":1050,"_140":183,"_184":1051,"_186":187,"_188":1052,"_190":1053,"_192":1054,"_194":1055,"_196":1056,"_198":1057,"_200":1058},"48490d76-c117-4813-9e44-d08d44e53200","2025041052499693.jpg",105279,"0ef55182d75fdce9b0e8cdaf4c03e078ea6eeb5578a6154000d2e3efca25ae71",183,677,"/igenu-preview/media/0ef55182d75fdce9b0e8cdaf.png","2026-10-20T17:32:39.916Z",[1059],{"_192":1054,"_194":1055,"_186":205,"_196":1060},"/igenu-preview/media/565e37464151b9fb7246a52e.webp",[1062,1093,1118,1142,1165],{"_144":1063,"_140":1064,"_57":1065,"_148":149,"_103":1066,"_151":1067,"_153":1068,"_154":1069,"_155":1089},"f7ce5bd6-9b75-467f-bee9-eb8ab23e63a7","APPLICATION","drinking-water","饮用水","连接处理与配水过程中的监测需求。","<p>饮用水监测覆盖进水、处理过程、出水及配水网络。可按 pH、浊度、电导率与余氯等参数探索仪器，具体适用性以各型号技术资料为准。</p>",{"_144":1070,"_140":183,"_184":1071,"_186":226,"_188":1072,"_190":1073,"_192":1074,"_194":1075,"_196":1076,"_198":1077,"_200":1078},"b507b9b5-7eb5-4173-83ee-fb266501df22","sybanner1.jpg",283339,"ea117bc117aac471ac0e6bf3d42bbcb7c2d8490f1e1ce04797ff680bdc98eee8",1200,334,"/igenu-preview/media/ea117bc117aac471ac0e6bf3.jpg","2026-10-20T17:32:39.579Z",[1079,1082,1085,1087],{"_192":203,"_194":1080,"_186":205,"_196":1081},89,"/igenu-preview/media/8d8bf753a2b1b2b52b429720.webp",{"_192":208,"_194":1083,"_186":205,"_196":1084},178,"/igenu-preview/media/89deca543eca96e5ed6c71c3.webp",{"_192":212,"_194":555,"_186":205,"_196":1086},"/igenu-preview/media/0c66b0a832f4356f7667fdc3.webp",{"_192":1074,"_194":1075,"_186":205,"_196":1088},"/igenu-preview/media/53d0854ee8163d7eeee592d7.webp",[444,161,605,409,356,445,159,158,157,1090,326,295,296,514,632,446,357,568,541,1091,1092,761,763],"f98a1a11-9b74-4b87-a91b-1548d296a61a","f339fd2d-ce7e-4de5-80dc-4651311a7f1c","0a1adde0-ea7b-4a40-b71e-a3b127b921f4",{"_144":1094,"_140":1064,"_57":1095,"_148":149,"_103":1096,"_151":1097,"_153":1098,"_154":1099,"_155":1115},"a3fa2cbf-4507-4fb4-9a6e-02d0defe3ef3","surface-water","地表水","探索河流、湖泊与水源中的测量参数。","<p>地表水监测帮助了解水体状况及其变化。可结合监测位置的需求，了解溶解氧、浊度、藻类及其他参数的相关仪器。</p>",{"_144":1100,"_140":183,"_184":1101,"_186":226,"_188":1102,"_190":1103,"_192":1074,"_194":1075,"_196":1104,"_198":1105,"_200":1106},"a96aa7c9-7b3b-4e0d-b612-1d67b9c9a070","sybanner2.jpg",266624,"cdf3ca1f3ff1131eca539bea66fe227fc32515b88582094770bb9a85ee224c72","/igenu-preview/media/cdf3ca1f3ff1131eca539bea.jpg","2026-10-20T17:32:39.585Z",[1107,1109,1111,1113],{"_192":203,"_194":1080,"_186":205,"_196":1108},"/igenu-preview/media/5ed418866c28338e8d58b071.webp",{"_192":208,"_194":1083,"_186":205,"_196":1110},"/igenu-preview/media/d03a51d19f1daad62cbe2448.webp",{"_192":212,"_194":555,"_186":205,"_196":1112},"/igenu-preview/media/343c776003d0297d44a3d3bc.webp",{"_192":1074,"_194":1075,"_186":205,"_196":1114},"/igenu-preview/media/408a0ee9c600f189eff01bb4.webp",[160,161,409,356,1116,445,159,158,157,1090,326,295,296,514,1117,632,446,357,568,541,1091,1092,761],"a4f89e53-652b-45dd-9cfa-d40ea54aa7f6","59e96d81-68ca-4e10-b4eb-288a3afe8881",{"_144":1119,"_140":1064,"_57":1120,"_148":149,"_103":1121,"_151":1122,"_153":1123,"_154":1124,"_155":1140},"e90f8976-faba-4cad-9f5d-cbde34192263","wastewater","污水处理","理解处理过程中的水质与污泥状态。","<p>污水应用包含多种测量任务。pH、溶解氧、悬浮物、污泥浓度及营养盐相关仪器，可用于相应处理环节的监测。请确认具体型号的测量范围与安装条件。</p>",{"_144":1125,"_140":183,"_184":1126,"_186":226,"_188":1127,"_190":1128,"_192":1074,"_194":1075,"_196":1129,"_198":1130,"_200":1131},"4b48352c-4bd9-48ab-9944-50eb658528f4","sybanner3.jpg",208005,"e356f85dd5122e366f1147eb7bd7cf6f1d2638f9780451966abf1e2ac52915e3","/igenu-preview/media/e356f85dd5122e366f1147eb.jpg","2026-10-20T17:32:39.591Z",[1132,1134,1136,1138],{"_192":203,"_194":1080,"_186":205,"_196":1133},"/igenu-preview/media/a54fc37687b86b3033664611.webp",{"_192":208,"_194":1083,"_186":205,"_196":1135},"/igenu-preview/media/08ccc77a6c4176e0745341e8.webp",{"_192":212,"_194":555,"_186":205,"_196":1137},"/igenu-preview/media/8fc946fbf86ce6a0fbb20292.webp",{"_192":1074,"_194":1075,"_186":205,"_196":1139},"/igenu-preview/media/0eee0efb7008a1da6e93fb96.webp",[674,160,444,161,409,356,1116,445,159,586,158,157,326,295,296,514,632,446,568,1091,1092,1141,856,896,897,952,761,676,763],"8adc50f7-109a-4e34-80e1-4442cb557ef8",{"_144":1143,"_140":1064,"_57":1144,"_148":670,"_103":1145,"_151":1146,"_153":1147,"_154":1148,"_155":1164},"97afa075-8b5c-4e56-b89d-6c27b12655bc","industrial-process","工业过程","连接流量、物位、压力与温度。","<p>每一种工业过程都有其特定工况。可了解流量、物位、温度、压力及相关水质分析仪器，并结合介质、安装条件与具体型号参数进行选型。</p>",{"_144":1149,"_140":183,"_184":1150,"_186":226,"_188":1151,"_190":1152,"_192":1074,"_194":1075,"_196":1153,"_198":1154,"_200":1155},"5d7c8527-d9e6-4378-856e-d2702dd5f45c","banner1.jpg",342744,"0315db0a4d6455fdcea62eb7c34070f2535d2d23fde50368cace315078c47bf8","/igenu-preview/media/0315db0a4d6455fdcea62eb7.jpg","2026-10-20T17:32:39.532Z",[1156,1158,1160,1162],{"_192":203,"_194":1080,"_186":205,"_196":1157},"/igenu-preview/media/a51f00cd84d52e09f1964644.webp",{"_192":208,"_194":1083,"_186":205,"_196":1159},"/igenu-preview/media/1a75cbec4f4732b367748fe1.webp",{"_192":212,"_194":555,"_186":205,"_196":1161},"/igenu-preview/media/f2cf254aa13eb7305cffe19c.webp",{"_192":1074,"_194":1075,"_186":205,"_196":1163},"/igenu-preview/media/94d9a4b088ec1822e4ee21d2.webp",[674,160,444,409,356,445,586,158,157,1090,326,295,296,514,446,357,1141,856,675,896,897,952,761,762],{"_144":1166,"_140":1064,"_57":1167,"_148":892,"_103":1168,"_151":1169,"_153":1170,"_154":1171,"_155":1187},"0ac612fd-a006-488b-94bc-442a2b4273c3","gas-safety","气体监测","用于浓度监测的固定式与便携式仪器。","<p>了解固定式气体检测仪、便携式检测仪及恶臭监测仪器。可检测气体、量程与接口取决于具体型号和配置，请与团队沟通目标气体及现场工况。</p>",{"_144":1172,"_140":183,"_184":1173,"_186":226,"_188":1174,"_190":1175,"_192":1074,"_194":1075,"_196":1176,"_198":1177,"_200":1178},"80c049fc-40ad-4323-9a25-c2cca9f27648","banner5.jpg",179706,"1a37cf51eb0d1214c061c8ba7603a9ebf13ba78e6de2501e0a99fadc4adf4436","/igenu-preview/media/1a37cf51eb0d1214c061c8ba.jpg","2026-10-20T17:32:39.557Z",[1179,1181,1183,1185],{"_192":203,"_194":1080,"_186":205,"_196":1180},"/igenu-preview/media/1f5d3fc4303b503be10d1a7d.webp",{"_192":208,