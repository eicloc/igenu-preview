ion",[102,118],{"_103":104,"_105":106},"title","产品","links",[107,112,115],{"_108":109,"_110":111},"label","Wasseranalyse","href","/de/products?category=water",{"_108":113,"_110":114},"Industrielle Messung","/de/products?category=industrial",{"_108":116,"_110":117},"Gasdetektion","/de/products?category=gas",{"_103":119,"_105":120},"了解更多",[121,124,127,130,133],{"_108":122,"_110":123},"关于我们","/de/about",{"_108":125,"_110":126},"客户案例","/de/cases",{"_108":128,"_110":129},"新闻中心","/de/news",{"_108":131,"_110":132},"售后服务","/de/service",{"_108":134,"_110":135},"下载中心","/de/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ph",[],[],"seo",{"_103":146,"_147":148,"_149":-5,"_150":151},"pH-Wert | IGENU SCIENCE","description","Entdecken Sie passende Geräte für pH-Wert.","imageUrl","index",true,"canonical","https://eicloc.github.io/igenu-preview/de/parameters/ph","query",{},"selected",[],"knowledge",{"_160":161,"_140":162,"_57":141,"_163":164,"_103":165,"_166":148,"_167":-5,"_168":-5,"_169":170,"_58":176,"_298":299},"id","02a3eb84-0972-4c75-b32f-8e027890b010","PARAMETER","category","water","pH-Wert","summary","bodyHtml","cover","productIds",[171,172,173,174,175],"da285210-11c2-4983-81be-86274bcf1ca2","331a2881-86de-42d4-aad2-8985fb41f4ba","27f7a7c7-2e6f-4394-8a3b-e1d66ae51c83","0edda979-2d5f-4caa-bde7-a1368da21597","ca3ec482-3741-46d1-bf9e-a1da33a8c095",[177,225,248,269,287],{"_160":171,"_57":178,"_179":180,"_181":182,"_183":184,"_185":151,"_163":186,"_189":190},"ig3000","model","IG3000","name","IG3000 Display Mehrkanalregler","shortDescription","Der Mehrkanalregler verbindet kompatible digitale und analoge Wassersensoren mit einer gemeinsamen Anzeige und Menüführung. Konfigurierbare Ausgänge, Relais und Kommunikationsoptionen unterstützen die Prozessanbindung; eine Haltefunktion für Ausgangssignale erleichtert Arbeiten während der Wartung angeschlossener Sensoren.","featured",{"_57":164,"_187":-5,"_181":109,"_147":-5,"_144":188},"brand",{"_103":109,"_147":-5,"_149":-5,"_150":151},"heroImage",{"_160":191,"_140":192,"_193":194,"_195":196,"_197":198,"_199":200,"_201":202,"_203":204,"_205":206,"_207":208,"_209":210},"d84d4b36-8577-47f5-a6b1-91a7ae3a7c9f","IMAGE","originalName","2025040855746689.png","mimeType","image/png","size",749999,"sha256","8032374cce79b2ec8e8e37dca3798c3058050655937edfc7f06654e8d4ff5b9e","width",1280,"height",1706,"url","/igenu-preview/media/8032374cce79b2ec8e8e37dc.png","createdAt","2026-10-20T17:32:39.748Z","variants",[211,216,220,223],{"_201":212,"_203":213,"_195":214,"_205":215},320,427,"image/webp","/igenu-preview/media/c82ee037d25142ee99b2efed.webp",{"_201":217,"_203":218,"_195":214,"_205":219},640,853,"/igenu-preview/media/8aafd5be554a54bb0699b6bf.webp",{"_201":221,"_203":202,"_195":214,"_205":222},960,"/igenu-preview/media/4a8ece2b232c4eb15009de8a.webp",{"_201":202,"_203":204,"_195":214,"_205":224},"/igenu-preview/media/288701302fcf6e887f187cad.webp",{"_160":172,"_57":226,"_179":227,"_181":228,"_183":229,"_185":151,"_163":230,"_189":232},"ig30phs","IG30PHS","IG30PHS Digitale pH-Elektrode","Die digitale pH-Elektrode kombiniert Gelbefüllung, ein Referenzsystem mit doppelter Salzbrücke und integrierte Temperaturerfassung. Modbus ermöglicht die Verbindung mit kompatiblen Reglern; Kalibrieroptionen sowie mitgelieferte Halterung und Durchflusszelle unterstützen Installation und Routinebetrieb am Messpunkt der jeweiligen Anlage.",{"_57":164,"_187":-5,"_181":109,"_147":-5,"_144":231},{"_103":109,"_147":-5,"_149":-5,"_150":151},{"_160":233,"_140":192,"_193":234,"_195":235,"_197":236,"_199":237,"_201":238,"_203":239,"_205":240,"_207":241,"_209":242},"7507b7cd-7dc3-42b2-90a4-f843106d4461","2025040859520101.png","image/jpeg",19079,"7dfe5452c927d26232963ff85f11073f15b9d29010abcb394bea3ce0f2f502d6",358,302,"/igenu-preview/media/7dfe5452c927d26232963ff8.jpg","2026-10-20T17:32:39.754Z",[243,246],{"_201":212,"_203":244,"_195":214,"_205":245},270,"/igenu-preview/media/93a066c50a54638353b43bbf.webp",{"_201":238,"_203":239,"_195":214,"_205":247},"/igenu-preview/media/b72cc265fa7500183b25c7da.webp",{"_160":173,"_57":249,"_179":250,"_181":251,"_183":252,"_185":253,"_163":254,"_189":256},"ig3000mp-x","IG3000MP-X","IG3000MP-X Multiparameter-Wasseranalysator","Digitale Wechselsonden ermöglichen eine anwendungsbezogene Kombination von pH, gelöstem Sauerstoff, Leitfähigkeit und Trübung. Wasserdichte Anschlüsse und in den Sonden gespeicherte Kalibrierdaten unterstützen den Austausch vor Ort; eine automatische Reinigung hilft, Ablagerungen an den Sensorflächen zu begrenzen.",false,{"_57":164,"_187":-5,"_181":109,"_147":-5,"_144":255},{"_103":109,"_147":-5,"_149":-5,"_150":151},{"_160":257,"_140":192,"_193":258,"_195":235,"_197":259,"_199":260,"_201":261,"_203":261,"_205":262,"_207":263,"_209":264},"d6d649eb-90c0-469f-9bfb-1c613153f689","2025040861670749.jpg",19258,"9a9243397faa84f675ead5a8a5216895cf7e15c9b82d390083269947f0d00581",540,"/igenu-preview/media/9a9243397faa84f675ead5a8.jpg","2026-10-20T17:32:39.812Z",[265,267],{"_201":212,"_203":212,"_195":214,"_205":266},"/igenu-preview/media/32f08ba6aa513832d0c6c644.webp",{"_201":261,"_203":261,"_195":214,"_205":268},"/igenu-preview/media/61f38d89920b71a6040fa537.webp",{"_160":174,"_57":270,"_179":271,"_181":272,"_183":273,"_185":253,"_163":274,"_189":276},"ig30ise-x","IG30ISE-X","IG30ISE-X Ionenselektive Elektrode","Die ionenselektive Messung unterstützt konfigurierte Ionenparameter und pH in der Wasserüberwachung. Die Tauchsonde benötigt kein separates Probenahmesystem und bietet Kompensations- sowie Kalibrierfunktionen für Anwendungen in Trinkwasser, Umweltmessung und Abwasser; die Parameter werden anwendungsbezogen ausgewählt.",{"_57":164,"_187":-5,"_181":109,"_147":-5,"_144":275},{"_103":109,"_147":-5,"_149":-5,"_150":151},{"_160":277,"_140":192,"_193":278,"_195":196,"_197":279,"_199":280,"_201":212,"_203":281,"_205":282,"_207":283,"_209":284},"c6e3c765-909d-45fd-bd1c-7dbc51fecd54","2025041051038309.png",13330,"8936108072d3c61053c40f382494eb98c8734713fb66a99450bf2aedb26fb684",120,"/igenu-preview/media/8936108072d3c61053c40f38.png","2026-10-20T17:32:39.882Z",[285],{"_201":212,"_203":281,"_195":214,"_205":286},"/igenu-preview/media/f11ab30d5325a31abe0f2adb.webp",{"_160":175,"_57":288,"_179":289,"_181":290,"_183":291,"_185":253,"_163":292,"_189":294},"ig30ph01","IG30PH01","IG30PH01 Analoge pH-Elektrode","Die analoge pH-Elektrode verbindet eine Gelbefüllung mit einem Referenzsystem mit doppelter Salzbrücke für Wasser- und Prozessmessungen. Ein integrierter Temperatursensor unterstützt die Kompensation; Halterung und Durchflusszelle erleichtern die Installation an dem für die Anwendung vorgesehenen Messpunkt.",{"_57":164,"_187":-5,"_181":109,"_147":-5,"_144":293},{"_103":109,"_147":-5,"_149":-5,"_150":151},{"_160":233,"_140":192,"_193":234,"_195":235,"_197":236,"_199":237,"_201":238,"_203":239,"_205":240,"_207":241,"_209":295},[296,297],{"_201":212,"_203":244,"_195":214,"_205":245},{"_201":238,"_203":239,"_195":214,"_205":247},"sourceSections",[]]
