,"_149":-5,"_150":151},"heroImage",{"_160":190,"_140":191,"_192":193,"_194":195,"_196":197,"_198":199,"_200":201,"_202":203,"_204":205,"_206":207,"_208":209},"485bff13-2df9-448f-a8bc-6b60b3e5ad76","IMAGE","originalName","2025040851503805.png","mimeType","image/png","size",698863,"sha256","8ef050d2f42f424a5466c7f703dc0ddcbb2915dc23bdee338481847f3cefa2dd","width",2604,"height",1704,"url","/igenu-preview/media/8ef050d2f42f424a5466c7f7.png","createdAt","2026-10-20T17:32:39.690Z","variants",[210,215,219,223,227],{"_200":211,"_202":212,"_194":213,"_204":214},320,209,"image/webp","/igenu-preview/media/63971d02adf57bfde6335036.webp",{"_200":216,"_202":217,"_194":213,"_204":218},640,419,"/igenu-preview/media/94e5c9a427aaff2e7fe15add.webp",{"_200":220,"_202":221,"_194":213,"_204":222},960,628,"/igenu-preview/media/6403302113043098a393f716.webp",{"_200":224,"_202":225,"_194":213,"_204":226},1280,838,"/igenu-preview/media/bd1f66f7ac71cc90284d1d8d.webp",{"_200":228,"_202":229,"_194":213,"_204":230},1600,1047,"/igenu-preview/media/0f4d290e7e86d3dd29596237.webp",{"_160":172,"_57":232,"_177":233,"_179":234,"_181":235,"_183":184,"_163":236,"_188":238},"ig9500","IG9500","IG9500 Tauchsonde zur Füllstandsmessung","Die druckbasierte Tauchsonde misst Flüssigkeitsstände mit einem Silizium-Messelement in einem abgedichteten Edelstahlgehäuse. Wählbare Ausgänge unterstützen die Überwachung von Behältern, Wassersystemen und Pumpanlagen; die medienberührten Werkstoffe werden auf die zu messende Flüssigkeit und den Einsatzort abgestimmt.",{"_57":164,"_186":-5,"_179":113,"_147":-5,"_144":237},{"_103":113,"_147":-5,"_149":-5,"_150":151},{"_160":239,"_140":191,"_192":240,"_194":195,"_196":241,"_198":242,"_200":243,"_202":244,"_204":245,"_206":246,"_208":247},"2c2a9461-2d1e-4d92-9b2f-bb3264ca2631","2025040851522761.jpg",83470,"4faf3f82eaab6ca730d4cb0baaed53b24302624c182eac3dae9bc76e518a7daa",399,397,"/igenu-preview/media/4faf3f82eaab6ca730d4cb0b.png","2026-10-20T17:32:39.698Z",[248,251],{"_200":211,"_202":249,"_194":213,"_204":250},318,"/igenu-preview/media/c18242a2c8052f476dfdc70d.webp",{"_200":243,"_202":244,"_194":213,"_204":252},"/igenu-preview/media/7c5fdf13c62f45db05f4fbd2.webp",{"_160":173,"_57":254,"_177":255,"_179":256,"_181":257,"_183":184,"_163":258,"_188":260},"ig9600","IG9600","IG9600 Ultraschall-Messgerät für Schlammgrenzschichten","Die Auswertung von Ultraschallechos ermittelt die Schlammgrenzschicht in Absetz- und Eindickbecken. Getrennte Sonde, integrierte Temperaturkompensation und lokale Anzeige unterstützen die Überwachung in Abwasserbehandlung und Wasserwerks-Sedimentation; die Konfiguration wird an die jeweilige Installation vor Ort angepasst.",{"_57":164,"_186":-5,"_179":113,"_147":-5,"_144":259},{"_103":113,"_147":-5,"_149":-5,"_150":151},{"_160":261,"_140":191,"_192":262,"_194":195,"_196":263,"_198":264,"_200":265,"_202":203,"_204":266,"_206":267,"_208":268},"fe68277b-0e41-4c1a-b0a4-8bfebd654caa","2025040854938433.png",549953,"65b4e4d80f69906e1d7bb840b3735e20c7fa903b831162b2a977ae41ff5f77d9",2064,"/igenu-preview/media/65b4e4d80f69906e1d7bb840.png","2026-10-20T17:32:39.735Z",[269,272,275,278,281],{"_200":211,"_202":270,"_194":213,"_204":271},264,"/igenu-preview/media/2dc78a489616479a5aadfbac.webp",{"_200":216,"_202":273,"_194":213,"_204":274},528,"/igenu-preview/media/aae51fe4186be6ad1749b345.webp",{"_200":220,"_202":276,"_194":213,"_204":277},793,"/igenu-preview/media/50b869a018e4f784a789e882.webp",{"_200":224,"_202":279,"_194":213,"_204":280},1057,"/igenu-preview/media/44748a134c7000c8efd4c395.webp",{"_200":228,"_202":282,"_194":213,"_204":283},1321,"/igenu-preview/media/8ef2f704c499019d37e0855c.webp","sourceSections",[]]
