3":109,"_147":-5,"_149":-5,"_150":151},"heroImage",{"_160":191,"_140":192,"_193":194,"_195":196,"_197":198,"_199":200,"_201":202,"_203":204,"_205":206,"_207":208,"_209":210},"d84d4b36-8577-47f5-a6b1-91a7ae3a7c9f","IMAGE","originalName","2025040855746689.png","mimeType","image/png","size",749999,"sha256","8032374cce79b2ec8e8e37dca3798c3058050655937edfc7f06654e8d4ff5b9e","width",1280,"height",1706,"url","/igenu-preview/media/8032374cce79b2ec8e8e37dc.png","createdAt","2026-10-20T17:32:39.748Z","variants",[211,216,220,223],{"_201":212,"_203":213,"_195":214,"_205":215},320,427,"image/webp","/igenu-preview/media/c82ee037d25142ee99b2efed.webp",{"_201":217,"_203":218,"_195":214,"_205":219},640,853,"/igenu-preview/media/8aafd5be554a54bb0699b6bf.webp",{"_201":221,"_203":202,"_195":214,"_205":222},960,"/igenu-preview/media/4a8ece2b232c4eb15009de8a.webp",{"_201":202,"_203":204,"_195":214,"_205":224},"/igenu-preview/media/288701302fcf6e887f187cad.webp",{"_160":172,"_57":226,"_179":227,"_181":228,"_183":229,"_185":230,"_163":231,"_189":233},"ig3000lt","IG3000LT","IG3000LT Trübungsanalysator für niedrige Messbereiche","Für die Messung niedriger Trübungen in Trinkwasser und Aufbereitungssystemen kombiniert der Analysator optische Erfassung mit einer Durchflusszelle zur Blasenentfernung. Der modulare Aufbau unterstützt Kalibrierung, Reinigung und Wartung; zusätzlich zur Trübung wird die Temperatur angezeigt.",false,{"_57":164,"_187":-5,"_181":109,"_147":-5,"_144":232},{"_103":109,"_147":-5,"_149":-5,"_150":151},{"_160":234,"_140":192,"_193":235,"_195":196,"_197":236,"_199":237,"_201":238,"_203":239,"_205":240,"_207":241,"_209":242},"257d01fc-7670-46be-af54-0ae68bffbc45","2025040860761681.jpg",133072,"32687b0fb7e3209190a365f6165fd1befe9616a983cc291c12aca450fcae88b2",327,551,"/igenu-preview/media/32687b0fb7e3209190a365f6.png","2026-10-20T17:32:39.781Z",[243,246],{"_201":212,"_203":244,"_195":214,"_205":245},539,"/igenu-preview/media/f37ebd4fe6509270a9cebcfb.webp",{"_201":238,"_203":239,"_195":214,"_205":247},"/igenu-preview/media/eeb83d74a18b9d4f5cb4ef75.webp",{"_160":173,"_57":249,"_179":250,"_181":251,"_183":252,"_185":230,"_163":253,"_189":255},"ig3000mp-x","IG3000MP-X","IG3000MP-X Multiparameter-Wasseranalysator","Digitale Wechselsonden ermöglichen eine anwendungsbezogene Kombination von pH, gelöstem Sauerstoff, Leitfähigkeit und Trübung. Wasserdichte Anschlüsse und in den Sonden gespeicherte Kalibrierdaten unterstützen den Austausch vor Ort; eine automatische Reinigung hilft, Ablagerungen an den Sensorflächen zu begrenzen.",{"_57":164,"_187":-5,"_181":109,"_147":-5,"_144":254},{"_103":109,"_147":-5,"_149":-5,"_150":151},{"_160":256,"_140":192,"_193":257,"_195":258,"_197":259,"_199":260,"_201":261,"_203":261,"_205":262,"_207":263,"_209":264},"d6d649eb-90c0-469f-9bfb-1c613153f689","2025040861670749.jpg","image/jpeg",19258,"9a9243397faa84f675ead5a8a5216895cf7e15c9b82d390083269947f0d00581",540,"/igenu-preview/media/9a9243397faa84f675ead5a8.jpg","2026-10-20T17:32:39.812Z",[265,267],{"_201":212,"_203":212,"_195":214,"_205":266},"/igenu-preview/media/32f08ba6aa513832d0c6c644.webp",{"_201":261,"_203":261,"_195":214,"_205":268},"/igenu-preview/media/61f38d89920b71a6040fa537.webp",{"_160":174,"_57":270,"_179":271,"_181":272,"_183":273,"_185":230,"_163":274,"_189":276},"ig30ht","IG30HT","IG30HT Trübungssensor für hohe Messbereiche","Die Infrarot-Streulichtmessung erfasst Trübungen in Prozesswasser, Oberflächenwasser und Aufbereitungsanlagen. Die digitale Sonde verbindet optische Kompensation mit einem Saphirfenster; eine optionale Reinigungsbürste hilft, Ablagerungen auf der Messfläche während des laufenden Onlinebetriebs in der Anlage zu reduzieren.",{"_57":164,"_187":-5,"_181":109,"_147":-5,"_144":275},{"_103":109,"_147":-5,"_149":-5,"_150":151},{"_160":277,"_140":192,"_193":278,"_195":196,"_197":279,"_199":280,"_201":281,"_203":282,"_205":283,"_207":284,"_209":285},"95eccf83-22e5-4f4d-a03f-5509479d7661","2025040860985293.jpg",11246,"ecdac2d963d6479b136774a8172895d54061650f1cb8089d1404ff2a26710a79",190,78,"/igenu-preview/media/ecdac2d963d6479b136774a8.png","2026-10-20T17:32:39.787Z",[286],{"_201":281,"_203":282,"_195":214,"_205":287},"/igenu-preview/media/c0547cb002a63d36b1ac374c.webp",{"_160":175,"_57":289,"_179":290,"_181":291,"_183":292,"_185":230,"_163":293,"_189":295},"ig3254cod","IG3254COD","IG3254COD UV-Sensor für CSB und TOC","Die UV-Absorptionsmessung unterstützt die Onlinebestimmung von CSB und TOC ohne Reagenziendosierung. Trübungskompensation, Kalibrieroptionen und eine verfügbare automatische Reinigung passen die digitale Sonde an die Wasserüberwachung an; Ergebnisse werden entsprechend der gewählten Kalibrierung und Messkonfiguration interpretiert.",{"_57":164,"_187":-5,"_181":109,"_147":-5,"_144":294},{"_103":109,"_147":-5,"_149":-5,"_150":151},{"_160":296,"_140":192,"_193":297,"_195":258,"_197":298,"_199":299,"_201":261,"_203":261,"_205":300,"_207":301,"_209":302},"79d9f104-d914-4e36-bec2-d6d2b843fefd","2025041051182309.jpg",14215,"e3e2c21db606165f614650cf931244737a0e84793f3dd9ab8bd834db8aa5b8b3","/igenu-preview/media/e3e2c21db606165f614650cf.jpg","2026-10-20T17:32:39.888Z",[303,305],{"_201":212,"_203":212,"_195":214,"_205":304},"/igenu-preview/media/087409fcbd7eefe1aec06c53.webp",{"_201":261,"_203":261,"_195":214,"_205":306},"/igenu-preview/media/6d889354b11ab94fb489a773.webp","sourceSections",[]]
