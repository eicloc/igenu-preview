49":-5,"_150":151},"heroImage",{"_160":190,"_140":191,"_192":193,"_194":195,"_196":197,"_198":199,"_200":201,"_202":203,"_204":205,"_206":207,"_208":209},"d84d4b36-8577-47f5-a6b1-91a7ae3a7c9f","IMAGE","originalName","2025040855746689.png","mimeType","image/png","size",749999,"sha256","8032374cce79b2ec8e8e37dca3798c3058050655937edfc7f06654e8d4ff5b9e","width",1280,"height",1706,"url","/igenu-preview/media/8032374cce79b2ec8e8e37dc.png","createdAt","2026-10-20T17:32:39.748Z","variants",[210,215,219,222],{"_200":211,"_202":212,"_194":213,"_204":214},320,427,"image/webp","/igenu-preview/media/c82ee037d25142ee99b2efed.webp",{"_200":216,"_202":217,"_194":213,"_204":218},640,853,"/igenu-preview/media/8aafd5be554a54bb0699b6bf.webp",{"_200":220,"_202":201,"_194":213,"_204":221},960,"/igenu-preview/media/4a8ece2b232c4eb15009de8a.webp",{"_200":201,"_202":203,"_194":213,"_204":223},"/igenu-preview/media/288701302fcf6e887f187cad.webp",{"_160":172,"_57":225,"_178":226,"_180":227,"_182":228,"_184":229,"_163":230,"_188":232},"ig3000mp-x","IG3000MP-X","IG3000MP-X Multiparameter-Wasseranalysator","Digitale Wechselsonden ermöglichen eine anwendungsbezogene Kombination von pH, gelöstem Sauerstoff, Leitfähigkeit und Trübung. Wasserdichte Anschlüsse und in den Sonden gespeicherte Kalibrierdaten unterstützen den Austausch vor Ort; eine automatische Reinigung hilft, Ablagerungen an den Sensorflächen zu begrenzen.",false,{"_57":164,"_186":-5,"_180":109,"_147":-5,"_144":231},{"_103":109,"_147":-5,"_149":-5,"_150":151},{"_160":233,"_140":191,"_192":234,"_194":235,"_196":236,"_198":237,"_200":238,"_202":238,"_204":239,"_206":240,"_208":241},"d6d649eb-90c0-469f-9bfb-1c613153f689","2025040861670749.jpg","image/jpeg",19258,"9a9243397faa84f675ead5a8a5216895cf7e15c9b82d390083269947f0d00581",540,"/igenu-preview/media/9a9243397faa84f675ead5a8.jpg","2026-10-20T17:32:39.812Z",[242,244],{"_200":211,"_202":211,"_194":213,"_204":243},"/igenu-preview/media/32f08ba6aa513832d0c6c644.webp",{"_200":238,"_202":238,"_194":213,"_204":245},"/igenu-preview/media/61f38d89920b71a6040fa537.webp",{"_160":173,"_57":247,"_178":248,"_180":249,"_182":250,"_184":229,"_163":251,"_188":253},"ig30rps","IG30RPS","IG30RPS Digitale Redoxelektrode","Die digitale Redoxelektrode überwacht das Oxidations-Reduktions-Potenzial in Wasser und industriellen Prozessen. Eine Platin-Messelektrode und ein Referenzsystem mit doppelter Salzbrücke werden durch digitale Kommunikation, Proben- oder Standardkalibrierung sowie Halterung und Durchflusszelle für die Installation ergänzt.",{"_57":164,"_186":-5,"_180":109,"_147":-5,"_144":252},{"_103":109,"_147":-5,"_149":-5,"_150":151},{"_160":254,"_140":191,"_192":255,"_194":235,"_196":256,"_198":257,"_200":258,"_202":259,"_204":260,"_206":261,"_208":262},"7507b7cd-7dc3-42b2-90a4-f843106d4461","2025040859520101.png",19079,"7dfe5452c927d26232963ff85f11073f15b9d29010abcb394bea3ce0f2f502d6",358,302,"/igenu-preview/media/7dfe5452c927d26232963ff8.jpg","2026-10-20T17:32:39.754Z",[263,266],{"_200":211,"_202":264,"_194":213,"_204":265},270,"/igenu-preview/media/93a066c50a54638353b43bbf.webp",{"_200":258,"_202":259,"_194":213,"_204":267},"/igenu-preview/media/b72cc265fa7500183b25c7da.webp",{"_160":174,"_57":269,"_178":270,"_180":271,"_182":272,"_184":229,"_163":273,"_188":275},"ig30rps01","IG30RPS01","IG30RPS01 Analoge Redoxelektrode","Die analoge Redoxelektrode erfasst das Oxidations-Reduktions-Potenzial in der Wasseraufbereitung und Prozessüberwachung. Platin-Messelement und Referenzsystem mit doppelter Salzbrücke werden durch Proben- und Standardkalibrierung sowie eine Halterung und Durchflusszelle für den Einbau am vorgesehenen Messpunkt ergänzt.",{"_57":164,"_186":-5,"_180":109,"_147":-5,"_144":274},{"_103":109,"_147":-5,"_149":-5,"_150":151},{"_160":254,"_140":191,"_192":255,"_194":235,"_196":256,"_198":257,"_200":258,"_202":259,"_204":260,"_206":261,"_208":276},[277,278],{"_200":211,"_202":264,"_194":213,"_204":265},{"_200":258,"_202":259,"_194":213,"_204":267},"sou