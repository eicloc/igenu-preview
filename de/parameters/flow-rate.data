berührungslose Ultraschall-Pegelmessung berechnet den Durchfluss an konfigurierten Messwehren und Messrinnen. Eine getrennte Sonde mit Anzeigeeinheit liefert Momentan- und Summenwerte für Anwendungen wie Abwassereinleitungen, Bewässerung und kommunale Wasserbauanlagen an den jeweils eingerichteten Messstellen vor Ort.",{"_57":164,"_186":-5,"_179":113,"_147":-5,"_144":247},{"_103":113,"_147":-5,"_149":-5,"_150":151},{"_160":249,"_140":191,"_192":250,"_194":231,"_196":251,"_198":252,"_200":253,"_202":254,"_204":255,"_206":256,"_208":257},"c09dd052-6bcc-434a-9386-7136b00ba170","2025040854281913.png",544222,"96effce7a54b18259f3ac6a19a290f71d4f862b45801327c466bd60032c71808",1809,1449,"/igenu-preview/media/96effce7a54b18259f3ac6a1.png","2026-10-20T17:32:39.727Z",[258,261,264,268,272],{"_200":211,"_202":259,"_194":213,"_204":260},256,"/igenu-preview/media/f7db19bc9da969b069506228.webp",{"_200":216,"_202":262,"_194":213,"_204":263},513,"/igenu-preview/media/9e26d52402655e540b305fd0.webp",{"_200":265,"_202":266,"_194":213,"_204":267},960,769,"/igenu-preview/media/1e64887f2c4083e3b4c84b69.webp",{"_200":269,"_202":270,"_194":213,"_204":271},1280,1025,"/igenu-preview/media/a853495b9ddf518f0be39552.webp",{"_200":273,"_202":274,"_194":213,"_204":275},1600,1282,"/igenu-preview/media/f0f509b5abc23cc9078dfaf4.webp","sourceSections",[]]
