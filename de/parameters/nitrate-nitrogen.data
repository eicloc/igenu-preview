,"_147":-5,"_149":-5,"_150":151},"heroImage",{"_160":190,"_140":191,"_192":193,"_194":195,"_196":197,"_198":199,"_200":201,"_202":203,"_204":205,"_206":207,"_208":209},"d84d4b36-8577-47f5-a6b1-91a7ae3a7c9f","IMAGE","originalName","2025040855746689.png","mimeType","image/png","size",749999,"sha256","8032374cce79b2ec8e8e37dca3798c3058050655937edfc7f06654e8d4ff5b9e","width",1280,"height",1706,"url","/igenu-preview/media/8032374cce79b2ec8e8e37dc.png","createdAt","2026-10-20T17:32:39.748Z","variants",[210,215,219,222],{"_200":211,"_202":212,"_194":213,"_204":214},320,427,"image/webp","/igenu-preview/media/c82ee037d25142ee99b2efed.webp",{"_200":216,"_202":217,"_194":213,"_204":218},640,853,"/igenu-preview/media/8aafd5be554a54bb0699b6bf.webp",{"_200":220,"_202":201,"_194":213,"_204":221},960,"/igenu-preview/media/4a8ece2b232c4eb15009de8a.webp",{"_200":201,"_202":203,"_194":213,"_204":223},"/igenu-preview/media/288701302fcf6e887f187cad.webp",{"_160":172,"_57":225,"_178":226,"_180":227,"_182":228,"_184":151,"_163":229,"_188":231},"ig30uvno3","IG30UVNO3","IG30UVNO3 UV-Sensor für Nitratstickstoff","Die UV-Absorptionsmessung erfasst Nitratstickstoff direkt im Wasser, ohne chemische Reagenzien oder separates Probenahmesystem. Wählbare optische Weglängen, Störgrößenkompensation und automatische Reinigung unterstützen den Onlineeinsatz in Trinkwasser, Umweltüberwachung und Abwasserbehandlung sowie die Anpassung an den Messpunkt.",{"_57":164,"_186":-5,"_180":109,"_147":-5,"_144":230},{"_103":109,"_147":-5,"_149":-5,"_150":151},{"_160":232,"_140":191,"_192":233,"_194":234,"_196":235,"_198":236,"_200":237,"_202":238,"_204":239,"_206":240,"_208":241},"79581a81-10c6-426b-80fa-28e7baf03c33","2025040861391349.png","image/jpeg",16873,"82c04b6460e5738541de5cfefb589dc0c6890e78350a89fe4e1a3b1a0828a745",263,348,"/igenu-preview/media/82c04b6460e5738541de5cfe.jpg","2026-10-20T17:32:39.799Z",[242],{"_200":237,"_202":238,"_194":213,"_204":243},"/igenu-preview/media/5668d414b7362883ab524969.webp",{"_160":173,"_57":245,"_178":246,"_180":247,"_182":248,"_184":249,"_163":250,"_188":252},"ig3000mp-x","IG3000MP-X","IG3000MP-X Multiparameter-Wasseranalysator","Digitale Wechselsonden ermöglichen eine anwendungsbezogene Kombination von pH, gelöstem Sauerstoff, Leitfähigkeit und Trübung. Wasserdichte Anschlüsse und in den Sonden gespeicherte Kalibrierdaten unterstützen den Austausch vor Ort; eine automatische Reinigung hilft, Ablagerungen an den Sensorflächen zu begrenzen.",false,{"_57":164,"_186":-5,"_180":109,"_147":-5,"_144":251},{"_103":109,"_147":-5,"_149":-5,"_150":151},{"_160":253,"_140":191,"_192":254,"_194":234,"_196":255,"_198":256,"_200":257,"_202":257,"_204":258,"_206":259,"_208":260},"d6d649eb-90c0-469f-9bfb-1c613153f689","2025040861670749.jpg",19258,"9a9243397faa84f675ead5a8a5216895cf7e15c9b82d390083269947f0d00581",540,"/igenu-preview/media/9a9243397faa84f675ead5a8.jpg","2026-10-20T17:32:39.812Z",[261,263],{"_200":211,"_202":211,"_194":213,"_204":262},"/igenu-preview/media/32f08ba6aa513832d0c6c644.webp",{"_200":257,"_202":257,"_194":213,"_204":264},"/igenu-preview/media/61f38d89920b71a6040fa537.webp",{"_160":174,"_57":266,"_178":267,"_180":268,"_182":269,"_184":249,"_163":270,"_188":272},"ig30ise-x","IG30ISE-X","IG30ISE-X Ionenselektive Elektrode","Die ionenselektive Messung unterstützt konfigurierte Ionenparameter und pH in der Wasserüberwachung. Die Tauchsonde benötigt kein separates Probenahmesystem und bietet Kompensations- sowie Kalibrierfunktionen für Anwendungen in Trinkwasser, Umweltmessung und Abwasser; die Parameter werden anwendungsbezogen ausgewählt.",{"_57":164,"_186":-5,"_180":109,"_147":-5,"_144":271},{"_103":109,"_147":-5,"_149":-5,"_150":151},{"_160":273,"_140":191,"_192":274,"_194":195,"_196":275,"_198":276,"_200":211,"_202":277,"_204":278,"_206":279,"_208":280},"c6e3c765-909d-45fd-bd1c-7dbc51fecd54","2025041051038309.png",13330,"8936108072d3c61053c40f382494eb98c8734713fb66a99450bf2aedb26fb684",120,"/igenu-preview/media/8936108072d3c61