38d89920b71a6040fa537.webp",{"_160":173,"_57":246,"_177":247,"_179":248,"_181":249,"_183":228,"_163":250,"_187":252},"ig30cds","IG30CDS","IG30CDS Leitfähigkeitssensor","Verschiedene Zellkonstanten ermöglichen die Leitfähigkeitsmessung in der Wasseraufbereitung und in industriellem Prozesswasser. Digitale Kommunikation und gespeicherte Kalibrierwerte unterstützen die Systemintegration; die mitgelieferte Halterung und Durchflusszelle erleichtern den Einbau und die Einrichtung am vorgesehenen Messpunkt.",{"_57":164,"_185":-5,"_179":109,"_147":-5,"_144":251},{"_103":109,"_147":-5,"_149":-5,"_150":151},{"_160":253,"_140":190,"_191":254,"_193":234,"_195":255,"_197":256,"_199":257,"_201":257,"_203":258,"_205":259,"_207":260},"97568f30-f32e-4d9a-85ac-2b57a8967181","2025040860050401.jpg",57217,"08cc865f38c95a6b72364eaf3f6b94912df92297b7cb4dbcdb9d9d327b79dd1c",500,"/igenu-preview/media/08cc865f38c95a6b72364eaf.jpg","2026-10-20T17:32:39.763Z",[261,263],{"_199":210,"_201":210,"_193":212,"_203":262},"/igenu-preview/media/6f7c525ac57d10f270f2e15f.webp",{"_199":257,"_201":257,"_193":212,"_203":264},"/igenu-preview/media/d8eaca92b7d0ec37a6ee861d.webp","sourceSections",[]]
