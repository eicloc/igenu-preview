"ig8300voc","IG8300VOC","IG8300VOC Onlinesystem zur Geruchs- und Gasüberwachung","Das System überwacht konfigurierte geruchsrelevante Gase mit mehreren Sensoren, Probenvorbehandlung, Temperaturkompensation und automatischer Kalibrierung. Integrierte Anzeige, Datenspeicherung und Kommunikationsoptionen unterstützen die vernetzte Umweltüberwachung an Abwasseranlagen, Chemiestandorten und Abfallbehandlungsanlagen sowie die Anbindung an das Überwachungssystem.",{"_57":164,"_185":-5,"_179":116,"_147":-5,"_144":250},{"_103":116,"_147":-5,"_149":-5,"_150":151},{"_160":252,"_140":190,"_191":253,"_193":194,"_195":254,"_197":255,"_199":256,"_201":257,"_203":258,"_205":259,"_207":260},"248b037a-97ca-43b1-abac-a26d2deaf089","2025040852682581.png",22439,"97c97b1129c8237eb4b7d324799035ec948f856036b41f67613d22e0171553b0",194,421,"/igenu-preview/media/97c97b1129c8237eb4b7d324.jpg","2026-10-20T17:32:39.720Z",[261],{"_199":256,"_201":257,"_193":212,"_203":262},"/igenu-preview/media/51378fe539ff38c9e791e3c9.webp","sourceSections",[]]
