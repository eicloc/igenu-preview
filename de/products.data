"_150":469,"_152":470,"_153":471,"_154":487},"97afa075-8b5c-4e56-b89d-6c27b12655bc","industrial-process","Industrielle Prozesse","Durchfluss, Füllstand, Druck und Temperatur im Kontext.","<p>Jeder Industrieprozess hat eigene Betriebsbedingungen. Entdecken Sie Instrumente für Durchfluss, Füllstand, Temperatur, Druck und gegebenenfalls Wasseranalyse. Wählen Sie anhand von Medium, Einbau und Modellspezifikationen.</p>",{"_143":472,"_140":378,"_379":473,"_381":382,"_383":474,"_385":475,"_387":388,"_389":390,"_391":476,"_393":477,"_395":478},"5d7c8527-d9e6-4378-856e-d2702dd5f45c","banner1.jpg",342744,"0315db0a4d6455fdcea62eb7c34070f2535d2d23fde50368cace315078c47bf8","/igenu-preview/media/0315db0a4d6455fdcea62eb7.jpg","2026-10-20T17:32:39.532Z",[479,481,483,485],{"_387":398,"_389":399,"_381":400,"_391":480},"/igenu-preview/media/a51f00cd84d52e09f1964644.webp",{"_387":403,"_389":404,"_381":400,"_391":482},"/igenu-preview/media/1a75cbec4f4732b367748fe1.webp",{"_387":407,"_389":408,"_381":400,"_391":484},"/igenu-preview/media/f2cf254aa13eb7305cffe19c.webp",{"_387":388,"_389":390,"_381":400,"_391":486},"/igenu-preview/media/94d9a4b088ec1822e4ee21d2.webp",[267,159,203,190,182,204,233,157,156,413,175,167,168,212,205,183,464,285,268,299,300,307,276,277],{"_143":489,"_140":371,"_57":490,"_147":295,"_103":491,"_150":492,"_152":493,"_153":494,"_154":510},"0ac612fd-a006-488b-94bc-442a2b4273c3","gas-safety","Gasüberwachung","Stationäre und tragbare Instrumente zur Konzentrationsüberwachung.","<p>Entdecken Sie stationäre und tragbare Gasdetektoren sowie Instrumente zur Geruchsüberwachung. Erfassbare Gase, Messbereiche und Schnittstellen hängen von Modell und Konfiguration ab. Besprechen Sie Zielgas und Betriebsbedingungen mit unserem Team.</p>",{"_143":495,"_140":378,"_379":496,"_381":382,"_383":497,"_385":498,"_387":388,"_389":390,"_391":499,"_393":500,"_395":501},"80c049fc-40ad-4323-9a25-c2cca9f27648","banner5.jpg",179706,"1a37cf51eb0d1214c061c8ba7603a9ebf13ba78e6de2501e0a99fadc4adf4436","/igenu-preview/media/1a37cf51eb0d1214c061c8ba.jpg","2026-10-20T17:32:39.557Z",[502,504,506,508],{"_387":398,"_389":399,"_381":400,"_391":503},"/igenu-preview/media/1f5d3fc4303b503be10d1a7d.webp",{"_387":403,"_389":404,"_381":400,"_391":505},"/igenu-preview/media/f1c479027edd7c1eeb3cef4f.webp",{"_387":407,"_389":408,"_381":400,"_391":507},"/igenu-preview/media/64ad6ec0c7d8ae6a3937f3f9.webp",{"_387":388,"_389":390,"_381":400,"_391":509},"/igenu-preview/media/a68a1914bdb031107cff6a6c.webp",[268,299,300,307],"seo",{"_103":513,"_514":91,"_515":-5,"_516":517},"Instrumente | IGENU SCIENCE","description","imageUrl","index",true,"canonical","https://eicloc.github.io/igenu-preview/de/products","query",{},"selected",[],{"_525":526,"_794":795,"_796":797,"_798":799,"_800":801},"items",[527,561,583,605,624,646,665,691,713,733,752,772],{"_143":159,"_57":528,"_529":530,"_531":532,"_533":534,"_535":517,"_147":536,"_539":540},"ig3000","model","IG3000","name","IG3000 Display Mehrkanalregler","shortDescription","Der Mehrkanalregler verbindet kompatible digitale und analoge Wassersensoren mit einer gemeinsamen Anzeige und Menüführung. Konfigurierbare Ausgänge, Relais und Kommunikationsoptionen unterstützen die Prozessanbindung; eine Haltefunktion für Ausgangssignale erleichtert Arbeiten während der Wartung angeschlossener Sensoren.","featured",{"_57":148,"_537":-5,"_531":109,"_514":-5,"_511":538},"brand",{"_103":109,"_514":-5,"_515":-5,"_516":517},"heroImage",{"_143":541,"_140":378,"_379":542,"_381":543,"_383":544,"_385":545,"_387":546,"_389":547,"_391":548,"_393":549,"_395":550},"d84d4b36-8577-47f5-a6b1-91a7ae3a7c9f","2025040855746689.png","image/png",749999,"8032374cce79b2ec8e8e37dca3798c3058050655937edfc7f06654e8d4ff5b9e",1280,1706,"/igenu-preview/media/8032374cce79b2ec8e8e37dc.png","2026-10-20T17:32:39.748Z",[551,554,557,559],{"_387":398,"_389":552,"_381":400,"_391":553},427,"/igenu-preview/media/c82ee037d25142ee99b2efed.webp",{"_387":403,"_389":555,"_381":400,"_391":556},853,"/igenu-preview/media/8aafd5be554a54bb0699b6bf.webp",{"_387":407,"_389":546,"_381":400,"_391":558},"/igenu-preview/media/4a8ece2b232c4eb15009de8a.webp",{"_387":546,"_389":547,"_381":400,"_391":560},"/igenu-preview/media/288701302fcf6e887f187cad.webp",{"_143":156,"_57":562,"_529":563,"_531":564,"_533":565,"_535":517,"_147":566,"_539":568},"ig30phs","IG30PHS","IG30PHS Digitale pH-Elektrode","Die digitale pH-Elektrode kombiniert Gelbefüllung, ein Referenzsystem mit doppelter Salzbrücke und integrierte Temperaturerfassung. Modbus ermöglicht die Verbindung mit kompatiblen Reglern; Kalibrieroptionen sowie mitgelieferte Halterung und Durchflusszelle unterstützen Installation und Routinebetrieb am Messpunkt der jeweiligen Anlage.",{"_57":148,"_537":-5,"_531":109,"_514":-5,"_511":567},{"_103":109,"_514":-5,"_515":-5,"_516":517},{"_143":569,"_140":378,"_379":570,"_381":382,"_383":571,"_385":572,"_387":573,"_389":574,"_391":575,"_393":576,"_395":577},"7507b7cd-7dc3-42b2-90a4-f843106d4461","2025040859520101.png",19079,"7dfe5452c927d26232963ff85f11073f15b9d29010abcb394bea3ce0f2f502d6",358,302,"/igenu-preview/media/7dfe5452c927d26232963ff8.jpg","2026-10-20T17:32:39.754Z",[578,581],{"_387":398,"_389":579,"_381":400,"_391":580},270,"/igenu-preview/media/93a066c50a54638353b43bbf.webp",{"_387":573,"_389":574,"_381":400,"_391":582},"/igenu-preview/media/b72cc265fa7500183b25c7da.webp",{"_143":175,"_57":584,"_529":585,"_531":586,"_533":587,"_535":517,"_147":588,"_539":590},"ig30rdo","IG30RDO","IG30RDO Optischer Sensor für gelösten Sauerstoff","Die fluoreszenzbasierte Messung erfasst gelösten Sauerstoff ohne Elektrolytwechsel oder Polarisation des Sensors. Integrierte Temperaturkompensation und digitale Kommunikation unterstützen die kontinuierliche Wasserüberwachung; Luft- und Probenkalibrierung ermöglichen die Einrichtung für Anwendungen in Aufbereitung, Umweltüberwachung und Aquakultur.",{"_57":148,"_537":-5,"_531":109,"_514":-5,"_511":589},{"_103":109,"_514":-5,"_515":-5,"_516":517},{"_143":591,"_140":378,"_379":592,"_381":382,"_383":593,"_385":594,"_387":595,"_389":596,"_391":597,"_393":598,"_395":599},"0ddcf618-0714-49aa-9919-74ce97332e9e","2025040860317013.png",19493,"1513162129cbcc0b7fb98e96f5e5a24329832e50befa0944e7b17725123db89a",458,293,"/igenu-preview/media/1513162129cbcc0b7fb98e96.jpg","2026-10-20T17:32:39.769Z",[600,603],{"_387":398,"_389":601,"_381":400,"_391":602},205,"/igenu-preview/media/875a6bfa76d0d60b22d59c3d.webp",{"_387":595,"_389":596,"_381":400,"_391":604},"/igenu-preview/media/676768d13901a89005e95e68.webp",{"_143":212,"_57":606,"_529":607,"_531":608,"_533":609,"_535":517,"_147":610,"_539":612},"ig30ss-sol","IG30SS/SOL","IG30SS/SOL Sensor für Schwebstoffe und Schlammkonzentration","Die Infrarot-Streulichtmessung überwacht Schwebstoffe und Schlammkonzentrationen in Wasser- und Abwasserprozessen. Die digitale Sonde kombiniert optische Kompensation mit einem Saphirfenster; eine optionale Reinigungsbürste begrenzt Ablagerungen auf der Messfläche während der kontinuierlichen Überwachung am jeweiligen Einsatzort.",{"_57":148,"_537":-5,"_531":109,"_514":-5,"_511":611},{"_103":109,"_514":-5,"_515":-5,"_516":517},{"_143":613,"_140":378,"_379":614,"_381":382,"_383":615,"_385":616,"_387":617,"_389":618,"_391":619,"_393":620,"_395":621},"1439d80a-330c-424f-b53e-2863e4ad2437","2025040860527217.png",17952,"fbfabb8705ffee2ab2928de1e179bcbdfff9163bf9562b20f0a57da383e92447",252,303,"/igenu-preview/media/fbfabb8705ffee2ab2928de1.jpg","2026-10-20T17:32:39.774Z",[622],{"_387":617,"_389":618,"_381":400,"_391":623},"/igenu-preview/media/75deeb09829c31a530ddf618.webp",{"_143":299,"_57":625,"_529":626,"_531":627,"_533":628,"_535":517,"_147":629,"_539":631},"ig8100","IG8100","IG8100 Stationärer Gasdetektor mit Alarm","Der stationäre Gasdetektor wird für das benötigte Zielgas konfiguriert und überwacht dessen Konzentration kontinuierlich. Akustische und optische Alarme sowie analoge und digitale Ausgänge ermöglichen die Anbindung an geeignete Steuerungs- und Überwachungssysteme am installierten Messpunkt.",{"_57":295,"_537":-5,"_531":116,"_514":-5,"_511":630},{"_103":116,"_514":-5,"_515":-5,"_516":517},{"_143":632,"_140":378,"_379":633,"_381":382,"_383":634,"_385":635,"_387":636,"_389":637,"_391":638,"_393":639,"_395":640},"a55ad70e-9d54-462e-a2ea-a827378021aa","2018040281324785.jpg",50456,"839a34011d33d0b03a4d61735b7686e5645b3091e52bd34545f51bda446373d6",339,243,"/igenu-preview/media/839a34011d33d0b03a4d6173.jpg","2026-10-20T17:32:39.606Z",[641,644],{"_387":398,"_389":642,"_381":400,"_391":643},229,"/igenu-preview/media/6d839fb13c7f64d9a04f573f.webp",{"_387":636,"_389":637,"_381":400,"_391":645},"/igenu-preview/media/023755c71cd1c8e5ab08db45.webp",{"_143":247,"_57":647,"_529":648,"_531":649,"_533":650,"_535":517,"_147":651,"_539":653},"ig30uvno3","IG30UVNO3","IG30UVNO3 UV-Sensor für Nitratstickstoff","Die UV-Absorptionsmessung erfasst Nitratstickstoff direkt im Wasser, ohne chemische Reagenzien oder separates Probenahmesystem. Wählbare optische Weglängen, Störgrößenkompensation und automatische Reinigung unterstützen den Onlineeinsatz in Trinkwasser, Umweltüberwachung und Abwasserbehandlung sowie die Anpassung an den Messpunkt.",{"_57":148,"_537":-5,"_531":109,"_514":-5,"_511":652},{"_103":109,"_514":-5,"_515":-5,"_516":517},{"_143":654,"_140":378,"_379":655,"_381":382,"_383":656,"_385":657,"_387":658,"_389":659,"_391":660,"_393":661,"_395":662},"79581a81-10c6-426b-80fa-28e7baf03c33","2025040861391349.png",16873,"82c04b6460e5738541de5cfefb589dc0c6890e78350a89fe4e1a3b1a0828a745",263,348,"/igenu-preview/media/82c04b6460e5738541de5cfe.jpg","2026-10-20T17:32:39.799Z",[663],{"_387":658,"_389":659,"_381":400,"_391":664},"/igenu-preview/media/5668d414b7362883ab524969.webp",{"_143":267,"_57":666,"_529":667,"_531":668,"_533":669,"_535":670,"_147":671,"_539":673},"ig1000","IG1000","IG1000 Elektromagnetischer Durchflussmesser","Der elektromagnetische Durchflussmesser erfasst leitfähige Flüssigkeiten wie Wasser und Prozessschlämme. Rohrleitungseinbau und elektrische Ausgänge ermöglichen die Einbindung in die Prozessüberwachung; Elektroden, Auskleidung und Anschlüsse werden passend zum Medium und zur Anwendung ausgewählt.",false,{"_57":263,"_537":-5,"_531":113,"_514":-5,"_511":672},{"_103":113,"_514":-5,"_515":-5,"_516":517},{"_143":674,"_140":378,"_379":675,"_381":382,"_383":676,"_385":677,"_387":678,"_389":679,"_391":680,"_393":681,"_395":682},"ae088e5b-dee3-4d64-a813-8aea3d5faa40","2018040280914617.jpg",79233,"2a75c1e35c4f5d26d0d45a78e4afd1e32e7fc5846f14595ed04ad41691e1ba5a",775,522,"/igenu-preview/media/2a75c1e35c4f5d26d0d45a78.jpg","2026-10-20T17:32:39.599Z",[683,686,689],{"_387":398,"_389":684,"_381":400,"_391":685},216,"/igenu-preview/media/b9d84e037e2e93e539dbc230.webp",{"_387":403,"_389":687,"_381":400,"_391":688},431,"/igenu-preview/media/34a2de4913f859e3b5fd7093.webp",{"_387":678,"_389":679,"_381":400,"_391":690},"/igenu-preview/media/f7cba31a9a75d0b97c8bfde5.webp",{"_143":203,"_57":692,"_529":693,"_531":694,"_533":695,"_535":670,"_147":696,"_539":698},"ig3000lt","IG3000LT","IG3000LT Trübungsanalysator für niedrige Messbereiche","Für die Messung niedriger Trübungen in Trinkwasser und Aufbereitungssystemen kombiniert der Analysator optische Erfassung mit einer Durchflusszelle zur Blasenentfernung. Der modulare Aufbau unterstützt Kalibrierung, Reinigung und Wartung; zusätzlich zur Trübung wird die Temperatur angezeigt.",{"_57":148,"_537":-5,"_531":109,"_514":-5,"_511":697},{"_103":109,"_514":-5,"_515":-5,"_516":517},{"_143":699,"_140":378,"_379":700,"_381":543,"_383":701,"_385":702,"_387":703,"_389":704,"_391":705,"_393":706,"_395":707},"257d01fc-7670-46be-af54-0ae68bffbc45","2025040860761681.jpg",133072,"32687b0fb7e3209190a365f6165fd1befe9616a983cc291c12aca450fcae88b2",327,551,"/igenu-preview/media/32687b0fb7e3209190a365f6.png","2026-10-20T17:32:39.781Z",[708,711],{"_387":398,"_389":709,"_381":400,"_391":710},539,"/igenu-preview/media/f37ebd4fe6509270a9cebcfb.webp",{"_387":703,"_389":704,"_381":400,"_391":712},"/igenu-preview/media/eeb83d74a18b9d4f5cb4ef75.webp",{"_143":160,"_57":714,"_529":715,"_531":716,"_533":717,"_535":670,"_147":718,"_539":720},"ig3000mp-x","IG3000MP-X","IG3000MP-X Multiparameter-Wasseranalysator","Digitale Wechselsonden ermöglichen eine anwendungsbezogene Kombination von pH, gelöstem Sauerstoff, Leitfähigkeit und Trübung. Wasserdichte Anschlüsse und in den Sonden gespeicherte Kalibrierdaten unterstützen den Austausch vor Ort; eine automatische Reinigung hilft, Ablagerungen an den Sensorflächen zu begrenzen.",{"_57":148,"_537":-5,"_531":109,"_514":-5,"_511":719},{"_103":109,"_514":-5,"_515":-5,"_516":517},{"_143":721,"_140":378,"_379":722,"_381":382,"_383":723,"_385":724,"_387":725,"_389":725,"_391":726,"_393":727,"_395":728},"d6d649eb-90c0-469f-9bfb-1c613153f689","2025040861670749.jpg",19258,"9a9243397faa84f675ead5a8a5216895cf7e15c9b82d390083269947f0d00581",540,"/igenu-preview/media/9a9243397faa84f675ead5a8.jpg","2026-10-20T17:32:39.812Z",[729,731],{"_387":398,"_389":398,"_381":400,"_391":730},"/igenu-preview/media/32f08ba6aa513832d0c6c644.webp",{"_387":725,"_389":725,"_381":400,"_391":732},"/igenu-preview/media/61f38d89920b71a6040fa537.webp",{"_143":240,"_57":734,"_529":735,"_531":736,"_533":737,"_535":670,"_147":738,"_539":740},"ig30bga-ig30chl","IG30BGA/IG30CHL","IG30BGA/IG30CHL Blaualgen- und Chlorophyllsensor","Die Fluoreszenzmessung erfasst Blaualgen und Chlorophyll direkt im Wasser, ohne Probenextraktion oder chemische Reagenzien. Digitale Kommunikation unterstützt die kontinuierliche Überwachung; eine optionale Reinigungsbürste begrenzt Ablagerungen an der optischen Messfläche, etwa beim Einsatz an Wasserentnahmestellen.",{"_57":148,"_537":-5,"_531":109,"_514":-5,"_511":739},{"_103":109,"_514":-5,"_515":-5,"_516":517},{"_143":741,"_140":378,"_379":742,"_381":382,"_383":743,"_385":744,"_387":725,"_389":725,"_391":745,"_393":746,"_395":747},"e9c2938f-6236-4c7f-bf9d-752bcf98b444","2025040861512869.jpg",13520,"3a4bd3a9ba0af3bd90061177b116d1a851d9d410ca383514dfbd7fdb3aa5270f","/igenu-preview/media/3a4bd3a9ba0af3bd90061177.jpg","2026-10-20T17:32:39.805Z",[748,750],{"_387":398,"_389":398,"_381":400,"_391":749},"/igenu-preview/media/9fb61c06fe27bcc0e9cecfd6.webp",{"_387":725,"_389":725,"_381":400,"_391":751},"/igenu-preview/media/b63396be40013d2d55e983f5.webp",{"_143":190,"_57":753,"_529":754,"_531":755,"_533":756,"_535":670,"_147":757,"_539":759},"ig30cds","IG30CDS","IG30CDS Leitfähigkeitssensor","Verschiedene Zellkonstanten ermöglichen die Leitfähigkeitsmessung in der Wasseraufbereitung und in industriellem Prozesswasser. Digitale Kommunikation und gespeicherte Kalibrierwerte unterstützen die Systemintegration; die mitgelieferte Halterung und Durchflusszelle erleichtern den Einbau und die Einrichtung am vorgesehenen Messpunkt.",{"_57":148,"_537":-5,"_531":109,"_514":-5,"_511":758},{"_103":109,"_514":-5,"_515":-5,"_516":517},{"_143":760,"_140":378,"_379":761,"_381":382,"_383":762,"_385":763,"_387":764,"_389":764,"_391":765,"_393":766,"_395":767},"97568f30-f32e-4d9a-85ac-2b57a8967181","2025040860050401.jpg",57217,"08cc865f38c95a6b72364eaf3f6b94912df92297b7cb4dbcdb9d9d327b79dd1c",500,"/igenu-preview/media/08cc865f38c95a6b72364eaf.jpg","2026-10-20T17:32:39.763Z",[768,770],{"_387":398,"_389":398,"_381":400,"_391":769},"/igenu-preview/media/6f7c525ac57d10f270f2e15f.webp",{"_387":764,"_389":764,"_381":400,"_391":771},"/igenu-preview/media/d8eaca92b7d0ec37a6ee861d.webp",{"_143":182,"_57":773,"_529":774,"_531":775,"_533":776,"_535":670,"_147":777,"_539":779},"ig30cls","IG30CLS","IG30CLS Restchlorsensor","Der Sensor misst Restchlor und Chlordioxid im Wasser nach einem elektrochemischen Verfahren mit konstantem Potenzial. Eine abgestimmte Durchflusszelle führt die Probe; kolorimetrische Reagenzien sowie ein regelmäßiger Austausch von Membranen oder Elektrolyt sind dabei nicht erforderlich.",{"_57":148,"_537":-5,"_531":109,"_514":-5,"_511":778},{"_103":109,"_514":-5,"_515":-5,"_516":517},{"_143":780,"_140":378,"_379":781,"_381":382,"_383":782,"_385":783,"_387":784,"_389":785,"_391":786,"_393":787,"_395":788},"ce0b8383-b6df-4c9a-aabb-3a55435db7a7","2025040861142109.png",22021,"128cbf77e27c44f50a679ba8b27ec860b8243697fccdc4f64b056e6497df3a79",344,423,"/igenu-preview/media/128cbf77e27c44f50a679ba8.jpg","2026-10-20T17:32:39.792Z",[789,792],{"_387":398,"_389":790,"_381":400,"_391":791},393,"/igenu-preview/media/e07f5ef0e1a47e02ed6259ae.webp",{"_387":784,"_389":785,"_381":400,"_391":793},"/igenu-preview/media/ecb94564bb6e1f06cbfde7cd.webp","page",1,"pageSize",12,"total",37,"totalPages",4,"categories",[804,806,808],{"_57":148,"_537":-5,"_531":109,"_514":-5,"_511":805},{"_103":109,"_514":-5,"_515":-5,"_516":517},{"_57":263,"_537":-5,"_531":113,"_514":-5,"_511":807},{"_103":113,"_514":-5,"_515":-5,"_516":517},{"_57":295,"_537":-5,"_531":116,"_514":-5,"_511":809},{"_103":116,"_514":-5,"_515":-5,"_516":517},{"_57":58,"_103":60,"_811":812,"_827":828,"_511":512},"sections",[813],{"_143":814,"_815":816,"_7":817,"_824":-5,"_825":826},"3b0fa1c1-2b06-40a5-ba88-59eb543c4efe","type","TEXT_IMAGE",{"_818":819,"_820":821,"_822":823},"body","Instrumente nach Produktfamilie, Parameter oder Anwendung entdecken.","heading","Klarheit für jede Messaufgabe.","imagePosition","right","media","mediaItems",[],"supportDownloads",[]]
