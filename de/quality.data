ion",[102,118],{"_103":104,"_105":106},"title","产品","links",[107,112,115],{"_108":109,"_110":111},"label","Wasseranalyse","href","/de/products?category=water",{"_108":113,"_110":114},"Industrielle Messung","/de/products?category=industrial",{"_108":116,"_110":117},"Gasdetektion","/de/products?category=gas",{"_103":119,"_105":120},"了解更多",[121,124,127,130,133],{"_108":122,"_110":123},"关于我们","/de/about",{"_108":125,"_110":126},"客户案例","/de/cases",{"_108":128,"_110":129},"新闻中心","/de/news",{"_108":131,"_110":132},"售后服务","/de/service",{"_108":134,"_110":135},"下载中心","/de/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","quality",[],[],"seo",{"_103":146,"_147":91,"_148":-5,"_149":150},"Qualitätssystem | IGENU SCIENCE","description","imageUrl","index",true,"canonical","https://eicloc.github.io/igenu-preview/de/quality","query",{},"selected",[],"page",{"_57":141,"_103":159,"_160":161,"_230":231,"_144":145},"Qualitätssystem","sections",[162],{"_163":164,"_165":166,"_7":167,"_185":186,"_222":223},"id","907defe6-e83a-4916-9bba-c6015179e197","type","TEXT_IMAGE",{"_168":38,"_169":170,"_171":172,"_173":174,"_183":184},"body","heading","qualität in den dienst der messungen","bodyHtml","<p>seit seiner inbetriebnahme, igenu kontinuierlich verbessert und die qualität seiner dienstleistungen entwickelt, mit einem sehr genauen zielsetzung:</p><p>kundenzufriedenheit</p><p>zu prüfen und lösungen vorschlagen, perfekt an ständig wechselnden anforderungen der kunden</p><p>für igenu, experte für die analyse, die qualität ist sein motto.regeln und verfahren gelten für alle ebenen, von der planung bis zur produktion, verkauf und schließlich die after - sales - service.</p><p>zusätzlich zu dieser qualität, die hoch technologischen bereich überwachung erfordert höchste aufmerksamkeit nicht nur auf die fähigkeiten und qualifikationen der mitarbeiter, aber auch für ihre sicherheit.</p>","sourceNotes",[175],{"_103":176,"_177":150,"_171":178,"_179":180,"_181":182},"QUALITÄT","p