on",[102,118],{"_103":104,"_105":106},"title","产品","links",[107,112,115],{"_108":109,"_110":111},"label","Wasseranalyse","href","/de/products?category=water",{"_108":113,"_110":114},"Industrielle Messung","/de/products?category=industrial",{"_108":116,"_110":117},"Gasdetektion","/de/products?category=gas",{"_103":119,"_105":120},"了解更多",[121,124,127,130,133],{"_108":122,"_110":123},"关于我们","/de/about",{"_108":125,"_110":126},"客户案例","/de/cases",{"_108":128,"_110":129},"新闻中心","/de/news",{"_108":131,"_110":132},"售后服务","/de/service",{"_108":134,"_110":135},"下载中心","/de/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind",[],[],"seo",{"_103":145,"_146":91,"_147":-5,"_148":149},"Kundendienst & Support | IGENU SCIENCE","description","imageUrl","index",true,"canonical","https://eicloc.github.io/igenu-preview/de/service","query",{},"selected",[],"page",{"_57":82,"_103":158,"_159":160,"_228":229,"_143":144},"Kundendienst & Support","sections",[161],{"_162":163,"_164":165,"_7":166,"_183":184,"_220":221},"id","5fa1c174-4e0b-43d6-8b3f-6713acf93284","type","TEXT_IMAGE",{"_167":38,"_168":169,"_170":171,"_172":173,"_181":182},"body","heading","AFTER SALES POLITITK","bodyHtml","<p>Reparatur - service: reparaturen und / oder standard - austausch, abhängig von den anforderungen unserer kunden</p><p>kunden - ausbildung zur optimierung der nutzung unserer analysegeräte</p><p>ersatzteile: spielbaren teile auf lager</p><p>Inbetriebnahme der analysatoren und ausbildung der mitarbeiter vor ort</p><p>bedienung auf nachfrage der störungsbeseitigungen</p><p>regelmäßige besuche für wartungsverträge, verschiedene arten von verträgen angeboten.</p><p>Unsere ausländischen agenten werden regelmäßig schulungen für alle unsere produkte.</p>","sourceNotes",[174],{"_103":169,"_175":149,"_170":176,"_177":178,"_179":180},"pending","<p>Heute die kundenzufriedenheit ist ig environnement ist leitmotiv.um sicherzustellen, dass wir effizient sind in diesem bereich bieten wir eine multi - service - after - sales - abteilung.</p><p>Eine after - sales - service mit sitz in aix en provence</p><p>technische unterstützung: unsere servicetechniker verpflichten sich zur antwort auf ihre fragen per telefon oder per e - mail innerhalb von 24 stunden</p><p>ein team von spezialisten für deutschland (und auf der ganzen welt zu gewährleisten, wenn nötig)</p>","sourceUrl","http://www.igenu.com/de/AFTER.html","capturedAt","2026-10-21T04:13:22.254Z","imagePosition","right","media",{"_162":185,"_140":186,"_187":188,"_189":190,"_191":192,"_193":194,"_195":196,"_197":198,"_199":200,"_201":202,"_203":204},"d3e2e0bf-fc98-4a22-9168-db57e6e95770","IMAGE","originalName","banner2.jpg","mimeType","image/jpeg","size",156061,"sha256","bf2e04a4abd73a498193b401022db731baba02809ff40e8fe8bd9941403c65be","width",1200,"height",334,"url","/igenu-preview/media/bf2e04a4abd73a498193b401.jpg","createdAt","2026-10-20T17:32:39.538Z","variants",[205,210,214,218],{"_195":206,"_197":207,"_189":208,"_199":209},320,89,"image/webp","/igenu-preview/media/4194935bea57b6acc00f076e.webp",{"_195":211,"_197":212,"_189":208,"_199":213},640,178,"/igenu-preview/media/f624da608982a3225f43d227.webp",{"_195":215,"_197":216,"_189":208,"_199":217},960,267,"/igenu-preview/media/85eff24a5e704ee762de52e4.webp",{"_195":196,"_197":198,"_189":208,"_199":219},"/igenu-preview/media/8b18a9e61d8ab43663cb4651.webp","mediaItems",[222],{"_162":185,"_140":186,"_187":188,"_189":190,"_191":192,"_193":194,"_195":196,"_197":198,"_199":200,"_201":202,"_203":223},[224,225,226,227],{"_195":206,"_197":207,"_189":208,"_199":209},{"_195":211,"_197":212,"_189":208,"_199":213},{"_195":215,"_197":216,"_189":208,"_199":217},{"_195":196,"_197":198,"_189":208,"_199":219},"supportDownloads",[]]
