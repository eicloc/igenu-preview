ion",[102,118],{"_103":104,"_105":106},"title","产品","links",[107,112,115],{"_108":109,"_110":111},"label","Wasseranalyse","href","/de/products?category=water",{"_108":113,"_110":114},"Industrielle Messung","/de/products?category=industrial",{"_108":116,"_110":117},"Gasdetektion","/de/products?category=gas",{"_103":119,"_105":120},"了解更多",[121,124,127,130,133],{"_108":122,"_110":123},"关于我们","/de/about",{"_108":125,"_110":126},"客户案例","/de/cases",{"_108":128,"_110":129},"新闻中心","/de/news",{"_108":131,"_110":132},"售后服务","/de/service",{"_108":134,"_110":135},"下载中心","/de/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","wastewater",[],[],"seo",{"_103":146,"_147":148,"_149":-5,"_150":151},"Abwasser | IGENU SCIENCE","description","Wasser und Schlamm im Behandlungsprozess verstehen.","imageUrl","index",true,"canonical","https://eicloc.github.io/igenu-preview/de/applications/wastewater","query",{},"selected",[],"knowledge",{"_160":161,"_140":162,"_57":141,"_163":164,"_103":165,"_166":148,"_167":168,"_169":170,"_206":207,"_58":237,"_831":832},"id","e90f8976-faba-4cad-9f5d-cbde34192263","APPLICATION","category","water","Abwasser","summary","bodyHtml","<p>Abwasseranwendungen umfassen unterschiedliche Messaufgaben. Instrumente für pH, gelösten Sauerstoff, Schwebstoffe, Schlammkonzentration und Nährstoffe dienen der Überwachung relevanter Prozessschritte. Prüfen Sie Messbereich und Einbaubedingungen jedes Instruments.</p>","cover",{"_160":171,"_140":172,"_173":174,"_175":176,"_177":178,"_179":180,"_181":182,"_183":184,"_185":186,"_187":188,"_189":190},"4b48352c-4bd9-48ab-9944-50eb658528f4","IMAGE","originalName","sybanner3.jpg","mimeType","image/jpeg","size",208005,"sha256","e356f85dd5122e366f1147eb7bd7cf6f1d2638f9780451966abf1e2ac52915e3","width",1200,"height",334,"url","/igenu-preview/media/e356f85dd5122e366f1147eb.jpg","createdAt","2026-10-20T17:32:39.591Z","variants",[191,196,200,204],{"_181":192,"_183":193,"_175":194,"_185":195},320,89,"image/webp","/ig