ion",[102,118],{"_103":104,"_105":106},"title","产品","links",[107,112,115],{"_108":109,"_110":111},"label","Wasseranalyse","href","/de/products?category=water",{"_108":113,"_110":114},"Industrielle Messung","/de/products?category=industrial",{"_108":116,"_110":117},"Gasdetektion","/de/products?category=gas",{"_103":119,"_105":120},"了解更多",[121,124,127,130,133],{"_108":122,"_110":123},"关于我们","/de/about",{"_108":125,"_110":126},"客户案例","/de/cases",{"_108":128,"_110":129},"新闻中心","/de/news",{"_108":131,"_110":132},"售后服务","/de/service",{"_108":134,"_110":135},"下载中心","/de/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","gas-safety",[],[],"seo",{"_103":146,"_147":148,"_149":-5,"_150":151},"Gasüberwachung | IGENU SCIENCE","description","Stationäre und tragbare Instrumente zur Konzentrationsüberwachung.","imageUrl","index",true,"canonical","https://eicloc.github.io/igenu-preview/de/applications/gas-safety","query",{},"selected",[],"knowledge",{"_160":161,"_140":162,"_57":141,"_163":164,"_103":165,"_166":148,"_167":168,"_169":170,"_206":207,"_58":212,"_307":308},"id","0ac612fd-a006-488b-94bc-442a2b4273c3","APPLICATION","category","gas","Gasüberwachung","summary","bodyHtml","<p>Entdecken Sie stationäre und tragbare Gasdetektoren sowie Instrumente zur Geruchsüberwachung. Erfassbare Gase, Messbereiche und Schnittstellen hängen von Modell und Konfiguration ab. Besprechen Sie Zielgas und Betriebsbedingungen mit unserem Team.</p>","cover",{"_160":171,"_140":172,"_173":174,"_175":176,"_177":178,"_179":180,"_181":182,"_183":184,"_185":186,"_187":188,"_189":190},"80c049fc-40ad-4323-9a25-c2cca9f27648","IMAGE","originalName","banner5.jpg","mimeType","image/jpeg","size",179706,"sha256","1a37cf51eb0d1214c061c8ba7603a9ebf13ba78e6de2501e0a99fadc4adf4436","width",1200,"height",334,"url","/igenu-preview/media/1a37cf51eb0d1214c061c8ba.jpg","createdAt","2026-10-20T17:32:39.557Z","variants",[191,196,200,204],{"_181":192,"_183":193,"_175":194,"_185":195},320,89,"image/webp","/igenu-preview/media/1f5d3fc4303b503be10d1a7d.webp",{"_181":197,"_183":198,"_175":194,"_185":199},640,178,"/igenu-preview/media/f1c479027edd7c1eeb3cef4f.webp",{"_181":201,"_183":202,"_175":194,"_185":203},960,267,"/igenu-preview/media/64ad6ec0c7d8ae6a3937f3f9.webp",{"_181":182,"_183":184,"_175":194,"_185":205},"/igenu-preview/media/a68a1914bdb031107cff6a6c.webp","productIds",[208,209,210,211],"f3e2a88e-adb6-4f1f-8997-8600b01faa5a","c21fd893-48c8-47d3-a114-c7748db71a81","d712539f-bba5-44ea-9c7e-5be89c6d40ac","0ebe2f55-73e5-48ce-b7d2-aab462d75429",[213,241,263,288],{"_160":208,"_57":214,"_215":216,"_217":218,"_219":220,"_221":151,"_163":222,"_225":226},"ig8100","model","IG8100","name","IG8100 Stationärer Gasdetektor mit Alarm","shortDescription","Der stationäre Gasdetektor wird für das benötigte Zielgas konfiguriert und überwacht dessen Konzentration kontinuierlich. Akustische und optische Alarme sowie analoge und digitale Ausgänge ermöglichen die Anbindung an geeignete Steuerungs- und Überwachungssysteme am installierten Messpunkt.","featured",{"_57":164,"_223":-5,"_217":116,"_147":-5,"_144":224},"brand",{"_103":116,"_147":-5,"_149":-5,"_150":151},"heroImage",{"_160":227,"_140":172,"_173":228,"_175":176,"_177":229,"_179":230,"_181":231,"_183":232,"_185":233,"_187":234,"_189":235},"a55ad70e-9d54-462e-a2ea-a827378021aa","2018040281324785.jpg",50456,"839a34011d33d0b03a4d61735b7686e5645b3091e52bd34545f51bda446373d6",339,243,"/igenu-preview/media/839a34011d33d0b03a4d6173.jpg","2026-10-20T17:32:39.606Z",[236,239],{"_181":192,"_183":237,"_175":194,"_185":238},229,"/igenu-preview/media/6d839fb13c7f64d9a04f573f.webp",{"_181":231,"_183":232,"_175":194,"_185":240},"/igenu-preview/media/023755c71cd1c8e5ab08db45.webp",{"_160":209,"_57":242,"_215":243,"_217":244,"_219":245,"_221":246,"_163":247,"_225":250},"ig70vm","IG70VM","IG70VM Thermischer Gasmassendurchflussmesser","Die thermische Messung bestimmt den Gasmassenstrom anhand eines beheizten Referenzelements und eines Temperaturvergleichs. Ohne bewegliche Sensorkomponenten und mit wählbaren Signalschnittstellen unterstützt das Gerät die Gasdurchflussüberwachung in petrochemischen Anlagen, Energieerzeugung und metallurgischen Prozessen am Messpunkt.",false,{"_57":248,"_223":-5,"_217":113,"_147":-5,"_144":249},"industrial",{"_103":113,"_147":-5,"_149":-5,"_150":151},{"_160":251,"_140":172,"_173":252,"_175":253,"_177":254,"_179":255,"_181":256,"_183":257,"_185":258,"_187":259,"_189":260},"287d31f2-573d-40b0-8a95-78fa8fb30365","2025040855196033.jpg","image/png",118746,"7f449f38ed6bf8e134b99b22ebc9fa0c38477f3744c6a59cd166d471f92c6feb",255,555,"/igenu-preview/media/7f449f38ed6bf8e134b99b22.png","2026-10-20T17:32:39.741Z",[261],{"_181":256,"_183":257,"_175":194,"_185":262},"/igenu-preview/media/e43bee78aa0a1ae068fb4bf4.webp",{"_160":210,"_57":264,"_215":265,"_217":266,"_219":267,"_221":246,"_163":268,"_225":270},"ig8100mp","IG8100MP","IG8100MP Tragbarer Gasdetektor mit Alarm","Der tragbare Gasdetektor nutzt eine integrierte Pumpe zur Probenahme und wird mit Sensoren für die gewünschten Zielgase ausgestattet. Ein Farbdisplay zeigt Messinformationen; akustische, optische und Vibrationsalarme unterstützen die Wahrnehmung des Gerätestatus bei mobilen Kontrollen.",{"_57":164,"_223":-5,"_217":116,"_147":-5,"_144":269},{"_103":116,"_147":-5,"_149":-5,"_150":151},{"_160":271,"_140":172,"_173":272,"_175":253,"_177":273,"_179":274,"_181":275,"_183":276,"_185":277,"_187":278,"_189":279},"2c4a4ac6-d50b-4737-b7e4-ebc32635cd6c","2025040852237053.png",280168,"08e61223b82894782eed918587b2b8ae3b4fa6fbbb2b5228bbfebeca395a748a",691,699,"/igenu-preview/media/08e61223b82894782eed9185.png","2026-10-20T17:32:39.713Z",[280,283,286],{"_181":192,"_183":281,"_175":194,"_185":282},324,"/igenu-preview/media/5f86a27572b4892ac922fa01.webp",{"_181":197,"_183":284,"_175":194,"_185":285},647,"/igenu-preview/media/56eed4aed7ff6130c91bdc9f.webp",{"_181":275,"_183":276,"_175":194,"_185":287},"/igenu-preview/media/50e8b14977630a4f3e555596.webp",{"_160":211,"_57":289,"_215":290,"_217":291,"_219":292,"_221":246,"_163":293,"_225":295},"ig8300voc","IG8300VOC","IG8300VOC Onlinesystem zur Geruchs- und Gasüberwachung","Das System überwacht konfigurierte geruchsrelevante Gase mit mehreren Sensoren, Probenvorbehandlung, Temperaturkompensation und automatischer Kalibrierung. Integrierte Anzeige, Datenspeicherung und Kommunikationsoptionen unterstützen die vernetzte Umweltüberwachung an Abwasseranlagen, Chemiestandorten und Abfallbehandlungsanlagen sowie die Anbindung an das Überwachungssystem.",{"_57":164,"_223":-5,"_217":116,"_147":-5,"_144":294},{"_103":116,"_147":-5,"_149":-5,"_150":151},{"_160":296,"_140":172,"_173":297,"_175":176,"_177":298,"_179":299,"_181":300,"_183":301,"_185":302,"_187":303,"_189":304},"248b037a-97ca-43b1-abac-a26d2deaf089","2025040852682581.png",22439,"97c97b1129c8237eb4b7d324799035ec948f856036b41f67613d22e0171553b0",194,421,"/igenu-preview/media/97c97b1129c8237eb4b7d324.jpg","2026-10-20T17:32:39.720Z",[305],{"_181":300,"_183":301,"_175":194,"_185":306},"/igenu-preview/media/51378fe539ff38c9e791e3c9.webp","sourceSections",[309],{"_160":310,"_311":312,"_7":313,"_328":-5,"_329":330},"96ef603c-983d-4756-aabc-11adbd6856b5","type","TEXT_IMAGE",{"_314":38,"_315":165,"_167":38,"_316":317,"_326":327},"body","heading","sourceNotes",[318],{"_103":319,"_320":151,"_167":321,"_322":323,"_324":325},"Schädliche/Brennbares Gas","pending","<p>Schädliche /Brennbares gas.</p><p>drei grundlegende arten von risiken</p><p>sauerstoff-mangel und anreicherung</p><p>brennbare gase und dämpfe</p><p>giftige schadstoffe</p><p>wir werden bestimmt, ersticken die haupttodesursache in geschlossenen räumen.die luft ist sauerstoff mangel, wenn die konzentration unter 19,5% o2.</p><p>Vergiftung</p><p>als lel sensor vergiftet wird die sensoren oberfläche und die sensoren poren werden oxidiert silikon überzogen.</p><p>silikon sensor wird sich seine fähigkeit als vergiftet zu erkennen, methan, zwar nicht mit einer merklichen hemmung zu erkennen, andere brennbare gase.</p><p>als die der lel - vergiftung führt irgendwann zu verlieren, ist die fähigkeit zu erkennen, brennbare gase.</p><p>von sensoren giftige gase</p><p>kohlenmonoxid (co)</p><p>schwefelwasserstoff (h2s)</p><p>kombination sensoren zur verfügung</p><p>schwefeldioxid (so2)</p><p>chlor (cl2 / chlordioxid (clo2)</p><p>ammoniak (nh3)</p><p>phosphine (ph3)</p><p>stickstoffdioxid (no2)</p><p>blausäure (hcn)</p><p>stickstoffmonoxid (no)</p>","sourceUrl","http://www.igenu.com/de/index_2.html","capturedAt","2026-10-21T04:13:22.254Z","imagePosition","right","media","mediaItems",[]]
