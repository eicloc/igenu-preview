ion",[102,118],{"_103":104,"_105":106},"title","产品","links",[107,112,115],{"_108":109,"_110":111},"label","Wasseranalyse","href","/de/products?category=water",{"_108":113,"_110":114},"Industrielle Messung","/de/products?category=industrial",{"_108":116,"_110":117},"Gasdetektion","/de/products?category=gas",{"_103":119,"_105":120},"了解更多",[121,124,127,130,133],{"_108":122,"_110":123},"关于我们","/de/about",{"_108":125,"_110":126},"客户案例","/de/cases",{"_108":128,"_110":129},"新闻中心","/de/news",{"_108":131,"_110":132},"售后服务","/de/service",{"_108":134,"_110":135},"下载中心","/de/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","drinking-water",[],[],"seo",{"_103":146,"_147":148,"_149":-5,"_150":151},"Trinkwasser | IGENU SCIENCE","description","Messung in Aufbereitung und Verteilung.","imageUrl","index",true,"canonical","https://eicloc.github.io/igenu-preview/de/applications/drinking-water","query",{},"selected",[],"knowledge",{"_160":161,"_140":162,"_57":141,"_163":164,"_103":165,"_166":148,"_167":168,"_169":170,"_206":207,"_58":231,"_661":662},"id","f7ce5bd6-9b75-467f-bee9-eb8ab23e63a7","APPLICATION","category","water","Trinkwasser","summary","bodyHtml","<p>Die Trinkwasserüberwachung umfasst Zulauf, Aufbereitungsprozess, Anlagenablauf und Verteilungsnetz. Entdecken Sie Instrumente für pH, Trübung, Leitfähigkeit und Restchlor entsprechend den jeweiligen Modellspezifikationen.</p>","cover",{"_160":171,"_140":172,"_173":174,"_175":176,"_177":178,"_179":180,"_181":182,"_183":184,"_185":186,"_187":188,"_189":190},"b507b9b5-7eb5-4173-83ee-fb266501df22","IMAGE","originalName","sybanner1.jpg","mimeType","image/jpeg","size",283339,"sha256","ea117bc117aac471ac0e6bf3d42bbcb7c2d8490f1e1ce04797ff680bdc98eee8","width",1200,"height",334,"url","/igenu-preview/media/ea117bc117aac471ac0e6bf3.jpg","createdAt","2026-10-20T17:32:39.579Z","variants",[191,196,200,204],{"_181":192,"_183":193,"_175":194,"_185":195},320,89,"image/webp","/igenu-preview/media/8d8bf753a2b1b2b52b429720.webp",{"_181":197,"_183":198,"_175":194,"_185":199},640,178,"/igenu-preview/media/89deca543eca96e5ed6c71c3.webp",{"_181":201,"_183":202,"_175":194,"_185":203},960,267,"/igenu-preview/media/0c66b0a832f4356f7667fdc3.webp",{"_181":182,"_183":184,"_175":194,"_185":205},"/igenu-preview/media/53d0854ee8163d7eeee592d7.webp","productIds",[208,209,210,211,212,213,214,215,216,217,218,219,220,221,222,223,224,225,226,227,228,229,230],"331a2881-86de-42d4-aad2-8985fb41f4ba","f607cd0f-5835-4426-b788-827be959a3fc","9d824bcb-a360-4cc5-9c05-f39f8c5afaa3","a5b76360-49f2-40e8-aeb2-c79f30115f7c","4df5cf04-3393-4883-9cb6-f83c88032cc8","27f7a7c7-2e6f-4394-8a3b-e1d66ae51c83","df5b5971-b8ab-4461-9dd3-21bd164a9ff2","f33fa081-7e09-4283-a1f0-899eb8c5a37c","979b50bb-1b83-4aa2-b03a-464c97387d69","beabf1d3-ee7e-4d27-92b1-039290c217dc","0edda979-2d5f-4caa-bde7-a1368da21597","ca3ec482-3741-46d1-bf9e-a1da33a8c095","f98a1a11-9b74-4b87-a91b-1548d296a61a","443d766d-df72-4a5d-a984-9164160231c6","99bf2912-77d5-49a2-8d9e-8eedee30d193","dfbb0b65-0921-4d76-820c-bc18ebd08c71","caa08499-feb7-4ba5-a00f-5383e3318a7b","db61c5f5-bfca-49a7-a45f-f4768be3a5dc","879c4612-34a5-41ef-a5f2-419989ad469e","f339fd2d-ce7e-4de5-80dc-4651311a7f1c","0a1adde0-ea7b-4a40-b71e-a3b127b921f4","43425fa1-18a8-4ebe-995e-466a914f67da","12c35e01-af3a-4ad0-b514-1b67363212af",[232,260,282,301,320,344,364,383,403,425,444,462,473,484,495,506,525,547,565,575,585,595,630],{"_160":208,"_57":233,"_234":235,"_236":237,"_238":239,"_240":151,"_163":241,"_244":245},"ig30phs","model","IG30PHS","name","IG30PHS Digitale pH-Elektrode","shortDescription","Die digitale pH-Elektrode kombiniert Gelbefüllung, ein Referenzsystem mit doppelter Salzbrücke und integrierte Temperaturerfassung. Modbus ermöglicht die Verbindung mit kompatiblen Reglern; Kalibrieroptionen sowie mitgelieferte Halterung und Durchflusszelle unterstützen Installation und Routinebetrieb am Messpunkt der jeweiligen Anlage.","featured",{"_57":164,"_242":-5,"_236":109,"_147":-5,"_144":243},"brand",{"_103":109,"_147":-5,"_149":-5,"_150":151},"heroImage",{"_160":246,"_140":172,"_173":247,"_175":176,"_177":248,"_179":249,"_181":250,"_183":251,"_185":252,"_187":253,"_189":254},"7507b7cd-7dc3-42b2-90a4-f843106d4461","2025040859520101.png",19079,"7dfe5452c927d26232963ff85f11073f15b9d29010abcb394bea3ce0f2f502d6",358,302,"/igenu-preview/media/7dfe5452c927d26232963ff8.jpg","2026-10-20T17:32:39.754Z",[255,258],{"_181":192,"_183":256,"_175":194,"_185":257},270,"/igenu-preview/media/93a066c50a54638353b43bbf.webp",{"_181":250,"_183":251,"_175":194,"_185":259},"/igenu-preview/media/b72cc265fa7500183b25c7da.webp",{"_160":209,"_57":261,"_234":262,"_236":263,"_238":264,"_240":151,"_163":265,"_244":267},"ig30rdo","IG30RDO","IG30RDO Optischer Sensor für gelösten Sauerstoff","Die fluoreszenzbasierte Messung erfasst gelösten Sauerstoff ohne Elektrolytwechsel oder Polarisation des Sensors. Integrierte Temperaturkompensation und digitale Kommunikation unterstützen die kontinuierliche Wasserüberwachung; Luft- und Probenkalibrierung ermöglichen die Einrichtung für Anwendungen in Aufbereitung, Umweltüberwachung und Aquakultur.",{"_57":164,"_242":-5,"_236":109,"_147":-5,"_144":266},{"_103":109,"_147":-5,"_149":-5,"_150":151},{"_160":268,"_140":172,"_173":269,"_175":176,"_177":270,"_179":271,"_181":272,"_183":273,"_185":274,"_187":275,"_189":276},"0ddcf618-0714-49aa-9919-74ce97332e9e","2025040860317013.png",19493,"1513162129cbcc0b7fb98e96f5e5a24329832e50befa0944e7b17725123db89a",458,293,"/igenu-preview/media/1513162129cbcc0b7fb98e96.jpg","2026-10-20T17:32:39.769Z",[277,280],{"_181":192,"_183":278,"_175":194,"_185":279},205,"/igenu-preview/media/875a6bfa76d0d60b22d59c3d.webp",{"_181":272,"_183":273,"_175":194,"_185":281},"/igenu-preview/media/676768d13901a89005e95e68.webp",{"_160":210,"_57":283,"_234":284,"_236":285,"_238":286,"_240":151,"_163":287,"_244":289},"ig30ss-sol","IG30SS/SOL","IG30SS/SOL Sensor für Schwebstoffe und Schlammkonzentration","Die Infrarot-Streulichtmessung überwacht Schwebstoffe und Schlammkonzentrationen in Wasser- und Abwasserprozessen. Die digitale Sonde kombiniert optische Kompensation mit einem Saphirfenster; eine optionale Reinigungsbürste begrenzt Ablagerungen auf der Messfläche während der kontinuierlichen Überwachung am jeweiligen Einsatzort.",{"_57":164,"_242":-5,"_236":109,"_147":-5,"_144":288},{"_103":109,"_147":-5,"_149":-5,"_150":151},{"_160":290,"_140":172,"_173":291,"_175":176,"_177":292,"_179":293,"_181":294,"_183":295,"_185":296,"_187":297,"_189":298},"1439d80a-330c-424f-b53e-2863e4ad2437","2025040860527217.png",17952,"fbfabb8705ffee2ab2928de1e179bcbdfff9163bf9562b20f0a57da383e92447",252,303,"/igenu-preview/media/fbfabb8705ffee2ab2928de1.jpg","2026-10-20T17:32:39.774Z",[299],{"_181":294,"_183":295,"_175":194,"_185":300},"/igenu-preview/media/75deeb09829c31a530ddf618.webp",{"_160":211,"_57":302,"_234":303,"_236":304,"_238":305,"_240":151,"_163":306,"_244":308},"ig30uvno3","IG30UVNO3","IG30UVNO3 UV-Sensor für Nitratstickstoff","Die UV-Absorptionsmessung erfasst Nitratstickstoff direkt im Wasser, ohne chemische Reagenzien oder separates Probenahmesystem. Wählbare optische Weglängen, Störgrößenkompensation und automatische Reinigung unterstützen den Onlineeinsatz in Trinkwasser, Umweltüberwachung und Abwasserbehandlung sowie die Anpassung an den Messpunkt.",{"_57":164,"_242":-5,"_236":109,"_147":-5,"_144":307},{"_103":109,"_147":-5,"_149":-5,"_150":151},{"_160":309,"_140":172,"_173":310,"_175":176,"_177":311,"_179":312,"_181":313,"_183":314,"_185":315,"_187":316,"_189":317},"79581a81-10c6-426b-80fa-28e7baf03c33","2025040861391349.png",16873,"82c04b6460e5738541de5cfefb589dc0c6890e78350a89fe4e1a3b1a0828a745",263,348,"/igenu-preview/media/82c04b6460e5738541de5cfe.jpg","2026-10-20T17:32:39.799Z",[318],{"_181":313,"_183":314,"_175":194,"_185":319},"/igenu-preview/media/5668d414b7362883ab524969.webp",{"_160":212,"_57":321,"_234":322,"_236":323,"_238":324,"_240":325,"_163":326,"_244":328},"ig3000lt","IG3000LT","IG3000LT Trübungsanalysator für niedrige Messbereiche","Für die Messung niedriger Trübungen in Trinkwasser und Aufbereitungssystemen kombiniert der Analysator optische Erfassung mit einer Durchflusszelle zur Blasenentfernung. Der modulare Aufbau unterstützt Kalibrierung, Reinigung und Wartung; zusätzlich zur Trübung wird die Temperatur angezeigt.",false,{"_57":164,"_242":-5,"_236":109,"_147":-5,"_144":327},{"_103":109,"_147":-5,"_149":-5,"_150":151},{"_160":329,"_140":172,"_173":330,"_175":331,"_177":332,"_179":333,"_181":334,"_183":335,"_185":336,"_187":337,"_189":338},"257d01fc-7670-46be-af54-0ae68bffbc45","2025040860761681.jpg","image/png",133072,"32687b0fb7e3209190a365f6165fd1befe9616a983cc291c12aca450fcae88b2",327,551,"/igenu-preview/media/32687b0fb7e3209190a365f6.png","2026-10-20T17:32:39.781Z",[339,342],{"_181":192,"_183":340,"_175":194,"_185":341},539,"/igenu-preview/media/f37ebd4fe6509270a9cebcfb.webp",{"_181":334,"_183":335,"_175":194,"_185":343},"/igenu-preview/media/eeb83d74a18b9d4f5cb4ef75.webp",{"_160":213,"_57":345,"_234":346,"_236":347,"_238":348,"_240":325,"_163":349,"_244":351},"ig3000mp-x","IG3000MP-X","IG3000MP-X Multiparameter-Wasseranalysator","Digitale Wechselsonden ermöglichen eine anwendungsbezogene Kombination von pH, gelöstem Sauerstoff, Leitfähigkeit und Trübung. Wasserdichte Anschlüsse und in den Sonden gespeicherte Kalibrierdaten unterstützen den Austausch vor Ort; eine automatische Reinigung hilft, Ablagerungen an den Sensorflächen zu begrenzen.",{"_57":164,"_242":-5,"_236":109,"_147":-5,"_144":350},{"_103":109,"_147":-5,"_149":-5,"_150":151},{"_160":352,"_140":172,"_173":353,"_175":176,"_177":354,"_179":355,"_181":356,"_183":356,"_185":357,"_187":358,"_189":359},"d6d649eb-90c0-469f-9bfb-1c613153f689","2025040861670749.jpg",19258,"9a9243397faa84f675ead5a8a5216895cf7e15c9b82d390083269947f0d00581",540,"/igenu-preview/media/9a9243397faa84f675ead5a8.jpg","2026-10-20T17:32:39.812Z",[360,362],{"_181":192,"_183":192,"_175":194,"_185":361},"/igenu-preview/media/32f08ba6aa513832d0c6c644.webp",{"_181":356,"_183":356,"_175":194,"_185":363},"/igenu-preview/media/61f38d89920b71a6040fa537.webp",{"_160":214,"_57":365,"_234":366,"_236":367,"_238":368,"_240":325,"_163":369,"_244":371},"ig30bga-ig30chl","IG30BGA/IG30CHL","IG30BGA/IG30CHL Blaualgen- und Chlorophyllsensor","Die Fluoreszenzmessung erfasst Blaualgen und Chlorophyll direkt im Wasser, ohne Probenextraktion oder chemische Reagenzien. Digitale Kommunikation unterstützt die kontinuierliche Überwachung; eine optionale Reinigungsbürste begrenzt Ablagerungen an der optischen Messfläche, etwa beim Einsatz an Wasserentnahmestellen.",{"_57":164,"_242":-5,"_236":109,"_147":-5,"_144":370},{"_103":109,"_147":-5,"_149":-5,"_150":151},{"_160":372,"_140":172,"_173":373,"_175":176,"_177":374,"_179":375,"_181":356,"_183":356,"_185":376,"_187":377,"_189":378},"e9c2938f-6236-4c7f-bf9d-752bcf98b444","2025040861512869.jpg",13520,"3a4bd3a9ba0af3bd90061177b116d1a851d9d410ca383514dfbd7fdb3aa5270f","/igenu-preview/media/3a4bd3a9ba0af3bd90061177.jpg","2026-10-20T17:32:39.805Z",[379,381],{"_181":192,"_183":192,"_175":194,"_185":380},"/igenu-preview/media/9fb61c06fe27bcc0e9cecfd6.webp",{"_181":356,"_183":356,"_175":194,"_185":382},"/igenu-preview/media/b63396be40013d2d55e983f5.webp",{"_160":215,"_57":384,"_234":385,"_236":386,"_238":387,"_240":325,"_163":388,"_244":390},"ig30cds","IG30CDS","IG30CDS Leitfähigkeitssensor","Verschiedene Zellkonstanten ermöglichen die Leitfähigkeitsmessung in der Wasseraufbereitung und in industriellem Prozesswasser. Digitale Kommunikation und gespeicherte Kalibrierwerte unterstützen die Systemintegration; die mitgelieferte Halterung und Durchflusszelle erleichtern den Einbau und die Einrichtung am vorgesehenen Messpunkt.",{"_57":164,"_242":-5,"_236":109,"_147":-5,"_144":389},{"_103":109,"_147":-5,"_149":-5,"_150":151},{"_160":391,"_140":172,"_173":392,"_175":176,"_177":393,"_179":394,"_181":395,"_183":395,"_185":396,"_187":397,"_189":398},"97568f30-f32e-4d9a-85ac-2b57a8967181","2025040860050401.jpg",57217,"08cc865f38c95a6b72364eaf3f6b94912df92297b7cb4dbcdb9d9d327b79dd1c",500,"/igenu-preview/media/08cc865f38c95a6b72364eaf.jpg","2026-10-20T17:32:39.763Z",[399,401],{"_181":192,"_183":192,"_175":194,"_185":400},"/igenu-preview/media/6f7c525ac57d10f270f2e15f.webp",{"_181":395,"_183":395,"_175":194,"_185":402},"/igenu-preview/media/d8eaca92b7d0ec37a6ee861d.webp",{"_160":216,"_57":404,"_234":405,"_236":406,"_238":407,"_240":325,"_163":408,"_244":410},"ig30cls","IG30CLS","IG30CLS Restchlorsensor","Der Sensor misst Restchlor und Chlordioxid im Wasser nach einem elektrochemischen Verfahren mit konstantem Potenzial. Eine abgestimmte Durchflusszelle führt die Probe; kolorimetrische Reagenzien sowie ein regelmäßiger Austausch von Membranen oder Elektrolyt sind dabei nicht erforderlich.",{"_57":164,"_242":-5,"_236":109,"_147":-5,"_144":409},{"_103":109,"_147":-5,"_149":-5,"_150":151},{"_160":411,"_140":172,"_173":412,"_175":176,"_177":413,"_179":414,"_181":415,"_183":416,"_185":417,"_187":418,"_189":419},"ce0b8383-b6df-4c9a-aabb-3a55435db7a7","2025040861142109.png",22021,"128cbf77e27c44f50a679ba8b27ec860b8243697fccdc4f64b056e6497df3a79",344,423,"/igenu-preview/media/128cbf77e27c44f50a679ba8.jpg","2026-10-20T17:32:39.792Z",[420,423],{"_181":192,"_183":421,"_175":194,"_185":422},393,"/igenu-preview/media/e07f5ef0e1a47e02ed6259ae.webp",{"_181":415,"_183":416,"_175":194,"_185":424},"/igenu-preview/media/ecb94564bb6e1f06cbfde7cd.webp",{"_160":217,"_57":426,"_234":427,"_236":428,"_238":429,"_240":325,"_163":430,"_244":432},"ig30ht","IG30HT","IG30HT Trübungssensor für hohe Messbereiche","Die Infrarot-Streulichtmessung erfasst Trübungen in Prozesswasser, Oberflächenwasser und Aufbereitungsanlagen. Die digitale Sonde verbindet optische Kompensation mit einem Saphirfenster; eine optionale Reinigungsbürste hilft, Ablagerungen auf der Messfläche während des laufenden Onlinebetriebs in der Anlage zu reduzieren.",{"_57":164,"_242":-5,"_236":109,"_147":-5,"_144":431},{"_103":109,"_147":-5,"_149":-5,"_150":151},{"_160":433,"_140":172,"_173":434,"_175":331,"_177":435,"_179":436,"_181":437,"_183":438,"_185":439,"_187":440,"_189":441},"95eccf83-22e5-4f4d-a03f-5509479d7661","2025040860985293.jpg",11246,"ecdac2d963d6479b136774a8172895d54061650f1cb8089d1404ff2a26710a79",190,78,"/igenu-preview/media/ecdac2d963d6479b136774a8.png","2026-10-20T17:32:39.787Z",[442],{"_181":437,"_183":438,"_175":194,"_185":443},"/igenu-preview/media/c0547cb002a63d36b1ac374c.webp",{"_160":218,"_57":445,"_234":446,"_236":447,"_238":448,"_240":325,"_163":449,"_244":451},"ig30ise-x","IG30ISE-X","IG30ISE-X Ionenselektive Elektrode","Die ionenselektive Messung unterstützt konfigurierte Ionenparameter und pH in der Wasserüberwachung. Die Tauchsonde benötigt kein separates Probenahmesystem und bietet Kompensations- sowie Kalibrierfunktionen für Anwendungen in Trinkwasser, Umweltmessung und Abwasser; die Parameter werden anwendungsbezogen ausgewählt.",{"_57":164,"_242":-5,"_236":109,"_147":-5,"_144":450},{"_103":109,"_147":-5,"_149":-5,"_150":151},{"_160":452,"_140":172,"_173":453,"_175":331,"_177":454,"_179":455,"_181":192,"_183":456,"_185":457,"_187":458,"_189":459},"c6e3c765-909d-45fd-bd1c-7dbc51fecd54","2025041051038309.png",13330,"8936108072d3c61053c40f382494eb98c8734713fb66a99450bf2aedb26fb684",120,"/igenu-preview/media/8936108072d3c61053c40f38.png","2026-10-20T17:32:39.882Z",[460],{"_181":192,"_183":456,"_175":194,"_185":461},"/igenu-preview/media/f11ab30d5325a31abe0f2adb.webp",{"_160":219,"_57":463,"_234":464,"_236":465,"_238":466,"_240":325,"_163":467,"_244":469},"ig30ph01","IG30PH01","IG30PH01 Analoge pH-Elektrode","Die analoge pH-Elektrode verbindet eine Gelbefüllung mit einem Referenzsystem mit doppelter Salzbrücke für Wasser- und Prozessmessungen. Ein integrierter Temperatursensor unterstützt die Kompensation; Halterung und Durchflusszelle erleichtern die Installation an dem für die Anwendung vorgesehenen Messpunkt.",{"_57":164,"_242":-5,"_236":109,"_147":-5,"_144":468},{"_103":109,"_147":-5,"_149":-5,"_150":151},{"_160":246,"_140":172,"_173":247,"_175":176,"_177":248,"_179":249,"_181":250,"_183":251,"_185":252,"_187":253,"_189":470},[471,472],{"_181":192,"_183":256,"_175":194,"_185":257},{"_181":250,"_183":251,"_175":194,"_185":259},{"_160":220,"_57":474,"_234":475,"_236":476,"_238":477,"_240":325,"_163":478,"_244":480},"ig30ptco","IG30PTCO","IG30PTCO Sensor für Wasserfärbung","Die optische Absorptionsmessung erfasst die Wasserfärbung anhand der Platin-Cobalt-Farbskala. Automatische Trübungskompensation und eine Reinigungsbürste unterstützen den Onlinebetrieb; gespeicherte Kalibrierwerte und digitale Kommunikation erleichtern die Verbindung mit dem Wasserüberwachungssystem und die Einrichtung am vorgesehenen Messpunkt.",{"_57":164,"_242":-5,"_236":109,"_147":-5,"_144":479},{"_103":109,"_147":-5,"_149":-5,"_150":151},{"_160":372,"_140":172,"_173":373,"_175":176,"_177":374,"_179":375,"_181":356,"_183":356,"_185":376,"_187":377,"_189":481},[482,483],{"_181":192,"_183":192,"_175":194,"_185":380},{"_181":356,"_183":356,"_175":194,"_185":382},{"_160":221,"_57":485,"_234":486,"_236":487,"_238":488,"_240":325,"_163":489,"_244":491},"ig30rps","IG30RPS","IG30RPS Digitale Redoxelektrode","Die digitale Redoxelektrode überwacht das Oxidations-Reduktions-Potenzial in Wasser und industriellen Prozessen. Eine Platin-Messelektrode und ein Referenzsystem mit doppelter Salzbrücke werden durch digitale Kommunikation, Proben- oder Standardkalibrierung sowie Halterung und Durchflusszelle für die Installation ergänzt.",{"_57":164,"_242":-5,"_236":109,"_147":-5,"_144":490},{"_103":109,"_147":-5,"_149":-5,"_150":151},{"_160":246,"_140":172,"_173":247,"_175":176,"_177":248,"_179":249,"_181":250,"_183":251,"_185":252,"_187":253,"_189":492},[493,494],{"_181":192,"_183":256,"_175":194,"_185":257},{"_181":250,"_183":251,"_175":194,"_185":259},{"_160":222,"_57":496,"_234":497,"_236":498,"_238":499,"_240":325,"_163":500,"_244":502},"ig30rps01","IG30RPS01","IG30RPS01 Analoge Redoxelektrode","Die analoge Redoxelektrode erfasst das Oxidations-Reduktions-Potenzial in der Wasseraufbereitung und Prozessüberwachung. Platin-Messelement und Referenzsystem mit doppelter Salzbrücke werden durch Proben- und Standardkalibrierung sowie eine Halterung und Durchflusszelle für den Einbau am vorgesehenen Messpunkt ergänzt.",{"_57":164,"_242":-5,"_236":109,"_147":-5,"_144":501},{"_103":109,"_147":-5,"_149":-5,"_150":151},{"_160":246,"_140":172,"_173":247,"_175":176,"_177":248,"_179":249,"_181":250,"_183":251,"_185":252,"_187":253,"_189":503},[504,505],{"_181":192,"_183":256,"_175":194,"_185":257},{"_181":250,"_183":251,"_175":194,"_185":259},{"_160":223,"_57":507,"_234":508,"_236":509,"_238":510,"_240":325,"_163":511,"_244":513},"ig3254cod","IG3254COD","IG3254COD UV-Sensor für CSB und TOC","Die UV-Absorptionsmessung unterstützt die Onlinebestimmung von CSB und TOC ohne Reagenziendosierung. Trübungskompensation, Kalibrieroptionen und eine verfügbare automatische Reinigung passen die digitale Sonde an die Wasserüberwachung an; Ergebnisse werden entsprechend der gewählten Kalibrierung und Messkonfiguration interpretiert.",{"_57":164,"_242":-5,"_236":109,"_147":-5,"_144":512},{"_103":109,"_147":-5,"_149":-5,"_150":151},{"_160":514,"_140":172,"_173":515,"_175":176,"_177":516,"_179":517,"_181":356,"_183":356,"_185":518,"_187":519,"_189":520},"79d9f104-d914-4e36-bec2-d6d2b843fefd","2025041051182309.jpg",14215,"e3e2c21db606165f614650cf931244737a0e84793f3dd9ab8bd834db8aa5b8b3","/igenu-preview/media/e3e2c21db606165f614650cf.jpg","2026-10-20T17:32:39.888Z",[521,523],{"_181":192,"_183":192,"_175":194,"_185":522},"/igenu-preview/media/087409fcbd7eefe1aec06c53.webp",{"_181":356,"_183":356,"_175":194,"_185":524},"/igenu-preview/media/6d889354b11ab94fb489a773.webp",{"_160":224,"_57":526,"_234":527,"_236":528,"_238":529,"_240":325,"_163":530,"_244":532},"ig3500","IG3500","IG3500 Restchloranalysator","Der Analysator bestimmt Restchlor im Wasser mittels DPD-Kolorimetrie für Versorgungs- und Prozessanwendungen. Optische Störgrößenkompensation, automatische Reinigung und Datenspeicherung werden durch Relaisausgänge zur Steuerungsanbindung sowie ein optionales Kommunikationsmodul für die Fernübertragung der Messwerte ergänzt.",{"_57":164,"_242":-5,"_236":109,"_147":-5,"_144":531},{"_103":109,"_147":-5,"_149":-5,"_150":151},{"_160":533,"_140":172,"_173":534,"_175":331,"_177":535,"_179":536,"_181":537,"_183":538,"_185":539,"_187":540,"_189":541},"c50c4c9d-55bb-4423-8c3e-781ffff460bb","2025040937453857.jpg",161037,"8851b0c528aa8f3f11bac4d54c4a5ffd8e6ba0b79e7a6a527d4c31805dbb2c25",439,577,"/igenu-preview/media/8851b0c528aa8f3f11bac4d5.png","2026-10-20T17:32:39.818Z",[542,545],{"_181":192,"_183":543,"_175":194,"_185":544},421,"/igenu-preview/media/a94dedbc4c305ed00e17532e.webp",{"_181":537,"_183":538,"_175":194,"_185":546},"/igenu-preview/media/addc2737c9f6397359f3a546.webp",{"_160":225,"_57":548,"_234":549,"_236":550,"_238":551,"_240":325,"_163":552,"_244":554},"ig3500an","IG3500AN","IG3500AN Analysator für Ammoniak- und Ammoniumstickstoff","Die Salicylat-Photometrie bestimmt Ammoniak- und Ammoniumstickstoff im Wasser. Automatische Bereichsumschaltung, Qualitätskontrollen und Betriebsprotokolle unterstützen den Onlinebetrieb; Alarmfunktionen und elektrische Kommunikationsschnittstellen ermöglichen die Einbindung in Systeme für Trinkwasser, Umweltüberwachung und Abwasser sowie die Übertragung von Messwerten.",{"_57":164,"_242":-5,"_236":109,"_147":-5,"_144":553},{"_103":109,"_147":-5,"_149":-5,"_150":151},{"_160":555,"_140":172,"_173":556,"_175":331,"_177":557,"_179":558,"_181":202,"_183":559,"_185":560,"_187":561,"_189":562},"bfda7f5e-e504-4c40-85f0-1afea6d4aba3","2025040938476253.jpg",51146,"076a24550dfec7d99b95ba8827dbead49c4506dc3d55d9d8b47b0c95d2a2c36e",435,"/igenu-preview/media/076a24550dfec7d99b95ba88.png","2026-10-20T17:32:39.824Z",[563],{"_181":202,"_183":559,"_175":194,"_185":564},"/igenu-preview/media/f3d468788765b050ceafe139.webp",{"_160":226,"_57":566,"_234":567,"_236":568,"_238":569,"_240":325,"_163":570,"_244":572},"ig3500codmn","IG3500CODMN","IG3500CODmn Analysator für den Permanganatindex","Die Oxidation mit Kaliumpermanganat und anschließende Titration bestimmen den Permanganatindex im Wasser. Automatische Bereichsumschaltung, Qualitätskontrollen und Betriebsprotokolle unterstützen die Onlineüberwachung; Alarmfunktionen und elektrische Schnittstellen ermöglichen die Einbindung des Analysators in ein übergeordnetes System.",{"_57":164,"_242":-5,"_236":109,"_147":-5,"_144":571},{"_103":109,"_147":-5,"_149":-5,"_150":151},{"_160":555,"_140":172,"_173":556,"_175":331,"_177":557,"_179":558,"_181":202,"_183":559,"_185":560,"_187":561,"_189":573},[574],{"_181":202,"_183":559,"_175":194,"_185":564},{"_160":227,"_57":576,"_234":577,"_236":578,"_238":579,"_240":325,"_163":580,"_244":582},"ig3500tn","IG3500TN","IG3500TN Gesamtstickstoffanalysator","Ein alkalischer Persulfataufschluss mit anschließender UV-Photometrie bestimmt den Gesamtstickstoff im Wasser. Automatische Bereichsumschaltung, Qualitätskontrollen und Messprotokolle unterstützen den Onlinebetrieb; Kommunikations- und Alarmfunktionen ermöglichen die Anbindung an übergeordnete Systeme zur Umweltüberwachung und Abwasserkontrolle vor Ort.",{"_57":164,"_242":-5,"_236":109,"_147":-5,"_144":581},{"_103":109,"_147":-5,"_149":-5,"_150":151},{"_160":555,"_140":172,"_173":556,"_175":331,"_177":557,"_179":558,"_181":202,"_183":559,"_185":560,"_187":561,"_189":583},[584],{"_181":202,"_183":559,"_175":194,"_185":564},{"_160":228,"_57":586,"_234":587,"_236":588,"_238":589,"_240":325,"_163":590,"_244":592},"ig3500tp","IG3500TP","IG3500TP Gesamtphosphoranalysator","Probenaufschluss und Ammoniummolybdat-Photometrie bestimmen den Gesamtphosphor im Wasser. Automatische Bereichsumschaltung, Qualitätskontrollen und Messprotokolle unterstützen den Onlinebetrieb; Kommunikationsschnittstellen und Alarmfunktionen ermöglichen die Einbindung in Anwendungen der Umweltüberwachung sowie der Trinkwasser- und Abwasserkontrolle am jeweiligen Standort.",{"_57":164,"_242":-5,"_236":109,"_147":-5,"_144":591},{"_103":109,"_147":-5,"_149":-5,"_150":151},{"_160":555,"_140":172,"_173":556,"_175":331,"_177":557,"_179":558,"_181":202,"_183":559,"_185":560,"_187":561,"_189":593},[594],{"_181":202,"_183":559,"_175":194,"_185":564},{"_160":229,"_57":596,"_234":597,"_236":598,"_238":599,"_240":325,"_163":600,"_244":603},"ig9000","IG9000","IG9000 Ultraschall-Füllstandsmessgerät","Die Ultraschall-Laufzeitmessung überwacht Füllstände von Flüssigkeiten und Schüttgütern ohne direkten Medienkontakt. Kompakt- und Getrenntausführungen, Signalanalyse und Temperaturkompensation unterstützen den Einbau in Wasseraufbereitung, Lagertanks und weiteren Füllstandsanwendungen sowie die Anpassung an die jeweilige Messstelle.",{"_57":601,"_242":-5,"_236":113,"_147":-5,"_144":602},"industrial",{"_103":113,"_147":-5,"_149":-5,"_150":151},{"_160":604,"_140":172,"_173":605,"_175":331,"_177":606,"_179":607,"_181":608,"_183":609,"_185":610,"_187":611,"_189":612},"485bff13-2df9-448f-a8bc-6b60b3e5ad76","2025040851503805.png",698863,"8ef050d2f42f424a5466c7f703dc0ddcbb2915dc23bdee338481847f3cefa2dd",2604,1704,"/igenu-preview/media/8ef050d2f42f424a5466c7f7.png","2026-10-20T17:32:39.690Z",[613,616,619,622,626],{"_181":192,"_183":614,"_175":194,"_185":615},209,"/igenu-preview/media/63971d02adf57bfde6335036.webp",{"_181":197,"_183":617,"_175":194,"_185":618},419,"/igenu-preview/media/94e5c9a427aaff2e7fe15add.webp",{"_181":201,"_183":620,"_175":194,"_185":621},628,"/igenu-preview/media/6403302113043098a393f716.webp",{"_181":623,"_183":624,"_175":194,"_185":625},1280,838,"/igenu-preview/media/bd1f66f7ac71cc90284d1d8d.webp",{"_181":627,"_183":628,"_175":194,"_185":629},1600,1047,"/igenu-preview/media/0f4d290e7e86d3dd29596237.webp",{"_160":230,"_57":631,"_234":632,"_236":633,"_238":634,"_240":325,"_163":635,"_244":637},"ig9600","IG9600","IG9600 Ultraschall-Messgerät für Schlammgrenzschichten","Die Auswertung von Ultraschallechos ermittelt die Schlammgrenzschicht in Absetz- und Eindickbecken. Getrennte Sonde, integrierte Temperaturkompensation und lokale Anzeige unterstützen die Überwachung in Abwasserbehandlung und Wasserwerks-Sedimentation; die Konfiguration wird an die jeweilige Installation vor Ort angepasst.",{"_57":601,"_242":-5,"_236":113,"_147":-5,"_144":636},{"_103":113,"_147":-5,"_149":-5,"_150":151},{"_160":638,"_140":172,"_173":639,"_175":331,"_177":640,"_179":641,"_181":642,"_183":609,"_185":643,"_187":644,"_189":645},"fe68277b-0e41-4c1a-b0a4-8bfebd654caa","2025040854938433.png",549953,"65b4e4d80f69906e1d7bb840b3735e20c7fa903b831162b2a977ae41ff5f77d9",2064,"/igenu-preview/media/65b4e4d80f69906e1d7bb840.png","2026-10-20T17:32:39.735Z",[646,649,652,655,658],{"_181":192,"_183":647,"_175":194,"_185":648},264,"/igenu-preview/media/2dc78a489616479a5aadfbac.webp",{"_181":197,"_183":650,"_175":194,"_185":651},528,"/igenu-preview/media/aae51fe4186be6ad1749b345.webp",{"_181":201,"_183":653,"_175":194,"_185":654},793,"/igenu-preview/media/50b869a018e4f784a789e882.webp",{"_181":623,"_183":656,"_175":194,"_185":657},1057,"/igenu-preview/media/44748a134c7000c8efd4c395.webp",{"_181":627,"_183":659,"_175":194,"_185":660},1321,"/igenu-preview/media/8ef2f704c499019d37e0855c.webp","sourceSections",[663],{"_160":664,"_665":666,"_7":667,"_675":-5,"_676":677},"f1c49c62-7600-48bc-9130-7f5016c5423a","type","TEXT_IMAGE",{"_668":38,"_669":165,"_167":670,"_671":672,"_673":674},"body","heading","<p>die qualität des trinkwassers ist gemessen an den verschiedenen stufen: bei der einreise an die kläranlage, während der behandlung mit seinem austritt aus der kläranlage und entlang der vertrieb.</p>","sourceNotes",[],"imagePosition","right","media","mediaItems",[]]
