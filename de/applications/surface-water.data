ion",[102,118],{"_103":104,"_105":106},"title","产品","links",[107,112,115],{"_108":109,"_110":111},"label","Wasseranalyse","href","/de/products?category=water",{"_108":113,"_110":114},"Industrielle Messung","/de/products?category=industrial",{"_108":116,"_110":117},"Gasdetektion","/de/products?category=gas",{"_103":119,"_105":120},"了解更多",[121,124,127,130,133],{"_108":122,"_110":123},"关于我们","/de/about",{"_108":125,"_110":126},"客户案例","/de/cases",{"_108":128,"_110":129},"新闻中心","/de/news",{"_108":131,"_110":132},"售后服务","/de/service",{"_108":134,"_110":135},"下载中心","/de/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","surface-water",[],[],"seo",{"_103":146,"_147":148,"_149":-5,"_150":151},"Oberflächenwasser | IGENU SCIENCE","description","Messparameter für Flüsse, Seen und Wasserquellen.","imageUrl","index",true,"canonical","https://eicloc.github.io/igenu-preview/de/applications/surface-water","query",{},"selected",[],"knowledge",{"_160":161,"_140":162,"_57":141,"_163":164,"_103":165,"_166":148,"_167":168,"_169":170,"_206":207,"_58":231,"_645":646},"id","a3fa2cbf-4507-4fb4-9a6e-02d0defe3ef3","APPLICATION","category","water","Oberflächenwasser","summary","bodyHtml","<p>Die Überwachung von Oberflächenwasser liefert Informationen über Wasserzustand und Veränderungen. Entdecken Sie Instrumente für gelösten Sauerstoff, Trübung, Algen und weitere verfügbare Parameter entsprechend Ihrem Messort.</p>","cover",{"_160":171,"_140":172,"_173":174,"_175":176,"_177":178,"_179":180,"_181":182,"_183":184,"_185":186,"_187":188,"_189":190},"a96aa7c9-7b3b-4e0d-b612-1d67b9c9a070","IMAGE","originalName","sybanner2.jpg","mimeType","image/jpeg","size",266624,"sha256","cdf3ca1f3ff1131eca539bea66fe227fc32515b88582094770bb9a85ee224c72","width",1200,"height",334,"url","/igenu-preview/media/cdf3ca1f3ff1131eca539bea.jpg","createdAt","2026-10-20T17:32:39.585Z","variants",[191,196,200,204],{"_181":192,"_183":193,"_175":194,"_185":195},320,89,"image/webp","/igenu-preview/media/5