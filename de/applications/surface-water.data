":243},"brand",{"_103":109,"_147":-5,"_149":-5,"_150":151},"heroImage",{"_160":246,"_140":172,"_173":247,"_175":248,"_177":249,"_179":250,"_181":251,"_183":252,"_185":253,"_187":254,"_189":255},"d84d4b36-8577-47f5-a6b1-91a7ae3a7c9f","2025040855746689.png","image/png",749999,"8032374cce79b2ec8e8e37dca3798c3058050655937edfc7f06654e8d4ff5b9e",1280,1706,"/igenu-preview/media/8032374cce79b2ec8e8e37dc.png","2026-10-20T17:32:39.748Z",[256,259,262,264],{"_181":192,"_183":257,"_175":194,"_185":258},427,"/igenu-preview/media/c82ee037d25142ee99b2efed.webp",{"_181":197,"_183":260,"_175":194,"_185":261},853,"/igenu-preview/media/8aafd5be554a54bb0699b6bf.webp",{"_181":201,"_183":251,"_175":194,"_185":263},"/igenu-preview/media/4a8ece2b232c4eb15009de8a.webp",{"_181":251,"_183":252,"_175":194,"_185":265},"/igenu-preview/media/288701302fcf6e887f187cad.webp",{"_160":209,"_57":267,"_234":268,"_236":269,"_238":270,"_240":151,"_163":271,"_244":273},"ig30phs","IG30PHS","IG30PHS Digitale pH-Elektrode","Die digitale pH-Elektrode kombiniert Gelbefüllung, ein Referenzsystem mit doppelter Salzbrücke und integrierte Temperaturerfassung. Modbus ermöglicht die Verbindung mit kompatiblen Reglern; Kalibrieroptionen sowie mitgelieferte Halterung und Durchflusszelle unterstützen Installation und Routinebetrieb am Messpunkt der jeweiligen Anlage.",{"_57":164,"_242":-5,"_236":109,"_147":-5,"_144":272},{"_103":109,"_147":-5,"_149":-5,"_150":151},{"_160":274,"_140":172,"_173":275,"_175":176,"_177":276,"_179":277,"_181":278,"_183":279,"_185":280,"_187":281,"_189":282},"7507b7cd-7dc3-42b2-90a4-f843106d4461","2025040859520101.png",19079,"7dfe5452c927d26232963ff85f11073f15b9d29010abcb394bea3ce0f2f502d6",358,302,"/igenu-preview/media/7dfe5452c927d26232963ff8.jpg","2026-10-20T17:32:39.754Z",[283,286],{"_181":192,"_183":284,"_175":194,"_185":285},270,"/igenu-preview/media/93a066c50a54638353b43bbf.webp",{"_181":278,"_183":279,"_175":194,"_185":287},"/igenu-preview/media/b72cc265fa7500183b25c7da.webp",{"_160":210,"_57":289,"_234":290,"_236":291,"_238":292,"_240":151,"_163":293,"_244":295},"ig30rdo","IG30RDO","IG30RDO Optischer Sensor für gelösten Sauerstoff","Die fluoreszenzbasierte Messung erfasst gelösten Sauerstoff ohne Elektrolytwechsel oder Polarisation des Sensors. Integrierte Temperaturkompensation und digitale Kommunikation unterstützen die kontinuierliche Wasserüberwachung; Luft- und Probenkalibrierung ermöglichen die Einrichtung für Anwendungen in Aufbereitung, Umweltüberwachung und Aquakultur.",{"_57":164,"_242":-5,"_236":109,"_147":-5,"_144":294},{"_103":109,"_147":-5,"_149":-5,"_150":151},{"_160":296,"_140":172,"_173":297,"_175":176,"_177":298,"_179":299,"_181":300,"_183":301,"_185":302,"_187":303,"_189":304},"0ddcf618-0714-49aa-9919-74ce97332e9e","2025040860317013.png",19493,"1513162129cbcc0b7fb98e96f5e5a24329832e50befa0944e7b17725123db89a",458,293,"/igenu-preview/media/1513162129cbcc0b7fb98e96.jpg","2026-10-20T17:32:39.769Z",[305,308],{"_181":192,"_183":306,"_175":194,"_185":307},205,"/igenu-preview/media/875a6bfa76d0d60b22d59c3d.webp",{"_181":300,"_183":301,"_175":194,"_185":309},"/igenu-preview/media/676768d13901a89005e95e68.webp",{"_160":211,"_57":311,"_234":312,"_236":313,"_238":314,"_240":151,"_163":315,"_244":317},"ig30ss-sol","IG30SS/SOL","IG30SS/SOL Sensor für Schwebstoffe und Schlammkonzentration","Die Infrarot-Streulichtmessung überwacht Schwebstoffe und Schlammkonzentrationen in Wasser- und Abwasserprozessen. Die digitale Sonde kombiniert optische Kompensation mit einem Saphirfenster; eine optionale Reinigungsbürste begrenzt Ablagerungen auf der Messfläche während der kontinuierlichen Überwachung am jeweiligen Einsatzort.",{"_57":164,"_242":-5,"_236":109,"_147":-5,"_144":316},{"_103":109,"_147":-5,"_149":-5,"_150":151},{"_160":318,"_140":172,"_173":319,"_175":176,"_177":320,"_179":321,"_181":322,"_183":323,"_185":324,"_187":325,"_189":326},"1439d80a-330c-424f-b53e-2863e4ad2437","2025040860527217.png",17952,"fbfabb8705ffee2ab2928de1e179bcbdfff9163bf9562b20f0a57da383e92447",252,303,"/igenu-preview/media/fbfabb8705ffee2ab2928de1.jpg","2026-10-20T17:32:39.774Z",[327],{"_181":322,"_183":323,"_175":194,"_185":328},"/igenu-preview/media/75deeb09829c31a530ddf618.webp",{"_160":212,"_57":330,"_234":331,"_236":332,"_238":333,"_240":151,"_163":334,"_244":336},"ig30uvno3","IG30UVNO3","IG30UVNO3 UV-Sensor für Nitratstickstoff","Die UV-Absorptionsmessung erfasst Nitratstickstoff direkt im Wasser, ohne chemische Reagenzien oder separates Probenahmesystem. Wählbare optische Weglängen, Störgrößenkompensation und automatische Reinigung unterstützen den Onlineeinsatz in Trinkwasser, Umweltüberwachung und Abwasserbehandlung sowie die Anpassung an den Messpunkt.",{"_57":164,"_242":-5,"_236":109,"_147":-5,"_144":335},{"_103":109,"_147":-5,"_149":-5,"_150":151},{"_160":337,"_140":172,"_173":338,"_175":176,"_177":339,"_179":340,"_181":341,"_183":342,"_185":343,"_187":344,"_189":345},"79581a81-10c6-426b-80fa-28e7baf03c33","2025040861391349.png",16873,"82c04b6460e5738541de5cfefb589dc0c6890e78350a89fe4e1a3b1a0828a745",263,348,"/igenu-preview/media/82c04b6460e5738541de5cfe.jpg","2026-10-20T17:32:39.799Z",[346],{"_181":341,"_183":342,"_175":194,"_185":347},"/igenu-preview/media/5668d414b7362883ab524969.webp",{"_160":213,"_57":349,"_234":350,"_236":351,"_238":352,"_240":353,"_163":354,"_244":356},"ig3000mp-x","IG3000MP-X","IG3000MP-X Multiparameter-Wasseranalysator","Digitale Wechselsonden ermöglichen eine anwendungsbezogene Kombination von pH, gelöstem Sauerstoff, Leitfähigkeit und Trübung. Wasserdichte Anschlüsse und in den Sonden gespeicherte Kalibrierdaten unterstützen den Austausch vor Ort; eine automatische Reinigung hilft, Ablagerungen an den Sensorflächen zu begrenzen.",false,{"_57":164,"_242":-5,"_236":109,"_147":-5,"_144":355},{"_103":109,"_147":-5,"_149":-5,"_150":151},{"_160":357,"_140":172,"_173":358,"_175":176,"_177":359,"_179":360,"_181":361,"_183":361,"_185":362,"_187":363,"_189":364},"d6d649eb-90c0-469f-9bfb-1c613153f689","2025040861670749.jpg",19258,"9a9243397faa84f675ead5a8a5216895cf7e15c9b82d390083269947f0d00581",540,"/igenu-preview/media/9a9243397faa84f675ead5a8.jpg","2026-10-20T17:32:39.812Z",[365,367],{"_181":192,"_183":192,"_175":194,"_185":366},"/igenu-preview/media/32f08ba6aa513832d0c6c644.webp",{"_181":361,"_183":361,"_175":194,"_185":368},"/igenu-preview/media/61f38d89920b71a6040fa537.webp",{"_160":214,"_57":370,"_234":371,"_236":372,"_238":373,"_240":353,"_163":374,"_244":376},"ig30cds","IG30CDS","IG30CDS Leitfähigkeitssensor","Verschiedene Zellkonstanten ermöglichen die Leitfähigkeitsmessung in der Wasseraufbereitung und in industriellem Prozesswasser. Digitale Kommunikation und gespeicherte Kalibrierwerte unterstützen die Systemintegration; die mitgelieferte Halterung und Durchflusszelle erleichtern den Einbau und die Einrichtung am vorgesehenen Messpunkt.",{"_57":164,"_242":-5,"_236":109,"_147":-5,"_144":375},{"_103":109,"_147":-5,"_149":-5,"_150":151},{"_160":377,"_140":172,"_173":378,"_175":176,"_177":379,"_179":380,"_181":381,"_183":381,"_185":382,"_187":383,"_189":384},"97568f30-f32e-4d9a-85ac-2b57a8967181","2025040860050401.jpg",57217,"08cc865f38c95a6b72364eaf3f6b94912df92297b7cb4dbcdb9d9d327b79dd1c",500,"/igenu-preview/media/08cc865f38c95a6b72364eaf.jpg","2026-10-20T17:32:39.763Z",[385,387],{"_181":192,"_183":192,"_175":194,"_185":386},"/igenu-preview/media/6f7c525ac57d10f270f2e15f.webp",{"_181":381,"_183":381,"_175":194,"_185":388},"/igenu-preview/media/d8eaca92b7d0ec37a6ee861d.webp",{"_160":215,"_57":390,"_234":391,"_236":392,"_238":393,"_240":353,"_163":394,"_244":396},"ig30cls","IG30CLS","IG30CLS Restchlorsensor","Der Sensor misst Restchlor und Chlordioxid im Wasser nach einem elektrochemischen Verfahren mit konstantem Potenzial. Eine abgestimmte Durchflusszelle führt die Probe; kolorimetrische Reagenzien sowie ein regelmäßiger Austausch von Membranen oder Elektrolyt sind dabei nicht erforderlich.",{"_57":164,"_242":-5,"_236":109,"_147":-5,"_144":395},{"_103":109,"_147":-5,"_149":-5,"_150":151},{"_160":397,"_140":172,"_173":398,"_175":176,"_177":399,"_179":400,"_181":401,"_183":402,"_185":403,"_187":404,"_189":405},"ce0b8383-b6df-4c9a-aabb-3a55435db7a7","2025040861142109.png",22021,"128cbf77e27c44f50a679ba8b27ec860b8243697fccdc4f64b056e6497df3a79",344,423,"/igenu-preview/media/128cbf77e27c44f50a679ba8.jpg","2026-10-20T17:32:39.792Z",[406,409],{"_181":192,"_183":407,"_175":194,"_185":408},393,"/igenu-preview/media/e07f5ef0e1a47e02ed6259ae.webp",{"_181":401,"_183":402,"_175":194,"_185":410},"/igenu-preview/media/ecb94564bb6e1f06cbfde7cd.webp",{"_160":216,"_57":412,"_234":413,"_236":414,"_238":415,"_240":353,"_163":416,"_244":418},"ig30codm","IG30CODM","IG30CODM Sensor für gefärbte gelöste organische Stoffe","Die UV-Fluoreszenzmessung erfasst gefärbte gelöste organische Stoffe direkt im Wasser. Eine kompakte Sonde, automatische Reinigungsbürste und digitale Kommunikation unterstützen die kontinuierliche Onlineüberwachung in Flüssen, Seen, Grundwasser und Abwasser sowie die Einbindung in das jeweilige Messsystem.",{"_57":164,"_242":-5,"_236":109,"_147":-5,"_144":417},{"_103":109,"_147":-5,"_149":-5,"_150":151},{"_160":419,"_140":172,"_173":420,"_175":176,"_177":421,"_179":422,"_181":361,"_183":361,"_185":423,"_187":424,"_189":425},"e9c2938f-6236-4c7f-bf9d-752bcf98b444","2025040861512869.jpg",13520,"3a4bd3a9ba0af3bd90061177b116d1a851d9d410ca383514dfbd7fdb3aa5270f","/igenu-preview/media/3a4bd3a9ba0af3bd90061177.jpg","2026-10-20T17:32:39.805Z",[426,428],{"_181":192,"_183":192,"_175":194,"_185":427},"/igenu-preview/media/9fb61c06fe27bcc0e9cecfd6.webp",{"_181":361,"_183":361,"_175":194,"_185":429},"/igenu-preview/media/b63396be40013d2d55e983f5.webp",{"_160":217,"_57":431,"_234":432,"_236":433,"_238":434,"_240":353,"_163":435,"_244":437},"ig30ht","IG30HT","IG30HT Trübungssensor für hohe Messbereiche","Die Infrarot-Streulichtmessung erfasst Trübungen in Prozesswasser, Oberflächenwasser und Aufbereitungsanlagen. Die digitale Sonde verbindet optische Kompensation mit einem Saphirfenster; eine optionale Reinigungsbürste hilft, Ablagerungen auf der Messfläche während des laufenden Onlinebetriebs in der Anlage zu reduzieren.",{"_57":164,"_242":-5,"_236":109,"_147":-5,"_144":436},{"_103":109,"_147":-5,"_149":-5,"_150":151},{"_160":438,"_140":172,"_173":439,"_175":248,"_177":440,"_179":441,"_181":442,"_183":443,"_185":444,"_187":445,"_189":446},"95eccf83-22e5-4f4d-a03f-5509479d7661","2025040860985293.jpg",11246,"ecdac2d963d6479b136774a8172895d54061650f1cb8089d1404ff2a26710a79",190,78,"/igenu-preview/media/ecdac2d963d6479b136774a8.png","2026-10-20T17:32:39.787Z",[447],{"_181":442,"_183":443,"_175":194,"_185":448},"/igenu-preview/media/c0547cb002a63d36b1ac374c.webp",{"_160":218,"_57":450,"_234":451,"_236":452,"_238":453,"_240":353,"_163":454,"_244":456},"ig30ise-x","IG30ISE-X","IG30ISE-X Ionenselektive Elektrode","Die ionenselektive Messung unterstützt konfigurierte Ionenparameter und pH in der Wasserüberwachung. Die Tauchsonde benötigt kein separates Probenahmesystem und bietet Kompensations- sowie Kalibrierfunktionen für Anwendungen in Trinkwasser, Umweltmessung und Abwasser; die Parameter werden anwendungsbezogen ausgewählt.",{"_57":164,"_242":-5,"_236":109,"_147":-5,"_144":455},{"_103":109,"_147":-5,"_149":-5,"_150":151},{"_160":457,"_140":172,"_173":458,"_175":248,"_177":459,"_179":460,"_181":192,"_183":461,"_185":462,"_187":463,"_189":464},"c6e3c765-909d-45fd-bd1c-7dbc51fecd54","2025041051038309.png",13330,"8936108072d3c61053c40f382494eb98c8734713fb66a99450bf2aedb26fb684",120,"/igenu-preview/media/8936108072d3c61053c40f38.png","2026-10-20T17:32:39.882Z",[465],{"_181":192,"_183":461,"_175":194,"_185":466},"/igenu-preview/media/f11ab30d5325a31abe0f2adb.webp",{"_160":219,"_57":468,"_234":469,"_236":470,"_238":471,"_240":353,"_163":472,"_244":474},"ig30ph01","IG30PH01","IG30PH01 Analoge pH-Elektrode","Die analoge pH-Elektrode verbindet eine Gelbefüllung mit einem Referenzsystem mit doppelter Salzbrücke für Wasser- und Prozessmessungen. Ein integrierter Temperatursensor unterstützt die Kompensation; Halterung und Durchflusszelle erleichtern die Installation an dem für die Anwendung vorgesehenen Messpunkt.",{"_57":164,"_242":-5,"_236":109,"_147":-5,"_144":473},{"_103":109,"_147":-5,"_149":-5,"_150":151},{"_160":274,"_140":172,"_173":275,"_175":176,"_177":276,"_179":277,"_181":278,"_183":279,"_185":280,"_187":281,"_189":475},[476,477],{"_181":192,"_183":284,"_175":194,"_185":285},{"_181":278,"_183":279,"_175":194,"_185":287},{"_160":220,"_57":479,"_234":480,"_236":481,"_238":482,"_240":353,"_163":483,"_244":485},"ig30ptco","IG30PTCO","IG30PTCO Sensor für Wasserfärbung","Die optische Absorptionsmessung erfasst die Wasserfärbung anhand der Platin-Cobalt-Farbskala. Automatische Trübungskompensation und eine Reinigungsbürste unterstützen den Onlinebetrieb; gespeicherte Kalibrierwerte und digitale Kommunikation erleichtern die Verbindung mit dem Wasserüberwachungssystem und die Einrichtung am vorgesehenen Messpunkt.",{"_57":164,"_242":-5,"_236":109,"_147":-5,"_144":484},{"_103":109,"_147":-5,"_149":-5,"_150":151},{"_160":419,"_140":172,"_173":420,"_175":176,"_177":421,"_179":422,"_181":361,"_183":361,"_185":423,"_187":424,"_189":486},[487,488],{"_181":192,"_183":192,"_175":194,"_185":427},{"_181":361,"_183":361,"_175":194,"_185":429},{"_160":221,"_57":490,"_234":491,"_236":492,"_238":493,"_240":353,"_163":494,"_244":496},"ig30rps","IG30RPS","IG30RPS Digitale Redoxelektrode","Die digitale Redoxelektrode überwacht das Oxidations-Reduktions-Potenzial in Wasser und industriellen Prozessen. Eine Platin-Messelektrode und ein Referenzsystem mit doppelter Salzbrücke werden durch digitale Kommunikation, Proben- oder Standardkalibrierung sowie Halterung und Durchflusszelle für die Installation ergänzt.",{"_57":164,"_242":-5,"_236":109,"_147":-5,"_144":495},{"_103":109,"_147":-5,"_149":-5,"_150":151},{"_160":274,"_140":172,"_173":275,"_175":176,"_177":276,"_179":277,"_181":278,"_183":279,"_185":280,"_187":281,"_189":497},[498,499],{"_181":192,"_183":284,"_175":194,"_185":285},{"_181":278,"_183":279,"_175":194,"_185":287},{"_160":222,"_57":501,"_234":502,"_236":503,"_238":504,"_240":353,"_163":505,"_244":507},"ig30rps01","IG30RPS01","IG30RPS01 Analoge Redoxelektrode","Die analoge Redoxelektrode erfasst das Oxidations-Reduktions-Potenzial in der Wasseraufbereitung und Prozessüberwachung. Platin-Messelement und Referenzsystem mit doppelter Salzbrücke werden durch Proben- und Standardkalibrierung sowie eine Halterung und Durchflusszelle für den Einbau am vorgesehenen Messpunkt ergänzt.",{"_57":164,"_242":-5,"_236":109,"_147":-5,"_144":506},{"_103":109,"_147":-5,"_149":-5,"_150":151},{"_160":274,"_140":172,"_173":275,"_175":176,"_177":276,"_179":277,"_181":278,"_183":279,"_185":280,"_187":281,"_189":508},[509,510],{"_181":192,"_183":284,"_175":194,"_185":285},{"_181":278,"_183":279,"_175":194,"_185":287},{"_160":223,"_57":512,"_234":513,"_236":514,"_238":515,"_240":353,"_163":516,"_244":518},"ig30tpy","IG30TPY","IG30TPY Sensor für Wassertransparenz","Die Durchlichtmessung liefert Werte für Wassertransparenz und Temperatur ohne chemische Reagenzien. Eine kompakte digitale Sonde mit automatischer Reinigungsbürste unterstützt die Onlineüberwachung von Oberflächengewässern, Flussläufen und Aquakulturen und begrenzt Ablagerungen an der optischen Messfläche im Wasser.",{"_57":164,"_242":-5,"_236":109,"_147":-5,"_144":517},{"_103":109,"_147":-5,"_149":-5,"_150":151},{"_160":419,"_140":172,"_173":420,"_175":176,"_177":421,"_179":422,"_181":361,"_183":361,"_185":423,"_187":424,"_189":519},[520,521],{"_181":192,"_183":192,"_175":194,"_185":427},{"_181":361,"_183":361,"_175":194,"_185":429},{"_160":224,"_57":523,"_234":524,"_236":525,"_238":526,"_240":353,"_163":527,"_244":529},"ig3254cod","IG3254COD","IG3254COD UV-Sensor für CSB und TOC","Die UV-Absorptionsmessung unterstützt die Onlinebestimmung von CSB und TOC ohne Reagenziendosierung. Trübungskompensation, Kalibrieroptionen und eine verfügbare automatische Reinigung passen die digitale Sonde an die Wasserüberwachung an; Ergebnisse werden entsprechend der gewählten Kalibrierung und Messkonfiguration interpretiert.",{"_57":164,"_242":-5,"_236":109,"_147":-5,"_144":528},{"_103":109,"_147":-5,"_149":-5,"_150":151},{"_160":530,"_140":172,"_173":531,"_175":176,"_177":532,"_179":533,"_181":361,"_183":361,"_185":534,"_187":535,"_189":536},"79d9f104-d914-4e36-bec2-d6d2b843fefd","2025041051182309.jpg",14215,"e3e2c21db606165f614650cf931244737a0e84793f3dd9ab8bd834db8aa5b8b3","/igenu-preview/media/e3e2c21db606165f614650cf.jpg","2026-10-20T17:32:39.888Z",[537,539],{"_181":192,"_183":192,"_175":194,"_185":538},"/igenu-preview/media/087409fcbd7eefe1aec06c53.webp",{"_181":361,"_183":361,"_175":194,"_185":540},"/igenu-preview/media/6d889354b11ab94fb489a773.webp",{"_160":225,"_57":542,"_234":543,"_236":544,"_238":545,"_240":353,"_163":546,"_244":548},"ig3500","IG3500","IG3500 Restchloranalysator","Der Analysator bestimmt Restchlor im Wasser mittels DPD-Kolorimetrie für Versorgungs- und Prozessanwendungen. Optische Störgrößenkompensation, automatische Reinigung und Datenspeicherung werden durch Relaisausgänge zur Steuerungsanbindung sowie ein optionales Kommunikationsmodul für die Fernübertragung der Messwerte ergänzt.",{"_57":164,"_242":-5,"_236":109,"_147":-5,"_144":547},{"_103":109,"_147":-5,"_149":-5,"_150":151},{"_160":549,"_140":172,"_173":550,"_175":248,"_177":551,"_179":552,"_181":553,"_183":554,"_185":555,"_187":556,"_189":557},"c50c4c9d-55bb-4423-8c3e-781ffff460bb","2025040937453857.jpg",161037,"8851b0c528aa8f3f11bac4d54c4a5ffd8e6ba0b79e7a6a527d4c31805dbb2c25",439,577,"/igenu-preview/media/8851b0c528aa8f3f11bac4d5.png","2026-10-20T17:32:39.818Z",[558,561],{"_181":192,"_183":559,"_175":194,"_185":560},421,"/igenu-preview/media/a94dedbc4c305ed00e17532e.webp",{"_181":553,"_183":554,"_175":194,"_185":562},"/igenu-preview/media/addc2737c9f6397359f3a546.webp",{"_160":226,"_57":564,"_234":565,"_236":566,"_238":567,"_240":353,"_163":568,"_244":570},"ig3500an","IG3500AN","IG3500AN Analysator für Ammoniak- und Ammoniumstickstoff","Die Salicylat-Photometrie bestimmt Ammoniak- und Ammoniumstickstoff im Wasser. Automatische Bereichsumschaltung, Qualitätskontrollen und Betriebsprotokolle unterstützen den Onlinebetrieb; Alarmfunktionen und elektrische Kommunikationsschnittstellen ermöglichen die Einbindung in Systeme für Trinkwasser, Umweltüberwachung und Abwasser sowie die Übertragung von Messwerten.",{"_57":164,"_242":-5,"_236":109,"_147":-5,"_144":569},{"_103":109,"_147":-5,"_149":-5,"_150":151},{"_160":571,"_140":172,"_173":572,"_175":248,"_177":573,"_179":574,"_181":202,"_183":575,"_185":576,"_187":577,"_189":578},"bfda7f5e-e504-4c40-85f0-1afea6d4aba3","2025040938476253.jpg",51146,"076a24550dfec7d99b95ba8827dbead49c4506dc3d55d9d8b47b0c95d2a2c36e",435,"/igenu-preview/media/076a24550dfec7d99b95ba88.png","2026-10-20T17:32:39.824Z",[579],{"_181":202,"_183":575,"_175":194,"_185":580},"/igenu-preview/media/f3d468788765b050ceafe139.webp",{"_160":227,"_57":582,"_234":583,"_236":584,"_238":585,"_240":353,"_163":586,"_244":588},"ig3500codmn","IG3500CODMN","IG3500CODmn Analysator für den Permanganatindex","Die Oxidation mit Kaliumpermanganat und anschließende Titration bestimmen den Permanganatindex im Wasser. Automatische Bereichsumschaltung, Qualitätskontrollen und Betriebsprotokolle unterstützen die Onlineüberwachung; Alarmfunktionen und elektrische Schnittstellen ermöglichen die Einbindung des Analysators in ein übergeordnetes System.",{"_57":164,"_242":-5,"_236":109,"_147":-5,"_144":587},{"_103":109,"_147":-5,"_149":-5,"_150":151},{"_160":571,"_140":172,"_173":572,"_175":248,"_177":573,"_179":574,"_181":202,"_183":575,"_185":576,"_187":577,"_189":589},[590],{"_181":202,"_183":575,"_175":194,"_185":580},{"_160":228,"_57":592,"_234":593,"_236":594,"_238":595,"_240":353,"_163":596,"_244":598},"ig3500tn","IG3500TN","IG3500TN Gesamtstickstoffanalysator","Ein alkalischer Persulfataufschluss mit anschließender UV-Photometrie bestimmt den Gesamtstickstoff im Wasser. Automatische Bereichsumschaltung, Qualitätskontrollen und Messprotokolle unterstützen den Onlinebetrieb; Kommunikations- und Alarmfunktionen ermöglichen die Anbindung an übergeordnete Systeme zur Umweltüberwachung und Abwasserkontrolle vor Ort.",{"_57":164,"_242":-5,"_236":109,"_147":-5,"_144":597},{"_103":109,"_147":-5,"_149":-5,"_150":151},{"_160":571,"_140":172,"_173":572,"_175":248,"_177":573,"_179":574,"_181":202,"_183":575,"_185":576,"_187":577,"_189":599},[600],{"_181":202,"_183":575,"_175":194,"_185":580},{"_160":229,"_57":602,"_234":603,"_236":604,"_238":605,"_240":353,"_163":606,"_244":608},"ig3500tp","IG3500TP","IG3500TP Gesamtphosphoranalysator","Probenaufschluss und Ammoniummolybdat-Photometrie bestimmen den Gesamtphosphor im Wasser. Automatische Bereichsumschaltung, Qualitätskontrollen und Messprotokolle unterstützen den Onlinebetrieb; Kommunikationsschnittstellen und Alarmfunktionen ermöglichen die Einbindung in Anwendungen der Umweltüberwachung sowie der Trinkwasser- und Abwasserkontrolle am jeweiligen Standort.",{"_57":164,"_242":-5,"_236":109,"_147":-5,"_144":607},{"_103":109,"_147":-5,"_149":-5,"_150":151},{"_160":571,"_140":172,"_173":572,"_175":248,"_177":573,"_179":574,"_181":202,"_183":575,"_185":576,"_187":577,"_189":609},[610],{"_181":202,"_183":575,"_175":194,"_185":580},{"_160":230,"_57":612,"_234":613,"_236":614,"_238":615,"_240":353,"_163":616,"_244":619},"ig9000","IG9000","IG9000 Ultraschall-Füllstandsmessgerät","Die Ultraschall-Laufzeitmessung überwacht Füllstände von Flüssigkeiten und Schüttgütern ohne direkten Medienkontakt. Kompakt- und Getrenntausführungen, Signalanalyse und Temperaturkompensation unterstützen den Einbau in Wasseraufbereitung, Lagertanks und weiteren Füllstandsanwendungen sowie die Anpassung an die jeweilige Messstelle.",{"_57":617,"_242":-5,"_236":113,"_147":-5,"_144":618},"industrial",{"_103":113,"_147":-5,"_149":-5,"_150":151},{"_160":620,"_140":172,"_173":621,"_175":248,"_177":622,"_179":623,"_181":624,"_183":625,"_185":626,"_187":627,"_189":628},"485bff13-2df9-448f-a8bc-6b60b3e5ad76","2025040851503805.png",698863,"8ef050d2f42f424a5466c7f703dc0ddcbb2915dc23bdee338481847f3cefa2dd",2604,1704,"/igenu-preview/media/8ef050d2f42f424a5466c7f7.png","2026-10-20T17:32:39.690Z",[629,632,635,638,641],{"_181":192,"_183":630,"_175":194,"_185":631},209,"/igenu-preview/media/63971d02adf57bfde6335036.webp",{"_181":197,"_183":633,"_175":194,"_185":634},419,"/igenu-preview/media/94e5c9a427aaff2e7fe15add.webp",{"_181":201,"_183":636,"_175":194,"_185":637},628,"/igenu-preview/media/6403302113043098a393f716.webp",{"_181":251,"_183":639,"_175":194,"_185":640},838,"/igenu-preview/media/bd1f66f7ac71cc90284d1d8d.webp",{"_181":642,"_183":643,"_175":194,"_185":644},1600,1047,"/igenu-preview/media/0f4d290e7e86d3dd29596237.webp","sourceSections",[647],{"_160":648,"_649":650,"_7":651,"_659":-5,"_660":661},"d2deb83f-cae4-4fad-853d-147f88540b85","type","TEXT_IMAGE",{"_652":38,"_653":165,"_167":654,"_655":656,"_657":658},"body","heading","<p>ob in form von überwachungsstationen oder mobilen labors (feste oder mobile stationen), neue umwelt spielt eine rolle bei dem schutz von oberflächengewässern, wasser, flüsse und grundwasser.das ziel ist eine echtzeit - maßnahmen, die verschmutzung der oberflächengewässer, um, wenn nötig, schutz des trinkwassers an der quelle.</p>","sourceNotes",[],"imagePosition","right","media","mediaItems",[]]
