ion",[102,118],{"_103":104,"_105":106},"title","产品","links",[107,112,115],{"_108":109,"_110":111},"label","Wasseranalyse","href","/de/products?category=water",{"_108":113,"_110":114},"Industrielle Messung","/de/products?category=industrial",{"_108":116,"_110":117},"Gasdetektion","/de/products?category=gas",{"_103":119,"_105":120},"了解更多",[121,124,127,130,133],{"_108":122,"_110":123},"关于我们","/de/about",{"_108":125,"_110":126},"客户案例","/de/cases",{"_108":128,"_110":129},"新闻中心","/de/news",{"_108":131,"_110":132},"售后服务","/de/service",{"_108":134,"_110":135},"下载中心","/de/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig9500",[],[],"seo",{"_103":146,"_147":148,"_149":150,"_151":152},"IG9500 Tauchsonde zur Füllstandsmessung | IGENU SCIENCE","description","Die druckbasierte Tauchsonde misst Flüssigkeitsstände mit einem Silizium-Messelement in einem abgedichteten Edelstahlgehäuse. Wählbare Ausgänge unterstützen die Überwachung von Behältern, Wassersystemen und Pumpanlagen; die medienberührten Werkstoffe werden auf die zu messende Flüssigkeit und den Einsatzort abgestimmt.","imageUrl","/igenu-preview/media/4faf3f82eaab6ca730d4cb0b.png","index",true,"canonical","https://eicloc.github.io/igenu-preview/de/products/ig9500","query",{},"selected",[],"detail",{"_161":162,"_57":141,"_163":164,"_165":166,"_167":148,"_168":169,"_170":171,"_175":176,"_203":204,"_205":206,"_147":-5,"_207":208,"_209":210,"_211":212,"_213":214,"_266":267,"_268":269,"_270":271,"_144":145},"id","0e1e5a66-1d38-4043-9a18-089fbc0ccd6a","model","IG9500","name","IG9500 Tauchsonde zur Füllstandsmessung","shortDescription","featured",false,"category",{"_57":172,"_173":-5,"_165":113,"_147":-5,"_144":174},"industrial","brand",{"_103":113,"_147":-5,"_149":-5,"_151":152},"heroImage",{"_161":177,"_140":178,"_179":180,"_181":182,"_183":184,"_185":186,"_187":188,"_189":190,"_191":150,"_192":193,"_194":195},"2c2a9461-2d1e-4d92-9b2f-bb3264ca2631","IMAGE","originalName","2025040851522761.jpg","mimeTy