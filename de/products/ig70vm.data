[{"_1":2,"_7":8},"root",{"_3":4},"data",{"_5":6},"productView","grid","content",{"_3":9},{"_10":11,"_12":13,"_14":15,"_140":58,"_57":141,"_64":142,"_70":143,"_144":145,"_153":154,"_155":156,"_157":158,"_159":160},"locale","de","origin","https://eicloc.github.io","settings",{"_16":17,"_18":19,"_21":22,"_23":24,"_54":55,"_86":87,"_88":89,"_26":27,"_28":29,"_37":-5,"_90":91,"_92":-5,"_93":94,"_95":96,"_97":98,"_99":-5,"_100":101,"_136":-5,"_137":-5,"_138":139},"defaultLocale","en","enabledLocales",[17,20,11],"zh-CN","logoUrl","/igenu-preview/media/f607ce2a51366ba8778f1000.jpg","regionalContacts",[25,39,47],{"_26":27,"_28":29,"_30":31,"_35":36,"_37":38},"email","Germany@igenu.com","phone","0049-935890-024","labels",{"_11":32,"_17":33,"_20":34},"Deutschland","Germany","德国","region","GERMANY","address","",{"_26":40,"_28":41,"_30":42,"_35":46,"_37":38},"cn@igenu.com","400-002-1266",{"_11":43,"_17":44,"_20":45},"Servicezentrum China","China service center","中国服务中心","CHINA",{"_26":48,"_28":38,"_30":49,"_35":53,"_37":38},"info@igenu-germany.com",{"_11":50,"_17":51,"_20":52},"Internationale Anfragen","International enquiries","国际业务咨询","INTERNATIONAL","navigation",[56,63,69,75,81],{"_57":58,"_30":59},"slug","products",{"_11":60,"_17":61,"_20":62},"Instrumente","Instruments","产品中心",{"_57":64,"_30":65},"parameters",{"_11":66,"_17":67,"_20":68},"Messparameter","Parameters","测量参数",{"_57":70,"_30":71},"applications",{"_11":72,"_17":73,"_20":74},"Anwendungen","Applications","应用方案",{"_57":76,"_30":77},"about",{"_11":78,"_17":79,"_20":80},"Über IGENU","About IGENU","关于 IGENU",{"_57":82,"_30":83},"service",{"_11":84,"_17":84,"_20":85},"Support","服务支持","companyName","IGENU SCIENCE","tagline","Umwelt verstehen. Prozesse beherrschen.","footer","Messtechnik für Wasser, industrielle Prozesse und Gasdetektion. Entdecken Sie die Technik für Ihre nächste Messaufgabe.","copyright","primaryCta","Experten kontaktieren","primaryCtaUrl","/contact","socialLinks",{},"defaultSeoImageUrl","footerNavigation",[102,118],{"_103":104,"_105":106},"title","产品","links",[107,112,115],{"_108":109,"_110":111},"label","Wasseranalyse","href","/de/products?category=water",{"_108":113,"_110":114},"Industrielle Messung","/de/products?category=industrial",{"_108":116,"_110":117},"Gasdetektion","/de/products?category=gas",{"_103":119,"_105":120},"了解更多",[121,124,127,130,133],{"_108":122,"_110":123},"关于我们","/de/about",{"_108":125,"_110":126},"客户案例","/de/cases",{"_108":128,"_110":129},"新闻中心","/de/news",{"_108":131,"_110":132},"售后服务","/de/service",{"_108":134,"_110":135},"下载中心","/de/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig70vm",[],[],"seo",{"_103":146,"_147":148,"_149":150,"_151":152},"IG70VM Thermischer Gasmassendurchflussmesser | IGENU SCIENCE","description","Die thermische Messung bestimmt den Gasmassenstrom anhand eines beheizten Referenzelements und eines Temperaturvergleichs. Ohne bewegliche Sensorkomponenten und mit wählbaren Signalschnittstellen unterstützt das Gerät die Gasdurchflussüberwachung in petrochemischen Anlagen, Energieerzeugung und metallurgischen Prozessen am Messpunkt.","imageUrl","/igenu-preview/media/7f449f38ed6bf8e134b99b22.png","index",true,"canonical","https://eicloc.github.io/igenu-preview/de/products/ig70vm","query",{},"selected",[],"detail",{"_161":162,"_57":141,"_163":164,"_165":166,"_167":148,"_168":169,"_170":171,"_175":176,"_199":200,"_201":202,"_147":-5,"_203":204,"_205":206,"_220":221,"_222":223,"_287":288,"_289":290,"_291":292,"_144":145},"id","c21fd893-48c8-47d3-a114-c7748db71a81","model","IG70VM","name","IG70VM Thermischer Gasmassendurchflussmesser","shortDescription","featured",false,"category",{"_57":172,"_173":-5,"_165":113,"_147":-5,"_144":174},"industrial","brand",{"_103":113,"_147":-5,"_149":-5,"_151":152},"heroImage",{"_161":177,"_140":178,"_179":180,"_181":182,"_183":184,"_185":186,"_187":188,"_189":190,"_191":150,"_192":193,"_194":195},"287d31f2-573d-40b0-8a95-78fa8fb30365","IMAGE","originalName","2025040855196033.jpg","mimeType","image/png","size",118746,"sha256","7f449f38ed6bf8e134b99b22ebc9fa0c38477f3744c6a59cd166d471f92c6feb","width",255,"height",555,"url","createdAt","2026-10-20T17:32:39.741Z","variants",[196],{"_187":188,"_189":190,"_181":197,"_191":198},"image/webp","/igenu-preview/media/e43bee78aa0a1ae068fb4bf4.webp","detailLayout","STRUCTURED","availableLocales",[20,11,17],"bodyHtml","<span><strong>Produktmerkmale:</strong></span><br />◆Ein echtes Qualitäts-Durchflussmessgerät, das keine Temperatur- und Druckkompensation für die Gasdurchflussmessung erfordert, was die Messung bequem und präzise macht. Kann den Massendurchsatz oder den Standardvolumenstrom von Gas erhalten<br />◆ Weitbereichsverhältnis, fähig, Gase mit Durchflussraten von 100Nm/s bis 0.2Nm/s zu messen und kann für die Gasleckerkennung verwendet werden<br />◆Gute seismische Leistung und lange Lebensdauer. Der Sensor hat keine beweglichen Teile oder Drucksensorkomponenten und wird nicht durch Vibrationen auf die Messgenauigkeit beeinflusst<br />◆ Einfache Installation und Wartung. Wenn die Bedingungen vor Ort es zulassen, können ununterbrochene Installation und Wartung erreicht werden<br />◆Mit RS-485 Kommunikation oder HART Kommunikation können Fabrikautomation und -integration erreicht werden<br /><span><strong>Anwendungsbereiche:</strong></span><br />Petrochemikalie, Umweltschutz, Wasseraufbereitung, thermische Energie, Schmelzen, Medizin<br /><span><strong>Technische Parameter:</strong></span><br />Messmedium: verschiedene Gase (ohne Acetylengas)<br />Messbereich: DN10~4000mm  ND25~2000mm <br />Durchfluss: 0.2~100Nm/s<br />Genauigkeit: ± 0,5%<br />Arbeitstemperatur: Sensor: Raumtemperaturtyp -10~200 ℃ Hochtemperaturtyp -10~350 ℃ Konverter:- 20～45℃ <br />Arbeitsdruck: mittlerer Druck ≤ 2.5Mpa mittlerer Druck ≤ 4Mpa<br />Stromversorgung: All-in-one Maschine (DC24V oder AC220V ≤ 18W) geteilte Art (AC220V ≤ 19W)<br />Ansprechgeschwindigkeit: 1S<br />Ausgang: 4-20mA (photoelektrische Trennung, maximale Last 500 Ω), RS485 (photoelektrische Trennung), HART Protokoll<br />Rohrleitungsmaterial: Kohlenstoffstahl, Edelstahl, Kunststoff, etc<br />Display: Vierzeilige LCD-Anzeige<br />Anzeigeinhalt: Massendurchsatz, Standardbedingungsvolumendurchsatz, kumulative Durchflussrate, Standardzeit, kumulative Betriebszeit, mittlere Temperatur, Standarddurchsatz usw.<br />Schutzart: IP67 für Primärzähler<br />Sensor Material: Edelstahl/Kohlenstoffstahl\n    ","gallery",[207],{"_161":208,"_140":178,"_179":209,"_181":210,"_183":211,"_185":212,"_187":213,"_189":214,"_191":215,"_192":216,"_194":217},"065cc5b0-e98f-4705-b61d-45043501843d","2022042942150065.jpg","image/jpeg",16946,"4992623265b6e7526ebac02e17ae603479bf473915f8bd172a72f5ba5954fc5b",251,399,"/igenu-preview/media/4992623265b6e7526ebac02e.jpg","2026-10-20T17:32:39.680Z",[218],{"_187":213,"_189":214,"_181":197,"_191":219},"/igenu-preview/media/9e57d7becb2756c38d1975b2.webp","features",[],"specificationGroups",[224],{"_165":225,"_226":227},"Technische Daten","specifications",[228,235,239,243,247,251,255,259,263,267,271,275,279,283],{"_229":230,"_108":231,"_232":233,"_234":-5},"key","medium","Messmedium","value","verschiedene Gase (ohne Acetylengas)","unit",{"_229":236,"_108":237,"_232":238,"_234":-5},"measurement-range","Messbereich","DN10~4000mm  ND25~2000mm",{"_229":240,"_108":241,"_232":242,"_234":-5},"flow-rate","Durchfluss","0.2~100Nm/s",{"_229":244,"_108":245,"_232":246,"_234":-5},"accuracy","Genauigkeit","± 0,5%",{"_229":248,"_108":249,"_232":250,"_234":-5},"operating-temperature","Arbeitstemperatur","Sensor: Raumtemperaturtyp -10~200 ℃ Hochtemperaturtyp -10~350 ℃ Konverter:- 20～45℃",{"_229":252,"_108":253,"_232":254,"_234":-5},"pressure","Arbeitsdruck","mittlerer Druck ≤ 2.5Mpa mittlerer Druck ≤ 4Mpa",{"_229":256,"_108":257,"_232":258,"_234":-5},"power-supply","Stromversorgung","All-in-one Maschine (DC24V oder AC220V ≤ 18W) geteilte Art (AC220V ≤ 19W)",{"_229":260,"_108":261,"_232":262,"_234":-5},"response-time","Ansprechgeschwindigkeit","1S",{"_229":264,"_108":265,"_232":266,"_234":-5},"output","Ausgang","4-20mA (photoelektrische Trennung, maximale Last 500 Ω), RS485 (photoelektrische Trennung), HART Protokoll",{"_229":268,"_108":269,"_232":270,"_234":-5},"pipeline-material","Rohrleitungsmaterial","Kohlenstoffstahl, Edelstahl, Kunststoff, etc",{"_229":272,"_108":273,"_232":274,"_234":-5},"display","Display","Vierzeilige LCD-Anzeige",{"_229":276,"_108":277,"_232":278,"_234":-5},"display-content","Anzeigeinhalt","Massendurchsatz, Standardbedingungsvolumendurchsatz, kumulative Durchflussrate, Standardzeit, kumulative Betriebszeit, mittlere Temperatur, Standarddurchsatz usw.",{"_229":280,"_108":281,"_232":282,"_234":-5},"protection","Schutzart","IP67 für Primärzähler",{"_229":284,"_108":285,"_232":286,"_234":-5},"sensor-material","Sensor Material","Edelstahl/Kohlenstoffstahl","sourceReviews",[],"documents",[],"supportDownloads",[]]
