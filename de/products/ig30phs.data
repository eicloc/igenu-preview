ion",[102,118],{"_103":104,"_105":106},"title","产品","links",[107,112,115],{"_108":109,"_110":111},"label","Wasseranalyse","href","/de/products?category=water",{"_108":113,"_110":114},"Industrielle Messung","/de/products?category=industrial",{"_108":116,"_110":117},"Gasdetektion","/de/products?category=gas",{"_103":119,"_105":120},"了解更多",[121,124,127,130,133],{"_108":122,"_110":123},"关于我们","/de/about",{"_108":125,"_110":126},"客户案例","/de/cases",{"_108":128,"_110":129},"新闻中心","/de/news",{"_108":131,"_110":132},"售后服务","/de/service",{"_108":134,"_110":135},"下载中心","/de/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig30phs",[],[],"seo",{"_103":146,"_147":148,"_149":150,"_151":152},"IG30PHS Digitale pH-Elektrode | IGENU SCIENCE","description","Die digitale pH-Elektrode kombiniert Gelbefüllung, ein Referenzsystem mit doppelter Salzbrücke und integrierte Temperaturerfassung. Modbus ermöglicht die Verbindung mit kompatiblen Reglern; Kalibrieroptionen sowie mitgelieferte Halterung und Durchflusszelle unterstützen Installation und Routinebetrieb am Messpunkt der jeweiligen Anlage.","imageUrl","/igenu-preview/media/7dfe5452c927d26232963ff8.jpg","index",true,"canonical","https://eicloc.github.io/igenu-preview/de/products/ig30phs","query",{},"selected",[],"detail",{"_161":162,"_57":141,"_163":164,"_165":166,"_167":148,"_168":152,"_169":170,"_174":175,"_202":203,"_204":205,"_147":-5,"_206":207,"_208":209,"_210":211,"_212":213,"_305":306,"_307":308,"_309":310,"_144":145},"id","331a2881-86de-42d4-aad2-8985fb41f4ba","model","IG30PHS","name","IG30PHS Digitale pH-Elektrode","shortDescription","featured","category",{"_57":171,"_172":-5,"_165":109,"_147":-5,"_144":173},"water","brand",{"_103":109,"_147":-5,"_149":-5,"_151":152},"heroImage",{"_161":176,"_140":177,"_178":179,"_180":181,"_182":183,"_184":185,"_186":187,"_188":189,"_190":150,"_191":192,"_193":194},"7507b7cd-7dc3-42b2-90a4-f843106d4461","IMAGE","originalName","2025040859520101.png","mimeType","image/jpeg","size",19079,"sha256","7dfe5452c927d26232963ff85f11073f15b9d29010abcb394bea3ce0f2f502d6","width",358,"height",302,"url","createdAt","2026-10-20T17:32:39.754Z","variants",[195,200],{"_186":196,"_188":197,"_180":198,"_190":199},320,270,"image/webp","/igenu-preview/media/93a066c50a54638353b43bbf.webp",{"_186":187,"_188":189,"_180":198,"_190":201},"/igenu-preview/media/b72cc265fa7500183b25c7da.webp","detailLayout","STRUCTURED","availableLocales",[20,11,17],"bodyHtml","<p><strong><span>Produktmerkmale:</span></strong><br />◆ Reiche Konfiguration, um verschiedene Arbeitsbedingungen Anforderungen zu erfüllen<br />◆ Eingebauter Temperatursensor, automatische Temperaturkompensation<br />◆ Automatische Identifizierung der Standardlösung, optionale 1-Punkt-, 2-Punkt-Standardlösungskalibrierung und 1-Punkt-Probenkalibrierung<br />◆ Digitalsensor, Standard Modbus RTU Protokoll, nicht beeinflusst durch Übertragungsabstand, bessere Stabilität<br />◆Der Sensor besteht aus Ryton Material, das eine längere Lebensdauer hat und Wartung und Ausfallzeiten reduziert<br />◆ Mikroporöse Doppelsalzbrücke der großen Kapazität macht die Sonde widerstandsfähiger gegen Toxizität und hat eine längere Lebensdauer<br />◆ Dicke und hochohmige Blase mit starker struktureller Festigkeit, nicht leicht durch Partikelschlag beschädigt<br />◆ Geschirmte Schalenverpackung, nicht durch elektromagnetische Störungen der Umwelt beeinträchtigt<br /><span><strong>Anwendungsbereiche:</strong></span><br />Oberflächenwasser, kommunales Abwasser, Umweltüberwachung, industrielle Prozesskontrolle, Verschmutzungsquellen, industrielles Abwasser, Leitungswasser, Biopharmazeutika, Bier und Getränke, Erdöl und Petrochemie, Metallurgie<br /><span><strong>Technische Parameter:</strong></span><br />Messbereich: 0-14pH; Temperatur:- 5-105℃<br />Auflösung: 0.01 pH, 0.1 ℃<br />Genauigkeit: ± 0,01 pH<br />Wiederholbarkeit: 0,01 pH<br />Arbeitsumgebung: 0-95 ℃<br />Reaktionszeit: bis zu 95% in 30 Sekunden<br />Drift: ≤ 0.02 pH/24h ohne Akkumulation<br />Höchstdruck: 8,0bar<br />Maximale Strömungsgeschwindigkeit: 3 Meter pro Sekunde<br />Kalibrierungsmethode: Eine Punktprobe, eine Punktstandardlösung, Zwei-Punkt-Standardlösung Kalibrierung<br />Standardlösungsauswahl: manuell, automatisch<br />Temperaturausgleich: automatisch<br />Temperaturelektrode: PT1000<br />Elektrodenform: digitale Elektrode<br />Referenzelektrode: PTFE poröse Salzbrücke Flüssigkeitsverbindung<br />Kommunikationsschnittstelle: ModbusRS485<br />Elektrodenmaterial: PEEK、Ryton<br />Gewindeschnittstelle: Front und Heck Standard 3/4NPT<br />Schutzniveau: IP68<br />Kabellänge: Standard 10m, ausziehbar<br />Elektrodengröße: 165mm bis 25mm<br /></p>\n    ","gallery",[],"features",[],"specificationGroups",[214],{"_165":215,"_216":217},"Technische Daten","specifications",[218,225,229,233,237,241,245,249,253,257,261,265,269,273,277,281,285,289,293,297,301],{"_219":220,"_108":221,"_222":223,"_224":-5},"key","measurement-range","Messbereich","value","0-14pH; Temperatur:- 5-105℃","unit",{"_219":226,"_108":227,"_222":228,"_224":-5},"resolution","Auflösung","0.01 pH, 0.1 ℃",{"_219":230,"_108":231,"_222":232,"_224":-5},"accuracy","Genauigkeit","± 0,01 pH",{"_219":234,"_108":235,"_222":236,"_224":-5},"repeatability","Wiederholbarkeit","0,01 pH",{"_219":238,"_108":239,"_222":240,"_224":-5},"operating-temperature","Arbeitsumgebung","0-95 ℃",{"_219":242,"_108":243,"_222":244,"_224":-5},"response-time","Reaktionszeit","bis zu 95% in 30 Sekunden",{"_219":246,"_108":247,"_222":248,"_224":-5},"drift","Drift","≤ 0.02 pH/24h ohne Akkumulation",{"_219":250,"_108":251,"_222":252,"_224":-5},"maximum-pressure","Höchstdruck","8,0bar",{"_219":254,"_108":255,"_222":256,"_224":-5},"maximum-flow","Maximale Strömungsgeschwindigkeit","3 Meter pro Sekunde",{"_219":258,"_108":259,"_222":260,"_224":-5},"calibration","Kalibrierungsmethode","Eine Punktprobe, eine Punktstandardlösung, Zwei-Punkt-Standardlösung Kalibrierung",{"_219":262,"_108":263,"_222":264,"_224":-5},"standard-solution","Standardlösungsauswahl","manuell, automatisch",{"_219":266,"_108":267,"_222":268,"_224":-5},"temperature-compensation","Temperaturausgleich","automatisch",{"_219":270,"_108":271,"_222":272,"_224":-5},"temperature-electrode","Temperaturelektrode","PT1000",{"_219":274,"_108":275,"_222":276,"_224":-5},"electrode-form","Elektrodenform","digitale Elektrode",{"_219":278,"_108":279,"_222":280,"_224":-5},"reference-electrode","Referenzelektrode","PTFE poröse Salzbrücke Flüssigkeitsverbindung",{"_219":282,"_108":283,"_222":284,"_224":-5},"digital-communication","Kommunikationsschnittstelle","ModbusRS485",{"_219":286,"_108":287,"_222":288,"_224":-5},"electrode-material","Elektrodenmaterial","PEEK、Ryton",{"_219":290,"_108":291,"_222":292,"_224":-5},"thread","Gewindeschnittstelle","Front und Heck Standard 3/4NPT",{"_219":294,"_108":295,"_222":296,"_224":-5},"protection","Schutzniveau","IP68",{"_219":298,"_108":299,"_222":300,"_224":-5},"cable","Kabellänge","Standard 10m, ausziehbar",{"_219":302,"_108":303,"_222":304,"_224":-5},"electrode-size","Elektrodengröße","165mm bis 25mm","sourceReviews",[],"documents",[],"supportDownloads",[]]
