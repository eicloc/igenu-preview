[{"_1":2,"_7":8},"root",{"_3":4},"data",{"_5":6},"productView","grid","content",{"_3":9},{"_10":11,"_12":13,"_14":15,"_140":58,"_57":141,"_64":142,"_70":143,"_144":145,"_153":154,"_155":156,"_157":158,"_159":160},"locale","de","origin","https://eicloc.github.io","settings",{"_16":17,"_18":19,"_21":22,"_23":24,"_54":55,"_86":87,"_88":89,"_26":27,"_28":29,"_37":-5,"_90":91,"_92":-5,"_93":94,"_95":96,"_97":98,"_99":-5,"_100":101,"_136":-5,"_137":-5,"_138":139},"defaultLocale","en","enabledLocales",[17,20,11],"zh-CN","logoUrl","/igenu-preview/media/f607ce2a51366ba8778f1000.jpg","regionalContacts",[25,39,47],{"_26":27,"_28":29,"_30":31,"_35":36,"_37":38},"email","Germany@igenu.com","phone","0049-935890-024","labels",{"_11":32,"_17":33,"_20":34},"Deutschland","Germany","德国","region","GERMANY","address","",{"_26":40,"_28":41,"_30":42,"_35":46,"_37":38},"cn@igenu.com","400-002-1266",{"_11":43,"_17":44,"_20":45},"Servicezentrum China","China service center","中国服务中心","CHINA",{"_26":48,"_28":38,"_30":49,"_35":53,"_37":38},"info@igenu-germany.com",{"_11":50,"_17":51,"_20":52},"Internationale Anfragen","International enquiries","国际业务咨询","INTERNATIONAL","navigation",[56,63,69,75,81],{"_57":58,"_30":59},"slug","products",{"_11":60,"_17":61,"_20":62},"Instrumente","Instruments","产品中心",{"_57":64,"_30":65},"parameters",{"_11":66,"_17":67,"_20":68},"Messparameter","Parameters","测量参数",{"_57":70,"_30":71},"applications",{"_11":72,"_17":73,"_20":74},"Anwendungen","Applications","应用方案",{"_57":76,"_30":77},"about",{"_11":78,"_17":79,"_20":80},"Über IGENU","About IGENU","关于 IGENU",{"_57":82,"_30":83},"service",{"_11":84,"_17":84,"_20":85},"Support","服务支持","companyName","IGENU SCIENCE","tagline","Umwelt verstehen. Prozesse beherrschen.","footer","Messtechnik für Wasser, industrielle Prozesse und Gasdetektion. Entdecken Sie die Technik für Ihre nächste Messaufgabe.","copyright","primaryCta","Experten kontaktieren","primaryCtaUrl","/contact","socialLinks",{},"defaultSeoImageUrl","footerNavigation",[102,118],{"_103":104,"_105":106},"title","产品","links",[107,112,115],{"_108":109,"_110":111},"label","Wasseranalyse","href","/de/products?category=water",{"_108":113,"_110":114},"Industrielle Messung","/de/products?category=industrial",{"_108":116,"_110":117},"Gasdetektion","/de/products?category=gas",{"_103":119,"_105":120},"了解更多",[121,124,127,130,133],{"_108":122,"_110":123},"关于我们","/de/about",{"_108":125,"_110":126},"客户案例","/de/cases",{"_108":128,"_110":129},"新闻中心","/de/news",{"_108":131,"_110":132},"售后服务","/de/service",{"_108":134,"_110":135},"下载中心","/de/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig30ht",[],[],"seo",{"_103":146,"_147":148,"_149":150,"_151":152},"IG30HT Trübungssensor für hohe Messbereiche | IGENU SCIENCE","description","Die Infrarot-Streulichtmessung erfasst Trübungen in Prozesswasser, Oberflächenwasser und Aufbereitungsanlagen. Die digitale Sonde verbindet optische Kompensation mit einem Saphirfenster; eine optionale Reinigungsbürste hilft, Ablagerungen auf der Messfläche während des laufenden Onlinebetriebs in der Anlage zu reduzieren.","imageUrl","/igenu-preview/media/ecdac2d963d6479b136774a8.png","index",true,"canonical","https://eicloc.github.io/igenu-preview/de/products/ig30ht","query",{},"selected",[],"detail",{"_161":162,"_57":141,"_163":164,"_165":166,"_167":148,"_168":169,"_170":171,"_175":176,"_199":200,"_201":202,"_147":-5,"_203":204,"_205":206,"_207":208,"_209":210,"_294":295,"_296":297,"_298":299,"_144":145},"id","beabf1d3-ee7e-4d27-92b1-039290c217dc","model","IG30HT","name","IG30HT Trübungssensor für hohe Messbereiche","shortDescription","featured",false,"category",{"_57":172,"_173":-5,"_165":109,"_147":-5,"_144":174},"water","brand",{"_103":109,"_147":-5,"_149":-5,"_151":152},"heroImage",{"_161":177,"_140":178,"_179":180,"_181":182,"_183":184,"_185":186,"_187":188,"_189":190,"_191":150,"_192":193,"_194":195},"95eccf83-22e5-4f4d-a03f-5509479d7661","IMAGE","originalName","2025040860985293.jpg","mimeType","image/png","size",11246,"sha256","ecdac2d963d6479b136774a8172895d54061650f1cb8089d1404ff2a26710a79","width",190,"height",78,"url","createdAt","2026-10-20T17:32:39.787Z","variants",[196],{"_187":188,"_189":190,"_181":197,"_191":198},"image/webp","/igenu-preview/media/c0547cb002a63d36b1ac374c.webp","detailLayout","STRUCTURED","availableLocales",[20,11,17],"bodyHtml","<strong><span>Produktmerkmale:</span></strong><br />◆ Eingebauter Temperatursensor, automatische Lichtquelle Temperaturdriftkompensation<br />◆Annahme von Dual Beam Infrarot und Streulicht Photometer Detection Technologie, es hat gute Wiederholbarkeit und Stabilität<br />◆ Digitalsensor, RS-485 Ausgang, Standard Modbus RTU Protokoll, nicht beeinflusst durch Übertragungsabstand, bessere Stabilität<br />◆Der Sensor besteht aus Edelstahl-Material, das eine längere Lebensdauer hat und Wartung und Ausfallzeiten reduziert<br />◆Unter Verwendung einer 860nm Nahinfrarotlichtquelle kann es die Farbstörungen des Beispielhintergrundlichts ausgleichen<br />◆ Ausgestattet mit einem selbstreinigenden System, stabilem Betrieb und minimaler Wartung<br />◆Saphirfenster, langlebig und verschleißfest, gewährleistet langfristige Datengenauigkeit<br />◆ Nicht beeinträchtigt durch Strömungsgeschwindigkeitsinterferenzen und in der Lage, schweren Stößen standzuhalten<br />◆Digitale Sensoren mit starker Interferenz-Fähigkeit und großer Übertragungsabstrecke<br /><strong><span>Anwendungsbereiche:</span></strong><br />Industrielle Prozesswasserüberwachung, Trinkwasseraufbereitung, Oberflächenwasser-/Grundwasserüberwachung, Abwasserbehandlung, Membranfiltrationsüberwachung<br /><strong><span>Technische Parameter:</span></strong><br />Bereich: 0~1000NTU, 0.2~4000 NTU, 0.5~10000NTU<br />Messprinzip: 860nm Wellenlänge, Streulicht bei 90° und 135 °<br />Resolution: 0.001 NTU<br />Messgenauigkeit: ± 1% oder ± 0,1NTU des Messwertes, je nachdem, was größer ist<br />Wiederholbarkeit: weniger als ± 1%<br />Blasenkompensation: softwarebasierte Blasenkompensation<br />Reaktionszeit: T90＜5S<br />Höchstdruck: ≤ 30bar<br />Kalibrierungsmethode: Einzelpunktprobe, Neigungskalibrierung<br />Sensormaterial: Gehäuse: SUS316L； Fenster: Saphir<br />Selbstreinigung: automatische Kratzbürste (optional)<br />Lichtdämpfungskompensation: automatisch<br />Sensorkommunikation: MODBUS RS-485 <br />Lagertemperatur:- 10~50℃ <br />Arbeitstemperatur: 0~45 ℃ (nicht frierend)<br />Schutzniveau: IP68 <br />Kabellänge: Standard 10m, ausziehbar<br />Maximaler Druck: 30bar<br />Maximale Strömungsgeschwindigkeit: 3 Meter pro Sekunde<br />Sensorgröße: 176mm*22mm\n    ","gallery",[],"features",[],"specificationGroups",[211],{"_165":212,"_213":214},"Technische Daten","specifications",[215,222,226,230,234,238,242,246,250,254,258,262,266,270,274,278,282,286,290],{"_216":217,"_108":218,"_219":220,"_221":-5},"key","measurement-range","Bereich","value","0~1000NTU, 0.2~4000 NTU, 0.5~10000NTU","unit",{"_216":223,"_108":224,"_219":225,"_221":-5},"measurement-principle","Messprinzip","860nm Wellenlänge, Streulicht bei 90° und 135 °",{"_216":227,"_108":228,"_219":229,"_221":-5},"resolution","Resolution","0.001 NTU",{"_216":231,"_108":232,"_219":233,"_221":-5},"accuracy","Messgenauigkeit","± 1% oder ± 0,1NTU des Messwertes, je nachdem, was größer ist",{"_216":235,"_108":236,"_219":237,"_221":-5},"repeatability","Wiederholbarkeit","weniger als ± 1%",{"_216":239,"_108":240,"_219":241,"_221":-5},"bubble-compensation","Blasenkompensation","softwarebasierte Blasenkompensation",{"_216":243,"_108":244,"_219":245,"_221":-5},"response-time","Reaktionszeit","T90＜5S",{"_216":247,"_108":248,"_219":249,"_221":-5},"maximum-pressure","Höchstdruck","≤ 30bar; 30bar",{"_216":251,"_108":252,"_219":253,"_221":-5},"calibration","Kalibrierungsmethode","Einzelpunktprobe, Neigungskalibrierung",{"_216":255,"_108":256,"_219":257,"_221":-5},"sensor-material","Sensormaterial","Gehäuse: SUS316L； Fenster: Saphir",{"_216":259,"_108":260,"_219":261,"_221":-5},"self-cleaning","Selbstreinigung","automatische Kratzbürste (optional)",{"_216":263,"_108":264,"_219":265,"_221":-5},"light-attenuation-compensation","Lichtdämpfungskompensation","automatisch",{"_216":267,"_108":268,"_219":269,"_221":-5},"digital-communication","Sensorkommunikation","MODBUS RS-485",{"_216":271,"_108":272,"_219":273,"_221":-5},"storage-temperature","Lagertemperatur","- 10~50℃",{"_216":275,"_108":276,"_219":277,"_221":-5},"operating-temperature","Arbeitstemperatur","0~45 ℃ (nicht frierend)",{"_216":279,"_108":280,"_219":281,"_221":-5},"protection","Schutzniveau","IP68",{"_216":283,"_108":284,"_219":285,"_221":-5},"cable","Kabellänge","Standard 10m, ausziehbar",{"_216":287,"_108":288,"_219":289,"_221":-5},"maximum-flow","Maximale Strömungsgeschwindigkeit","3 Meter pro Sekunde",{"_216":291,"_108":292,"_219":293,"_221":-5},"sensor-size","Sensorgröße","176mm*22mm","sourceReviews",[],"documents",[],"supportDownloads",[]]
