",105279,"sha256","0ef55182d75fdce9b0e8cdaf4c03e078ea6eeb5578a6154000d2e3efca25ae71","width",183,"height",677,"url","createdAt","2026-10-20T17:32:39.916Z","variants",[196],{"_187":188,"_189":190,"_181":197,"_191":198},"image/webp","/igenu-preview/media/565e37464151b9fb7246a52e.webp","detailLayout","STRUCTURED","availableLocales",[11,20,17],"bodyHtml","<span><strong>Produktmerkmale:</strong></span><br />◆ Genaues Signal und Fernübertragung (bis zu 1000 Meter)<br />◆Hohe Präzision, Anti-Interferenz, gute Langzeitstabilität, wartungsfrei<br />◆Der Sender kann Messungen vor Ort anzeigen<br />◆Bereich: -200 ℃ bis 1200 ℃; Konventionelle Genauigkeit: ± 0,25%<br /><span><strong>Technische Parameter:</strong></span><br />Messbereich:- 200-1200℃<br />Temperaturmessbereich des Thermistors:&lt;Pt100&gt;-200~450 ℃&lt; Cu50&gt;-50～150℃<br />Temperaturmessbereich für Thermoelemente：&lt; K&gt; 0℃-1200℃; &lt; E&gt; 0℃-800℃;<br />                                                                           &lt;S&gt; 0℃-1600℃ &lt;B&gt; 0℃-1800℃<br />Messgenauigkeit:&lt;thermischer Widerstand&gt;± 0,25%; ± 0.5%； &lt; Thermoelement&gt;± 0,75%<br />Ausgangssignal:4-20mA<br />Warmer Schwimmer:  ± 0.025%/℃<br />Zeitverschiebung: weniger als ± 0,5% pro Jahr<br />Umgebungstemperatur: -10~85 ℃<br />Spannungsversorgung: 24V DC ± 10%<br />Tragfähigkeit: 0-500 Ω<br />Anzeigebereich:  -1999～1999<br />Schutzniveau:  IP65<br />Explosionsschutzniveau:  dII BT6<br />Material des Schutzrohrs: 1Cr18Ni9Ti oder Keramik- oder Stahljade-Rohr\n    ","gallery",[],"features",[],"specificationGroups",[211],{"_165":212,"_213":214},"Technische Daten","specifications",[215,222,226,230,234,238,242,246,250,254,258,262,266,270],{"_216":217,"_108":218,"_219":220,"_221":-5},"key","measurement-range","Messbereich","value","- 200-1200℃","unit",{"_216":223,"_108":224,"_219":225,"_221":-5},"thermistor-range","Temperaturmessbereich des Thermistors","<Pt100>-200~450 ℃< Cu50>-50～150℃",{"_216":227,"_108":228,"_219":229,"_221":-5