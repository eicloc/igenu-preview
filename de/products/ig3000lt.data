ion",[102,118],{"_103":104,"_105":106},"title","产品","links",[107,112,115],{"_108":109,"_110":111},"label","Wasseranalyse","href","/de/products?category=water",{"_108":113,"_110":114},"Industrielle Messung","/de/products?category=industrial",{"_108":116,"_110":117},"Gasdetektion","/de/products?category=gas",{"_103":119,"_105":120},"了解更多",[121,124,127,130,133],{"_108":122,"_110":123},"关于我们","/de/about",{"_108":125,"_110":126},"客户案例","/de/cases",{"_108":128,"_110":129},"新闻中心","/de/news",{"_108":131,"_110":132},"售后服务","/de/service",{"_108":134,"_110":135},"下载中心","/de/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig3000lt",[],[],"seo",{"_103":146,"_147":148,"_149":150,"_151":152},"IG3000LT Trübungsanalysator für niedrige Messbereiche | IGENU SCIENCE","description","Für die Messung niedriger Trübungen in Trinkwasser und Aufbereitungssystemen kombiniert der Analysator optische Erfassung mit einer Durchflusszelle zur Blasenentfernung. Der modulare Aufbau unterstützt Kalibrierung, Reinigung und Wartung; zusätzlich zur Trübung wird die Temperatur angezeigt.","imageUrl","/igenu-preview/media/32687b0fb7e3209190a365f6.png","index",true,"canonical","https://eicloc.github.io/igenu-preview/de/products/ig3000lt","query",{},"selected",[],"detail",{"_161":162,"_57":141,"_163":164,"_165":166,"_167":148,"_168":169,"_170":171,"_175":176,"_203":204,"_205":206,"_147":-5,"_207":208,"_209":210,"_211":212,"_213":214,"_318":319,"_320":321,"_322":323,"_144":145},"id","4df5cf04-3393-4883-9cb6-f83c88032cc8","model","IG3000LT","name","IG3000LT Trübungsanalysator für niedrige Messbereiche","shortDescription","featured",false,"category",{"_57":172,"_173":-5,"_165":109,"_147":-5,"_144":174},"water","brand",{"_103":109,"_147":-5,"_149":-5,"_151":152},"heroImage",{"_161":177,"_140":178,"_179":180,"_181":182,"_183":184,"_185":186,"_187":188,"_189":190,"_191":150,"_192":193,"_194":195},"257d01fc-7670-46be-af54-0ae68bffbc45","IMAGE","originalName","2025040860761681.jpg","mimeType","image/png","size",133072,"sha256","32687b0fb7e3209190a365f6165fd1befe9616a983cc291c12aca450fcae88b2","width",327,"height",551,"url","createdAt","2026-10-20T17:32:39.781Z","variants",[196,201],{"_187":197,"_189":198,"_181":199,"_191":200},320,539,"image/webp","/igenu-preview/media/f37ebd4fe6509270a9cebcfb.webp",{"_187":188,"_189":190,"_181":199,"_191":202},"/igenu-preview/media/eeb83d74a18b9d4f5cb4ef75.webp","detailLayout","STRUCTURED","availableLocales",[20,11,17],"bodyHtml","<strong><span>Produktmerkmale:</span></strong><br />◆ Erfüllt und übertrifft die Anforderungen der Methode USEPA 180.1<br />◆ Stabiles und effizientes Blasenentfernsystem<br />◆ Kompakte Struktur, kleine Stellfläche<br />◆Geringe Betriebskosten<br />◆135mL Durchflusszelle mit niedriger Hysterese, hohe Empfindlichkeit<br />◆Gleichzeitige Messung und Anzeige der Temperatur<br />◆ Einfache Reinigung und Wartung<br />◆ Output Verriegelungsfunktion, einfach zu warten<br /><span><strong>Anwendungsbereiche:</strong></span><br />Trinkwasseraufbereitungsanlage, Überwachung des Trinkwasserleitungsnetzes, Membranbehandlungsprozess, Lebensmittel- und Pharmatechnik, Überwachung des Konservenwassersystems, Abwasserablauf<br /><strong><span>Technische Parameter:</span></strong><br />Bereich: 0-100NTU<br />Auflösung: 0.0001NTU<br />Genauigkeit: ± 1% des Messwertes oder 0.008 NTU, je nachdem, was größer ist (weniger als 20 NTU);<br />± 2% des Messwertes oder 0,015NTU, je nachdem, was größer ist (größer als 20NTU)<br />Reaktionszeit: 30 Sekunden bis 90%<br />Maßeinheit: NTU<br />Temperatureinheit: ℃<br />Kalibrierung: Nullpunktkalibrierung, 1-Punkt-Standardprobenkalibrierung, Temperaturkalibrierung, Hangkalibrierung<br />Display: Großes LED-Display, 7-Tasten Menü Navigation<br />Signalfilterung: 0-100S<br />Analogausgang: 2-Kanal 4-20mA<br />Digitale Kommunikation: MODBUS/RS485,MODBUS/RS232，Profibus，DeviceNet、CANopen、EthermetIP、ModbusTCP,TCP/IP<br />Relais: 2-Kanal FromC, 5A@250VAC<br />Probendurchfluss: 200-750ml/min<br />Wassertemperatur:- 5~50℃<br />Umgebungstemperatur:- 20~60℃<br />Lichtquelle: Weißes Licht (Wolframlampe)<br />Lichtkammer: eloxiertes Aluminium<br />Zirkulationsbecken: ABS Kunststoff, 135ml<br />Sensormaterial: Quarz, eloxiertes Aluminium<br />Einlassrohrschnittstelle: 1/4<br />Einlassrohrschnittstelle: 3/8<br />Leistungsbedarf: 100-230VAC, 50/60Hz<br />Prüfergröße: 200mm oder 200mm oder 70mm<br />Sensor- und Durchflusszellengröße: 210mm, 140mm, 100mm<br />Energieverbrauch: ≤ 10W\n    ","gallery",[],"features",[],"specificationGroups",[215],{"_165":216,"_217":218},"Technische Daten","specifications",[219,226,230,234,238,242,246,250,254,258,262,266,270,274,278,282,286,290,294,298,302,306,310,314],{"_220":221,"_108":222,"_223":224,"_225":-5},"key","measurement-range","Bereich","value","0-100NTU","unit",{"_220":227,"_108":228,"_223":229,"_225":-5},"resolution","Auflösung","0.0001NTU",{"_220":231,"_108":232,"_223":233,"_225":-5},"accuracy","Genauigkeit","± 1% des Messwertes oder 0.008 NTU, je nachdem, was größer ist (weniger als 20 NTU);",{"_220":235,"_108":236,"_223":237,"_225":-5},"response-time","Reaktionszeit","30 Sekunden bis 90%",{"_220":239,"_108":240,"_223":241,"_225":-5},"units","Maßeinheit","NTU",{"_220":243,"_108":244,"_223":245,"_225":-5},"temperature-unit","Temperatureinheit","℃",{"_220":247,"_108":248,"_223":249,"_225":-5},"calibration","Kalibrierung","Nullpunktkalibrierung, 1-Punkt-Standardprobenkalibrierung, Temperaturkalibrierung, Hangkalibrierung",{"_220":251,"_108":252,"_223":253,"_225":-5},"display","Display","Großes LED-Display, 7-Tasten Menü Navigation",{"_220":255,"_108":256,"_223":257,"_225":-5},"signal-filtering","Signalfilterung","0-100S",{"_220":259,"_108":260,"_223":261,"_225":-5},"analog-output","Analogausgang","2-Kanal 4-20mA",{"_220":263,"_108":264,"_223":265,"_225":-5},"digital-communication","Digitale Kommunikation","MODBUS/RS485,MODBUS/RS232，Profibus，DeviceNet、CANopen、EthermetIP、ModbusTCP,TCP/IP",{"_220":267,"_108":268,"_223":269,"_225":-5},"relay","Relais","2-Kanal FromC, 5A@250VAC",{"_220":271,"_108":272,"_223":273,"_225":-5},"sample-flow","Probendurchfluss","200-750ml/min",{"_220":275,"_108":276,"_223":277,"_225":-5},"water-temperature","Wassertemperatur","- 5~50℃",{"_220":279,"_108":280,"_223":281,"_225":-5},"operating-temperature","Umgebungstemperatur","- 20~60℃",{"_220":283,"_108":284,"_223":285,"_225":-5},"light-source","Lichtquelle","Weißes Licht (Wolframlampe)",{"_220":287,"_108":288,"_223":289,"_225":-5},"light-chamber","Lichtkammer","eloxiertes Aluminium",{"_220":291,"_108":292,"_223":293,"_225":-5},"flow-cell","Zirkulationsbecken","ABS Kunststoff, 135ml",{"_220":295,"_108":296,"_223":297,"_225":-5},"sensor-material","Sensormaterial","Quarz, eloxiertes Aluminium",{"_220":299,"_108":300,"_223":301,"_225":-5},"inlet-connection","Einlassrohrschnittstelle","1/4; 3/8",{"_220":303,"_108":304,"_223":305,"_225":-5},"power-supply","Leistungsbedarf","100-230VAC, 50/60Hz",{"_220":307,"_108":308,"_223":309,"_225":-5},"controller-size","Prüfergröße","200mm oder 200mm oder 70mm",{"_220":311,"_108":312,"_223":313,"_225":-5},"sensor-cell-size","Sensor- und Durchflusszellengröße","210mm, 140mm, 100mm",{"_220":315,"_108":316,"_223":317,"_225":-5},"power-consumption","Energieverbrauch","≤ 10W","sourceReviews",[],"documents",[],"supportDownloads",[]]
