ion",[102,118],{"_103":104,"_105":106},"title","产品","links",[107,112,115],{"_108":109,"_110":111},"label","Wasseranalyse","href","/de/products?category=water",{"_108":113,"_110":114},"Industrielle Messung","/de/products?category=industrial",{"_108":116,"_110":117},"Gasdetektion","/de/products?category=gas",{"_103":119,"_105":120},"了解更多",[121,124,127,130,133],{"_108":122,"_110":123},"关于我们","/de/about",{"_108":125,"_110":126},"客户案例","/de/cases",{"_108":128,"_110":129},"新闻中心","/de/news",{"_108":131,"_110":132},"售后服务","/de/service",{"_108":134,"_110":135},"下载中心","/de/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig3000mp-x",[],[],"seo",{"_103":146,"_147":148,"_149":150,"_151":152},"IG3000MP-X Multiparameter-Wasseranalysator | IGENU SCIENCE","description","Digitale Wechselsonden ermöglichen eine anwendungsbezogene Kombination von pH, gelöstem Sauerstoff, Leitfähigkeit und Trübung. Wasserdichte Anschlüsse und in den Sonden gespeicherte Kalibrierdaten unterstützen den Austausch vor Ort; eine automatische Reinigung hilft, Ablagerungen an den Sensorflächen zu begrenzen.","imageUrl","/igenu-preview/media/9a9243397faa84f675ead5a8.jpg","index",true,"canonical","https://eicloc.github.io/igenu-preview/de/products/ig3000mp-x","query",{},"selected",[],"detail",{"_161":162,"_57":141,"_163":164,"_165":166,"_167":148,"_168":169,"_170":171,"_175":176,"_201":202,"_203":204,"_147":-5,"_205":206,"_207":208,"_209":210,"_211":212,"_250":251,"_252":253,"_254":255,"_144":145},"id","27f7a7c7-2e6f-4394-8a3b-e1d66ae51c83","model","IG3000MP-X","name","IG3000MP-X Multiparameter-Wasseranalysator","shortDescription","featured",false,"category",{"_57":172,"_173":-5,"_165":109,"_147":-5,"_144":174},"water","brand",{"_103":109,"_147":-5,"_149":-5,"_151":152},"heroImage",{"_161":177,"_140":178,"_179":180,"_181":182,"_183":184,"_185":186,"_187":188,"_189":188,"_190":150,"_191":192,"_193":194},"d6d649eb-90c0-469f-9bfb-1c613153f689","IMAGE","originalName","2025040861670749.jpg","mimeType","image/jpeg","size",19258,"sha256","9a9243397faa84f675ead5a8a5216895cf7e15c9b82d390083269947f0d00581","width",540,"height","url","createdAt","2026-10-20T17:32:39.812Z","variants",[195,199],{"_187":196,"_189":196,"_181":197,"_190":198},320,"image/webp","/igenu-preview/media/32f08ba6aa513832d0c6c644.webp",{"_187":188,"_189":188,"_181":197,"_190":200},"/igenu-preview/media/61f38d89920b71a6040fa537.webp","detailLayout","STRUCTURED","availableLocales",[20,11,17],"bodyHtml","<strong><span>Produktmerkmale:</span></strong><br />◆ Digitaler Sensor, RS485 Ausgang, unterstützt MODBUS<br />◆ Alle Kalibrierparameter werden im Sensor gespeichert, und jede Sonde wird mit einem wasserdichten Stecker für einfaches Einsetzen und Austauschen geliefert.<br />◆ Ausgestattet mit einem automatischen Reinigungsgerät kann es Oberflächenflecken von Sensoren effektiv entfernen, mikrobielles Wachstum verhindern und genauere und geringere Wartung bieten<br />◆ Optional gelöster Sauerstoff, Leitfähigkeit, Trübung pH、ORP、 Chlorophyll, Blaualgen, Wasseröl und andere Sensoren, geeignet für langfristige Online-Überwachung<br />◆ Multi in einem strukturellen Entwurf, fähig, gleichzeitig 7-Sonden anzuschließen und 8-Parameter zu messen<br /><strong><span>Anwendungsbereiche:</span></strong><br />Umweltüberwachung, Trink- und Oberflächenwasserüberwachung, Industrieabwasser, Abwasser, häusliches Abwasser, Abwasser, Grundwasser, Seewasser<br /><strong><span>Technische Parameter:</span></strong><p></p><table> <tbody><tr>  <td><p>Messparameter</p></td>  <td><p>PH</p></td>  <td><p>ORP</p></td>  <td><p>Leitfähigkeit</p></td>  <td><p>gelöster Sauerstoff</p></td>  <td><p>Trübung</p></td>  <td><p>Chlorophyll</p></td>  <td><p>Blaualgen</p></td>  <td><p>Temperatur</p></td> </tr> <tr>  <td><p>Bereich</p></td>  <td><p>0-14pH</p></td>  <td><p>±1999mV</p></td>  <td><p>0-20us/cm；  0-200us/cm; 0-2000us/cm; 0-10ms/cm</p>  <p> </p></td>  <td><p>0~20mg/L</p></td>  <td><p>0~1000NTU</p></td>  <td><p>0-1000ppb </p>  <p> </p></td>  <td><p>0~200,000 cells/mL </p>  <p> </p></td>  <td><p>-5-105℃</p></td> </tr> <tr>  <td><p>Genauigkeit</p></td>  <td><p>± 0.01 pH</p></td>  <td><p>±0. 1 mV</p></td>  <td><p>±1%Ablesung</p></td>  <td><p></p>± 0,1 mg/L unter 5 mg/L<br />Wenn es 5 mg/L überschreitet, ist es ± 0,2 mg/L<p></p>  <p> </p></td>  <td><p>± 1% oder ± 0,1NTU des Messwertes, je nachdem, welcher größer ist</p></td>  <td><p>± 3%  des Messwertes oder 0,1ppb</p></td>  <td><p>± 3% des Messwertes</p></td>  <td><p>±0.1℃</p></td> </tr> <tr>  <td><p>Auflösung</p></td>  <td><p>0.01 pH</p></td>  <td><p>0. 1 mV</p></td>  <td><p>±1%Ablesung</p></td>  <td><p>0.01mg/L</p></td>  <td><p>0.001NTU</p></td>  <td><p>0.1ppb</p></td>  <td><p>1 cells/mL</p></td>  <td><p>0.1℃</p></td> </tr> <tr>  <td><p>Wiederholbarkeit</p></td>  <td><p>0.01 pH</p></td>  <td><p>0. 1 mV</p></td>  <td><p>±1%Ablesung</p></td>  <td><p>±0.1mg/L</p></td>  <td><p>±1%</p></td>  <td><p>±3%</p></td>  <td><p>±3%</p></td>  <td><p>0.1℃</p></td> </tr> <tr>  <td><p>Reaktionszeit</p></td>  <td><p>30S,T95</p></td>  <td><p>30S,T95</p></td>  <td><p>30S,T90</p></td>  <td><p>37S,T95</p></td>  <td><p>5S,T90</p></td>  <td><p>30S,T90</p></td>  <td><p>30S,T90</p></td>  <td><p>15S,T90</p></td> </tr> <tr>  <td><p>Schutzart</p></td>  <td><p>IP68</p></td>  <td><p>IP68</p></td>  <td><p>IP68</p></td>  <td><p>IP68</p></td>  <td><p>IP68</p></td>  <td><p>IP68</p></td>  <td><p>IP68</p></td>  <td><p>IP68</p></td> </tr> <tr>  <td><p>Material</p></td>  <td><p>PEEK、Ryton</p></td>  <td><p>PEEK、Ryton</p></td>  <td><p>PEEK、Ryton</p></td>  <td><p>Titanlegierung</p></td>  <td><p>316L</p></td>  <td><p>316L</p></td>  <td><p>316L</p></td>  <td><p>PT1000</p></td> </tr></tbody></table><br />\n    ","gallery",[],"features",[],"specificationGroups",[213],{"_165":214,"_215":216},"Technische Daten","specifications",[217,222,226,230,234,238,242,246],{"_218":64,"_108":66,"_219":220,"_221":-5},"key","value","PH | ORP | Leitfähigkeit | gelöster Sauerstoff | Trübung | Chlorophyll | Blaualgen | Temperatur","unit",{"_218":223,"_108":224,"_219":225,"_221":-5},"measurement-range","Bereich","0-14pH | ±1999mV | 0-20us/cm； 0-200us/cm; 0-2000us/cm; 0-10ms/cm | 0~20mg/L | 0~1000NTU | 0-1000ppb | 0~200,000 cells/mL | -5-105℃",{"_218":227,"_108":228,"_219":229,"_221":-5},"accuracy","Genauigkeit","± 0.01 pH | ±0. 1 mV | ±1%Ablesung | ± 0,1 mg/L unter 5 mg/L\nWenn es 5 mg/L überschreitet, ist es ± 0,2 mg/L | ± 1% oder ± 0,1NTU des Messwertes, je nachdem, welcher größer ist | ± 3%  des Messwertes oder 0,1ppb | ± 3% des Messwertes | ±0.1℃",{"_218":231,"_108":232,"_219":233,"_221":-5},"resolution","Auflösung","0.01 pH | 0. 1 mV | ±1%Ablesung | 0.01mg/L | 0.001NTU | 0.1ppb | 1 cells/mL | 0.1℃",{"_218":235,"_108":236,"_219":237,"_221":-5},"repeatability","Wiederholbarkeit","0.01 pH | 0. 1 mV | ±1%Ablesung | ±0.1mg/L | ±1% | ±3% | ±3% | 0.1℃",{"_218":239,"_108":240,"_219":241,"_221":-5},"response-time","Reaktionszeit","30S,T95 | 30S,T95 | 30S,T90 | 37S,T95 | 5S,T90 | 30S,T90 | 30S,T90 | 15S,T90",{"_218":243,"_108":244,"_219":245,"_221":-5},"protection","Schutzart","IP68 | IP68 | IP68 | IP68 | IP68 | IP68 | IP68 | IP68",{"_218":247,"_108":248,"_219":249,"_221":-5},"material","Material","PEEK、Ryton | PEEK、Ryton | PEEK、Ryton | Titanlegierung | 316L | 316L | 316L | PT1000","sourceReviews",[],"documents",[],"supportDownloads",[]]
