ion",[102,118],{"_103":104,"_105":106},"title","产品","links",[107,112,115],{"_108":109,"_110":111},"label","Wasseranalyse","href","/de/products?category=water",{"_108":113,"_110":114},"Industrielle Messung","/de/products?category=industrial",{"_108":116,"_110":117},"Gasdetektion","/de/products?category=gas",{"_103":119,"_105":120},"了解更多",[121,124,127,130,133],{"_108":122,"_110":123},"关于我们","/de/about",{"_108":125,"_110":126},"客户案例","/de/cases",{"_108":128,"_110":129},"新闻中心","/de/news",{"_108":131,"_110":132},"售后服务","/de/service",{"_108":134,"_110":135},"下载中心","/de/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig9000",[],[],"seo",{"_103":146,"_147":148,"_149":150,"_151":152},"IG9000 Ultraschall-Füllstandsmessgerät | IGENU SCIENCE","description","Die Ultraschall-Laufzeitmessung überwacht Füllstände von Flüssigkeiten und Schüttgütern ohne direkten Medienkontakt. Kompakt- und Getrenntausführungen, Signalanalyse und Temperaturkompensation unterstützen den Einbau in Wasseraufbereitung, Lagertanks und weiteren Füllstandsanwendungen sowie die Anpassung an die jeweilige Messstelle.","imageUrl","/igenu-preview/media/8ef050d2f42f424a5466c7f7.png","index",true,"canonical","https://eicloc.github.io/igenu-preview/de/products/ig9000","query",{},"selected",[],"detail",{"_161":162,"_57":141,"_163":164,"_165":166,"_167":148,"_168":169,"_170":171,"_175":176,"_217":218,"_219":220,"_147":-5,"_221":222,"_223":224,"_225":226,"_227":228,"_329":330,"_360":361,"_362":363,"_144":145},"id","43425fa1-18a8-4ebe-995e-466a914f67da","model","IG9000","name","IG9000 Ultraschall-Füllstandsmessgerät","shortDescription","featured",false,"category",{"_57":172,"_173":-5,"_165":113,"_147":-5,"_144":174},"industrial","brand",{"_103":113,"_147":-5,"_149":-5,"_151":152},"heroImage",{"_161":177,"_140":178,"_179":180,"_181":182,"_183":184,"_185":186,"_187":188,"_189":190,"_191":150,"_192":193,"_194":195},"485bff13-2df9-448f-a8bc-6b60b3e5ad76","IMAGE","originalName","2025040851503805.png","mimeType","image/png","size",698863,"sha256","8ef050d2f42f424a5466c7f703dc0ddcbb2915dc23bdee338481847f3cefa2dd","width",2604,"height",1704,"url","createdAt","2026-10-20T17:32:39.690Z","variants",[196,201,205,209,213],{"_187":197,"_189":198,"_181":199,"_191":200},320,209,"image/webp","/igenu-preview/media/63971d02adf57bfde6335036.webp",{"_187":202,"_189":203,"_181":199,"_191":204},640,419,"/igenu-preview/media/94e5c9a427aaff2e7fe15add.webp",{"_187":206,"_189":207,"_181":199,"_191":208},960,628,"/igenu-preview/media/6403302113043098a393f716.webp",{"_187":210,"_189":211,"_181":199,"_191":212},1280,838,"/igenu-preview/media/bd1f66f7ac71cc90284d1d8d.webp",{"_187":214,"_189":215,"_181":199,"_191":216},1600,1047,"/igenu-preview/media/0f4d290e7e86d3dd29596237.webp","detailLayout","STRUCTURED","availableLocales",[20,11,17],"bodyHtml","<p><span><strong>Produktmerkmale:</strong></span><br />◆ Integrierte oder geteilte Typoptionen, passend für verschiedene Installationsanforderungen vor Ort<br />◆Der Host kann als Einkanal oder Zweikanal ausgewählt werden und kann Funktionen wie Mehrpunktmessung und Alarm erreichen<br />◆ Einfach zu bedienen, zuverlässige Ergebnisse, Schnittstellenbetriebsanweisungen können Betriebsfehler reduzieren<br />◆Das Sondenmaterial ist in POM-, PVDF-, PTFE-Optionen erhältlich, geeignet für verschiedene Arbeitsbedingungen<br />◆ Intern integrierter Temperatursensor, fähig zur Echtzeit-Temperaturkompensation für Schallgeschwindigkeit<br /><strong><span>Anwendungsbereiche:</span></strong><br />Öffentliches Abwasser, Industrieabwasser, Umweltüberwachung, Trink- und Oberflächenwasserüberwachung, industrielle Prozesse<br /><strong><span>Technische Parameter:</span><br />Integriert</strong><br />Stromversorgung: DC18-36V； AC90-260V <br />Leistung: 0/4-20mA; RS485 (optional)<br />Bereich: 0~5/10/15/20m<br />Genauigkeit: 0,25% (Bereich)<br />Auflösung: 1mm<br />Blinde Zone: 0.3~0.6 (Sichtbereich)<br />Anzeigetyp: 128.64LCD (auf Chinesisch und Englisch, Echosignal)<br />Anzeigemodus: Flüssigkeitsstand, Luftabstand<br />Prozesstemperatur:- 30℃~80℃ <br />Schutzart: IP68 (Drahtdurchmesser 7-12mm)<br />Elektrische Schnittstelle: M20*1.5 <br />Steuerung: 2-Kanal programmierbares Relais<br />Fehleralarm: Ja<br />Signalsuche: Diese Funktion kann effektiv mit Situationen mit schlechter Signalreflexion wie Schaum und Müllschwimmer umgehen<br /><strong>Split-Typ:</strong><br />Stromversorgung: DC18-36V； AC90-260V <br />Ausgang: 2-Kanal 0/4-20mA; RS485 (optional)<br />Bereich: 0~5/10/15/20m<br />Genauigkeit: 0,25% (Bereich)<br />Auflösung: 1mm Blind Zone: 0.3~0.6 (visueller Bereich)<br />Anzeigetyp: 192.64LCD (auf Chinesisch und Englisch, Echosignal)<br />Anzeigemodus: Flüssigkeitsstand, Luftabstand<br />Prozesstemperatur: Sender: -30 ℃~80 ℃; Sensor:- 40℃~80℃ <br />Schutzstufe: Sender: IP65； Sensor: IP68 (Drahtdurchmesser 7-12mm)<br />Elektrische Schnittstelle: M20*1.5 <br />Steuerung: 4-Kanal programmierbares Relais<br />Fehleralarm: Ja<br />Signalsuche: Diese Funktion kann effektiv mit Situationen mit schlechter Signalreflexion wie Schaum und Müllschwimmer umgehen<br /></p>\n    ","gallery",[],"features",[],"specificationGroups",[229,292],{"_165":230,"_231":232},"Integriert","specifications",[233,240,244,248,252,256,260,264,268,272,276,280,284,288],{"_234":235,"_108":236,"_237":238,"_239":-5},"key","integrated.power-supply","Stromversorgung","value","DC18-36V； AC90-260V","unit",{"_234":241,"_108":242,"_237":243,"_239":-5},"integrated.output","Leistung","0/4-20mA; RS485 (optional)",{"_234":245,"_108":246,"_237":247,"_239":-5},"integrated.measurement-range","Bereich","0~5/10/15/20m",{"_234":249,"_108":250,"_237":251,"_239":-5},"integrated.accuracy","Genauigkeit","0,25% (Bereich)",{"_234":253,"_108":254,"_237":255,"_239":-5},"integrated.resolution","Auflösung","1mm",{"_234":257,"_108":258,"_237":259,"_239":-5},"integrated.blind-zone","Blinde Zone","0.3~0.6 (Sichtbereich)",{"_234":261,"_108":262,"_237":263,"_239":-5},"integrated.