ion",[102,118],{"_103":104,"_105":106},"title","产品","links",[107,112,115],{"_108":109,"_110":111},"label","Wasseranalyse","href","/de/products?category=water",{"_108":113,"_110":114},"Industrielle Messung","/de/products?category=industrial",{"_108":116,"_110":117},"Gasdetektion","/de/products?category=gas",{"_103":119,"_105":120},"了解更多",[121,124,127,130,133],{"_108":122,"_110":123},"关于我们","/de/about",{"_108":125,"_110":126},"客户案例","/de/cases",{"_108":128,"_110":129},"新闻中心","/de/news",{"_108":131,"_110":132},"售后服务","/de/service",{"_108":134,"_110":135},"下载中心","/de/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig30cds",[],[],"seo",{"_103":146,"_147":148,"_149":150,"_151":152},"IG30CDS Leitfähigkeitssensor | IGENU SCIENCE","description","Verschiedene Zellkonstanten ermöglichen die Leitfähigkeitsmessung in der Wasseraufbereitung und in industriellem Prozesswasser. Digitale Kommunikation und gespeicherte Kalibrierwerte unterstützen die Systemintegration; die mitgelieferte Halterung und Durchflusszelle erleichtern den Einbau und die Einrichtung am vorgesehenen Messpunkt.","imageUrl","/igenu-preview/media/08cc865f38c95a6b72364eaf.jpg","index",true,"canonical","https://eicloc.github.io/igenu-preview/de/products/ig30cds","query",{},"selected",[],"detail",{"_161":162,"_57":141,"_163":164,"_165":166,"_167":148,"_168":169,"_170":171,"_175":176,"_201":202,"_203":204,"_147":-5,"_205":206,"_207":208,"_209":210,"_211":212,"_296":297,"_298":299,"_300":301,"_144":145},"id","f33fa081-7e09-4283-a1f0-899eb8c5a37c","model","IG30CDS","name","IG30CDS Leitfähigkeitssensor","shortDescription","featured",false,"category",{"_57":172,"_173":-5,"_165":109,"_147":-5,"_144":174},"water","brand",{"_103":109,"_147":-5,"_149":-5,"_151":152},"heroImage",{"_161":177,"_140":178,"_179":180,"_181":182,"_183":184,"_185":186,"_187":188,"_189":188,"_190":150,"_191":192,"_193":194},"97568f30-f32e-4d9a-85ac-2b57a8967181","IMAGE","originalName","2025040860050401.jpg","mimeType","image/jpeg","size",57217,"sha256","08cc865f38c95a6b72364eaf3f6b94912df92297b7cb4dbcdb9d9d327b79dd1c","width",500,"height","url","createdAt","2026-10-20T17:32:39.763Z","variants",[195,199],{"_187":196,"_189":196,"_181":197,"_190":198},320,"image/webp","/igenu-preview/media/6f7c525ac57d10f270f2e15f.webp",{"_187":188,"_189":188,"_181":197,"_190":200},"/igenu-preview/media/d8eaca92b7d0ec37a6ee861d.webp","detailLayout","STRUCTURED","availableLocales",[20,11,17],"bodyHtml","<strong><span>Produktmerkmale:</span></strong><br />◆Schnelle Reaktionszeit, erreicht 95% in 15 Sekunden<br />◆ Digitalsensor, RS-485 Ausgang, Standard Modbus RTU Protokoll, nicht beeinflusst durch Übertragungsabstand, bessere Stabilität<br />◆Der Sensor besteht aus Ryton Material, das eine längere Lebensdauer hat und Wartung und Ausfallzeiten reduziert<br />◆Schnelle Reaktion, genaue Messung, zuverlässige Daten und bequeme Bedienung<br />◆Interne Elektroden können extrem schwache Signale ohne Polarisationseffekte messen<br />◆Interner integrierter Speicher, kann sich die Kalibrier- und Einstellungsinformationen auch nach Stromausfall noch merken<br /><span><strong>Anwendungsbereiche:</strong></span><br />Oberflächenwasser, kommunales Abwasser, Umweltüberwachung, industrielle Prozesskontrolle, Verschmutzungsquellen, industrielles Abwasser, Leitungswasser, Biopharmazeutika, Bier und Getränke, Erdöl und Petrochemie, Metallurgie<br /><span><strong>Technische Parameter:</strong></span><br />Messbereich: K=0.01，0-20us/cm； K=0. 1，0-200us/cm;  K=1，0-2000us/cm;  K=10，0-20000us/cm<br />Temperatur: 0-125 ℃<br />Auflösung: 0.01 us/cm; 0,1us/cm; 1us/cm,0.1℃<br />Genauigkeit: ± 1% Ablesung<br />Wiederholbarkeit: ± 1% Ablesbarkeit<br />Temperaturausgleich: automatisch<br />Arbeitsumgebung: 0-95 ℃<br />Höchstdruck: 6,0bar<br />Maximale Strömungsgeschwindigkeit: 3 Meter pro Sekunde<br />Kalibrierungsmethode: Kalibrierung der Standardlösung<br />Temperaturausgleich: automatisch<br />Temperaturelektrode: PT1000<br />Elektrodenform: digitale Elektrode<br />Reaktionszeit: 15 Sekunden bis 95%<br />Kommunikationsschnittstelle: ModbusRS485<br />Elektrodenmaterial: PEEK、Ryton<br />Gewindeschnittstelle: Front und Heck Standard 3/4NPT<br />Schutzniveau: IP68<br />Kabellänge: Standard 10m, ausziehbar<br />Elektrodengröße: 165mm bis 25mm\n    ","gallery",[],"features",[],"specificationGroups",[213],{"_165":214,"_215":216},"Technische Daten","specifications",[217,224,228,232,236,240,244,248,252,256,260,264,268,272,276,280,284,288,292],{"_218":219,"_108":220,"_221":222,"_223":-5},"key","measurement-range","Messbereich","value","K=0.01，0-20us/cm； K=0. 1，0-200us/cm;  K=1，0-2000us/cm;  K=10，0-20000us/cm","unit",{"_218":225,"_108":226,"_221":227,"_223":-5},"temperature","Temperatur","0-125 ℃",{"_218":229,"_108":230,"_221":231,"_223":-5},"resolution","Auflösung","0.01 us/cm; 0,1us/cm; 1us/cm,0.1℃",{"_218":233,"_108":234,"_221":235,"_223":-5},"accuracy","Genauigkeit","± 1% Ablesung",{"_218":237,"_108":238,"_221":239,"_223":-5},"repeatability","Wiederholbarkeit","± 1% Ablesbarkeit",{"_218":241,"_108":242,"_221":243,"_223":-5},"temperature-compensation","Temperaturausgleich","automatisch",{"_218":245,"_108":246,"_221":247,"_223":-5},"operating-temperature","Arbeitsumgebung","0-95 ℃",{"_218":249,"_108":250,"_221":251,"_223":-5},"maximum-pressure","Höchstdruck","6,0bar",{"_218":253,"_108":254,"_221":255,"_223":-5},"maximum-flow","Maximale Strömungsgeschwindigkeit","3 Meter pro Sekunde",{"_218":257,"_108":258,"_221":259,"_223":-5},"calibration","Kalibrierungsmethode","Kalibrierung der Standardlösung",{"_218":261,"_108":262,"_221":263,"_223":-5},"temperature-electrode","Temperaturelektrode","PT1000",{"_218":265,"_108":266,"_221":267,"_223":-5},"electrode-form","Elektrodenform","digitale Elektrode",{"_218":269,"_108":270,"_221":271,"_223":-5},"response-time","Reaktionszeit","15 Sekunden bis 95%",{"_218":273,"_108":274,"_221":275,"_223":-5},"digital-communication","Kommunikationsschnittstelle","ModbusRS485",{"_218":277,"_108":278,"_221":279,"_223":-5},"electrode-material","Elektrodenmaterial","PEEK、Ryton",{"_218":281,"_108":282,"_221":283,"_223":-5},"thread","Gewindeschnittstelle","Front und Heck Standard 3/4NPT",{"_218":285,"_108":286,"_221":287,"_223":-5},"protection","Schutzniveau","IP68",{"_218":289,"_108":290,"_221":291,"_223":-5},"cable","Kabellänge","Standard 10m, ausziehbar",{"_218":293,"_108":294,"_221":295,"_223":-5},"electrode-size","Elektrodengröße","165mm bis 25mm","sourceReviews",[],"documents",[],"supportDownloads",[]]
