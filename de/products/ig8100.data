ion",[102,118],{"_103":104,"_105":106},"title","产品","links",[107,112,115],{"_108":109,"_110":111},"label","Wasseranalyse","href","/de/products?category=water",{"_108":113,"_110":114},"Industrielle Messung","/de/products?category=industrial",{"_108":116,"_110":117},"Gasdetektion","/de/products?category=gas",{"_103":119,"_105":120},"了解更多",[121,124,127,130,133],{"_108":122,"_110":123},"关于我们","/de/about",{"_108":125,"_110":126},"客户案例","/de/cases",{"_108":128,"_110":129},"新闻中心","/de/news",{"_108":131,"_110":132},"售后服务","/de/service",{"_108":134,"_110":135},"下载中心","/de/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig8100",[],[],"seo",{"_103":146,"_147":148,"_149":150,"_151":152},"IG8100 Stationärer Gasdetektor mit Alarm | IGENU SCIENCE","description","Der stationäre Gasdetektor wird für das benötigte Zielgas konfiguriert und überwacht dessen Konzentration kontinuierlich. Akustische und optische Alarme sowie analoge und digitale Ausgänge ermöglichen die Anbindung an geeignete Steuerungs- und Überwachungssysteme am installierten Messpunkt.","imageUrl","/igenu-preview/media/839a34011d33d0b03a4d6173.jpg","index",true,"canonical","https://eicloc.github.io/igenu-preview/de/products/ig8100","query",{},"selected",[],"detail",{"_161":162,"_57":141,"_163":164,"_165":166,"_167":148,"_168":152,"_169":170,"_174":175,"_202":203,"_204":205,"_147":-5,"_206":207,"_208":209,"_225":226,"_227":228,"_312":313,"_314":315,"_316":317,"_144":145},"id","f3e2a88e-adb6-4f1f-8997-8600b01faa5a","model","IG8100","name","IG8100 Stationärer Gasdetektor mit Alarm","shortDescription","featured","category",{"_57":171,"_172":-5,"_165":116,"_147":-5,"_144":173},"gas","brand",{"_103":116,"_147":-5,"_149":-5,"_151":152},"heroImage",{"_161":176,"_140":177,"_178":179,"_180":181,"_182":183,"_184":185,"_186":187,"_188":189,"_190":150,"_191":192,"_193":194},"a55ad70e-9d54-462e-a2ea-a827378021aa","IMAGE","originalName","2018040281324785.jpg","mimeType","image/jpeg","size",50456,"sha256","839a34011d33d0b03a4d61735b7686e5645b3091e52bd34545f51bda446373d6","width",339,"height",243,"url","createdAt","2026-10-20T17:32:39.606Z","variants",[195,200],{"_186":196,"_188":197,"_180":198,"_190":199},320,229,"image/webp","/igenu-preview/media/6d839fb13c7f64d9a04f573f.webp",{"_186":187,"_188":189,"_180":198,"_190":201},"/igenu-preview/media/023755c71cd1c8e5ab08db45.webp","detailLayout","STRUCTURED","availableLocales",[20,11,17],"bodyHtml","<p><strong><span>Produktmerkmale:</span></strong><br />◆ Drei Draht 4-20mA, RS485 (Modbus RTU) dualer Signalausgang, perfekt kompatibel mit verschiedenen PLC/DCS Steuersystemen<br />◆ Vor-Ort-Ton- und Lichtalarmfunktion, Großbildschirm Multi-Parameter-LCD-Anzeige<br />◆ Optionale Infrarotfernbedienung, kann ohne Öffnen der Abdeckung debugged werden<br />◆ Wissenschaftlicher und angemessener Kammerstrukturentwurf, Verwendung von ultrahochfestem Aluminium der Luftfahrtqualität, ausgezeichnete Oberflächenbehandlungstechnologie, längere Lebensdauer<br /><strong><span>Anwendungsbereiche:</span></strong><br />Erdöl/chemische Industrie, industrielle Fertigung, Abwasserbehandlung, Energie- und Elektrotechnik, Metallschmelzen<br /><span><strong>Technische Parameter:</strong></span><br /><strong>Gasdetektion:</strong><br />Sauerstoff, Schwefel und Oxide<br />Sauerstoff O2, Ozon O3, Kohlenmonoxid CO, Kohlendioxid CO2, Stickstoffoxid NO, Stickstoffdioxid NO2, Stickstoffoxide NOx, Schwefeldioxid SO2, Chlordioxid CLO2<br />Stickstoff, Wasserstoff und Cyanid<br />Wasserstoff H2, Ammoniak NH3, Schwefelwasserstoff H2S, Stickstoff N2, Chlorwasserstoff HCL, Phosphin PH3, Cyanid HCN, Arsin AsH3, Fluorwasserstoff HF<br />Alkane und brennbare Gase<br />Brenngase EX, Methan CH4, Ethan C2H6, Propan C3H8, Epoxyethan C2H4O<br />Organische flüchtige Gase<br />Geruch ODOR, Benzol C6H6, Toluol C7H8, Xylol C8H10 VOCs 、 Formaldehyd CH2O, Ethylen C2H4, Ethanol C2H6O, Gesamtkohlenwasserstoffe ohne Methan<br />Halogen, halogenierte Kohlenwasserstoffe<br />Schwefelhexafluorid SF6, Chlorgas CL2, Flurgas F2, Bromgas Br2<br />Detektionsprinzip: elektrochemische Methode/Infrarot-Methode/katalytische Verbrennung/PID<br />Messbereich: 0~50/100ppm, 0~50/100%Vol<br />Auflösungsleistung: 0,01ppm,0,01%VOL<br />Nachweisgrenze: 0,05ppm, 0,05% VOL<br />Genauigkeit: ≤ ±1%F.S<br />Nulldrift: ≤ ± 1% F.S/Jahr<br />Ansprechzeit: ≤ 20 Sekunden (T90)<br />Erholungszeit: ≤ 20 Sekunden<br />Anzeigemodus: LCD Hintergrundbeleuchtung<br />Detektionsmethode: Diffusionsmessung, Dauerbetrieb<br />Arbeitstemperatur:- 30℃~ ＋60℃ <br />Arbeitsfeuchte: 5%~95% RH ohne Kondensation<br />Installationsmethoden: an der Wand montiert, an der Rohrleitung montiert<br />Shell-Material: Alle Aluminiumschale, Fluorcarbon-Farbe korrosionsbeständig, robust und langlebig<br />Schutzniveau: IP66 <br />Alarmmodus: hoher und niedriger Alarm/Intervallalarm/gewichteter Durchschnittsalarm<br />Signalausgang: Drei Draht System 4-20mA RS485(ModbusRTU) <br />Digitales Signal: RS-485 Ausgang, ModBus RTU Kommunikationsprotokoll (optional)<br />Größe: 180mm, 140mm, 92mm (Höhe der Breite und Dicke)<br /></p>\n    ","gallery",[210],{"_161":211,"_140":177,"_178":212,"_180":181,"_182":213,"_184":214,"_186":215,"_188":216,"_190":217,"_191":218,"_193":219},"b85fe479-8089-4ee5-aa2a-db75eb8b0b74","2025040939442237.png",52081,"0c749136b26fb747638a2559e5b6057a6373b64df0d34ac5108e01e84a3722c1",478,261,"/igenu-preview/media/0c749136b26fb747638a2559.jpg","2026-10-20T17:32:39.834Z",[220,223],{"_186":196,"_188":221,"_180":198,"_190":222},175,"/igenu-preview/media/6fec0333eb8c94d8cec4a3a6.webp",{"_186":215,"_188":216,"_180":198,"_190":224},"/igenu-preview/media/a19d8e5c0a5cd6234f0fd3a6.webp","features",[],"specificationGroups",[229],{"_165":230,"_231":232},"Technische Daten","specifications",[233,240,244,248,252,256,260,264,268,272,276,280,284,288,292,296,300,304,308],{"_234":235,"_108":236,"_237":238,"_239":-5},"key","measurement-principle","Detektionsprinzip","value","elektrochemische Methode/Infrarot-Methode/katalytische Verbrennung/PID","unit",{"_234":241,"_108":242,"_237":243,"_239":-5},"measurement-range","Messbereich","0~50/100ppm, 0~50/100%Vol",{"_234":245,"_108":246,"_237":247,"_239":-5},"resolution","Auflösungsleistung","0,01ppm,0,01%VOL",{"_234":249,"_108":250,"_237":251,"_239":-5},"detection-limit","Nachweisgrenze","0,05ppm, 0,05% VOL",{"_234":253,"_108":254,"_237":255,"_239":-5},"accuracy","Genauigkeit","≤ ±1%F.S",{"_234":257,"_108":258,"_237":259,"_239":-5},"zero-drift","Nulldrift","≤ ± 1% F.S/Jahr",{"_234":261,"_108":262,"_237":263,"_239":-5},"response-time","Ansprechzeit","≤ 20 Sekunden (T90)",{"_234":265,"_108":266,"_237":267,"_239":-5},"recovery-time","Erholungszeit","≤ 20 Sekunden",{"_234":269,"_108":270,"_237":271,"_239":-5},"display","Anzeigemodus","LCD Hintergrundbeleuchtung",{"_234":273,"_108":274,"_237":275,"_239":-5},"detection-method","Detektionsmethode","Diffusionsmessung, Dauerbetrieb",{"_234":277,"_108":278,"_237":279,"_239":-5},"operating-temperature","Arbeitstemperatur","- 30℃~ ＋60℃",{"_234":281,"_108":282,"_237":283,"_239":-5},"operating-humidity","Arbeitsfeuchte","5%~95% RH ohne Kondensation",{"_234":285,"_108":286,"_237":287,"_239":-5},"installation","Installationsmethoden","an der Wand montiert, an der Rohrleitung montiert",{"_234":289,"_108":290,"_237":291,"_239":-5},"material","Shell-Material","Alle Aluminiumschale, Fluorcarbon-Farbe korrosionsbeständig, robust und langlebig",{"_234":293,"_108":294,"_237":295,"_239":-5},"protection","Schutzniveau","IP66",{"_234":297,"_108":298,"_237":299,"_239":-5},"alarm-mode","Alarmmodus","hoher und niedriger Alarm/Intervallalarm/gewichteter Durchschnittsalarm",{"_234":301,"_108":302,"_237":303,"_239":-5},"output","Signalausgang","Drei Draht System 4-20mA RS485(ModbusRTU)",{"_234":305,"_108":306,"_237":307,"_239":-5},"digital-signal","Digitales Signal","RS-485 Ausgang, ModBus RTU Kommunikationsprotokoll (optional)",{"_234":309,"_108":310,"_237":311,"_239":-5},"dimensions","Größe","180mm