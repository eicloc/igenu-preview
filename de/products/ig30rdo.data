ion",[102,118],{"_103":104,"_105":106},"title","产品","links",[107,112,115],{"_108":109,"_110":111},"label","Wasseranalyse","href","/de/products?category=water",{"_108":113,"_110":114},"Industrielle Messung","/de/products?category=industrial",{"_108":116,"_110":117},"Gasdetektion","/de/products?category=gas",{"_103":119,"_105":120},"了解更多",[121,124,127,130,133],{"_108":122,"_110":123},"关于我们","/de/about",{"_108":125,"_110":126},"客户案例","/de/cases",{"_108":128,"_110":129},"新闻中心","/de/news",{"_108":131,"_110":132},"售后服务","/de/service",{"_108":134,"_110":135},"下载中心","/de/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig30rdo",[],[],"seo",{"_103":146,"_147":148,"_149":150,"_151":152},"IG30RDO Optischer Sensor für gelösten Sauerstoff | IGENU SCIENCE","description","Die fluoreszenzbasierte Messung erfasst gelösten Sauerstoff ohne Elektrolytwechsel oder Polarisation des Sensors. Integrierte Temperaturkompensation und digitale Kommunikation unterstützen die kontinuierliche Wasserüberwachung; Luft- und Probenkalibrierung ermöglichen die Einrichtung für Anwendungen in Aufbereitung, Umweltüberwachung und Aquakultur.","imageUrl","/igenu-preview/media/1513162129cbcc0b7fb98e96.jpg","index",true,"canonical","https://eicloc.github.io/igenu-preview/de/products/ig30rdo","query",{},"selected",[],"detail",{"_161":162,"_57":141,"_163":164,"_165":166,"_167":148,"_168":152,"_169":170,"_174":175,"_202":203,"_204":205,"_147":-5,"_206":207,"_208":209,"_210":211,"_212":213,"_301":302,"_303":304,"_305":306,"_144":145},"id","f607cd0f-5835-4426-b788-827be959a3fc","model","IG30RDO","name","IG30RDO Optischer Sensor für gelösten Sauerstoff","shortDescription","featured","category",{"_57":171,"_172":-5,"_165":109,"_147":-5,"_144":173},"water","brand",{"_103":109,"_147":-5,"_149":-5,"_151":152},"heroImage",{"_161":176,"_140":177,"_178":179,"_180":181,"_182":183,"_184":185,"_186":187,"_188":189,"_190":150,"_191":192,"_193":194},"0ddcf618-0714-49aa-9919-74ce97332e9e","IMAGE","originalName","2025040860317013.png","mimeType","image/jpeg","size",19493,"sha256","1513162129cbcc0b7fb98e96f5e5a24329832e50befa0944e7b17725123db89a","width",458,"height",293,"url","createdAt","2026-10-20T17:32:39.769Z","variants",[195,200],{"_186":196,"_188":197,"_180":198,"_190":199},320,205,"image/webp","/igenu-preview/media/875a6bfa76d0d60b22d59c3d.webp",{"_186":187,"_188":189,"_180":198,"_190":201},"/igenu-preview/media/676768d13901a89005e95e68.webp","detailLayout","STRUCTURED","availableLocales",[20,11,17],"bodyHtml","<strong><span>Produktmerkmale:</span></strong><br />◆ Eingebauter Temperatursensor, automatische Temperaturkompensation<br />◆Fluoreszenzmethode, kein Bedarf, Membran und Elektrolyt zu ersetzen, Luftkalibrierung, einfach und schnell<br />◆ Digitalsensor, RS-485 Ausgang, Standard Modbus RTU Protokoll, nicht beeinflusst durch Übertragungsabstand, bessere Stabilität<br />◆Der Sensor besteht aus Titanlegierungsmaterial, das eine längere Lebensdauer hat und Wartung und Ausfallzeiten reduziert<br />◆ Keine Polarisation erforderlich, schnelle Reaktionszeit<br />◆ Nicht beeinflusst durch pH-Schwankungen CO2、 Störung durch Sulfide, Schwefelwasserstoff, Sulfate, Chloride, Ammoniakstickstoff und Schwermetalle<br />◆ Nicht beeinträchtigt durch Strömungsgeschwindigkeitsinterferenzen und in der Lage, schweren Stößen standzuhalten<br /><span><strong>Anwendungsbereiche:</strong></span><br />Kommunale Abwässer, Industrieabwässer, Umweltüberwachung, Trink- und Oberflächenwasserüberwachung, industrielle Prozesse, Aquakultur, biologische Prozesse<br /><span><strong>Technische Parameter:</strong></span><br />Bereich: 0~20mg/L oder 0~200% Sättigung, 0~65 ℃<br />Messprinzip: Fluoreszenzmethode<br />Messgenauigkeit: ± 0,1 mg/L, wenn unter 5 mg/L<br />Wenn es 5 mg/L überschreitet, ist es ± 0,2 mg/L<br />Temperatur: ±0,1°C<br />Reaktionszeit: 95% erreicht in 37 Sekunden bei 20 ℃<br />Wiederholbarkeit: ± 0,1mg/L<br />Auflösung: 0,01mg/L<br />Maximaler Druck: 23bar.50 ℃<br />Maximaler Durchfluss: Keine Durchflussmenge erforderlich<br />Kalibrierungsmethoden: Sättigungsluftkalibrierung, 1-Punkt-Probenkalibrierung, Nullpunkt-Kalibrierung, 1-Punkt-Temperaturkalibrierung<br />Material des Elektrodenkörpers: Titanlegierung<br />Gewindeschnittstelle: Standard 3/4NPT<br />Sensorkommunikation: MODBUS RS-485 <br />Temperaturelektrode: PT1000<br />Elektrodenform: digitale Elektrode<br />Kommunikationsschnittstelle: ModbusRS485<br />Lagertemperatur:- 15~60℃ <br />Arbeitstemperatur: 0~65 ℃ (nicht frierend)<br />Schutzniveau: IP68<br />Kabellänge: Standard 10m, ausziehbar<br />Sensorgröße: 151mm bis 26mm\n    ","gallery",[],"features",[],"specificationGroups",[214],{"_165":215,"_216":217},"Technische Daten","specifications",[218,225,229,233,237,241,245,249,253,257,261,265,269,273,277,281,285,289,293,297],{"_219":220,"_108":221,"_222":223,"_224":-5},"key","measurement-range","Bereich","value","0~20mg/L oder 0~200% Sättigung, 0~65 ℃","unit",{"_219":226,"_108":227,"_222":228,"_224":-5},"measurement-principle","Messprinzip","Fluoreszenzmethode",{"_219":230,"_108":231,"_222":232,"_224":-5},"accuracy","Messgenauigkeit","± 0,1 mg/L, wenn unter 5 mg/L",{"_219":234,"_108":235,"_222":236,"_224":-5},"temperature","Temperatur","±0,1°C",{"_219":238,"_108":239,"_222":240,"_224":-5},"response-time","Reaktionszeit","95% erreicht in 37 Sekunden bei 20 ℃",{"_219":242,"_108":243,"_222":244,"_224":-5},"repeatability","Wiederholbarkeit","± 0,1mg/L",{"_219":246,"_108":247,"_222":248,"_224":-5},"resolution","Auflösung","0,01mg/L",{"_219":250,"_108":251,"_222":252,"_224":-5},"maximum-pressure","Maximaler Druck","23bar.50 ℃",{"_219":254,"_108":255,"_222":256,"_224":-5},"maximum-flow","Maximaler Durchfluss","Keine Durchflussmenge erforderlich",{"_219":258,"_108":259,"_222":260,"_224":-5},"calibration","Kalibrierungsmethoden","Sättigungsluftkalibrierung, 1-Punkt-Probenkalibrierung, Nullpunkt-Kalibrierung, 1-Punkt-Temperaturkalibrierung",{"_219":262,"_108":263,"_222":264,"_224":-5},"electrode-body-material","Material des Elektrodenkörpers","Titanlegierung",{"_219":266,"_108":267,"_222":268,"_224":-5},"thread","Gewindeschnittstelle","Standard 3/4NPT",{"_219":270,"_108":271,"_222":272,"_224":-5},"digital-communication","Sensorkommunikation","MODBUS RS-485; ModbusRS485",{"_219":274,"_108":275,"_222":276,"_224":-5},"temperature-electrode","Temperaturelektrode","PT1000",{"_219":278,"_108":279,"_222":280,"_224":-5},"electrode-form","Elektrodenform","digitale Elektrode",{"_219":282,"_108":283,"_222":284,"_224":-5},"storage-temperature","Lagertemperatur","- 15~60℃",{"_219":286,"_108":287,"_222":288,"_224":-5},"operating-temperature","Arbeitstemperatur","0~65 ℃ (nicht frierend)",{"_219":290,"_108":291,"_222":292,"_224":-5},"protection","Schutzniveau","IP68",{"_219":294,"_108":295,"_222":296,"_224":-5},"cable","Kabellänge","Standard 10m, ausziehbar",{"_219":298,"_108":299,"_222":300,"_224":-5},"sensor-size","Sensorgröße","151mm bis 26mm","sourceReviews",[],"documents",[],"supportDownloads",[]]
