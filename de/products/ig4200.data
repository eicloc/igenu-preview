ion",[102,118],{"_103":104,"_105":106},"title","产品","links",[107,112,115],{"_108":109,"_110":111},"label","Wasseranalyse","href","/de/products?category=water",{"_108":113,"_110":114},"Industrielle Messung","/de/products?category=industrial",{"_108":116,"_110":117},"Gasdetektion","/de/products?category=gas",{"_103":119,"_105":120},"了解更多",[121,124,127,130,133],{"_108":122,"_110":123},"关于我们","/de/about",{"_108":125,"_110":126},"客户案例","/de/cases",{"_108":128,"_110":129},"新闻中心","/de/news",{"_108":131,"_110":132},"售后服务","/de/service",{"_108":134,"_110":135},"下载中心","/de/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig4200",[],[],"seo",{"_103":146,"_147":148,"_149":150,"_151":152},"IG4200 Online-Analysator für die Gesamtfeststoffkonzentration | IGENU SCIENCE","description","Die Mikrowellentransmission bestimmt die Gesamtfeststoffkonzentration direkt in Wasserproben ohne vorherige Trennung oder Sedimentation. Kontinuierliche Messwerte und die Anbindung an Steuerungssysteme unterstützen die Prozessüberwachung in Abwasserbehandlung, Chemie, pharmazeutischer Herstellung und Lebensmittelverarbeitung an den vorgesehenen Messstellen.","imageUrl","/igenu-preview/media/4b53f5aab7936bf5768d9331.jpg","index",true,"canonical","https://eicloc.github.io/igenu-preview/de/products/ig4200","query",{},"selected",[],"detail",{"_161":162,"_57":141,"_163":164,"_165":166,"_167":148,"_168":169,"_170":171,"_175":176,"_203":204,"_205":206,"_147":-5,"_207":208,"_209":210,"_211":212,"_213":214,"_282":283,"_284":285,"_286":287,"_144":145},"id","8adc50f7-109a-4e34-80e1-4442cb557ef8","model","IG4200","name","IG4200 Online-Analysator für die Gesamtfeststoffkonzentration","shortDescription","featured",false,"category",{"_57":172,"_173":-5,"_165":113,"_147":-5,"_144":174},"industrial","brand",{"_103":113,"_147":-5,"_149":-5,"_151":152},"heroImage",{"_161":177,"_140":178,"_179":180,"_181":182,"_183":184,"_185":186,"_187":188,"_189":190,"_191":150,"_192":193,"_194":195},"a7d0c5a5-4017-44bb-880a-fe921c7cae03","IMAGE","originalName","2025041053569693.png","mimeType","image/jpeg","size",47641,"sha256","4b53f5aab7936bf5768d9331003eaab972aa10e742396f2311725e7a132e48cb","width",490,"height",278,"url","createdAt","2026-10-20T17:32:39.927Z","variants",[196,201],{"_187":197,"_189":198,"_181":199,"_191":200},320,182,"image/webp","/igenu-preview/media/460947b2f394cc6a41c35af0.webp",{"_187":188,"_189":190,"_181":199,"_191":202},"/igenu-preview/media/b3843283fc6cbe984798d870.webp","detailLayout","STRUCTURED","availableLocales",[20,11,17],"bodyHtml","<span><strong>Produktmerkmale:</strong></span><br />◆Schnell und präzise: Durch die Verwendung von Mikrowellensignalen zur Messung kann die Konzentration von Feststoffen in Wasserproben innerhalb von Sekunden mit hoher Genauigkeit ermittelt werden.<br />◆ Keine Notwendigkeit für Probenverarbeitung: Traditionelle Prüfmethoden für die Feststoffkonzentration erfordern Trennung, Ausfällung und andere Behandlungen der Probe, während Online-Mikrowellen-Gesamtkonzentrationsmessgeräte die ◆Wasserprobe direkt messen und den Schritt der Probenverarbeitung eliminieren.<br />◆Echtzeitüberwachung: Dieses Instrument kann die Änderungen der Gesamtfestkonzentration in Wasserproben in Echtzeit überwachen und die Steuerung und Anpassung des Produktionsprozesses erleichtern.<br />◆Hoher Automatisierungsgrad: Es kann an das Steuerungssystem des Produktionsprozesses angeschlossen werden, um eine automatisierte Steuerung zu erreichen.<br />◆Derzeit sind die meisten der eingesetzten Schlammkonzentrationssensoren optische Sensoren, die den Messkopf stark verunreinigen und durch den angesammelten Kalkstein vom Messbereich abweichen, wodurch die Wartungskosten steigen. Der ◆IG4200 verwendet einen speziellen Materialsensor, der der Ansammlung von Schmutz widersteht und so langfristige Stabilität bietet.<br /><span><strong>Anwendungsbereiche:</strong></span><br />Chemie, Pharma, Abwasserbehandlung, Lebensmittel, Umweltschutz<br /><span><strong>Technische Parameter:</strong></span><br />Messbereich: 35% TS, 350000 mg/L<br />Wiederholbarkeit: 0,01% TS<br />Auflösung: 0,001%<br />Genauigkeit (unter stabilen Bedingungen):  ± 0,02% TS<br />Druck: größer als 1,5 bar<br />Leitfähigkeit: 0-25ms/cm<br />Signalanschluss: 4-20mA/RS485<br />Flüssiges Empfangsmaterial: 316L+keramik<br />Probenahmezeit: 1 Sekunde<br />Schutzart: Sensor IP66, Controller: IP65<br />Installationsmethoden: Stecker, Flansch Typ<br />Durchfluss: ＜ 5m/s<br />Prozesstemperatur: 0-70 ℃<br />Umgebungstemperatur: 0-60 ℃<br />Stromversorgung: 220VAC\n    ","gallery",[],"features",[],"specificationGroups",[215],{"_165":216,"_217":218},"Technische Daten","specifications",[219,226,230,234,238,242,246,250,254,258,262,266,270,274,278],{"_220":221,"_108":222,"_223":224,"_225":-5},"key","measurement-range","Messbereich","value","35% TS, 350000 mg/L","unit",{"_220":227,"_108":228,"_223":229,"_225":-5},"repeatability","Wiederholbarkeit","0,01% TS",{"_220":231,"_108":232,"_223":233,"_225":-5},"resolution","Auflösung","0,001%",{"_220":235,"_108":236,"_223":237,"_225":-5},"accuracy","Genauigkeit (unter stabilen Bedingungen)","± 0,02% TS",{"_220":239,"_108":240,"_223":241,"_225":-5},"pressure","Druck","größer als 1,5 bar",{"_220":243,"_108":244,"_223":245,"_225":-5},"conductivity","Leitfähigkeit","0-25ms/cm",{"_220":247,"_108":248,"_223":249,"_225":-5},"signal-port","Signalanschluss","4-20mA/RS485",{"_220":251,"_108":252,"_223":253,"_225":-5},"wetted-material","Flüssiges Empfangsmaterial","316L+keramik",{"_220":255,"_108":256,"_223":257,"_225":-5},"sampling-time","Probenahmezeit","1 Sekunde",{"_220":259,"_108":260,"_223":261,"_225":-5},"protection","Schutzart","Sensor IP66, Controller: IP65",{"_220":263,"_108":264,"_223":265,"_225":-5},"installation","Installationsmethoden","Stecker, Flansch Typ",{"_220":267,"_108":268,"_223":269,"_225":-5},"flow-rate","Durchfluss","＜ 5m/s",{"_220":271,"_108":272,"_223":273,"_225":-5},"process-temperature","Prozesstemperatur","0-70 ℃",{"_220":275,"_108":276,"_223":277,"_225":-5},"operating-temperature","Umgebungstemperatur","0-60 ℃",{"_220":279,"_108":280,"_223":281,"_225":-5},"power-supply","Stromversorgung","220VAC","sourceReviews",[],"documents",[],"supportDownloads",[]]
