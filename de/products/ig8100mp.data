ion",[102,118],{"_103":104,"_105":106},"title","产品","links",[107,112,115],{"_108":109,"_110":111},"label","Wasseranalyse","href","/de/products?category=water",{"_108":113,"_110":114},"Industrielle Messung","/de/products?category=industrial",{"_108":116,"_110":117},"Gasdetektion","/de/products?category=gas",{"_103":119,"_105":120},"了解更多",[121,124,127,130,133],{"_108":122,"_110":123},"关于我们","/de/about",{"_108":125,"_110":126},"客户案例","/de/cases",{"_108":128,"_110":129},"新闻中心","/de/news",{"_108":131,"_110":132},"售后服务","/de/service",{"_108":134,"_110":135},"下载中心","/de/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig8100mp",[],[],"seo",{"_103":146,"_147":148,"_149":150,"_151":152},"IG8100MP Tragbarer Gasdetektor mit Alarm | IGENU SCIENCE","description","Der tragbare Gasdetektor nutzt eine integrierte Pumpe zur Probenahme und wird mit Sensoren für die gewünschten Zielgase ausgestattet. Ein Farbdisplay zeigt Messinformationen; akustische, optische und Vibrationsalarme unterstützen die Wahrnehmung des Gerätestatus bei mobilen Kontrollen.","imageUrl","/igenu-preview/media/08e61223b82894782eed9185.png","index",true,"canonical","https://eicloc.github.io/igenu-preview/de/products/ig8100mp","query",{},"selected",[],"detail",{"_161":162,"_57":141,"_163":164,"_165":166,"_167":148,"_168":169,"_170":171,"_175":176,"_207":208,"_209":210,"_147":-5,"_211":212,"_213":214,"_215":216,"_217":218,"_286":287,"_288":289,"_290":291,"_144":145},"id","d712539f-bba5-44ea-9c7e-5be89c6d40ac","model","IG8100MP","name","IG8100MP Tragbarer Gasdetektor mit Alarm","shortDescription","featured",false,"category",{"_57":172,"_173":-5,"_165":116,"_147":-5,"_144":174},"gas","brand",{"_103":116,"_147":-5,"_149":-5,"_151":152},"heroImage",{"_161":177,"_140":178,"_179":180,"_181":182,"_183":184,"_185":186,"_187":188,"_189":190,"_191":150,"_192":193,"_194":195},"2c4a4ac6-d50b-4737-b7e4-ebc32635cd6c","IMAGE","originalName","2025040852237053.png","mimeType","image/png","size",280168,"sha256","08e61223b82894782eed918587b2b8ae3b4fa6fbbb2b5228bbfebeca395a748a","width",691,"height",699,"url","createdAt","2026-10-20T17:32:39.713Z","variants",[196,201,205],{"_187":197,"_189":198,"_181":199,"_191":200},320,324,"image/webp","/igenu-preview/media/5f86a27572b4892ac922fa01.webp",{"_187":202,"_189":203,"_181":199,"_191":204},640,647,"/igenu-preview/media/56eed4aed7ff6130c91bdc9f.webp",{"_187":188,"_189":190,"_181":199,"_191":206},"/igenu-preview/media/50e8b14977630a4f3e555596.webp","detailLayout","STRUCTURED","availableLocales",[20,11,17],"bodyHtml","<strong><span>Produktmerkmale:</span></strong><br />2.5-Zoll hochauflösender Farbbildschirm, drei Anzeigemodi, fähig, Kurvengrafiken anzuzeigen<br />◆ Ausgestattet mit einem Standard-um-Füllstandsfilter, kann es 99% von Öl, Wasser, Staub und Verunreinigungen herausfiltern, wodurch es einfacher zu bedienen und zu verwenden ist<br />◆ Unterstützt 1-4 Arten von Sensoren, Millisekunden Level Antwort, hohe Genauigkeit<br />Pumpsaugprobe, geeignet für jedes Szenario<br />Dreifacher Alarm (Ton und Licht, Vibration), nicht leicht zu ignorieren<br /><strong><span>Anwendungsbereiche:</span></strong><br />Erdöl/chemische Industrie, industrielle Fertigung, Abwasserbehandlung, Energie- und Elektrotechnik, Metallschmelzen<br /><strong><span>Technische Parameter:</span><br />Gasdetektion:</strong><br />Sauerstoff, Schwefel und Oxide<br />Sauerstoff O2, Ozon O3, Kohlenmonoxid CO, Kohlendioxid CO2, Stickstoffoxid NO, Stickstoffdioxid NO2, Stickstoffoxide NOx, Schwefeldioxid SO2, Chlordioxid CLO2<br />Stickstoff, Wasserstoff und Cyanid<br />Wasserstoff H2, Ammoniak NH3, Schwefelwasserstoff H2S, Stickstoff N2, Chlorwasserstoff HCL, Phosphin PH3, Cyanid HCN, Arsin AsH3, Fluorwasserstoff HF<br />Alkane und brennbare Gase<br />Brenngase EX, Methan CH4, Ethan C2H6, Propan C3H8, Epoxyethan C2H4O<br />Organische flüchtige Gase<br />Geruch ODOR, Benzol C6H6, Toluol C7H8, Xylol C8H10 VOCs 、 Formaldehyd CH2O, Ethylen C2H4, Ethanol C2H6O, Gesamtkohlenwasserstoffe ohne Methan<br />Halogen, halogenierte Kohlenwasserstoffe<br />Schwefelhexafluorid SF6, Chlorgas CL2, Flurgas F2, Bromgas Br2<br />Detektionsprinzip: elektrochemische Methode/Infrarot-Methode/katalytische Verbrennung/PID<br />Messbereich: 0~50/100ppm, 0~50/100%Vol<br />Auflösungsleistung: 0,01ppm,0,01%VOL<br />Nachweisgrenze: 0,05ppm, 0,05% VOL<br />Genauigkeit: ≤ ±1%F.S<br />Nulldrift: ≤ ± 1% F.S/Jahr<br />Ansprechzeit: ≤ 15 Sekunden (T90)<br />Erholungszeit: ≤ 20 Sekunden<br />Prüfmethode: Pumpensaugung<br />Temperatur und Feuchtigkeit: Temperaturerfassungsbereich: -40~120 ℃, Temperaturerfassungsbereich: 0-100% RH<br />Erkennungsmethode: Echtzeit, zeitgesteuert<br />Gasausbreitung: Unterstützt 1-4 Sonden<br />Nulldrift: ≤ ± 1% (F.S/Jahr)<br />Schutzniveau: IP65<br />Speichermodus: lokaler Speicher oder Speicherkarte<br />Stromversorgung: 4600mA wiederaufladbare Polymerbatterie\n    ","gallery",[],"features",[],"specificationGroups",[219],{"_165":220,"_221":222},"Technische Daten","specifications",[223,230,234,238,242,246,250,254,258,262,266,270,274,278,282],{"_224":225,"_108":226,"_227":228,"_229":-5},"key","measurement-principle","Detektionsprinzip","value","elektrochemische Methode/Infrarot-Methode/katalytische Verbrennung/PID","unit",{"_224":231,"_108":232,"_227":233,"_229":-5},"measurement-range","Messbereich","0~50/100ppm, 0~50/100%Vol",{"_224":235,"_108":236,"_227":237,"_229":-5},"resolution","Auflösungsleistung","0,01ppm,0,01%VOL",{"_224":239,"_108":240,"_227":241,"_229":-5},"detection-limit","Nachweisgrenze","0,05ppm, 0,05% VOL",{"_224":243,"_108":244,"_227":245,"_229":-5},"accuracy","Genauigkeit","≤ ±1%F.S",{"_224":247,"_108":248,"_227":249,"_229":-5},"zero-drift","Nulldrift","≤ ± 1% F.S/Jahr; ≤ ± 1% (F.S/Jahr)",{"_224":251,"_108":252,"_227":253,"_229":-5},"response-time","Ansprechzeit","≤ 15 Sekunden (T90)",{"_224":255,"_108":256,"_227":257,"_229":-5},"recovery-time","Erholungszeit","≤ 20 Sekunden",{"_224":259,"_108":260,"_227":261,"_229":-5},"testing-method","Prüfmethode","Pumpensaugung",{"_224":263,"_108":264,"_227":265,"_229":-5},"temperature-humidity","Temperatur und Feuchtigkeit","Temperaturerfassungsbereich: -40~120 ℃, Temperaturerfassungsbereich: 0-100% RH",{"_224":267,"_108":268,"_227":269,"_229":-5},"detection-method","Erkennungsmethode","Echtzeit, zeitgesteuert",{"_224":271,"_108":272,"_227":273,"_229":-5},"gas-expansion","Gasausbreitung","Unterstützt 1-4 Sonden",{"_224":275,"_108":276,"_227":277,"_229":-5},"protection","Schutzniveau","IP65",{"_224":279,"_108":280,"_227":281,"_229":-5},"storage-mode","Speichermodus","lokaler Speicher oder Speicherkarte",{"_224":283,"_108":284,"_227":285,"_229":-5},"power-supply","Stromversorgung","4600mA wiederaufladbare Polymerbatterie","sourceReviews",[],"documents",[],"supportDownloads",[]]
