ion",[102,118],{"_103":104,"_105":106},"title","产品","links",[107,112,115],{"_108":109,"_110":111},"label","Wasseranalyse","href","/de/products?category=water",{"_108":113,"_110":114},"Industrielle Messung","/de/products?category=industrial",{"_108":116,"_110":117},"Gasdetektion","/de/products?category=gas",{"_103":119,"_105":120},"了解更多",[121,124,127,130,133],{"_108":122,"_110":123},"关于我们","/de/about",{"_108":125,"_110":126},"客户案例","/de/cases",{"_108":128,"_110":129},"新闻中心","/de/news",{"_108":131,"_110":132},"售后服务","/de/service",{"_108":134,"_110":135},"下载中心","/de/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig1000",[],[],"seo",{"_103":146,"_147":148,"_149":150,"_151":152},"IG1000 Elektromagnetischer Durchflussmesser | IGENU SCIENCE","description","Der elektromagnetische Durchflussmesser erfasst leitfähige Flüssigkeiten wie Wasser und Prozessschlämme. Rohrleitungseinbau und elektrische Ausgänge ermöglichen die Einbindung in die Prozessüberwachung; Elektroden, Auskleidung und Anschlüsse werden passend zum Medium und zur Anwendung ausgewählt.","imageUrl","/igenu-preview/media/2a75c1e35c4f5d26d0d45a78.jpg","index",true,"canonical","https://eicloc.github.io/igenu-preview/de/products/ig1000","query",{},"selected",[],"detail",{"_161":162,"_57":141,"_163":164,"_165":166,"_167":148,"_168":169,"_170":171,"_175":176,"_207":208,"_209":210,"_147":-5,"_211":212,"_213":214,"_215":216,"_217":218,"_274":275,"_322":323,"_324":325,"_144":145},"id","718efa0b-619e-43bd-aa4d-e57bc33e3a82","model","IG1000","name","IG1000 Elektromagnetischer Durchflussmesser","shortDescription","featured",false,"category",{"_57":172,"_173":-5,"_165":113,"_147":-5,"_144":174},"industrial","brand",{"_103":113,"_147":-5,"_149":-5,"_151":152},"heroImage",{"_161":177,"_140":178,"_179":180,"_181":182,"_183":184,"_185":186,"_187":188,"_189":190,"_191":150,"_192":193,"_194":195},"ae088e5b-dee3-4d64-a813-8aea3d5faa40","IMAGE","originalName","2018040280914617.jpg","mimeType","image/jpeg","size",79233,"sha256","2a75c1e35c4f5d26d0d45a78e4afd1e32e7fc5846f14595ed04ad41691e1ba5a","width",775,"height",522,"url","createdAt","2026-10-20T17:32:39.599Z","variants",[196,201,205],{"_187":197,"_189":198,"_181":199,"_191":200},320,216,"image/webp","/igenu-preview/media/b9d84e037e2e93e539dbc230.webp",{"_187":202,"_189":203,"_181":199,"_191":204},640,431,"/igenu-preview/media/34a2de4913f859e3b5fd7093.webp",{"_187":188,"_189":190,"_181":199,"_191":206},"/igenu-preview/media/f7cba31a9a75d0b97c8bfde5.webp","detailLayout","STRUCTURED","availableLocales",[20,11,17],"bodyHtml","<span>Technische Parameter</span><br /><br />Die serie von ig1000 serie electromagnetic flowmeter abgeschlossen ist und dient zur messung der flüssigkeit mit elektrischen leitfähigkeit von weniger als 5 s / cm<br />der zustrom von zellstoff, schleim und schlamm.die optionale kaliber wird kontinuierlich von dn10 zu dn3000.sensor - und umstellung<br />das gerät hat eine form, design und auch eine art form.<br />die produktion von ig1000 electromagnetic flowmeter nimmt die technologie der ig corporation (igenu gmbh).<br />kontrolle und qualitätsmanagement einhaltung der technischen spezifikationen der ig - unternehmen und mit dem online - system der qualitätssicherung und der ig öffentliche<br />unsere qualität inspektion und zertifizierung, prüfung von deutschen experten, qualität und die deutsche fabrik waren ende<br />alle gleich sind, damit die versammlung und die produktion von ig1000 serie electromagnetic flowmeter ist der gleiche wie der deutschen fabrik.<br />qualität.die anwendung wirkung ist sehr ideal und begrüßt von der großen zahl der nutzer.<br /><br /><span>Sensor:</span><br />modell ig12<br />genauigkeit standard + 0,5% (+ 0,2%,<br />prozess - verbindung flansch (tan - gang), flansch (1.4571 (316ti])<br />futter schwer / weich kautschuk, ptfe und pfa<br />die elektrische leitfähigkeit &gt; 5 / cm (enthärtetem wasser 20 us / cm)<br />elektrode material edelstahl 1.4571 (316ti], 1.4539, hirson legierung b2 / c4, pt, iridium, tantal, titan<br />schutz grad ip67<br />- temperatur - 25 - + 180 c<br />das design nicht explosionsgeschützten / 97, atex - 1173x<br />zertifizierung projekt kaltes wasser, abwasser und ohne wasser flüssig<br />druckgeräte<br />die 97 / 23 / zb konsistenz bewertung entspricht der kategorie iii, fluid - gruppe 1<br /><br /><span>video:</span><br />stromversorgung 85-253 vac / 16.8-26.4vac / 16.8-31.2 vdc<br />aktuelle ausgabe 0 / 2 - 10 ma, 0-5ma, 0 / 4 - 20 ma, 0 / 4 / 12 bis 20<br />ma<br />der puls des aktiven oder passiven optocoupler 24 v dc puls<br />einsatz von externen null optocoupler<br />akku - reset optocoupler input<br />positive / reverse - messung der ausgangssignal des optocoupler<br />der schlauch -, wird von der dn10:3 / 8 und das ausgangssignal des optocoupler<br />self - monitoring - funktionen<br />auf der stelle anzeige / müdigkeit<br />zusatz - funktion<br />shell<br />aluminium - hülle (standard), edelstahl - konverter (auswahl<br />mit)<br />mitteilung profibus dp, profibus pa, hart - protokoll<br />foundation - fieldbus - ascii - protokoll (rs485)\n    ","gallery",[],"features",[],"specificationGroups",[219],{"_165":220,"_221":222},"Technische Daten","specifications",[223,230,234,238,242,246,250,254,258,262,266,270],{"_224":225,"_108":226,"_227":228,"_229":-5},"key","accuracy","Genauigkeit standard","value","+ 0,5% (+ 0,2%,","unit",{"_224":231,"_108":232,"_227":233,"_229":-5},"process-connection","Prozess - verbindung","flansch (tan - gang), flansch (1.4571 (316ti])",{"_224":235,"_108":236,"_227":237,"_229":-5},"lining","Futter","schwer / weich kautschuk, ptfe und pfa",{"_224":239,"_108":240,"_227":241,"_229":-5},"conductivity","Die elektrische leitfähigkeit","> 5 / cm (enthärtetem wasser 20 us / cm)",{"_224":243,"_108":244,"_227":245,"_229":-5},"electrode-material","Elektrode material","edelstahl 1.4571 (316ti], 1.4539, hirson legierung b2 / c4, pt, iridium, tantal, titan",{"_224":247,"_108":248,"_227":249,"_229":-5},"protection","Schutz grad","ip67",{"_224":251,"_108":252,"_227":253,"_229":-5},"power-supply","Stromversorgung","85-253 vac / 16.8-26.4vac / 16.8-31.2 vdc",{"_224":255,"_108":256,"_227":257,"_229":-5},"current-output","Aktuelle ausgabe","0 / 2 - 10 ma, 0-5ma, 0 / 4 - 20 ma, 0 / 4 / 12 bis 20\nma",{"_224":259,"_108":260,"_227":261,"_229":-5},"pulse-output","Der puls des","aktiven oder passiven optocoupler 24 v dc puls",{"_224":263,"_108":264,"_227":265,"_229":-5},"accumulator-reset","Akku - reset","optocoupler input",{"_224":267,"_108":268,"_227":269,"_229":-5},"empty-pipe-detector","der schlauch -, wird von der dn10","3 / 8 und das ausgangssignal des optocoupler",{"_224":271,"_108":272,"_227":273,"_229":-5},"digital-communication","Mitteilung","profibus dp, profibus pa, hart - protokoll\nfoundation - fieldbus - ascii - protokoll (rs485)","sourceReviews",[276,295,304,313],{"_224":243,"_140":277,"_278":279,"_280":281,"_282":283},"conflict","note","原站三语资料存在差异；保留各语言原值，等待品牌方确认。","status","pending","sources",[284,289,293],{"_108":285,"_227":286,"_10":17,"_287":288},"Electrode material","of stainless steel 1.4571[316Ti], 1.4539, hirson alloy B2/C4, Pt, iridium, tantalum, titanium","sourceUrl","http://www.igenu.com/proshow_6.html",{"_108":290,"_227":291,"_10":20,"_287":292},"电极材质","含钼不锈钢、哈氏合金 B、哈氏合金 C、钛、铂 / 铱合金、 钽、碳化钨","http://www.igenu.com/cn/proshow_6.html",{"_108":244,"_227":245,"_10":11,"_287":294},"http://www.igenu.com/de/proshow_6.html",{"_224":259,"_140":277,"_278":279,"_280":281,"_282":296},[297,300,303],{"_108":298,"_227":299,"_10":17,"_287":288},"Pulse output","active 24 V DC pulse or passive Optocoupler",{"_108":301,"_227":302,"_10":20,"_287":292},"脉冲输出","无源、有源、频率、脉宽可调",{"_108":260,"_227":261,"_10":11,"_287":294},{"_224":271,"_140":277,"_278":279,"_280":281,"_282":305},[306,309,312],{"_108":307,"_227":308,"_10":17,"_287":288},"Communication","PROFIBUS DP, PROFIBUS PA, HART- protocol,\nFOUNDATION Fieldbus ASCII- protocol (RS485)",{"_108":310,"