ion",[102,118],{"_103":104,"_105":106},"title","产品","links",[107,112,115],{"_108":109,"_110":111},"label","Wasseranalyse","href","/de/products?category=water",{"_108":113,"_110":114},"Industrielle Messung","/de/products?category=industrial",{"_108":116,"_110":117},"Gasdetektion","/de/products?category=gas",{"_103":119,"_105":120},"了解更多",[121,124,127,130,133],{"_108":122,"_110":123},"关于我们","/de/about",{"_108":125,"_110":126},"客户案例","/de/cases",{"_108":128,"_110":129},"新闻中心","/de/news",{"_108":131,"_110":132},"售后服务","/de/service",{"_108":134,"_110":135},"下载中心","/de/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig30cls",[],[],"seo",{"_103":146,"_147":148,"_149":150,"_151":152},"IG30CLS Restchlorsensor | IGENU SCIENCE","description","Der Sensor misst Restchlor und Chlordioxid im Wasser nach einem elektrochemischen Verfahren mit konstantem Potenzial. Eine abgestimmte Durchflusszelle führt die Probe; kolorimetrische Reagenzien sowie ein regelmäßiger Austausch von Membranen oder Elektrolyt sind dabei nicht erforderlich.","imageUrl","/igenu-preview/media/128cbf77e27c44f50a679ba8.jpg","index",true,"canonical","https://eicloc.github.io/igenu-preview/de/products/ig30cls","query",{},"selected",[],"detail",{"_161":162,"_57":141,"_163":164,"_165":166,"_167":148,"_168":169,"_170":171,"_175":176,"_203":204,"_205":206,"_147":-5,"_207":208,"_209":210,"_211":212,"_213":214,"_285":286,"_287":288,"_289":290,"_144":145},"id","979b50bb-1b83-4aa2-b03a-464c97387d69","model","IG30CLS","name","IG30CLS Restchlorsensor","shortDescription","featured",false,"category",{"_57":172,"_173":-5,"_165":109,"_147":-5,"_144":174},"water","brand",{"_103":109,"_147":-5,"_149":-5,"_151":152},"heroImage",{"_161":177,"_140":178,"_179":180,"_181":182,"_183":184,"_185":186,"_187":188,"_189":190,"_191":150,"_192":193,"_194":195},"ce0b8383-b6df-4c9a-aabb-3a55435db7a7","IMAGE","originalName","2025040861142109.png","mimeType","image/jpeg","size",22021,"sha256","128cbf77e27c44f50a679ba8b27ec860b8243697fccdc4f64b056e6497df3a79","width",344,"height",423,"url","createdAt","2026-10-20T17:32:39.792Z","variants",[196,201],{"_187":197,"_189":198,"_181":199,"_191":200},320,393,"image/webp","/igenu-preview/media/e07f5ef0e1a47e02ed6259ae.webp",{"_187":188,"_189":190,"_181":199,"_191":202},"/igenu-preview/media/ecb94564bb6e1f06cbfde7cd.webp","detailLayout","STRUCTURED","availableLocales",[20,11,17],"bodyHtml","<strong><span>Produktmerkmale:</span></strong><br />◆ Annahme des Prinzips der konstanten Spannung<br />◆ Keine Notwendigkeit, die Membran und den Elektrolyt zu ersetzen<br />◆ Keine Notwendigkeit für kolorimetrische Reagenzien<br />◆ Speziell entworfener Zirkulationskanal zur Aufrechterhaltung einer stabilen Durchflussrate<br />◆ Nullpunktstabilität, starke Anti-Interferenz Fähigkeit<br />◆ Einfache und bequeme Bedienung, hohe Wirtschaftlichkeit<br /><strong><span>Anwendungsbereiche:</span></strong><br />Kommunale Wasserwerke, Kläranlagen, Sekundärwasserversorgung, Überwachung von Trink- und Oberflächenwasser, industrielle Prozesse<br /><strong><span>Technische Parameter:</span></strong><br />Bereich: 0~2mg/L oder 0~20mg/L<br />Messprinzip: konstante Spannung<br />Messgenauigkeit: ± 5%<br />Wiederholbarkeit: ± 5% des Messwertes<br />Auflösung: 0,01mg/L<br />Durchfluss: 25~55 L/h<br />Kalibrierungsmethoden: Nullkalibrierung, Neigungskalibrierung<br />PH-Kompensation: manuell oder automatisch<br />Temperaturausgleich: manuell oder automatisch<br />Steigung: 75%~155%<br />Sensormaterial: 316L Edelstahl+Platin Elektrode<br />Sensorspannung: 9~36VDC<br />Sensorkommunikation: MODBUS RS-485 <br />Mittlere Temperatur: 0~50 ℃ (nicht frierend)<br />Kabellänge: Standard 1,5 Meter, ausziehbar<br />Sensorgröße: 201mm bis 35mm\n    ","gallery",[],"features",[],"specificationGroups",[215],{"_165":216,"_217":218},"Technische Daten","specifications",[219,226,230,234,238,242,246,250,254,257,261,265,269,273,277,281],{"_220":221,"_108":222,"_223":224,"_225":-5},"key","meas