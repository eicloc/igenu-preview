ion",[102,118],{"_103":104,"_105":106},"title","产品","links",[107,112,115],{"_108":109,"_110":111},"label","Wasseranalyse","href","/de/products?category=water",{"_108":113,"_110":114},"Industrielle Messung","/de/products?category=industrial",{"_108":116,"_110":117},"Gasdetektion","/de/products?category=gas",{"_103":119,"_105":120},"了解更多",[121,124,127,130,133],{"_108":122,"_110":123},"关于我们","/de/about",{"_108":125,"_110":126},"客户案例","/de/cases",{"_108":128,"_110":129},"新闻中心","/de/news",{"_108":131,"_110":132},"售后服务","/de/service",{"_108":134,"_110":135},"下载中心","/de/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig30bga-ig30chl",[],[],"seo",{"_103":146,"_147":148,"_149":150,"_151":152},"IG30BGA/IG30CHL Blaualgen- und Chlorophyllsensor | IGENU SCIENCE","description","Die Fluoreszenzmessung erfasst Blaualgen und Chlorophyll direkt im Wasser, ohne Probenextraktion oder chemische Reagenzien. Digitale Kommunikation unterstützt die kontinuierliche Überwachung; eine optionale Reinigungsbürste begrenzt Ablagerungen an der optischen Messfläche, etwa beim Einsatz an Wasserentnahmestellen.","imageUrl","/igenu-preview/media/3a4bd3a9ba0af3bd90061177.jpg","index",true,"canonical","https://eicloc.github.io/igenu-preview/de/products/ig30bga-ig30chl","query",{},"selected",[],"detail",{"_161":162,"_57":141,"_163":164,"_165":166,"_167":148,"_168":169,"_170":171,"_175":176,"_201":202,"_203":204,"_147":-5,"_205":206,"_207":208,"_209":210,"_211":212,"_276":277,"_278":279,"_280":281,"_144":145},"id","df5b5971-b8ab-4461-9dd3-21bd164a9ff2","model","IG30BGA/IG30CHL","name","IG30BGA/IG30CHL Blaualgen- und Chlorophyllsensor","shortDescription","featured",false,"category",{"_57":172,"_173":-5,"_165":109,"_147":-5,"_144":174},"water","brand",{"_103":109,"_147":-5,"_149":-5,"_151":152},"heroImage",{"_161":177,"_140":178,"_179":180,"_181":182,"_183":184,"_185":186,"_187":188,"_189":188,"_190":150,"_191":192,"_193":194},"e9c2938f-6236-4c7f-bf9d-752bcf98b444","IMAGE","originalName","2025040861512869.jpg","mimeType","image/jpeg","size",13520,"sha256","3a4bd3a9ba0af3bd90061177b116d1a851d9d410ca383514dfbd7fdb3aa5270f","width",540,"height","url","createdAt","2026-10-20T17:32:39.805Z","variants",[195,199],{"_187":196,"_189":196,"_181":197,"_190":198},320,"image/webp","/igenu-preview/media/9fb61c06fe27bcc0e9cecfd6.webp",{"_187":188,"_189":188,"_181":197,"_190":200},"/igenu-preview/media/b63396be40013d2d55e983f5.webp","detailLayout","STRUCTURED","availableLocales",[20,11,17],"bodyHtml","<strong><span>Produktmerkmale:</span></strong><br />◆ Annahme der korrosionsbeständigen Hülle der Titanlegierung; NPT3/4 Gewindeschnittstelle für einfache Installation;<br />◆ Mit Selbstreinigungsfunktion kann es Anbauteile von Wasserproben ohne Wartung entfernen;<br />◆ Die Probe benötigt keine Verarbeitung oder Extraktion, ist zerstörungsfrei, reagenzfrei und schadstofffrei; Direkte Messung ist einfacher als herkömmliche Analysemethoden<br />◆ Genaue Messung, niedrige Erkennungsgrenze und gute Langzeitstabilität;<br />◆ Ultra helle LED-Lichtquelle, verbessert Signal-Rausch-Verhältnis und verbessert Stabilität;<br />◆ Ausgestattet mit Kalibrierdatenspeicherfunktion, Plug and Play, keine Kalibrierung erforderlich für den ersten Gebrauch.<br />◆ Digitaler Sensor, RS-485 Ausgang, unterstützt MODBUS<br />◆ Kann kontinuierlich online überwacht werden, Echtzeit-Steuerung der Wasserqualitätsdynamik<br /><strong><span>Anwendungsbereiche:</span></strong><br />Überwachung von Trinkwasserquellen, Warnung vor Algenblüten, Aufnahme von Wasserpflanzen, Umweltüberwachung<br /><strong><span>Technische Parameter:</span></strong><br />Messbereich: Blaualgen: 0-200000 Zellen/ml<br />Chlorophyll: 0-1000ppb<br />Messprinzip: UV-Fluoreszenz<br />Messgenauigkeit: ± 3% des Lesens oder 0,1ppb<br />Wiederholbarkeit: ± 3%<br />Kalibriermethode: Einpunktkalibrierung, basierend auf experimentellen Ergebnissen<br />Medium Anforderungen: Durchfluss: 0-3m/s; Druck: 0-100psi<br />Sensormaterial: 316L oder POM<br />Sensorkommunikation: MODBUS RS-485 <br />Lagertemperatur:- 15~50℃ <br />Arbeitstemperatur: 0~50 ℃ (nicht frierend)<br />Selbstreinigung: automatische Kratzbürste (optional)<br />Kabellänge: Standard 10m, ausziehbar<br />Sensorgröße: 176mm bis 22mm\n    ","gallery",[],"features",[],"specificationGroups",[213],{"_165":214,"_215":216},"Technische Daten","specifications",[217,224,228,232,236,240,244,248,252,256,260,264,268,272],{"_218":219,"_108":220,"_221":222,"_223":-5},"key","measurement-range","Messbereich","value","Blaualgen: 0-200000 Zellen/ml","unit",{"_218":225,"_108":226,"_221":227,"_223":-5},"chlorophyll","Chlorophyll","0-1000ppb",{"_218":229,"_108":230,"_221":231,"_223":-5},"measurement-principle","Messprinzip","UV-Fluoreszenz",{"_218":233,"_108":234,"_221":235,"_223":-5},"accuracy","Messgenauigkeit","± 3% des Lesens oder 0,1ppb",{"_218":237,"_108":238,"_221":239,"_223":-5},"repeatability","Wiederholbarkeit","± 3%",{"_218":241,"_108":242,"_221":243,"_223":-5},"calibration","Kalibriermethode","Einpunktkalibrierung, basierend auf experimentellen Ergebnissen",{"_218":245,"_108":246,"_221":247,"_223":-5},"medium-requirements","Medium Anforderungen","Durchfluss: 0-3m/s; Druck: 0-100psi",{"_218":249,"_108":250,"_221":251,"_223":-5},"sensor-material","Sensormaterial","316L oder POM",{"_218":253,"_108":254,"_221":255,"_223":-5},"digital-communication","Sensorkommunikation","MODBUS RS-485",{"_218":257,"_108":258,"_221":259,"_223":-5},"storage-temperature","Lagertemperatur","- 15~50℃",{"_218":261,"_108":262,"_221":263,"_223":-5},"operating-temperature","Arbeitstemperatur","0~50 ℃ (nicht frierend)",{"_218":265,"_108":266,"_221":267,"_223":-5},"self-cleaning","Selbstreinigung","automatische Kratzbürste (optional)",{"_218":269,"_108":270,"_221":271,"_223":-5},"cable","Kabellänge","Standard 10m, ausziehbar",{"_218":273,"_108":274,"_221":275,"_223":-5},"sensor-size","Sensorgröße","176mm bis 22mm","sourceReviews",[],"documents",[],"supportDownloads",[