ion",[102,118],{"_103":104,"_105":106},"title","产品","links",[107,112,115],{"_108":109,"_110":111},"label","Wasseranalyse","href","/de/products?category=water",{"_108":113,"_110":114},"Industrielle Messung","/de/products?category=industrial",{"_108":116,"_110":117},"Gasdetektion","/de/products?category=gas",{"_103":119,"_105":120},"了解更多",[121,124,127,130,133],{"_108":122,"_110":123},"关于我们","/de/about",{"_108":125,"_110":126},"客户案例","/de/cases",{"_108":128,"_110":129},"新闻中心","/de/news",{"_108":131,"_110":132},"售后服务","/de/service",{"_108":134,"_110":135},"下载中心","/de/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig30rps",[],[],"seo",{"_103":146,"_147":148,"_149":150,"_151":152},"IG30RPS Digitale Redoxelektrode | IGENU SCIENCE","description","Die digitale Redoxelektrode überwacht das Oxidations-Reduktions-Potenzial in Wasser und industriellen Prozessen. Eine Platin-Messelektrode und ein Referenzsystem mit doppelter Salzbrücke werden durch digitale Kommunikation, Proben- oder Standardkalibrierung sowie Halterung und Durchflusszelle für die Installation ergänzt.","imageUrl","/igenu-preview/media/7dfe5452c927d26232963ff8.jpg","index",true,"canonical","https://eicloc.github.io/igenu-preview/de/products/ig30rps","query",{},"selected",[],"detail",{"_161":162,"_57":141,"_163":164,"_165":166,"_167":148,"_168":169,"_170":171,"_175":176,"_203":204,"_205":206,"_147":-5,"_207":208,"_209":210,"_211":212,"_213":214,"_290":291,"_292":293,"_294":295,"_144":145},"id","443d766d-df72-4a5d-a984-9164160231c6","model","IG30RPS","name","IG30RPS Digitale Redoxelektrode","shortDescription","featured",false,"category",{"_57":172,"_173":-5,"_165":109,"_147":-5,"_144":174},"water","brand",{"_103":109,"_147":-5,"_149":-5,"_151":152},"heroImage",{"_161":177,"_140":178,"_179":180,"_181":182,"_183":184,"_185":186,"_187":188,"_189":190,"_191":150,"_192":193,"_194":195},"7507b7cd-7dc3-42b2-90a4-f843106d4461","IMAGE","originalName","2025040859520101.png","mimeType","image/jpeg","size",19079,"sha256","7dfe5452c927d26232963ff85f11073f15b9d29010abcb394bea3ce0f2f502d6","width",358,"height",302,"url","createdAt","2026-10-20T17:32:39.754Z","variants",[196,201],{"_187":197,"_189":198,"_181":199,"_191":200},320,270,"image/webp","/igenu-preview/media/93a066c50a54638353b43bbf.webp",{"_187":188,"_189":190,"_181":199,"_191":202},"/igenu-preview/media/b72cc265fa7500183b25c7da.webp","detailLayout","STRUCTURED","availableLocales",[20,11,17],"bodyHtml","<strong><span>Produktmerkmale:</span></strong><br />◆ Reiche Konfiguration, um verschiedene Arbeitsbedingungen Anforderungen zu erfüllen<br />◆ Eingebauter Temperatursensor, automatische Temperaturkompensation<br />◆ Automatische Identifizierung der Standardlösung, eine Punktprobenkalibrierung<br />◆Der Sensor besteht aus Ryton Material, das eine längere Lebensdauer hat und Wartung und Ausfallzeiten reduziert<br />◆ Mikroporöse Doppelsalzbrücke der großen Kapazität macht die Sonde widerstandsfähiger gegen Toxizität und hat eine längere Lebensdauer<br />◆ Dicke und hochohmige Blase mit starker struktureller Festigkeit, nicht leicht durch Partikelschlag beschädigt<br />◆ Ultra große Platinelektrode verbessert die Reaktionsgeschwindigkeit und Verschmutzungsbeständigkeit der ORP-Elektrode<br />◆ Digitalsensor, RS-485 Ausgang, Standard Modbus RTU Protokoll, nicht beeinflusst durch Übertragungsabstand, bessere Stabilität<br />◆ Geschirmte Schalenverpackung, nicht durch elektromagnetische Störungen der Umwelt beeinträchtigt<br /><span><strong>Anwendungsbereiche:</strong></span><br />Oberflächenwasser, kommunales Abwasser, Umweltüberwachung, industrielle Prozesskontrolle, Verschmutzungsquellen, industrielles Abwasser, Leitungswasser, Biopharmazeutika, Bier und Getränke, Erdöl und Petrochemie, Metallurgie<br /><strong><span>Technische Parameter:</span></strong><br />Messbereich: ± 1999mV; Temperatur:- 5-95℃<br />Auflösung: 0.1 mV, 0.1 ℃<br />Genauigkeit: ± 0,5 mV<br />Arbeitsumgebung: 0-95 ℃<br />Reaktionszeit: bis zu 95% in 30 Sekunden<br />Höchstdruck: 8,0bar<br />Maximale Strömungsgeschwindigkeit: 3 Meter pro Sekunde<br />Kalibrierungsmethode: Ein Punkt Probe, ein Punkt Standardlösung Kalibrierung<br />Temperaturelektrode: PT1000<br />Elektrodenform: digitale Elektrode<br />Referenzelektrode: PTFE poröse Salzbrücke Flüssigkeitsverbindung<br />Kommunikationsschnittstelle: ModbusRS485<br />Elektrodenmaterial: PEEK、Ryton<br />Gewindeschnittstelle: Front und Heck Standard 3/4NPT<br />Schutzniveau: IP68<br />Kabellänge: Standard 10m, ausziehbar<br />Elektrodengröße: 165mm bis 25mm\n    ","gallery",[],"features",[],"specificationGroups",[215],{"_165":216,"_217":218},"Technische Daten","specifications",[219,226,230,234,238,242,246,250,254,258,262,266,270,274,278,282,286],{"_220":221,"_108":222,"_223":224,"_225":-5},"key","measurement-range","Messbereich","value","± 1999mV; Temperatur:- 5-95℃","unit",{"_220":227,"_108":228,"_223":229,"_225":-5},"resolution","Auflösung","0.1 mV, 0.1 ℃",{"_220":231,"_108":232,"_223":233,"_225":-5},"accuracy","Genauigkeit","± 0,5 mV",{"_220":235,"_108":236,"_223":237,"_225":-5},"operating-temperature","Arbeitsumgebung","0-95 ℃",{"_220":239,"_108":240,"_223":241,"_225":-5},"response-time","Reaktionszeit","bis zu 95% in 30 Sekunden",{"_220":243,"_108":244,"_223":245,"_225":-5},"maximum-pressure","Höchstdruck","8,0bar",{"_220":247,"_108":248,"_223":249,"_225":-5},"maximum-flow","Maximale Strömungsgeschwindigkeit","3 Meter pro Sekunde",{"_220":251,"_108":252,"_223":253,"_225":-5},"calibration","Kalibrierungsmethode","Ein Punkt Probe, ein Punkt Standardlösung Kalibrierung",{"_220":255,"_108":256,"_223":257,"_225":-5},"temperature-electrode","Temperaturelektrode","PT1000",{"_220":259,"_108":260,"_223":261,"_225":-5},"electrode-form","Elektrodenform","digitale Elektrode",{"_220":263,"_108":264,"_223":265,"_225":-5},"reference-electrode","Referenzelektrode","PTFE poröse Salzbrücke Flüssigkeitsverbindung",{"_220":267,"_108":268,"_223":269,"_225":-5},"digital-communication","Kommunikationsschnittstelle","ModbusRS485",{"_220":271,"_108":272,"_223":273,"_225":-5},"electrode-material","Elektrodenmaterial","PEEK、Ryton",{"_220":275,"_108":276,"_223":277,"_225":-5},"thread","Gewindeschnittstelle","Front und Heck Standard 3/4NPT",{"_220":279,"_108":280,"_223":281,"_225":-5},"protection","Schutzniveau","IP68",{"_220":283,"_108":284,"_223":285,"_225":-5},"cable","Kabellänge","Standard 10m, ausziehbar",{"_220":287,"_108":288,"_223":289,"_225":-5},"electrode-size","Elektrodengröße","165mm bis 25mm","sourceReviews",[],"documents",[],"supportDownloads",[]]
