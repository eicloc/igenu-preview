[{"_1":2,"_7":8},"root",{"_3":4},"data",{"_5":6},"productView","grid","content",{"_3":9},{"_10":11,"_12":13,"_14":15,"_140":58,"_57":141,"_64":142,"_70":143,"_144":145,"_153":154,"_155":156,"_157":158,"_159":160},"locale","de","origin","https://eicloc.github.io","settings",{"_16":17,"_18":19,"_21":22,"_23":24,"_54":55,"_86":87,"_88":89,"_26":27,"_28":29,"_37":-5,"_90":91,"_92":-5,"_93":94,"_95":96,"_97":98,"_99":-5,"_100":101,"_136":-5,"_137":-5,"_138":139},"defaultLocale","en","enabledLocales",[17,20,11],"zh-CN","logoUrl","/igenu-preview/media/f607ce2a51366ba8778f1000.jpg","regionalContacts",[25,39,47],{"_26":27,"_28":29,"_30":31,"_35":36,"_37":38},"email","Germany@igenu.com","phone","0049-935890-024","labels",{"_11":32,"_17":33,"_20":34},"Deutschland","Germany","德国","region","GERMANY","address","",{"_26":40,"_28":41,"_30":42,"_35":46,"_37":38},"cn@igenu.com","400-002-1266",{"_11":43,"_17":44,"_20":45},"Servicezentrum China","China service center","中国服务中心","CHINA",{"_26":48,"_28":38,"_30":49,"_35":53,"_37":38},"info@igenu-germany.com",{"_11":50,"_17":51,"_20":52},"Internationale Anfragen","International enquiries","国际业务咨询","INTERNATIONAL","navigation",[56,63,69,75,81],{"_57":58,"_30":59},"slug","products",{"_11":60,"_17":61,"_20":62},"Instrumente","Instruments","产品中心",{"_57":64,"_30":65},"parameters",{"_11":66,"_17":67,"_20":68},"Messparameter","Parameters","测量参数",{"_57":70,"_30":71},"applications",{"_11":72,"_17":73,"_20":74},"Anwendungen","Applications","应用方案",{"_57":76,"_30":77},"about",{"_11":78,"_17":79,"_20":80},"Über IGENU","About IGENU","关于 IGENU",{"_57":82,"_30":83},"service",{"_11":84,"_17":84,"_20":85},"Support","服务支持","companyName","IGENU SCIENCE","tagline","Umwelt verstehen. Prozesse beherrschen.","footer","Messtechnik für Wasser, industrielle Prozesse und Gasdetektion. Entdecken Sie die Technik für Ihre nächste Messaufgabe.","copyright","primaryCta","Experten kontaktieren","primaryCtaUrl","/contact","socialLinks",{},"defaultSeoImageUrl","footerNavigation",[102,118],{"_103":104,"_105":106},"title","产品","links",[107,112,115],{"_108":109,"_110":111},"label","Wasseranalyse","href","/de/products?category=water",{"_108":113,"_110":114},"Industrielle Messung","/de/products?category=industrial",{"_108":116,"_110":117},"Gasdetektion","/de/products?category=gas",{"_103":119,"_105":120},"了解更多",[121,124,127,130,133],{"_108":122,"_110":123},"关于我们","/de/about",{"_108":125,"_110":126},"客户案例","/de/cases",{"_108":128,"_110":129},"新闻中心","/de/news",{"_108":131,"_110":132},"售后服务","/de/service",{"_108":134,"_110":135},"下载中心","/de/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig8300voc",[],[],"seo",{"_103":146,"_147":148,"_149":150,"_151":152},"IG8300VOC Onlinesystem zur Geruchs- und Gasüberwachung | IGENU SCIENCE","description","Das System überwacht konfigurierte geruchsrelevante Gase mit mehreren Sensoren, Probenvorbehandlung, Temperaturkompensation und automatischer Kalibrierung. Integrierte Anzeige, Datenspeicherung und Kommunikationsoptionen unterstützen die vernetzte Umweltüberwachung an Abwasseranlagen, Chemiestandorten und Abfallbehandlungsanlagen sowie die Anbindung an das Überwachungssystem.","imageUrl","/igenu-preview/media/97c97b1129c8237eb4b7d324.jpg","index",true,"canonical","https://eicloc.github.io/igenu-preview/de/products/ig8300voc","query",{},"selected",[],"detail",{"_161":162,"_57":141,"_163":164,"_165":166,"_167":148,"_168":169,"_170":171,"_175":176,"_199":200,"_201":202,"_147":-5,"_203":204,"_205":206,"_207":208,"_209":210,"_288":289,"_290":291,"_292":293,"_144":145},"id","0ebe2f55-73e5-48ce-b7d2-aab462d75429","model","IG8300VOC","name","IG8300VOC Onlinesystem zur Geruchs- und Gasüberwachung","shortDescription","featured",false,"category",{"_57":172,"_173":-5,"_165":116,"_147":-5,"_144":174},"gas","brand",{"_103":116,"_147":-5,"_149":-5,"_151":152},"heroImage",{"_161":177,"_140":178,"_179":180,"_181":182,"_183":184,"_185":186,"_187":188,"_189":190,"_191":150,"_192":193,"_194":195},"248b037a-97ca-43b1-abac-a26d2deaf089","IMAGE","originalName","2025040852682581.png","mimeType","image/jpeg","size",22439,"sha256","97c97b1129c8237eb4b7d324799035ec948f856036b41f67613d22e0171553b0","width",194,"height",421,"url","createdAt","2026-10-20T17:32:39.720Z","variants",[196],{"_187":188,"_189":190,"_181":197,"_191":198},"image/webp","/igenu-preview/media/51378fe539ff38c9e791e3c9.webp","detailLayout","STRUCTURED","availableLocales",[20,11,17],"bodyHtml","<p><strong><span>Produktmerkmale:</span></strong><br />◆ Annahme von hochpräzisen elektrochemischen Sensoren, mit zuverlässiger und stabiler Leistung<br />◆Ausgestattet mit unabhängigen Algorithmen, um genaue und zuverlässige Daten zu gewährleisten<br />◆Integriert in mehrere Vorbehandlungssysteme wie Staubentfernung, Wasserentfernung und Wärmeableitung, wodurch die Lebensdauer effektiv verlängert wird<br />◆Integrierte Temperaturausgleichstechnologie+automatische Kalibriertechnologie, intelligente Kalibrierung ohne manuellen Eingriff<br />◆ Integrierte GPRS-Kommunikationstechnologie, Echtzeit-Überwachungsdaten können mit der Plattform des Umweltschutzbüros verbunden werden<br />◆ Annahme eines 7-Zoll-industriellen Touchscreen-Displays und eines größeren Bildschirms für klarere Anzeige<br />◆ Eingebaute 16GB Speicherkarte, Daten können für 2-5 Jahre gespeichert werden<br />◆ Ausgestattet mit einem 32-Bit Hochgeschwindigkeits-Verarbeitungschip und automatischer Netzwerkfunktion für Ausschalten und Einschalten der Überwachung<br />◆Der Sensor verfügt über automatische Reinigung und intelligente Kalibrierfunktionen, mit 365- bis 24-Stunden-kontinuierlicher Überwachung ohne Druck<br />◆ Spezielles Aussehen Design, Anti-Interferenz<br /><strong><span>Anwendungsbereiche:</span></strong><br />Erdöl/Chemie, Industrielle Fertigung, Abwasserbehandlung, Druck, Müll, Aquakultur<br /><strong><span>Technische Parameter</span></strong><br />Gasdetektion: NH3、C9H9N、H2S、CH4S、C2SH6、C2H6S2、CS 2、C8H8、OU、VOC、T、H、PM2.5、PM10 <br />Messbereich: Geruch: 0-2000 NH3 C9H9N、H2S、CH4S、C2SH6、C2H6S2、CS 2、C8H8：0-100ppm,  Flüchtige Gase (VOC): 0-100ppm PM2.5, PM10: 0-1000ppb<br />Auflösung: 1OU; 0,01ppm,1ppb<br />Reaktionszeit: T90≤20s <br />Messgenauigkeit: ± 3%<br />Linearer Fehler: ≤ ±1% <br />Nulldrift: ≤ ± 1% (F.S/Jahr)<br />Erholungszeit: ≤ 20 Sekunden<br />Installationsmethoden: Typ der Säulenklemme, Typ der Wand montiert<br />Wiederholbarkeit: ≤ ±1% <br />Schutzniveau: IP65 <br />Temperatur und Feuchtigkeit: optionales Zubehör, Temperaturerkennungsbereich: -40~800 ℃, Feuchtigkeitserkennungsbereich: 0-100% RH<br />Alarmeinstellungen: Der Alarmwert kann beliebig eingestellt werden<br />Datenspeicherung: Standardkonfiguration umfasst die Speicherung von über 100000 Datenstücken, unterstützt SD-Karten mit großer Kapazität, kontinuierliche Datenspeicherung für mehr als ein Jahr und ermöglicht die freie Einstellung von Datenspeicherintervallen<br />Signalausgang: Unterstützt drahtlose oder verdrahtete Übertragungsmethoden wie RS485, GPRS, 433M, NBIOT, LoRa, etc.<br />Arbeitsumgebung: Arbeitstemperatur -30~50 ℃ (kundengebundenes oder optionales Vorbehandlungssystem erforderlich für Gebrauch in höheren Temperatur- und Feuchtigkeitsumgebungen) Arbeitsfeuchte: ≤ 95% RH, keine Kondensation<br />Arbeitsdruck: 0 ～ 100Kpa<br />Arbeitsstromversorgung: 220VAC<br /></p>\n    ","gallery",[],"features",[],"specificationGroups",[211],{"_165":212,"_213":214},"Technische Daten","specifications",[215,221,225,229,233,237,241,245,249,253,256,260,264,268,272,276,280,284],{"_216":217,"_108":116,"_218":219,"_220":-5},"key","gas-detection","value","NH3、C9H9N、H2S、CH4S、C2SH6、C2H6S2、CS 2、C8H8、OU、VOC、T、H、PM2.5、PM10","unit",{"_216":222,"_108":223,"_218":224,"_220":-5},"measurement-range","Messbereich","Geruch: 0-2000 NH3 C9H9N、H2S、CH4S、C2SH6、C2H6S2、CS 2、C8H8：0-100ppm,  Flüchtige Gase (VOC): 0-100ppm PM2.5, PM10: 0-1000ppb",{"_216":226,"_108":227,"_218":228,"_220":-5},"resolution","Auflösung","1OU; 0,01ppm,1ppb",{"_216":230,"_108":231,"_218":232,"_220":-5},"response-time","Reaktionszeit","T90≤20s",{"_216":234,"_108":235,"_218":236,"_220":-5},"accuracy","Messgenauigkeit","± 3%",{"_216":238,"_108":239,"_218":240,"_220":-5},"linearity","Linearer Fehler","≤ ±1%",{"_216":242,"_108":243,"_218":244,"_220":-5},"zero-drift","Nulldrift","≤ ± 1% (F.S/Jahr)",{"_216":246,"_108":247,"_218":248,"_220":-5},"recovery-time","Erholungszeit","≤ 20 Sekunden",{"_216":250,"_108":251,"_218":252,"_220":-5},"installation","Installationsmethoden","Typ der Säulenklemme, Typ der Wand montiert",{"_216":254,"_108":255,"_218":240,"_220":-5},"repeatability","Wiederholbarkeit",{"_216":257,"_108":258,"_218":259,"_220":-5},"protection","Schutzniveau","IP65",{"_216":261,"_108":262,"_218":263,"_220":-5},"temperature-humidity","Temperatur und Feuchtigkeit","optionales Zubehör, Temperaturerkennungsbereich: -40~800 ℃, Feuchtigkeitserkennungsbereich: 0-100% RH",{"_216":265,"_108":266,"_218":267,"_220":-5},"alarm-settings","Alarmeinstellungen","Der Alarmwert kann beliebig eingestellt werden",{"_216":269,"_108":270,"_218":271,"_220":-5},"data-storage","Datenspeicherung","Standardkonfiguration umfasst die Speicherung von über 100000 Datenstücken, unterstützt SD-Karten mit großer Kapazität, kontinuierliche Datenspeicherung für mehr als ein Jahr und ermöglicht die freie Einstellung von Datenspeicherintervallen",{"_216":273,"_108":274,"_218":275,"_220":-5},"output","Signalausgang","Unterstützt drahtlose oder verdrahtete Übertragungsmethoden wie RS485, GPRS, 433M, NBIOT, LoRa, etc.",{"_216":277,"_108":278,"_218":279,"_220":-5},"operating-temperature","Arbeitsumgebung","Arbeitstemperatur -30~50 ℃ (kundengebundenes oder optionales Vorbehandlungssystem erforderlich für Gebrauch in höheren Temperatur- und Feuchtigkeitsumgebungen) Arbeitsfeuchte: ≤ 95% RH, keine Kondensation",{"_216":281,"_108":282,"_218":283,"_220":-5},"pressure","Arbeitsdruck","0 ～ 100Kpa",{"_216":285,"_108":286,"_218":287,"_220":-5},"power-supply","Arbeitsstromversorgung","220VAC","sourceReviews",[],"documents",[],"supportDownloads",[]]
