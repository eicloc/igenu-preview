ion",[102,118],{"_103":104,"_105":106},"title","产品","links",[107,112,115],{"_108":109,"_110":111},"label","Wasseranalyse","href","/de/products?category=water",{"_108":113,"_110":114},"Industrielle Messung","/de/products?category=industrial",{"_108":116,"_110":117},"Gasdetektion","/de/products?category=gas",{"_103":119,"_105":120},"了解更多",[121,124,127,130,133],{"_108":122,"_110":123},"关于我们","/de/about",{"_108":125,"_110":126},"客户案例","/de/cases",{"_108":128,"_110":129},"新闻中心","/de/news",{"_108":131,"_110":132},"售后服务","/de/service",{"_108":134,"_110":135},"下载中心","/de/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig9600",[],[],"seo",{"_103":146,"_147":148,"_149":150,"_151":152},"IG9600 Ultraschall-Messgerät für Schlammgrenzschichten | IGENU SCIENCE","description","Die Auswertung von Ultraschallechos ermittelt die Schlammgrenzschicht in Absetz- und Eindickbecken. Getrennte Sonde, integrierte Temperaturkompensation und lokale Anzeige unterstützen die Überwachung in Abwasserbehandlung und Wasserwerks-Sedimentation; die Konfiguration wird an die jeweilige Installation vor Ort angepasst.","imageUrl","/igenu-preview/media/65b4e4d80f69906e1d7bb840.png","index",true,"canonical","https://eicloc.github.io/igenu-preview/de/products/ig9600","query",{},"selected",[],"detail",{"_161":162,"_57":141,"_163":164,"_165":166,"_167":148,"_168":169,"_170":171,"_175":176,"_217":218,"_219":220,"_147":-5,"_221":222,"_223":224,"_225":226,"_227":228,"_308":309,"_310":311,"_312":313,"_144":145},"id","12c35e01-af3a-4ad0-b514-1b67363212af","model","IG9600","name","IG9600 Ultraschall-Messgerät für Schlammgrenzschichten","shortDescription","featured",false,"category",{"_57":172,"_173":-5,"_165":113,"_147":-5,"_144":174},"industrial","brand",{"_103":113,"_147":-5,"_149":-5,"_151":152},"heroImage",{"_161":177,"_140":178,"_179":180,"_181":182,"_183":184,"_185":186,"_187":188,"_189":190,"_191":150,"_192":193,"_194":195},"fe68277b-0e41-4c1a-b0a4-8bfebd654caa","IMAGE","originalName","2025040854938433.png","mimeType","image/png","size",549953,"sha256","65b4e4d80f69906e1d7bb840b3735e20c7fa903b831162b2a977ae41ff5f77d9","width",2064,"height",1704,"url","createdAt","2026-10-20T17:32:39.735Z","variants",[196,201,205,209,213],{"_187":197,"_189":198,"_181":199,"_191":200},320,264,"image/webp","/igenu-preview/media/2dc78a489616479a5aadfbac.webp",{"_187":202,"_189":203,"_181":199,"_191":204},640,528,"/igenu-preview/media/aae51fe4186be6ad1749b345.webp",{"_187":206,"_189":207,"_181":199,"_191":208},960,793,"/igenu-preview/media/50b869a018e4f784a789e882.webp",{"_187":210,"_189":211,"_181":199,"_191":212},1280,1057,"/igenu-preview/media/44748a134c7000c8efd4c395.webp",{"_187":214,"_189":215,"_181":199,"_191":216},1600,1321,"/igenu-preview/media/8ef2f704c499019d37e0855c.webp","detailLayout","STRUCTURED","availableLocales",[20,11,17],"bodyHtml","<strong><span>Produktmerkmale:</span></strong><br />◆ Split-Typ, passend für verschiedene Vor-Ort-Installationsanforderungen<br />◆Der Host hat eine chinesische und englische Bedienoberfläche, die Funktionen wie Mehrpunktmessung und Alarm erreichen kann<br />◆ Einfach zu bedienen, zuverlässige Ergebnisse, Schnittstellenbetriebsanweisungen können Betriebsfehler reduzieren<br />◆Das Sondenmaterial ist in POM-, PVDF-, PTFE-Optionen erhältlich, geeignet für verschiedene Arbeitsbedingungen<br />◆ Intern integrierter Temperatursensor, fähig zur Echtzeit-Temperaturkompensation für Schallgeschwindigkeit<br /><span><strong>Anwendungsbereiche:</strong></span><br />In Situationen, in denen es eine Fest-Flüssig-Grenzfläche gibt, die Schlammgehalte in den primären und sekundären Sedimentationstanks von Kläranlagen, Schlammkonzentrationstanks und Sedimentationstanks von Kläranlagen<br /><span><strong>Technische Parameter:</strong></span><br />Messbereich: 0.2~10/15/20m<br />Auflösung:&lt; 0.04m<br />Genauigkeit: 0,1m ± 0,05m<br />Reaktionszeit: 10-900s (einstellbar)<br />Kalibrierung: Es muss nur einmal beim Einschalten des Geräts durchgeführt werden<br />Automatischer Druckbereich: ≤ 0,3bar<br />Umgebungstemperatur: 0-50 ℃<br />Temperaturkompensation: automatische Kompensation<br />Schutzniveau: IP68 <br />Durchflussmenge: ≤ 3m/s<br />Größe: 140mm × 195mm (H × D)<br />Gewicht: Ungefähr 3,5Kg<br />Wartung: Regelmäßig&lt;1 Stunde/Monat<br />Kabellänge: 10m, verlängert um mindestens 100m<br />Ausgang: 2-Kanal 0/4-20mA, Last 750 Ω<br />Alarm: Mehrwegerelais, 220VAC/2A 485<br />Signal: Modbus-Protokoll (optional)<br />Prozesstemperatur: Sender: -30 ℃~80 ℃; Sensor:- 40℃~80℃ <br />Schutzstufe: Sender: IP65； Sender: IP68 <br />Stromversorgung: DC18-36V； AC90-260V\n    ","gallery",[],"features",[],"specificationGroups",[229],{"_165":230,"_231":232},"Technische Daten","specifications",[233,240,244,248,252,256,260,264,268,272,276,280,284,288,292,296,300,304],{"_234":235,"_108":236,"_237":238,"_239":-5},"key","measurement-range","Messbereich","value","0.2~10/15/20m","unit",{"_234":241,"_108":242,"_237":243,"_239":-5},"resolution","Auflösung","< 0.04m",{"_234":245,"_108":246,"_237":247,"_239":-5},"accuracy","Genauigkeit","0,1m ± 0,05m",{"_234":249,"_108":250,"_237":251,"_239":-5},"response-time","Reaktionszeit","10-900s (einstellbar)",{"_234":253,"_108":254,"_237":255,"_239":-5},"calibration","Kalibrierung","Es muss nur einmal beim Einschalten des Geräts durchgeführt werden",{"_234":257,"_108":258,"_237":259,"_239":-5},"automatic-pressure-range","Automatischer Druckbereich","≤ 0,3bar",{"_234":261,"_108":262,"_237":263,"_239":-5},"operating-temperature","Umgebungstemperatur","0-50 ℃",{"_234":265,"_108":266,"_237":267,"_239":-5},"temperature-compensation","Temperaturkompensation","automatische Kompensation",{"_234":269,"_108":270,"_237":271,"_239":-5},"protection","Schutzniveau","IP68; Sender: IP65； Sender: IP68",{"_234":273,"_108":274,"_237":275,"_239":-5},"flow-requirement","Durchflussmenge","≤ 3m/s",{"_234":277,"_108":278,"_237":279,"_239":-5},"dimensions","Größe","140mm × 195mm (H × D)",{"_234":281,"_108":282,"_237":283,"_239":-5},"weight","Gewicht","Ungefähr 3,5Kg",{"_234":285,"_108":286,"_237":287,"_239":-5},"maintenance","Wartung","Regelmäßig<1 Stunde/Monat",{"_234":289,"_108":290,"_237":291,"_239":-5},"cable","Kabellänge","10m, verlängert um mindestens 100m",{"_234":293,"_108":294,"_237":295,"_239":-5},"output","Ausgang","2-Kanal 0/4-20mA, Last 750 Ω; Modbus-Protokoll (optional)",{"_234":297,"_108":298,"_237":299,"_239":-5},"alarm","Alarm","Mehrwegerelais, 220VAC/2A 485",{"_234":301,"_108":302,"_237":303,"_239":-5},"process-temperature","Prozesstemperatur","Sender: -30 ℃~80 ℃; Sensor:- 40℃~80℃",{"_234":305,"_108":306,"_237":307,"_239":-5},"power-supply","Stromversorgung","DC18-36V； AC90-260V","sourceReviews",[],"documents",[],"supportDownloads",[]]
