ion",[102,118],{"_103":104,"_105":106},"title","产品","links",[107,112,115],{"_108":109,"_110":111},"label","Wasseranalyse","href","/de/products?category=water",{"_108":113,"_110":114},"Industrielle Messung","/de/products?category=industrial",{"_108":116,"_110":117},"Gasdetektion","/de/products?category=gas",{"_103":119,"_105":120},"了解更多",[121,124,127,130,133],{"_108":122,"_110":123},"关于我们","/de/about",{"_108":125,"_110":126},"客户案例","/de/cases",{"_108":128,"_110":129},"新闻中心","/de/news",{"_108":131,"_110":132},"售后服务","/de/service",{"_108":134,"_110":135},"下载中心","/de/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig9400",[],[],"seo",{"_103":146,"_147":148,"_149":150,"_151":152},"IG9400 Ultraschall-Durchflussmesser für offene Gerinne | IGENU SCIENCE","description","Die berührungslose Ultraschall-Pegelmessung berechnet den Durchfluss an konfigurierten Messwehren und Messrinnen. Eine getrennte Sonde mit Anzeigeeinheit liefert Momentan- und Summenwerte für Anwendungen wie Abwassereinleitungen, Bewässerung und kommunale Wasserbauanlagen an den jeweils eingerichteten Messstellen vor Ort.","imageUrl","/igenu-preview/media/96effce7a54b18259f3ac6a1.png","index",true,"canonical","https://eicloc.github.io/igenu-preview/de/products/ig9400","query",{},"selected",[],"detail",{"_161":162,"_57":141,"_163":164,"_165":166,"_167":148,"_168":169,"_170":171,"_175":176,"_217":218,"_219":220,"_147":-5,"_221":222,"_223":224,"_225":226,"_227":228,"_284":285,"_305":306,"_307":308,"_144":145},"id","eb107e4e-e537-4104-aea5-d30cd2f70c8a","model","IG9400","name","IG9400 Ultraschall-Durchflussmesser für offene Gerinne","shortDescription","featured",false,"category",{"_57":172,"_173":-5,"_165":113,"_147":-5,"_144":174},"industrial","brand",{"_103":113,"_147":-5,"_149":-5,"_151":152},"heroImage",{"_161":177,"_140":178,"_179":180,"_181":182,"_183":184,"_185":186,"_187":188,"_189":190,"_191":150,"_192":193,"_194":195},"c09dd052-6bcc-434a-9386-7136b00ba170","IMAGE","originalName","2025040854281913.png","mimeType","image/png","size",544222,"sha256","96effce7a54b18259f3ac6a19a290f71d4f862b45801327c466bd60032c71808","width",1809,"height",1449,"url","createdAt","2026-10-20T17:32:39.727Z","variants",[196,201,205,209,213],{"_187":197,"_189":198,"_181":199,"_191":200},320,256,"image/webp","/igenu-preview/media/f7db19bc9da969b069506228.webp",{"_187":202,"_189":203,"_181":199,"_191":204},640,513,"/igenu-preview/media/9e26d52402655e540b305fd0.webp",{"_187":206,"_189":207,"_181":199,"_191":208},960,769,"/igenu-preview/media/1e64887f2c4083e3b4c84b69.webp",{"_187":210,"_189":211,"_181":199,"_191":212},1280,1025,"/igenu-preview/media/a853495b9ddf518f0be39552.webp",{"_187":214,"_189":215,"_181":199,"_191":216},1600,1282,"/igenu-preview/media/f0f509b5abc23cc9078dfaf4.webp","detailLayout","STRUCTURED","availableLocales",[20,11,17],"bodyHtml","<strong><span>Produktmerkmale:</span></strong><br />◆ Split-Typ, passend für verschiedene Vor-Ort-Installationsanforderungen<br />◆ Automatische Anpassung der Übertragungsleistung basierend auf Durchflussrate, erweiterte digitale Modellberechnung, Anti-Interferenz-Design<br />◆ Einfach zu bedienen, zuverlässige Ergebnisse, Schnittstellenbetriebsanweisungen können Betriebsfehler reduzieren<br />◆ Das Sondenmaterial ist in POM, PVDF und PTFE verfügbar, passend für verschiedene Arbeitsbedingungen<br />◆ Intern integrierter Temperatursensor, fähig zur Echtzeit-Temperaturkompensation für Schallgeschwindigkeit<br /><span><strong>Anwendungsbereiche:</strong></span><br />Abwasserablauf, Bewässerung landwirtschaftlicher Flächen, kommunales Abwasser, Wasserschutztechnik<br /><span><strong>Technische Parameter:</strong></span><br />Höhe des Flüssigkeitsstands: ≤ 5m<br />Momentaner Durchfluss: bestimmt durch die Art und Spezifikationen des verwendeten Messwehrbehälters<br />Kumulierter Verkehr: 0-99999999m ³<br />Auflösung: 0.001m ³/h<br />Genauigkeit: 2%<br />Toter Winkel: 0,3m<br />Anzeigemodus: LCD-Anzeige<br />Startwinkel: 6 °~10 °<br />Schutzstufe: Schutzstufe: Sender: IP65； Sender: IP68<br />Stromversorgung: DC18-36V； AC90-260V<br />Signal: 4-20mA, RS485 (optional)<br />Alarm: Mehrwegrelais\n    ","gallery",[],"features",[],"specificationGroups",[229],{"_165":230,"_231":232},"Technische Daten","specifications",[233,240,244,248,252,256,260,264,268,272,276,280],{"_234":235,"_108":236,"_237":238,"_239":-5},"key","liquid-level-height","Höhe des Flüssigkeitsstands","value","≤ 5m","unit",{"_234":241,"_108":242,"_237":243,"_239":-5},"instantaneous-flow","Momentaner Durchfluss","bestimmt durch die Art und Spezifikationen des verwendeten Messwehrbehälters",{"_234":245,"_108":246,"_237":247,"_239":-5},"accumulated-flow","Kumulierter Verkehr","0-99999999m ³",{"_234":249,"_108":250,"_237":251,"_239":-5},"resolution","Auflösung","0.001m ³/h",{"_234":253,"_108":254,"_237":255,"_239":-5},"accuracy","Genauigkeit","2%",{"_234":257,"_108":258,"_237":259,"_239":-5},"blind-zone","Toter Winkel","0,3m",{"_234":261,"_108":262,"_237":263,"_239":-5},"display","Anzeigemodus","LCD-Anzeige",{"_234":265,"_108":266,"_237":267,"_239":-5},"launch-angle","Startwinkel","6 °~10 °",{"_234":269,"_108":270,"_237":271,"_239":-5},"protection","Schutzstufe","Schutzstufe: Sender: IP65； Sender: IP68",{"_234":273,"_108":274,"_237":275,"_239":-5},"power-supply","Stromversorgung","DC18-36V； AC90-260V",{"_234":277,"_108":278,"_237":279,"_239":-5},"output","Signal","4-20mA, RS485 (optional)",{"_234":281,"_108":282,"_237":283,"_239":-5},"alarm","Alarm","Mehrwegrelais","sourceReviews",[286],{"_234":245,"_140":287,"_288":289,"_290":291,"_292":293},"conflict","note","原站三语资料存在差异；保留各语言原值，等待品牌方确认。","status","pending","sources",[294,299,303],{"_108":295,"_237":296,"_10":17,"_297":298},"Accumulated traffic","0-99999999999m ³","sourceUrl","http://www.igenu.com/proshow_15.html",{"_108":300,"_237":301,"_10":20,"_297":302},"累积流量","0-999999999m³","http://www.igenu.com/cn/proshow_26.html",{"_108":246,"_237":247,"_10":11,"_297":304},"http://www.i