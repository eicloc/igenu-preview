ion",[102,118],{"_103":104,"_105":106},"title","产品","links",[107,112,115],{"_108":109,"_110":111},"label","Wasseranalyse","href","/de/products?category=water",{"_108":113,"_110":114},"Industrielle Messung","/de/products?category=industrial",{"_108":116,"_110":117},"Gasdetektion","/de/products?category=gas",{"_103":119,"_105":120},"了解更多",[121,124,127,130,133],{"_108":122,"_110":123},"关于我们","/de/about",{"_108":125,"_110":126},"客户案例","/de/cases",{"_108":128,"_110":129},"新闻中心","/de/news",{"_108":131,"_110":132},"售后服务","/de/service",{"_108":134,"_110":135},"下载中心","/de/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig5500",[],[],"seo",{"_103":146,"_147":148,"_149":150,"_151":152},"IG5500 Druckmessumformer | IGENU SCIENCE","description","Ein Silizium-Messelement mit Signalaufbereitung erfasst den Druck kompatibler Gase und Flüssigkeiten. Kompakte Bauform, wählbare Ausgänge und Prozessanschlüsse unterstützen den Einbau in Wasseraufbereitung, Hydraulikanlagen und industrielle Prozessregelung; die Ausführung wird passend zur vorgesehenen Messstelle ausgewählt.","imageUrl","/igenu-preview/media/c746becf8db6677ba7f20c1b.png","index",true,"canonical","https://eicloc.github.io/igenu-preview/de/products/ig5500","query",{},"selected",[],"detail",{"_161":162,"_57":141,"_163":164,"_165":166,"_167":148,"_168":169,"_170":171,"_175":176,"_207":208,"_209":210,"_147":-5,"_211":212,"_213":214,"_215":216,"_217":218,"_286":287,"_288":289,"_290":291,"_144":145},"id","d5c3a293-847d-45eb-8e36-aa2ac3fc2463","model","IG5500","name","IG5500 Druckmessumformer","shortDescription","featured",false,"category",{"_57":172,"_173":-5,"_165":113,"_147":-5,"_144":174},"industrial","brand",{"_103":113,"_147":-5,"_149":-5,"_151":152},"heroImage",{"_161":177,"_140":178,"_179":180,"_181":182,"_183":184,"_185":186,"_187":188,"_189":190,"_191":150,"_192":193,"_194":195},"33d41440-c759-49f8-90bd-34b6cd5f235a","IMAGE","originalName","2025040851699125.png","mimeType","image/png","size",328593,"sha256","c746becf8db6677ba7f20c1ba57229696ee47b035e9b8e09a92e661b92d3b81c","width",894,"height",591,"url","createdAt","2026-10-20T17:32:39.705Z","variants",[196,201,205],{"_187":197,"_189":198,"_181":199,"_191":200},320,212,"image/webp","/igenu-preview/media/742e701732a18bc68d06d2a3.webp",{"_187":202,"_189":203,"_181":199,"_191":204},640,423,"/igenu-preview/media/bcb0d54fc977c2edfe25d6f5.webp",{"_187":188,"_189":190,"_181":199,"_191":206},"/igenu-preview/media/6dcb50f0f86d2a52dccece3c.webp","detailLayout","STRUCTURED","availableLocales",[20,11,17],"bodyHtml","<strong><span>Produktmerkmale:</span></strong><br />◆Weit verbreitete Medien, können Öl, Wasser, Paste usw. mit bestimmter Korrosionsschutzfähigkeit messen<br />◆Gute Linearität, hohe Genauigkeit, hohe Stabilität, lange Lebensdauer<br />◆ Kleine Größe, geringes Gewicht, einfach zu installieren<br />◆ Breite Palette, korrosionsbeständig, geeignet für verschiedene Medien<br /><strong><span>Anwendungsbereiche:</span></strong><br />Wasseranlagen, Kläranlagen, Petrochemie, industrielle Prozesse<br /><span><strong>Technische Parameter:</strong></span><br />Messmedium: Gas, Flüssigkeit, Öl usw.<br />Messform und Messbereich: Messdruck (G Bs max (0-60) MPa, Minimum (0-0.5) Kpa<br />Absolutdruck (A,max (0-40) MPa, Minimum (0-5) KPa<br />Unterdruck (B) - (-0.1~40) MPa, Minimum (-0.2~0.2) KPa<br />Umgebungstemperatur:- 10~65℃ <br />Luftfeuchtigkeit: 5-100% relative Luftfeuchtigkeit<br />Genauigkeitsstufe: 0,1%<br />Überlastbarkeit: 2-5-fache Reichweite<br />Langzeitstabilität: weniger als 0,2% FS/60 Monate<br />Stromversorgung: 24VDC<br />Ausgangssignal: (4-20) mA (Zwei-/Drei-Draht-System) (optionaler HART-Protokollausgang) （0～10/20）mA<br />（0～5）V、（1～5）V、（0～10）V、 (Optional) RS485<br />Anzeigemodus: Digitalanzeige<br />Messrate: 0,2S<br />Arbeitstemperatur:- 40～80℃<br />Ausgleichstemperatur:- 20～70 ℃<br />Prozessanschluss: M20 × 1,5 Außengewinde (Ø 3 Innenloch), oder vom Benutzer spezifiziert<br />Schutzniveau: IP67<br />Elektromagnetische Kompatibilität: HF-Schutz entspricht EN61326\n    ","gallery",[],"features",[],"specificationGroups",[219],{"_165":220,"_221":222},"Technische Daten","specifications",[223,230,234,238,242,246,250,254,258,262,266,270,274,278,282],{"_224":225,"_108":226,"_227":228,"_229":-5},"key","medium","Messmedium","value","Gas, Flüssigkeit, Öl usw.","unit",{"_224":231,"_108":232,"_227":233,"_229":-5},"measurement-form","Messform und Messbereich","Messdruck (G Bs max (0-60) MPa, Minimum (0-0.5) Kpa",{"_224":235,"_108":236,"_227":237,"_229":-5},"operating-temperature","Umgebungstemperatur","- 10~65℃; - 40～80℃",{"_224":239,"_108":240,"_227":241,"_229":-5},"operating-humidity","Luftfeuchtigkeit","5-100% relative Luftfeuchtigkeit",{"_224":243,"_108":244,"_227":245,"_229":-5},"accuracy","Genauigkeitsstufe","0,1%",{"_224":247,"_108":248,"_227":249,"_229":-5},"overload-capacity","Überlastbarkeit","2-5-fache Reichweite",{"_224":251,"_108":252,"_227":253,"_229":-5},"long-term-stability","Langzeitstabilität","weniger als 0,2% FS/60 Monate",{"_224":255,"_108":256,"_227":257,"_229":-5},"power-supply","Stromversorgung","24VDC",{"_224":259,"_108":260,"_227":261,"_229":-5},"output","Ausgangssignal","(4-20) mA (Zwei-/Drei-Draht-System) (optionaler HART-Protokollausgang) （0～10/20）mA",{"_224":263,"_108":264,"_227":265,"_229":-5},"display","Anzeigemodus","Digitalanzeige",{"_224":267,"_108":268,"_227":269,"_229":-5},"measurement-rate","Messrate","0,2S",{"_224":271,"_108":272,"_227":273,"_229":-5},"compensation-temperature","Ausgleichstemperatur","- 20～70 ℃",{"_224":275,"_108":276,"_227":277,"_229":-5},"process-connection","Prozessanschluss","M20 × 1,5 Außengewinde (Ø 3 Innenloch), oder vom Benutzer spezifiziert",{"_224":279,"_108":280,"_227":281,"_229":-5},"protection","Schutzniveau","IP67",{"_224":283,"_108":284,"_227":285,"_229":-5},"emc","Elektromagnetische Kompatibilität","HF-Schutz entspricht EN61326","sourceReviews",[],"documents",[],"supportDownloads",[]]
