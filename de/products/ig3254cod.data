ion",[102,118],{"_103":104,"_105":106},"title","产品","links",[107,112,115],{"_108":109,"_110":111},"label","Wasseranalyse","href","/de/products?category=water",{"_108":113,"_110":114},"Industrielle Messung","/de/products?category=industrial",{"_108":116,"_110":117},"Gasdetektion","/de/products?category=gas",{"_103":119,"_105":120},"了解更多",[121,124,127,130,133],{"_108":122,"_110":123},"关于我们","/de/about",{"_108":125,"_110":126},"客户案例","/de/cases",{"_108":128,"_110":129},"新闻中心","/de/news",{"_108":131,"_110":132},"售后服务","/de/service",{"_108":134,"_110":135},"下载中心","/de/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig3254cod",[],[],"seo",{"_103":146,"_147":148,"_149":150,"_151":152},"IG3254COD UV-Sensor für CSB und TOC | IGENU SCIENCE","description","Die UV-Absorptionsmessung unterstützt die Onlinebestimmung von CSB und TOC ohne Reagenziendosierung. Trübungskompensation, Kalibrieroptionen und eine verfügbare automatische Reinigung passen die digitale Sonde an die Wasserüberwachung an; Ergebnisse werden entsprechend der gewählten Kalibrierung und Messkonfiguration interpretiert.","imageUrl","/igenu-preview/media/e3e2c21db606165f614650cf.jpg","index",true,"canonical","https://eicloc.github.io/igenu-preview/de/products/ig3254cod","query",{},"selected",[],"detail",{"_161":162,"_57":141,"_163":164,"_165":166,"_167":148,"_168":169,"_170":171,"_175":176,"_201":202,"_203":204,"_147":-5,"_205":206,"_207":208,"_209":210,"_211":212,"_296":297,"_298":299,"_300":301,"_144":145},"id","dfbb0b65-0921-4d76-820c-bc18ebd08c71","model","IG3254COD","name","IG3254COD UV-Sensor für CSB und TOC","shortDescription","featured",false,"category",{"_57":172,"_173":-5,"_165":109,"_147":-5,"_144":174},"water","brand",{"_103":109,"_147":-5,"_149":-5,"_151":152},"heroImage",{"_161":177,"_140":178,"_179":180,"_181":182,"_183":184,"_185":186,"_187":188,"_189":188,"_190":150,"_191":192,"_193":194},"79d9f104-d914-4e36-bec2-d6d2b843fefd","IMAGE","originalName","2025041051182309.jpg","mimeType","image/jpeg","size",14215,"sha256","e3e2c21db606165f614650cf931244737a0e84793f3dd9ab8bd834db8aa5b8b3","width",540,"height","url","createdAt","2026-10-20T17:32:39.888Z","variants",[195,199],{"_187":196,"_189":196,"_181":197,"_190":198},320,"image/webp","/igenu-preview/media/087409fcbd7eefe1aec06c53.webp",{"_187":188,"_189":188,"_181":197,"_190":200},"/igenu-preview/media/6d889354b11ab94fb489a773.webp","detailLayout","STRUCTURED","availableLocales",[20,11,17],"bodyHtml","<span><strong>Produktmerkmale:</strong></span><br />◆ Digitaler Sensor, 485 Ausgang, unterstützt Modbus RTU<br />◆ Kein Bedarf für Reagenzien, keine Verschmutzung, wirtschaftlicher und umweltfreundlicher<br />◆ Optionales automatisches Reinigungsgerät kann Oberflächenkontamination von Sensoren effektiv entfernen, mikrobielles Wachstum verhindern und genauere und niedrigere Wartung erreichen<br />◆ Messbare SAC COD、TOC、 Trübung, Temperatur und andere Parameter<br />◆ Kompensiert automatisch Trübungs- und Schwebstoffinterferenzen mit ausgezeichneter Testleistung<br /><span><strong>Anwendungsbereiche:</strong></span><br />Kommunale Abwässer, Industrieabwässer, Umweltüberwachung, Trink- und Oberflächenwasserüberwachung, industrielle Prozesse, Aquakultur, biologische Prozesse<br /><span><strong>Technische Parameter:</strong></span><br />Bereich: CSB (kalibriert mit KHP): 0~500mg/L,0-1500 mg/L CSB<br />TOC (kalibriert mit KHP): 0~180mg/L TOC ,0~600 mg/L TOC<br />Messprinzip: 254nm ultraviolettes Absorptionsspektrum<br />Lichtquelle: blinkende Xenon-Lampe<br />Optische Weglänge: 2,5mm, 6,5mm<br />Messgenauigkeit: ± 5% des Messwertes<br />Wiederholbarkeit: weniger als ± 5%<br />Nachweisgrenze: 0,1 mg/L<br />Messintervalle: 15s, 30s, 1min, 30min<br />Kalibrierungsmethoden: Einzelpunkt-Probenkalibrierung, Mehrpunkt-Standardlösung-Kalibrierung, Hangkalibrierung<br />Sensormaterial: Gehäuse: SUS316L； Fenster: Saphir<br />Selbstreinigung: automatische Kratzbürste<br />Kreuzempfindlichkeitskompensation: Trübung<br />Sensorkommunikation: MODBUS RS-485 <br />Lagertemperatur:- 10~50℃ <br />Arbeitstemperatur: 0~50 ℃ (nicht frierend)<br />Schutzniveau: IP68 <br />Kabellänge: Standard 10m, ausziehbar<br />Sensorgröße: 179mm*50mm\n    ","gallery",[],"features",[],"specificationGroups",[213],{"_165":214,"_215":216},"Technische Daten","specifications",[217,224,228,232,236,240,244,248,252,256,260,264,268,272,276,280,284,288,292],{"_218":219,"_108":220,"_221":222,"_223":-5},"key","measurement-range","Bereich","value","CSB (kalibriert mit KHP): 0~500mg/L,0-1500 mg/L CSB","unit",{"_218":225,"_108":226,"_221":227,"_223":-5},"toc","TOC (kalibriert mit KHP)","0~180mg/L TOC ,0~600 mg/L TOC",{"_218":229,"_108":230,"_221":231,"_223":-5},"measurement-principle","Messprinzip","254nm ultraviolettes Absorptionsspektrum",{"_218":233,"_108":234,"_221":235,"_223":-5},"light-source","Lichtquelle","blinkende Xenon-Lampe",{"_218":237,"_108":238,"_221":239,"_223":-5},"optical-path","Optische Weglänge","2,5mm, 6,5mm",{"_218":241,"_108":242,"_221":243,"_223":-5},"accuracy","Messgenauigkeit","± 5% des Messwertes",{"_218":245,"_108":246,"_221":247,"_223":-5},"repeatability","Wiederholbarkeit","weniger als ± 5%",{"_218":249,"_108":250,"_221":251,"_223":-5},"detection-limit","Nachweisgrenze","0,1 mg/L",{"_218":253,"_108":254,"_221":255,"_223":-5},"measurement-interval","Messintervalle","15s, 30s, 1min, 30min",{"_218":257,"_108":258,"_221":259,"_223":-5},"calibration","Kalibrierungsmethoden","Einzelpunkt-Probenkalibrierung, Mehrpunkt-Standardlösung-Kalibrierung, Hangkalibrierung",{"_218":261,"_108":262,"_221":263,"_223":-5},"sensor-material","Sensormaterial","Gehäuse: SUS316L； Fenster: Saphir",{"_218":265,"_108":266,"_221":267,"_223":-5},"self-cleaning","Selbstreinigung","automatische Kratzbürste",{"_218":269,"_108":270,"_221":271,"_223":-5},"cross-sensitivity-compensation","Kreuzempfindlichkeitskompensation","Trübung",{"_218":273,"_108":274,"_221":275,"_223":-5},"digital-communication","Sensorkommunikation","MODBUS RS-485",{"_218":277,"_108":278,"_221":279,"_223":-5},"storage-temperature","Lagertemperatur","- 10~50℃",{"_218":281,"_108":282,"_221":283,"_223":-5},"operating-temperature","Arbeitstemperatur","0~50 ℃ (nicht frierend)",{"_218":285,"_108":286,"_221":287,"_223":-5},"protection","Schutzniveau","IP68",{"_218":289,"_108":290,"_221":291,"_223":-5},"cable","Kabellänge","Standard 10m, ausziehbar",{"_218":293,"_108":294,"_221":295,"_223":-5},"sensor-size","Sensorgröße","179mm*50mm","sourceReviews",[],"documents",[],"supportDownloads",[]]
