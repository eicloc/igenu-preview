[{"_1":2,"_7":8},"root",{"_3":4},"data",{"_5":6},"productView","grid","content",{"_3":9},{"_10":11,"_12":13,"_14":15,"_140":58,"_57":141,"_64":142,"_70":143,"_144":145,"_153":154,"_155":156,"_157":158,"_159":160},"locale","de","origin","https://eicloc.github.io","settings",{"_16":17,"_18":19,"_21":22,"_23":24,"_54":55,"_86":87,"_88":89,"_26":27,"_28":29,"_37":-5,"_90":91,"_92":-5,"_93":94,"_95":96,"_97":98,"_99":-5,"_100":101,"_136":-5,"_137":-5,"_138":139},"defaultLocale","en","enabledLocales",[17,20,11],"zh-CN","logoUrl","/igenu-preview/media/f607ce2a51366ba8778f1000.jpg","regionalContacts",[25,39,47],{"_26":27,"_28":29,"_30":31,"_35":36,"_37":38},"email","Germany@igenu.com","phone","0049-935890-024","labels",{"_11":32,"_17":33,"_20":34},"Deutschland","Germany","德国","region","GERMANY","address","",{"_26":40,"_28":41,"_30":42,"_35":46,"_37":38},"cn@igenu.com","400-002-1266",{"_11":43,"_17":44,"_20":45},"Servicezentrum China","China service center","中国服务中心","CHINA",{"_26":48,"_28":38,"_30":49,"_35":53,"_37":38},"info@igenu-germany.com",{"_11":50,"_17":51,"_20":52},"Internationale Anfragen","International enquiries","国际业务咨询","INTERNATIONAL","navigation",[56,63,69,75,81],{"_57":58,"_30":59},"slug","products",{"_11":60,"_17":61,"_20":62},"Instrumente","Instruments","产品中心",{"_57":64,"_30":65},"parameters",{"_11":66,"_17":67,"_20":68},"Messparameter","Parameters","测量参数",{"_57":70,"_30":71},"applications",{"_11":72,"_17":73,"_20":74},"Anwendungen","Applications","应用方案",{"_57":76,"_30":77},"about",{"_11":78,"_17":79,"_20":80},"Über IGENU","About IGENU","关于 IGENU",{"_57":82,"_30":83},"service",{"_11":84,"_17":84,"_20":85},"Support","服务支持","companyName","IGENU SCIENCE","tagline","Umwelt verstehen. Prozesse beherrschen.","footer","Messtechnik für Wasser, industrielle Prozesse und Gasdetektion. Entdecken Sie die Technik für Ihre nächste Messaufgabe.","copyright","primaryCta","Experten kontaktieren","primaryCtaUrl","/contact","socialLinks",{},"defaultSeoImageUrl","footerNavigation",[102,118],{"_103":104,"_105":106},"title","产品","links",[107,112,115],{"_108":109,"_110":111},"label","Wasseranalyse","href","/de/products?category=water",{"_108":113,"_110":114},"Industrielle Messung","/de/products?category=industrial",{"_108":116,"_110":117},"Gasdetektion","/de/products?category=gas",{"_103":119,"_105":120},"了解更多",[121,124,127,130,133],{"_108":122,"_110":123},"关于我们","/de/about",{"_108":125,"_110":126},"客户案例","/de/cases",{"_108":128,"_110":129},"新闻中心","/de/news",{"_108":131,"_110":132},"售后服务","/de/service",{"_108":134,"_110":135},"下载中心","/de/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig3500an",[],[],"seo",{"_103":146,"_147":148,"_149":150,"_151":152},"IG3500AN Analysator für Ammoniak- und Ammoniumstickstoff | IGENU SCIENCE","description","Die Salicylat-Photometrie bestimmt Ammoniak- und Ammoniumstickstoff im Wasser. Automatische Bereichsumschaltung, Qualitätskontrollen und Betriebsprotokolle unterstützen den Onlinebetrieb; Alarmfunktionen und elektrische Kommunikationsschnittstellen ermöglichen die Einbindung in Systeme für Trinkwasser, Umweltüberwachung und Abwasser sowie die Übertragung von Messwerten.","imageUrl","/igenu-preview/media/076a24550dfec7d99b95ba88.png","index",true,"canonical","https://eicloc.github.io/igenu-preview/de/products/ig3500an","query",{},"selected",[],"detail",{"_161":162,"_57":141,"_163":164,"_165":166,"_167":148,"_168":169,"_170":171,"_175":176,"_199":200,"_201":202,"_147":-5,"_203":204,"_205":206,"_207":208,"_209":210,"_285":286,"_287":288,"_289":290,"_144":145},"id","db61c5f5-bfca-49a7-a45f-f4768be3a5dc","model","IG3500AN","name","IG3500AN Analysator für Ammoniak- und Ammoniumstickstoff","shortDescription","featured",false,"category",{"_57":172,"_173":-5,"_165":109,"_147":-5,"_144":174},"water","brand",{"_103":109,"_147":-5,"_149":-5,"_151":152},"heroImage",{"_161":177,"_140":178,"_179":180,"_181":182,"_183":184,"_185":186,"_187":188,"_189":190,"_191":150,"_192":193,"_194":195},"bfda7f5e-e504-4c40-85f0-1afea6d4aba3","IMAGE","originalName","2025040938476253.jpg","mimeType","image/png","size",51146,"sha256","076a24550dfec7d99b95ba8827dbead49c4506dc3d55d9d8b47b0c95d2a2c36e","width",267,"height",435,"url","createdAt","2026-10-20T17:32:39.824Z","variants",[196],{"_187":188,"_189":190,"_181":197,"_191":198},"image/webp","/igenu-preview/media/f3d468788765b050ceafe139.webp","detailLayout","STRUCTURED","availableLocales",[20,11,17],"bodyHtml","<strong><span>Produktmerkmale:</span></strong><br />◆Hochbereichsmessung niedriger Konzentration: Verwendung von Ringproben zur Reduzierung der Verdünnungszeiten und zur Verbesserung der Wiederholbarkeit. Die neue Akzeptanznorm verlangt, dass der Instrumentenbereich 2-3-mal so hoch ist wie die Emissionsnorm, aber die tatsächliche Konzentration der abgegebenen Wasserprobe ist sehr gering.<br />◆Innovatives Messverfahren (Patent) (1) mit automatischer Kompensationsfunktion gegen Trübungsstörungen, die keine Messfehler beim Sammeln von Trübungswasserproben verursacht; (2) mit Blasenabscheidefunktion, die einen signifikanten Einfluss auf Abwasser mit Blasen hat, wie Photovoltaikanlagen, Druck- und Färbeanlagen usw.<br />◆ Automatische Bereichsschaltfunktion: Wählen Sie eine beliebige Kombination aus niedrigem und hohem Bereich, und das Instrument schaltet automatisch in den optimalen Bereich basierend auf der tatsächlichen Wasserprobenkonzentration<br />◆ Mehrfache Qualitätskontrollfunktionen: Nullpunkt/Spanne/Standardprobenprüfung, Leerprüfung, reservierte parallele Probe und spitze Wiederherstellungsschnittstelle<br />◆Mehrere Messmodi, Schlüsselparameteranzeige, Betrieb, Verifizierung, Kalibrierprotokolle, obere und untere Grenzwertwarnung<br />◆ Power on Self-Test, automatisches Zurücksetzen, Flüssigkeitsmangel Alarm, Power-Off Schutz, Abfallflüssigkeitstrennung<br />◆ Unterstützt 2-Kanal RS232/485, 2-Kanal 4-20mA Kommunikationsschnittstellen und Echtzeit-Datendruck für Drucker<br />◆ (Optional) Cloud-Überwachungsfunktion: Echtzeitüberwachung des Gerätestatus auf Mobiltelefonen, Fernalarm, Fernfehlerdiagnose<br />◆ (Optional) Reagenzkühlung: Ausgestattet mit einem Reagenzkühlkasten, um die Reagenzgarantiezeit zu verlängern<br /><strong><span>Anwendungsbereiche:</span></strong><br />Oberflächenwasser, Grundwasser, Leitungswasser, Trinkwasser, kommunales Abwasser, industrielles Abwasser<br /><strong><span>Technische Parameter:</span></strong><br />Erkennungsbereich: 0.01~2mg/L; 0.05~10mg/L; 0,5~100mg/L<br />Messprinzip: Salicylsäurespektrophometrisches Verfahren<br />Genauigkeit: 0.01~2mg/L: ± 0,02 mg/L oder Wert 2%; 0.05~10mg/L: ± 0,05 mg/L oder 3% Ablesung; 0.5~100mg/L: ± 0.2 mg/L oder 3% Lesen<br />Wiederholbarkeit: ≤ 2%<br />Nulldrift: ± 5%<br />Entfernungsdift: ± 5%<br />Datenspeicherung: ≥ 48000 Datensätze<br />Umweltanforderungen: Temperatur+5-28° C: Luftfeuchtigkeit&lt;90%<br />Messzyklus: 20~50min<br />MTBF: ≥ 720h/Zeit<br />Kommunikationsschnittstelle: 4-20mA RS232、RS485 <br />Isolationsimpedanz: über 2M Ω<br />Stromversorgung: AC ( 220+20 ) V ( 50+0.5 ) Hz ，5A <br />Stromverbrauch: 150W<br />Quantitative Untergrenze: ≤ 0,02mg/L<br />Mindestnachweisgrenze: 0,01mg/L<br />Größe: 500mm, 445mm bis 1355mm\n    ","gallery",[],"features",[],"specificationGroups",[211],{"_165":212,"_213":214},"Technische Daten","specifications",[215,222,226,230,234,238,241,245,249,253,257,261,265,269,273,277,281],{"_216":217,"_108":218,"_219":220,"_221":-5},"key","measurement-range","Erkennungsbereich","value","0.01~2mg/L; 0.05~10mg/L; 0,5~100mg/L","unit",{"_216":223,"_108":224,"_219":225,"_221":-5},"measurement-principle","Messprinzip","Salicylsäurespektrophometrisches Verfahren",{"_216":227,"_108":228,"_219":229,"_221":-5},"accuracy","Genauigkeit","0.01~2mg/L: ± 0,02 mg/L oder Wert 2%; 0.05~10mg/L: ± 0,05 mg/L oder 3% Ablesung; 0.5~100mg/L: ± 0.2 mg/L oder 3% Lesen",{"_216":231,"_108":232,"_219":233,"_221":-5},"repeatability","Wiederholbarkeit","≤ 2%",{"_216":235,"_108":236,"_219":237,"_221":-5},"zero-drift","Nulldrift","± 5%",{"_216":239,"_108":240,"_219":237,"_221":-5},"range-drift","Entfernungsdift",{"_216":242,"_108":243,"_219":244,"_221":-5},"data-storage","Datenspeicherung","≥ 48000 Datensätze",{"_216":246,"_108":247,"_219":248,"_221":-5},"environment-requirements","Umweltanforderungen","Temperatur+5-28° C: Luftfeuchtigkeit<90%",{"_216":250,"_108":251,"_219":252,"_221":-5},"measurement-cycle","Messzyklus","20~50min",{"_216":254,"_108":255,"_219":256,"_221":-5},"mtbf","MTBF","≥ 720h/Zeit",{"_216":258,"_108":259,"_219":260,"_221":-5},"digital-communication","Kommunikationsschnittstelle","4-20mA RS232、RS485",{"_216":262,"_108":263,"_219":264,"_221":-5},"insulation","Isolationsimpedanz","über 2M Ω",{"_216":266,"_108":267,"_219":268,"_221":-5},"power-supply","Stromversorgung","AC ( 220+20 ) V ( 50+0.5 ) Hz ，5A",{"_216":270,"_108":271,"_219":272,"_221":-5},"power-consumption","Stromverbrauch","150W",{"_216":274,"_108":275,"_219":276,"_221":-5},"quantitative-limit","Quantitative Untergrenze","≤ 0,02mg/L",{"_216":278,"_108":279,"_219":280,"_221":-5},"detection-limit","Mindestnachweisgrenze","0,01mg/L",{"_216":282,"_108":283,"_219":284,"_221":-5},"dimensions","Größe","500mm, 445mm bis 1355mm","sourceReviews",[],"documents",[],"supportDownloads",[]]
