ion",[102,118],{"_103":104,"_105":106},"title","产品","links",[107,112,115],{"_108":109,"_110":111},"label","Wasseranalyse","href","/de/products?category=water",{"_108":113,"_110":114},"Industrielle Messung","/de/products?category=industrial",{"_108":116,"_110":117},"Gasdetektion","/de/products?category=gas",{"_103":119,"_105":120},"了解更多",[121,124,127,130,133],{"_108":122,"_110":123},"关于我们","/de/about",{"_108":125,"_110":126},"客户案例","/de/cases",{"_108":128,"_110":129},"新闻中心","/de/news",{"_108":131,"_110":132},"售后服务","/de/service",{"_108":134,"_110":135},"下载中心","/de/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig30ol",[],[],"seo",{"_103":146,"_147":148,"_149":150,"_151":152},"IG30OL Öl-in-Wasser-Sensor | IGENU SCIENCE","description","UV-Fluoreszenz erfasst Öl im Wasser, beispielsweise in petrochemischem Abwasser und bei der Überwachung von Reinjektionswasser in Ölfeldern. Optische Filterung und eine Selbstreinigung begrenzen Störeinflüsse und Ablagerungen; digitale Kommunikation verbindet die Sonde mit dem Überwachungssystem.","imageUrl","/igenu-preview/media/e3e2c21db606165f614650cf.jpg","index",true,"canonical","https://eicloc.github.io/igenu-preview/de/products/ig30ol","query",{},"selected",[],"detail",{"_161":162,"_57":141,"_163":164,"_165":166,"_167":148,"_168":169,"_170":171,"_175":176,"_201":202,"_203":204,"_147":-5,"_205":206,"_207":208,"_209":210,"_211":212,"_276":277,"_278":279,"_280":281,"_144":145},"id","32049077-055b-4d74-8a27-aac11e6dcee3","model","IG30OL","name","IG30OL Öl-in-Wasser-Sensor","shortDescription","featured",false,"category",{"_57":172,"_173":-5,"_165":109,"_147":-5,"_144":174},"water","brand",{"_103":109,"_147":-5,"_149":-5,"_151":152},"heroImage",{"_161":177,"_140":178,"_179":180,"_181":182,"_183":184,"_185":186,"_187":188,"_189":188,"_190":150,"_191":192,"_193":194},"79d9f104-d914-4e36-bec2-d6d2b843fefd","IMAGE","originalName","2025041051182309.jpg","mimeType","image/jpeg","size",14215,"sha256","e3e2c21db606165f614650cf931244737a0e84793f3dd9ab8bd834db8aa5b8b3","width",540,"height","url","createdAt","2026-10-20T17:32:39.888Z","variants",[195,199],{"_187":196,"_189":196,"_181":197,"_190":198},320,"image/webp","/igenu-preview/media/087409fcbd7eefe1aec06c53.webp",{"_187":188,"_189":188,"_181":197,"_190":200},"/igenu-preview/media/6d889354b11ab94fb489a773.webp","detailLayout","STRUCTURED","availableLocales",[20,11,17],"bodyHtml","<span><strong>Produktmerkmale:</strong></span><br />◆Das Prinzip der ultravioletten Fluoreszenzmethode zur Messung von Öl in Wasser hat eine hohe Genauigkeit und ausgezeichnete Korrelation mit Infrarot-Methode<br />◆ Annahme der korrosionsbeständigen Hülle der Titanlegierung; NPT3/4 Gewindeschnittstelle für einfache Installation<br />◆ Mit Selbstreinigungsfunktion entfernen Sie Anbauteile von Wasserproben, wartungsfrei<br />◆ Annahme einzigartiger optischer und elektronischer Filtertechnologie, um den Einfluss von Umgebungslicht auf die Messung zu beseitigen<br />◆ Nicht beeinflusst durch Schwebeteilchen im Wasser<br /><span><strong>Anwendungsbereiche:</strong></span><br />Standardableitung von Erdöl- und petrochemischem Abwasser, Ölgehaltskontrolle von Ölfeld-Reinjektionswasser, Einlassschutz der Kesselergänzende Umkehrosmosemembran und Abwasserbehandlung<br /><span><strong>Technische Parameter:</strong></span><br />Messbereich: 0-10mg/L, 0-100mg/L, 0-1000mg/L<br />Messprinzip: UV-Fluoreszenzmethode<br />Messgenauigkeit: ± 3% des Messwertes<br />Wiederholbarkeit: weniger als ± 3%<br />Nachweisgrenze: 0,1 mg/L<br />Reaktionszeit: 4 Sekunden<br />Kalibriermethode: Einzelpunktkalibrierung<br />Wasserprobenanforderung: Durchfluss: 0-3m/s; Druck: 0-100psi; 0-6bar; Temperatur: 0-50 ℃<br />Kommunikationsschnittstelle: ModbusRS485<br />Gewindeschnittstelle: Standard 3/4NPT<br />Schutzniveau: IP68<br />Installationsmethoden: Tauchart, Zirkulationsart<br />Kabellänge: Standard 10m, ausziehbar<br />Elektrodengröße: 176mm bis 22mm\n    ","gallery",[],"features",[],"specificationGroups",[213],{"_165":214,"_215":216},"Technische Daten","specifications",[217,224,228,232,236,240,244,248,252,256,260,264,268,272],{"_218":219,"_108":220,"_221":222,"_223":-5},"key","measurement-range","Messbereich","value","0-10mg/L, 0-100mg/L, 0-1000mg/L","unit",{"_218":225,"_108":226,"_221":227,"_223":-5},"measurement-principle","Messprinzip","UV-Fluoreszenzmethode",{"_218":229,"_108":230,"_221":231,"_223":-5},"accuracy","Messgenauigkeit","± 3% des Messwertes",{"_218":233,"_108":234,"_221":235,"_223":-5},"repeatability","Wiederholbarkeit","weniger als ± 3%",{"_218":237,"_108":238,"_221":239,"_223":-5},"detection-limit","Nachweisgrenze","0,1 mg/L",{"_218":241,"_108":242,"_221":243,"_223":-5},"response-time","Reaktionszeit","4 Sekunden",{"_218":245,"_108":246,"_221":247,"_223":-5},"calibration","Kalibriermethode","Einzelpunktkalibrierung",{"_218":249,"_108":250,"_221":251,"_223":-5},"water-sample","Wasserprobenanforderung","Durchfluss: 0-3m/s; Druck: 0-100psi; 0-6bar; Temperatur: 0-50 ℃",{"_218":253,"_108":254,"_221":255,"_223":-5},"digital-communication","Kommunikationsschnittstelle","ModbusRS485",{"_218":257,"_108":258,"_221":259,"_223":-5},"thread","Gewindeschnittstelle","Standard 3/4NPT",{"_218":261,"_108":262,"_221":263,"_223":-5},"protection","Schutzniveau","IP68",{"_218":265,"_108":266,"_221":267,"_223":-5},"installation","Installationsmethoden","Tauchart, Zirkulationsart",{"_218":269,"_108":270,"_221":271,"_223":-5},"cable","Kabellänge","Standard 10m, ausziehbar",{"_218":273,"_108":274,"_221":275,"_223":-5},"electrode-size","Elektrodengröße","176mm bis 22mm","sourceReviews",[],"documents",[],"supportDownloads",[]]
