ion",[102,118],{"_103":104,"_105":106},"title","产品","links",[107,112,115],{"_108":109,"_110":111},"label","Wasseranalyse","href","/de/products?category=water",{"_108":113,"_110":114},"Industrielle Messung","/de/products?category=industrial",{"_108":116,"_110":117},"Gasdetektion","/de/products?category=gas",{"_103":119,"_105":120},"了解更多",[121,124,127,130,133],{"_108":122,"_110":123},"关于我们","/de/about",{"_108":125,"_110":126},"客户案例","/de/cases",{"_108":128,"_110":129},"新闻中心","/de/news",{"_108":131,"_110":132},"售后服务","/de/service",{"_108":134,"_110":135},"下载中心","/de/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig3000",[],[],"seo",{"_103":146,"_147":148,"_149":150,"_151":152},"IG3000 Display Mehrkanalregler | IGENU SCIENCE","description","Der Mehrkanalregler verbindet kompatible digitale und analoge Wassersensoren mit einer gemeinsamen Anzeige und Menüführung. Konfigurierbare Ausgänge, Relais und Kommunikationsoptionen unterstützen die Prozessanbindung; eine Haltefunktion für Ausgangssignale erleichtert Arbeiten während der Wartung angeschlossener Sensoren.","imageUrl","/igenu-preview/media/8032374cce79b2ec8e8e37dc.png","index",true,"canonical","https://eicloc.github.io/igenu-preview/de/products/ig3000","query",{},"selected",[],"detail",{"_161":162,"_57":141,"_163":164,"_165":166,"_167":148,"_168":152,"_169":170,"_174":175,"_209":210,"_211":212,"_147":-5,"_213":214,"_215":216,"_217":218,"_219":220,"_307":308,"_309":310,"_311":312,"_144":145},"id","da285210-11c2-4983-81be-86274bcf1ca2","model","IG3000","name","IG3000 Display Mehrkanalregler","shortDescription","featured","category",{"_57":171,"_172":-5,"_165":109,"_147":-5,"_144":173},"water","brand",{"_103":109,"_147":-5,"_149":-5,"_151":152},"heroImage",{"_161":176,"_140":177,"_178":179,"_180":181,"_182":183,"_184":185,"_186":187,"_188":189,"_190":150,"_191":192,"_193":194},"d84d4b36-8577-47f5-a6b1-91a7ae3a7c9f","IMAGE","originalName","2025040855746689.png","mimeType","image/png","size",749999,"sha256","8032374cce79b2ec8e8e37dca3798c3058050655937edfc7f06654e8d4ff5b9e","width",1280,"height",1706,"url","createdAt","2026-10-20T17:32:39.748Z","variants",[195,200,204,207],{"_186":196,"_188":197,"_180":198,"_190":199},320,427,"image/webp","/igenu-preview/media/c82ee037d25142ee99b2efed.webp",{"_186":201,"_188":202,"_180":198,"_190":203},640,853,"/igenu-preview/media/8aafd5be554a54bb0699b6bf.webp",{"_186":205,"_188":187,"_180":198,"_190":206},960,"/igenu-preview/media/4a8ece2b232c4eb15009de8a.webp",{"_186":187,"_188":189,"_180":198,"_190":208},"/igenu-preview/media/288701302fcf6e887f187cad.webp","detailLayout","STRUCTURED","availableLocales",[20,11,17],"bodyHtml","<span><strong>Produktmerkmale:</strong></span><br />◆ Starke Kompatibilität, in der Lage, digitale und analoge Sensoren von Igno Firma anzuschließen<br />◆90.70 große Bildschirm LED Anzeige, benutzerfreundliche Schnittstelle<br />◆Große UV-beständige und korrosionsbeständige PS-Schale, geeignet für verschiedene raue Arbeitsbedingungen.<br />◆4-20mA Ausgang mit Steuerfunktion, fähig zur PID-Steuerung externer Geräte<br />◆ Optionale Mehrfachrelais, Modbus RTU, DeviceNet, Modbus RS232, CANopen, EthermetIP, Modbus TCP, TCP/IP Kommunikation, etc., können verschiedene Vor-Ort-Anforderungen erfüllen<br />◆ Mehrkanalregler, fähig, einen oder mehrere Sensoren anzuschließen<br />◆ Output Hold Funktion, bequem für Sensorwartung<br />◆Schutzart IP66, CE-Zertifizierung.<br /><span><strong>Anwendungsbereiche:</strong></span><br />Oberflächenwasser, kommunales Abwasser, Umweltüberwachung, industrielles Prozesswasser, Verschmutzungsquellen, Abwasser, intelligentes Wassermanagement<br /><span><strong>Technische Parameter:</strong></span><br />Display: Hochauflösender vollfarbiger großer Bildschirm LED-Anzeigebildschirm<br />Betriebsmodus: Navigation im Tastenmenü<br />Bedienoberfläche: Chinesisch/Englisch<br />Anzahl der Kanäle: 1-8<br />Unterstützende Parameter: PH、ORP、 Trübung, Restchlor, Leitfähigkeit, gelöster Sauerstoff, Blaualgen, Chlorophyll, Farbigkeit, Transparenz UVCOD、 Ammoniakstickstoff, Schlammkonzentration, Schwebstoffe, Nitratstickstoff usw.<br />Einheiten: pH, mV, mg/L, us/cm, cm, ppb, ppm, ℃,% NTU und andere<br />Stütztemperatursensoren: PT100、PT1000、NTC10/30K<br />Interne Stromversorgung: 5V/12V/24V<br />Relais: 1-4 Kanäle 220VAC 3A, programmierbar<br />Analogausgang: optionale 2-8 4-20mA Ausgänge<br />Digitale Kommunikation: ModbusRS485、DeviceNet、ModbusRS232、CANopen、EthermetIP、ModbusTCP,TCP/IP，Profibus<br />Output Hold Funktion: Ja<br />Größe: 200mm, 200mm, 70mm<br />Installationsmethode: Wandmontage<br />Schalenmaterial: Poly+PS<br />Arbeitsumfeld:- 10~50℃<br />Schutzart: Entsprechend IP66 NEMA 4X<br />Elektrische Schnittstelle: M16*1.5<br />Stromversorgung: 100~240VAC, 50/60Hz<br />Zertifizierung: EMV: CE-Zertifizierung, elektromagnetische und Strahlungsemissionen entsprechen EN 50081-2, Anti-Interferenz entspricht EN 61000-6-2\n    ","gallery",[],"features",[],"specificationGroups",[221],{"_165":222,"_223":224},"Technische Daten","specifications",[225,232,236,240,244,247,251,255,259,263,267,271,275,279,283,287,291,295,299,303],{"_226":227,"_108":228,"_229":230,"_231":-5},"key","display","Display","value","Hochauflösender vollfarbiger großer Bildschirm LED-Anzeigebildschirm","unit",{"_226":233,"_108":234,"_229":235,"_231":-5},"operation","Betriebsmodus","Navigation im Tastenmenü",{"_226":237,"_108":238,"_229":239,"_231":-5},"interface-language","Bedienoberfläche","Chinesisch/Englisch",{"_226":241,"_108":242,"_229":243,"_231":-5},"channels","Anzahl der Kanäle","1-8",{"_226":64,"_108":245,"_229":246,"_231":-5},"Unterstützende Parameter","PH、ORP、 Trübung, Restchlor, Leitfähigkeit, gelöster Sauerstoff, Blaualgen, Chlorophyll, Farbigkeit, Transparenz UVCOD、 Ammoniakstickstoff, Schlammkonzentration, Schwebstoffe, Nitratstickstoff usw.",{"_226":248,"_108":249,"_229":250,"_231":-5},"units","Einheiten","pH, mV, mg/L, us/cm, cm, ppb, ppm, ℃,% NTU und andere",{"_226":252,"_108":253,"_229":254,"_231":-5},"temperature-sensors","Stütztemperatursensoren","PT100、PT1000、NTC10/30K",{"_226":256,"_108":257,"_229":258,"_231":-5},"internal-power","Interne Stromversorgung","5V/12V/24V",{"_226":260,"_108":261,"_229":262,"_231":-5},"relay","Relais","1-4 Kanäle 220VAC 3A, programmierbar",{"_226":264,"_108":265,"_229":266,"_231":-5},"analog-output","Analogausgang","optionale 2-8 4-20mA Ausgänge",{"_226":268,"_108":269,"_229":270,"_231":-5},"digital-communication","Digitale Kommunikation","ModbusRS485、DeviceNet、ModbusRS232、CANopen、EthermetIP、ModbusTCP,TCP/IP，Profibus",{"_226":272,"_108":273,"_229":274,"_231":-5},"output-hold","Output Hold Funktion","Ja",{"_226":276,"_108":277,"_229":278,"_231":-5},"dimensions","Größe","200mm, 200mm, 70mm",{"_226":280,"_108":281,"_229":282,"_231":-5},"installation","Installationsmethode","Wandmontage",{"_226":284,"_108":285,"_229":286,"_231":-5},"material","Schalenmaterial","Poly+PS",{"_226":288,"_108":289,"_229":290,"_231":-5},"operating-temperature","Arbeitsumfeld","- 10~50℃",{"_226":292,"_108":293,"_229":294,"_231":-5},"protection","Schutzart","Entsprechend IP66 NEMA 4X",{"_226":296,"_108":297,"_229":298,"_231":-5},"connection","Elektrische Schnittstelle","M16*1.5",{"_226":300,"_108":301,"_229":302,"_231":-5},"power-supply","Stromversorgung","100~240VAC, 50/60Hz",{"_226":304,"_108":305,"_229":306,"_231":-5},"certification","Zertifizierung","EMV: CE-Zertifizierung, elektromagnetische und Strahlungsemissionen entsprechen EN 50081-2, Anti-Interferenz entspricht EN 61000-6-2","sourceReviews",[],"documents",[],"supportDownloads",[]]
