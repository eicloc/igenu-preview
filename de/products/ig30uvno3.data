ion",[102,118],{"_103":104,"_105":106},"title","产品","links",[107,112,115],{"_108":109,"_110":111},"label","Wasseranalyse","href","/de/products?category=water",{"_108":113,"_110":114},"Industrielle Messung","/de/products?category=industrial",{"_108":116,"_110":117},"Gasdetektion","/de/products?category=gas",{"_103":119,"_105":120},"了解更多",[121,124,127,130,133],{"_108":122,"_110":123},"关于我们","/de/about",{"_108":125,"_110":126},"客户案例","/de/cases",{"_108":128,"_110":129},"新闻中心","/de/news",{"_108":131,"_110":132},"售后服务","/de/service",{"_108":134,"_110":135},"下载中心","/de/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig30uvno3",[],[],"seo",{"_103":146,"_147":148,"_149":150,"_151":152},"IG30UVNO3 UV-Sensor für Nitratstickstoff | IGENU SCIENCE","description","Die UV-Absorptionsmessung erfasst Nitratstickstoff direkt im Wasser, ohne chemische Reagenzien oder separates Probenahmesystem. Wählbare optische Weglängen, Störgrößenkompensation und automatische Reinigung unterstützen den Onlineeinsatz in Trinkwasser, Umweltüberwachung und Abwasserbehandlung sowie die Anpassung an den Messpunkt.","imageUrl","/igenu-preview/media/82c04b6460e5738541de5cfe.jpg","index",true,"canonical","https://eicloc.github.io/igenu-preview/de/products/ig30uvno3","query",{},"selected",[],"detail",{"_161":162,"_57":141,"_163":164,"_165":166,"_167":148,"_168":152,"_169":170,"_174":175,"_198":199,"_200":201,"_147":-5,"_202":203,"_204":205,"_206":207,"_208":209,"_289":290,"_291":292,"_293":294,"_144":145},"id","a5b76360-49f2-40e8-aeb2-c79f30115f7c","model","IG30UVNO3","name","IG30UVNO3 UV-Sensor für Nitratstickstoff","shortDescription","featured","category",{"_57":171,"_172":-5,"_165":109,"_147":-5,"_144":173},"water","brand",{"_103":109,"_147":-5,"_149":-5,"_151":152},"heroImage",{"_161":176,"_140":177,"_178":179,"_180":181,"_182":183,"_184":185,"_186":187,"_188":189,"_190":150,"_191":192,"_193":194},"79581a81-10c6-426b-80fa-28e7baf03c33","IMAGE","originalName","2025040861391349.png","mimeType","image/jpeg","size",16873,"sha256","82c04b6460e5738541de5cfefb589dc0c6890e78350a89fe4e1a3b1a0828a745","width",263,"height",348,"url","createdAt","2026-10-20T17:32:39.799Z","variants",[195],{"_186":187,"_188":189,"_180":196,"_190":197},"image/webp","/igenu-preview/media/5668d414b7362883ab524969.webp","detailLayout","STRUCTURED","availableLocales",[20,11,17],"bodyHtml","<strong><span>Produktmerkmale:</span></strong><br />◆Präzise UV-Absorptionstechnologie: sorgt für hohe Präzision bei der Detektion<br />◆ Flexible optische Pfadauswahl: Bietet verschiedene optische Pfadauswahlen (1mm, 2mm, 5mm), um verschiedene Überwachungsbedarfe zu erfüllen<br />◆ Sonde direkte Immersionsmessung, keine Probenahme und Vorverarbeitung erforderlich<br />◆ Kein Bedarf für chemische Reagenzien, keine sekundäre Verschmutzung<br />◆ Kurze Ansprechzeit, fähig zur kontinuierlichen Messung<br />◆ Kein Bedarf, den Membrankopf und den Elektrolyt zu ersetzen<br />◆Der Sensor verfügt über eine automatische Reinigungsfunktion, die den Wartungsaufwand reduzieren kann<br /><strong><span>Anwendungsbereiche:</span></strong><br />Umweltüberwachung, Trink- und Oberflächenwasserüberwachung, Industrieabwasser, Abwasser, häusliches Abwasser, Abwasser, Grundwasser, Seewasser<br /><strong><span>Technische Parameter:</span></strong><br />Bereich: 0~40mg/L, 0~100mg/L<br />Messprinzip: UV-Absorptionsspektroskopie<br />Lichtquelle: blinkende Xenon-Lampe<br />Optische Weglänge: 1mm, 2mm, 5mm<br />Messgenauigkeit: ± 0,1 mg/L oder ± 3% des Messwertes<br />Wiederholbarkeit: weniger als ± 3%<br />Nachweisgrenze: 0,02 mg/L<br />Messintervalle: 15s, 30s, 1min, 30min<br />Kalibrierungsmethoden: Einzelpunkt-Probenkalibrierung, Mehrpunkt-Standardlösung-Kalibrierung, Hangkalibrierung<br />Sensormaterial: Gehäuse: SUS316L； Fenster: Saphir<br />Selbstreinigung: automatische Kratzbürste<br />Kompensation der Kreuzempfindlichkeit: Trübung, feste Partikel, organische Stoffe<br />Sensorkommunikation: MODBUS RS-485 <br />Lagertemperatur:- 10~50℃ <br />Arbeitstemperatur: 0~45 ℃ (nicht frierend)<br />Schutzniveau: IP68 <br />Kabellänge: Standard 10m, ausziehbar<br />Sensorgröße: 365mm*70mm\n    ","gallery",[],"features",[],"specificationGroups",[210],{"_165":211,"_212":213},"Technische Daten","specifications",[214,221,225,229,233,237,241,245,249,253,257,261,265,269,273,277,281,285],{"_215":216,"_108":217,"_218":219,"_220":-5},"key","measurement-range","Bereich","value","0~40mg/L, 0~100mg/L","unit",{"_215":222,"_108":223,"_218":224,"_220":-5},"measurement-principle","Messprinzip","UV-Absorptionsspektroskopie",{"_215":226,"_108":227,"_218":228,"_220":-5},"light-source","Lichtquelle","blinkende Xenon-Lampe",{"_215":230,"_108":231,"_218":232,"_220":-5},"optical-path","Optische Weglänge","1mm, 2mm, 5mm",{"_215":234,"_108":235,"_218":236,"_220":-5},"accuracy","Messgenauigkeit","± 0,1 mg/L oder ± 3% des Messwertes",{"_215":238,"_108":239,"_218":240,"_220":-5},"repeatability","Wiederholbarkeit","weniger als ± 3%",{"_215":242,"_108":243,"_218":244,"_220":-5},"detection-limit","Nachweisgrenze","0,02 mg/L",{"_215":246,"_108":247,"_218":248,"_220":-5},"measurement-interval","Messintervalle","15s, 30s, 1min, 30min",{"_215":250,"_108":251,"_218":252,"_220":-5},"calibration","Kalibrierungsmethoden","Einzelpunkt-Probenkalibrierung, Mehrpunkt-Standardlösung-Kalibrierung, Hangkalibrierung",{"_215":254,"_108":255,"_218":256,"_220":-5},"sensor-material","Sensormaterial","Gehäuse: SUS316L； Fenster: Saphir",{"_215":258,"_108":259,"_218":260,"_220":-5},"self-cleaning","Selbstreinigung","automatische Kratzbürste",{"_215":262,"_108":263,"_218":264,"_220":-5},"cross-sensitivity-compensation","Kompensation der Kreuzempfindlichkeit","Trübung, feste Partikel, organische Stoffe",{"_215":266,"_108":267,"_218":268,"_220":-5},"digital-communication","Sensorkommunikation","MODBUS RS-485",{"_215":270,"_108":271,"_218":272,"_220":-5},"storage-temperature","Lagertemperatur","- 10~50℃",{"_215":274,"_108":275,"_218":276,"_220":-5},"operating-temperature","Arbeitstemperatur","0~45 ℃ (nicht frierend)",{"_215":278,"_108":279,"_218":280,"_220":-5},"protection","Schutzniveau","IP68",{"_215":282,"_108":283,"_218":284,"_220":-5},"cable","Kabellänge","Standard 10m, ausziehbar",{"_215":286,"_108":287,"_218":288,"_220":-5},"sensor-size","Sensorgröße","365mm*70mm","sourceReviews",[],"documents",[],"supportDownloads",[]]
