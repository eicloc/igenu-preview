ion",[102,118],{"_103":104,"_105":106},"title","产品","links",[107,112,115],{"_108":109,"_110":111},"label","Wasseranalyse","href","/de/products?category=water",{"_108":113,"_110":114},"Industrielle Messung","/de/products?category=industrial",{"_108":116,"_110":117},"Gasdetektion","/de/products?category=gas",{"_103":119,"_105":120},"了解更多",[121,124,127,130,133],{"_108":122,"_110":123},"关于我们","/de/about",{"_108":125,"_110":126},"客户案例","/de/cases",{"_108":128,"_110":129},"新闻中心","/de/news",{"_108":131,"_110":132},"售后服务","/de/service",{"_108":134,"_110":135},"下载中心","/de/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig3500",[],[],"seo",{"_103":146,"_147":148,"_149":150,"_151":152},"IG3500 Restchloranalysator | IGENU SCIENCE","description","Der Analysator bestimmt Restchlor im Wasser mittels DPD-Kolorimetrie für Versorgungs- und Prozessanwendungen. Optische Störgrößenkompensation, automatische Reinigung und Datenspeicherung werden durch Relaisausgänge zur Steuerungsanbindung sowie ein optionales Kommunikationsmodul für die Fernübertragung der Messwerte ergänzt.","imageUrl","/igenu-preview/media/8851b0c528aa8f3f11bac4d5.png","index",true,"canonical","https://eicloc.github.io/igenu-preview/de/products/ig3500","query",{},"selected",[],"detail",{"_161":162,"_57":141,"_163":164,"_165":166,"_167":148,"_168":169,"_170":171,"_175":176,"_203":204,"_205":206,"_147":-5,"_207":208,"_209":210,"_211":212,"_213":214,"_310":311,"_312":313,"_314":315,"_144":145},"id","caa08499-feb7-4ba5-a00f-5383e3318a7b","model","IG3500","name","IG3500 Restchloranalysator","shortDescription","featured",false,"category",{"_57":172,"_173":-5,"_165":109,"_147":-5,"_144":174},"water","brand",{"_103":109,"_147":-5,"_149":-5,"_151":152},"heroImage",{"_161":177,"_140":178,"_179":180,"_181":182,"_183":184,"_185":186,"_187":188,"_189":190,"_191":150,"_192":193,"_194":195},"c50c4c9d-55bb-4423-8c3e-781ffff460bb","IMAGE","originalName","2025040937453857.jpg","mimeType","image/png","size",161037,"sha256","8851b0c528aa8f3f11bac4d54c4a5ffd8e6ba0b79e7a6a527d4c31805dbb2c25","width",439,"height",577,"url","createdAt","2026-10-20T17:32:39.818Z","variants",[196,201],{"_187":197,"_189":198,"_181":199,"_191":200},320,421,"image/webp","/igenu-preview/media/a94dedbc4c305ed00e17532e.webp",{"_187":188,"_189":190,"_181":199,"_191":202},"/igenu-preview/media/addc2737c9f6397359f3a546.webp","detailLayout","STRUCTURED","availableLocales",[11,20,17],"bodyHtml","<strong><span>Produktmerkmale:</span></strong><br />◆DPD-Standardkolorimetrisches Verfahren<br />◆ Optische Struktur des langen Pfades, nicht leicht verunreinigt, Absorptionsdetektionsauflösung kann größer als 0.001Abs sein<br />◆Dual Speed Technologie, kompensiert automatisch Trübung, Farbigkeit und Blasenstörungen<br />◆Einzigartige Fluidstruktur mit geringem Wartungsaufwand<br />◆Relaisausgang, kann die Chlorpumpe sperren, um automatische Chlorzugabe zu erreichen<br />◆ Optionales Fernübertragungsmodul 4G, drahtloser Datenhochladen<br />◆ Kommt mit Speicherfunktion für einfache Anzeige von Aufzeichnungen<br /><strong><span>Anwendungsbereiche:</span></strong><br />Kommunales Leitungswasser, Rohrleitungsüberwachung, Lebensmittel- und Getränkeüberwachung, Trink- und Oberflächenwasserüberwachung, industrielle Prozesse<br /><span><strong>Technische Parameter:</strong></span><br />Bereich: 0~10mg/L<br />Messprinzip: DPD kolorimetrisches Verfahren<br />Messgenauigkeit: ± 1% des Messwertes oder 0,01mg/L, je nachdem, welcher größer ist<br />Nachweisgrenze: 0,01mg/L<br />Messmodus: kontinuierliche Messung, periodische Messung (einstellbares Messintervall)<br />Anzeige: 70mm × 48mm LCD Display<br />Kalibrierung: Standardkalibrierkurve<br />Reagenzbestand Alarm: Ja<br />Datenspeicherung: Historische Aufzeichnungen<br />Automatische Reinigungsfunktion: verfügbar<br />Reagenzienaustauschzyklus: 1 Monat (gemessen in 5 Minuten)<br />Mitteilung: RS485MODBUS <br />Ausgang: 4-20mA<br />Relais: 2-Kanal, Alarm kann eingestellt werden<br />Stromversorgung: 220-230VAC, 50/60Hz<br />Probendurchfluss: 250-500ml/min<br />Probeneingangsdruck: 0.1~5bar<br />Probentemperatur: 5~45 ℃<br />Arbeitsumgebung: 5-95%, nicht kondensierend<br />Instrumentengröße: 350mm, 186mm, 460mm (Länge, Breite, Höhe)<br />Gewicht: 9kg<br />Installationsmethode: Wandmontage\n    ","gallery",[],"features",[],"specificationGroups",[215],{"_165":216,"_217":218},"Technische Daten","specifications",[219,226,230,234,238,242,246,250,254,258,262,266,270,274,278,282,286,290,294,298,302,306],{"_220":221,"_108":222,"_223":224,"_225":-5},"key","measurement-range","Bereich","value","0~10mg/L","unit",{"_220":227,"_108":228,"_223":229,"_225":-5},"measurement-principle","Messprinzip","DPD kolorimetrisches Verfahren",{"_220":231,"_108":232,"_223":233,"_225":-5},"accuracy","Messgenauigkeit","± 1% des Messwertes oder 0,01mg/L, je nachdem, welcher größer ist",{"_220":235,"_108":236,"_223":237,"_225":-5},"detection-limit","Nachweisgrenze","0,01mg/L",{"_220":239,"_108":240,"_223":241,"_225":-5},"measurement-mode","Messmodus","kontinuierliche Messung, periodische Messung (einstellbares Messintervall)",{"_220":243,"_108":244,"_223":245,"_225":-5},"display","Anzeige","70mm × 48mm LCD Display",{"_220":247,"_108":248,"_223":249,"_225":-5},"calibration","Kalibrierung","Standardkalibrierkurve",{"_220":251,"_108":252,"_223":253,"_225":-5},"reagent-alarm","Reagenzbestand Alarm","Ja",{"_220":255,"_108":256,"_223":257,"_225":-5},"data-storage","Datenspeicherung","Historische Aufzeichnungen",{"_220":259,"_108":260,"_223":261,"_225":-5},"automatic-cleaning","Automatische Reinigungsfunktion","verfügbar",{"_220":263,"_108":264,"_223":265,"_225":-5},"reagent-replacement","Reagenzienaustauschzyklus","1 Monat (gemessen in 5 Minuten)",{"_220":267,"_108":268,"_223":269,"_225":-5},"digital-communication","Mitteilung","RS485MODBUS",{"_220":271,"_108":272,"_223":273,"_225":-5},"output","Ausgang","4-20mA",{"_220":275,"_108":276,"_223":277,"_225":-5},"relay","Relais","2-Kanal, Alarm kann eingestellt werden",{"_220":279,"_108":280,"_223":281,"_225":-5},"power-supply","Stromversorgung","220-230VAC, 50/60Hz",{"_220":283,"_108":284,"_223":285,"_225":-5},"sample-flow","Probendurchfluss","250-500ml/min",{"_220":287,"_108":288,"_223":289,"_225":-5},"sample-pressure","Probeneingangsdruck","0.1~5bar",{"_220":291,"_108":292,"_223":293,"_225":-5},"sample-temperature","Probentemperatur","5~45 ℃",{"_220":295,"_108":296,"_223":297,"_225":-5},"operating-temperature","Arbeitsumgebung","5-95%, nicht kondensierend",{"_220":299,"_108":300,"_223":301,"_225":-5},"instrument-size","Instrumentengröße","350mm, 186mm, 460mm (Länge, Breite, Höhe)",{"_220":303,"_108":304,"_223":305,"_225":-5},"weight","Gewicht","9kg",{"_220":307,"_108":308,"_223":309,"_225":-5},"installation","Installationsmethode","Wandmontage","sourceReviews",[],"documents",[],"supportDownloads",[]]
