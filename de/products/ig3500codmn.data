ion",[102,118],{"_103":104,"_105":106},"title","产品","links",[107,112,115],{"_108":109,"_110":111},"label","Wasseranalyse","href","/de/products?category=water",{"_108":113,"_110":114},"Industrielle Messung","/de/products?category=industrial",{"_108":116,"_110":117},"Gasdetektion","/de/products?category=gas",{"_103":119,"_105":120},"了解更多",[121,124,127,130,133],{"_108":122,"_110":123},"关于我们","/de/about",{"_108":125,"_110":126},"客户案例","/de/cases",{"_108":128,"_110":129},"新闻中心","/de/news",{"_108":131,"_110":132},"售后服务","/de/service",{"_108":134,"_110":135},"下载中心","/de/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig3500codmn",[],[],"seo",{"_103":146,"_147":148,"_149":150,"_151":152},"IG3500CODmn Analysator für den Permanganatindex | IGENU SCIENCE","description","Die Oxidation mit Kaliumpermanganat und anschließende Titration bestimmen den Permanganatindex im Wasser. Automatische Bereichsumschaltung, Qualitätskontrollen und Betriebsprotokolle unterstützen die Onlineüberwachung; Alarmfunktionen und elektrische Schnittstellen ermöglichen die Einbindung des Analysators in ein übergeordnetes System.","imageUrl","/igenu-preview/media/076a24550dfec7d99b95ba88.png","index",true,"canonical","https://eicloc.github.io/igenu-preview/de/products/ig3500codmn","query",{},"selected",[],"detail",{"_161":162,"_57":141,"_163":164,"_165":166,"_167":148,"_168":169,"_170":171,"_175":176,"_199":200,"_201":202,"_147":-5,"_203":204,"_205":206,"_207":208,"_209":210,"_284":285,"_286":287,"_288":289,"_144":145},"id","879c4612-34a5-41ef-a5f2-419989ad469e","model","IG3500CODMN","name","IG3500CODmn Analysator für den Permanganatindex","shortDescription","featured",false,"category",{"_57":172,"_173":-5,"_165":109,"_147":-5,"_144":174},"water","brand",{"_103":109,"_147":-5,"_149":-5,"_151":152},"heroImage",{"_161":177,"_140":178,"_179":180,"_181":182,"_183":184,"_185":186,"_187":188,"_189":190,"_191":150,"_192":193,"_194":195},"bfda7f5e-e504-4c40-85f0-1afea6d4aba3","IMAGE","originalName","2025040938476253.jpg","mimeType","image/png","size",51146,"sha256","076a24550dfec7d99b95ba8827dbead49c4506dc3d55d9d8b47b0c95d2a2c36e","width",267,"height",435,"url","createdAt","2026-10-20T17:32:39.824Z","variants",[196],{"_187":188,"_189":190,"_181":197,"_191":198},"image/webp","/igenu-preview/media/f3d468788765b050ceafe139.webp","detailLayout","STRUCTURED","availableLocales",[11,20,17],"bodyHtml","<p><strong><span>Produktmerkmale:</span></strong><br />◆Hochbereichsmessung niedriger Konzentration: Verwendung von Ringproben zurReduzierung der Verdünnungszeiten und zur Verbesserung der Wiederholbarkeit.Die neue Akzeptanznorm verlangt, dass der Instrumentenbereich 2-3-mal derEmissionsnorm entspricht, aber die tatsächliche Konzentration der abgegebenenWasserprobe ist sehr gering. Für diese Situation der Messung niedrigerKonzentration mit hohem Bereich liegt der Vorteil besonders auf der Hand.<br />◆Innovatives Messverfahren (Patent) (1) mit automatischer Kompensationsfunktiongegen Trübungsstörungen, die keine Messfehler beim Sammeln vonTrübungswasserproben verursacht; (2) mit Blasenabscheidefunktion, die einensignifikanten Einfluss auf Abwasser mit Blasen hat, wie Photovoltaikanlagen,Druck- und Färbeanlagen usw.<br />◆ Automatische Bereichsschaltfunktion: Wählen Sie eine beliebige Kombinationaus niedrigem und hohem Bereich, und das Instrument schaltet automatisch in denoptimalen Bereich basierend auf der tatsächlichen Wasserprobenkonzentration<br />◆ Mehrfache Qualitätskontrollfunktionen:Nullpunkt/Spanne/Standardprobenprüfung, Leerprüfung, reservierte paralleleProbe und spitze Wiederherstellungsschnittstelle<br />◆Mehrere Messmodi, Schlüsselparameteranzeige, Betrieb, Verifizierung,Kalibrierprotokolle, obere und untere Grenzwertwarnung<br />◆ Power on Self-Test, automatisches Zurücksetzen, Flüssigkeitsmangel Alarm,Power-Off Schutz, Abfallflüssigkeitstrennung<br />◆ Unterstützt 2-Kanal RS232/485, 2-Kanal 4-20mA Kommunikationsschnittstellenund Echtzeit-Datendruck für Drucker<br />◆ (Optional) Cloud-Überwachungsfunktion: Echtzeitüberwachung des Gerätestatusauf Mobiltelefonen, Fernalarm, Fernfehlerdiagnose<br />◆ (Optional) Reagenzkühlung: Ausgestattet mit einem Reagenzkühlkasten, um dieReagenzgarantiezeit zu verlängern<br /><strong><span>Anwendungsbereiche:</span></strong><br />Oberflächenwasser, Grundwasser, Leitungswasser, Trinkwasser, Meerwasser</p><p></p><strong><span>Technische Parameter:</span></strong><br />Erfassungsbereich: (0~20/100 ) mg/L <br />Messprinzip: Kaliumpermanganatoxidationstitrationsmethode<br />Genauigkeit: ± 5%<br />Wiederholbarkeit: ≤ 2%<br />Nulldrift: ± 5%<br />Entfernungsdift: ± 5%<br />Datenspeicherung: ≥ 48000 Datensätze<br />Umweltanforderungen: Temperatur+5~28° C: Feuchtigkeit&lt;90%<br />Messzyklus: 30-50min<br />MTBF: ≥ 720h/Zeit<br />Kommunikationsschnittstelle: 4-20mA RS232、RS485 <br />Isolationsimpedanz: über 2M Ω<br />Stromversorgung: AC ( 220+20 ) V ( 50+0.5 ) Hz ，5A <br />Stromverbrauch: 150W<br />Quantitative untere Grenze: 0,2mg/L<br />Mindestnachweisgrenze: 0,04mg/L<br />Größe: 500mm, 445mm bis 1355mm<p></p>\n    ","gallery",[],"features",[],"specificationGroups",[211],{"_165":212,"_213":214},"Technische Daten","specifications",[215,222,226,230,234,237,240,244,248,252,256,260,264,268,272,276,280],{"_216":217,"_108":218,"_219":220,"_221":-5},"key","measurement-range","Erfassungsbereich","value","(0~20/100 ) mg/L","unit",{"_216":223,"_108":224,"_219":225,"_221":-5},"measurement-principle","Messprinzip","Kaliumpermanganatoxidationstitrationsmethode",{"_216":227,"_108":228,"_219":229,"_221":-5},"accuracy","Genauigkeit","± 5%",{"_216":231,"_108":232,"_219":233,"_221":-5},"repeatability","Wiederholbarkeit","≤ 2%",{"_216":235,"_108":236,"_219":229,"_221":-5},"zero-drift","Nulldrift",{"_216":238,"_108":239,"_219":229,"_221":-5},"range-drift","Entfernungsdift",{"_216":241,"_108":242,"_219":243,"_221":-5},"data-storage","Datenspeicherung","≥ 48000 Datensätze",{"_216":245,"_108":246,"_219":247,"_221":-5},"environment-requirements","Umweltanforderungen","Temperatur+5~28° C: Feuchtigkeit<90%",{"_216":249,"_108":250,"_219":251,"_221":-5},"measurement-cycle","Messzyklus","30-50min",{"_216":253,"_108":254,"_219":255,"_221":-5},"mtbf","MTBF","≥ 720h/Zeit",{"_216":257,"_108":258,"_219":259,"_221":-5},"digital-communication","Kommunikationsschnittstelle","4-20mA RS232、RS485",{"_216":261,"_108":262,"_219":263,"_221":-5},"insulation","Isolationsimpedanz","über 2M Ω",{"_216":265,"_108":266,"_219":267,"_221":-5},"power-supply","Stromversorgung","AC ( 220+20 ) V ( 50+0.5 ) Hz ，5A",{"_216":269,"_108":270,"_219":271,"_221":-5},"power-consumption","Stromverbrauch","150W",{"_216":273,"_108":274,"_219":275,"_221":-5},"quantitative-limit","Quantitative untere Grenze","0,2mg/L",{"_216":277,"_108":278,"_219":279,"_221":-5},"detection-limit","Mindestnachweisgrenze","0,04mg/L",{"_216":281,"_108":282,"_219":283,"_221":-5},"dimensions","Größe","500mm, 445mm bis 1355mm","sourceReviews",[],"documents",[],"supportDownloads",[]]
