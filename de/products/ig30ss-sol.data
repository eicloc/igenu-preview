ion",[102,118],{"_103":104,"_105":106},"title","产品","links",[107,112,115],{"_108":109,"_110":111},"label","Wasseranalyse","href","/de/products?category=water",{"_108":113,"_110":114},"Industrielle Messung","/de/products?category=industrial",{"_108":116,"_110":117},"Gasdetektion","/de/products?category=gas",{"_103":119,"_105":120},"了解更多",[121,124,127,130,133],{"_108":122,"_110":123},"关于我们","/de/about",{"_108":125,"_110":126},"客户案例","/de/cases",{"_108":128,"_110":129},"新闻中心","/de/news",{"_108":131,"_110":132},"售后服务","/de/service",{"_108":134,"_110":135},"下载中心","/de/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig30ss-sol",[],[],"seo",{"_103":146,"_147":148,"_149":150,"_151":152},"IG30SS/SOL Sensor für Schwebstoffe und Schlammkonzentration | IGENU SCIENCE","description","Die Infrarot-Streulichtmessung überwacht Schwebstoffe und Schlammkonzentrationen in Wasser- und Abwasserprozessen. Die digitale Sonde kombiniert optische Kompensation mit einem Saphirfenster; eine optionale Reinigungsbürste begrenzt Ablagerungen auf der Messfläche während der kontinuierlichen Überwachung am jeweiligen Einsatzort.","imageUrl","/igenu-preview/media/fbfabb8705ffee2ab2928de1.jpg","index",true,"canonical","https://eicloc.github.io/igenu-preview/de/products/ig30ss-sol","query",{},"selected",[],"detail",{"_161":162,"_57":141,"_163":164,"_165":166,"_167":148,"_168":152,"_169":170,"_174":175,"_198":199,"_200":201,"_147":-5,"_202":203,"_204":205,"_206":207,"_208":209,"_293":294,"_295":296,"_297":298,"_144":145},"id","9d824bcb-a360-4cc5-9c05-f39f8c5afaa3","model","IG30SS/SOL","name","IG30SS/SOL Sensor für Schwebstoffe und Schlammkonzentration","shortDescription","featured","category",{"_57":171,"_172":-5,"_165":109,"_147":-5,"_144":173},"water","brand",{"_103":109,"_147":-5,"_149":-5,"_151":152},"heroImage",{"_161":176,"_140":177,"_178":179,"_180":181,"_182":183,"_184":185,"_186":187,"_188":189,"_190":150,"_191":192,"_193":194},"1439d80a-330c-424f-b53e-2863e4ad2437","IMAGE","originalName","2025040860527217.png","mimeType","image/jpeg","size",17952,"sha256","fbfabb8705ffee2ab2928de1e179bcbdfff9163bf9562b20f0a57da383e92447","width",252,"height",303,"url","createdAt","2026-10-20T17:32:39.774Z","variants",[195],{"_186":187,"_188":189,"_180":196,"_190":197},"image/webp","/igenu-preview/media/75deeb09829c31a530ddf618.webp","detailLayout","STRUCTURED","availableLocales",[20,11,17],"bodyHtml","<strong><span>Produktmerkmale:</span></strong><br />◆ Eingebauter Temperatursensor, automatische Lichtquelle Temperaturdriftkompensation<br />◆Annahme von Dual Beam Infrarot und Streulicht Photometer Detection Technologie, es hat gute Wiederholbarkeit und Stabilität<br />◆ Digitalsensor, RS-485 Ausgang, Standard Modbus RTU Protokoll, nicht beeinflusst durch Übertragungsabstand, bessere Stabilität<br />◆Der Sensor besteht aus Edelstahl-Material, das eine längere Lebensdauer hat und Wartung und Ausfallzeiten reduziert<br />◆Unter Verwendung einer 860nm Nahinfrarotlichtquelle kann es die Farbstörungen des Beispielhintergrundlichts ausgleichen<br />◆ Ausgestattet mit einem selbstreinigenden System, stabilem Betrieb und minimaler Wartung<br />◆Saphirfenster, langlebig und verschleißfest, gewährleistet langfristige Datengenauigkeit<br />◆ Nicht beeinträchtigt durch Strömungsgeschwindigkeitsinterferenzen und in der Lage, schweren Stößen standzuhalten<br />◆Digitale Sensoren mit starker Interferenz-Fähigkeit und großer Übertragungsabstrecke<br /><span><strong>Anwendungsbereiche:</strong></span><br />Kommunale Abwässer, Industrieabwässer, Umweltüberwachung, Trink- und Oberflächenwasserüberwachung, industrielle Prozesse<br /><span><strong>Technische Parameter:</strong></span><br />Bereich: 0~50g/L, 0.1~100g/L, 0.2~500g/L<br />Messprinzip: 860nm Wellenlänge, Streulicht bei 90° und 140 °<br />Auflösung: 0,01mg/L<br />Messgenauigkeit: weniger als ± 1% des Messwertes (abhängig von der Homogenität des Mediums Schlamm)<br />Wiederholbarkeit: weniger als ± 1%<br />Blasenkompensation: softwarebasierte Blasenkompensation<br />Reaktionszeit: T90＜5S<br />Höchstdruck: ≤ 30bar<br />Kalibrierungsmethode: Einzelpunktprobe, Neigungskalibrierung<br />Sensormaterial: Gehäuse: SUS316L； Fenster: Saphir<br />Selbstreinigung: automatische Kratzbürste (optional)<br />Lichtdämpfungskompensation: automatisch<br />Sensorkommunikation: MODBUS RS-485 <br />Lagertemperatur:- 30~75℃ <br />Arbeitstemperatur: 0~70 ℃ (nicht frierend)<br />Schutzniveau: IP68 <br />Kabellänge: Standard 10m, ausziehbar<br />Maximaler Druck: 30bar<br />Maximale Strömungsgeschwindigkeit: 3 Meter pro Sekunde<br />Sensorgröße: 200mm*50mm\n    ","gallery",[],"features",[],"specificationGroups",[210],{"_165":211,"_212":213},"Technische Daten","specifications",[214,221,225,229,233,237,241,245,249,253,257,261,265,269,273,277,281,285,289],{"_215":216,"_108":217,"_218":219,"_220":-5},"key","measurement-range","Bereich","value","0~50g/L, 0.1~100g/L, 0.2~500g/L","unit",{"_215":222,"_108":223,"_218":224,"_220":-5},"measurement-principle","Messprinzip","860nm Wellenlänge, Streulicht bei 90° und 140 °",{"_215":226,"_108":227,"_218":228,"_220":-5},"resolution","Auflösung","0,01mg/L",{"_215":230,"_108":231,"_218":232,"_220":-5},"accuracy","Messgenauigkeit","weniger als ± 1% des Messwertes (abhängig von der Homogenität des Mediums Schlamm)",{"_215":234,"_108":235,"_218":236,"_220":-5},"repeatability","Wiederholbarkeit","weniger als ± 1%",{"_215":238,"_108":239,"_218":240,"_220":-5},"bubble-compensation","Blasenkompensation","softwarebasierte Blasenkompensation",{"_215":242,"_108":243,"_218":244,"_220":-5},"response-time","Reaktionszeit","T90＜5S",{"_215":246,"_108":247,"_218":248,"_220":-5},"maximum-pressure","Höchstdruck","≤ 30bar; 30bar",{"_215":250,"_108":251,"_218":252,"_220":-5},"calibration","Kalibrierungsmethode","Einzelpunktprobe, Neigungskalibrierung",{"_215":254,"_108":255,"_218":256,"_220":-5},"sensor-material","Sensormaterial","Gehäuse: SUS316L； Fenster: Saphir",{"_215":258,"_108":259,"_218":260,"_220":-5},"self-cleaning","Selbstreinigung","automatische Kratzbürste (optional)",{"_215":262,"_108":263,"_218":264,"_220":-5},"light-attenuation-compensation","Lichtdämpfungskompensation","automatisch",{"_215":266,"_108":267,"_218":268,"_220":-5},"digital-communication","Sensorkommunikation","MODBUS RS-485",{"_215":270,"_108":271,"_218":272,"_220":-5},"storage-temperature","Lagertemperatur","- 30~75℃",{"_215":274,"_108":275,"_218":276,"_220":-5},"operating-temperature","Arbeitstemperatur","0~70 ℃ (nicht frierend)",{"_215":278,"_108":279,"_218":280,"_220":-5},"protection","Schutzniveau","IP68",{"_215":282,"_108":283,"_218":284,"_220":-5},"cable","Kabellänge","Standard 10m, ausziehbar",{"_215":286,"_108":287,"_218":288,"_220":-5},"maximum-flow","Maximale Strömungsgeschwindigkeit","3 Meter pro Sekunde",{"_215":290,"_108":291,"_218":292,"_220":-5},"sensor-size","Sensorgröße","200mm*50mm","sourceReviews",[],"documents",[],"supportDownloads",[]]
