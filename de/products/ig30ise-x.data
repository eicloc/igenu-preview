ion",[102,118],{"_103":104,"_105":106},"title","产品","links",[107,112,115],{"_108":109,"_110":111},"label","Wasseranalyse","href","/de/products?category=water",{"_108":113,"_110":114},"Industrielle Messung","/de/products?category=industrial",{"_108":116,"_110":117},"Gasdetektion","/de/products?category=gas",{"_103":119,"_105":120},"了解更多",[121,124,127,130,133],{"_108":122,"_110":123},"关于我们","/de/about",{"_108":125,"_110":126},"客户案例","/de/cases",{"_108":128,"_110":129},"新闻中心","/de/news",{"_108":131,"_110":132},"售后服务","/de/service",{"_108":134,"_110":135},"下载中心","/de/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig30ise-x",[],[],"seo",{"_103":146,"_147":148,"_149":150,"_151":152},"IG30ISE-X Ionenselektive Elektrode | IGENU SCIENCE","description","Die ionenselektive Messung unterstützt konfigurierte Ionenparameter und pH in der Wasserüberwachung. Die Tauchsonde benötigt kein separates Probenahmesystem und bietet Kompensations- sowie Kalibrierfunktionen für Anwendungen in Trinkwasser, Umweltmessung und Abwasser; die Parameter werden anwendungsbezogen ausgewählt.","imageUrl","/igenu-preview/media/8936108072d3c61053c40f38.png","index",true,"canonical","https://eicloc.github.io/igenu-preview/de/products/ig30ise-x","query",{},"selected",[],"detail",{"_161":162,"_57":141,"_163":164,"_165":166,"_167":148,"_168":169,"_170":171,"_175":176,"_199":200,"_201":202,"_147":-5,"_203":204,"_205":206,"_207":208,"_209":210,"_312":313,"_314":315,"_316":317,"_144":145},"id","0edda979-2d5f-4caa-bde7-a1368da21597","model","IG30ISE-X","name","IG30ISE-X Ionenselektive Elektrode","shortDescription","featured",false,"category",{"_57":172,"_173":-5,"_165":109,"_147":-5,"_144":174},"water","brand",{"_103":109,"_147":-5,"_149":-5,"_151":152},"heroImage",{"_161":177,"_140":178,"_179":180,"_181":182,"_183":184,"_185":186,"_187":188,"_189":190,"_191":150,"_192":193,"_194":195},"c6e3c765-909d-45fd-bd1c-7dbc51fecd54","IMAGE","originalName","2025041051038309.png","mimeType","image/png","size",13330,"sha256","8936108072d3c61053c40f382494eb98c8734713fb66a99450bf2aedb26fb684","width",320,"height",120,"url","createdAt","2026-10-20T17:32:39.882Z","variants",[196],{"_187":188,"_189":190,"_181":197,"_191":198},"image/webp","/igenu-preview/media/f11ab30d5325a31abe0f2adb.webp","detailLayout","STRUCTURED","availableLocales",[20,11,17],"bodyHtml","<strong><span>Produktmerkmale:</span></strong><br />◆ Stabile und zuverlässige, ionenselektive Methode und Multi-Parameter-Kompensationstechnologie, genaue und stabile Messung<br />◆ Einfache Installation, der Sensor wird direkt in Wasser getaucht, ohne dass eine Probenahme erforderlich ist<br />◆ Einfache Wartung, erfordert nur regelmäßige Kalibrierung und Reinigung<br />◆ Ausgestattet mit Temperatur pH、 Automatische Kompensationsfunktion für Kaliumionen usw.<br />◆ Multi Parameteranzeige und Ausgabefunktion, eine Maschine für mehrere Zwecke<br />◆ Fähig zur Ein- und Mehrpunkt-Kalibrierung<br /><span><strong>Anwendungsbereiche:</strong></span><br />Umweltüberwachung, Trink- und Oberflächenwasserüberwachung, Industrieabwasser, Abwasser, häusliches Abwasser, Abwasser, Grundwasser, Seewasser<br /><span><strong>Technische Parameter:</strong></span><br />Messprinzip: ionenselektive Elektrodenmethode<br />Ausführliches Messprinzip: Ionenträgermembran, porenfreie Referenzelektrode<br />Messparameter: Ammoniakstickstoff, Nitratstickstoff pH、 Kaliumionen, Chloridionen, Fluoridionen<br />Messbereich: Ammoniakion: 0.1-1000mg/L (bis 10000mg/L Maximum)<br />Stickstoff: 0.1-1000mg/L (bis zu 10000mg/L Maximum)<br />Chlorid-Ion: 0.1-1000mg/L (bis zu 10000mg/L Maximum)<br />Kaliumion: 0.1-1000mg/L (bis zu 10000mg/L Maximum)<br />pH：2-12pH<br />Fluorid-Ion: 0.1-1000mg/L (bis zu 10000mg/L Maximum)<br />Genauigkeit: ± 3% oder ± 0,1 mg/L des Messwertes, je nachdem, was größer ist<br />Auflösung: 0,01 mg/L, 0,01 pH<br />Wiederholbarkeit: ± 1% FS<br />Reaktionszeit: T90≤30s, Fluoridion T90 ≤ 60s<br />Kaliumionenkompensation: manuell oder automatisch<br />PH-Kompensation: manuell oder automatisch<br />Temperaturausgleich: automatisch<br />Kalibrierung: Einpunktkalibrierung, Zweipunktkalibrierung<br />Betriebstemperatur: 0~45 ℃ (Fluorid-Ionen können bis zu 60 ℃) erreichen<br />Lagertemperatur:- 10~50℃ <br />Schutzniveau: IP68<br />Hauptmaterial: 316L POM<br />Automatische Reinigung: Druckluft (optional)<br />Kabellänge: Standard 10m, ausziehbar<br />Stromverbrauch: max. 1W<br />Sensorgröße: 264mm bis 55mm\n    ","gallery",[],"features",[],"specificationGroups",[211],{"_165":212,"_213":214},"Technische Daten","specifications",[215,222,226,228,232,236,239,242,246,249,253,257,261,265,269,272,276,280,284,288,292,296,300,304,308],{"_216":217,"_108":218,"_219":220,"_221":-5},"key","measurement-principle","Messprinzip","value","ionenselektive Elektrodenmethode","unit",{"_216":223,"_108":224,"_219":225,"_221":-5},"detailed-principle","Ausführliches Messprinzip","Ionenträgermembran, porenfreie Referenzelektrode",{"_216":64,"_108":66,"_219":227,"_221":-5},"Ammoniakstickstoff, Nitratstickstoff pH、 Kaliumionen, Chloridionen, Fluoridionen",{"_216":229,"_108":230,"_219":231,"_221":-5},"measurement-range","Messbereich","Ammoniakion: 0.1-1000mg/L (bis 10000mg/L Maximum)",{"_216":233,"_108":234,"_219":235,"_221":-5},"nitrate-range","Stickstoff","0.1-1000mg/L (bis zu 10000mg/L Maximum)",{"_216":237,"_108":238,"_219":235,"_221":-5},"chloride-range","Chlorid-Ion",{"_216":240,"_108":241,"_219":235,"_221":-5},"potassium-range","Kaliumion",{"_216":243,"_108":244,"_219":245,"_221":-5},"ph-range","pH","2-12pH",{"_216":247,"_108":248,"_219":235,"_221":-5},"fluoride-range","Fluorid-Ion",{"_216":250,"_108":251,"_219":252,"_221":-5},"accuracy","Genauigkeit","± 3% oder ± 0,1 mg/L des Messwertes, je nachdem, was größer ist",{"_216":254,"_108":255,"_219":256,"_221":-5},"resolution","Auflösung","0,01 mg/L, 0,01 pH",{"_216":258,"_108":259,"_219":260,"_221":-5},"repeatability","Wiederholbarkeit","± 1% FS",{"_216":262,"_108":263,"_219":264,"_221":-5},"response-time","Reaktionszeit","T90≤30s, Fluoridion T90 ≤ 60s",{"_216":266,"_108":267,"_219":268,"_221":-5},"potassium-compensation","Kaliumionenkompensation","manuell oder automatisch",{"_216":270,"_108":271,"_219":268,"_221":-5},"ph-compensation","PH-Kompensation",{"_216":273,"_108":274,"_219":275,"_221":-5},"temperature-compensation","Temperaturausgleich","automatisch",{"_216":277,"_108":278,"_219":279,"_221":-5},"calibration","Kalibrierung","Einpunktkalibrierung, Zweipunktkalibrierung",{"_216":281,"_108":282,"_219":283,"_221":-5},"operating-temperature","Betriebstemperatur","0~45 ℃ (Fluorid-Ionen können bis zu 60 ℃) erreichen",{"_216":285,"_108":286,"_219":287,"_221":-5},"storage-temperature","Lagertemperatur","- 10~50℃",{"_216":289,"_108":290,"_219":291,"_221":-5},"protection","Schutzniveau","IP68",{"_216":293,"_108":294,"_219":295,"_221":-5},"material","Hauptmaterial","316L POM",{"_216":297,"_108":298,"_219":299,"_221":-5},"automatic-cleaning","Automatische Reinigung","Druckluft (optional)",{"_216":301,"_108":302,"_219":303,"_221":-5},"cable","Kabellänge","Standard 10m, ausziehbar",{"_216":305,"_108":306,"_219":307,"_221":-5},"power-consumption","Stromverbrauch","max. 1W",{"_216":309,"_108":310,"_219":311,"_221":-5},"sensor-size","Sensorgröße","264mm bis 55mm","sourceReviews",[],"documents",[],"supportDownloads",[]]
