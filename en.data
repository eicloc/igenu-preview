83b25c7da.webp",{"_143":160,"_57":239,"_164":240,"_166":241,"_168":242,"_170":243,"_147":244,"_179":246},"ig3000mp-x","IG3000MP-X","IG3000MP-X Multiparameter Water Analyzer","Build a water monitoring system around interchangeable digital probes for parameters such as pH, dissolved oxygen, conductivity and turbidity. Probe connections and stored calibration data support field replacement, while an automatic cleaning arrangement helps limit surface deposits.",false,{"_57":148,"_173":-5,"_166":109,"_174":-5,"_175":245},{"_103":109,"_174":-5,"_177":-5,"_178":171},{"_143":247,"_139":182,"_183":248,"_185":225,"_187":249,"_189":250,"_191":251,"_193":251,"_195":252,"_197":253,"_199":254},"d6d649eb-90c0-469f-9bfb-1c613153f689","2025040861670749.jpg",19258,"9a9243397faa84f675ead5a8a5216895cf7e15c9b82d390083269947f0d00581",540,"/igenu-preview/media/9a9243397faa84f675ead5a8.jpg","2026-10-20T17:32:39.812Z",[255,257],{"_191":202,"_193":202,"_185":204,"_195":256},"/igenu-preview/media/32f08ba6aa513832d0c6c644.webp",{"_191":251,"_193":251,"_185":204,"_195":258},"/igenu-preview/media/61f38d89920b71a6040fa537.webp",{"_143":158,"_57":260,"_164":261,"_166":262,"_168":263,"_170":243,"_147":264,"_179":266},"ig30ise-x","IG30ISE-X","IG30ISE-X Ion-Selective Electrode","Ion-selective measurement supports water monitoring for configured ion parameters and pH. The immersion probe operates without a separate sampling system and provides compensation and calibration functions, making it suitable for drinking water, environmental and wastewater applications.",{"_57":148,"_173":-5,"_166":109,"_174":-5,"_175":265},{"_103":109,"_174":-5,"_177":-5,"_178":171},{"_143":267,"_139":182,"_183":268,"_185":186,"_187":269,"_189":270,"_191":202,"_193":271,"_195":272,"_197":273,"_199":274},"c6e3c765-909d-45fd-bd1c-7dbc51fecd54","2025041051038309.png",13330,"8936108072d3c61053c40f382494eb98c8734713fb66a99450bf2aedb26fb684",120,"/igenu-preview/media/8936108072d3c61053c40f38.png","2026-10-20T17:32:39.882Z",[275],