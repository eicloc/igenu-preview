avigation",[102,118],{"_103":104,"_105":106},"title","Products","links",[107,112,115],{"_108":109,"_110":111},"label","Water analysis","href","/en/products?category=water",{"_108":113,"_110":114},"Industrial measurement","/en/products?category=industrial",{"_108":116,"_110":117},"Gas detection","/en/products?category=gas",{"_103":119,"_105":120},"Explore",[121,123,126,129,132],{"_108":79,"_110":122},"/en/about",{"_108":124,"_110":125},"Customer cases","/en/cases",{"_108":127,"_110":128},"News","/en/news",{"_108":130,"_110":131},"After-sales service","/en/service",{"_108":133,"_110":134},"Downloads","/en/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig3500",[],[],"seo",{"_103":145,"_146":147,"_148":149,"_150":151},"IG3500 Residual Chlorine Analyzer | IGENU SCIENCE","description","DPD colorimetry measures residual chlorine in water for supply and process monitoring. The analyzer combines optical interference compensation, automatic cleaning and data storage, with relay outputs for control integration and an optional remote communication module for connected operation.","imageUrl","/igenu-preview/media/8851b0c528aa8f3f11bac4d5.png","index",true,"canonical","https://eicloc.github.io/igenu-preview/en/products/ig3500","query",{},"selected",[],"detail",{"_160":161,"_57":140,"_162":163,"_164":165,"_166":147,"_167":168,"_169":170,"_174":175,"_202":203,"_204":205,"_146":-5,"_206":207,"_208":209,"_210":211,"_212":213,"_309":310,"_311":312,"_313":314,"_143":144},"id","caa08499-feb7-4ba5-a00f-5383e3318a7b","model","IG3500","name","IG3500 Residual Chlorine Analyzer","shortDescription","featured",false,"category",{"_57":171,"_172":-5,"_164":109,"_146":-5,"_143":173},"water","brand",{"_103":109,"_146":-5,"_148":-5,"_150":151},"heroImage",{"_160":176,"_139":177,"_178":179,"_180":181,"_182":183,"_184":185,"_186":187,"_188":189,"_190":149,"_191":192,"_193":194},"c50c4c9d-55bb-4423-8c3e-781ffff460bb","IMAGE","originalName","2025040937453857.jpg","mimeType","image/png","size",161037,"sha256","8851b0c528aa8f3f11bac4d54c4a5ffd8e6ba0b79e7a6a527d4c31805dbb2c25","width",439,"height",577,"url","createdAt","2026-10-20T17:32:39.818Z","variants",[195,200],{"_186":196,"_188":197,"_180":198,"_190":199},320,421,"image/webp","/igenu-preview/media/a94dedbc4c305ed00e17532e.webp",{"_186":187,"_188":189,"_180":198,"_190":201},"/igenu-preview/media/addc2737c9f6397359f3a546.webp","detailLayout","STRUCTURED","availableLocales",[20,19,11],"bodyHtml","<strong><span>Product features:</span></strong><br />◆ DPD standard colorimetric method<br />◆ Long path optical structure, not easily contaminated, absorbance detection resolution can be greater than 0.001Abs<br />◆ Dual speed technology, automatically compensates for turbidity, chromaticity, and bubble interference<br />◆ Unique fluid structure with low maintenance requirements<br />◆ Relay output, can lock the chlorine pump to achieve automatic chlorine addition<br />◆ Optional 4G remote transmission module, wireless data upload<br />◆ Comes with storage function for easy viewing of records<br /><span><strong>Application areas:</strong></span><br />Municipal tap water, pipeline monitoring, food and beverage, drinking and surface water monitoring, industrial processes<br /><strong><span>Technical parameters:</span></strong><br />Range: 0~10mg/L<br />Measurement principle: DPD colorimetric method<br />Measurement accuracy: ± 1% of the measured value or 0.01mg/L, whichever is greater<br />Detection limit: 0.01mg/L<br />Measurement mode: continuous measurement, periodic measurement (adjustable measurement interval)<br />Display: 70mm × 48mm LCD display<br />Calibration: default calibration curve<br />Reagent remaining alarm: Yes<br />Data Storage: Historical Records<br />Automatic cleaning function: available<br />Reagent replacement cycle: 1 month (measured in 5 minutes)<br />Communication: RS485MODBUS <br />Output: 4-20mA<br />Relay: 2 channels, alarm can be set<br />Power supply: 220-230VAC, 50/60Hz<br />Sample flow rate: 250-500mL/min<br />Sample inlet pressure: 0.1~5bar<br />Sample temperature: 5~45 ℃<br />Working environment: 5-95%, non condensing<br />Instrument size: 350mm * 186mm * 460mm (length * width * height)<br />Weight: 9kg<br />Installation method: Wall mounted\n    ","gallery",[],"features",[],"specificationGroups",[214],{"_164":215,"_216":217},"Technical specifications","specifications",[218,225,229,233,237,241,245,249,253,257,261,265,269,273,277,281,285,289,293,297,301,305],{"_219":220,"_108":221,"_222":223,"_224":-5},"key","measurement-range","Range","value","0~10mg/L","unit",{"_219":226,"_108":227,"_222":228,"_224":-5},"measurement-principle","Measurement principle","DPD colorimetric method",{"_219":230,"_108":231,"_222":232,"_224":-5},"accuracy","Measurement accuracy","± 1% of the measured value or 0.01mg/L, whichever is greater",{"_219":234,"_108":235,"_222":236,"_224":-5},"detection-limit","Detection limit","0.01mg/L",{"_219":238,"_108":239,"_222":240,"_224":-5},"measurement-mode","Measurement mode","continuous measurement, periodic measurement (adjustable measurement interval)",{"_219":242,"_108":243,"_222":244,"_224":-5},"display","Display","70mm × 48mm LCD display",{"_219":246,"_108":247,"_222":248,"_224":-5},"calibration","Calibration","default calibration curve",{"_219":250,"_108":251,"_222":252,"_224":-5},"reagent-alarm","Reagent remaining alarm","Yes",{"_219":254,"_108":255,"_222":256,"_224":-5},"data-storage","Data Storage","Historical Records",{"_219":258,"_108":259,"_222":260,"_224":-5},"automatic-cleaning","Automatic cleaning function","available",{"_219":262,"_108":263,"_222":264,"_224":-5},"reagent-replacement","Reagent replacement cycle","1 month (measured in 5 minutes)",{"_219":266,"_108":267,"_222":268,"_224":-5},"digital-communication","Communication","RS485MODBUS",{"_219":270,"_108":271,"_222":272,"_224":-5},"output","Output","4-20mA",{"_219":274,"_108":275,"_222":276,"_224":-5},"relay","Relay","2 channels, alarm can be set",{"_219":278,"_108":279,"_222":280,"_224":-5},"power-supply","Power supply","220-230VAC, 50/60Hz",{"_219":282,"_108":283,"_222":284,"_224":-5},"sample-flow","Sample flow rate","250-500mL/min",{"_219":286,"_108":287,"_222":288,"_224":-5},"sample-pressure","Sample inlet pressure","0.1~5bar",{"_219":290,"_108":291,"_222":292,"_224":-5},"sample-temperature","Sample temperature","5~45 ℃",{"_219":294,"_108":295,"_222":296,"_224":-5},"operating-temperature","Working environment","5-95%, non condensing",{"_219":298,"_108":299,"_222":300,"_224":-5},"instrument-size","Instrument size","350mm * 186mm * 460mm (length * width * height)",{"_219":302,"_108":303,"_222":304,"_224":-5},"weight","Weight","9kg",{"_219":306,"_108":307,"_222":308,"_224":-5},"installation","Installation method","Wall mounted","sourceReviews",[],"documents",[],"supportDownloads",[]]
