avigation",[102,118],{"_103":104,"_105":106},"title","Products","links",[107,112,115],{"_108":109,"_110":111},"label","Water analysis","href","/en/products?category=water",{"_108":113,"_110":114},"Industrial measurement","/en/products?category=industrial",{"_108":116,"_110":117},"Gas detection","/en/products?category=gas",{"_103":119,"_105":120},"Explore",[121,123,126,129,132],{"_108":79,"_110":122},"/en/about",{"_108":124,"_110":125},"Customer cases","/en/cases",{"_108":127,"_110":128},"News","/en/news",{"_108":130,"_110":131},"After-sales service","/en/service",{"_108":133,"_110":134},"Downloads","/en/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig30ht",[],[],"seo",{"_103":145,"_146":147,"_148":149,"_150":151},"IG30HT High-Range Turbidity Sensor | IGENU SCIENCE","description","Infrared scattered-light sensing measures turbidity in process water, surface water and treatment applications. The digital probe combines optical compensation with a sapphire window and offers an optional cleaning brush to reduce deposits during ongoing monitoring.","imageUrl","/igenu-preview/media/ecdac2d963d6479b136774a8.png","index",true,"canonical","https://eicloc.github.io/igenu-preview/en/products/ig30ht","query",{},"selected",[],"detail",{"_160":161,"_57":140,"_162":163,"_164":165,"_166":147,"_167":168,"_169":170,"_174":175,"_198":199,"_200":201,"_146":-5,"_202":203,"_204":205,"_206":207,"_208":209,"_293":294,"_295":296,"_297":298,"_143":144},"id","beabf1d3-ee7e-4d27-92b1-039290c217dc","model","IG30HT","name","IG30HT High-Range Turbidity Sensor","shortDescription","featured",false,"category",{"_57":171,"_172":-5,"_164":109,"_146":-5,"_143":173},"water","brand",{"_103":109,"_146":-5,"_148":-5,"_150":151},"heroImage",{"_160":176,"_139":177,"_178":179,"_180":181,"_182":183,"_184":185,"_186":187,"_188":189,"_190":149,"_191":192,"_193":194},"95eccf83-22e5-4f4d-a03f-5509479d7661","IMAGE","originalName","2025040860985293.jpg","mimeType","image/png","size",11246,"sha256","ecdac2d963d6479b136774a8172895d54061650f1cb8089d1404ff2a26710a79","width",190,"height",78,"url","createdAt","2026-10-20T17:32:39.787Z","variants",[195],{"_186":187,"_188":189,"_180":196,"_190":197},"image/webp","/igenu-preview/media/c0547cb002a63d36b1ac374c.webp","detailLayout","STRUCTURED","availableLocales",[19,20,11],"bodyHtml","<strong><span>Product features:</span></strong><br />◆ Built in temperature sensor, automatic light source temperature drift compensation<br />◆ Adopting dual beam infrared and scattered light photometer detection technology, it has good repeatability and stability<br />◆ Digital sensor, RS-485 output, standard Modbus RTU protocol, not affected by transmission distance, better stability<br />◆ The sensor is made of stainless steel material, which has a longer service life and reduces maintenance and downtime<br />◆ Using an 860nm near-infrared light source, it can compensate for the color interference of the sample background light<br />◆ Equipped with a self-cleaning system, stable operation and minimal maintenance<br />◆ Sapphire window, durable and wear-resistant, ensuring long-term data accuracy<br />◆ Not affected by flow velocity interference and able to withstand severe impacts<br />◆ Digital sensors with strong anti-interference ability and long transmission distance<br /><strong><span>Application areas:</span></strong><br />Industrial process water monitoring, drinking water treatment, surface water/groundwater monitoring, sewage treatment, membrane filtration monitoring<br /><strong><span>Technical parameters:</span></strong><br />Range: 0~1000NTU, 0.2~4000 NTU, 0.5~10000NTU<br />Measurement principle: 860nm wavelength, scattered light at 90 ° and 135 °<br />Resolution: 0.001 NTU<br />Measurement accuracy: ± 1% or ± 0.1NTU of the reading, whichever is greater<br />Repeatability: less than ± 1%<br />Bubble compensation: software based bubble compensation<br />Response time: T90＜5S<br />Maximum pressure: ≤ 30bar <br />Calibration method: single point sample, slope calibration<br />Sensor material: Body: SUS316L； Window: Sapphire<br />Self cleaning: automatic scraping brush (optional)<br />Light attenuation compensation: automatic<br />Sensor communication: MODBUS RS-485 <br />Storage temperature:- 10~50℃ <br />Working temperature: 0~45 ℃ (non freezing)<br />Protection level: IP68 <br />Cable length: Standard 10m, extendable<br />Maximum pressure: 30bar<br />Maximum flow velocity: 3 meters per second<br />Sensor size: 176mm*22mm\n    ","gallery",[],"features",[],"specificationGroups",[210],{"_164":211,"_212":213},"Technical specifications","specifications",[214,221,225,229,233,237,241,245,249,253,257,261,265,269,273,277,281,285,289],{"_215":216,"_108":217,"_218":219,"_220":-5},"key","measurement-range","Range","value","0~1000NTU, 0.2~4000 NTU, 0.5~10000NTU","unit",{"_215":222,"_108":223,"_218":224,"_220":-5},"measurement-principle","Measurement principle","860nm wavelength, scattered light at 90 ° and 135 °",{"_215":226,"_108":227,"_218":228,"_220":-5},"resolution","Resolution","0.001 NTU",{"_215":230,"_108":231,"_218":232,"_220":-5},"accuracy","Measurement accuracy","± 1% or ± 0.1NTU of the reading, whichever is greater",{"_215":234,"_108":235,"_218":236,"_220":-5},"repeatability","Repeatability","less than ± 1%",{"_215":238,"_108":239,"_218":240,"_220":-5},"bubble-compensation","Bubble compensation","software based bubble compensation",{"_215":242,"_108":243,"_218":244,"_220":-5},"response-time","Response time","T90＜5S",{"_215":246,"_108":247,"_218":248,"_220":-5},"maximum-pressure","Maximum pressure","≤ 30bar; 30bar",{"_215":250,"_108":251,"_218":252,"_220":-5},"calibration","Calibration method","single point sample, slope calibration",{"_215":254,"_108":255,"_218":256,"_220":-5},"sensor-material","Sensor material","Body: SUS316L； Window: Sapphire",{"_215":258,"_108":259,"_218":260,"_220":-5},"self-cleaning","Self cleaning","automatic scraping brush (optional)",{"_215":262,"_108":263,"_218":264,"_220":-5},"light-attenuation-compensation","Light attenuation compensation","automatic",{"_215":266,"_108":267,"_218":268,"_220":-5},"digital-communication","Sensor communication","MODBUS RS-485",{"_215":270,"_108":271,"_218":272,"_220":-5},"storage-temperature","Storage temperature","- 10~50℃",{"_215":274,"_108":275,"_218":276,"_220":-5},"operating-temperature","Working temperature","0~45 ℃ (non freezing)",{"_215":278,"_108":279,"_218":280,"_220":-5},"protection","Protection level","IP68",{"_215":282,"_108":283,"_218":284,"_220":-5},"cable","Cable length","Standard 10m, extendable",{"_215":286,"_108":287,"_218":288,"_220":-5},"maximum-flow","Maximum flow velocity","3 meters per second",{"_215":290,"_108":291,"_218":292,"_220":-5},"sensor-size","Sensor size","176mm*22mm","sourceReviews",[],"documents",[],"supportDownloads",[]]
