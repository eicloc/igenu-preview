avigation",[102,118],{"_103":104,"_105":106},"title","Products","links",[107,112,115],{"_108":109,"_110":111},"label","Water analysis","href","/en/products?category=water",{"_108":113,"_110":114},"Industrial measurement","/en/products?category=industrial",{"_108":116,"_110":117},"Gas detection","/en/products?category=gas",{"_103":119,"_105":120},"Explore",[121,123,126,129,132],{"_108":79,"_110":122},"/en/about",{"_108":124,"_110":125},"Customer cases","/en/cases",{"_108":127,"_110":128},"News","/en/news",{"_108":130,"_110":131},"After-sales service","/en/service",{"_108":133,"_110":134},"Downloads","/en/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig5200",[],[],"seo",{"_103":145,"_146":147,"_148":149,"_150":151},"IG5200 Temperature Transmitter | IGENU SCIENCE","description","Combine a resistance temperature detector or thermocouple with signal conversion and local indication in an integrated transmitter. An electrical output proportional to temperature supports connection to monitoring equipment, while the local display assists with inspection at the measurement point.","imageUrl","/igenu-preview/media/0ef55182d75fdce9b0e8cdaf.png","index",true,"canonical","https://eicloc.github.io/igenu-preview/en/products/ig5200","query",{},"selected",[],"detail",{"_160":161,"_57":140,"_162":163,"_164":165,"_166":147,"_167":168,"_169":170,"_174":175,"_198":199,"_200":201,"_146":-5,"_202":203,"_204":205,"_206":207,"_208":209,"_273":274,"_275":276,"_277":278,"_143":144},"id","6bd17643-47a4-46c6-93c1-0b337edb7ec2","model","IG5200","name","IG5200 Temperature Transmitter","shortDescription","featured",false,"category",{"_57":171,"_172":-5,"_164":113,"_146":-5,"_143":173},"industrial","brand",{"_103":113,"_146":-5,"_148":-5,"_150":151},"heroImage",{"_160":176,"_139":177,"_178":179,"_180":181,"_182":183,"_184":185,"_186":187,"_188":189,"_190":149,"_191":192,"_193":194},"48490d76-c117-4813-9e44-d08d44e53200","IMAGE","originalName","2025041052499693.jpg","mimeType","image/png","size",105279,"sha256","0ef55182d75fdce9b0e8cdaf4c03e078ea6eeb5578a6154000d2e3efca25ae71","width",183,"height",677,"url","createdAt","2026-10-20T17:32:39.916Z","variants",[195],{"_186":187,"_188":189,"_180":196,"_190":197},"image/webp","/igenu-preview/media/565e37464151b9fb7246a52e.webp","detailLayout","STRUCTURED","availableLocales",[20,19,11],"bodyHtml","<span><strong>Product features:</strong></span><br />◆ Accurate signal and long-distance transmission (up to 1000 meters)<br />◆ High precision, anti-interference, good long-term stability, maintenance free<br />◆ The transmitter can display measurements on site<br />◆ Range: -200 ℃ to 1200 ℃; Conventional accuracy: ± 0.25%<br /><span><strong>Technical parameters:</strong></span><br />Measurement range:- 200-1200℃<br />Temperature measurement range of thermistor:&lt;Pt100&gt;-200~450 ℃&lt; Cu50&gt;-50～150℃<br />Thermocouple temperature measurement range：&lt; K&gt;  0℃-1200℃；          &lt; E&gt;  0℃-800℃；<br />                                                                                &lt;S&gt;  0℃-1600℃              &lt;B&gt;  0℃-1800℃<br />Measurement accuracy:&lt;thermal resistance&gt;± 0.25%; ± 0.5%； &lt; Thermocouple&gt;± 0.75%<br />Output signal:4-20mA<br />Warm float:  ± 0.025%/℃<br />Time drift: less than ± 0.5% per year<br />Environmental temperature: -10~85 ℃<br />Power supply voltage: 24V DC ± 10%<br />Load capacity: 0-500 Ω<br />Display range:  -1999～1999<br />Protection level:  IP65<br />Explosion proof level:  dII BT6<br />Material of protective tube: 1Cr18Ni9Ti or ceramic or steel jade tube\n    ","gallery",[],"features",[],"specificationGroups",[210],{"_164":211,"_212":213},"Technical specifications","specifications",[214,221,225,229,233,237,241,245,249,253,257,261,265,269],{"_215":216,"_108":217,"_218":219,"_220":-5},"key","measurement-range","Measurement range","value","- 200-1200℃","unit",{"_215":222,"_108":223,"_218":224,"_220":-5},"thermistor-range","Temperature measurement range of thermistor","<Pt100>-200~450 ℃< Cu50>-50～150℃",{"_215":226,"_108":227,"_218":228,"_220":-5},"thermocouple-range","Thermocouple temperature measurement range","< K>  0℃-1200℃；          < E>  0℃-800℃；\n<S>  0℃-1600℃              <B>  0℃-1800℃",{"_215":230,"_108":231,"_218":232,"_220":-5},"accuracy","Measurement accuracy","<thermal resistance>± 0.25%; ± 0.5%； < Thermocouple>± 0.75%",{"_215":234,"_108":235,"_218":236,"_220":-5},"output","Output signal","4-20mA",{"_215":238,"_108":239,"_218":240,"_220":-5},"temperature-drift","Warm float","± 0.025%/℃",{"_215":242,"_108":243,"_218":244,"_220":-5},"time-drift","Time drift","less than ± 0.5% per year",{"_215":246,"_108":247,"_218":248,"_220":-5},"operating-temperature","Environmental temperature","-10~85 ℃",{"_215":250,"_108":251,"_218":252,"_220":-5},"power-supply","Power supply voltage","24V DC ± 10%",{"_215":254,"_108":255,"_218":256,"_220":-5},"load","Load capacity","0-500 Ω",{"_215":258,"_108":259,"_218":260,"_220":-5},"display-range","Display range","-1999～1999",{"_215":262,"_108":263,"_218":264,"_220":-5},"protection","Protection level","IP65",{"_215":266,"_108":267,"_218":268,"_220":-5},"explosion-protection","Explosion proof level","dII BT6",{"_215":270,"_108":271,"_218":272,"_220":-5},"protective-tube-material","Material of protective tube","1Cr18Ni9Ti or ceramic or steel jade tube","sourceReviews",[],"documents",[],"supportDownloads",[]]
