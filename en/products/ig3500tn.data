avigation",[102,118],{"_103":104,"_105":106},"title","Products","links",[107,112,115],{"_108":109,"_110":111},"label","Water analysis","href","/en/products?category=water",{"_108":113,"_110":114},"Industrial measurement","/en/products?category=industrial",{"_108":116,"_110":117},"Gas detection","/en/products?category=gas",{"_103":119,"_105":120},"Explore",[121,123,126,129,132],{"_108":79,"_110":122},"/en/about",{"_108":124,"_110":125},"Customer cases","/en/cases",{"_108":127,"_110":128},"News","/en/news",{"_108":130,"_110":131},"After-sales service","/en/service",{"_108":133,"_110":134},"Downloads","/en/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig3500tn",[],[],"seo",{"_103":145,"_146":147,"_148":149,"_150":151},"IG3500TN Total Nitrogen Analyzer | IGENU SCIENCE","description","Alkaline persulfate digestion followed by ultraviolet spectrophotometry determines total nitrogen in water. Automatic range switching, quality-control checks and measurement logs support online operation, with communication and alarm functions for integration into environmental and wastewater monitoring systems.","imageUrl","/igenu-preview/media/076a24550dfec7d99b95ba88.png","index",true,"canonical","https://eicloc.github.io/igenu-preview/en/products/ig3500tn","query",{},"selected",[],"detail",{"_160":161,"_57":140,"_162":163,"_164":165,"_166":147,"_167":168,"_169":170,"_174":175,"_198":199,"_200":201,"_146":-5,"_202":203,"_204":205,"_206":207,"_208":209,"_284":285,"_286":287,"_288":289,"_143":144},"id","f339fd2d-ce7e-4de5-80dc-4651311a7f1c","model","IG3500TN","name","IG3500TN Total Nitrogen Analyzer","shortDescription","featured",false,"category",{"_57":171,"_172":-5,"_164":109,"_146":-5,"_143":173},"water","brand",{"_103":109,"_146":-5,"_148":-5,"_150":151},"heroImage",{"_160":176,"_139":177,"_178":179,"_180":181,"_182":183,"_184":185,"_186":187,"_188":189,"_190":149,"_191":192,"_193":194},"bfda7f5e-e504-4c40-85f0-1afea6d4aba3","IMAGE","originalName","2025040938476253.jpg","mimeType","image/png","size",51146,"sha256","076a24550dfec7d99b95ba8827dbead49c4506dc3d55d9d8b47b0c95d2a2c36e","width",267,"height",435,"url","createdAt","2026-10-20T17:32:39.824Z","variants",[195],{"_186":187,"_188":189,"_180":196,"_190":197},"image/webp","/igenu-preview/media/f3d468788765b050ceafe139.webp","detailLayout","STRUCTURED","availableLocales",[19,20,11],"bodyHtml","<p><strong>Product features:</strong><br />◆High range measurement of low concentration: using ring sampling to reducedilution times and improve repeatability. The new acceptance standard requiresthe instrument range to be 2-3 times the emission standard, but the actualconcentration of the discharged water sample is very low. In response to thissituation of measuring low concentration with a high range, the advantages areparticularly obvious<br />◆Innovative measurement method (patent) (1) with anti turbidity interferenceautomatic compensation function, which will not make measurement errors whencollecting turbid water samples; (2) with bubble elimination function, whichhas a significant effect on wastewater with bubbles, such as photovoltaicplants, printing and dyeing plants, etc<br />◆ Automatic range switching function: Choose any combination of low range andhigh range, and the instrument will automatically switch to the optimal rangebased on the actual water sample concentration<br />◆ Multiple quality control functions: zero point/span/standard sampleverification, blank testing, reserved parallel sample and spiked recoveryinterface<br />◆Multiple measurement modes, key parameter display, operation, verification,calibration logs, upper and lower limit warning<br />◆ Power on self-test, automatic reset, liquid shortage alarm, power-offprotection, waste liquid separation<br />◆ Supports 2-channel RS232/485, 2-channel 4-20mA communication interfaces, andreal-time data printing for printers<br />◆ (Optional) Cloud monitoring function: Real time monitoring of instrument statuson mobile phones, remote alarm, remote fault diagnosis<br />◆ (Optional) Reagent Refrigeration: Equipped with a reagent refrigeration boxto extend the reagent warranty period<br /><strong>Application areas:</strong><br />Surface water, groundwater, tap water, drinking water, municipal sewage,industrial wastewater</p><strong><span>Technical parameters:</span></strong><br />Detection range: 0.02~5mg/L; 0.05~10mg/L; 0.1~100mg/L <br />Measurement principle: Alkaline potassium persulfate digestion UV spectrophotometry<br />Accuracy: 0.02~5mg/L: ± 0.02 mg/L or reading 2% 0.05~10mg/L: ± 0.05 mg/L or reading 3% 0.1~100 mg/L: ± 0.1 mg/L or reading 3%<br />Repeatability: ≤ 2%<br />Zero drift: ± 5%<br />Range drift: ± 5%<br />Data storage: ≥ 48000 records<br />Environmental requirements: temperature+5-28 ° C: humidity&lt;90%<br />Measurement cycle: 20~50min<br />MTBF: ≥ 720h/time<br />Communication interface: 4-20mA RS232、RS485 <br />Insulation impedance: above 2M Ω<br />Power Supply: AC ( 220+20 ) V ( 50+0.5 ) Hz ，5A <br />Power consumption: 150W<br />Quantitative lower limit: ≤ 0.05mg/L <br />Minimum detection limit: 0.05mg/L<br />Size: 500mm * 445mm * 1355mm\n    ","gallery",[],"features",[],"specificationGroups",[210],{"_164":211,"_212":213},"Technical specifications","specifications",[214,221,225,229,233,237,240,244,248,252,256,260,264,268,272,276,280],{"_215":216,"_108":217,"_218":219,"_220":-5},"key","measurement-range","Detection range","value","0.02~5mg/L; 0.05~10mg/L; 0.1~100mg/L","unit",{"_215":222,"_108":223,"_218":224,"_220":-5},"measurement-principle","Measurement principle","Alkaline potassium persulfate digestion UV spectrophotometry",{"_215":226,"_108":227,"_218":228,"_220":-5},"accuracy","Accuracy","0.02~5mg/L: ± 0.02 mg/L or reading 2% 0.05~10mg/L: ± 0.05 mg/L or reading 3% 0.1~100 mg/L: ± 0.1 mg/L or reading 3%",{"_215":230,"_108":231,"_218":232,"_220":-5},"repeatability","Repeatability","≤ 2%",{"_215":234,"_108":235,"_218":236,"_220":-5},"zero-drift","Zero drift","± 5%",{"_215":238,"_108":239,"_218":236,"_220":-5},"range-drift","Range drift",{"_215":241,"_108":242,"_218":243,"_220":-5},"data-storage","Data storage","≥ 48000 records",{"_215":245,"_108":246,"_218":247,"_220":-5},"environment-requirements","Environmental requirements","temperature+5-28 ° C: humidity<90%",{"_215":249,"_108":250,"_218":251,"_220":-5},"measurement-cycle","Measurement cycle","20~50min",{"_215":253,"_108":254,"_218":255,"_220":-5},"mtbf","MTBF","≥ 720h/time",{"_215":257,"_108":258,"_218":259,"_220":-5},"digital-communication","Communication interface","4-20mA RS232、RS485",{"_215":261,"_108":262,"_218":263,"_220":-5},"insulation","Insulation impedance","above 2M Ω",{"_215":265,"_108":266,"_218":267,"_220":-5},"power-supply","Power Supply","AC ( 220+20 ) V ( 50+0.5 ) Hz ，5A",{"_215":269,"_108":270,"_218":271,"_220":-5},"power-consumption","Power consumption","150W",{"_215":273,"_108":274,"_218":275,"_220":-5},"quantitative-limit","Quantitative lower limit","≤ 0.05mg/L",{"_215":277,"_108":278,"_218":279,"_220":-5},"detection-limit","Minimum detection limit","0.05mg/L",{"_215":281,"_108":282,"_218":283,"_220":-5},"dimensions","Size","500mm * 445mm * 1355mm","sourceReviews",[],"documents",[],"supportDownloads",[]]
