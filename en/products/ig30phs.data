avigation",[102,118],{"_103":104,"_105":106},"title","Products","links",[107,112,115],{"_108":109,"_110":111},"label","Water analysis","href","/en/products?category=water",{"_108":113,"_110":114},"Industrial measurement","/en/products?category=industrial",{"_108":116,"_110":117},"Gas detection","/en/products?category=gas",{"_103":119,"_105":120},"Explore",[121,123,126,129,132],{"_108":79,"_110":122},"/en/about",{"_108":124,"_110":125},"Customer cases","/en/cases",{"_108":127,"_110":128},"News","/en/news",{"_108":130,"_110":131},"After-sales service","/en/service",{"_108":133,"_110":134},"Downloads","/en/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig30phs",[],[],"seo",{"_103":145,"_146":147,"_148":149,"_150":151},"IG30PHS Digital pH Electrode | IGENU SCIENCE","description","Digital pH measurement combines a gel-filled electrode, double-junction reference and integrated temperature sensing. Modbus communication supports connection to compatible controllers, while calibration options and the supplied mounting bracket and flow cell support installation and routine operation.","imageUrl","/igenu-preview/media/7dfe5452c927d26232963ff8.jpg","index",true,"canonical","https://eicloc.github.io/igenu-preview/en/products/ig30phs","query",{},"selected",[],"detail",{"_160":161,"_57":140,"_162":163,"_164":165,"_166":147,"_167":151,"_168":169,"_173":174,"_201":202,"_203":204,"_146":-5,"_205":206,"_207":208,"_209":210,"_211":212,"_304":305,"_306":307,"_308":309,"_143":144},"id","331a2881-86de-42d4-aad2-8985fb41f4ba","model","IG30PHS","name","IG30PHS Digital pH Electrode","shortDescription","featured","category",{"_57":170,"_171":-5,"_164":109,"_146":-5,"_143":172},"water","brand",{"_103":109,"_146":-5,"_148":-5,"_150":151},"heroImage",{"_160":175,"_139":176,"_177":178,"_179":180,"_181":182,"_183":184,"_185":186,"_187":188,"_189":149,"_190":191,"_192":193},"7507b7cd-7dc3-42b2-90a4-f843106d4461","IMAGE","originalName","2025040859520101.png","mimeType","image/jpeg","size",19079,"sha256","7dfe5452c927d26232963ff85f11073f15b9d29010abcb394bea3ce0f2f502d6","width",358,"height",302,"url","createdAt","2026-10-20T17:32:39.754Z","variants",[194,199],{"_185":195,"_187":196,"_179":197,"_189":198},320,270,"image/webp","/igenu-preview/media/93a066c50a54638353b43bbf.webp",{"_185":186,"_187":188,"_179":197,"_189":200},"/igenu-preview/media/b72cc265fa7500183b25c7da.webp","detailLayout","STRUCTURED","availableLocales",[19,20,11],"bodyHtml","<strong><span>Product features:</span></strong><br />◆ Rich configuration to meet various working conditions requirements<br />◆ Built in temperature sensor, automatic temperature compensation<br />◆ Automatic identification of standard solution, optional 1-point, 2-point standard solution calibration, and 1-point sample calibration<br />◆ Digital sensor, standard Modbus RTU protocol, not affected by transmission distance, better stability<br />◆The sensor is made of Ryton material, which has a longer service life and reduces maintenance and downtime<br />◆ Large capacity microporous double salt bridge makes the probe more resistant to toxicity and has a longer service life<br />◆ Thick and high impedance bubble with strong structural strength, not easily damaged by particle impact<br />◆ Shielded shell packaging, not affected by environmental electromagnetic interference<br /><strong><span>Application areas:</span></strong><br />Surface water, municipal sewage, environmental monitoring, industrial process control, pollution sources, industrial wastewater, tap water, biopharmaceuticals, beer and beverage, petroleum and petrochemical, metallurgy<br /><strong><span>Technical parameters:</span></strong><br />Measurement range: 0-14pH; Temperature:- 5-105℃<br />Resolution: 0.01 pH, 0.1 ℃<br />Accuracy: ± 0.01 pH<br />Repeatability: 0.01 pH<br />Working environment: 0-95 ℃<br />Response time: up to 95% in 30 seconds<br />Drift: ≤ 0.02 pH/24h without accumulation<br />Maximum pressure: 8.0bar<br />Maximum flow velocity: 3 meters per second<br />Calibration method: One point sample, one point standard solution, two-point standard solution calibration<br />Standard solution selection: manual, automatic<br />Temperature compensation: automatic<br />Temperature electrode: PT1000<br />Electrode form: digital electrode<br />Reference electrode: PTFE porous salt bridge liquid connection<br />Communication interface: ModbusRS485<br />Electrode material: PEEK、Ryton<br />Threaded interface: Front and rear standard 3/4NPT<br />Protection level: IP68<br />Cable length: Standard 10m, extendable<br />Electrode size: 165mm * 25mm\n    ","gallery",[],"features",[],"specificationGroups",[213],{"_164":214,"_215":216},"Technical specifications","specifications",[217,224,228,232,236,240,244,248,252,256,260,264,268,272,276,280,284,288,292,296,300],{"_218":219,"_108":220,"_221":222,"_223":-5},"key","measurement-range","Measurement range","value","0-14pH; Temperature:- 5-105℃","unit",{"_218":225,"_108":226,"_221":227,"_223":-5},"resolution","Resolution","0.01 pH, 0.1 ℃",{"_218":229,"_108":230,"_221":231,"_223":-5},"accuracy","Accuracy","± 0.01 pH",{"_218":233,"_108":234,"_221":235,"_223":-5},"repeatability","Repeatability","0.01 pH",{"_218":237,"_108":238,"_221":239,"_223":-5},"operating-temperature","Working environment","0-95 ℃",{"_218":241,"_108":242,"_221":243,"_223":-5},"response-time","Response time","up to 95% in 30 seconds",{"_218":245,"_108":246,"_221":247,"_223":-5},"drift","Drift","≤ 0.02 pH/24h without accumulation",{"_218":249,"_108":250,"_221":251,"_223":-5},"maximum-pressure","Maximum pressure","8.0bar",{"_218":253,"_108":254,"_221":255,"_223":-5},"maximum-flow","Maximum flow velocity","3 meters per second",{"_218":257,"_108":258,"_221":259,"_223":-5},"calibration","Calibration method","One point sample, one point standard solution, two-point standard solution calibration",{"_218":261,"_108":262,"_221":263,"_223":-5},"standard-solution","Standard solution selection","manual, automatic",{"_218":265,"_108":266,"_221":267,"_223":-5},"temperature-compensation","Temperature compensation","automatic",{"_218":269,"_108":270,"_221":271,"_223":-5},"temperature-electrode","Temperature electrode","PT1000",{"_218":273,"_108":274,"_221":275,"_223":-5},"electrode-form","Electrode form","digital electrode",{"_218":277,"_108":278,"_221":279,"_223":-5},"reference-electrode","Reference electrode","PTFE porous salt bridge liquid connection",{"_218":281,"_108":282,"_221":283,"_223":-5},"digital-communication","Communication interface","ModbusRS485",{"_218":285,"_108":286,"_221":287,"_223":-5},"electrode-material","Electrode material","PEEK、Ryton",{"_218":289,"_108":290,"_221":291,"_223":-5},"thread","Threaded interface","Front and rear standard 3/4NPT",{"_218":293,"_108":294,"_221":295,"_223":-5},"protection","Protection level","IP68",{"_218":297,"_108":298,"_221":299,"_223":-5},"cable","Cable length","Standard 10m, extendable",{"_218":301,"_108":302,"_221":303,"_223":-5},"electrode-size","Electrode size","165mm * 25mm","sourceReviews",[],"documents",[],"supportDownloads",[]]
