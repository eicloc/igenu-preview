avigation",[102,118],{"_103":104,"_105":106},"title","Products","links",[107,112,115],{"_108":109,"_110":111},"label","Water analysis","href","/en/products?category=water",{"_108":113,"_110":114},"Industrial measurement","/en/products?category=industrial",{"_108":116,"_110":117},"Gas detection","/en/products?category=gas",{"_103":119,"_105":120},"Explore",[121,123,126,129,132],{"_108":79,"_110":122},"/en/about",{"_108":124,"_110":125},"Customer cases","/en/cases",{"_108":127,"_110":128},"News","/en/news",{"_108":130,"_110":131},"After-sales service","/en/service",{"_108":133,"_110":134},"Downloads","/en/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig30rps",[],[],"seo",{"_103":145,"_146":147,"_148":149,"_150":151},"IG30RPS Digital ORP Electrode | IGENU SCIENCE","description","A digital ORP electrode for oxidation-reduction monitoring in water and industrial processes. Its platinum sensing element and double-junction reference are complemented by digital communication, sample or standard calibration, and a mounting bracket and flow cell for installation.","imageUrl","/igenu-preview/media/7dfe5452c927d26232963ff8.jpg","index",true,"canonical","https://eicloc.github.io/igenu-preview/en/products/ig30rps","query",{},"selected",[],"detail",{"_160":161,"_57":140,"_162":163,"_164":165,"_166":147,"_167":168,"_169":170,"_174":175,"_202":203,"_204":205,"_146":-5,"_206":207,"_208":209,"_210":211,"_212":213,"_289":290,"_291":292,"_293":294,"_143":144},"id","443d766d-df72-4a5d-a984-9164160231c6","model","IG30RPS","name","IG30RPS Digital ORP Electrode","shortDescription","featured",false,"category",{"_57":171,"_172":-5,"_164":109,"_146":-5,"_143":173},"water","brand",{"_103":109,"_146":-5,"_148":-5,"_150":151},"heroImage",{"_160":176,"_139":177,"_178":179,"_180":181,"_182":183,"_184":185,"_186":187,"_188":189,"_190":149,"_191":192,"_193":194},"7507b7cd-7dc3-42b2-90a4-f843106d4461","IMAGE","originalName","2025040859520101.png","mimeType","image/jpeg","size",19079,"sha256","7dfe5452c927d26232963ff85f11073f15b9d29010abcb394bea3ce0f2f502d6","width",358,"height",302,"url","createdAt","2026-10-20T17:32:39.754Z","variants",[195,200],{"_186":196,"_188":197,"_180":198,"_190":199},320,270,"image/webp","/igenu-preview/media/93a066c50a54638353b43bbf.webp",{"_186":187,"_188":189,"_180":198,"_190":201},"/igenu-preview/media/b72cc265fa7500183b25c7da.webp","detailLayout","STRUCTURED","availableLocales",[19,20,11],"bodyHtml","<strong><span>Product features:</span></strong><br />◆ Rich configuration to meet various working conditions requirements<br />◆ Built in temperature sensor, automatic temperature compensation<br />◆ Automatic identification of standard solution, one point sample calibration<br />The sensor is made of Ryton material, which has a longer service life and reduces maintenance and downtime<br />◆ Large capacity microporous double salt bridge makes the probe more resistant to toxicity and has a longer service life<br />◆ Thick and high impedance bubble with strong structural strength, not easily damaged by particle impact<br />◆ Ultra large platinum electrode improves the response speed and pollution resistance of ORP electrode<br />◆ Digital sensor, RS-485 output, standard Modbus RTU protocol, not affected by transmission distance, better stability<br />◆ Shielded shell packaging, not affected by environmental electromagnetic interference<br /><strong><span>Application areas:</span></strong><br />Surface water, municipal sewage, environmental monitoring, industrial process control, pollution sources, industrial wastewater, tap water, biopharmaceuticals, beer and beverage, petroleum and petrochemical, metallurgy<br /><strong><span>Technical parameters:</span></strong><br />Measurement range: ± 1999mV; Temperature:- 5-95℃<br />Resolution: 0.1 mV, 0.1 ℃<br />Accuracy: ± 0.5 mV<br />Working environment: 0-95 ℃<br />Response time: up to 95% in 30 seconds<br />Maximum pressure: 8.0bar<br />Maximum flow velocity: 3 meters per second<br />Calibration method: One point sample, one point standard solution calibration<br />Temperature electrode: PT1000<br />Electrode form: digital electrode<br />Reference electrode: PTFE porous salt bridge liquid connection<br />Communication interface: ModbusRS485<br />Electrode material: PEEK、Ryton<br />Threaded interface: Front and rear standard 3/4NPT<br />Protection level: IP68<br />Cable length: Standard 10m, extendable<br />Electrode size: 165mm * 25mm\n    ","gallery",[],"features",[],"specificationGroups",[214],{"_164":215,"_216":217},"Technical specifications","specifications",[218,225,229,233,237,241,245,249,253,257,261,265,269,273,277,281,285],{"_219":220,"_108":221,"_222":223,"_224":-5},"key","measurement-range","Measurement range","value","± 1999mV; Temperature:- 5-95℃","unit",{"_219":226,"_108":227,"_222":228,"_224":-5},"resolution","Resolution","0.1 mV, 0.1 ℃",{"_219":230,"_108":231,"_222":232,"_224":-5},"accuracy","Accuracy","± 0.5 mV",{"_219":234,"_108":235,"_222":236,"_224":-5},"operating-temperature","Working environment","0-95 ℃",{"_219":238,"_108":239,"_222":240,"_224":-5},"response-time","Response time","up to 95% in 30 seconds",{"_219":242,"_108":243,"_222":244,"_224":-5},"maximum-pressure","Maximum pressure","8.0bar",{"_219":246,"_108":247,"_222":248,"_224":-5},"maximum-flow","Maximum flow velocity","3 meters per second",{"_219":250,"_108":251,"_222":252,"_224":-5},"calibration","Calibration method","One point sample, one point standard solution calibration",{"_219":254,"_108":255,"_222":256,"_224":-5},"temperature-electrode","Temperature electrode","PT1000",{"_219":258,"_108":259,"_222":260,"_224":-5},"electrode-form","Electrode form","digital electrode",{"_219":262,"_108":263,"_222":264,"_224":-5},"reference-electrode","Reference electrode","PTFE porous salt bridge liquid connection",{"_219":266,"_108":267,"_222":268,"_224":-5},"digital-communication","Communication interface","ModbusRS485",{"_219":270,"_108":271,"_222":272,"_224":-5},"electrode-material","Electrode material","PEEK、Ryton",{"_219":274,"_108":275,"_222":276,"_224":-5},"thread","Threaded interface","Front and rear standard 3/4NPT",{"_219":278,"_108":279,"_222":280,"_224":-5},"protection","Protection level","IP68",{"_219":282,"_108":283,"_222":284,"_224":-5},"cable","Cable length","Standard 10m, extendable",{"_219":286,"_108":287,"_222":288,"_224":-5},"electrode-size","Electrode size","165mm * 25mm","sourceReviews",[],"documents",[],"supportDownloads",[]]
