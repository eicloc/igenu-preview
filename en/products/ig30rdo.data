avigation",[102,118],{"_103":104,"_105":106},"title","Products","links",[107,112,115],{"_108":109,"_110":111},"label","Water analysis","href","/en/products?category=water",{"_108":113,"_110":114},"Industrial measurement","/en/products?category=industrial",{"_108":116,"_110":117},"Gas detection","/en/products?category=gas",{"_103":119,"_105":120},"Explore",[121,123,126,129,132],{"_108":79,"_110":122},"/en/about",{"_108":124,"_110":125},"Customer cases","/en/cases",{"_108":127,"_110":128},"News","/en/news",{"_108":130,"_110":131},"After-sales service","/en/service",{"_108":133,"_110":134},"Downloads","/en/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig30rdo",[],[],"seo",{"_103":145,"_146":147,"_148":149,"_150":151},"IG30RDO Optical Dissolved Oxygen Sensor | IGENU SCIENCE","description","Fluorescence-based sensing measures dissolved oxygen without electrolyte replacement or sensor polarization. Integrated temperature compensation and digital communication support continuous water monitoring, with air and sample calibration options for use in treatment, environmental and aquaculture applications.","imageUrl","/igenu-preview/media/1513162129cbcc0b7fb98e96.jpg","index",true,"canonical","https://eicloc.github.io/igenu-preview/en/products/ig30rdo","query",{},"selected",[],"detail",{"_160":161,"_57":140,"_162":163,"_164":165,"_166":147,"_167":151,"_168":169,"_173":174,"_201":202,"_203":204,"_146":-5,"_205":206,"_207":208,"_209":210,"_211":212,"_300":301,"_302":303,"_304":305,"_143":144},"id","f607cd0f-5835-4426-b788-827be959a3fc","model","IG30RDO","name","IG30RDO Optical Dissolved Oxygen Sensor","shortDescription","featured","category",{"_57":170,"_171":-5,"_164":109,"_146":-5,"_143":172},"water","brand",{"_103":109,"_146":-5,"_148":-5,"_150":151},"heroImage",{"_160":175,"_139":176,"_177":178,"_179":180,"_181":182,"_183":184,"_185":186,"_187":188,"_189":149,"_190":191,"_192":193},"0ddcf618-0714-49aa-9919-74ce97332e9e","IMAGE","originalName","2025040860317013.png","mimeType","image/jpeg","size",19493,"sha256","1513162129cbcc0b7fb98e96f5e5a24329832e50befa0944e7b17725123db89a","width",458,"height",293,"url","createdAt","2026-10-20T17:32:39.769Z","variants",[194,199],{"_185":195,"_187":196,"_179":197,"_189":198},320,205,"image/webp","/igenu-preview/media/875a6bfa76d0d60b22d59c3d.webp",{"_185":186,"_187":188,"_179":197,"_189":200},"/igenu-preview/media/676768d13901a89005e95e68.webp","detailLayout","STRUCTURED","availableLocales",[19,20,11],"bodyHtml","<strong><span>Product features:</span></strong><br />◆ Built in temperature sensor, automatic temperature compensation<br />◆Fluorescence method, no need to replace membrane and electrolyte, air calibration, simple and fast<br />◆ Digital sensor, RS-485 output, standard Modbus RTU protocol, not affected by transmission distance, better stability ◆ The sensor is made of titanium alloy material, with a longer service life, reducing maintenance and downtime<br />◆ No polarization required, fast response time<br />◆ Not affected by pH fluctuations CO2、 Interference from sulfides, hydrogen sulfide, sulfates, chlorides, ammonia nitrogen, and heavy metals<br />◆ Not affected by flow velocity interference and able to withstand severe impacts<br /><strong><span>Application areas:</span></strong><br />Municipal sewage, industrial wastewater, environmental monitoring, monitoring of drinking and surface water, industrial processes, aquaculture, biological processes<br /><strong><span>Technical parameters:</span></strong><br />Range: 0~20mg/L or 0~200% saturation, 0~65 ℃<br />Measurement principle: Fluorescence method<br />Measurement accuracy: ± 0.1 mg/L when below 5 mg/L<br />When it exceeds 5 mg/L, it is ± 0.2 mg/L<br />Temperature: ±0.1°C<br />Response time: 95% achieved in 37 seconds at 20 ℃<br />Repeatability: ± 0.1mg/L<br />Resolution: 0.01mg/L<br />Maximum pressure: 23bar @ 50 ℃<br />Maximum flow rate: No flow rate requirement<br />Calibration methods: saturated air calibration, 1-point sample calibration, zero point calibration, 1-point temperature calibration<br />Electrode body material: titanium alloy<br />Threaded interface: standard 3/4NPT<br />Sensor communication: MODBUS RS-485 <br />Temperature electrode: PT1000<br />Electrode form: digital electrode<br />Communication interface: ModbusRS485<br />Storage temperature:- 15~60℃ <br />Working temperature: 0~65 ℃ (non freezing)<br />Protection level: IP68<br />Cable length: Standard 10m, extendable<br />Sensor size: 151mm * 26mm\n    ","gallery",[],"features",[],"specificationGroups",[213],{"_164":214,"_215":216},"Technical specifications","specifications",[217,224,228,232,236,240,244,248,252,256,260,264,268,272,276,280,284,288,292,296],{"_218":219,"_108":220,"_221":222,"_223":-5},"key","measurement-range","Range","value","0~20mg/L or 0~200% saturation, 0~65 ℃","unit",{"_218":225,"_108":226,"_221":227,"_223":-5},"measurement-principle","Measurement principle","Fluorescence method",{"_218":229,"_108":230,"_221":231,"_223":-5},"accuracy","Measurement accuracy","± 0.1 mg/L when below 5 mg/L",{"_218":233,"_108":234,"_221":235,"_223":-5},"temperature","Temperature","±0.1°C",{"_218":237,"_108":238,"_221":239,"_223":-5},"response-time","Response time","95% achieved in 37 seconds at 20 ℃",{"_218":241,"_108":242,"_221":243,"_223":-5},"repeatability","Repeatability","± 0.1mg/L",{"_218":245,"_108":246,"_221":247,"_223":-5},"resolution","Resolution","0.01mg/L",{"_218":249,"_108":250,"_221":251,"_223":-5},"maximum-pressure","Maximum pressure","23bar @ 50 ℃",{"_218":253,"_108":254,"_221":255,"_223":-5},"maximum-flow","Maximum flow rate","No flow rate requirement",{"_218":257,"_108":258,"_221":259,"_223":-5},"calibration","Calibration methods","saturated air calibration, 1-point sample calibration, zero point calibration, 1-point temperature calibration",{"_218":261,"_108":262,"_221":263,"_223":-5},"electrode-body-material","Electrode body material","titanium alloy",{"_218":265,"_108":266,"_221":267,"_223":-5},"thread","Threaded interface","standard 3/4NPT",{"_218":269,"_108":270,"_221":271,"_223":-5},"digital-communication","Sensor communication","MODBUS RS-485; ModbusRS485",{"_218":273,"_108":274,"_221":275,"_223":-5},"temperature-electrode","Temperature electrode","PT1000",{"_218":277,"_108":278,"_221":279,"_223":-5},"electrode-form","Electrode form","digital electrode",{"_218":281,"_108":282,"_221":283,"_223":-5},"storage-temperature","Storage temperature","- 15~60℃",{"_218":285,"_108":286,"_221":287,"_223":-5},"operating-temperature","Working temperature","0~65 ℃ (non freezing)",{"_218":289,"_108":290,"_221":291,"_223":-5},"protection","Protection level","IP68",{"_218":293,"_108":294,"_221":295,"_223":-5},"cable","Cable length","Standard 10m, extendable",{"_218":297,"_108":298,"_221":299,"_223":-5},"sensor-size","Sensor size","151mm * 26mm","sourceReviews",[],"documents",[],"supportDownloads",[]]
