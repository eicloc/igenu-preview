avigation",[102,118],{"_103":104,"_105":106},"title","Products","links",[107,112,115],{"_108":109,"_110":111},"label","Water analysis","href","/en/products?category=water",{"_108":113,"_110":114},"Industrial measurement","/en/products?category=industrial",{"_108":116,"_110":117},"Gas detection","/en/products?category=gas",{"_103":119,"_105":120},"Explore",[121,123,126,129,132],{"_108":79,"_110":122},"/en/about",{"_108":124,"_110":125},"Customer cases","/en/cases",{"_108":127,"_110":128},"News","/en/news",{"_108":130,"_110":131},"After-sales service","/en/service",{"_108":133,"_110":134},"Downloads","/en/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig30ptco",[],[],"seo",{"_103":145,"_146":147,"_148":149,"_150":151},"IG30PTCO Water Color Sensor | IGENU SCIENCE","description","Optical absorption measures water color against the platinum-cobalt color scale. Automatic turbidity compensation and a cleaning brush support online monitoring, while stored calibration settings and digital communication simplify connection to water monitoring systems at the installation site.","imageUrl","/igenu-preview/media/3a4bd3a9ba0af3bd90061177.jpg","index",true,"canonical","https://eicloc.github.io/igenu-preview/en/products/ig30ptco","query",{},"selected",[],"detail",{"_160":161,"_57":140,"_162":163,"_164":165,"_166":147,"_167":168,"_169":170,"_174":175,"_200":201,"_202":203,"_146":-5,"_204":205,"_206":207,"_208":209,"_210":211,"_271":272,"_273":274,"_275":276,"_143":144},"id","f98a1a11-9b74-4b87-a91b-1548d296a61a","model","IG30PTCO","name","IG30PTCO Water Color Sensor","shortDescription","featured",false,"category",{"_57":171,"_172":-5,"_164":109,"_146":-5,"_143":173},"water","brand",{"_103":109,"_146":-5,"_148":-5,"_150":151},"heroImage",{"_160":176,"_139":177,"_178":179,"_180":181,"_182":183,"_184":185,"_186":187,"_188":187,"_189":149,"_190":191,"_192":193},"e9c2938f-6236-4c7f-bf9d-752bcf98b444","IMAGE","originalName","2025040861512869.jpg","mimeType","image/jpeg","size",13520,"sha256","3a4bd3a9ba0af3bd90061177b116d1a851d9d410ca383514dfbd7fdb3aa5270f","width",540,"height","url","createdAt","2026-10-20T17:32:39.805Z","variants",[194,198],{"_186":195,"_188":195,"_180":196,"_189":197},320,"image/webp","/igenu-preview/media/9fb61c06fe27bcc0e9cecfd6.webp",{"_186":187,"_188":187,"_180":196,"_189":199},"/igenu-preview/media/b63396be40013d2d55e983f5.webp","detailLayout","STRUCTURED","availableLocales",[19,20,11],"bodyHtml","<strong><span>Product features:</span></strong><br />◆ Digital sensor, RS-485 output, MODBUS protocol<br />◆Equipped with an automatic cleaning brush to prevent contamination and eliminate bubbles<br />◆ Automatically compensates for turbidity interference and has good testing performance<br />◆ Built in calibration parameters, precisely calibrated at the factory, can be directly installed and used<br /><span><strong>Application areas:</strong></span><br />Drinking water monitoring, surface water monitoring, hospitals, industrial enterprises, environmental protection<br /><span><strong>Technical parameters:</strong></span><br />Measurement range: 0-50Pt Co<br />Measurement principle: optical method (platinum cobalt color standard)<br />Measurement accuracy: ± 2% FS<br />Repeatability: less than ± 2%<br />Sensor material: Body: SUS316L； Window: Sapphire<br />Self cleaning: automatic scraping brush<br />Sensor communication: MODBUS RS-485 <br />Storage temperature:- 10~50℃ <br />Working temperature: 0~50 ℃ (non freezing)<br />Protection level: IP68 <br />Power consumption:&lt; 2W<br />Cable length: Standard 10m, extendable<br />Sensor size: 212mm * 50mm\n    ","gallery",[],"features",[],"specificationGroups",[212],{"_164":213,"_214":215},"Technical specifications","specifications",[216,223,227,231,235,239,243,247,251,255,259,263,267],{"_217":218,"_108":219,"_220":221,"_222":-5},"key","measurement-range","Measurement range","value","0-50Pt Co","unit",{"_217":224,"_108":225,"_220":226,"_222":-5},"measurement-principle","Measurement principle","optical method (platinum cobalt color standard)",{"_217":228,"_108":229,"_220":230,"_222":-5},"accuracy","Measurement accuracy","± 2% FS",{"_217":232,"_108":233,"_220":234,"_222":-5},"repeatability","Repeatability","less than ± 2%",{"_217":236,"_108":237,"_220":238,"_222":-5},"sensor-material","Sensor material","Body: SUS316L； Window: Sapphire",{"_217":240,"_108":241,"_220":242,"_222":-5},"self-cleaning","Self cleaning","automatic scraping brush",{"_217":244,"_108":245,"_220":246,"_222":-5},"digital-communication","Sensor communication","MODBUS RS-485",{"_217":248,"_108":249,"_220":250,"_222":-5},"storage-temperature","Storage temperature","- 10~50℃",{"_217":252,"_108":253,"_220":254,"_222":-5},"operating-temperature","Working temperature","0~50 ℃ (non freezing)",{"_217":256,"_108":257,"_220":258,"_222":-5},"protection","Protection level","IP68",{"_217":260,"_108":261,"_220":262,"_222":-5},"power-consumption","Power consumption","< 2W",{"_217":264,"_108":265,"_220":266,"_222":-5},"cable","Cable length","Standard 10m, extendable",{"_217":268,"_108":269,"_220":270,"_222":-5},"sensor-size","Sensor size","212mm * 50mm","sourceReviews",[],"documents",[],"supportDownloads",[]]
