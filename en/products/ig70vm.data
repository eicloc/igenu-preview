avigation",[102,118],{"_103":104,"_105":106},"title","Products","links",[107,112,115],{"_108":109,"_110":111},"label","Water analysis","href","/en/products?category=water",{"_108":113,"_110":114},"Industrial measurement","/en/products?category=industrial",{"_108":116,"_110":117},"Gas detection","/en/products?category=gas",{"_103":119,"_105":120},"Explore",[121,123,126,129,132],{"_108":79,"_110":122},"/en/about",{"_108":124,"_110":125},"Customer cases","/en/cases",{"_108":127,"_110":128},"News","/en/news",{"_108":130,"_110":131},"After-sales service","/en/service",{"_108":133,"_110":134},"Downloads","/en/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig70vm",[],[],"seo",{"_103":145,"_146":147,"_148":149,"_150":151},"IG70VM Thermal Gas Mass Flowmeter | IGENU SCIENCE","description","Thermal sensing measures gas mass flow using a heated reference element and a temperature comparison. With no moving sensing components and selectable signal interfaces, the instrument supports gas-flow monitoring in petrochemical, power generation and metallurgical processes.","imageUrl","/igenu-preview/media/7f449f38ed6bf8e134b99b22.png","index",true,"canonical","https://eicloc.github.io/igenu-preview/en/products/ig70vm","query",{},"selected",[],"detail",{"_160":161,"_57":140,"_162":163,"_164":165,"_166":147,"_167":168,"_169":170,"_174":175,"_198":199,"_200":201,"_146":-5,"_202":203,"_204":205,"_219":220,"_221":222,"_286":287,"_288":289,"_290":291,"_143":144},"id","c21fd893-48c8-47d3-a114-c7748db71a81","model","IG70VM","name","IG70VM Thermal Gas Mass Flowmeter","shortDescription","featured",false,"category",{"_57":171,"_172":-5,"_164":113,"_146":-5,"_143":173},"industrial","brand",{"_103":113,"_146":-5,"_148":-5,"_150":151},"heroImage",{"_160":176,"_139":177,"_178":179,"_180":181,"_182":183,"_184":185,"_186":187,"_188":189,"_190":149,"_191":192,"_193":194},"287d31f2-573d-40b0-8a95-78fa8fb30365","IMAGE","originalName","2025040855196033.jpg","mimeType","image/png","size",118746,"sha256","7f449f38ed6bf8e134b99b22ebc9fa0c38477f3744c6a59cd166d471f92c6feb","width",255,"height",555,"url","createdAt","2026-10-20T17:32:39.741Z","variants",[195],{"_186":187,"_188":189,"_180":196,"_190":197},"image/webp","/igenu-preview/media/e43bee78aa0a1ae068fb4bf4.webp","detailLayout","STRUCTURED","availableLocales",[19,20,11],"bodyHtml","<strong><span>Product features:</span></strong><br />◆A true quality flowmeter that does not require temperature and pressure compensation for gas flow measurement, making measurement convenient and accurate. Can obtain the mass flow rate or standard volume flow rate of gas<br />◆ Wide range ratio, capable of measuring gases with flow rates ranging from 100Nm/s to 0.2Nm/s, and can be used for gas leak detection<br />◆Good seismic performance and long service life. The sensor has no moving parts or pressure sensing components, and is not affected by vibration on measurement accuracy<br />◆ Easy installation and maintenance. If on-site conditions permit, non-stop installation and maintenance can be achieved<br />◆Using RS-485 communication or HART communication, factory automation and integration can be achieved<br /><p><strong><span>Application areas:</span></strong></p>Petrochemical, Environmental Protection, Water Treatment, Thermal Power, Smelting, Medical<br /><p><strong><span>Technical parameters:</span></strong></p>Measurement medium: various gases (excluding acetylene gas)<br />Measurement range: DN10~4000mm  ND25~2000mm <br />Flow rate: 0.2~100Nm/s<br />Accuracy: ± 0.5%<br />Working temperature: Sensor: Room temperature type -10~200 ℃ High temperature type -10~350 ℃ Converter:- 20～45℃ <br />Work pressure: medium pressure ≤ 2.5Mpa medium pressure ≤ 4Mpa<br />Power supply: all-in-one machine (DC24V or AC220V ≤ 18W) split type (AC220V ≤ 19W)<br />Response speed: 1S<br />Output: 4-20mA (photoelectric isolation, maximum load 500 Ω), RS485 (photoelectric isolation), HART protocol<br />Pipeline material: carbon steel, stainless steel, plastic, etc<br />Display: Four line LCD display<br />Display content: mass flow rate, standard condition volume flow rate, cumulative flow rate, standard time, cumulative operating time, medium temperature, standard flow rate, etc<br />Protection level: IP67 for primary meter<br />Sensor Material: Stainless Steel/Carbon Steel\n    ","gallery",[206],{"_160":207,"_139":177,"_178":208,"_180":209,"_182":210,"_184":211,"_186":212,"_188":213,"_190":214,"_191":215,"_193":216},"065cc5b0-e98f-4705-b61d-45043501843d","2022042942150065.jpg","image/jpeg",16946,"4992623265b6e7526ebac02e17ae603479bf473915f8bd172a72f5ba5954fc5b",251,399,"/igenu-preview/media/4992623265b6e7526ebac02e.jpg","2026-10-20T17:32:39.680Z",[217],{"_186":212,"_188":213,"_180":196,"_190":218},"/igenu-preview/media/9e57d7becb2756c38d1975b2.webp","features",[],"specificationGroups",[223],{"_164":224,"_225":226},"Technical specifications","specifications",[227,234,238,242,246,250,254,258,262,266,270,274,278,282],{"_228":229,"_108":230,"_231":232,"_233":-5},"key","medium","Measurement medium","value","various gases (excluding acetylene gas)","unit",{"_228":235,"_108":236,"_231":237,"_233":-5},"measurement-range","Measurement range","DN10~4000mm  ND25~2000mm",{"_228":239,"_108":240,"_231":241,"_233":-5},"flow-rate","Flow rate","0.2~100Nm/s",{"_228":243,"_108":244,"_231":245,"_233":-5},"accuracy","Accuracy","± 0.5%",{"_228":247,"_108":248,"_231":249,"_233":-5},"operating-temperature","Working temperature","Sensor: Room temperature type -10~200 ℃ High temperature type -10~350 ℃ Converter:- 20～45℃",{"_228":251,"_108":252,"_231":253,"_233":-5},"pressure","Work pressure","medium pressure ≤ 2.5Mpa medium pressure ≤ 4Mpa",{"_228":255,"_108":256,"_231":257,"_233":-5},"power-supply","Power supply","all-in-one machine (DC24V or AC220V ≤ 18W) split type (AC220V ≤ 19W)",{"_228":259,"_108":260,"_231":261,"_233":-5},"response-time","Response speed","1S",{"_228":263,"_108":264,"_231":265,"_233":-5},"output","Output","4-20mA (photoelectric isolation, maximum load 500 Ω), RS485 (photoelectric isolation), HART protocol",{"_228":267,"_108":268,"_231":269,"_233":-5},"pipeline-material","Pipeline material","carbon steel, stainless steel, plastic, etc",{"_228":271,"_108":272,"_231":273,"_233":-5},"display","Display","Four line LCD display",{"_228":275,"_108":276,"_231":277,"_233":-5},"display-content","Display content","mass flow rate, standard condition volume flow rate, cumulative flow rate, standard time, cumulative operating time, medium temperature, standard flow rate, etc",{"_228":279,"_108":280,"_231":281,"_233":-5},"protection","Protection level","IP67 for primary meter",{"_228":283,"_108":284,"_231":285,"_233":-5},"sensor-material","Sensor Material","Stainless Steel/Carbon Steel","sourceReviews",[],"documents",[],"supportDownloads",[]]
