avigation",[102,118],{"_103":104,"_105":106},"title","Products","links",[107,112,115],{"_108":109,"_110":111},"label","Water analysis","href","/en/products?category=water",{"_108":113,"_110":114},"Industrial measurement","/en/products?category=industrial",{"_108":116,"_110":117},"Gas detection","/en/products?category=gas",{"_103":119,"_105":120},"Explore",[121,123,126,129,132],{"_108":79,"_110":122},"/en/about",{"_108":124,"_110":125},"Customer cases","/en/cases",{"_108":127,"_110":128},"News","/en/news",{"_108":130,"_110":131},"After-sales service","/en/service",{"_108":133,"_110":134},"Downloads","/en/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig8300voc",[],[],"seo",{"_103":145,"_146":147,"_148":149,"_150":151},"IG8300VOC Online Odor and Gas Monitoring System | IGENU SCIENCE","description","Monitor configured odor-related gases through a multisensor system with sample pretreatment, temperature compensation and automatic calibration functions. An integrated display, data storage and communication options support connected environmental monitoring at wastewater treatment, chemical production and waste-handling sites.","imageUrl","/igenu-preview/media/97c97b1129c8237eb4b7d324.jpg","index",true,"canonical","https://eicloc.github.io/igenu-preview/en/products/ig8300voc","query",{},"selected",[],"detail",{"_160":161,"_57":140,"_162":163,"_164":165,"_166":147,"_167":168,"_169":170,"_174":175,"_198":199,"_200":201,"_146":-5,"_202":203,"_204":205,"_206":207,"_208":209,"_287":288,"_289":290,"_291":292,"_143":144},"id","0ebe2f55-73e5-48ce-b7d2-aab462d75429","model","IG8300VOC","name","IG8300VOC Online Odor and Gas Monitoring System","shortDescription","featured",false,"category",{"_57":171,"_172":-5,"_164":116,"_146":-5,"_143":173},"gas","brand",{"_103":116,"_146":-5,"_148":-5,"_150":151},"heroImage",{"_160":176,"_139":177,"_178":179,"_180":181,"_182":183,"_184":185,"_186":187,"_188":189,"_190":149,"_191":192,"_193":194},"248b037a-97ca-43b1-abac-a26d2deaf089","IMAGE","originalName","2025040852682581.png","mimeType","image/jpeg","size",22439,"sha256","97c97b1129c8237eb4b7d324799035ec948f856036b41f67613d22e0171553b0","width",194,"height",421,"url","createdAt","2026-10-20T17:32:39.720Z","variants",[195],{"_186":187,"_188":189,"_180":196,"_190":197},"image/webp","/igenu-preview/media/51378fe539ff38c9e791e3c9.webp","detailLayout","STRUCTURED","availableLocales",[19,20,11],"bodyHtml","<p><strong><span>Product features:</span></strong><br />★ Adopting high-precision electrochemical sensors, with reliable and stable performance<br />Equipped with independent algorithms to ensure accurate and reliable data<br />★ Built in multiple pre-treatment systems such as dust removal, water removal, and heat dissipation, effectively extending the service life<br />★ Integrated temperature compensation technology+automatic calibration technology, intelligent calibration without manual intervention<br />★ Integrated GPRS communication technology, real-time monitoring data can be connected to the environmental protection bureau platform<br />★ Adopting a 7-inch industrial touch screen display and a larger screen for clearer display<br />★ Built in 16GB memory card, data can be stored for 2-5 years<br />★ Equipped with a 32-bit high-speed processing chip and automatic networking function for power-off and power on monitoring<br />★The sensor has automatic cleaning and intelligent calibration functions, with 365 * 24-hour continuous monitoring without any pressure<br />★ Special appearance design, anti-interference<br /></p><p><strong><span>Technical Parameter</span></strong><br />Gas detection: NH3、C9H9N、H2S、CH4S、C2SH6、C2H6S2、CS 2、C8H8、OU、VOC、T、H、PM2.5、PM10 <br />Measurement range: Odor: 0-2000 NH3 C9H9N、H2S、CH4S、C2SH6、C2H6S2、CS 2、C8H8：0-100ppm,  Volatile gases (VOCs): 0-100ppm PM2.5, PM10: 0-1000ppb<br />Resolution: 1OU; 0.01ppm,1ppb <br />Response time: T90≤20s <br />Measurement accuracy: ± 3%<br />Linear error: ≤ ±1% <br />Zero drift: ≤ ± 1% (F.S/year)<br />Recovery time: ≤ 20 seconds<br />Installation methods: column clamp type, wall mounted type<br />Repeatability: ≤ ±1% <br />Protection level: IP65 <br />Temperature and humidity: optional accessories, temperature detection range: -40~800 ℃, humidity detection range: 0-100% RH<br />Alarm settings: The alarm value can be set arbitrarily<br />Data storage: Standard configuration includes storage of over 100000 pieces of data, supports large capacity SD cards, continuous data storage for more than one year, and allows for free setting of data storage intervals<br />Signal output: Supports wireless or wired transmission methods such as RS485, GPRS, 433M, NBIOT, LoRa, etc<br />Working environment: Working temperature -30~50 ℃ (customized or optional pre-treatment system required for use in higher temperature and humidity environments) Working humidity: ≤ 95% RH, no condensation<br />working pressure: 0 ～ 100Kpa <br />Working power supply: 220VAC<br /></p>\n    ","gallery",[],"features",[],"specificationGroups",[210],{"_164":211,"_212":213},"Technical specifications","specifications",[214,220,224,228,232,236,240,244,248,252,255,259,263,267,271,275,279,283],{"_215":216,"_108":116,"_217":218,"_219":-5},"key","gas-detection","value","NH3、C9H9N、H2S、CH4S、C2SH6、C2H6S2、CS 2、C8H8、OU、VOC、T、H、PM2.5、PM10","unit",{"_215":221,"_108":222,"_217":223,"_219":-5},"measurement-range","Measurement range","Odor: 0-2000 NH3 C9H9N、H2S、CH4S、C2SH6、C2H6S2、CS 2、C8H8：0-100ppm,  Volatile gases (VOCs): 0-100ppm PM2.5, PM10: 0-1000ppb",{"_215":225,"_108":226,"_217":227,"_219":-5},"resolution","Resolution","1OU; 0.01ppm,1ppb",{"_215":229,"_108":230,"_217":231,"_219":-5},"response-time","Response time","T90≤20s",{"_215":233,"_108":234,"_217":235,"_219":-5},"accuracy","Measurement accuracy","± 3%",{"_215":237,"_108":238,"_217":239,"_219":-5},"linearity","Linear error","≤ ±1%",{"_215":241,"_108":242,"_217":243,"_219":-5},"zero-drift","Zero drift","≤ ± 1% (F.S/year)",{"_215":245,"_108":246,"_217":247,"_219":-5},"recovery-time","Recovery time","≤ 20 seconds",{"_215":249,"_108":250,"_217":251,"_219":-5},"installation","Installation methods","column clamp type, wall mounted type",{"_215":253,"_108":254,"_217":239,"_219":-5},"repeatability","Repeatability",{"_215":256,"_108":257,"_217":258,"_219":-5},"protection","Protection level","IP65",{"_215":260,"_108":261,"_217":262,"_219":-5},"temperature-humidity","Temperature and humidity","optional accessories, temperature detection range: -40~800 ℃, humidity detection range: 0-100% RH",{"_215":264,"_108":265,"_217":266,"_219":-5},"alarm-settings","Alarm settings","The alarm value can be set arbitrarily",{"_215":268,"_108":269,"_217":270,"_219":-5},"data-storage","Data storage","Standard configuration includes storage of over 100000 pieces of data, supports large capacity SD cards, continuous data storage for more than one year, and allows for free setting of data storage intervals",{"_215":272,"_108":273,"_217":274,"_219":-5},"output","Signal output","Supports wireless or wired transmission methods such as RS485, GPRS, 433M, NBIOT, LoRa, etc",{"_215":276,"_108":277,"_217":278,"_219":-5},"operating-temperature","Working environment","Working temperature -30~50 ℃ (customized or optional pre-treatment system required for use in higher temperature and humidity environments) Working humidity: ≤ 95% RH, no condensation",{"_215":280,"_108":281,"_217":282,"_219":-5},"pressure","working pressure","0 ～ 100Kpa",{"_215":284,"_108":285,"_217":286,"_219":-5},"power-supply","Working power supply","220VAC","sourceReviews",[],"documents",[],"supportDownloads",[]]
