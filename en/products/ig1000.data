avigation",[102,118],{"_103":104,"_105":106},"title","Products","links",[107,112,115],{"_108":109,"_110":111},"label","Water analysis","href","/en/products?category=water",{"_108":113,"_110":114},"Industrial measurement","/en/products?category=industrial",{"_108":116,"_110":117},"Gas detection","/en/products?category=gas",{"_103":119,"_105":120},"Explore",[121,123,126,129,132],{"_108":79,"_110":122},"/en/about",{"_108":124,"_110":125},"Customer cases","/en/cases",{"_108":127,"_110":128},"News","/en/news",{"_108":130,"_110":131},"After-sales service","/en/service",{"_108":133,"_110":134},"Downloads","/en/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig1000",[],[],"seo",{"_103":145,"_146":147,"_148":149,"_150":151},"IG1000 Electromagnetic Flowmeter | IGENU SCIENCE","description","Electromagnetic flow sensing measures conductive liquids, including water and process slurries. Inline installation and electrical outputs support integration into process monitoring, with material and connection options selected to suit the application and the measured medium.","imageUrl","/igenu-preview/media/2a75c1e35c4f5d26d0d45a78.jpg","index",true,"canonical","https://eicloc.github.io/igenu-preview/en/products/ig1000","query",{},"selected",[],"detail",{"_160":161,"_57":140,"_162":163,"_164":165,"_166":147,"_167":168,"_169":170,"_174":175,"_206":207,"_208":209,"_146":-5,"_210":211,"_212":213,"_214":215,"_216":217,"_281":282,"_329":330,"_331":332,"_143":144},"id","718efa0b-619e-43bd-aa4d-e57bc33e3a82","model","IG1000","name","IG1000 Electromagnetic Flowmeter","shortDescription","featured",false,"category",{"_57":171,"_172":-5,"_164":113,"_146":-5,"_143":173},"industrial","brand",{"_103":113,"_146":-5,"_148":-5,"_150":151},"heroImage",{"_160":176,"_139":177,"_178":179,"_180":181,"_182":183,"_184":185,"_186":187,"_188":189,"_190":149,"_191":192,"_193":194},"ae088e5b-dee3-4d64-a813-8aea3d5faa40","IMAGE","originalName","2018040280914617.jpg","mimeType","image/jpeg","size",79233,"sha256","2a75c1e35c4f5d26d0d45a78e4afd1e32e7fc5846f14595ed04ad41691e1ba5a","width",775,"height",522,"url","createdAt","2026-10-20T17:32:39.599Z","variants",[195,200,204],{"_186":196,"_188":197,"_180":198,"_190":199},320,216,"image/webp","/igenu-preview/media/b9d84e037e2e93e539dbc230.webp",{"_186":201,"_188":202,"_180":198,"_190":203},640,431,"/igenu-preview/media/34a2de4913f859e3b5fd7093.webp",{"_186":187,"_188":189,"_180":198,"_190":205},"/igenu-preview/media/f7cba31a9a75d0b97c8bfde5.webp","detailLayout","STRUCTURED","availableLocales",[19,20,11],"bodyHtml","<span>Technical Parameter</span><br /><br /> The series of IG1000 series electromagnetic flowmeter is complete and is used to measure the liquid with electrical conductivity less than 5 S/cm,<br />The flow of pulp, mucus and mud. The optional calibre is continuous from DN10 to DN3000. Sensor and conversion<br />The device has one shape design, and also has a type of shape.<br />The production process of IG1000 electromagnetic flowmeter adopts the technology of IG Corporation (IGENU GmbH).<br />Control and quality management strictly comply with the technical specifications of IG company and conform to the ISO9001 quality assurance system and the IG public<br />Our quality inspection and certification requirements, inspection and testing by German experts, quality performance and German factory products end<br />All the same, thus ensuring the domestic assembly and production of IG1000 series electromagnetic flowmeter is the same as that of the German factory.<br />Quality. The application effect is very ideal and is welcomed by the vast number of users.<br /><br /><span>Sensor:</span><br /><br />Model IG12<br />Accuracy standard + 0.5%, optional + 0.2%<br />Process connection flange (Tan Gang), flange (1.4571[316Ti])<br />Lining hard / soft rubber, PTFE, PFA<br />Electrical conductivity &gt; 5 uS/cm (softened water is 20 uS/cm)<br />Electrode material of stainless steel 1.4571[316Ti], 1.4539, hirson alloy B2/C4, Pt, iridium, tantalum, titanium<br />Protection grade IP67<br />Fluid temperature -25 ~ +180 C<br />The design of T explosion-proof V 97, ATEX 1173X<br />Certification Project cold water, waste water and non water liquid<br />Pressure equipment<br />The 97/23/EG consistency assessment accords with Category III, Fluid Group 1<br /><br /><span>Converter:</span><br /><br />Power supply 85-253 VAC/16.8-26.4VAC/16.8-31.2 VDC<br />Current output 0/2-10 mA, 0-5mA, 0/4-20 mA, 0/4-10/12-20<br />MA<br />Pulse output active 24 V DC pulse or passive Optocoupler<br />Input of external zero Optocoupler<br />Accumulator reset optocoupler input<br />Positive / reverse measurement of the output signal of the optocoupler<br />The air tube detector starts from the DN10:3/8, and the output signal of the optocoupler<br />Self monitoring functions<br />On-the-spot display / fatigue<br />Additive function<br />Shell<br />Aluminum converter shell (standard), stainless steel converter (selection<br />With)<br />Communication PROFIBUS DP, PROFIBUS PA, HART- protocol,<br />FOUNDATION Fieldbus ASCII- protocol (RS485)\n    ","gallery",[],"features",[],"specificationGroups",[218],{"_164":219,"_220":221},"Technical specifications","specifications",[222,229,233,237,241,245,249,253,257,261,265,269,273,277],{"_223":224,"_108":225,"_226":227,"_228":-5},"key","accuracy","Accuracy standard","value","+ 0.5%, optional + 0.2%","unit",{"_223":230,"_108":231,"_226":232,"_228":-5},"process-connection","Process connection","flange (Tan Gang), flange (1.4571[316Ti])",{"_223":234,"_108":235,"_226":236,"_228":-5},"lining","Lining","hard / soft rubber, PTFE, PFA",{"_223":238,"_108":239,"_226":240,"_228":-5},"conductivity","Electrical conductivity","> 5 uS/cm (softened water is 20 uS/cm)",{"_223":242,"_108":243,"_226":244,"_228":-5},"electrode-material","Electrode material","of stainless steel 1.4571[316Ti], 1.4539, hirson alloy B2/C4, Pt, iridium, tantalum, titanium",{"_223":246,"_108":247,"_226":248,"_228":-5},"protection","Protection grade","IP67",{"_223":250,"_108":251,"_226":252,"_228":-5},"process-temperature","Fluid temperature","-25 ~ +180 C",{"_223":254,"_108":255,"_226":256,"_228":-5},"explosion-design","The design of","T explosion-proof V 97, ATEX 1173X",{"_223":258,"_108":259,"_226":260,"_228":-5},"power-supply","Power supply","85-253 VAC/16.8-26.4VAC/16.8-31.2 VDC",{"_223":262,"_108":263,"_226":264,"_228":-5},"current-output","Current output","0/2-10 mA, 0-5mA, 0/4-20 mA, 0/4-10/12-20\nMA",{"_223":266,"_108":267,"_226":268,"_228":-5},"pulse-output","Pulse output","active 24 V DC pulse or passive Optocoupler",{"_223":270,"_108":271,"_226":272,"_228":-5},"accumulator-reset","Accumulator reset","optocoupler input",{"_223":274,"_108":275,"_226":276,"_228":-5},"empty-pipe-detector","The air tube detector starts from the DN10","3/8, and the output signal of the optocoupler",{"_223":278,"_108":279,"_226":280,"_228":-5},"digital-communication","Communication","PROFIBUS DP, PROFIBUS PA, HART- protocol,\nFOUNDATION Fieldbus ASCII- protocol (RS485)","sourceReviews",[283,302,311,320],{"_223":242,"_139":284,"_285":286,"_287":288,"_289":290},"conflict","note","原站三语资料存在差异；保留各语言原值，等待品牌方确认。","status","pending","sources",[291,294,298],{"_108":243,"_226":244,"_10":11,"_292":293},"sourceUrl","http://www.igenu.com/proshow_6.html",{"_108":295,"_226":296,"_10":19,"_292":297},"电极材质","含钼不锈钢、哈氏合金 B、哈氏合金 C、钛、铂 / 铱合金、 钽、碳化钨","http://www.igenu.com/cn/proshow_6.html",{"_108":299,"_226":300,"_10":20,"_292":301},"Elektrode material","edelstahl 1.4571 (316ti], 1.4539, hirson legierung b2 / c4, pt, iridium, tantal, titan","http://www.igenu.com/de/proshow_6.html",{"_223":266,"_139":284,"_285":286,"_287":288,"_289":303},[304,305,308],{"_108":267,"_226":268,"_10":11,"_292":293},{"_108":306,"_226":307,"_10":19,"_292":297},"脉冲输出","无源、有源、频率、脉宽可调",{"_108":309,"_226":310,"_10":20,"_292":301},"Der puls des","aktiven oder passiven optocoupler 24 v dc puls",{"_223":278,"_139":284,"_285":2