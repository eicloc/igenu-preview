avigation",[102,118],{"_103":104,"_105":106},"title","Products","links",[107,112,115],{"_108":109,"_110":111},"label","Water analysis","href","/en/products?category=water",{"_108":113,"_110":114},"Industrial measurement","/en/products?category=industrial",{"_108":116,"_110":117},"Gas detection","/en/products?category=gas",{"_103":119,"_105":120},"Explore",[121,123,126,129,132],{"_108":79,"_110":122},"/en/about",{"_108":124,"_110":125},"Customer cases","/en/cases",{"_108":127,"_110":128},"News","/en/news",{"_108":130,"_110":131},"After-sales service","/en/service",{"_108":133,"_110":134},"Downloads","/en/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig4200",[],[],"seo",{"_103":145,"_146":147,"_148":149,"_150":151},"IG4200 Online Total Solids Analyzer | IGENU SCIENCE","description","Microwave transmission measures total solids concentration directly in water samples without prior separation or settling. Continuous readings and control-system connectivity support process monitoring in wastewater treatment, chemical production, pharmaceutical manufacturing and food processing applications.","imageUrl","/igenu-preview/media/4b53f5aab7936bf5768d9331.jpg","index",true,"canonical","https://eicloc.github.io/igenu-preview/en/products/ig4200","query",{},"selected",[],"detail",{"_160":161,"_57":140,"_162":163,"_164":165,"_166":147,"_167":168,"_169":170,"_174":175,"_202":203,"_204":205,"_146":-5,"_206":207,"_208":209,"_210":211,"_212":213,"_281":282,"_283":284,"_285":286,"_143":144},"id","8adc50f7-109a-4e34-80e1-4442cb557ef8","model","IG4200","name","IG4200 Online Total Solids Analyzer","shortDescription","featured",false,"category",{"_57":171,"_172":-5,"_164":113,"_146":-5,"_143":173},"industrial","brand",{"_103":113,"_146":-5,"_148":-5,"_150":151},"heroImage",{"_160":176,"_139":177,"_178":179,"_180":181,"_182":183,"_184":185,"_186":187,"_188":189,"_190":149,"_191":192,"_193":194},"a7d0c5a5-4017-44bb-880a-fe921c7cae03","IMAGE","originalName","2025041053569693.png","mimeType","image/jpeg","size",47641,"sha256","4b53f5aab7936bf5768d9331003eaab972aa10e742396f2311725e7a132e48cb","width",490,"height",278,"url","createdAt","2026-10-20T17:32:39.927Z","variants",[195,200],{"_186":196,"_188":197,"_180":198,"_190":199},320,182,"image/webp","/igenu-preview/media/460947b2f394cc6a41c35af0.webp",{"_186":187,"_188":189,"_180":198,"_190":201},"/igenu-preview/media/b3843283fc6cbe984798d870.webp","detailLayout","STRUCTURED","availableLocales",[19,20,11],"bodyHtml","<span><strong>Product Features:</strong></span><br />◆Fast and accurate: By using microwave signals for measurement, the concentration of total solids in water samples can be obtained within seconds with high accuracy.<br />◆ No need for sample processing: Traditional total solid concentration testing methods require separation, precipitation, and other treatments of the sample, while online microwave total solid concentration measuring instruments directly measure the ◆water sample, eliminating the step of sample processing.<br />◆Real time monitoring: This instrument can monitor the changes in total solid concentration in water samples in real time, facilitating control and adjustment of the production process.<br />◆High degree of automation: It can be connected to the control system of the production process to achieve automated control.<br />◆Currently, most of the sludge concentration sensors used are optical sensors, which seriously contaminate the measuring head. The accumulated limestone will cause it to deviate from the measurement range, thereby increasing maintenance costs. ◆The IG4200 uses a special material sensor that can resist the accumulation of dirt, thus providing long-term stability.<br /><span><strong>Application areas:</strong></span><br />Chemical, pharmaceutical, sewage treatment, food, environmental protection<br /><span><strong>Technical Parameter:</strong></span><br />Measurement range: 35% TS, 350000 mg/L<br />Repeatability: 0.01% TS<br />Resolution: 0.001%<br />Accuracy (under stable conditions): ± 0.02% TS<br />Pressure: greater than 1.5 bar<br />Conductivity: 0-25ms/cm<br />Signal port: 4-20mA/RS485<br />Liquid receiving material: 316L+ceramic<br />Sampling time: 1 second<br />Protection level: Sensor IP66, Controller: IP65<br />Installation methods: plug-in, flange type<br />Flow rate: ＜ 5m/s<br />Process temperature: 0-70 ℃<br />Environmental temperature: 0-60 ℃<br />Power supply: 220VAC\n    ","gallery",[],"features",[],"specificationGroups",[214],{"_164":215,"_216":217},"Technical specifications","specifications",[218,225,229,233,237,241,245,249,253,257,261,265,269,273,277],{"_219":220,"_108":221,"_222":223,"_224":-5},"key","measurement-range","Measurement range","value","35% TS, 350000 mg/L","unit",{"_219":226,"_108":227,"_222":228,"_224":-5},"repeatability","Repeatability","0.01% TS",{"_219":230,"_108":231,"_222":232,"_224":-5},"resolution","Resolution","0.001%",{"_219":234,"_108":235,"_222":236,"_224":-5},"accuracy","Accuracy (under stable conditions)","± 0.02% TS",{"_219":238,"_108":239,"_222":240,"_224":-5},"pressure","Pressure","greater than 1.5 bar",{"_219":242,"_108":243,"_222":244,"_224":-5},"conductivity","Conductivity","0-25ms/cm",{"_219":246,"_108":247,"_222":248,"_224":-5},"signal-port","Signal port","4-20mA/RS485",{"_219":250,"_108":251,"_222":252,"_224":-5},"wetted-material","Liquid receiving material","316L+ceramic",{"_219":254,"_108":255,"_222":256,"_224":-5},"sampling-time","Sampling time","1 second",{"_219":258,"_108":259,"_222":260,"_224":-5},"protection","Protection level","Sensor IP66, Controller: IP65",{"_219":262,"_108":263,"_222":264,"_224":-5},"installation","Installation methods","plug-in, flange type",{"_219":266,"_108":267,"_222":268,"_224":-5},"flow-rate","Flow rate","＜ 5m/s",{"_219":270,"_108":271,"_222":272,"_224":-5},"process-temperature","Process temperature","0-70 ℃",{"_219":274,"_108":275,"_222":276,"_224":-5},"operating-temperature","Environmental temperature","0-60 ℃",{"_219":278,"_108":279,"_222":280,"_224":-5},"power-supply","Power supply","220VAC","sourceReviews",[],"documents",[],"supportDownloads",[]]
