avigation",[102,118],{"_103":104,"_105":106},"title","Products","links",[107,112,115],{"_108":109,"_110":111},"label","Water analysis","href","/en/products?category=water",{"_108":113,"_110":114},"Industrial measurement","/en/products?category=industrial",{"_108":116,"_110":117},"Gas detection","/en/products?category=gas",{"_103":119,"_105":120},"Explore",[121,123,126,129,132],{"_108":79,"_110":122},"/en/about",{"_108":124,"_110":125},"Customer cases","/en/cases",{"_108":127,"_110":128},"News","/en/news",{"_108":130,"_110":131},"After-sales service","/en/service",{"_108":133,"_110":134},"Downloads","/en/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig30bga-ig30chl",[],[],"seo",{"_103":145,"_146":147,"_148":149,"_150":151},"IG30BGA/IG30CHL Algae and Chlorophyll Sensor | IGENU SCIENCE","description","Fluorescence sensing enables direct monitoring of blue-green algae and chlorophyll without sample extraction or chemical reagents. Digital communication supports continuous water monitoring, with a cleaning-brush option to help manage deposits on the optical sensing surface.","imageUrl","/igenu-preview/media/3a4bd3a9ba0af3bd90061177.jpg","index",true,"canonical","https://eicloc.github.io/igenu-preview/en/products/ig30bga-ig30chl","query",{},"selected",[],"detail",{"_160":161,"_57":140,"_162":163,"_164":165,"_166":147,"_167":168,"_169":170,"_174":175,"_200":201,"_202":203,"_146":-5,"_204":205,"_206":207,"_208":209,"_210":211,"_275":276,"_277":278,"_279":280,"_143":144},"id","df5b5971-b8ab-4461-9dd3-21bd164a9ff2","model","IG30BGA/IG30CHL","name","IG30BGA/IG30CHL Algae and Chlorophyll Sensor","shortDescription","featured",false,"category",{"_57":171,"_172":-5,"_164":109,"_146":-5,"_143":173},"water","brand",{"_103":109,"_146":-5,"_148":-5,"_150":151},"heroImage",{"_160":176,"_139":177,"_178":179,"_180":181,"_182":183,"_184":185,"_186":187,"_188":187,"_189":149,"_190":191,"_192":193},"e9c2938f-6236-4c7f-bf9d-752bcf98b444","IMAGE","originalName","2025040861512869.jpg","mimeType","image/jpeg","size",13520,"sha256","3a4bd3a9ba0af3bd90061177b116d1a851d9d410ca383514dfbd7fdb3aa5270f","width",540,"height","url","createdAt","2026-10-20T17:32:39.805Z","variants",[194,198],{"_186":195,"_188":195,"_180":196,"_189":197},320,"image/webp","/igenu-preview/media/9fb61c06fe27bcc0e9cecfd6.webp",{"_186":187,"_188":187,"_180":196,"_189":199},"/igenu-preview/media/b63396be40013d2d55e983f5.webp","detailLayout","STRUCTURED","availableLocales",[19,20,11],"bodyHtml","<strong><span>Product features:</span></strong><br />◆ Adopting titanium alloy corrosion-resistant shell; NPT3/4 threaded interface for easy installation;<br />◆ With self-cleaning function, it can remove attachments from water samples without maintenance;<br />◆ The sample does not require processing or extraction, is non-destructive, reagent free, and pollution-free; Direct measurement is simpler than traditional analysis methods<br />◆ Accurate measurement, low detection limit, and good long-term stability;<br />◆ Ultra bright LED light source, improving signal-to-noise ratio and enhancing stability;<br />◆ Equipped with calibration record storage function, plug and play, no calibration required for the first use.<br />◆ Digital sensor, RS-485 output, supports MODBUS<br />◆ Can be continuously monitored online, real-time control of water quality dynamics<br /><strong><span>Application areas:</span></strong><br />Monitoring of drinking water sources, warning of algal blooms, intake of water plants, environmental monitoring<br /><strong><span>Technical parameters:</span></strong><br />Measurement range: blue-green algae: 0-200000 cells/mL<br />                                  Chlorophyll: 0-1000ppb<br />Measurement principle: UV fluorescence<br />Measurement accuracy: ± 3% of reading or 0.1ppb<br />Repeatability: ± 3%<br />Calibration method: single point calibration, based on experimental results<br />Medium requirements: flow rate: 0-3m/s; Pressure: 0-100psi<br />Sensor material: 316L or POM<br />Sensor communication: MODBUS RS-485 <br />Storage temperature:- 15~50℃ <br />Working temperature: 0~50 ℃ (non freezing)<br />Self cleaning: automatic scraping brush (optional)<br />Cable length: Standard 10m, extendable<br />Sensor size: 176mm * 22mm\n    ","gallery",[],"features",[],"specificationGroups",[212],{"_164":213,"_214":215},"Technical specifications","specifications",[216,223,227,231,235,239,243,247,251,255,259,263,267,271],{"_217":218,"_108":219,"_220":221,"_222":-5},"key","measurement-range","Measurement range","value","blue-green algae: 0-200000 cells/mL","unit",{"_217":224,"_108":225,"_220":226,"_222":-5},"chlorophyll","Chlorophyll","0-1000ppb",{"_217":228,"_108":229,"_220":230,"_222":-5},"measurement-principle","Measurement principle","UV fluorescence",{"_217":232,"_108":233,"_220":234,"_222":-5},"accuracy","Measurement accuracy","± 3% of reading or 0.1ppb",{"_217":236,"_108":237,"_220":238,"_222":-5},"repeatability","Repeatability","± 3%",{"_217":240,"_108":241,"_220":242,"_222":-5},"calibration","Calibration method","single point calibration, based on experimental results",{"_217":244,"_108":245,"_220":246,"_222":-5},"medium-requirements","Medium requirements","flow rate: 0-3m/s; Pressure: 0-100psi",{"_217":248,"_108":249,"_220":250,"_222":-5},"sensor-material","Sensor material","316L or POM",{"_217":252,"_108":253,"_220":254,"_222":-5},"digital-communication","Sensor communication","MODBUS RS-485",{"_217":256,"_108":257,"_220":258,"_222":-5},"storage-temperature","Storage temperature","- 15~50℃",{"_217":260,"_108":261,"_220":262,"_222":-5},"operating-temperature","Working temperature","0~50 ℃ (non freezing)",{"_217":264,"_108":265,"_220":266,"_222":-5},"self-cleaning","Self cleaning","automatic scraping brush (optional)",{"_217":268,"_108":269,"_220":270,"_222":-5},"cable","Cable length","Standard 10m, extendable",{"_217":272,"_108":273,"_220":274,"_222":-5},"sensor-size","Sensor size","176mm * 22mm","sourceReviews"