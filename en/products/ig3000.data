avigation",[102,118],{"_103":104,"_105":106},"title","Products","links",[107,112,115],{"_108":109,"_110":111},"label","Water analysis","href","/en/products?category=water",{"_108":113,"_110":114},"Industrial measurement","/en/products?category=industrial",{"_108":116,"_110":117},"Gas detection","/en/products?category=gas",{"_103":119,"_105":120},"Explore",[121,123,126,129,132],{"_108":79,"_110":122},"/en/about",{"_108":124,"_110":125},"Customer cases","/en/cases",{"_108":127,"_110":128},"News","/en/news",{"_108":130,"_110":131},"After-sales service","/en/service",{"_108":133,"_110":134},"Downloads","/en/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig3000",[],[],"seo",{"_103":145,"_146":147,"_148":149,"_150":151},"IG3000 Display Multichannel Controller | IGENU SCIENCE","description","Bring compatible digital and analog water sensors together in a multichannel controller with a clear display and menu navigation. Configurable outputs, relays and communication options support process integration, while an output-hold function assists with sensor maintenance.","imageUrl","/igenu-preview/media/8032374cce79b2ec8e8e37dc.png","index",true,"canonical","https://eicloc.github.io/igenu-preview/en/products/ig3000","query",{},"selected",[],"detail",{"_160":161,"_57":140,"_162":163,"_164":165,"_166":147,"_167":151,"_168":169,"_173":174,"_208":209,"_210":211,"_146":-5,"_212":213,"_214":215,"_216":217,"_218":219,"_306":307,"_308":309,"_310":311,"_143":144},"id","da285210-11c2-4983-81be-86274bcf1ca2","model","IG3000","name","IG3000 Display Multichannel Controller","shortDescription","featured","category",{"_57":170,"_171":-5,"_164":109,"_146":-5,"_143":172},"water","brand",{"_103":109,"_146":-5,"_148":-5,"_150":151},"heroImage",{"_160":175,"_139":176,"_177":178,"_179":180,"_181":182,"_183":184,"_185":186,"_187":188,"_189":149,"_190":191,"_192":193},"d84d4b36-8577-47f5-a6b1-91a7ae3a7c9f","IMAGE","originalName","2025040855746689.png","mimeType","image/png","size",749999,"sha256","8032374cce79b2ec8e8e37dca3798c3058050655937edfc7f06654e8d4ff5b9e","width",1280,"height",1706,"url","createdAt","2026-10-20T17:32:39.748Z","variants",[194,199,203,206],{"_185":195,"_187":196,"_179":197,"_189":198},320,427,"image/webp","/igenu-preview/media/c82ee037d25142ee99b2efed.webp",{"_185":200,"_187":201,"_179":197,"_189":202},640,853,"/igenu-preview/media/8aafd5be554a54bb0699b6bf.webp",{"_185":204,"_187":186,"_179":197,"_189":205},960,"/igenu-preview/media/4a8ece2b232c4eb15009de8a.webp",{"_185":186,"_187":188,"_179":197,"_189":207},"/igenu-preview/media/288701302fcf6e887f187cad.webp","detailLayout","STRUCTURED","availableLocales",[19,20,11],"bodyHtml","<p></p><p><strong><span>Product features:</span></strong><br />◆ Strong compatibility, able to connect digital and analog sensors from Igno company<br />◆90 * 70 large screen LED display, user-friendly interface<br />◆Large size UV resistant and anti-corrosion PS shell, suitable for various harsh working conditions.<br />◆4-20mA output with control function, capable of PID control of external devices<br />◆ Optional multiple relays, Modbus RTU, DeviceNet, Modbus RS232, CANopen, EthermetIP, Modbus TCP, TCP/IP communication, etc., can meet various on-site requirements<br />◆ Multi channel controller, capable of connecting one or more sensors<br />◆ Output hold function, convenient for sensor maintenance<br />◆IP66 protection level, CE certification.</p><p><strong><span>Technical parameters:</span></strong></p><p>Display: High resolution full-color large screen LED display screen<br />Operation mode: Key menu navigation<br />Operation interface: Chinese/English<br />Number of channels: 1-8<br />Supporting parameters: PH、ORP、 Turbidity, residual chlorine, conductivity, dissolved oxygen, blue-green algae, chlorophyll, chromaticity, transparency UVCOD、 Ammonia nitrogen, sludge concentration, suspended solids, nitrate nitrogen, etc<br />Units: pH, mV, mg/L, us/cm, cm, ppb, ppm, ℃,% NTU and others<br />Support temperature sensors: PT100、PT1000、NTC10/30K<br />Internal power supply: 5V/12V/24V<br />Relay: 1-4 channels 220VAC 3A, programmable<br />Analog output: optional 2-8 4-20mA outputs<br />Digital Communication: ModbusRS485、DeviceNet、ModbusRS232、CANopen、EthermetIP、ModbusTCP,TCP/IP，Profibus<br />Output hold function: Yes<br />Size: 200mm * 200mm * 70mm<br />Installation method: Wall mounted<br />Shell material: Poly+PS<br />Work environment:- 10~50℃<br />Protection level: Compliant with IP66 NEMA 4X<br />Electrical interface: M16*1.5<br />Power supply: 100~240VAC, 50/60Hz<br />Certification: EMC: CE certification, electromagnetic and radiation emissions comply with EN 50081-2, anti-interference complies with EN 61000-6-2<br /></p>\n    ","gallery",[],"features",[],"specificationGroups",[220],{"_164":221,"_222":223},"Technical specifications","specifications",[224,231,235,239,243,246,250,254,258,262,266,270,274,278,282,286,290,294,298,302],{"_225":226,"_108":227,"_228":229,"_230":-5},"key","display","Display","value","High resolution full-color large screen LED display screen","unit",{"_225":232,"_108":233,"_228":234,"_230":-5},"operation","Operation mode","Key menu navigation",{"_225":236,"_108":237,"_228":238,"_230":-5},"interface-language","Operation interface","Chinese/English",{"_225":240,"_108":241,"_228":242,"_230":-5},"channels","Number of channels","1-8",{"_225":64,"_108":244,"_228":245,"_230":-5},"Supporting parameters","PH、ORP、 Turbidity, residual chlorine, conductivity, dissolved oxygen, blue-green algae, chlorophyll, chromaticity, transparency UVCOD、 Ammonia nitrogen, sludge concentration, suspended solids, nitrate nitrogen, etc",{"_225":247,"_108":248,"_228":249,"_230":-5},"units","Units","pH, mV, mg/L, us/cm, cm, ppb, ppm, ℃,% NTU and others",{"_225":251,"_108":252,"_228":253,"_230":-5},"temperature-sensors","Support temperature sensors","PT100、PT1000、NTC10/30K",{"_225":255,"_108":256,"_228":257,"_230":-5},"internal-power","Internal power supply","5V/12V/24V",{"_225":259,"_108":260,"_228":261,"_230":-5},"relay","Relay","1-4 channels 220VAC 3A, programmable",{"_225":263,"_108":264,"_228":265,"_230":-5},"analog-output","Analog output","optional 2-8 4-20mA outputs",{"_225":267,"_108":268,"_228":269,"_230":-5},"digital-communication","Digital Communication","ModbusRS485、DeviceNet、ModbusRS232、CANopen、EthermetIP、ModbusTCP,TCP/IP，Profibus",{"_225":271,"_108":272,"_228":273,"_230":-5},"output-hold","Output hold function","Yes",{"_225":275,"_108":276,"_228":277,"_230":-5},"dimensions","Size","200mm * 200mm * 70mm",{"_225":279,"_108":280,"_228":281,"_230":-5},"installation","Installation method","Wall mounted",{"_225":283,"_108":284,"_228":285,"_230":-5},"material","Shell material","Poly+PS",{"_225":287,"_108":288,"_228":289,"_230":-5},"operating-temperature","Work environment","- 10~50℃",{"_225":291,"_108":292,"_228":293,"_230":-5},"protection","Protection level","Compliant with IP66 NEMA 4X",{"_225":295,"_108":296,"_228":297,"_230":-5},"connection","Electrical interface","M16*1.5",{"_225":299,"_108":300,"_228":301,"_230":-5},"power-supply","Power supply","100~240VAC, 50/60Hz",{"_225":303,"_108":304,"_228":305,"_230":-5},"certification","Certification","EMC: CE certification, electromagnetic and radiation emissions comply with EN 50081-2, anti-interference complies with EN 61000-6-2","sourceReviews",[],"documents",[],"supportDownloads",[]]
