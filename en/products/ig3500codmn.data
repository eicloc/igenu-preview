avigation",[102,118],{"_103":104,"_105":106},"title","Products","links",[107,112,115],{"_108":109,"_110":111},"label","Water analysis","href","/en/products?category=water",{"_108":113,"_110":114},"Industrial measurement","/en/products?category=industrial",{"_108":116,"_110":117},"Gas detection","/en/products?category=gas",{"_103":119,"_105":120},"Explore",[121,123,126,129,132],{"_108":79,"_110":122},"/en/about",{"_108":124,"_110":125},"Customer cases","/en/cases",{"_108":127,"_110":128},"News","/en/news",{"_108":130,"_110":131},"After-sales service","/en/service",{"_108":133,"_110":134},"Downloads","/en/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig3500codmn",[],[],"seo",{"_103":145,"_146":147,"_148":149,"_150":151},"IG3500CODmn Permanganate Index Analyzer | IGENU SCIENCE","description","Permanganate oxidation and titration determine the permanganate index in water. Automatic range switching, quality-control checks and operating logs support online monitoring, while alarm functions and standard electrical interfaces help connect the analyzer to a wider monitoring system.","imageUrl","/igenu-preview/media/076a24550dfec7d99b95ba88.png","index",true,"canonical","https://eicloc.github.io/igenu-preview/en/products/ig3500codmn","query",{},"selected",[],"detail",{"_160":161,"_57":140,"_162":163,"_164":165,"_166":147,"_167":168,"_169":170,"_174":175,"_198":199,"_200":201,"_146":-5,"_202":203,"_204":205,"_206":207,"_208":209,"_283":284,"_285":286,"_287":288,"_143":144},"id","879c4612-34a5-41ef-a5f2-419989ad469e","model","IG3500CODMN","name","IG3500CODmn Permanganate Index Analyzer","shortDescription","featured",false,"category",{"_57":171,"_172":-5,"_164":109,"_146":-5,"_143":173},"water","brand",{"_103":109,"_146":-5,"_148":-5,"_150":151},"heroImage",{"_160":176,"_139":177,"_178":179,"_180":181,"_182":183,"_184":185,"_186":187,"_188":189,"_190":149,"_191":192,"_193":194},"bfda7f5e-e504-4c40-85f0-1afea6d4aba3","IMAGE","originalName","2025040938476253.jpg","mimeType","image/png","size",51146,"sha256","076a24550dfec7d99b95ba8827dbead49c4506dc3d55d9d8b47b0c95d2a2c36e","width",267,"height",435,"url","createdAt","2026-10-20T17:32:39.824Z","variants",[195],{"_186":187,"_188":189,"_180":196,"_190":197},"image/webp","/igenu-preview/media/f3d468788765b050ceafe139.webp","detailLayout","STRUCTURED","availableLocales",[20,19,11],"bodyHtml","<strong><span>Product features:</span></strong><br />◆High range measurement of low concentration: using ring sampling to reduce dilution times and improve repeatability. The new acceptance standard requires the instrument range to be 2-3 times the emission standard, but the actual concentration of the discharged water sample is very low. For this situation of measuring low concentration with high range, the advantage is particularly obvious<br />◆Innovative measurement method (patent) (1) with anti turbidity interference automatic compensation function, which will not make measurement errors when collecting turbid water samples; (2) with bubble elimination function, which has a significant effect on wastewater with bubbles, such as photovoltaic plants, printing and dyeing plants, etc<br />◆ Automatic range switching function: Choose any combination of low range and high range, and the instrument will automatically switch to the optimal range based on the actual water sample concentration<br />◆ Multiple quality control functions: zero point/span/standard sample verification, blank testing, reserved parallel sample and spiked recovery interface<br />◆Multiple measurement modes, key parameter display, operation, verification, calibration logs, upper and lower limit warning<br />◆ Power on self-test, automatic reset, liquid shortage alarm, power-off protection, waste liquid separation<br />◆ Supports 2-channel RS232/485, 2-channel 4-20mA communication interfaces, and real-time data printing for printers<br />◆ (Optional) Cloud monitoring function: Real time monitoring of instrument status on mobile phones, remote alarm, remote fault diagnosis<br />◆ (Optional) Reagent Refrigeration: Equipped with a reagent refrigeration box to extend the reagent warranty period<br /><span><strong>Application areas:</strong></span><br />Surface water, groundwater, tap water, drinking water, seawater<br /><strong><span>Technical parameters:</span></strong><br />Detection range: (0~20/100 ) mg/L <br />Measurement principle: Potassium permanganate oxidation titration method<br />Accuracy: ± 5%<br />Repeatability: ≤ 2%<br />Zero drift: ± 5%<br />Range drift: ± 5%<br />Data storage: ≥ 48000 records<br />Environmental requirements: Temperature+5~28 ° C: Humidity&lt;90%<br />Measurement cycle: 30-50min<br />MTBF: ≥ 720h/time<br />Communication interface: 4-20mA RS232、RS485 <br />Insulation impedance: above 2M Ω<br />Power Supply: AC ( 220+20 ) V ( 50+0.5 ) Hz ，5A <br />Power consumption: 150W<br />Quantitative lower limit: 0.2mg/L<br />Minimum detection limit: 0.04mg/L<br />Size: 500mm * 445mm * 1355mm\n    ","gallery",[],"features",[],"specificationGroups",[210],{"_164":211,"_212":213},"Technical specifications","specifications",[214,221,225,229,233,236,239,243,247,251,255,259,263,267,271,275,279],{"_215":216,"_108":217,"_218":219,"_220":-5},"key","measurement-range","Detection range","value","(0~20/100 ) mg/L","unit",{"_215":222,"_108":223,"_218":224,"_220":-5},"measurement-principle","Measurement principle","Potassium permanganate oxidation titration method",{"_215":226,"_108":227,"_218":228,"_220":-5},"accuracy","Accuracy","± 5%",{"_215":230,"_108":231,"_218":232,"_220":-5},"repeatability","Repeatability","≤ 2%",{"_215":234,"_108":235,"_218":228,"_220":-5},"zero-drift","Zero drift",{"_215":237,"_108":238,"_218":228,"_220":-5},"range-drift","Range drift",{"_215":240,"_108":241,"_218":242,"_220":-5},"data-storage","Data storage","≥ 48000 records",{"_215":244,"_108":245,"_218":246,"_220":-5},"environment-requirements","Environmental requirements","Temperature+5~28 ° C: Humidity<90%",{"_215":248,"_108":249,"_218":250,"_220":-5},"measurement-cycle","Measurement cycle","30-50min",{"_215":252,"_108":253,"_218":254,"_220":-5},"mtbf","MTBF","≥ 720h/time",{"_215":256,"_108":257,"_218":258,"_220":-5},"digital-communication","Communication interface","4-20mA RS232、RS485",{"_215":260,"_108":261,"_218":262,"_220":-5},"insulation","Insulation impedance","above 2M Ω",{"_215":264,"_108":265,"_218":266,"_220":-5},"power-supply","Power Supply","AC ( 220+20 ) V ( 50+0.5 ) Hz ，5A",{"_215":268,"_108":269,"_218":270,"_220":-5},"power-consumption","Power consumption","150W",{"_215":272,"_108":273,"_218":274,"_220":-5},"quantitative-limit","Quantitative lower limit","0.2mg/L",{"_215":276,"_108":277,"_218":278,"_220":-5},"detection-limit","Minimum detection limit","0.04mg/L",{"_215":280,"_108":281,"_218":282,"_220":-5},"dimensions","Size","500mm * 445mm * 1355mm","sourceReviews",[],"documents",[],"supportDownloads",[]]
