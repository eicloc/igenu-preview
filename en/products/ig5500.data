avigation",[102,118],{"_103":104,"_105":106},"title","Products","links",[107,112,115],{"_108":109,"_110":111},"label","Water analysis","href","/en/products?category=water",{"_108":113,"_110":114},"Industrial measurement","/en/products?category=industrial",{"_108":116,"_110":117},"Gas detection","/en/products?category=gas",{"_103":119,"_105":120},"Explore",[121,123,126,129,132],{"_108":79,"_110":122},"/en/about",{"_108":124,"_110":125},"Customer cases","/en/cases",{"_108":127,"_110":128},"News","/en/news",{"_108":130,"_110":131},"After-sales service","/en/service",{"_108":133,"_110":134},"Downloads","/en/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig5500",[],[],"seo",{"_103":145,"_146":147,"_148":149,"_150":151},"IG5500 Pressure Transmitter | IGENU SCIENCE","description","A silicon sensing element and signal-conditioning circuit provide pressure measurement for compatible gases and liquids. A compact housing, selectable outputs and process connections support installation in water treatment, hydraulic equipment and industrial process control applications.","imageUrl","/igenu-preview/media/c746becf8db6677ba7f20c1b.png","index",true,"canonical","https://eicloc.github.io/igenu-preview/en/products/ig5500","query",{},"selected",[],"detail",{"_160":161,"_57":140,"_162":163,"_164":165,"_166":147,"_167":168,"_169":170,"_174":175,"_206":207,"_208":209,"_146":-5,"_210":211,"_212":213,"_214":215,"_216":217,"_285":286,"_287":288,"_289":290,"_143":144},"id","d5c3a293-847d-45eb-8e36-aa2ac3fc2463","model","IG5500","name","IG5500 Pressure Transmitter","shortDescription","featured",false,"category",{"_57":171,"_172":-5,"_164":113,"_146":-5,"_143":173},"industrial","brand",{"_103":113,"_146":-5,"_148":-5,"_150":151},"heroImage",{"_160":176,"_139":177,"_178":179,"_180":181,"_182":183,"_184":185,"_186":187,"_188":189,"_190":149,"_191":192,"_193":194},"33d41440-c759-49f8-90bd-34b6cd5f235a","IMAGE","originalName","2025040851699125.png","mimeType","image/png","size",328593,"sha256","c746becf8db6677ba7f20c1ba57229696ee47b035e9b8e09a92e661b92d3b81c","width",894,"height",591,"url","createdAt","2026-10-20T17:32:39.705Z","variants",[195,200,204],{"_186":196,"_188":197,"_180":198,"_190":199},320,212,"image/webp","/igenu-preview/media/742e701732a18bc68d06d2a3.webp",{"_186":201,"_188":202,"_180":198,"_190":203},640,423,"/igenu-preview/media/bcb0d54fc977c2edfe25d6f5.webp",{"_186":187,"_188":189,"_180":198,"_190":205},"/igenu-preview/media/6dcb50f0f86d2a52dccece3c.webp","detailLayout","STRUCTURED","availableLocales",[19,20,11],"bodyHtml","<strong><span>Product features:</span></strong><br />◆Widely used media, can measure oil, water, paste, etc., with certain anti-corrosion ability<br />◆Good linearity, high accuracy, high stability, long lifespan<br />◆ Small size, light weight, easy to install<br /><p>◆ Wide range, corrosion-resistant, suitable for various media</p><p><strong><span>Technical parameters:</span></strong><br />Measurement medium: gas, liquid, oil, etc<br />Measurement form and range: gauge pressure (G) - maximum (0-60) MPa, Minimum (0-0.5) Kpa<br />Absolute pressure (A) - maximum (0-40) MPa, Minimum (0-5) KPa<br />Negative pressure (B) - (-0.1~40) MPa, Minimum (-0.2~0.2) KPa<br />Environmental temperature:- 10~65℃ <br />Environmental humidity: 5-100% relative humidity<br />Accuracy level: 0.1%<br />Overload capacity: 2-5 times the range<br />Long term stability: less than 0.2% FS/60 months<br />Power supply: 24VDC<br />Output signal: (4-20) mA (two/three wire system) (optional HART protocol output) （0～10/20）mA<br />（0～5）V、（1～5）V、（0～10）V、 (Optional) RS485<br />Display mode: digital display<br />Measurement rate: 0.2S<br />Working temperature:- 40～80℃<br />Compensation temperature:- 20～70 ℃<br />Process connection: M20 × 1.5 external thread (Ø 3 internal hole), or user specified<br />Protection level: IP67<br />Electromagnetic compatibility: RF protection complies with EN61326<br /></p>\n    ","gallery",[],"features",[],"specificationGroups",[218],{"_164":219,"_220":221},"Technical specifications","specifications",[222,229,233,237,241,245,249,253,257,261,265,269,273,277,281],{"_223":224,"_108":225,"_226":227,"_228":-5},"key","medium","Measurement medium","value","gas, liquid, oil, etc","unit",{"_223":230,"_108":231,"_226":232,"_228":-5},"measurement-form","Measurement form and range","gauge pressure (G) - maximum (0-60) MPa, Minimum (0-0.5) Kpa",{"_223":234,"_108":235,"_226":236,"_228":-5},"operating-temperature","Environmental temperature","- 10~65℃; - 40～80℃",{"_223":238,"_108":239,"_226":240,"_228":-5},"operating-humidity","Environmental humidity","5-100% relative humidity",{"_223":242,"_108":243,"_226":244,"_228":-5},"accuracy","Accuracy level","0.1%",{"_223":246,"_108":247,"_226":248,"_228":-5},"overload-capacity","Overload capacity","2-5 times the range",{"_223":250,"_108":251,"_226":252,"_228":-5},"long-term-stability","Long term stability","less than 0.2% FS/60 months",{"_223":254,"_108":255,"_226":256,"_228":-5},"power-supply","Power supply","24VDC",{"_223":258,"_108":259,"_226":260,"_228":-5},"output","Output signal","(4-20) mA (two/three wire system) (optional HART protocol output) （0～10/20）mA",{"_223":262,"_108":263,"_226":264,"_228":-5},"display","Display mode","digital display",{"_223":266,"_108":267,"_226":268,"_228":-5},"measurement-rate","Measurement rate","0.2S",{"_223":270,"_108":271,"_226":272,"_228":-5},"compensation-temperature","Compensation temperature","- 20～70 ℃",{"_223":274,"_108":275,"_226":276,"_228":-5},"process-connection","Process connection","M20 × 1.5 external thread (Ø 3 internal hole), or user specified",{"_223":278,"_108":279,"_226":280,"_228":-5},"protection","Protection level","IP67",{"_223":282,"_108":283,"_226":284,"_228":-5},"emc","Electromagnetic compatibility","RF protection complies with EN61326","sourceReviews",[],"documents",[],"supportDownloads",[]]
