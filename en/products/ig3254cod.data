avigation",[102,118],{"_103":104,"_105":106},"title","Products","links",[107,112,115],{"_108":109,"_110":111},"label","Water analysis","href","/en/products?category=water",{"_108":113,"_110":114},"Industrial measurement","/en/products?category=industrial",{"_108":116,"_110":117},"Gas detection","/en/products?category=gas",{"_103":119,"_105":120},"Explore",[121,123,126,129,132],{"_108":79,"_110":122},"/en/about",{"_108":124,"_110":125},"Customer cases","/en/cases",{"_108":127,"_110":128},"News","/en/news",{"_108":130,"_110":131},"After-sales service","/en/service",{"_108":133,"_110":134},"Downloads","/en/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig3254cod",[],[],"seo",{"_103":145,"_146":147,"_148":149,"_150":151},"IG3254COD UV COD and TOC Sensor | IGENU SCIENCE","description","Ultraviolet absorption supports online COD and TOC measurement without reagent dosing. Turbidity compensation, calibration options and an available automatic cleaning system help adapt the digital probe to water monitoring, with results interpreted according to the selected calibration.","imageUrl","/igenu-preview/media/e3e2c21db606165f614650cf.jpg","index",true,"canonical","https://eicloc.github.io/igenu-preview/en/products/ig3254cod","query",{},"selected",[],"detail",{"_160":161,"_57":140,"_162":163,"_164":165,"_166":147,"_167":168,"_169":170,"_174":175,"_200":201,"_202":203,"_146":-5,"_204":205,"_206":207,"_208":209,"_210":211,"_295":296,"_297":298,"_299":300,"_143":144},"id","dfbb0b65-0921-4d76-820c-bc18ebd08c71","model","IG3254COD","name","IG3254COD UV COD and TOC Sensor","shortDescription","featured",false,"category",{"_57":171,"_172":-5,"_164":109,"_146":-5,"_143":173},"water","brand",{"_103":109,"_146":-5,"_148":-5,"_150":151},"heroImage",{"_160":176,"_139":177,"_178":179,"_180":181,"_182":183,"_184":185,"_186":187,"_188":187,"_189":149,"_190":191,"_192":193},"79d9f104-d914-4e36-bec2-d6d2b843fefd","IMAGE","originalName","2025041051182309.jpg","mimeType","image/jpeg","size",14215,"sha256","e3e2c21db606165f614650cf931244737a0e84793f3dd9ab8bd834db8aa5b8b3","width",540,"height","url","createdAt","2026-10-20T17:32:39.888Z","variants",[194,198],{"_186":195,"_188":195,"_180":196,"_189":197},320,"image/webp","/igenu-preview/media/087409fcbd7eefe1aec06c53.webp",{"_186":187,"_188":187,"_180":196,"_189":199},"/igenu-preview/media/6d889354b11ab94fb489a773.webp","detailLayout","STRUCTURED","availableLocales",[19,20,11],"bodyHtml","<span><strong>Product features:</strong></span><br />◆ Digital sensor, 485 output, supports Modbus RTU<br />◆ No need for reagents, no pollution, more economical and environmentally friendly<br />◆ Optional automatic cleaning device can effectively remove surface contamination of sensors, prevent microbial growth, and achieve more accurate and lower maintenance<br />◆ Measurable SAC COD、TOC、 Turbidity, temperature and other parameters<br />◆ Automatically compensates for turbidity and suspended solids interference, with excellent testing performance<br /><span><strong>Application areas:</strong></span><br />Municipal sewage, industrial wastewater, environmental monitoring, monitoring of drinking and surface water, industrial processes, aquaculture, biological processes<br /><strong><span>Technical parameters:</span></strong><br />Range: COD (calibrated using KHP): 0~500mg/L，0-1500 mg/L COD <br />TOC (calibrated using KHP): 0~180mg/L TOC ，0~600 mg/L TOC<br />Measurement principle: 254nm ultraviolet absorption spectrum<br />Light source: flashing xenon lamp<br />Optical path length: 2.5mm, 6.5mm<br />Measurement accuracy: ± 5% of the reading<br />Repeatability: less than ± 5%<br />Detection limit: 0.1 mg/L<br />Measurement intervals: 15s, 30s, 1min, 30min<br />Calibration methods: single point sample calibration, multi-point standard solution calibration, slope calibration<br />Sensor material: Body: SUS316L； Window: Sapphire<br />Self cleaning: automatic scraping brush<br />Cross sensitivity compensation: turbidity<br />Sensor communication: MODBUS RS-485 <br />Storage temperature:- 10~50℃ <br />Working temperature: 0~50 ℃ (non freezing)<br />Protection level: IP68 <br />Cable length: Standard 10m, extendable<br />Sensor size: 179mm*50mm\n    ","gallery",[],"features",[],"specificationGroups",[212],{"_164":213,"_214":215},"Technical specifications","specifications",[216,223,227,231,235,239,243,247,251,255,259,263,267,271,275,279,283,287,291],{"_217":218,"_108":219,"_220":221,"_222":-5},"key","measurement-range","Range","value","COD (calibrated using KHP): 0~500mg/L，0-1500 mg/L COD","unit",{"_217":224,"_108":225,"_220":226,"_222":-5},"toc","TOC (calibrated using KHP)","0~180mg/L TOC ，0~600 mg/L TOC",{"_217":228,"_108":229,"_220":230,"_222":-5},"measurement-principle","Measurement principle","254nm ultraviolet absorption spectrum",{"_217":232,"_108":233,"_220":234,"_222":-5},"light-source","Light source","flashing xenon lamp",{"_217":236,"_108":237,"_220":238,"_222":-5},"optical-path","Optical path length","2.5mm, 6.5mm",{"_217":240,"_108":241,"_220":242,"_222":-5},"accuracy","Measurement accuracy","± 5% of the reading",{"_217":244,"_108":245,"_220":246,"_222":-5},"repeatability","Repeatability","less than ± 5%",{"_217":248,"_108":249,"_220":250,"_222":-5},"detection-limit","Detection limit","0.1 mg/L",{"_217":252,"_108":253,"_220":254,"_222":-5},"measurement-interval","Measurement intervals","15s, 30s, 1min, 30min",{"_217":256,"_108":257,"_220":258,"_222":-5},"calibration","Calibration methods","single point sample calibration, multi-point standard solution calibration, slope calibration",{"_217":260,"_108":261,"_220":262,"_222":-5},"sensor-material","Sensor material","Body: SUS316L； Window: Sapphire",{"_217":264,"_108":265,"_220":266,"_222":-5},"self-cleaning","Self cleaning","automatic scraping brush",{"_217":268,"_108":269,"_220":270,"_222":-5},"cross-sensitivity-compensation","Cross sensitivity compensation","turbidity",{"_217":272,"_108":273,"_220":274,"_222":-5},"digital-communication","Sensor communication","MODBUS RS-485",{"_217":276,"_108":277,"_220":278,"_222":-5},"storage-temperature","Storage temperature","- 10~50℃",{"_217":280,"_108":281,"_220":282,"_222":-5},"operating-temperature","Working temperature","0~50 ℃ (non freezing)",{"_217":284,"_108":285,"_220":286,"_222":-5},"protection","Protection level","IP68",{"_217":288,"_108":289,"_220":290,"_222":-5},"cable","Cable length","Standard 10m, extendable",{"_217":292,"_108":293,"_220":294,"_222":-5},"sensor-size","Sensor size","179mm*50mm","sourceReviews",[],"documents",[],"supportDownloads",[]]
