avigation",[102,118],{"_103":104,"_105":106},"title","Products","links",[107,112,115],{"_108":109,"_110":111},"label","Water analysis","href","/en/products?category=water",{"_108":113,"_110":114},"Industrial measurement","/en/products?category=industrial",{"_108":116,"_110":117},"Gas detection","/en/products?category=gas",{"_103":119,"_105":120},"Explore",[121,123,126,129,132],{"_108":79,"_110":122},"/en/about",{"_108":124,"_110":125},"Customer cases","/en/cases",{"_108":127,"_110":128},"News","/en/news",{"_108":130,"_110":131},"After-sales service","/en/service",{"_108":133,"_110":134},"Downloads","/en/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig30ss-sol",[],[],"seo",{"_103":145,"_146":147,"_148":149,"_150":151},"IG30SS/SOL Suspended Solids and Sludge Concentration Sensor | IGENU SCIENCE","description","Infrared scattered-light sensing monitors suspended solids and sludge concentration in water and wastewater processes. The digital probe combines optical compensation with a sapphire window, while an optional cleaning brush helps manage deposits during continuous monitoring at the measurement point.","imageUrl","/igenu-preview/media/fbfabb8705ffee2ab2928de1.jpg","index",true,"canonical","https://eicloc.github.io/igenu-preview/en/products/ig30ss-sol","query",{},"selected",[],"detail",{"_160":161,"_57":140,"_162":163,"_164":165,"_166":147,"_167":151,"_168":169,"_173":174,"_197":198,"_199":200,"_146":-5,"_201":202,"_203":204,"_205":206,"_207":208,"_292":293,"_294":295,"_296":297,"_143":144},"id","9d824bcb-a360-4cc5-9c05-f39f8c5afaa3","model","IG30SS/SOL","name","IG30SS/SOL Suspended Solids and Sludge Concentration Sensor","shortDescription","featured","category",{"_57":170,"_171":-5,"_164":109,"_146":-5,"_143":172},"water","brand",{"_103":109,"_146":-5,"_148":-5,"_150":151},"heroImage",{"_160":175,"_139":176,"_177":178,"_179":180,"_181":182,"_183":184,"_185":186,"_187":188,"_189":149,"_190":191,"_192":193},"1439d80a-330c-424f-b53e-2863e4ad2437","IMAGE","originalName","2025040860527217.png","mimeType","image/jpeg","size",17952,"sha256","fbfabb8705ffee2ab2928de1e179bcbdfff9163bf9562b20f0a57da383e92447","width",252,"height",303,"url","createdAt","2026-10-20T17:32:39.774Z","variants",[194],{"_185":186,"_187":188,"_179":195,"_189":196},"image/webp","/igenu-preview/media/75deeb09829c31a530ddf618.webp","detailLayout","STRUCTURED","availableLocales",[19,20,11],"bodyHtml","<strong><span>Product features:</span></strong><br />◆ Built in temperature sensor, automatic light source temperature drift compensation<br />◆ Adopting dual beam infrared and scattered light photometer detection technology, it has good repeatability and stability<br />◆ Digital sensor, RS-485 output, standard Modbus RTU protocol, not affected by transmission distance, better stability<br />◆ The sensor is made of stainless steel material, which has a longer service life and reduces maintenance and downtime<br />◆ Using an 860nm near-infrared light source, it can compensate for the color interference of the sample background light<br />◆ Equipped with a self-cleaning system, stable operation and minimal maintenance<br />◆ Sapphire window, durable and wear-resistant, ensuring long-term data accuracy<br />◆ Not affected by flow velocity interference and able to withstand severe impacts<br />◆ Digital sensors with strong anti-interference ability and long transmission distance<br /><strong><span>Application areas:</span></strong><br />Municipal sewage, industrial wastewater, environmental monitoring, monitoring of drinking and surface water, industrial processes<br /><strong><span>Technical parameters:</span></strong><br />Range: 0~50g/L, 0.1~100g/L, 0.2~500g/L<br />Measurement principle: 860nm wavelength, scattered light at 90 ° and 140 °<br />Resolution: 0.01mg/L<br />Measurement accuracy: less than ± 1% of the reading (depending on the homogeneity of the medium sludge)<br />Repeatability: less than ± 1%<br />Bubble compensation: software based bubble compensation<br />Response time: T90＜5S<br />Maximum pressure: ≤ 30bar <br />Calibration method: single point sample, slope calibration<br />Sensor material: Body: SUS316L； Window: Sapphire<br />Self cleaning: automatic scraping brush (optional)<br />Light attenuation compensation: automatic<br />Sensor communication: MODBUS RS-485 <br />Storage temperature:- 30~75℃ <br />Working temperature: 0~70 ℃ (non freezing)<br />Protection level: IP68 <br />Cable length: Standard 10m, extendable<br />Maximum pressure: 30bar<br />Maximum flow velocity: 3 meters per second<br />Sensor size: 200mm*50mm\n    ","gallery",[],"features",[],"specificationGroups",[209],{"_164":210,"_211":212},"Technical specifications","specifications",[213,220,224,228,232,236,240,244,248,252,256,260,264,268,272,276,280,284,288],{"_214":215,"_108":216,"_217":218,"_219":-5},"key","measurement-range","Range","value","0~50g/L, 0.1~100g/L, 0.2~500g/L","unit",{"_214":221,"_108":222,"_217":223,"_219":-5},"measurement-principle","Measurement principle","860nm wavelength, scattered light at 90 ° and 140 °",{"_214":225,"_108":226,"_217":227,"_219":-5},"resolution","Resolution","0.01mg/L",{"_214":229,"_108":230,"_217":231,"_219":-5},"accuracy","Measurement accuracy","less than ± 1% of the reading (depending on the homogeneity of the medium sludge)",{"_214":233,"_108":234,"_217":235,"_219":-5},"repeatability","Repeatability","less than ± 1%",{"_214":237,"_108":238,"_217":239,"_219":-5},"bubble-compensation","Bubble compensation","software based bubble compensation",{"_214":241,"_108":242,"_217":243,"_219":-5},"response-time","Response time","T90＜5S",{"_214":245,"_108":246,"_217":247,"_219":-5},"maximum-pressure","Maximum pressure","≤ 30bar; 30bar",{"_214":249,"_108":250,"_217":251,"_219":-5},"calibration","Calibration method","single point sample, slope calibration",{"_214":253,"_108":254,"_217":255,"_219":-5},"sensor-material","Sensor material","Body: SUS316L； Window: Sapphire",{"_214":257,"_108":258,"_217":259,"_219":-5},"self-cleaning","Self cleaning","automatic scraping brush (optional)",{"_214":261,"_108":262,"_217":263,"_219":-5},"light-attenuation-compensation","Light attenuation compensation","automatic",{"_214":265,"_108":266,"_217":267,"_219":-5},"digital-communication","Sensor communication","MODBUS RS-485",{"_214":269,"_108":270,"_217":271,"_219":-5},"storage-temperature","Storage temperature","- 30~75℃",{"_214":273,"_108":274,"_217":275,"_219":-5},"operating-temperature","Working temperature","0~70 ℃ (non freezing)",{"_214":277,"_108":278,"_217":279,"_219":-5},"protection","Protection level","IP68",{"_214":281,"_108":282,"_217":283,"_219":-5},"cable","Cable length","Standard 10m, extendable",{"_214":285,"_108":286,"_217":287,"_219":-5},"maximum-flow","Maximum flow velocity","3 meters per second",{"_214":289,"_108":290,"_217":291,"_219":-5},"sensor-size","Sensor size","200mm*50mm","sourceReviews",[],"documents",[],"supportDownloads",[]]
