avigation",[102,118],{"_103":104,"_105":106},"title","Products","links",[107,112,115],{"_108":109,"_110":111},"label","Water analysis","href","/en/products?category=water",{"_108":113,"_110":114},"Industrial measurement","/en/products?category=industrial",{"_108":116,"_110":117},"Gas detection","/en/products?category=gas",{"_103":119,"_105":120},"Explore",[121,123,126,129,132],{"_108":79,"_110":122},"/en/about",{"_108":124,"_110":125},"Customer cases","/en/cases",{"_108":127,"_110":128},"News","/en/news",{"_108":130,"_110":131},"After-sales service","/en/service",{"_108":133,"_110":134},"Downloads","/en/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig30uvno3",[],[],"seo",{"_103":145,"_146":147,"_148":149,"_150":151},"IG30UVNO3 UV Nitrate Nitrogen Sensor | IGENU SCIENCE","description","Ultraviolet absorption measures nitrate nitrogen directly in water without chemical reagents or a separate sampling system. Selectable optical paths, interference compensation and automatic cleaning support online deployment in drinking water, environmental monitoring and wastewater treatment applications.","imageUrl","/igenu-preview/media/82c04b6460e5738541de5cfe.jpg","index",true,"canonical","https://eicloc.github.io/igenu-preview/en/products/ig30uvno3","query",{},"selected",[],"detail",{"_160":161,"_57":140,"_162":163,"_164":165,"_166":147,"_167":151,"_168":169,"_173":174,"_197":198,"_199":200,"_146":-5,"_201":202,"_203":204,"_205":206,"_207":208,"_288":289,"_290":291,"_292":293,"_143":144},"id","a5b76360-49f2-40e8-aeb2-c79f30115f7c","model","IG30UVNO3","name","IG30UVNO3 UV Nitrate Nitrogen Sensor","shortDescription","featured","category",{"_57":170,"_171":-5,"_164":109,"_146":-5,"_143":172},"water","brand",{"_103":109,"_146":-5,"_148":-5,"_150":151},"heroImage",{"_160":175,"_139":176,"_177":178,"_179":180,"_181":182,"_183":184,"_185":186,"_187":188,"_189":149,"_190":191,"_192":193},"79581a81-10c6-426b-80fa-28e7baf03c33","IMAGE","originalName","2025040861391349.png","mimeType","image/jpeg","size",16873,"sha256","82c04b6460e5738541de5cfefb589dc0c6890e78350a89fe4e1a3b1a0828a745","width",263,"height",348,"url","createdAt","2026-10-20T17:32:39.799Z","variants",[194],{"_185":186,"_187":188,"_179":195,"_189":196},"image/webp","/igenu-preview/media/5668d414b7362883ab524969.webp","detailLayout","STRUCTURED","availableLocales",[19,20,11],"bodyHtml","<strong><span>Product features:</span></strong><br />◆ Accurate UV absorption technology: ensures high precision in detection<br />◆ Flexible optical path selection: Provides different optical path options (1mm, 2mm, 5mm) to meet different monitoring needs<br />◆ Probe direct immersion measurement, no sampling and preprocessing required<br />◆ No need for chemical reagents, no secondary pollution<br />◆ Short response time, capable of continuous measurement<br />◆ No need to replace the membrane head and electrolyte<br />◆ The sensor has an automatic cleaning function, which can reduce maintenance<br /><strong><span>Application areas:</span></strong><br />Environmental monitoring, monitoring of drinking and surface water, industrial wastewater, sewage, domestic wastewater, sewage, groundwater, lake water<br /><strong><span>Technical parameters:</span></strong><br />Range: 0~40mg/L, 0~100mg/L<br />Measurement principle: UV absorption spectroscopy<br />Light source: flashing xenon lamp<br />Optical path length: 1mm, 2mm, 5mm<br />Measurement accuracy: ± 0.1 mg/L or ± 3% of the reading<br />Repeatability: less than ± 3%<br />Detection limit: 0.02 mg/L<br />Measurement intervals: 15s, 30s, 1min, 30min<br />Calibration methods: single point sample calibration, multi-point standard solution calibration, slope calibration<br />Sensor material: Body: SUS316L； Window: Sapphire<br />Self cleaning: automatic scraping brush<br />Cross sensitivity compensation: turbidity, solid particles, organic matter<br />Sensor communication: MODBUS RS-485 <br />Storage temperature:- 10~50℃ <br />Working temperature: 0~45 ℃ (non freezing)<br />Protection level: IP68 <br />Cable length: Standard 10m, extendable<br />Sensor size: 365mm*70mm\n    ","gallery",[],"features",[],"specificationGroups",[209],{"_164":210,"_211":212},"Technical specifications","specifications",[213,220,224,228,232,236,240,244,248,252,256,260,264,268,272,276,280,284],{"_214":215,"_108":216,"_217":218,"_219":-5},"key","measurement-range","Range","value","0~40mg/L, 0~100mg/L","unit",{"_214":221,"_108":222,"_217":223,"_219":-5},"measurement-principle","Measurement principle","UV absorption spectroscopy",{"_214":225,"_108":226,"_217":227,"_219":-5},"light-source","Light source","flashing xenon lamp",{"_214":229,"_108":230,"_217":231,"_219":-5},"optical-path","Optical path length","1mm, 2mm, 5mm",{"_214":233,"_108":234,"_217":235,"_219":-5},"accuracy","Measurement accuracy","± 0.1 mg/L or ± 3% of the reading",{"_214":237,"_108":238,"_217":239,"_219":-5},"repeatability","Repeatability","less than ± 3%",{"_214":241,"_108":242,"_217":243,"_219":-5},"detection-limit","Detection limit","0.02 mg/L",{"_214":245,"_108":246,"_217":247,"_219":-5},"measurement-interval","Measurement intervals","15s, 30s, 1min, 30min",{"_214":249,"_108":250,"_217":251,"_219":-5},"calibration","Calibration methods","single point sample calibration, multi-point standard solution calibration, slope calibration",{"_214":253,"_108":254,"_217":255,"_219":-5},"sensor-material","Sensor material","Body: SUS316L； Window: Sapphire",{"_214":257,"_108":258,"_217":259,"_219":-5},"self-cleaning","Self cleaning","automatic scraping brush",{"_214":261,"_108":262,"_217":263,"_219":-5},"cross-sensitivity-compensation","Cross sensitivity compensation","turbidity, solid particles, organic matter",{"_214":265,"_108":266,"_217":267,"_219":-5},"digital-communication","Sensor communication","MODBUS RS-485",{"_214":269,"_108":270,"_217":271,"_219":-5},"storage-temperature","Storage temperature","- 10~50℃",{"_214":273,"_108":274,"_217":275,"_219":-5},"operating-temperature","Working temperature","0~45 ℃ (non freezing)",{"_214":277,"_108":278,"_217":279,"_219":-5},"protection","Protection level","IP68",{"_214":281,"_108":282,"_217":283,"_219":-5},"cable","Cable length","Standard 10m, extendable",{"_214":285,"_108":286,"_217":287,"_219":-5},"sensor-size","Sensor size","365mm*70mm","sourceReviews",[],"documents",[],"supportDownloads",[]]
