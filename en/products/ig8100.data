avigation",[102,118],{"_103":104,"_105":106},"title","Products","links",[107,112,115],{"_108":109,"_110":111},"label","Water analysis","href","/en/products?category=water",{"_108":113,"_110":114},"Industrial measurement","/en/products?category=industrial",{"_108":116,"_110":117},"Gas detection","/en/products?category=gas",{"_103":119,"_105":120},"Explore",[121,123,126,129,132],{"_108":79,"_110":122},"/en/about",{"_108":124,"_110":125},"Customer cases","/en/cases",{"_108":127,"_110":128},"News","/en/news",{"_108":130,"_110":131},"After-sales service","/en/service",{"_108":133,"_110":134},"Downloads","/en/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig8100",[],[],"seo",{"_103":145,"_146":147,"_148":149,"_150":151},"IG8100 Fixed Gas Detector and Alarm | IGENU SCIENCE","description","Configured for the required target gas, this fixed detector provides continuous concentration monitoring and local audible and visual alarms. Analog and digital outputs connect detection points with compatible control and monitoring systems in the selected installation.","imageUrl","/igenu-preview/media/839a34011d33d0b03a4d6173.jpg","index",true,"canonical","https://eicloc.github.io/igenu-preview/en/products/ig8100","query",{},"selected",[],"detail",{"_160":161,"_57":140,"_162":163,"_164":165,"_166":147,"_167":151,"_168":169,"_173":174,"_201":202,"_203":204,"_146":-5,"_205":206,"_207":208,"_224":225,"_226":227,"_311":312,"_313":314,"_315":316,"_143":144},"id","f3e2a88e-adb6-4f1f-8997-8600b01faa5a","model","IG8100","name","IG8100 Fixed Gas Detector and Alarm","shortDescription","featured","category",{"_57":170,"_171":-5,"_164":116,"_146":-5,"_143":172},"gas","brand",{"_103":116,"_146":-5,"_148":-5,"_150":151},"heroImage",{"_160":175,"_139":176,"_177":178,"_179":180,"_181":182,"_183":184,"_185":186,"_187":188,"_189":149,"_190":191,"_192":193},"a55ad70e-9d54-462e-a2ea-a827378021aa","IMAGE","originalName","2018040281324785.jpg","mimeType","image/jpeg","size",50456,"sha256","839a34011d33d0b03a4d61735b7686e5645b3091e52bd34545f51bda446373d6","width",339,"height",243,"url","createdAt","2026-10-20T17:32:39.606Z","variants",[194,199],{"_185":195,"_187":196,"_179":197,"_189":198},320,229,"image/webp","/igenu-preview/media/6d839fb13c7f64d9a04f573f.webp",{"_185":186,"_187":188,"_179":197,"_189":200},"/igenu-preview/media/023755c71cd1c8e5ab08db45.webp","detailLayout","STRUCTURED","availableLocales",[19,20,11],"bodyHtml","<p><strong><span>Product features:</span></strong><br />◆ Three wire 4-20mA, RS485 (Modbus RTU) dual signal output, perfectly compatible with various PLC/DCS control systems<br />◆ On site sound and light alarm function, large screen multi parameter LCD display<br />◆ Optional infrared remote control, can be debugged without opening the cover<br />◆ Scientific and reasonable chamber structure design, use of aviation quality ultra-high strength aluminum, excellent surface treatment technology, longer service life<br /></p><p><strong><span>Technical Parameter：</span></strong><br />Gas detection:<br />Oxygen, sulfur, and oxides<br />Oxygen O2, ozone O3, carbon monoxide CO, carbon dioxide CO2, nitric oxide NO, nitrogen dioxide NO2, nitrogen oxides NOx, sulfur dioxide SO2, chlorine dioxide CLO2<br />Nitrogen, hydrogen, and cyanide<br />Hydrogen H2, ammonia NH3, hydrogen sulfide H2S, nitrogen N2, hydrogen chloride HCL, phosphine PH3, hydrogen cyanide HCN, arsine AsH3, hydrogen fluoride HF<br />Alkanes and flammable gases<br />Combustible gases EX, methane CH4, ethane C2H6, propane C3H8, epoxyethane C2H4O<br />Organic volatile gases<br />Odor ODOR, benzene C6H6, toluene C7H8, xylene C8H10 VOCs 、 Formaldehyde CH2O, ethylene C2H4, ethanol C2H6O, non methane total hydrocarbons<br />Halogen, halogenated hydrocarbon<br />Sulfur hexafluoride SF6, chlorine gas CL2, fluorine gas F2, bromine gas Br2<br />Detection principle: electrochemical method/infrared method/catalytic combustion/PID<br />Measurement range: 0~50/100ppm, 0~50/100%Vol <br />resolving power: 0.01ppm，0.01%VOL <br />Detection limit: 0.05ppm, 0.05% VOL<br />Accuracy: ≤ ±1%F.S <br />Zero drift: ≤ ± 1% F.S/year<br />Response time: ≤ 20 seconds (T90)<br />Recovery time: ≤ 20 seconds<br />Display mode: LCD backlit display<br />Detection method: diffusion measurement, continuous operation<br />Working temperature:- 30℃~ ＋60℃ <br />Working humidity: 5%~95% RH without condensation<br />Installation methods: wall mounted, pipeline mounted<br />Shell material: All aluminum shell, fluorocarbon paint corrosion-resistant, sturdy and durable<br />Protection level: IP66 <br />Alarm mode: high and low alarm/interval alarm/weighted average alarm<br />Signal output: Three wire system 4-20mA RS485(ModbusRTU) <br />Digital signal: RS-485 output, ModBus RTU communication protocol (optional)<br />Size: 180mm * 140mm * 92mm (height * width * thickness)<br /></p><p><br /></p>\n    ","gallery",[209],{"_160":210,"_139":176,"_177":211,"_179":180,"_181":212,"_183":213,"_185":214,"_187":215,"_189":216,"_190":217,"_192":218},"b85fe479-8089-4ee5-aa2a-db75eb8b0b74","2025040939442237.png",52081,"0c749136b26fb747638a2559e5b6057a6373b64df0d34ac5108e01e84a3722c1",478,261,"/igenu-preview/media/0c749136b26fb747638a2559.jpg","2026-10-20T17:32:39.834Z",[219,222],{"_185":195,"_187":220,"_179":197,"_189":221},175,"/igenu-preview/media/6fec0333eb8c94d8cec4a3a6.webp",{"_185":214,"_187":215,"_179":197,"_189":223},"/igenu-preview/media/a19d8e5c0a5cd6234f0fd3a6.webp","features",[],"specificationGroups",[228],{"_164":229,"_230":231},"Technical specifications","specifications",[232,239,243,247,251,255,259,263,267,271,275,279,283,287,291,295,299,303,307],{"_233":234,"_108":235,"_236":237,"_238":-5},"key","measurement-principle","Detection principle","value","electrochemical method/infrared method/catalytic combustion/PID","unit",{"_233":240,"_108":241,"_236":242,"_238":-5},"measurement-range","Measurement range","0~50/100ppm, 0~50/100%Vol",{"_233":244,"_108":245,"_236":246,"_238":-5},"resolution","resolving power","0.01ppm，0.01%VOL",{"_233":248,"_108":249,"_236":250,"_238":-5},"detection-limit","Detection limit","0.05ppm, 0.05% VOL",{"_233":252,"_108":253,"_236":254,"_238":-5},"accuracy","Accuracy","≤ ±1%F.S",{"_233":256,"_108":257,"_236":258,"_238":-5},"zero-drift","Zero drift","≤ ± 1% F.S/year",{"_233":260,"_108":261,"_236":262,"_238":-5},"response-time","Response time","≤ 20 seconds (T90)",{"_233":264,"_108":265,"_236":266,"_238":-5},"recovery-time","Recovery time","≤ 20 seconds",{"_233":268,"_108":269,"_236":270,"_238":-5},"display","Display mode","LCD backlit display",{"_233":272,"_108":273,"_236":274,"_238":-5},"detection-method","Detection method","diffusion measurement, continuous operation",{"_233":276,"_108":277,"_236":278,"_238":-5},"operating-temperature","Working temperature","- 30℃~ ＋60℃",{"_233":280,"_108":281,"_236":282,"_238":-5},"operating-humidity","Working humidity","5%~95% RH without condensation",{"_233":284,"_108":285,"_236":286,"_238":-5},"installation","Installation methods","wall mounted, pipeline mounted",{"_233":288,"_108":289,"_236":290,"_238":-5},"material","Shell material","All aluminum shell, fluorocarbon paint corrosion-resistant, sturdy and durable",{"_233":292,"_108":293,"_236":294,"_238":-5},"protection","Protection level","IP66",{"_233":296,"_108":297,"_236":298,"_238":-5},"alarm-mode","Alarm mode","high and low alarm/interval alarm/weighted average alarm",{"_233":300,"_108":301,"_236":302,"_238":-5},"output","Signal output","Three wire system 4-20mA RS485(ModbusRTU)",{"_233":304,"_108":305,"_236":306,"_238":-5},"digital-signal","Digital signal","RS-485 output, ModBus RTU communication protocol (optional)",{"_233":308,"_108":309,"_236":310,"_238":-5},"dimensions","Size","180mm * 140mm * 92mm (height * width * thickness)","sourceReviews",[],"documents",[],"supportDownloads",[]]
