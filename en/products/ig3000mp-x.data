avigation",[102,118],{"_103":104,"_105":106},"title","Products","links",[107,112,115],{"_108":109,"_110":111},"label","Water analysis","href","/en/products?category=water",{"_108":113,"_110":114},"Industrial measurement","/en/products?category=industrial",{"_108":116,"_110":117},"Gas detection","/en/products?category=gas",{"_103":119,"_105":120},"Explore",[121,123,126,129,132],{"_108":79,"_110":122},"/en/about",{"_108":124,"_110":125},"Customer cases","/en/cases",{"_108":127,"_110":128},"News","/en/news",{"_108":130,"_110":131},"After-sales service","/en/service",{"_108":133,"_110":134},"Downloads","/en/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig3000mp-x",[],[],"seo",{"_103":145,"_146":147,"_148":149,"_150":151},"IG3000MP-X Multiparameter Water Analyzer | IGENU SCIENCE","description","Build a water monitoring system around interchangeable digital probes for parameters such as pH, dissolved oxygen, conductivity and turbidity. Probe connections and stored calibration data support field replacement, while an automatic cleaning arrangement helps limit surface deposits.","imageUrl","/igenu-preview/media/9a9243397faa84f675ead5a8.jpg","index",true,"canonical","https://eicloc.github.io/igenu-preview/en/products/ig3000mp-x","query",{},"selected",[],"detail",{"_160":161,"_57":140,"_162":163,"_164":165,"_166":147,"_167":168,"_169":170,"_174":175,"_200":201,"_202":203,"_146":-5,"_204":205,"_206":207,"_208":209,"_210":211,"_250":251,"_252":253,"_254":255,"_143":144},"id","27f7a7c7-2e6f-4394-8a3b-e1d66ae51c83","model","IG3000MP-X","name","IG3000MP-X Multiparameter Water Analyzer","shortDescription","featured",false,"category",{"_57":171,"_172":-5,"_164":109,"_146":-5,"_143":173},"water","brand",{"_103":109,"_146":-5,"_148":-5,"_150":151},"heroImage",{"_160":176,"_139":177,"_178":179,"_180":181,"_182":183,"_184":185,"_186":187,"_188":187,"_189":149,"_190":191,"_192":193},"d6d649eb-90c0-469f-9bfb-1c613153f689","IMAGE","originalName","2025040861670749.jpg","mimeType","image/jpeg","size",19258,"sha256","9a9243397faa84f675ead5a8a5216895cf7e15c9b82d390083269947f0d00581","width",540,"height","url","createdAt","2026-10-20T17:32:39.812Z","variants",[194,198],{"_186":195,"_188":195,"_180":196,"_189":197},320,"image/webp","/igenu-preview/media/32f08ba6aa513832d0c6c644.webp",{"_186":187,"_188":187,"_180":196,"_189":199},"/igenu-preview/media/61f38d89920b71a6040fa537.webp","detailLayout","STRUCTURED","availableLocales",[19,20,11],"bodyHtml","<strong><span>Product features:</span></strong><br />◆ Digital sensor, RS485 output, supports MODBUS<br />◆All calibration parameters are stored in the sensor, and each probe comes with a waterproof connector for easy insertion and replacement<br />◆Equipped with an automatic cleaning device, it can effectively remove surface stains from sensors, prevent microbial growth, and provide more accurate and lower maintenance<br />◆ Optional dissolved oxygen, conductivity, turbidity pH、ORP、 Chlorophyll, blue-green algae, water oil and other sensors, suitable for long-term online monitoring<br />◆ Multi in one structural design, capable of simultaneously connecting 7 probes and measuring 8 parameters<br /><blockquote></blockquote><p><strong><span>Application areas:</span></strong></p><p>Environmental monitoring, monitoring of drinking and surface water, industrial wastewater, sewage, domestic wastewater, sewage, groundwater, lake water</p><p><strong><span>Technical parameters:</span></strong><br /></p><p><strong><span></span></strong></p><table> <tbody><tr>  <td><p>Measurement parameters</p></td>  <td><p>PH</p></td>  <td><p>ORP</p></td>  <td><p>conductivity</p></td>  <td><p>dissolved oxygen</p></td>  <td><p>turbidity</p></td>  <td><p>chlorophyll</p></td>  <td><p>blue-green algae</p></td>  <td><p>temperature</p></td> </tr> <tr>  <td><p>Range</p></td>  <td><p>0-14pH</p></td>  <td><p>±1999mV</p></td>  <td><p>0-20us/cm；  0-200us/cm; 0-2000us/cm; 0-10ms/cm</p>  <p> </p></td>  <td><p>0~20mg/L</p></td>  <td><p>0~1000NTU</p></td>  <td><p>0-1000ppb </p>  <p> </p></td>  <td><p>0~200,000 cells/mL </p>  <p> </p></td>  <td><p>-5-105℃</p></td> </tr> <tr>  <td><p>Accuracy</p></td>  <td><p>± 0.01 pH</p></td>  <td><p>±0. 1 mV</p></td>  <td><p>±1% of the reading</p></td>  <td><p>± 0.1  mg/L when below 5 mg/L ± 0.2 mg/L when above 5 mg/L</p></td>  <td><p>± 1% or ± 0.1NTU  of the reading, whichever is greater</p></td>  <td><p>± 3% of the reading or 0.1ppb</p></td>  <td><p>± 3% of the reading</p></td>  <td><p>±0.1℃</p></td> </tr> <tr>  <td><p>Resolution</p></td>  <td><p>0.01 pH</p></td>  <td><p>0. 1 mV</p></td>  <td><p>±1% of the reading</p></td>  <td><p>0.01mg/L</p></td>  <td><p>0.001NTU</p></td>  <td><p>0.1ppb</p></td>  <td><p>1 cells/mL</p></td>  <td><p>0.1℃</p></td> </tr> <tr>  <td><p>Repeatability</p></td>  <td><p>0.01 pH</p></td>  <td><p>0. 1 mV</p></td>  <td><p>±1%读数</p></td>  <td><p>±0.1mg/L</p></td>  <td><p>±1%</p></td>  <td><p>±3%</p></td>  <td><p>±3%</p></td>  <td><p>0.1℃</p></td> </tr> <tr>  <td><p>Response time</p></td>  <td><p>30S,T95</p></td>  <td><p>30S,T95</p></td>  <td><p>30S,T90</p></td>  <td><p>37S,T95</p></td>  <td><p>5S,T90</p></td>  <td><p>30S,T90</p></td>  <td><p>30S,T90</p></td>  <td><p>15S,T90</p></td> </tr> <tr>  <td><p>Protection level</p></td>  <td><p>IP68</p></td>  <td><p>IP68</p></td>  <td><p>IP68</p></td>  <td><p>IP68</p></td>  <td><p>IP68</p></td>  <td><p>IP68</p></td>  <td><p>IP68</p></td>  <td><p>IP68</p></td> </tr> <tr>  <td><p>Main materials</p></td>  <td><p>PEEK、Ryton</p></td>  <td><p>PEEK、Ryton</p></td>  <td><p>PEEK、Ryton</p></td>  <td><p>titanium alloy</p></td>  <td><p>316L</p></td>  <td><p>316L</p></td>  <td><p>316L</p></td>  <td><p>PT1000</p></td> </tr></tbody></table><br /><br /><p></p>\n    ","gallery",[],"features",[],"specificationGroups",[212],{"_164":213,"_214":215},"Technical specifications","specifications",[216,222,226,230,234,238,242,246],{"_217":64,"_108":218,"_219":220,"_221":-5},"key","Measurement parameters","value","PH | ORP | conductivity | dissolved oxygen | turbidity | chlorophyll | blue-green algae | temperature","unit",{"_217":223,"_108":224,"_219":225,"_221":-5},"measurement-range","Range","0-14pH | ±1999mV | 0-20us/cm； 0-200us/cm; 0-2000us/cm; 0-10ms/cm | 0~20mg/L | 0~1000NTU | 0-1000ppb | 0~200,000 cells/mL | -5-105℃",{"_217":227,"_108":228,"_219":229,"_221":-5},"accuracy","Accuracy","± 0.01 pH | ±0. 1 mV | ±1% of the reading | ± 0.1 mg/L when below 5 mg/L ± 0.2 mg/L when above 5 mg/L | ± 1% or ± 0.1NTU of the reading, whichever is greater | ± 3% of the reading or 0.1ppb | ± 3% of the reading | ±0.1℃",{"_217":231,"_108":232,"_219":233,"_221":-5},"resolution","Resolution","0.01 pH | 0. 1 mV | ±1% of the reading | 0.01mg/L | 0.001NTU | 0.1ppb | 1 cells/mL | 0.1℃",{"_217":235,"_108":236,"_219":237,"_221":-5},"repeatability","Repeatability","0.01 pH | 0. 1 mV | ±1%读数 | ±0.1mg/L | ±1% | ±3% | ±3% | 0.1℃",{"_217":239,"_108":240,"_219":241,"_221":-5},"response-time","Response time","30S,T95 | 30S,T95 | 30S,T90 | 37S,T95 | 5S,T90 | 30S,T90 | 30S,T90 | 15S,T90",{"_217":243,"_108":244,"_219":245,"_221":-5},"protection","Protection level","IP68 | IP68 | IP68 | IP68 | IP68 | IP68 | IP68 | IP68",{"_217":247,"_108":248,"_219":249,"_221":-5},"material","Main materials","PEEK、Ryton | PEEK、Ryton | PEEK、Ryton | titanium alloy | 316L | 316L | 316L | PT1000","sourceReviews",[],"documents",[],"supportDownloads",[]]
