avigation",[102,118],{"_103":104,"_105":106},"title","Products","links",[107,112,115],{"_108":109,"_110":111},"label","Water analysis","href","/en/products?category=water",{"_108":113,"_110":114},"Industrial measurement","/en/products?category=industrial",{"_108":116,"_110":117},"Gas detection","/en/products?category=gas",{"_103":119,"_105":120},"Explore",[121,123,126,129,132],{"_108":79,"_110":122},"/en/about",{"_108":124,"_110":125},"Customer cases","/en/cases",{"_108":127,"_110":128},"News","/en/news",{"_108":130,"_110":131},"After-sales service","/en/service",{"_108":133,"_110":134},"Downloads","/en/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig3000lt",[],[],"seo",{"_103":145,"_146":147,"_148":149,"_150":151},"IG3000LT Low-Range Turbidity Analyzer | IGENU SCIENCE","description","Designed for low-level turbidity measurement in drinking water and treatment systems, this analyzer combines optical detection with a flow cell that removes bubbles. Its modular arrangement supports calibration, cleaning and servicing, with temperature displayed alongside turbidity.","imageUrl","/igenu-preview/media/32687b0fb7e3209190a365f6.png","index",true,"canonical","https://eicloc.github.io/igenu-preview/en/products/ig3000lt","query",{},"selected",[],"detail",{"_160":161,"_57":140,"_162":163,"_164":165,"_166":147,"_167":168,"_169":170,"_174":175,"_202":203,"_204":205,"_146":-5,"_206":207,"_208":209,"_210":211,"_212":213,"_317":318,"_319":320,"_321":322,"_143":144},"id","4df5cf04-3393-4883-9cb6-f83c88032cc8","model","IG3000LT","name","IG3000LT Low-Range Turbidity Analyzer","shortDescription","featured",false,"category",{"_57":171,"_172":-5,"_164":109,"_146":-5,"_143":173},"water","brand",{"_103":109,"_146":-5,"_148":-5,"_150":151},"heroImage",{"_160":176,"_139":177,"_178":179,"_180":181,"_182":183,"_184":185,"_186":187,"_188":189,"_190":149,"_191":192,"_193":194},"257d01fc-7670-46be-af54-0ae68bffbc45","IMAGE","originalName","2025040860761681.jpg","mimeType","image/png","size",133072,"sha256","32687b0fb7e3209190a365f6165fd1befe9616a983cc291c12aca450fcae88b2","width",327,"height",551,"url","createdAt","2026-10-20T17:32:39.781Z","variants",[195,200],{"_186":196,"_188":197,"_180":198,"_190":199},320,539,"image/webp","/igenu-preview/media/f37ebd4fe6509270a9cebcfb.webp",{"_186":187,"_188":189,"_180":198,"_190":201},"/igenu-preview/media/eeb83d74a18b9d4f5cb4ef75.webp","detailLayout","STRUCTURED","availableLocales",[19,20,11],"bodyHtml","<strong><span>Product features:</span></strong><br />◆ Meets and exceeds the requirements of USEPA 180.1 method<br />◆ Stable and efficient bubble removal system<br />◆ Compact structure, small footprint<br />◆Low operating costs<br />◆135mL flow cell - low hysteresis, high sensitivity<br />◆Simultaneously measure and display temperature<br />◆ Easy cleaning and maintenance<br />◆ Output locking function, easy to maintain<br /><strong><span>Application areas:</span></strong><br />Drinking water treatment system, monitoring of drinking water pipe network, membrane treatment process, food and pharmaceutical engineering, monitoring of canned water system, wastewater discharge outlet<br /><strong><span>Technical parameters:</span></strong><br />Range: 0-100NTU<br />Resolution: 0.0001NTU<br />Accuracy: ± 1% of the reading, or 0.008 NTU, whichever is greater (less than 20 NTU);<br />± 2% of the reading, or 0.015NTU, whichever is greater (greater than 20NTU)<br />Response time: 30 seconds to reach 90%<br />Measurement unit: NTU<br />Temperature unit: ℃<br />Calibration: zero point calibration, 1-point standard sample calibration, temperature calibration, slope calibration<br />Display: Large screen LED display, 7-key menu navigation<br />Signal filtering: 0-100S<br />Analog output: 2-channel 4-20mA<br />Digital Communication: MODBUS/RS485,MODBUS/RS232，Profibus，DeviceNet、CANopen、EthermetIP、ModbusTCP,TCP/IP<br />Relay: 2-channel FromC, 5A@250VAC<br />Sample flow rate: 200-750mL/min<br />Water temperature:- 5~50℃<br />Environmental temperature:- 20~60℃<br />Light source: White light (tungsten lamp)<br />Light chamber: anodized aluminum<br />Circulation pool: ABS plastic, 135ml<br />Sensor material: quartz, anodized aluminum<br />Inlet pipe interface: 1/4<br />Inlet pipe interface: 3/8<br />Power requirements: 100-230VAC, 50/60Hz<br />Controller size: 200mm * 200mm * 70mm<br />Sensor and flow cell size: 210mm * 140mm * 100mm<br />Power consumption: ≤ 10W\n    ","gallery",[],"features",[],"specificationGroups",[214],{"_164":215,"_216":217},"Technical specifications","specifications",[218,225,229,233,237,241,245,249,253,257,261,265,269,273,277,281,285,289,293,297,301,305,309,313],{"_219":220,"_108":221,"_222":223,"_224":-5},"key","measurement-range","Range","value","0-100NTU","unit",{"_219":226,"_108":227,"_222":228,"_224":-5},"resolution","Resolution","0.0001NTU",{"_219":230,"_108":231,"_222":232,"_224":-5},"accuracy","Accuracy","± 1% of the reading, or 0.008 NTU, whichever is greater (less than 20 NTU);",{"_219":234,"_108":235,"_222":236,"_224":-5},"response-time","Response time","30 seconds to reach 90%",{"_219":238,"_108":239,"_222":240,"_224":-5},"units","Measurement unit","NTU",{"_219":242,"_108":243,"_222":244,"_224":-5},"temperature-unit","Temperature unit","℃",{"_219":246,"_108":247,"_222":248,"_224":-5},"calibration","Calibration","zero point calibration, 1-point standard sample calibration, temperature calibration, slope calibration",{"_219":250,"_108":251,"_222":252,"_224":-5},"display","Display","Large screen LED display, 7-key menu navigation",{"_219":254,"_108":255,"_222":256,"_224":-5},"signal-filtering","Signal filtering","0-100S",{"_219":258,"_108":259,"_222":260,"_224":-5},"analog-output","Analog output","2-channel 4-20mA",{"_219":262,"_108":263,"_222":264,"_224":-5},"digital-communication","Digital Communication","MODBUS/RS485,MODBUS/RS232，Profibus，DeviceNet、CANopen、EthermetIP、ModbusTCP,TCP/IP",{"_219":266,"_108":267,"_222":268,"_224":-5},"relay","Relay","2-channel FromC, 5A@250VAC",{"_219":270,"_108":271,"_222":272,"_224":-5},"sample-flow","Sample flow rate","200-750mL/min",{"_219":274,"_108":275,"_222":276,"_224":-5},"water-temperature","Water temperature","- 5~50℃",{"_219":278,"_108":279,"_222":280,"_224":-5},"operating-temperature","Environmental temperature","- 20~60℃",{"_219":282,"_108":283,"_222":284,"_224":-5},"light-source","Light source","White light (tungsten lamp)",{"_219":286,"_108":287,"_222":288,"_224":-5},"light-chamber","Light chamber","anodized aluminum",{"_219":290,"_108":291,"_222":292,"_224":-5},"flow-cell","Circulation pool","ABS plastic, 135ml",{"_219":294,"_108":295,"_222":296,"_224":-5},"sensor-material","Sensor material","quartz, anodized aluminum",{"_219":298,"_108":299,"_222":300,"_224":-5},"inlet-connection","Inlet pipe interface","1/4; 3/8",{"_219":302,"_108":303,"_222":304,"_224":-5},"power-supply","Power requirements","100-230VAC, 50/60Hz",{"_219":306,"_108":307,"_222":308,"_224":-5},"controller-size","Controller size","200mm * 200mm * 70mm",{"_219":310,"_108":311,"_222":312,"_224":-5},"sensor-cell-size","Sensor and flow cell size","210mm * 140mm * 100mm",{"_219":314,"_108":315,"_222":316,"_224":-5},"power-consumption","Power consumption","≤ 10W","sourceReviews",[],"documents",[],"supportDownloads",[]]
