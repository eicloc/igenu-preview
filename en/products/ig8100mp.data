avigation",[102,118],{"_103":104,"_105":106},"title","Products","links",[107,112,115],{"_108":109,"_110":111},"label","Water analysis","href","/en/products?category=water",{"_108":113,"_110":114},"Industrial measurement","/en/products?category=industrial",{"_108":116,"_110":117},"Gas detection","/en/products?category=gas",{"_103":119,"_105":120},"Explore",[121,123,126,129,132],{"_108":79,"_110":122},"/en/about",{"_108":124,"_110":125},"Customer cases","/en/cases",{"_108":127,"_110":128},"News","/en/news",{"_108":130,"_110":131},"After-sales service","/en/service",{"_108":133,"_110":134},"Downloads","/en/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig8100mp",[],[],"seo",{"_103":145,"_146":147,"_148":149,"_150":151},"IG8100MP Portable Gas Detector and Alarm | IGENU SCIENCE","description","A portable gas detector with pumped sampling and sensor options selected for the target gases. A color display presents measurement information, while audible, visual and vibration alarms support on-site awareness during mobile gas monitoring and inspection work.","imageUrl","/igenu-preview/media/08e61223b82894782eed9185.png","index",true,"canonical","https://eicloc.github.io/igenu-preview/en/products/ig8100mp","query",{},"selected",[],"detail",{"_160":161,"_57":140,"_162":163,"_164":165,"_166":147,"_167":168,"_169":170,"_174":175,"_206":207,"_208":209,"_146":-5,"_210":211,"_212":213,"_214":215,"_216":217,"_285":286,"_287":288,"_289":290,"_143":144},"id","d712539f-bba5-44ea-9c7e-5be89c6d40ac","model","IG8100MP","name","IG8100MP Portable Gas Detector and Alarm","shortDescription","featured",false,"category",{"_57":171,"_172":-5,"_164":116,"_146":-5,"_143":173},"gas","brand",{"_103":116,"_146":-5,"_148":-5,"_150":151},"heroImage",{"_160":176,"_139":177,"_178":179,"_180":181,"_182":183,"_184":185,"_186":187,"_188":189,"_190":149,"_191":192,"_193":194},"2c4a4ac6-d50b-4737-b7e4-ebc32635cd6c","IMAGE","originalName","2025040852237053.png","mimeType","image/png","size",280168,"sha256","08e61223b82894782eed918587b2b8ae3b4fa6fbbb2b5228bbfebeca395a748a","width",691,"height",699,"url","createdAt","2026-10-20T17:32:39.713Z","variants",[195,200,204],{"_186":196,"_188":197,"_180":198,"_190":199},320,324,"image/webp","/igenu-preview/media/5f86a27572b4892ac922fa01.webp",{"_186":201,"_188":202,"_180":198,"_190":203},640,647,"/igenu-preview/media/56eed4aed7ff6130c91bdc9f.webp",{"_186":187,"_188":189,"_180":198,"_190":205},"/igenu-preview/media/50e8b14977630a4f3e555596.webp","detailLayout","STRUCTURED","availableLocales",[19,20,11],"bodyHtml","<p><strong><span>Product features:</span></strong></p><p>◆2.5-inch high-definition color screen, three display modes, capable of displaying curve graphs<br />◆ Equipped with a standard um level filter, it can filter out 99% of oil, water, dust and impurities, making it easier to operate and use<br />◆ Supports 1-4 types of sensors, millisecond level response, high accuracy<br />◆Pump suction sampling, suitable for any scenario<br />◆Triple alarm (sound and light, vibration), not easy to ignore<br /></p><p><strong><span>Technical Parameter：</span></strong></p><p>Gas detection:</p>Oxygen, sulfur, and oxides<br />Oxygen O2, ozone O3, carbon monoxide CO, carbon dioxide CO2, nitric oxide NO, nitrogen dioxide NO2, nitrogen oxides NOx, sulfur dioxide SO2, chlorine dioxide CLO2<br />Nitrogen, hydrogen, and cyanide<br />Hydrogen H2, ammonia NH3, hydrogen sulfide H2S, nitrogen N2, hydrogen chloride HCL, phosphine PH3, hydrogen cyanide HCN, arsine AsH3, hydrogen fluoride HF<br />Alkanes and flammable gases<br />Combustible gases EX, methane CH4, ethane C2H6, propane C3H8, epoxyethane C2H4O<br />Organic volatile gases<br />Odor ODOR, benzene C6H6, toluene C7H8, xylene C8H10 VOCs 、 Formaldehyde CH2O, ethylene C2H4, ethanol C2H6O, non methane total hydrocarbons<br />Halogen, halogenated hydrocarbon<br />Sulfur hexafluoride SF6, chlorine gas CL2, fluorine gas F2, bromine gas Br2<br />Detection principle: electrochemical method/infrared method/catalytic combustion/PID<br />Measurement range: 0~50/100ppm, 0~50/100%Vol <br />resolving power: 0.01ppm，0.01%VOL <br />Detection limit: 0.05ppm, 0.05% VOL<br />Accuracy: ≤ ±1%F.S <br />Zero drift: ≤ ± 1% F.S/year<br />Response time: ≤ 15 seconds (T90)<br />Recovery time: ≤ 20 seconds<br />Testing method: pump suction<br />Temperature and humidity: Temperature detection range: -40~120 ℃, temperature detection range: 0-100% RH<br />Detection method: real-time, timed<br />Gas Expansion: Supports 1-4 probes<br />Zero drift: ≤± 1% (F.S/year)<br />Protection level: IP65<br />Storage mode: local memory or memory card<br />Power supply: 4600mA rechargeable polymer battery\n    ","gallery",[],"features",[],"specificationGroups",[218],{"_164":219,"_220":221},"Technical specifications","specifications",[222,229,233,237,241,245,249,253,257,261,265,269,273,277,281],{"_223":224,"_108":225,"_226":227,"_228":-5},"key","measurement-principle","Detection principle","value","electrochemical method/infrared method/catalytic combustion/PID","unit",{"_223":230,"_108":231,"_226":232,"_228":-5},"measurement-range","Measurement range","0~50/100ppm, 0~50/100%Vol",{"_223":234,"_108":235,"_226":236,"_228":-5},"resolution","resolving power","0.01ppm，0.01%VOL",{"_223":238,"_108":239,"_226":240,"_228":-5},"detection-limit","Detection limit","0.05ppm, 0.05% VOL",{"_223":242,"_108":243,"_226":244,"_228":-5},"accuracy","Accuracy","≤ ±1%F.S",{"_223":246,"_108":247,"_226":248,"_228":-5},"zero-drift","Zero drift","≤ ± 1% F.S/year; ≤± 1% (F.S/year)",{"_223":250,"_108":251,"_226":252,"_228":-5},"response-time","Response time","≤ 15 seconds (T90)",{"_223":254,"_108":255,"_226":256,"_228":-5},"recovery-time","Recovery time","≤ 20 seconds",{"_223":258,"_108":259,"_226":260,"_228":-5},"testing-method","Testing method","pump suction",{"_223":262,"_108":263,"_226":264,"_228":-5},"temperature-humidity","Temperature and humidity","Temperature detection range: -40~120 ℃, temperature detection range: 0-100% RH",{"_223":266,"_108":267,"_226":268,"_228":-5},"detection-method","Detection method","real-time, timed",{"_223":270,"_108":271,"_226":272,"_228":-5},"gas-expansion","Gas Expansion","Supports 1-4 probes",{"_223":274,"_108":275,"_226":276,"_228":-5},"protection","Protection level","IP65",{"_223":278,"_108":279,"_226":280,"_228":-5},"storage-mode","Storage mode","local memory or memory card",{"_223":282,"_108":283,"_226":284,"_228":-5},"power-supply","Power supply","4600mA rechargeable polymer battery","sourceReviews",[],"documents",[],"supportDownloads",[]]
