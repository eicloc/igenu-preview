avigation",[102,118],{"_103":104,"_105":106},"title","Products","links",[107,112,115],{"_108":109,"_110":111},"label","Water analysis","href","/en/products?category=water",{"_108":113,"_110":114},"Industrial measurement","/en/products?category=industrial",{"_108":116,"_110":117},"Gas detection","/en/products?category=gas",{"_103":119,"_105":120},"Explore",[121,123,126,129,132],{"_108":79,"_110":122},"/en/about",{"_108":124,"_110":125},"Customer cases","/en/cases",{"_108":127,"_110":128},"News","/en/news",{"_108":130,"_110":131},"After-sales service","/en/service",{"_108":133,"_110":134},"Downloads","/en/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig30cls",[],[],"seo",{"_103":145,"_146":147,"_148":149,"_150":151},"IG30CLS Residual Chlorine Sensor | IGENU SCIENCE","description","Using a constant-potential electrochemical method, this sensor measures residual chlorine and chlorine dioxide in water. A dedicated flow cell maintains sample flow, while the design avoids colorimetric reagents and routine replacement of membranes or electrolyte.","imageUrl","/igenu-preview/media/128cbf77e27c44f50a679ba8.jpg","index",true,"canonical","https://eicloc.github.io/igenu-preview/en/products/ig30cls","query",{},"selected",[],"detail",{"_160":161,"_57":140,"_162":163,"_164":165,"_166":147,"_167":168,"_169":170,"_174":175,"_202":203,"_204":205,"_146":-5,"_206":207,"_208":209,"_210":211,"_212":213,"_284":285,"_286":287,"_288":289,"_143":144},"id","979b50bb-1b83-4aa2-b03a-464c97387d69","model","IG30CLS","name","IG30CLS Residual Chlorine Sensor","shortDescription","featured",false,"category",{"_57":171,"_172":-5,"_164":109,"_146":-5,"_143":173},"water","brand",{"_103":109,"_146":-5,"_148":-5,"_150":151},"heroImage",{"_160":176,"_139":177,"_178":179,"_180":181,"_182":183,"_184":185,"_186":187,"_188":189,"_190":149,"_191":192,"_193":194},"ce0b8383-b6df-4c9a-aabb-3a55435db7a7","IMAGE","originalName","2025040861142109.png","mimeType","image/jpeg","size",22021,"sha256","128cbf77e27c44f50a679ba8b27ec860b8243697fccdc4f64b056e6497df3a79","width",344,"height",423,"url","createdAt","2026-10-20T17:32:39.792Z","variants",[195,200],{"_186":196,"_188":197,"_180":198,"_190":199},320,393,"image/webp","/igenu-preview/media/e07f5ef0e1a47e02ed6259ae.webp",{"_186":187,"_188":189,"_180":198,"_190":201},"/igenu-preview/media/ecb94564bb6e1f06cbfde7cd.webp","detailLayout","STRUCTURED","availableLocales",[19,20,11],"bodyHtml","<strong><span>Product features:</span></strong><br />◆ Adopting the principle of constant voltage<br />◆ No need to replace the membrane and electrolyte<br />◆ No need for colorimetric reagents<br />◆ Specially designed circulation channel to maintain stable flow rate<br />◆ Zero point stability, strong anti-interference ability<br />◆ Simple and convenient operation, high cost-effectiveness<br /><strong><span>Application areas:</span></strong><br />Municipal waterworks, sewage treatment plants, secondary water supply, monitoring of drinking and surface water, industrial processes<br /><strong><span>Technical parameters:</span></strong><br />Range: 0~2mg/L or 0~20mg/L<br />Measurement principle: constant voltage<br />Measurement accuracy: ± 5%<br />Repeatability: ± 5% of the reading<br />Resolution: 0.01mg/L<br />Flow rate: 25~55 L/h<br />Calibration methods: zero calibration, slope calibration<br />PH compensation: manual or automatic<br />Temperature compensation: manual or automatic<br />Slope: 75%~155%<br />Sensor material: 316L stainless steel+platinum electrode<br />Sensor voltage: 9~36VDC<br />Sensor communication: MODBUS RS-485 <br />Medium temperature: 0~50 ℃ (non freezing)<br />Cable length: standard 1.5 meters, extendable<br />Sensor size: 201mm * 35mm\n    ","gallery",[],"features",[],"specificationGroups",[214],{"_164":215,"_216":217},"Technical specifications","specifications",[218,225,229,233,237,241,245,249,253,256,260,264,268,272,276,280],{"_219":220,"_108":221,"_222":223,"_224":-5},"key","measurement-range","Range","value","0~2mg/L or 0~20mg/L","unit",{"_219":226,"_108":227,"_222":228,"_224":-5},"measurement-principle","Measurement principle","constant voltage",{"_219":230,"_108":231,"_222":232,"_224":-5},"accuracy","Measurement accuracy","± 5%",{"_219":234,"_108":235,"_222":236,"_224":-5},"repeatability","Repeatability","± 5% of the reading",{"_219":238,"_108":239,"_222":240,"_224":-5},"resolution","Resolution","0.01mg/L",{"_219":242,"_108":243,"_222":244,"_224":-5},"flow-rate","Flow rate","25~55 L/h",{"_219":246,"_108":247,"_222":248,"_224":-5},"calibration","Calibration methods","zero calibration, slope calibration",{"_219":250,"_108":251,"_222":252,"_224":-5},"ph-compensation","PH compensation","manual or automatic",{"_219":254,"_108":255,"_222":252,"_224":-5},"temperature-compensation","Temperature compensation",{"_219":257,"_108":258,"_222":259,"_224":-5},"slope","Slope","75%~155%",{"_219":261,"_108":262,"_222":263,"_224":-5},"sensor-material","Sensor material","316L stainless steel+platinum electrode",{"_219":265,"_108":266,"_222":267,"_224":-5},"sensor-voltage","Sensor voltage","9~36VDC",{"_219":269,"_108":270,"_222":271,"_224":-5},"digital-communication","Sensor communication","MODBUS RS-485",{"_219":273,"_108":274,"_222":275,"_224":-5},"medium-temperature","Medium temperature","0~50 ℃ (non freezing)",{"_219":277,"_108":278,"_222":279,"_224":-5},"cable","Cable length","standard 1.5 meters, extendable",{"_219":281,"_108":282,"_222":283,"_224":-5},"sensor-size","Sensor size","201mm * 35mm","sourceReviews",[],"documents",[],"supportDownloads",[]]
