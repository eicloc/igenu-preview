image/jpeg","size",14215,"sha256","e3e2c21db606165f614650cf931244737a0e84793f3dd9ab8bd834db8aa5b8b3","width",540,"height","url","createdAt","2026-10-20T17:32:39.888Z","variants",[194,198],{"_186":195,"_188":195,"_180":196,"_189":197},320,"image/webp","/igenu-preview/media/087409fcbd7eefe1aec06c53.webp",{"_186":187,"_188":187,"_180":196,"_189":199},"/igenu-preview/media/6d889354b11ab94fb489a773.webp","detailLayout","STRUCTURED","availableLocales",[19,20,11],"bodyHtml","<span><strong>Product features:</strong></span><br />◆The principle of ultraviolet fluorescence method for measuring oil in water has high accuracy and excellent correlation with infrared method<br />◆ Adopting titanium alloy corrosion-resistant shell; NPT3/4 threaded interface for easy installation<br />◆ With self-cleaning function, remove attachments from water samples, maintenance free<br />◆ Adopting unique optical and electronic filtering technology to eliminate the influence of ambient light on measurement<br />◆ Not affected by suspended particles in water<br /><span><strong>Application areas:</strong></span><br />Standard discharge of petroleum and petrochemical wastewater, oil content control of oilfield reinjection water, inlet protection of boiler supplementary reverse osmosis membrane, and wastewater treatment<br /><span><strong>Technical parameters:</strong></span><br />Measurement range: 0-10mg/L, 0-100mg/L,  0-1000mg/L<br />Measurement principle: UV fluorescence method<br />Measurement accuracy: ± 3% of the reading<br />Repeatability: less than ± 3%<br />Detection limit: 0.1 mg/L<br />Response time: 4 seconds<br />Calibration method: single point calibration<br />Water sample requirement: flow rate: 0-3m/s; Pressure: 0-100psi; 0-6bar; Temperature: 0-50 ℃<br />Communication interface: ModbusRS485<br />Threaded interface: standard 3/4NPT<br />Protection level: IP68<br />Installation methods: immersion type, circulation type<br />Cable length: Standard 10m, extendable<br />Electrode size: 