avigation",[102,118],{"_103":104,"_105":106},"title","Products","links",[107,112,115],{"_108":109,"_110":111},"label","Water analysis","href","/en/products?category=water",{"_108":113,"_110":114},"Industrial measurement","/en/products?category=industrial",{"_108":116,"_110":117},"Gas detection","/en/products?category=gas",{"_103":119,"_105":120},"Explore",[121,123,126,129,132],{"_108":79,"_110":122},"/en/about",{"_108":124,"_110":125},"Customer cases","/en/cases",{"_108":127,"_110":128},"News","/en/news",{"_108":130,"_110":131},"After-sales service","/en/service",{"_108":133,"_110":134},"Downloads","/en/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig9000",[],[],"seo",{"_103":145,"_146":147,"_148":149,"_150":151},"IG9000 Ultrasonic Level Transmitter | IGENU SCIENCE","description","Ultrasonic time-of-flight measurement monitors levels in liquids and bulk materials without contact with the medium. Integrated and separate arrangements, signal analysis and temperature compensation support installation in water treatment and storage tanks, with configuration options matched to the measurement point.","imageUrl","/igenu-preview/media/8ef050d2f42f424a5466c7f7.png","index",true,"canonical","https://eicloc.github.io/igenu-preview/en/products/ig9000","query",{},"selected",[],"detail",{"_160":161,"_57":140,"_162":163,"_164":165,"_166":147,"_167":168,"_169":170,"_174":175,"_216":217,"_218":219,"_146":-5,"_220":221,"_222":223,"_224":225,"_226":227,"_326":327,"_357":358,"_359":360,"_143":144},"id","43425fa1-18a8-4ebe-995e-466a914f67da","model","IG9000","name","IG9000 Ultrasonic Level Transmitter","shortDescription","featured",false,"category",{"_57":171,"_172":-5,"_164":113,"_146":-5,"_143":173},"industrial","brand",{"_103":113,"_146":-5,"_148":-5,"_150":151},"heroImage",{"_160":176,"_139":177,"_178":179,"_180":181,"_182":183,"_184":185,"_186":187,"_188":189,"_190":149,"_191":192,"_193":194},"485bff13-2df9-448f-a8bc-6b60b3e5ad76","IMAGE","originalName","2025040851503805.png","mimeType","image/png","size",698863,"sha256","8ef050d2f42f424a5466c7f703dc0ddcbb2915dc23bdee338481847f3cefa2dd","width",2604,"height",1704,"url","createdAt","2026-10-20T17:32:39.690Z","variants",[195,200,204,208,212],{"_186":196,"_188":197,"_180":198,"_190":199},320,209,"image/webp","/igenu-preview/media/63971d02adf57bfde6335036.webp",{"_186":201,"_188":202,"_180":198,"_190":203},640,419,"/igenu-preview/media/94e5c9a427aaff2e7fe15add.webp",{"_186":205,"_188":206,"_180":198,"_190":207},960,628,"/igenu-preview/media/6403302113043098a393f716.webp",{"_186":209,"_188":210,"_180":198,"_190":211},1280,838,"/igenu-preview/media/bd1f66f7ac71cc90284d1d8d.webp",{"_186":213,"_188":214,"_180":198,"_190":215},1600,1047,"/igenu-preview/media/0f4d290e7e86d3dd29596237.webp","detailLayout","STRUCTURED","availableLocales",[19,20,11],"bodyHtml","<strong><span>Product features:</span></strong><br />◆ Integrated or split type options, suitable for different on-site installation requirements<br />◆The host can be selected as single channel or dual channel, and can achieve functions such as multi-point measurement and alarm<br />◆ Simple to use, reliable results, interface operation instructions can reduce operational errors<br />◆The probe material is available in POM, PVDF, PTFE options, suitable for various working conditions<br />◆ Internally integrated temperature sensor, capable of real-time temperature compensation for sound velocity<br /><p><strong><span>Application areas:</span></strong></p>Government wastewater, industrial wastewater, environmental monitoring, monitoring of drinking and surface water, industrial processes<br /><p><strong><span>Technical parameters:</span></strong></p><strong><span>Integrated</span></strong><br />Power Supply: DC18-36V； AC90-260V <br />Output: 0/4-20mA; RS485 (optional)<br />Range: 0~5/10/15/20m<br />Accuracy: 0.25% (range)<br />Resolution: 1mm<br />Blind zone: 0.3~0.6 (visual range)<br />Display type: 128 * 64LCD (in Chinese and English, echo signal)<br />Display mode: liquid level, air distance<br />Process temperature:- 30℃~80℃ <br />Protection level: IP68 (wire diameter 7-12mm)<br />Electrical interface: M20*1.5 <br />Control: 2-channel programmable relay<br />Fault alarm: Yes<br />Signal search: this function can effectively deal with situations with poor signal reflection such as foam and garbage floats<br /><strong><span>split type</span></strong><br />Power Supply: DC18-36V； AC90-260V <br />Output: 2-channel 0/4-20mA; RS485 (optional)<br />Range: 0~5/10/15/20m<br />Accuracy: 0.25% (range)<br />Resolution: 1mm Blind Zone: 0.3~0.6 (Visual Range)<br />Display type: 192 * 64LCD (in Chinese and English, echo signal)<br />Display mode: liquid level, air distance<br />Process temperature: transmitter: -30 ℃~80 ℃; Sensor:- 40℃~80℃ <br />Protection level: Transmitter: IP65； Sensor: IP68 (wire diameter 7-12mm)<br />Electrical interface: M20*1.5 <br />Control: 4-channel programmable relay<br />Fault alarm: Yes<br />Signal search: this function can effectively deal with situations with poor signal reflection such as foam and garbage floats\n    ","gallery",[],"features",[],"specificationGroups",[228,291],{"_164":229,"_230":231},"Integrated","specifications",[232,239,243,247,251,255,259,263,267,271,275,279,283,287],{"_233":234,"_108":235,"_236":237,"_238":-5},"key","integrated.power-supply","Power Supply","value","DC18-36V； AC90-260V","unit",{"_233":240,"_108":241,"_236":242,"_238":-5},"integrated.output","Output","0/4-20mA; RS485 (optional)",{"_233":244,"_108":245,"_236":246,"_238":-5},"integrated.measurement-range","Range","0~5/10/15/20m",{"_233":248,"_108":249,"_236":250,"_238":-5},"integrated.accuracy","Accuracy","0.25% (range)",{"_233":252,"_108":253,"_236":254,"_238":-5},"integrated.resolution","Resolution","1mm",{"_233":256,"_108":257,"_236":258,"_238":-5},"integrated.blind-zone","Blind zone","0.3~0.6 (visual range)",{"_233":260,"_108":261,"_236":262,"_238":-5},"integrated.display","Display type","128 * 64LCD (in Chinese and English, echo signal)",{"_233":264,"_108":265,"_236":266,"_238":-5},"integrated.display-mode","Display mode","liquid level, air distance",{"_233":268,"_108":269,"_236":270,"_238":-5},"integrated.process-temperature","Process temperature","- 30℃~80℃",{"_233":272,"_108":273,"_236":274,"_238":-5},"integrated.protection","Protection level","IP68 (wire diameter 7-12mm)",{"_233":276,"_108":277,"_236":278,"_238":-5},"integrated.connection","Electrical interface","M20*1.5",{"_233":280,"_108":281,"_236":282,"_238":-5},"integrated.control","Control","2-channel programmable relay",{"_233":284,"_108":285,"_236":286,"_238":-5},"integrated.fault-alarm","Fault alarm","Yes",{"_233":288,"_108":289,"_236":290,"_238":-5},"integrated.signal-search","Signal search","this function can effectively deal with situations with poor signal reflection such as foam and garbage floats",{"_164":292,"_230":293},"Split type",[294,296,299,301,303,306,309,311,314,317,319,322,324],{"_233":295,"_108":235,"_236":237,"_238":-5},"split.power-supply",{"_233":297,"_108":241,"_236":298,"_238":-5},"split.output","2-channel 0/4-20mA; RS485 (optional)",{"_233":300,"_108":245,"_236":246,"_238":-5},"split.measurement-range",{"_233":302,"_108":249,"_236":250,"_238":-5},"split.accuracy",{"_233":304,"_108":253,"_236":305,"_238":-5},"split.resolution","1mm Blind Zone: 0.3~0.6 (Visual Range)",{"_233":307,"_108":261,"_236":308,"_238":-5},"split.display","192 * 64LCD (in Chinese and English, echo signal)",{"_233":310,"_108":265,"_236":266,"_238":-5},"split.display-mode",{"_233":312,"_108":269,"_236":313,"_238":-5},"split.process-temperature","transmitter: -30 ℃~80 ℃; Sensor:- 40℃~80℃",{"_233":315,"_108":273,"_236":316,"_238":-5},"split.protection","Transmitter: IP65； Sensor: IP68 (wire diameter 7-12mm)",{"_233":318,"_108":277,"_236":278,"_238":-5},"split.connection",{"_233":320,"_108":281,"_236":321,"_238":-5},"split.control","4-channel programmable relay",{"_233":323,"_108":