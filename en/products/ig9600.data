avigation",[102,118],{"_103":104,"_105":106},"title","Products","links",[107,112,115],{"_108":109,"_110":111},"label","Water analysis","href","/en/products?category=water",{"_108":113,"_110":114},"Industrial measurement","/en/products?category=industrial",{"_108":116,"_110":117},"Gas detection","/en/products?category=gas",{"_103":119,"_105":120},"Explore",[121,123,126,129,132],{"_108":79,"_110":122},"/en/about",{"_108":124,"_110":125},"Customer cases","/en/cases",{"_108":127,"_110":128},"News","/en/news",{"_108":130,"_110":131},"After-sales service","/en/service",{"_108":133,"_110":134},"Downloads","/en/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig9600",[],[],"seo",{"_103":145,"_146":147,"_148":149,"_150":151},"IG9600 Ultrasonic Sludge Interface Monitor | IGENU SCIENCE","description","Ultrasonic echo timing identifies the sludge interface in settling and thickening tanks. A separate probe, integrated temperature compensation and local display support monitoring in wastewater treatment and waterworks sedimentation processes, with configuration adapted to the installation.","imageUrl","/igenu-preview/media/65b4e4d80f69906e1d7bb840.png","index",true,"canonical","https://eicloc.github.io/igenu-preview/en/products/ig9600","query",{},"selected",[],"detail",{"_160":161,"_57":140,"_162":163,"_164":165,"_166":147,"_167":168,"_169":170,"_174":175,"_216":217,"_218":219,"_146":-5,"_220":221,"_222":223,"_224":225,"_226":227,"_307":308,"_309":310,"_311":312,"_143":144},"id","12c35e01-af3a-4ad0-b514-1b67363212af","model","IG9600","name","IG9600 Ultrasonic Sludge Interface Monitor","shortDescription","featured",false,"category",{"_57":171,"_172":-5,"_164":113,"_146":-5,"_143":173},"industrial","brand",{"_103":113,"_146":-5,"_148":-5,"_150":151},"heroImage",{"_160":176,"_139":177,"_178":179,"_180":181,"_182":183,"_184":185,"_186":187,"_188":189,"_190":149,"_191":192,"_193":194},"fe68277b-0e41-4c1a-b0a4-8bfebd654caa","IMAGE","originalName","2025040854938433.png","mimeType","image/png","size",549953,"sha256","65b4e4d80f69906e1d7bb840b3735e20c7fa903b831162b2a977ae41ff5f77d9","width",2064,"height",1704,"url","createdAt","2026-10-20T17:32:39.735Z","variants",[195,200,204,208,212],{"_186":196,"_188":197,"_180":198,"_190":199},320,264,"image/webp","/igenu-preview/media/2dc78a489616479a5aadfbac.webp",{"_186":201,"_188":202,"_180":198,"_190":203},640,528,"/igenu-preview/media/aae51fe4186be6ad1749b345.webp",{"_186":205,"_188":206,"_180":198,"_190":207},960,793,"/igenu-preview/media/50b869a018e4f784a789e882.webp",{"_186":209,"_188":210,"_180":198,"_190":211},1280,1057,"/igenu-preview/media/44748a134c7000c8efd4c395.webp",{"_186":213,"_188":214,"_180":198,"_190":215},1600,1321,"/igenu-preview/media/8ef2f704c499019d37e0855c.webp","detailLayout","STRUCTURED","availableLocales",[19,20,11],"bodyHtml","<strong><span>Product features:</span></strong><br />◆ Split type, suitable for different on-site installation requirements<br />◆The host has a Chinese and English operating interface, which can achieve functions such as multi-point measurement and alarm<br />◆ Simple to use, reliable results, interface operation instructions can reduce operational errors<br />◆The probe material is available in POM, PVDF, PTFE options, suitable for various working conditions<br /><p>◆ Internally integrated temperature sensor, capable of real-time temperature compensation for sound velocity</p><p><strong><span>Technical parameters:</span></strong></p>Measurement range: 0.2~10/15/20m<br />Resolution:&lt; 0.04m <br />Accuracy: 0.1m ± 0.05m<br />Response time: 10-900s (adjustable)<br />Calibration: It only needs to be performed once when turning on the device<br />Automatic pressure range: ≤ 0.3bar <br />Environmental temperature: 0-50 ℃<br />Temperature compensation: automatic compensation<br />Protection level: IP68 <br />Flow rate requirement: ≤ 3m/s<br />Size: 140mm × 195mm (H × D)<br />Weight: Approximately 3.5Kg<br />Maintenance: Regular&lt;1 hour/month<br />Cable length: 10m, extended by at least 100m<br />Output: 2-channel 0/4-20mA, load 750 Ω<br />Alarm: Multi way relay, 220VAC/2A 485<br />Signal: Modbus protocol (optional)<br />Process temperature: transmitter: -30 ℃~80 ℃; Sensor:- 40℃~80℃ <br />Protection level: Transmitter: IP65； Transmitter: IP68 <br />Power Supply: DC18-36V； AC90-260V\n    ","gallery",[],"features",[],"specificationGroups",[228],{"_164":229,"_230":231},"Technical specifications","specifications",[232,239,243,247,251,255,259,263,267,271,275,279,283,287,291,295,299,303],{"_233":234,"_108":235,"_236":237,"_238":-5},"key","measurement-range","Measurement range","value","0.2~10/15/20m","unit",{"_233":240,"_108":241,"_236":242,"_238":-5},"resolution","Resolution","< 0.04m",{"_233":244,"_108":245,"_236":246,"_238":-5},"accuracy","Accuracy","0.1m ± 0.05m",{"_233":248,"_108":249,"_236":250,"_238":-5},"response-time","Response time","10-900s (adjustable)",{"_233":252,"_108":253,"_236":254,"_238":-5},"calibration","Calibration","It only needs to be performed once when turning on the device",{"_233":256,"_108":257,"_236":258,"_238":-5},"automatic-pressure-range","Automatic pressure range","≤ 0.3bar",{"_233":260,"_108":261,"_236":262,"_238":-5},"operating-temperature","Environmental temperature","0-50 ℃",{"_233":264,"_108":265,"_236":266,"_238":-5},"temperature-compensation","Temperature compensation","automatic compensation",{"_233":268,"_108":269,"_236":270,"_238":-5},"protection","Protection level","IP68; Transmitter: IP65； Transmitter: IP68",{"_233":272,"_108":273,"_236":274,"_238":-5},"flow-requirement","Flow rate requirement","≤ 3m/s",{"_233":276,"_108":277,"_236":278,"_238":-5},"dimensions","Size","140mm × 195mm (H × D)",{"_233":280,"_108":281,"_236":282,"_238":-5},"weight","Weight","Approximately 3.5Kg",{"_233":284,"_108":285,"_236":286,"_238":-5},"maintenance","Maintenance","Regular<1 hour/month",{"_233":288,"_108":289,"_236":290,"_238":-5},"cable","Cable length","10m, extended by at least 100m",{"_233":292,"_108":293,"_236":294,"_238":-5},"output","Output","2-channel 0/4-20mA, load 750 Ω; Modbus protocol (optional)",{"_233":296,"_108":297,"_236":298,"_238":-5},"alarm","Alarm","Multi way relay, 220VAC/2A 485",{"_233":300,"_108":301,"_236":302,"_238":-5},"process-temperature","Process temperature","transmitter: -30 ℃~80 ℃; Sensor:- 40℃~80℃",{"_233":304,"_108":305,"_236":306,"_238":-5},"power-supply","Power Supply","DC18-36V； AC90-260V","sourceReviews",[],"documents",[],"supportDownloads",[]]
