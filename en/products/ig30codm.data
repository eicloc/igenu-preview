avigation",[102,118],{"_103":104,"_105":106},"title","Products","links",[107,112,115],{"_108":109,"_110":111},"label","Water analysis","href","/en/products?category=water",{"_108":113,"_110":114},"Industrial measurement","/en/products?category=industrial",{"_108":116,"_110":117},"Gas detection","/en/products?category=gas",{"_103":119,"_105":120},"Explore",[121,123,126,129,132],{"_108":79,"_110":122},"/en/about",{"_108":124,"_110":125},"Customer cases","/en/cases",{"_108":127,"_110":128},"News","/en/news",{"_108":130,"_110":131},"After-sales service","/en/service",{"_108":133,"_110":134},"Downloads","/en/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig30codm",[],[],"seo",{"_103":145,"_146":147,"_148":149,"_150":151},"IG30CODM Colored Dissolved Organic Matter Sensor | IGENU SCIENCE","description","Ultraviolet fluorescence measures colored dissolved organic matter directly in water. A compact probe, automatic cleaning brush and digital communication support continuous online monitoring in rivers, lakes, groundwater and wastewater, with deployment tailored to the monitoring location.","imageUrl","/igenu-preview/media/3a4bd3a9ba0af3bd90061177.jpg","index",true,"canonical","https://eicloc.github.io/igenu-preview/en/products/ig30codm","query",{},"selected",[],"detail",{"_160":161,"_57":140,"_162":163,"_164":165,"_166":147,"_167":168,"_169":170,"_174":175,"_200":201,"_202":203,"_146":-5,"_204":205,"_206":207,"_208":209,"_210":211,"_279":280,"_281":282,"_283":284,"_143":144},"id","a4f89e53-652b-45dd-9cfa-d40ea54aa7f6","model","IG30CODM","name","IG30CODM Colored Dissolved Organic Matter Sensor","shortDescription","featured",false,"category",{"_57":171,"_172":-5,"_164":109,"_146":-5,"_143":173},"water","brand",{"_103":109,"_146":-5,"_148":-5,"_150":151},"heroImage",{"_160":176,"_139":177,"_178":179,"_180":181,"_182":183,"_184":185,"_186":187,"_188":187,"_189":149,"_190":191,"_192":193},"e9c2938f-6236-4c7f-bf9d-752bcf98b444","IMAGE","originalName","2025040861512869.jpg","mimeType","image/jpeg","size",13520,"sha256","3a4bd3a9ba0af3bd90061177b116d1a851d9d410ca383514dfbd7fdb3aa5270f","width",540,"height","url","createdAt","2026-10-20T17:32:39.805Z","variants",[194,198],{"_186":195,"_188":195,"_180":196,"_189":197},320,"image/webp","/igenu-preview/media/9fb61c06fe27bcc0e9cecfd6.webp",{"_186":187,"_188":187,"_180":196,"_189":199},"/igenu-preview/media/b63396be40013d2d55e983f5.webp","detailLayout","STRUCTURED","availableLocales",[19,20,11],"bodyHtml","<span><strong>Product features:</strong></span><br />◆ Sensor, using the principle of ultraviolet fluorescence analysis, specifically designed to detect colored soluble organic matter in water bodies<br />◆ It is applicable to the measurement of colored soluble organic matter in Rivers and Lakes, with high sensitivity, small size, automatic cleaning brush, etc., suitable for long-term online monitoring<br />◆ Applied in environmental monitoring, groundwater monitoring, marine research, wastewater treatment and other fields<br />◆ RS485 output, supporting MODBUS, can be easily integrated into water quality monitoring systems to meet customer needs<br /><span><strong>Application areas:</strong></span><br />Environmental monitoring, groundwater monitoring, marine research, wastewater treatment<br /><span><strong>Technical parameters:</strong></span><br />Measurement range: 0-400ppb<br />Measurement principle: UV fluorescence method<br />Measurement accuracy: ± 3% of the reading<br />Repeatability: less than ± 3%<br />Detection limit: 0.1 ppb<br />Response time: 4 seconds<br />Linearity: R2&gt;0.999 (continuous dilution of standard solution)<br />Water sample requirement: flow rate: 0-3m/s; Pressure: 0-100psi; 0-6bar; Temperature: 0-50 ℃<br />Communication interface: ModbusRS485<br />Threaded interface: standard 3/4NPT<br />Protection level: IP68<br />Installation methods: immersion type, circulation type<br />Cable length: Standard 10m, extendable<br />Sensor material: 316L<br />Electrode size: 190mm * 46mm\n    ","gallery",[],"features",[],"specificationGroups",[212],{"_164":213,"_214":215},"Technical specifications","specifications",[216,223,227,231,235,239,243,247,251,255,259,263,267,271,275],{"_217":218,"_108":219,"_220":221,"_222":-5},"key","measurement-range","Measurement range","value","0-400ppb","unit",{"_217":224,"_108":225,"_220":226,"_222":-5},"measurement-principle","Measurement principle","UV fluorescence method",{"_217":228,"_108":229,"_220":230,"_222":-5},"accuracy","Measurement accuracy","± 3% of the reading",{"_217":232,"_108":233,"_220":234,"_222":-5},"repeatability","Repeatability","less than ± 3%",{"_217":236,"_108":237,"_220":238,"_222":-5},"detection-limit","Detection limit","0.1 ppb",{"_217":240,"_108":241,"_220":242,"_222":-5},"response-time","Response time","4 seconds",{"_217":244,"_108":245,"_220":246,"_222":-5},"linearity","Linearity","R2>0.999 (continuous dilution of standard solution)",{"_217":248,"_108":249,"_220":250,"_222":-5},"water-sample","Water sample requirement","flow rate: 0-3m/s; Pressure: 0-100psi; 0-6bar; Temperature: 0-50 ℃",{"_217":252,"_108":253,"_220":254,"_222":-5},"digital-communication","Communication interface","ModbusRS485",{"_217":256,"_108":257,"_220":258,"_222":-5},"thread","Threaded interface","standard 3/4NPT",{"_217":260,"_108":261,"_220":262,"_222":-5},"protection","Protection level","IP68",{"_217":264,"_108":265,"_220":266,"_222":-5},"installation","Installation methods","immersion type, circulation type",{"_217":268,"_108":269,"_220":270,"_222":-5},"cable","Cable length","Standard 10m, extendable",{"_217":272,"_108":273,"_220":274,"_222":-5},"sensor-material","Sensor material","316L",{"_217":276,"_108":277,"_220":278,"_222":-5},"electrode-size","Electrode size","190mm * 46mm","sourceReviews",[],"documents",[],"supportDownloads",[]]
