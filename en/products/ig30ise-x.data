avigation",[102,118],{"_103":104,"_105":106},"title","Products","links",[107,112,115],{"_108":109,"_110":111},"label","Water analysis","href","/en/products?category=water",{"_108":113,"_110":114},"Industrial measurement","/en/products?category=industrial",{"_108":116,"_110":117},"Gas detection","/en/products?category=gas",{"_103":119,"_105":120},"Explore",[121,123,126,129,132],{"_108":79,"_110":122},"/en/about",{"_108":124,"_110":125},"Customer cases","/en/cases",{"_108":127,"_110":128},"News","/en/news",{"_108":130,"_110":131},"After-sales service","/en/service",{"_108":133,"_110":134},"Downloads","/en/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig30ise-x",[],[],"seo",{"_103":145,"_146":147,"_148":149,"_150":151},"IG30ISE-X Ion-Selective Electrode | IGENU SCIENCE","description","Ion-selective measurement supports water monitoring for configured ion parameters and pH. The immersion probe operates without a separate sampling system and provides compensation and calibration functions, making it suitable for drinking water, environmental and wastewater applications.","imageUrl","/igenu-preview/media/8936108072d3c61053c40f38.png","index",true,"canonical","https://eicloc.github.io/igenu-preview/en/products/ig30ise-x","query",{},"selected",[],"detail",{"_160":161,"_57":140,"_162":163,"_164":165,"_166":147,"_167":168,"_169":170,"_174":175,"_198":199,"_200":201,"_146":-5,"_202":203,"_204":205,"_206":207,"_208":209,"_312":313,"_314":315,"_316":317,"_143":144},"id","0edda979-2d5f-4caa-bde7-a1368da21597","model","IG30ISE-X","name","IG30ISE-X Ion-Selective Electrode","shortDescription","featured",false,"category",{"_57":171,"_172":-5,"_164":109,"_146":-5,"_143":173},"water","brand",{"_103":109,"_146":-5,"_148":-5,"_150":151},"heroImage",{"_160":176,"_139":177,"_178":179,"_180":181,"_182":183,"_184":185,"_186":187,"_188":189,"_190":149,"_191":192,"_193":194},"c6e3c765-909d-45fd-bd1c-7dbc51fecd54","IMAGE","originalName","2025041051038309.png","mimeType","image/png","size",13330,"sha256","8936108072d3c61053c40f382494eb98c8734713fb66a99450bf2aedb26fb684","width",320,"height",120,"url","createdAt","2026-10-20T17:32:39.882Z","variants",[195],{"_186":187,"_188":189,"_180":196,"_190":197},"image/webp","/igenu-preview/media/f11ab30d5325a31abe0f2adb.webp","detailLayout","STRUCTURED","availableLocales",[19,20,11],"bodyHtml","<span><strong>Product features:</strong></span><br />◆ Stable and reliable, ion selective method and multi parameter compensation technology, accurate and stable measurement<br />◆ Easy installation, the sensor is directly submerged in water without the need for sampling<br />◆ Easy maintenance, only requiring regular calibration and cleaning<br />◆ Equipped with temperature pH、 Automatic compensation function for potassium ions, etc<br />◆ Multi parameter display and output function, one machine for multiple purposes<br />◆ Capable of single point and multi-point calibration<br /><span><strong>Application areas:</strong></span><br />Environmental monitoring, monitoring of drinking and surface water, industrial wastewater, sewage, domestic wastewater, sewage, groundwater, lake water<br /><strong><span>Technical parameters:</span></strong><br />Measurement principle: ion selective electrode method<br />Detailed measurement principle: ion carrier membrane, non porous reference electrode<br />Measurement parameters: ammonia nitrogen, nitrate nitrogen pH、 Potassium ions, chloride ions, fluoride ions<br />Measurement range: Ammonia ion: 0.1-1000mg/L (up to 10000mg/L maximum)<br />Nitrous nitrogen: 0.1-1000mg/L (up to 10000mg/L maximum)<br />Chloride ion: 0.1-1000mg/L (up to 10000mg/L maximum)<br />Potassium ion: 0.1-1000mg/L (up to 10000mg/L maximum)<br />pH：2-12pH<br />Fluoride ion: 0.1-1000mg/L (up to 10000mg/L maximum)<br />Accuracy: ± 3% or ± 0.1 mg/L of the reading, whichever is greater<br />Resolution: 0.01 mg/L, 0.01 pH<br />Repeatability: ± 1% FS<br />Response time: T90≤30s, Fluoride ion T90 ≤ 60s<br />Potassium ion compensation: manual or automatic<br />PH compensation: manual or automatic<br />Temperature compensation: automatic<br />Calibration: single point calibration, two-point calibration<br />Operating temperature: 0~45 ℃ (fluoride ions can reach up to 60 ℃)<br />Storage temperature:- 10~50℃ <br />Protection level: IP68<br />Main material: 316L POM<br />Automatic cleaning: Compressed air (optional)<br />Cable length: Standard 10m, extendable<br />Power consumption: 1W max<br />Sensor size: 264mm * 55mm\n    ","gallery",[],"features",[],"specificationGroups",[210],{"_164":211,"_212":213},"Technical specifications","specifications",[214,221,225,228,232,236,239,242,246,249,253,257,261,265,269,272,276,280,284,288,292,296,300,304,308],{"_215":216,"_108":217,"_218":219,"_220":-5},"key","measurement-principle","Measurement principle","value","ion selective electrode method","unit",{"_215":222,"_108":223,"_218":224,"_220":-5},"detailed-principle","Detailed measurement principle","ion carrier membrane, non porous reference electrode",{"_215":64,"_108":226,"_218":227,"_220":-5},"Measurement parameters","ammonia nitrogen, nitrate nitrogen pH、 Potassium ions, chloride ions, fluoride ions",{"_215":229,"_108":230,"_218":231,"_220":-5},"measurement-range","Measurement range","Ammonia ion: 0.1-1000mg/L (up to 10000mg/L maximum)",{"_215":233,"_108":234,"_218":235,"_220":-5},"nitrate-range","Nitrous nitrogen","0.1-1000mg/L (up to 10000mg/L maximum)",{"_215":237,"_108":238,"_218":235,"_220":-5},"chloride-range","Chloride ion",{"_215":240,"_108":241,"_218":235,"_220":-5},"potassium-range","Potassium ion",{"_215":243,"_108":244,"_218":245,"_220":-5},"ph-range","pH","2-12pH",{"_215":247,"_108":248,"_218":235,"_220":-5},"fluoride-range","Fluoride ion",{"_215":250,"_108":251,"_218":252,"_220":-5},"accuracy","Accuracy","± 3% or ± 0.1 mg/L of the reading, whichever is greater",{"_215":254,"_108":255,"_218":256,"_220":-5},"resolution","Resolution","0.01 mg/L, 0.01 pH",{"_215":258,"_108":259,"_218":260,"_220":-5},"repeatability","Repeatability","± 1% FS",{"_215":262,"_108":263,"_218":264,"_220":-5},"response-time","Response time","T90≤30s, Fluoride ion T90 ≤ 60s",{"_215":266,"_108":267,"_218":268,"_220":-5},"potassium-compensation","Potassium ion compensation","manual or automatic",{"_215":270,"_108":271,"_218":268,"_220":-5},"ph-compensation","PH compensation",{"_215":273,"_108":274,"_218":275,"_220":-5},"temperature-compensation","Temperature compensation","automatic",{"_215":277,"_108":278,"_218":279,"_220":-5},"calibration","Calibration","single point calibration, two-point calibration",{"_215":281,"_108":282,"_218":283,"_220":-5},"operating-temperature","Operating temperature","0~45 ℃ (fluoride ions can reach up to 60 ℃)",{"_215":285,"_108":286,"_218":287,"_220":-5},"storage-temperature","Storage temperature","- 10~50℃",{"_215":289,"_108":290,"_218":291,"_220":-5},"protection","Protection level","IP68",{"_215":293,"_108":294,"_218":295,"_220":-5},"material","Main material","316L POM",{"_215":297,"_108":298,"_218":299,"_220":-5},"automatic-cleaning","Automatic cleaning","Compressed air (optional)",{"_215":301,"_108":302,"_218":303,"_220":-5},"cable","Cable length","Standard 10m, extendable",{"_215":305,"_108":306,"_218":307,"_220":-5},"power-consumption","Power consumption","1W max",{"_215":309,"_108":310,"_218":311,"_220":-5},"sensor-size","Sensor size","264mm * 55mm","sourceReviews",[],"documents",[],"supportDownloads",[]]
