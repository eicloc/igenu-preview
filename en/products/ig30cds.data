avigation",[102,118],{"_103":104,"_105":106},"title","Products","links",[107,112,115],{"_108":109,"_110":111},"label","Water analysis","href","/en/products?category=water",{"_108":113,"_110":114},"Industrial measurement","/en/products?category=industrial",{"_108":116,"_110":117},"Gas detection","/en/products?category=gas",{"_103":119,"_105":120},"Explore",[121,123,126,129,132],{"_108":79,"_110":122},"/en/about",{"_108":124,"_110":125},"Customer cases","/en/cases",{"_108":127,"_110":128},"News","/en/news",{"_108":130,"_110":131},"After-sales service","/en/service",{"_108":133,"_110":134},"Downloads","/en/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig30cds",[],[],"seo",{"_103":145,"_146":147,"_148":149,"_150":151},"IG30CDS Conductivity Sensor | IGENU SCIENCE","description","Measure conductivity in water treatment and industrial process water with a choice of cell constants. Digital communication and stored calibration settings support system integration and routine operation, while the supplied mounting arrangement and flow cell simplify installation.","imageUrl","/igenu-preview/media/08cc865f38c95a6b72364eaf.jpg","index",true,"canonical","https://eicloc.github.io/igenu-preview/en/products/ig30cds","query",{},"selected",[],"detail",{"_160":161,"_57":140,"_162":163,"_164":165,"_166":147,"_167":168,"_169":170,"_174":175,"_200":201,"_202":203,"_146":-5,"_204":205,"_206":207,"_208":209,"_210":211,"_294":295,"_296":297,"_298":299,"_143":144},"id","f33fa081-7e09-4283-a1f0-899eb8c5a37c","model","IG30CDS","name","IG30CDS Conductivity Sensor","shortDescription","featured",false,"category",{"_57":171,"_172":-5,"_164":109,"_146":-5,"_143":173},"water","brand",{"_103":109,"_146":-5,"_148":-5,"_150":151},"heroImage",{"_160":176,"_139":177,"_178":179,"_180":181,"_182":183,"_184":185,"_186":187,"_188":187,"_189":149,"_190":191,"_192":193},"97568f30-f32e-4d9a-85ac-2b57a8967181","IMAGE","originalName","2025040860050401.jpg","mimeType","image/jpeg","size",57217,"sha256","08cc865f38c95a6b72364eaf3f6b94912df92297b7cb4dbcdb9d9d327b79dd1c","width",500,"height","url","createdAt","2026-10-20T17:32:39.763Z","variants",[194,198],{"_186":195,"_188":195,"_180":196,"_189":197},320,"image/webp","/igenu-preview/media/6f7c525ac57d10f270f2e15f.webp",{"_186":187,"_188":187,"_180":196,"_189":199},"/igenu-preview/media/d8eaca92b7d0ec37a6ee861d.webp","detailLayout","STRUCTURED","availableLocales",[19,20,11],"bodyHtml","<strong><span>Product features:</span></strong><br />◆ Fast response time, reaching 95% in 15 seconds<br />◆ Digital sensor, RS-485 output, standard Modbus RTU protocol, not affected by transmission distance, better stability<br />◆ The sensor is made of Ryton material, which has a longer service life and reduces maintenance and downtime<br />◆ Quick response, accurate measurement, reliable data, and convenient operation<br />◆ Internal electrodes can measure extremely weak signals without polarization effects<br />◆ Internal integrated memory, can still remember the calibration and setting information stored even after power failure<br /><strong><span>Application areas:</span></strong><br />Surface water, municipal sewage, environmental monitoring, industrial process control, pollution sources, industrial wastewater, tap water, biopharmaceuticals, beer and beverage, petroleum and petrochemical, metallurgy<br /><strong><span>Technical parameters:</span></strong><br />Measurement range: K=0.01，0-20us/cm； K=0. 1，0-200us/cm;  K=1，0-2000us/cm;  K=10，0-20000us/cm<br />Temperature: 0-125 ℃<br />Resolution: 0.01 us/cm; 0.1us/cm;  1us/cm，0.1℃<br />Accuracy: ± 1% reading<br />Repeatability: ± 1% reading<br />Temperature compensation: automatic<br />Working environment: 0-95 ℃<br />Maximum pressure: 6.0bar<br />Maximum flow velocity: 3 meters per second<br />Calibration method: Standard solution calibration<br />Temperature compensation: automatic<br />Temperature electrode: PT1000<br />Electrode form: digital electrode<br />Response time: 15 seconds up to 95%<br />Communication interface: ModbusRS485<br />Electrode material: PEEK、Ryton<br />Threaded interface: Front and rear standard 3/4NPT<br />Protection level: IP68<br />Cable length: Standard 10m, extendable<br />Electrode size: 165mm * 25mm\n    ","gallery",[],"features",[],"specificationGroups",[212],{"_164":213,"_214":215},"Technical specifications","specifications",[216,223,227,231,235,238,242,246,250,254,258,262,266,270,274,278,282,286,290],{"_217":218,"_108":219,"_220":221,"_222":-5},"key","measurement-range","Measurement range","value","K=0.01，0-20us/cm； K=0. 1，0-200us/cm;  K=1，0-2000us/cm;  K=10，0-20000us/cm","unit",{"_217":224,"_108":225,"_220":226,"_222":-5},"temperature","Temperature","0-125 ℃",{"_217":228,"_108":229,"_220":230,"_222":-5},"resolution","Resolution","0.01 us/cm; 0.1us/cm;  1us/cm，0.1℃",{"_217":232,"_108":233,"_220":234,"_222":-5},"accuracy","Accuracy","± 1% reading",{"_217":236,"_108":237,"_220":234,"_222":-5},"repeatability","Repeatability",{"_217":239,"_108":240,"_220":241,"_222":-5},"temperature-compensation","Temperature compensation","automatic",{"_217":243,"_108":244,"_220":245,"_222":-5},"operating-temperature","Working environment","0-95 ℃",{"_217":247,"_108":248,"_220":249,"_222":-5},"maximum-pressure","Maximum pressure","6.0bar",{"_217":251,"_108":252,"_220":253,"_222":-5},"maximum-flow","Maximum flow velocity","3 meters per second",{"_217":255,"_108":256,"_220":257,"_222":-5},"calibration","Calibration method","Standard solution calibration",{"_217":259,"_108":260,"_220":261,"_222":-5},"temperature-electrode","Temperature electrode","PT1000",{"_217":263,"_108":264,"_220":265,"_222":-5},"electrode-form","Electrode form","digital electrode",{"_217":267,"_108":268,"_220":269,"_222":-5},"response-time","Response time","15 seconds up to 95%",{"_217":271,"_108":272,"_220":273,"_222":-5},"digital-communication","Communication interface","ModbusRS485",{"_217":275,"_108":276,"_220":277,"_222":-5},"electrode-material","Electrode material","PEEK、Ryton",{"_217":279,"_108":280,"_220":281,"_222":-5},"thread","Threaded interface","Front and rear standard 3/4NPT",{"_217":283,"_108":284,"_220":285,"_222":-5},"protection","Protection level","IP68",{"_217":287,"_108":288,"_220":289,"_222":-5},"cable","Cable length","Standard 10m, extendable",{"_217":291,"_108":292,"_220":293,"_222":-5},"electrode-size","Electrode size","165mm * 25mm","sourceReviews",[],"documents",[],"supportDownloads",[]]
