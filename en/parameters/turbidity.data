:213,"_204":246},"/igenu-preview/media/eeb83d74a18b9d4f5cb4ef75.webp",{"_159":172,"_57":248,"_178":249,"_180":250,"_182":251,"_184":229,"_162":252,"_188":254},"ig3000mp-x","IG3000MP-X","IG3000MP-X Multiparameter Water Analyzer","Build a water monitoring system around interchangeable digital probes for parameters such as pH, dissolved oxygen, conductivity and turbidity. Probe connections and stored calibration data support field replacement, while an automatic cleaning arrangement helps limit surface deposits.",{"_57":163,"_186":-5,"_180":109,"_146":-5,"_143":253},{"_103":109,"_146":-5,"_148":-5,"_149":150},{"_159":255,"_139":191,"_192":256,"_194":257,"_196":258,"_198":259,"_200":260,"_202":260,"_204":261,"_206":262,"_208":263},"d6d649eb-90c0-469f-9bfb-1c613153f689","2025040861670749.jpg","image/jpeg",19258,"9a9243397faa84f675ead5a8a5216895cf7e15c9b82d390083269947f0d00581",540,"/igenu-preview/media/9a9243397faa84f675ead5a8.jpg","2026-10-20T17:32:39.812Z",[264,266],{"_200":211,"_202":211,"_194":213,"_204":265},"/igenu-preview/media/32f08ba6aa513832d0c6c644.webp",{"_200":260,"_202":260,"_194":213,"_204":267},"/igenu-preview/media/61f38d89920b71a6040fa537.webp",{"_159":173,"_57":269,"_178":270,"_180":271,"_182":272,"_184":229,"_162":273,"_188":275},"ig30ht","IG30HT","IG30HT High-Range Turbidity Sensor","Infrared scattered-light sensing measures turbidity in process water, surface water and treatment applications. The digital probe combines optical compensation with a sapphire window and offers an optional cleaning brush to reduce deposits during ongoing monitoring.",{"_57":163,"_186":-5,"_180":109,"_146":-5,"_143":274},{"_103":109,"_146":-5,"_148":-5,"_149":150},{"_159":276,"_139":191,"_192":277,"_194":195,"_196":278,"_198":279,"_200":280,"_202":281,"_204":282,"_206":283,"_208":284},"95eccf83-22e5-4f4d-a03f-5509479d7661","2025040860985293.jpg",11246,"ecdac2d963d6479b136774a8172895d54061650f1cb8089d1404ff2a26710a79",190,78,"/igenu-preview/media/ecdac2d963d6479b136774a8.p