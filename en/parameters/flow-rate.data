ed open-channel weirs and flumes. A separate probe and display arrangement provides instantaneous and accumulated flow information for applications such as wastewater discharge points, irrigation and municipal water engineering.",{"_57":163,"_185":-5,"_178":113,"_146":-5,"_143":246},{"_103":113,"_146":-5,"_148":-5,"_149":150},{"_159":248,"_139":190,"_191":249,"_193":230,"_195":250,"_197":251,"_199":252,"_201":253,"_203":254,"_205":255,"_207":256},"c09dd052-6bcc-434a-9386-7136b00ba170","2025040854281913.png",544222,"96effce7a54b18259f3ac6a19a290f71d4f862b45801327c466bd60032c71808",1809,1449,"/igenu-preview/media/96effce7a54b18259f3ac6a1.png","2026-10-20T17:32:39.727Z",[257,260,263,267,271],{"_199":210,"_201":258,"_193":212,"_203":259},256,"/igenu-preview/media/f7db19bc9da969b069506228.webp",{"_199":215,"_201":261,"_193":212,"_203":262},513,"/igenu-preview/media/9e26d52402655e540b305fd0.webp",{"_199":264,"_201":265,"_193":212,"_203":266},960,769,"/igenu-preview/media/1e64887f2c4083e3b4c84b69.webp",{"_199":268,"_201":269,"_193":212,"_203":270},1280,1025,"/igenu-preview/media/a853495b9ddf518f0be39552.webp",{"_199":272,"_201":273,"_193":212,"_203":274},1600,1282,"/igenu-preview/media/f0f509b5abc23cc9078dfaf4.webp","sourceSections",[]]
