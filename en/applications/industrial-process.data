sensor maintenance.","featured",{"_57":242,"_243":-5,"_236":109,"_146":-5,"_143":244},"water","brand",{"_103":109,"_146":-5,"_148":-5,"_149":150},"heroImage",{"_159":247,"_139":171,"_172":248,"_174":249,"_176":250,"_178":251,"_180":252,"_182":253,"_184":254,"_186":255,"_188":256},"d84d4b36-8577-47f5-a6b1-91a7ae3a7c9f","2025040855746689.png","image/png",749999,"8032374cce79b2ec8e8e37dca3798c3058050655937edfc7f06654e8d4ff5b9e",1280,1706,"/igenu-preview/media/8032374cce79b2ec8e8e37dc.png","2026-10-20T17:32:39.748Z",[257,260,263,265],{"_180":191,"_182":258,"_174":193,"_184":259},427,"/igenu-preview/media/c82ee037d25142ee99b2efed.webp",{"_180":196,"_182":261,"_174":193,"_184":262},853,"/igenu-preview/media/8aafd5be554a54bb0699b6bf.webp",{"_180":200,"_182":252,"_174":193,"_184":264},"/igenu-preview/media/4a8ece2b232c4eb15009de8a.webp",{"_180":252,"_182":253,"_174":193,"_184":266},"/igenu-preview/media/288701302fcf6e887f187cad.webp",{"_159":208,"_57":268,"_234":269,"_236":270,"_238":271,"_240":150,"_162":272,"_245":274},"ig30phs","IG30PHS","IG30PHS Digital pH Electrode","Digital pH measurement combines a gel-filled electrode, double-junction reference and integrated temperature sensing. Modbus communication supports connection to compatible controllers, while calibration options and the supplied mounting bracket and flow cell support installation and routine operation.",{"_57":242,"_243":-5,"_236":109,"_146":-5,"_143":273},{"_103":109,"_146":-5,"_148":-5,"_149":150},{"_159":275,"_139":171,"_172":276,"_174":175,"_176":277,"_178":278,"_180":279,"_182":280,"_184":281,"_186":282,"_188":283},"7507b7cd-7dc3-42b2-90a4-f843106d4461","2025040859520101.png",19079,"7dfe5452c927d26232963ff85f11073f15b9d29010abcb394bea3ce0f2f502d6",358,302,"/igenu-preview/media/7dfe5452c927d26232963ff8.jpg","2026-10-20T17:32:39.754Z",[284,287],{"_180":191,"_182":285,"_174":193,"_184":286},270,"/igenu-preview/media/93a066c50a54638353b43bbf.webp",{"_180":279,"_182":280,"_174":193,"_184":288},"/igenu-prev