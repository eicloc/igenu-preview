"_143":242},"brand",{"_103":109,"_146":-5,"_148":-5,"_149":150},"heroImage",{"_159":245,"_139":171,"_172":246,"_174":175,"_176":247,"_178":248,"_180":249,"_182":250,"_184":251,"_186":252,"_188":253},"7507b7cd-7dc3-42b2-90a4-f843106d4461","2025040859520101.png",19079,"7dfe5452c927d26232963ff85f11073f15b9d29010abcb394bea3ce0f2f502d6",358,302,"/igenu-preview/media/7dfe5452c927d26232963ff8.jpg","2026-10-20T17:32:39.754Z",[254,257],{"_180":191,"_182":255,"_174":193,"_184":256},270,"/igenu-preview/media/93a066c50a54638353b43bbf.webp",{"_180":249,"_182":250,"_174":193,"_184":258},"/igenu-preview/media/b72cc265fa7500183b25c7da.webp",{"_159":208,"_57":260,"_233":261,"_235":262,"_237":263,"_239":150,"_162":264,"_243":266},"ig30rdo","IG30RDO","IG30RDO Optical Dissolved Oxygen Sensor","Fluorescence-based sensing measures dissolved oxygen without electrolyte replacement or sensor polarization. Integrated temperature compensation and digital communication support continuous water monitoring, with air and sample calibration options for use in treatment, environmental and aquaculture applications.",{"_57":163,"_241":-5,"_235":109,"_146":-5,"_143":265},{"_103":109,"_146":-5,"_148":-5,"_149":150},{"_159":267,"_139":171,"_172":268,"_174":175,"_176":269,"_178":270,"_180":271,"_182":272,"_184":273,"_186":274,"_188":275},"0ddcf618-0714-49aa-9919-74ce97332e9e","2025040860317013.png",19493,"1513162129cbcc0b7fb98e96f5e5a24329832e50befa0944e7b17725123db89a",458,293,"/igenu-preview/media/1513162129cbcc0b7fb98e96.jpg","2026-10-20T17:32:39.769Z",[276,279],{"_180":191,"_182":277,"_174":193,"_184":278},205,"/igenu-preview/media/875a6bfa76d0d60b22d59c3d.webp",{"_180":271,"_182":272,"_174":193,"_184":280},"/igenu-preview/media/676768d13901a89005e95e68.webp",{"_159":209,"_57":282,"_233":283,"_235":284,"_237":285,"_239":150,"_162":286,"_243":288},"ig30ss-sol","IG30SS/SOL","IG30SS/SOL Suspended Solids and Sludge Concentration Sensor","Infrared scattered-light sensing monitors suspended solids and sludge concentration in water and wastewater processes. The digital probe combines optical compensation with a sapphire window, while an optional cleaning brush helps manage deposits during continuous monitoring at the measurement point.",{"_57":163,"_241":-5,"_235":109,"_146":-5,"_143":287},{"_103":109,"_146":-5,"_148":-5,"_149":150},{"_159":289,"_139":171,"_172":290,"_174":175,"_176":291,"_178":292,"_180":293,"_182":294,"_184":295,"_186":296,"_188":297},"1439d80a-330c-424f-b53e-2863e4ad2437","2025040860527217.png",17952,"fbfabb8705ffee2ab2928de1e179bcbdfff9163bf9562b20f0a57da383e92447",252,303,"/igenu-preview/media/fbfabb8705ffee2ab2928de1.jpg","2026-10-20T17:32:39.774Z",[298],{"_180":293,"_182":294,"_174":193,"_184":299},"/igenu-preview/media/75deeb09829c31a530ddf618.webp",{"_159":210,"_57":301,"_233":302,"_235":303,"_237":304,"_239":150,"_162":305,"_243":307},"ig30uvno3","IG30UVNO3","IG30UVNO3 UV Nitrate Nitrogen Sensor","Ultraviolet absorption measures nitrate nitrogen directly in water without chemical reagents or a separate sampling system. Selectable optical paths, interference compensation and automatic cleaning support online deployment in drinking water, environmental monitoring and wastewater treatment applications.",{"_57":163,"_241":-5,"_235":109,"_146":-5,"_143":306},{"_103":109,"_146":-5,"_148":-5,"_149":150},{"_159":308,"_139":171,"_172":309,"_174":175,"_176":310,"_178":311,"_180":312,"_182":313,"_184":314,"_186":315,"_188":316},"79581a81-10c6-426b-80fa-28e7baf03c33","2025040861391349.png",16873,"82c04b6460e5738541de5cfefb589dc0c6890e78350a89fe4e1a3b1a0828a745",263,348,"/igenu-preview/media/82c04b6460e5738541de5cfe.jpg","2026-10-20T17:32:39.799Z",[317],{"_180":312,"_182":313,"_174":193,"_184":318},"/igenu-preview/media/5668d414b7362883ab524969.webp",{"_159":211,"_57":320,"_233":321,"_235":322,"_237":323,"_239":324,"_162":325,"_243":327},"ig3000lt","IG3000LT","IG3000LT Low-Range Turbidity Analyzer","Designed for low-level turbidity measurement in drinking water and treatment systems, this analyzer combines optical detection with a flow cell that removes bubbles. Its modular arrangement supports calibration, cleaning and servicing, with temperature displayed alongside turbidity.",false,{"_57":163,"_241":-5,"_235":109,"_146":-5,"_143":326},{"_103":109,"_146":-5,"_148":-5,"_149":150},{"_159":328,"_139":171,"_172":329,"_174":330,"_176":331,"_178":332,"_180":333,"_182":334,"_184":335,"_186":336,"_188":337},"257d01fc-7670-46be-af54-0ae68bffbc45","2025040860761681.jpg","image/png",133072,"32687b0fb7e3209190a365f6165fd1befe9616a983cc291c12aca450fcae88b2",327,551,"/igenu-preview/media/32687b0fb7e3209190a365f6.png","2026-10-20T17:32:39.781Z",[338,341],{"_180":191,"_182":339,"_174":193,"_184":340},539,"/igenu-preview/media/f37ebd4fe6509270a9cebcfb.webp",{"_180":333,"_182":334,"_174":193,"_184":342},"/igenu-preview/media/eeb83d74a18b9d4f5cb4ef75.webp",{"_159":212,"_57":344,"_233":345,"_235":346,"_237":347,"_239":324,"_162":348,"_243":350},"ig3000mp-x","IG3000MP-X","IG3000MP-X Multiparameter Water Analyzer","Build a water monitoring system around interchangeable digital probes for parameters such as pH, dissolved oxygen, conductivity and turbidity. Probe connections and stored calibration data support field replacement, while an automatic cleaning arrangement helps limit surface deposits.",{"_57":163,"_241":-5,"_235":109,"_146":-5,"_143":349},{"_103":109,"_146":-5,"_148":-5,"_149":150},{"_159":351,"_139":171,"_172":352,"_174":175,"_176":353,"_178":354,"_180":355,"_182":355,"_184":356,"_186":357,"_188":358},"d6d649eb-90c0-469f-9bfb-1c613153f689","2025040861670749.jpg",19258,"9a9243397faa84f675ead5a8a5216895cf7e15c9b82d390083269947f0d00581",540,"/igenu-preview/media/9a9243397faa84f675ead5a8.jpg","2026-10-20T17:32:39.812Z",[359,361],{"_180":191,"_182":191,"_174":193,"_184":360},"/igenu-preview/media/32f08ba6aa513832d0c6c644.webp",{"_180":355,"_182":355,"_174":193,"_184":362},"/igenu-preview/media/61f38d89920b71a6040fa537.webp",{"_