78,"/igenu-preview/media/ecdac2d963d6479b136774a8.png","2026-10-20T17:32:39.787Z",[441],{"_180":436,"_182":437,"_174":193,"_184":442},"/igenu-preview/media/c0547cb002a63d36b1ac374c.webp",{"_159":217,"_57":444,"_233":445,"_235":446,"_237":447,"_239":324,"_162":448,"_243":450},"ig30ise-x","IG30ISE-X","IG30ISE-X Ion-Selective Electrode","Ion-selective measurement supports water monitoring for configured ion parameters and pH. The immersion probe operates without a separate sampling system and provides compensation and calibration functions, making it suitable for drinking water, environmental and wastewater applications.",{"_57":163,"_241":-5,"_235":109,"_146":-5,"_143":449},{"_103":109,"_146":-5,"_148":-5,"_149":150},{"_159":451,"_139":171,"_172":452,"_174":330,"_176":453,"_178":454,"_180":191,"_182":455,"_184":456,"_186":457,"_188":458},"c6e3c765-909d-45fd-bd1c-7dbc51fecd54","2025041051038309.png",13330,"8936108072d3c61053c40f382494eb98c8734713fb66a99450bf2aedb26fb684",120,"/igenu-preview/media/8936108072d3c61053c40f38.png","2026-10-20T17:32:39.882Z",[459],{"_180":191,"_182":455,"_174":193,"_184":460},"/igenu-preview/media/f11ab30d5325a31abe0f2adb.webp",{"_159":218,"_57":462,"_233":463,"_235":464,"_237":465,"_239":324,"_162":466,"_243":468},"ig30ph01","IG30PH01","IG30PH01 Analog pH Electrode","An analog pH electrode for water and process monitoring, combining a gel-filled design with a double-junction reference arrangement. An integrated temperature sensor supports compensation, and the mounting bracket and flow cell provide options for installation at the measurement point.",{"_57":163,"_241":-5,"_235":109,"_146":-5,"_143":467},{"_103":109,"_146":-5,"_148":-5,"_149":150},{"_159":245,"_139":171,"_172":246,"_174":175,"_176":247,"_178":248,"_180":249,"_182":250,"_184":251,"_186":252,"_188":469},[470,471],{"_180":191,"_182":255,"_174":193,"_184":256},{"_180":249,"_182":250,"_174":193,"_184":258},{"_159":219,"_57":473,"_233":474,"_235":475,"_237":476,"_239":324,"_162":477,"_243":479},"ig30ptco","IG30PTCO","IG30PTCO Water Color Sensor","Optical absorption measures water color against the platinum-cobalt color scale. Automatic turbidity compensation and a cleaning brush support online monitoring, while stored calibration settings and digital communication simplify connection to water monitoring systems at the installation site.",{"_57":163,"_241":-5,"_235":109,"_146":-5,"_143":478},{"_103":109,"_146":-5,"_148":-5,"_149":150},{"_159":371,"_139":171,"_172":372,"_174":175,"_176":373,"_178":374,"_180":355,"_182":355,"_184":375,"_186":376,"_188":480},[481,482],{"_180":191,"_182":191,"_174":193,"_184":379},{"_180":355,"_182":355,"_174":193,"_184":381},{"_159":220,"_57":484,"_233":485,"_235":486,"_237":487,"_239":324,"_162":488,"_243":490},"ig30rps","IG30RPS","IG30RPS Digital ORP Electrode","A digital ORP electrode for oxidation-reduction monitoring in water and industrial processes. Its platinum sensing element and double-junction reference are complemented by digital communication, sample or standard calibration, and a mounting bracket and flow cell for installation.",{"_57":163,"_241":-5,"_235":109,"_146":-5,"_143":489},{"_103":109,"_146":-5,"_148":-5,"_149":150},{"_159":245,"_139":171,"_172":246,"_174":175,"_176":247,"_178":248,"_180":249,"_182":250,"_184":251,"_186":252,"_188":491},[492,493],{"_180":191,"_182":255,"_174":193,"_184":256},{"_180":249,"_182":250,"_174":193,"_184":258},{"_159":221,"_57":495,"_233":496,"_235":497,"_237":498,"_239":324,"_162":499,"_243":501},"ig30rps01","IG30RPS01","IG30RPS01 Analog ORP Electrode","An analog ORP electrode for water treatment and process monitoring, using a platinum sensing element and double-junction reference. Sample and standard calibration options, together with a mounting bracket and flow cell, support installation and routine measurement.",{"_57":163,"_241":-5,"_235":109,"_146":-5,"_143":500},{"_103":109,"_146":-5,"_148":-5,"_149":150},{"_159":245,"_139":171,"_172":246,"_174":175,"_176":247,"_178":248,"_180":249,"_182":250,"_184":251,"_186":252,"_188":502},[503,504],{"_180":191,"_182":255,"_174":193,"_184":256},{"_180":249,"_182":250,"_174":193,"_184":258},{"_159":222,"_57":506,"_233":507,"_235":508,"_237":509,"_239":324,"_162":510,"_243":512},"ig3254cod","IG3254COD","IG3254COD UV COD and TOC Sensor","Ultraviolet absorption supports online COD and TOC measurement without reagent dosing. Turbidity compensation, calibration options and an available automatic cleaning system help adapt the digital probe to water monitoring, with results interpreted according to the selected calibration.",{"_57":163,"_241":-5,"_235":109,"_146":-5,"_143":511},{"_103":109,"_146":-5,"_148":-5,"_149":150},{"_159":513,"_139":171,"_172":514,"_174":175,"_176":515,"_178":516,"_180":355,"_182":355,"_184":517,"_186":518,"_188":519},"79d9f104-d914-4e36-bec2-d6d2b843fefd","2025041051182309.jpg",14215,"e3e2c21db606165f614650cf931244737a0e84793f3dd9ab8bd834db8aa5b8b3","/igenu-preview/media/e3e2c21db606165f614650cf.jpg","2026-10-20T17:32:39.888Z",[520,522],{"_180":191,"_182":191,"_174":193,"_184":521},"/igenu-preview/media/087409fcbd7eefe1aec06c53.webp",{"_180":355,"_182":355,"_174":193,"_184":523},"/igenu-preview/media/6d889354b11ab94fb489a773.webp",{"_159":223,"_57":525,"_233":526,"_235":527,"_237":528,"_239":324,"_162":529,"_243":531},"ig3500","IG3500","IG3500 Residual Chlorine Analyzer","DPD colorimetry measures residual chlorine in water for supply and process monitoring. The analyzer combines optical interference compensation, automatic cleaning and data storage, with relay outputs for control integration and an optional remote communication module for connected operation.",{"_57":163,"_241":-5,"_235":109,"_146":-5,"_143":530},{"_103":109,"_146":-5,"_148":-5,"_149":150},{"_159":532,"_139":171,"_172":533,"_174":330,"_176":534,"_178":535,"_180":536,"_182":537,"_184":538,"_186":539,"_188":540},"c50c4c9d-55bb-4423-8c3e-781ffff460bb","2025040937453857.jpg",161037,"8851b0c528aa8f3f11bac4d54c4a5ffd8e6ba0b79e7a6a527d4c31805dbb2c25",439,577,"/igenu-preview/media/8851b0c528aa8f3f11bac4d5.png","2026-10-20T17:32:39.818Z",[541,544],{"_180":191,"_182":542,"_174":193,"_184":543},421,"/igenu-preview/media/a94dedbc4c305ed00e17532e.webp",{"_180":536,"_182":537,"_174":193,"_184":545},"/igenu-preview/media/addc2737c9f6397359f3a546.webp",{"_159":224,"_57":547,"_233":548,"_235":549,"_237":550,"_239":324,"_162":551,"_243":553},"ig3500an","IG3500AN","IG3500AN Ammonia Nitrogen Analyzer","Salicylate spectrophotometry measures ammonia nitrogen in water. Automatic range selection, quality-control routines and operating logs support online monitoring, with alarm functions and electrical communication interfaces for integration into drinking water, environmental and wastewater monitoring systems.",{"_57":163,"_241":-5,"_235":109,"_146":-5,"_143":552},{"_103":109,"_146":-5,"_148":-5,"_149":150},{"_159":554,"_139":171,"_172":555,"_174":330,"_176":556,"_178":557,"_180":201,"_182":558,"_184":559,"_186":560,"_188":561},"bfda7f5e-e504-4c40-85f0-1afea6d4aba3","2025040938476253.jpg",51146,"076a24550dfec7d99b95ba8827dbead49c4506dc3d55d9d8b47b0c95d2a2c36e",435,"/igenu-preview/media/076a24550dfec7d99b95ba88.png","2026-10-20T17:32:39.824Z",[562],{"_180":201,"_182":558,"_174":193,"_184":563},"/igenu-preview/media/f3d468788765b050ceafe139.webp",{"_159":225,"_57":565,"_233":566,"_235":567,"_237":568,"_239":324,"_162":569,"_243":571},"ig3500codmn","IG3500CODMN","IG3500CODmn Permanganate Index Analyzer","Permanganate oxidation and titration determine the permanganate index in water. Automatic range switching, quality-control checks and operating logs support online monitoring, while alarm functions and standard electrical interfaces help connect the analyzer to a wider monitoring system.",{"_57":163,"_241":-5,"_235":109,"_146":-5,"_143":570},{"_103":109,"_146":-5,"_148":-5,"_149":150},{"_159":554,"_139":171,"_172":555,"_174":330,"_176":556,"_178":557,"_180":201,"_182":558,"_184":559,"_186":560,"_188":572},[573],{"_180":201,"_182":558,"_174":193,"_184":563},{"_159":226,"_57":575,"_233":576,"_235":577,"_237":578,"_239":324,"_162":579,"_243":581},"ig3500tn","IG3500TN","IG3500TN Total Nitrogen Analyzer","Alkaline persulfate digestion followed by ultraviolet spectrophotometry determines total nitrogen in water. Automatic range switching, quality-control checks and measurement logs support online operation, with communication and alarm functions for integration into environmental and wastewater monitoring systems.",{"_57":163,"_241":-5,"_235":109,"_146":-5,"_143":580},{"_103":109,"_146":-5,"_148":-5,"_149":150},{"_159":554,"_139":171,"_172":555,"_174":330,"_176":556,"_178":557,"_180":201,"_182":558,"_184":559,"_186":560,"_188":582},[583],{"_180":201,"_182":558,"_174":193,"_184":563},{"_159":227,"_57":585,"_233":586,"_235":587,"_237":588,"_239":324,"_162":589,"_243":591},"ig3500tp","IG3500TP","IG3500TP Total Phosphorus Analyzer","Sample digestion and ammonium molybdate spectrophotometry determine total phosphorus in water. Automatic range switching, quality-control routines and measurement logs support online operation, with communication interfaces and alarm functions for environmental, drinking water and wastewater monitoring applications.",{"_57":163,"_241":-5,"_235":109,"_146":-5,"_143":590},{"_103":109,"_146":-5,"_148":-5,"_149":150},{"_159":554,"_139":171,"_172":555,"_174":330,"_176":556,"_178":557,"_180":201,"_182":558,"_184":559,"_186":560,"_188":592},[593],{"_180":201,"_182":558,"_174":193,"_184":563},{"_159":228,"_57":595,"_233":596,"_235":597,"_237":598,"_239":324,"_162":599,"_243":602},"ig9000","IG9000","IG9000 Ultrasonic Level Transmitter","Ultrasonic time-of-flight measurement monitors levels in liquids and bulk materials without contact with the medium. Integrated and separate arrangements, signal analysis and temperature compensation support installation in water treatment and storage tanks, with configuration options matched to the measurement point.",{"_57":600,"_241":-5,"_235":113,"_146":-5,"_143":601},"industrial",{"_103":113,"_146":-5,"_148":-5,"_149":150},{"_159":603,"_139":171,"_172":604,"_174":330,"_176":605,"_178":606,"_180":607,"_182":608,"_184":609,"_186":610,"_188":611},"485bff13-2df9-448f-a8bc-6b60b3e5ad76","2025040851503805.png",698863,"8ef050d2f42f424a5466c7f703dc0ddcbb2915dc23bdee338481847f3cefa2dd",2604,1704,"/igenu-preview/media/8ef050d2f42f424a5466c7f7.png","2026-10-20T17:32:39.690Z",[612,615,618,621,625],{"_180":191,"_182":613,"_174":193,"_184":614},209,"/igenu-preview/media/63971d02adf57bfde6335036.webp",{"_180":196,"_182":616,"_174":193,"_184":617},419,"/igenu-preview/media/94e5c9a427aaff2e7fe15add.webp",{"_180":200,"_182":619,"_174":193,"_184":620},628,"/igenu-preview/media/6403302113043098a393f716.webp",{"_180":622,"_182":623,"_174":193,"_184":624},1280,838,"/igenu-preview/media/bd1f66f7ac71cc90284d1d8d.webp",{"_180":626,"_182":627,"_174":193,"_184":628},1600,1047,"/igenu-preview/media/0f4d290e7e86d3dd29596237.webp",{"_159":229,"_57":630,"_233":631,"_235":632,"_237":633,"_239":324,"_162":634,"_243":636},"ig9600","IG9600","IG9600 Ultrasonic Sludge Interface Monitor","Ultrasonic echo timing identifies the sludge interface in settling and thickening tanks. A separate probe, integrated temperature compensation and local display support monitoring in wastewater treatment and waterworks sedimentation processes, with configuration adapted to the installation.",{"_57":600,"_241":-5,"_235":113,"_146":-5,"_143":635},{"_103":113,"_146":-5,"_148":-5,"_149":150},{"_159":637,"_139":171,"_172":638,"_174":330,"_176":639,"_178":640,"_180":641,"_182":608,"_184":642,"_186":643,"_188":644},"fe68277b-0e41-4c1a-b0a4-8bfebd654caa","2025040854938433.png",549953,"65b4e4d80f69906e1d7bb840b3735e20c7fa903b831162b2a977ae41ff5f77d9",2064,"/igenu-preview/media/65b4e4d80f69906e1d7bb840.png","2026-10-20T17:32:39.735Z",[645,648,651,654,657],{"_180":191,"_182":646,"_174":193,"_184":647},264,"/igenu-preview/