242},"brand",{"_103":109,"_146":-5,"_148":-5,"_149":150},"heroImage",{"_159":245,"_139":171,"_172":246,"_174":247,"_176":248,"_178":249,"_180":250,"_182":251,"_184":252,"_186":253,"_188":254},"d84d4b36-8577-47f5-a6b1-91a7ae3a7c9f","2025040855746689.png","image/png",749999,"8032374cce79b2ec8e8e37dca3798c3058050655937edfc7f06654e8d4ff5b9e",1280,1706,"/igenu-preview/media/8032374cce79b2ec8e8e37dc.png","2026-10-20T17:32:39.748Z",[255,258,261,263],{"_180":191,"_182":256,"_174":193,"_184":257},427,"/igenu-preview/media/c82ee037d25142ee99b2efed.webp",{"_180":196,"_182":259,"_174":193,"_184":260},853,"/igenu-preview/media/8aafd5be554a54bb0699b6bf.webp",{"_180":200,"_182":250,"_174":193,"_184":262},"/igenu-preview/media/4a8ece2b232c4eb15009de8a.webp",{"_180":250,"_182":251,"_174":193,"_184":264},"/igenu-preview/media/288701302fcf6e887f187cad.webp",{"_159":208,"_57":266,"_233":267,"_235":268,"_237":269,"_239":150,"_162":270,"_243":272},"ig30phs","IG30PHS","IG30PHS Digital pH Electrode","Digital pH measurement combines a gel-filled electrode, double-junction reference and integrated temperature sensing. Modbus communication supports connection to compatible controllers, while calibration options and the supplied mounting bracket and flow cell support installation and routine operation.",{"_57":163,"_241":-5,"_235":109,"_146":-5,"_143":271},{"_103":109,"_146":-5,"_148":-5,"_149":150},{"_159":273,"_139":171,"_172":274,"_174":175,"_176":275,"_178":276,"_180":277,"_182":278,"_184":279,"_186":280,"_188":281},"7507b7cd-7dc3-42b2-90a4-f843106d4461","2025040859520101.png",19079,"7dfe5452c927d26232963ff85f11073f15b9d29010abcb394bea3ce0f2f502d6",358,302,"/igenu-preview/media/7dfe5452c927d26232963ff8.jpg","2026-10-20T17:32:39.754Z",[282,285],{"_180":191,"_182":283,"_174":193,"_184":284},270,"/igenu-preview/media/93a066c50a54638353b43bbf.webp",{"_180":277,"_182":278,"_174":193,"_184":286},"/igenu-preview/media/b72cc265fa7500183b25c7da.webp",{"_159":209,"_57":288,"_233":289,"_235":290,"_237":291,"_239":150,"_162":292,"_243":294},"ig30rdo","IG30RDO","IG30RDO Optical Dissolved Oxygen Sensor","Fluorescence-based sensing measures dissolved oxygen without electrolyte replacement or sensor polarization. Integrated temperature compensation and digital communication support continuous water monitoring, with air and sample calibration options for use in treatment, environmental and aquaculture applications.",{"_57":163,"_241":-5,"_235":109,"_146":-5,"_143":293},{"_103":109,"_146":-5,"_148":-5,"_149":150},{"_159":295,"_139":171,"_172":296,"_174":175,"_176":297,"_178":298,"_180":299,"_182":300,"_184":301,"_186":302,"_188":303},"0ddcf618-0714-49aa-9919-74ce97332e9e","2025040860317013.png",19493,"1513162129cbcc0b7fb98e96f5e5a24329832e50befa0944e7b17725123db89a",458,293,"/igenu-preview/media/1513162129cbcc0b7fb98e96.jpg","2026-10-20T17:32:39.769Z",[304,307],{"_180":191,"_182":305,"_174":193,"_184":306},205,"/igenu-preview/media/875a6bfa76d0d60b22d59c3d.webp",{"_180":299,"_182":300,"_174":193,"_184":308},"/igenu-preview/media/676768d13901a89005e95e68.webp",{"_159":210,"_57":310,"_233":311,"_235":312,"_237":313,"_239":150,"_162":314,"_243":316},"ig30ss-sol","IG30SS/SOL","IG30SS/SOL Suspended Solids and Sludge Concentration Sensor","Infrared scattered-light sensing monitors suspended solids and sludge concentration in water and wastewater processes. The digital probe combines optical compensation with a sapphire window, while an optional cleaning brush helps manage deposits during continuous monitoring at the measurement point.",{"_57":163,"_241":-5,"_235":109,"_146":-5,"_143":315},{"_103":109,"_146":-5,"_148":-5,"_149":150},{"_159":317,"_139":171,"_172":318,"_174":175,"_176":319,"_178":320,"_180":321,"_182":322,"_184":323,"_186":324,"_188":325},"1439d80a-330c-424f-b53e-2863e4ad2437","2025040860527217.png",17952,"fbfabb8705ffee2ab2928de1e179bcbdfff9163bf9562b20f0a57da383e92447",252,303,"/igenu-preview/media/fbfabb8705ffee2ab2928de1.jpg","2026-10-20T17:32:39.774Z",[326],{"_180":321,"_182":322,"_174":193,"_184":327},"/igenu-preview/media/75deeb09829c31a530ddf618.webp",{"_159":211,"_57":329,"_233":330,"_235":331,"_237":332,"_239":150,"_162":333,"_243":335},"ig30uvno3","IG30UVNO3","IG30UVNO3 UV Nitrate Nitrogen Sensor","Ultraviolet absorption measures nitrate nitrogen directly in water without chemical reagents or a separate sampling system. Selectable optical paths, interference compensation and automatic cleaning support online deployment in drinking water, environmental monitoring and wastewater treatment applications.",{"_57":163,"_241":-5,"_235":109,"_146":-5,"_143":334},{"_103":109,"_146":-5,"_148":-5,"_149":150},{"_159":336,"_139":171,"_172":337,"_174":175,"_176":338,"_178":339,"_180":340,"_182":341,"_184":342,"_186":343,"_188":344},"79581a81-10c6-426b-80fa-28e7baf03c33","2025040861391349.png",16873,"82c04b6460e5738541de5cfefb589dc0c6890e78350a89fe4e1a3b1a0828a745",263,348,"/igenu-preview/media/82c04b6460e5738541de5cfe.jpg","2026-10-20T17:32:39.799Z",[345],{"_180":340,"_182":341,"_174":193,"_184":346},"/igenu-preview/media/5668d414b7362883ab524969.webp",{"_159":212,"_57":348,"_233":349,"_235":350,"_237":351,"_239":352,"_162":353,"_243":355},"ig3000mp-x","IG3000MP-X","IG3000MP-X Multiparameter Water Analyzer","Build a water monitoring system around interchangeable digital probes for parameters such as pH, dissolved oxygen, conductivity and turbidity. Probe connections and stored calibration data support field replacement, while an automatic cleaning arrangement helps limit surface deposits.",false,{"_57":163,"_241":-5,"_235":109,"_146":-5,"_143":354},{"_103":109,"_146":-5,"_148":-5,"_149":150},{"_159":356,"_139":171,"_172":357,"_174":175,"_176":358,"_178":359,"_180":360,"_182":360,"_184":361,"_186":362,"_188":363},"d6d649eb-90c0-469f-9bfb-1c613153f689","2025040861670749.jpg",19258,"9a9243397faa84f675ead5a8a5216895cf7e15c9b82d390083269947f0d00581",540,"/igenu-preview/media/9a9243397faa84f675ead5a8.jpg","2026-10-20T17:32:39.812Z",[364,366],{"_180":191,"_182":191,"_174":193,"_184":365},"/igenu-preview/media/32f08ba6aa513832d0c6c644.webp",{"_180":360,"_182":360,"_174":193,"_184":367},"/igenu-preview/media/61f38d89920b71a6040fa537.webp",{"_159":213,"_57":369,"_233":370,"_235":371,"_237":372,"_239":352,"_162":373,"_243":375},"ig30cds","IG30CDS","IG30CDS Conductivity Sensor","Measure conductivity in water treatment and industrial process water with a choice of cell constants. Digital communication and stored calibration settings support system integration and routine operation, while the supplied mounting arrangement and flow cell simplify installation.",{"_57":163,"_241":-5,"_235":109,"_146":-5,"_143":374},{"_103":109,"_146":-5,"_148":-5,"_149":150},{"_159":376,"_139":171,"_172":377,"_174":175,"_176":378,"_178":379,"_180":380,"_182":380,"_184":381,"_186":382,"_188":383},"97568f30-f32e-4d9a-85ac-2b57a8967181","2025040860050401.jpg",57217,"08cc865f38c95a6b72364eaf3f6b94912df92297b7cb4dbcdb9d9d327b79dd1c",500,"/igenu-preview/media/08cc865f38c95a6b72364eaf.jpg","2026-10-20T17:32:39.763Z",[384,386],{"_180":191,"_182":191,"_174":193,"_184":385},"/igenu-preview/media/6f7c525ac57d10f270f2e15f.webp",{"_180":380,"_182":380,"_174":193,"_184":387},"/igenu-preview/media/d8eaca92b7d0ec37a6ee861d.webp",{"_159":214,"_57":389,"_233":390,"_235":391,"_237":392,"_239":352,"_162":393,"_243":395},"ig30cls","IG30CLS","IG30CLS Residual Chlorine Sensor","Using a constant-potential electrochemical method, this sensor measures residual chlorine and chlorine dioxide in water. A dedicated flow cell maintains sample flow, while the design avoids colorimetric reagents and routine replacement of membranes or electrolyte.",{"_57":163,"_241":-5,"_235":109,"_146":-5,"_143":394},{"_103":109,"_146":-5,"_148":-5,"_149":150},{"_159":396,"_139":171,"_172":397,"_174":175,"_176":398,"_178":399,"_180":400,"_182":401,"_184":402,"_186":403,"_188":404},"ce0b8383-b6df-4c9a-aabb-3a55435db7a7","2025040861142109.png",22021,"128cbf77e27c44f50