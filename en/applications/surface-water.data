,"_176":439,"_178":440,"_180":441,"_182":442,"_184":443,"_186":444,"_188":445},"95eccf83-22e5-4f4d-a03f-5509479d7661","2025040860985293.jpg",11246,"ecdac2d963d6479b136774a8172895d54061650f1cb8089d1404ff2a26710a79",190,78,"/igenu-preview/media/ecdac2d963d6479b136774a8.png","2026-10-20T17:32:39.787Z",[446],{"_180":441,"_182":442,"_174":193,"_184":447},"/igenu-preview/media/c0547cb002a63d36b1ac374c.webp",{"_159":217,"_57":449,"_233":450,"_235":451,"_237":452,"_239":352,"_162":453,"_243":455},"ig30ise-x","IG30ISE-X","IG30ISE-X Ion-Selective Electrode","Ion-selective measurement supports water monitoring for configured ion parameters and pH. The immersion probe operates without a separate sampling system and provides compensation and calibration functions, making it suitable for drinking water, environmental and wastewater applications.",{"_57":163,"_241":-5,"_235":109,"_146":-5,"_143":454},{"_103":109,"_146":-5,"_148":-5,"_149":150},{"_159":456,"_139":171,"_172":457,"_174":247,"_176":458,"_178":459,"_180":191,"_182":460,"_184":461,"_186":462,"_188":463},"c6e3c765-909d-45fd-bd1c-7dbc51fecd54","2025041051038309.png",13330,"8936108072d3c61053c40f382494eb98c8734713fb66a99450bf2aedb26fb684",120,"/igenu-preview/media/8936108072d3c61053c40f38.png","2026-10-20T17:32:39.882Z",[464],{"_180":191,"_182":460,"_174":193,"_184":465},"/igenu-preview/media/f11ab30d5325a31abe0f2adb.webp",{"_159":218,"_57":467,"_233":468,"_235":469,"_237":470,"_239":352,"_162":471,"_243":473},"ig30ph01","IG30PH01","IG30PH01 Analog pH Electrode","An analog pH electrode for water and process monitoring, combining a gel-filled design with a double-junction reference arrangement. An integrated temperature sensor supports compensation, and the mounting bracket and flow cell provide options for installation at the measurement point.",{"_57":163,"_241":-5,"_235":109,"_146":-5,"_143":472},{"_103":109,"_146":-5,"_148":-5,"_149":150},{"_159":273,"_139":171,"_172":274,"_174":175,"_176":275,"_178":276,"_180":277,"_18