racket and flow cell, support installation and routine measurement.",{"_57":163,"_241":-5,"_235":109,"_146":-5,"_143":505},{"_103":109,"_146":-5,"_148":-5,"_149":150},{"_159":273,"_139":171,"_172":274,"_174":175,"_176":275,"_178":276,"_180":277,"_182":278,"_184":279,"_186":280,"_188":507},[508,509],{"_180":191,"_182":283,"_174":193,"_184":284},{"_180":277,"_182":278,"_174":193,"_184":286},{"_159":222,"_57":511,"_233":512,"_235":513,"_237":514,"_239":352,"_162":515,"_243":517},"ig30tpy","IG30TPY","IG30TPY Water Transparency Sensor","Transmitted-light measurement provides water transparency and temperature readings without chemical reagents. A compact digital probe with an automatic cleaning brush supports online monitoring in surface waters, river channels and aquaculture, helping limit deposits on the optical surface.",{"_57":163,"_241":-5,"_235":109,"_146":-5,"_143":516},{"_103":109,"_146":-5,"_148":-5,"_149":150},{"_159":418,"_139":171,"_172":419,"_174":175,"_176":420,"_178":421,"_180":360,"_182":360,"_184":422,"_186":423,"_188":518},[519,520],{"_180":191,"_182":191,"_174":193,"_184":426},{"_180":360,"_182":360,"_174":193,"_184":428},{"_159":223,"_57":522,"_233":523,"_235":524,"_237":525,"_239":352,"_162":526,"_243":528},"ig3254cod","IG3254COD","IG3254COD UV COD and TOC Sensor","Ultraviolet absorption supports online COD and TOC measurement without reagent dosing. Turbidity compensation, calibration options and an available automatic cleaning system help adapt the digital probe to water monitoring, with results interpreted according to the selected calibration.",{"_57":163,"_241":-5,"_235":109,"_146":-5,"_143":527},{"_103":109,"_146":-5,"_148":-5,"_149":150},{"_159":529,"_139":171,"_172":530,"_174":175,"_176":531,"_178":532,"_180":360,"_182":360,"_184":533,"_186":534,"_188":535},"79d9f104-d914-4e36-bec2-d6d2b843fefd","2025041051182309.jpg",14215,"e3e2c21db606165f614650cf931244737a0e84793f3dd9ab8bd834db8aa5b8b3","/igenu-preview/media/e3e2c21db606165f614650cf.jpg","2026-10-20T17:32:39.888Z",[536,538],{"_180":191,"_182":191,"_174":193,"_184":537},"/igenu-preview/media/087409fcbd7eefe1aec06c53.webp",{"_180":360,"_182":360,"_174":193,"_184":539},"/igenu-preview/media/6d889354b11ab94fb489a773.webp",{"_159":224,"_57":541,"_233":542,"_235":543,"_237":544,"_239":352,"_162":545,"_243":547},"ig3500","IG3500","IG3500 Residual Chlorine Analyzer","DPD colorimetry measures residual chlorine in water for supply and process monitoring. The analyzer combines optical interference compensation, automatic cleaning and data storage, with relay outputs for control integration and an optional remote communication module for connected operation.",{"_57":163,"_241":-5,"_235":109,"_146":-5,"_143":546},{"_103":109,"_146":-5,"_148":-5,"_149":150},{"_159":548,"_139":171,"_172":549,"_174":247,"_176":550,"_178":551,"_180":552,"_182":553,"_184":554,"_186":555,"_188":556},"c50c4c9d-55bb-4423-8c3e-781ffff460bb","2025040937453857.jpg",161037,"8851b0c528aa8f3f11bac4d54c4a5ffd8e6ba0b79e7a6a527d4c31805dbb2c25",439,577,"/igenu-preview/media/8851b0c528aa8f3f11bac4d5.png","2026-10-20T17:32:39.818Z",[557,560],{"_180":191,"_182":558,"_174":193,"_184":559},421,"/igenu-preview/media/a94dedbc4c305ed00e17532e.webp",{"_180":552,"_182":553,"_174":193,"_184":561},"/igenu-preview/media/addc2737c9f6397359f3a546.webp",{"_159":225,"_57":563,"_233":564,"_235":565,"_237":566,"_239":352,"_162":567,"_243":569},"ig3500an","IG3500AN","IG3500AN Ammonia Nitrogen Analyzer","Salicylate spectrophotometry measures ammonia nitrogen in water. Automatic range selection, quality-control routines and operating logs support online monitoring, with alarm functions and electrical communication interfaces for integration into drinking water, environmental and wastewater monitoring systems.",{"_57":163,"_241":-5,"_235":109,"_146":-5,"_143":568},{"_103":109,"_146":-5,"_148":-5,"_149":150},{"_159":570,"_139":171,"_172":571,"_174":247,"_176":572,"_178":573,"_180":201,"_182":574,"_184":575,"_186":576,"_188":577},"bfda7f5e-e504-4c40-85f0-1afea6d4aba3","2025040938476253.jpg",51146,"076a24550dfec7d99b95ba8827dbead49c4506dc3d55d9d8b47b0c95d2a2c36e",435,"/igenu-preview/media/076a24550dfec7d99b95ba88.png","2026-10-20T17:32:39.824Z",[578],{"_180":201,"_182":574,"_174":193,"_184":579},"/igenu-preview/media/f3d468788765b050ceafe139.webp",{"_159":226,"_57":581,"_233":582,"_235":583,"_237":584,"_239":352,"_162":585,"_243":587},"ig3500codmn","IG3500CODMN","IG3500CODmn Permanganate Index Analyzer","Permanganate oxidation and titration determine the permanganate index in water. Automatic range switching, quality-control checks and operating logs support online monitoring, while alarm functions and standard electrical interfaces help connect the analyzer to a wider monitoring system.",{"_57":163,"_241":-5,"_235":109,"_146":-5,"_143":586},{"_103":109,"_146":-5,"_148":-5,"_149":150},{"_159":570,"_139":171,"_172":571,"_174":247,"_176":572,"_178":573,"_180":201,"_182":574,"_184":575,"_186":576,"_188":588},[589],{"_180":201,"_182":574,"_174":193,"_184":579},{"_159":227,"_57":591,"_233":592,"_235":593,"_237":594,"_239":352,"_162":595,"_243":597},"ig3500tn","IG3500TN","IG3500TN Total Nitrogen Analyzer","Alkaline persulfate digestion followed by ultraviolet spectrophotometry determines total nitrogen in water. Automatic range switching, quality-control checks and measurement logs support online operation, with communication and alarm functions for integration into environmental and wastewater monitoring systems.",{"_57":163,"_241":-5,"_235":109,"_146":-5,"_143":596},{"_103":109,"_146":-5,"_148":-5,"_149":150},{"_159":570,"_139":171,"_172":571,"_174":247,"_176":572,"_178":573,"_180":201,"_182":574,"_184":575,"_186":576,"_188":598},[599],{"_180":201,"_182":574,"_174":193,"_184":579},{"_159":228,"_57":601,"_233":602,"_235":603,"_237":604,"_239":352,"_162":605,"_243":607},"ig3500tp","IG3500TP","IG3500TP Total Phosphorus Analyzer","Sample digestion and ammonium molybdate spectrophotometry determine total phosphorus in water. Automatic range switching, quality-control routines and measurement logs support online operation, with communication interfaces and alarm functions for environmental, drinking water and wastewater monitoring applications.",{"_57":163,"_241":-5,"_235":109,"_146":-5,"_143":606},{"_103":109,"_146":-5,"_148":-5,"_149":150},{"_159":570,"_139":171,"_172":571,"_174":247,"_176":572,"_178":573,"_180":201,"_182":574,"_184":575,"_186":576,"_188":608},[609],{"_180":201,"_182":574,"_174":193,"_184":579},{"_159":229,"_57":611,"_233":612,"_235":613,"_237":614,"_239":352,"_162":615,"_243":618},"ig9000","IG9000","IG9000 Ultrasonic Level Transmitter","Ultrasonic time-of-flight measurement monitors levels in liquids and bulk materials without contact with the medium. Integrated and separate arrangements, signal analysis and temperature compensation support installation in water treatment and storage tanks, with configuration options matched to the measurement point.",{"_57":616,"_241":-5,"_235":113,"_146":-5,"_143":617},"industrial",{"_103":113,"_146":-5,"_148":-5,"_149":150},{"_159":619,"_139":171,"_172":620,"_174":247,"_176":621,"_178":622,"_180":623,"_182":624,"_184":625,"_186":626,"_188":627},"485bff13-2df9-448f-a8bc-6b60b3e5ad76","2025040851503805.png",698863,"8ef050d2f42f424a5466c7f703dc0ddcbb2915dc23bdee338481847f3cefa2dd",2604,1704,"/igenu-preview/media/8ef050d2f42f424a5466c7f7.png","2026-10-20T17:32:39.690Z",[628,631,634,637,640],{"_180":191,"_182":629,"_174":193,"_184":630},209,"/igenu-preview/media/63971d02adf57bfde6335036.webp",{"_180":196,"_182":632,"_174":193,"_184":633},419,"/igenu-preview/media/94e5c9a427aaff2e7fe15add.webp",{"_180":200,"_182":635,"_174":193,"_184":636},628,"/igenu-preview/media/6403302113043098a393f716.webp",{"_180":250,"_182":638,"_174":193,"_184":639},838,"/igenu-preview/media/bd1f66f7ac71cc90284d1d8d.webp",{"_180":641,"_182":642,"_174":193,"_184":643},1600,1047,"/igenu-preview/media/0f4d290e7e86d3dd29596237.webp","sourceSections",[646],{"_159":647,"_648":649,"_7":650,"_658":-5,"_659":660},"203d0429-9fcc-49bd-b703-50548b7a5620","type","TEXT_IMAGE",{"_651":38,"_652":164,"_166":653,"_654":655,"_656":657},"body","heading","<p>Whether in the form of monitoring stations or mobile laboratories (fixed or mobile stations), IGENU plays a role in the protection of surface water, spring water, rivers and groundwater. The aim is to obtain real-time measures of surface water pollution, in order to, if necessary, protect drinking water at its source.</p>","sourceNotes",[],"imagePosition","right","media","mediaItems",[]]
