ns such as wastewater discharge points, irrigation and municipal water engineering.",{"_57":383,"_247":-5,"_241":113,"_146":-5,"_143":773},{"_103":113,"_146":-5,"_148":-5,"_149":150},{"_159":775,"_139":171,"_172":776,"_174":253,"_176":777,"_178":778,"_180":779,"_182":780,"_184":781,"_186":782,"_188":783},"c09dd052-6bcc-434a-9386-7136b00ba170","2025040854281913.png",544222,"96effce7a54b18259f3ac6a19a290f71d4f862b45801327c466bd60032c71808",1809,1449,"/igenu-preview/media/96effce7a54b18259f3ac6a1.png","2026-10-20T17:32:39.727Z",[784,787,790,793,796],{"_180":191,"_182":785,"_174":193,"_184":786},256,"/igenu-preview/media/f7db19bc9da969b069506228.webp",{"_180":196,"_182":788,"_174":193,"_184":789},513,"/igenu-preview/media/9e26d52402655e540b305fd0.webp",{"_180":200,"_182":791,"_174":193,"_184":792},769,"/igenu-preview/media/1e64887f2c4083e3b4c84b69.webp",{"_180":256,"_182":794,"_174":193,"_184":795},1025,"/igenu-preview/media/a853495b9ddf518f0be39552.webp",{"_180":764,"_182":797,"_174":193,"_184":798},1282,"/igenu-preview/media/f0f509b5abc23cc9078dfaf4.webp",{"_159":235,"_57":800,"_239":801,"_241":802,"_243":803,"_245":381,"_162":804,"_249":806},"ig9600","IG9600","IG9600 Ultrasonic Sludge Interface Monitor","Ultrasonic echo timing identifies the sludge interface in settling and thickening tanks. A separate probe, integrated temperature compensation and local display support monitoring in wastewater treatment and waterworks sedimentation processes, with configuration adapted to the installation.",{"_57":383,"_247":-5,"_241":113,"_146":-5,"_143":805},{"_103":113,"_146":-5,"_148":-5,"_149":150},{"_159":807,"_139":171,"_172":808,"_174":253,"_176":809,"_178":810,"_180":811,"_182":747,"_184":812,"_186":813,"_188":814},"fe68277b-0e41-4c1a-b0a4-8bfebd654caa","2025040854938433.png",549953,"65b4e4d80f69906e1d7bb840b3735e20c7fa903b831162b2a977ae41ff5f77d9",2064,"/igenu-preview/media/65b4e4d80f69906e1d7bb840.png","2026-10-20T17:32:39.735Z",[815,818,821,824,827],{"_180":191,"_182":81