"_146":-5,"_143":363},{"_103":109,"_146":-5,"_148":-5,"_149":150},{"_159":365,"_139":171,"_172":366,"_174":175,"_176":367,"_178":368,"_180":369,"_182":370,"_184":371,"_186":372,"_188":373},"79581a81-10c6-426b-80fa-28e7baf03c33","2025040861391349.png",16873,"82c04b6460e5738541de5cfefb589dc0c6890e78350a89fe4e1a3b1a0828a745",263,348,"/igenu-preview/media/82c04b6460e5738541de5cfe.jpg","2026-10-20T17:32:39.799Z",[374],{"_180":369,"_182":370,"_174":193,"_184":375},"/igenu-preview/media/5668d414b7362883ab524969.webp",{"_159":213,"_57":377,"_239":378,"_241":379,"_243":380,"_245":381,"_162":382,"_249":385},"ig1000","IG1000","IG1000 Electromagnetic Flowmeter","Electromagnetic flow sensing measures conductive liquids, including water and process slurries. Inline installation and electrical outputs support integration into process monitoring, with material and connection options selected to suit the application and the measured medium.",false,{"_57":383,"_247":-5,"_241":113,"_146":-5,"_143":384},"industrial",{"_103":113,"_146":-5,"_148":-5,"_149":150},{"_159":386,"_139":171,"_172":387,"_174":175,"_176":388,"_178":389,"_180":390,"_182":391,"_184":392,"_186":393,"_188":394},"ae088e5b-dee3-4d64-a813-8aea3d5faa40","2018040280914617.jpg",79233,"2a75c1e35c4f5d26d0d45a78e4afd1e32e7fc5846f14595ed04ad41691e1ba5a",775,522,"/igenu-preview/media/2a75c1e35c4f5d26d0d45a78.jpg","2026-10-20T17:32:39.599Z",[395,398,401],{"_180":191,"_182":396,"_174":193,"_184":397},216,"/igenu-preview/media/b9d84e037e2e93e539dbc230.webp",{"_180":196,"_182":399,"_174":193,"_184":400},431,"/igenu-preview/media/34a2de4913f859e3b5fd7093.webp",{"_180":390,"_182":391,"_174":193,"_184":402},"/igenu-preview/media/f7cba31a9a75d0b97c8bfde5.webp",{"_159":214,"_57":404,"_239":405,"_241":406,"_243":407,"_245":381,"_162":408,"_249":410},"ig3000lt","IG3000LT","IG3000LT Low-Range Turbidity Analyzer","Designed for low-level turbidity measurement in drinking water and treatment systems, this analyzer combines optical detection with a flow cell that removes bubbles. Its modular arrangement supports calibration, cleaning and servicing, with temperature displayed alongside turbidity.",{"_57":163,"_247":-5,"_241":109,"_146":-5,"_143":409},{"_103":109,"_146":-5,"_148":-5,"_149":150},{"_159":411,"_139":171,"_172":412,"_174":253,"_176":413,"_178":414,"_180":415,"_182":416,"_184":417,"_186":418,"_188":419},"257d01fc-7670-46be-af54-0ae68bffbc45","2025040860761681.jpg",133072,"32687b0fb7e3209190a365f6165fd1befe9616a983cc291c12aca450fcae88b2",327,551,"/igenu-preview/media/32687b0fb7e3209190a365f6.png","2026-10-20T17:32:39.781Z",[420,423],{"_180":191,"_182":421,"_174":193,"_184":422},539,"/igenu-preview/media/f37ebd4fe6509270a9cebcfb.webp",{"_180":415,"_182":416,"_174":193,"_184":424},"/igenu-preview/media/eeb83d74a18b9d4f5cb4ef75.webp",{"_159":215,"_57":426,"_239":427,"_241":428,"_243":429,"_245":381,"_162":430,"_249":432},"ig3000mp-x","IG3000MP-X","IG3000MP-X Multiparameter Water Analyzer","Build a water monitoring system around interchangeable digital probes for parameters such as pH, dissolved oxygen, conductivity and turbidity. Probe connections and stored calibration data support field replacement, while an automatic cleaning arrangement helps limit surface deposits.",{"_57":163,"_247":-5,"_241":109,"_146":-5,"_143":431},{"_103":109,"_146":-5,"_148":-5,"_149":150},{"_159":433,"_139":171,"_172":434,"_174":175,"_176":435,"_178":436,"_180":437,"_182":437,"_184":438,"_186":439,"_188":440},"d6d649eb-90c0-469f-9bfb-1c613153f689","2025040861670749.jpg",19258,"9a9243397faa84f675ead5a8a5216895cf7e15c9b82d390083269947f0d00581",540,"/igenu-preview/media/9a9243397faa84f675ead5a8.jpg","2026-10-20T17:32:39.812Z",[441,443],{"_180":191,"_182":191,"_174":193,"_184":442},"/igenu-preview/media/32f08ba6aa513832d0c6c644.webp",{"_180":437,"_182":437,"_174":193,"_184":444},"/igenu-preview/media/61f38d89920b71a6040fa537.webp",{"_159":216,"_57":446,"_239":447,"_241":448,"_243":449,"_245":381,"_162":450,"_249":452},"ig30cds","IG30CDS","IG30CDS Conductivity Sensor","Measure conductivity in water treatment and industrial process water with a choice of cell constants. Digital communication and stored calibration settings support system integration and routine operation, while the supplied mounting arrangement and flow cell simplify installation.",{"_57":163,"_247":-5,"_241":109,"_146":-5,"_143":451},{"_103":109,"_146":-5,"_148":-5,"_149":150},{"_159":453,"_139":171,"_172":454,"_174":175,"_176":455,"_178":456,"_180":457,"_182":457,"_184":458,"_186":459,"_188":460},"97568f30-f32e-4d9a-85ac-2b57a8967181","2025040860050401.jpg",57217,"08cc865f38c95a6b72364eaf3f6b94912df92297b7cb4dbcdb9d9d327b79dd1c",500,"/igenu-preview/media/08cc865f38c95a6b72364eaf.jpg","2026-10-20T17:32:39.763Z",[461,463],{"_180":191,"_182":191,"_174":193,"_184":462},"/igenu-preview/media/6f7c525ac57d10f270f2e15f.webp",{"_180":457,"_182":457,"_174":193,"_184":464},"/igenu-preview/media/d8eaca92b7d0ec37a6ee861d.webp",{"_159":217,"_57":466,"_239":467,"_241":468,"_243":469,"_245":381,"_162":470,"_249":472},"ig30cls","IG30CLS","IG30CLS Residual Chlorine Sensor","Using a constant-potential electrochemical method, this sensor measures residual chlorine and chlorine dioxide in water. A dedicated flow cell maintains sample flow, while the design avoids colorimetric reagents and routine replacement of membranes or electrolyte.",{"_57":163,"_247":-5,"_241":109,"_146":-5,"_143":471},{"_103":109,"_146":-5,"_148":-5,"_149":150},{"_159":473,"_139":171,"_172":474,"_174":175,"_176":475,"_178":476,"_180":477,"_182":478,"_184":479,"_186":480,"_188":481},"ce0b8383-b6df-4c9a-aabb-3a55435db7a7","2025040861142109.png",22021,"128cbf77e27c44f50a679ba8b27ec860b8243697fccdc4f64b056e6497df3a79",344,423,"/igenu-preview/media/128cbf77e27c44f50a679ba8.jpg","2026-10-20T17:32:39.792Z",[482,485],{"_180":191,"_182":483,"_174":193,"_184":484},393,"/igenu-preview/media/e07f5ef0e1a47e02ed6259ae.webp",{"_180":477,"_182":478,"_174":193,"_184":486},"/igenu-pr