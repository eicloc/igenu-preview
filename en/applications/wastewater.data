3":694,"_245":381,"_162":695,"_249":697},"ig8100mp","IG8100MP","IG8100MP Portable Gas Detector and Alarm","A portable gas detector with pumped sampling and sensor options selected for the target gases. A color display presents measurement information, while audible, visual and vibration alarms support on-site awareness during mobile gas monitoring and inspection work.",{"_57":340,"_247":-5,"_241":116,"_146":-5,"_143":696},{"_103":116,"_146":-5,"_148":-5,"_149":150},{"_159":698,"_139":171,"_172":699,"_174":253,"_176":700,"_178":701,"_180":702,"_182":703,"_184":704,"_186":705,"_188":706},"2c4a4ac6-d50b-4737-b7e4-ebc32635cd6c","2025040852237053.png",280168,"08e61223b82894782eed918587b2b8ae3b4fa6fbbb2b5228bbfebeca395a748a",691,699,"/igenu-preview/media/08e61223b82894782eed9185.png","2026-10-20T17:32:39.713Z",[707,710,713],{"_180":191,"_182":708,"_174":193,"_184":709},324,"/igenu-preview/media/5f86a27572b4892ac922fa01.webp",{"_180":196,"_182":711,"_174":193,"_184":712},647,"/igenu-preview/media/56eed4aed7ff6130c91bdc9f.webp",{"_180":702,"_182":703,"_174":193,"_184":714},"/igenu-preview/media/50e8b14977630a4f3e555596.webp",{"_159":232,"_57":716,"_239":717,"_241":718,"_243":719,"_245":381,"_162":720,"_249":722},"ig8300voc","IG8300VOC","IG8300VOC Online Odor and Gas Monitoring System","Monitor configured odor-related gases through a multisensor system with sample pretreatment, temperature compensation and automatic calibration functions. An integrated display, data storage and communication options support connected environmental monitoring at wastewater treatment, chemical production and waste-handling sites.",{"_57":340,"_247":-5,"_241":116,"_146":-5,"_143":721},{"_103":116,"_146":-5,"_148":-5,"_149":150},{"_159":723,"_139":171,"_172":724,"_174":175,"_176":725,"_178":726,"_180":727,"_182":728,"_184":729,"_186":730,"_188":731},"248b037a-97ca-43b1-abac-a26d2deaf089","2025040852682581.png",22439,"97c97b1129c8237eb4b7d324799035ec948f856036b41f67613d22e0171553b0",194,421,"/ige