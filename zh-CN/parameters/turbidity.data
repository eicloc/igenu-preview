aa84f675ead5a8.jpg","2026-10-20T17:32:39.812Z",[265,267],{"_201":212,"_203":212,"_195":214,"_205":266},"/igenu-preview/media/32f08ba6aa513832d0c6c644.webp",{"_201":261,"_203":261,"_195":214,"_205":268},"/igenu-preview/media/61f38d89920b71a6040fa537.webp",{"_160":174,"_57":270,"_179":271,"_181":272,"_183":273,"_185":230,"_163":274,"_189":276},"ig30ht","IG30HT","IG30HT 高量程浊度传感器","采用红外散射光原理测量浊度，适用于工业过程水、地表水及水处理监测。数字探头结合光学补偿与蓝宝石视窗，可选自动清洁刷，减少持续运行中的表面附着。",{"_57":164,"_187":-5,"_181":109,"_147":-5,"_144":275},{"_103":109,"_147":-5,"_149":-5,"_150":151},{"_160":277,"_140":192,"_193":278,"_195":196,"_197":279,"_199":280,"_201":281,"_203":282,"_205":283,"_207":284,"_209":285},"95eccf83-22e5-4f4d-a03f-5509479d7661","2025040860985293.jpg",11246,"ecdac2d963d6479b136774a8172895d54061650f1cb8089d1404ff2a26710a79",190,78,"/igenu-preview/media/ecdac2d963d6479b136774a8.png","2026-10-20T17:32:39.787Z",[286],{"_201":281,"_203":282,"_195":214,"_205":287},"/igenu-preview/media/c0547cb002a63d36b1ac374c.webp",{"_160":175,"_57":289,"_179":290,"_181":291,"_183":292,"_185":230,"_163":293,"_189":295},"ig3254cod","IG3254COD","IG3254COD 紫外法COD与TOC传感器","采用紫外吸收原理在线监测COD与TOC，无需投加测量试剂。数字探头结合浊度补偿、多种校准方式及可选自动清洁装置，测量结果需按所选校准方法解读。",{"_57":164,"_187":-5,"_181":109,"_147":-5,"_144":294},{"_103":109,"_147":-5,"_149":-5,"_150":151},{"_160":296,"_140":192,"_193":297,"_195":258,"_197":298,"_199":299,"_201":261,"_203":261,"_205":300,"_207":301,"_209":302},"79d9f104-d914-4e36-bec2-d6d2b843fefd","2025041051182309.jpg",14215,"e3e2c21db606165f614650cf931244737a0e84793f3dd9ab8bd834db8aa5b8b3","/igenu-preview/media/e3e2c21db606165f614650cf.jpg","2026-10-20T17:32:39.888Z",[303,305],{"_201":212,"_203":212,"_195":214,"_205":304},"/igenu-preview/media/087409fcbd7eefe1aec06c53.webp",{"_201":261,"_203":261,"_195":214,"_205":306},"/igenu-preview/media/6d889354b11ab94fb489a773.webp","sourceSections",[]]
