ts?category=water",{"_108":113,"_110":114},"工业测量","/zh-CN/products?category=industrial",{"_108":116,"_110":117},"气体检测","/zh-CN/products?category=gas",{"_103":119,"_105":120},"了解更多",[121,124,127,130,133],{"_108":122,"_110":123},"关于我们","/zh-CN/about",{"_108":125,"_110":126},"客户案例","/zh-CN/cases",{"_108":128,"_110":129},"新闻中心","/zh-CN/news",{"_108":131,"_110":132},"售后服务","/zh-CN/service",{"_108":134,"_110":135},"下载中心","/zh-CN/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig9000",[],[],"seo",{"_103":146,"_147":148,"_149":150,"_151":152},"IG9000 超声波物位计 | IGENU SCIENCE","description","通过超声波传播时间测量液体及散料物位，无需与介质直接接触。提供一体式与分体式结构，结合信号分析及温度补偿，适用于水处理、储罐等物位监测。","imageUrl","/igenu-preview/media/8ef050d2f42f424a5466c7f7.png","index",true,"canonical","https://eicloc.github.io/igenu-preview/zh-CN/products/ig9000","query",{},"selected",[],"detail",{"_161":162,"_57":141,"_163":164,"_165":166,"_167":148,"_168":169,"_170":171,"_175":176,"_217":218,"_219":220,"_147":-5,"_221":222,"_223":224,"_225":226,"_227":228,"_327":328,"_358":359,"_360":361,"_144":145},"id","43425fa1-18a8-4ebe-995e-466a914f67da","model","IG9000","name","IG9000 超声波物位计","shortDescription","featured",false,"category",{"_57":172,"_173":-5,"_165":113,"_147":-5,"_144":174},"industrial","brand",{"_103":113,"_147":-5,"_149":-5,"_151":152},"heroImage",{"_161":177,"_140":178,"_179":180,"_181":182,"_183":184,"_185":186,"_187":188,"_189":190,"_191":150,"_192":193,"_194":195},"485bff13-2df9-448f-a8bc-6b60b3e5ad76","IMAGE","originalName","2025040851503805.png","mimeType","image/png","size",698863,"sha256","8ef050d2f42f424a5466c7f703dc0ddcbb2915dc23bdee338481847f3cefa2dd","width",2604,"height",1704,"url","createdAt","2026-10-20T17:32:39.690Z","variants",[196,201,205,209,213],{"_187":197,"_189":198,"_181":199,"_191":200},320,209,"image/webp","/igenu-preview/media/63971d02adf57bfde6335036.webp",{"_187":202,"_189":203,"_181":199,"_191":204},640,419,"/igenu-preview/media/94e5c9a427aaff2e7fe15add.webp",{"_187":206,"_189":207,"_181":199,"_191":208},960,628,"/igenu-preview/media/6403302113043098a393f716.webp",{"_187":210,"_189":211,"_181":199,"_191":212},1280,838,"/igenu-preview/media/bd1f66f7ac71cc90284d1d8d.webp",{"_187":214,"_189":215,"_181":199,"_191":216},1600,1047,"/igenu-preview/media/0f4d290e7e86d3dd29596237.webp","detailLayout","STRUCTURED","availableLocales",[11,20,17],"bodyHtml","<p><strong><span>产品特点：</span></strong></p><p>◆一体式、分体式可选，适用于不同现场安装要求 </p><p>◆主机可单通道、双通道可选，可实现多点测量、报警等功能 </p><p>◆使用简洁，结果可靠，界面操作指示可以减少操作失误 </p><p>◆探头材质有POM、PVDF、PTFE可选，适用于多种工况场合 </p><p>◆内部集成温度传感器，可实时对声速进行温度补偿</p><p><strong> </strong></p><p><strong><span>应用领域：</span></strong></p><p>政污水、工业废水 、环境监测 、饮用及地表水监测 、工业过程</p><p><strong> </strong></p><p><strong><span>技术参数：</span></strong></p><p><strong>一体式</strong></p><p>电源：DC18-36V；AC90-260V</p><p>输出：0/4-20mA;RS485(选配) </p><p>量程：0~5/10/15/20m </p><p>精度：0.25%（量程） </p><p>分辨率：1mm </p><p>盲区：0.3~0.6（视量程） </p><p>显示类型：128*64LCD（中英文、回波信号） </p><p>显示模式：液位、空距 </p><p>过程温度：-30℃~80℃ </p><p>防护等级：IP68（线径7-12mm）</p><p>电气接口：M20*1.5 </p><p>控制：2路可编程继电器 </p><p>故障报警：有</p><p>信号搜索：该功能能够有效应对泡沫和垃圾漂浮物等信号反射不良场合</p><p><strong>分体式</strong></p><p>电源：DC18-36V；AC90-260V</p><p>输出：2路0/4-20mA;RS485(选配) </p><p>量程：0~5/10/15/20m </p><p>精度：0.25%（量程） </p><p>分辨率：1mm 盲区：0.3~0.6（视量程）</p><p>显示类型：192*64LCD（中英文、回波信号） </p><p>显示模式：液位、空距 </p><p>过程温度：变送器：-30℃~80℃；传感器：-40℃~80℃ </p><p>防护等级：变送器：IP65；传感器：IP68（线径7~ 12mm） </p><p>电气接口：M20*1.5 </p><p>控制：4路可编程继电器 </p><p>故障报警：有 </p><p>信号搜索：该功能能够有效应对泡沫和垃圾漂浮物等信号反射不良场合</p><br /><p></p>\n    ","gallery",[],"features",[],"specificationGroups",[229,292],{"_165":230,"_231":232},"一体式","specifications",[233,240,244,248,252,256,260,264,268,272,276,280,284,288],{"_234":235,"_108":236,"_237":238,"_239":-5},"key","integrated.power-supply","电源","value","DC18-36V；AC90-260V","unit",{"_234":241,"_108":242,"_237":243,"_239":-5},"integrated.output","输出","0/4-20mA;RS485(选配)",{"_234":245,"_108":246,"_237":247,"_239":-5},"integrated.measurement-range","量程","0~5/10/15/20m",{"_234":