ts?category=water",{"_108":113,"_110":114},"工业测量","/zh-CN/products?category=industrial",{"_108":116,"_110":117},"气体检测","/zh-CN/products?category=gas",{"_103":119,"_105":120},"了解更多",[121,124,127,130,133],{"_108":122,"_110":123},"关于我们","/zh-CN/about",{"_108":125,"_110":126},"客户案例","/zh-CN/cases",{"_108":128,"_110":129},"新闻中心","/zh-CN/news",{"_108":131,"_110":132},"售后服务","/zh-CN/service",{"_108":134,"_110":135},"下载中心","/zh-CN/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig8100mp",[],[],"seo",{"_103":146,"_147":148,"_149":150,"_151":152},"IG8100MP 便携式气体检测报警仪 | IGENU SCIENCE","description","采用泵吸式采样，按目标气体选配传感器，便于移动检测与现场巡检。彩色显示屏呈现测量信息，并提供声音、灯光及振动报警，辅助操作人员识别监测状态。","imageUrl","/igenu-preview/media/08e61223b82894782eed9185.png","index",true,"canonical","https://eicloc.github.io/igenu-preview/zh-CN/products/ig8100mp","query",{},"selected",[],"detail",{"_161":162,"_57":141,"_163":164,"_165":166,"_167":148,"_168":169,"_170":171,"_175":176,"_207":208,"_209":210,"_147":-5,"_211":212,"_213":214,"_215":216,"_217":218,"_285":286,"_287":288,"_289":290,"_144":145},"id","d712539f-bba5-44ea-9c7e-5be89c6d40ac","model","IG8100MP","name","IG8100MP 便携式气体检测报警仪","shortDescription","featured",false,"category",{"_57":172,"_173":-5,"_165":116,"_147":-5,"_144":174},"gas","brand",{"_103":116,"_147":-5,"_149":-5,"_151":152},"heroImage",{"_161":177,"_140":178,"_179":180,"_181":182,"_183":184,"_185":186,"_187":188,"_189":190,"_191":150,"_192":193,"_194":195},"2c4a4ac6-d50b-4737-b7e4-ebc32635cd6c","IMAGE","originalName","2025040852237053.png","mimeType","image/png","size",280168,"sha256","08e61223b82894782eed918587b2b8ae3b4fa6fbbb2b5228bbfebeca395a748a","width",691,"height",699,"url","createdAt","2026-10-20T17:32:39.713Z","variants",[196,201,205],{"_187":197,"_189":198,"_181":199,"_191":200},320,324,"image/webp","/igenu-preview/media/5f86a27572b4892ac922fa01.webp",{"_187":202,"_189":203,"_181":199,"_191":204},640,647,"/igenu-preview/media/56eed4aed7ff6130c91bdc9f.webp",{"_187":188,"_189":190,"_181":199,"_191":206},"/igenu-preview/media/50e8b14977630a4f3e555596.webp","detailLayout","STRUCTURED","availableLocales",[11,20,17],"bodyHtml","<p><strong><span>产品特点：</span></strong></p><p>◆2.5英寸高清彩屏，三种显示模式，可显示曲线图</p><p>◆标配um级过滤器，可滤掉99%油、水、尘杂质，操作使用更得心应手</p><p>◆支持1-4种传感器，毫秒级反应，精准度高</p><p>◆泵吸式取样，适合任何场景</p><p>◆三重报警（声光、震动），不易忽略</p><p><strong> </strong></p><p><strong><span>应用领域：</span></strong></p><p>石油/化工 、工业制造 、污水处理、电力电工、 金属冶炼</p><p><strong> </strong></p><p><strong><span>技术参数：</span></strong></p><p><strong>检测气体：</strong></p><p><strong>氧、硫及氧化物 </strong></p><p><a href=\"https://www.szwost.cn/product-17-1-24-1.html\" title=\"氧气 O2\" rel=\"noopener noreferrer\"><span>氧气 O2</span></a>、 <a href=\"https://www.szwost.cn/product-17-1-25-1.html\" title=\"臭氧 O3\" rel=\"noopener noreferrer\"><span>臭氧 O3</span></a>、 <a href=\"https://www.szwost.cn/product-17-1-35-1.html\" title=\"一氧化碳CO\" rel=\"noopener noreferrer\"><span>一氧化碳CO</span></a> 、<a href=\"https://www.szwost.cn/product-17-1-21-1.html\" title=\"二氧化碳CO2\" rel=\"noopener noreferrer\"><span>二氧化碳CO2</span></a> 、<a href=\"https://www.szwost.cn/product-17-1-34-1.html\" title=\"一氧化氮NO\" rel=\"noopener noreferrer\"><span>一氧化氮NO</span></a>、 <a href=\"https://www.szwost.cn/product-17-1-20-1.html\" title=\"二氧化氮NO2\" rel=\"noopener noreferrer\"><span>二氧化氮NO2</span></a>、 <a href=\"https://www.szwost.cn/product-17-1-164-1.html\" title=\"氮氧化物NOx\" rel=\"noopener noreferrer\"><span>氮氧化物NOx</span></a> 、<a href=\"https://www.szwost.cn/product-17-1-176-1.html\" title=\"二氧化硫SO2\" rel=\"noopener noreferrer\"><span>二氧化硫SO2</span></a>、 <a href=\"https://www.szwost.cn/product-17-1-177-1.html\" title=\"二氧化氯CLO2\" rel=\"noopener noreferrer\"><span>二氧化氯CLO2</span></a></p><p><strong>氮、氢及氰化物</strong></p><p><a href=\"https://www.szwost.cn/product-17-2-16-1.html\" title=\"氢气 H2\" rel=\"noopener noreferrer\"><span>氢气 H2</span></a> 、<a href=\"https://www.szwost.cn/product-17-2-17-1.html\" title=\"氨气 NH3\" rel=\"noopener noreferrer\"><span>氨气 NH3</span></a> 、<a href=\"https://www.szwost.cn/product-17-2-18-1.html\" title=\"硫化氢 H2S\" rel=\"noopener noreferrer\"><span>硫化氢 H2S</span></a> 、<a href=\"https://www.szwost.cn/product-17-2-33-1.html\" title=\"氮气N2\" rel=\"noopener noreferrer\"><span>氮气N2</span></a> 、<a href=\"https://www.szwost.cn/product-17-2-19-1.html\" title=\"氯化氢 HCL\" rel=\"noopener noreferrer\"><span>氯化氢 HCL</span></a> 、<a href=\"https://www.szwost.cn/product-17-2-36-1.html\" title=\"磷化氢PH3\" rel=\"noopener noreferrer\"><span>磷化氢PH3</span></a> 、<a href=\"https://www.szwost.cn/product-17-2-22-1.html\" title=\"氰化氢HCN\" rel=\"noopener noreferrer\"><span>氰化氢HCN</span></a>、 <a href=\"https://www.szwost.cn/product-17-2-37-1.html\" title=\"砷化氢AsH3\" rel=\"noopener noreferrer\"><span>砷化氢AsH3</span></a>、 <a href=\"https://www.szwost.cn/product-17-2-23-1.html\" title=\"氟化氢 HF\" rel=\"noopener noreferrer\"><span>氟化氢 HF</span></a></p><p><strong>烷类、可燃气体</strong></p><p><a href=\"https://www.szwost.cn/product-17-3-26-1.html\" title=\"可燃气体EX\" rel=\"noopener noreferrer\"><span>可燃气体EX</span></a>、 <a href=\"https://www.szwost.cn/product-17-3-44-1.html\" title=\"甲烷CH4\" rel=\"noopener noreferrer\"><span>甲烷CH4</span></a>、 <a href=\"https://www.szwost.cn/product-17-3-45-1.html\" title=\"乙烷C2H6\" rel=\"noopener noreferrer\"><span>乙烷C2H6</span></a> 、<a href=\"https://www.szwost.cn/product-17-3-28-1.html\" title=\"丙烷C3H8\" rel=\"noopener noreferrer\"><span>丙烷C3H8</span></a> 、<a href=\"https://www.szwost.cn/product-17-3-185-1.html\" title=\"环氧乙烷C2H4O\" rel=\"noopener noreferrer\"><span>环氧乙烷C2H4O</span></a></p><p><strong>有机挥发性气体</strong></p><p><a href=\"https://www.szwost.cn/product-17-4-27-1.html\" title=\"臭味ODOR\" rel=\"noopener noreferrer\"><span>臭味ODOR</span></a> 、<a href=\"https://www.szwost.cn/product-17-4-29-1.html\" title=\"苯C6H6\" rel=\"noopener noreferrer\"><span>苯C6H6</span></a> 、<a href=\"https://www.szwost.cn/product-17-4-30-1.html\" title=\"甲苯C7H8\" rel=\"noopener noreferrer\"><span>甲苯C7H8</span></a> 、<a href=\"https://www.szwost.cn/product-17-4-183-1.html\" title=\"二甲苯C8H10\" rel=\"noopener noreferrer\"><span>二甲苯C8H10</span></a> 、<a href=\"https://www.szwost.cn/product-17-4-184-1.html\" title=\"VOCs\" rel=\"noopener noreferrer\"><span>VOCs</span></a> 、<a href=\"https://www.szwost.cn/product-17-4-186-1.html\" title=\"甲醛CH2O\" rel=\"noopener noreferrer\"><span>甲醛CH2O</span></a> 、<a href=\"https://www.szwost.cn/product-17-4-187-1.html\" title=\"乙烯C2H4\" rel=\"noopener noreferrer\"><span>乙烯C2H4</span></a>、 <a href=\"https://www.szwost.cn/product-17-4-188-1.html\" title=\"乙醇C2H6O\" rel=\"noopener noreferrer\"><span>乙醇C2H6O</span></a> 、<a href=\"https://www.szwost.cn/product-17-4-189-1.html\" title=\"非甲烷总烃\" rel=\"noopener noreferrer\"><span>非甲烷总烃</span></a></p><p><strong>卤素、卤代烃</strong></p><p><a href=\"https://www.szwost.cn/product-17-5-46-1.html\" title=\"六氟化硫SF6\" rel=\"noopener noreferrer\"><span>六氟化硫SF6</span></a>、 <a href=\"https://www.szwost.cn/product-17-5-47-1.html\" title=\"氯气CL2\" rel=\"noopener noreferrer\"><span>氯气CL2</span></a>、 <a href=\"https://www.szwost.cn/product-17-5-48-1.html\" title=\"氟气F2\" rel=\"noopener noreferrer\"><span>氟气F2</span></a> 、<a href=\"https://www.szwost.cn/product-17-5-49-1.html\" title=\"溴气Br2\" rel=\"noopener noreferrer\"><span>溴气Br2</span></a></p><p>检测原理：电化学法/红外法/催化燃烧/PID</p><p>测量范围：0~50/100ppm, 0~50/100%Vol </p><p>分辨率： 0.01ppm，0.01%VOL</p><p>检测下限：0.05ppm，0.05%VOL</p><p>精度：≤±1%F.S </p><p>零点漂移：≤±1%F.S/年 </p><p>响应时间：≤15 秒（T90）</p><p>恢复时间：≤20 秒 </p><p>检测方式：泵吸式 </p><p>温湿度：温度检测范围：-40 ~ 120℃，温度检测范围：0-100%RH</p><p>检测方式：实时、定时 </p><p>气体扩展：支持1-4个探头</p><p>零点漂移：≤±1% （F.S/年）</p><p>防护等级：IP65</p><p>存储模式：    本机内存或内存卡</p><p>电源：4600mA可充电聚合物电池</p><br />\n    ","gallery",[],"features",[],"specificationGroups",[219],{"_165":220,"_221":222},"技术参数","specifications",[223,230,234,238,242,246,250,254,258,262,266,269,273,277,281],{"_224":225,"_108":226,"_227":228,"_229":-5},"key","measurement-principle","检测原理","value","电化学法/红外法/催化燃烧/PID","unit",