ts?category=water",{"_108":113,"_110":114},"工业测量","/zh-CN/products?category=industrial",{"_108":116,"_110":117},"气体检测","/zh-CN/products?category=gas",{"_103":119,"_105":120},"了解更多",[121,124,127,130,133],{"_108":122,"_110":123},"关于我们","/zh-CN/about",{"_108":125,"_110":126},"客户案例","/zh-CN/cases",{"_108":128,"_110":129},"新闻中心","/zh-CN/news",{"_108":131,"_110":132},"售后服务","/zh-CN/service",{"_108":134,"_110":135},"下载中心","/zh-CN/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig3000lt",[],[],"seo",{"_103":146,"_147":148,"_149":150,"_151":152},"IG3000LT 低量程浊度分析仪 | IGENU SCIENCE","description","面向饮用水与处理系统中的低浊度测量，采用光学检测与气泡去除流通池，减少气泡对读数的影响。模块化结构便于校准、清洁和维护，并可同时显示温度。","imageUrl","/igenu-preview/media/32687b0fb7e3209190a365f6.png","index",true,"canonical","https://eicloc.github.io/igenu-preview/zh-CN/products/ig3000lt","query",{},"selected",[],"detail",{"_161":162,"_57":141,"_163":164,"_165":166,"_167":148,"_168":169,"_170":171,"_175":176,"_203":204,"_205":206,"_147":-5,"_207":208,"_209":210,"_211":212,"_213":214,"_318":319,"_320":321,"_322":323,"_144":145},"id","4df5cf04-3393-4883-9cb6-f83c88032cc8","model","IG3000LT","name","IG3000LT 低量程浊度分析仪","shortDescription","featured",false,"category",{"_57":172,"_173":-5,"_165":109,"_147":-5,"_144":174},"water","brand",{"_103":109,"_147":-5,"_149":-5,"_151":152},"heroImage",{"_161":177,"_140":178,"_179":180,"_181":182,"_183":184,"_185":186,"_187":188,"_189":190,"_191":150,"_192":193,"_194":195},"257d01fc-7670-46be-af54-0ae68bffbc45","IMAGE","originalName","2025040860761681.jpg","mimeType","image/png","size",133072,"sha256","32687b0fb7e3209190a365f6165fd1befe9616a983cc291c12aca450fcae88b2","width",327,"height",551,"url","createdAt","2026-10-20T17:32:39.781Z","variants",[196,201],{"_187":197,"_189":198,"_181":199,"_191":200},320,539,"image/webp","/igenu-preview/media/f37ebd4fe6509270a9cebcfb.webp",{"_187":188,"_189":190,"_181":199,"_191":202},"/igenu-preview/media/eeb83d74a18b9d4f5cb4ef75.webp","detailLayout","STRUCTURED","availableLocales",[11,20,17],"bodyHtml","<p><strong><span>产品特点：</span></strong></p><p>◆符合并超过USEPA 180.1 方法要求</p><p>◆稳定高效的气泡去除系统 </p><p>◆结构紧凑，占用空间小 </p><p>◆运行成本低 </p><p>◆135mL流通池—迟滞小，灵敏度高</p><p>◆同时测量和显示温度 </p><p>◆清洗维护简单</p><p>◆输出锁定功能，维护方便</p><p><strong> </strong></p><p><strong><span>应用领域：</span></strong></p><p>饮用水处理系统 、饮用水管网监测、膜处理工艺 、食品及制药工程、罐装水系统监测、废水排放口</p><p><strong> </strong></p><p><strong><span>技术参数：</span></strong></p><p>量程：0-100NTU</p><p>分辨率：0.0001NTU</p><p>准确度：读数的±1%，或0.008NTUNTU，取大者（小于20NTU）；</p><p>读数的±2%，或0.015NTUNTU，取大者（大于20NTU）</p><p>响应时间：30秒达到90%</p><p>测量单位：NTU</p><p>温度单位：℃</p><p>校准：零点校准，1点标准样品校准，温度校准，斜率校准</p><p>显示：大屏幕LED显示，7键菜单导航</p><p>信号滤波：0-100S</p><p>模拟输出：2路4-20mA</p><p>数字通讯：MODBUS/RS485,MODBUS/RS232，Profibus，DeviceNet、CANopen、EthermetIP、ModbusTCP,TCP/IP</p><p>继电器：2路FromC,5A@250VAC</p><p>样品流速：200～750mL/min</p><p>水体温度：-5~50℃</p><p>环境温度：-20~60℃</p><p>光源：白光（钨灯）</p><p>光室：阳极氧化铝</p><p>流通池：ABS塑料，135ml</p><p>传感器材料：石英，阳极氧化铝</p><p>进水管接口：1/4</p><p>进水管接口：3/8</p><p>电源要求：100～230VAC,50/60Hz</p><p>控制器尺寸：200mm*200mm*70mm</p><p>传感器及流通池尺寸：210mm*140mm*100mm</p><p>功耗：≤10W</p><br />\n    ","gallery",[],"features",[],"specificationGroups",[215],{"_165":216,"_217":218},"技术参数","specifications",[219,226,230,234,238,242,246,250,254,258,262,266,270,274,278,282,286,290,294,298,302,306,310,314],{"_220":221,"_108":222,"_223":224,"_225":-5},"key","measurement-range","量程","value","0-100NTU","unit",{"_220":227,"_108":228,"_223":229,"_225":-5},"resolution","分辨率","0.0001NTU",{"_220":231,"_108":232,"_223":233,"_225":-5},"accuracy","准确度","读数的±1%，或0.008NTUNTU，取大者（小于20NTU）；",{"_220":235,"_108":236,"_223":237,"_225":-5},"response-time","响应时间","30秒达到90%",{"_220":239,"_108":240,"_223":241,"_225":-5},"units","测量单位","NTU",{"_220":243,"_108":244,"_223":245,"_225":-5},"temperature-unit","温度单位","℃",{"_220":247,"_108":248,"_223":249,"_225":-5},"calibration","校准","零点校准，1点标准样品校准，温度校准，斜率校准",{"_220":251,"_108":252,"_223":253,"_225":-5},"display","显示","大屏幕LED显示，7键菜单导航",{"_220":255,"_108":256,"_223":257,"_225":-5},"signal-filtering","信号滤波","0-100S",{"_220":259,"_108":260,"_223":261,"_225":-5},"analog-output","模拟输出","2路4-20mA",{"_220":263,"_108":264,"_223":265,"_225":-5},"digital-communication","数字通讯","MODBUS/RS485,MODBUS/RS232，Profibus，DeviceNet、CANopen、EthermetIP、ModbusTCP,TCP/IP",{"_220":267,"_108":268,"_223":269,"_225":-5},"relay","继电器","2路FromC,5A@250VAC",{"_220":271,"_108":272,"_223":273,"_225":-5},"sample-flow","样品流速","200～750mL/min",{"_220":275,"_108":276,"_223":277,"_225":-5},"water-temperature","水体温度","-5~50℃",{"_220":279,"_108":280,"_223":281,"_225":-5},"operating-temperature","环境温度","-20~60℃",{"_220":283,"_108":284,"_223":285,"_225":-5},"light-source","光源","白光（钨灯）",{"_220":287,"_108":288,"_223":289,"_225":-5},"light-chamber","光室","阳极氧化铝",{"_220":291,"_108":292,"_223":293,"_225":-5},"flow-cell","流通池","ABS塑料，135ml",{"_220":295,"_108":296,"_223":297,"_225":-5},"sensor-material","传感器材料","石英，阳极氧化铝",{"_220":299,"_108":300,"_223":301,"_225":-5},"inlet-connection","进水管接口","1/4; 3/8",{"_220":303,"_108":304,"_223":305,"_225":-5},"power-supply","电源要求","100～230VAC,50/60Hz",{"_220":307,"_108":308,"_223":309,"_225":-5},"controller-size","控制器尺寸","200mm*200mm*70mm",{"_220":311,"_108":312,"_223":313,"_225":-5},"sensor-cell-size","传感器及流通池尺寸","210mm*140mm*100mm",{"_220":315,"_108":316,"_223":317,"_225":-5},"power-consumption","功耗","≤10W","sourceReviews",[],"documents",[],"supportDownloads",[]]
