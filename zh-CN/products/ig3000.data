[{"_1":2,"_7":8},"root",{"_3":4},"data",{"_5":6},"productView","grid","content",{"_3":9},{"_10":11,"_12":13,"_14":15,"_140":58,"_57":141,"_64":142,"_70":143,"_144":145,"_153":154,"_155":156,"_157":158,"_159":160},"locale","zh-CN","origin","https://eicloc.github.io","settings",{"_16":17,"_18":19,"_21":22,"_23":24,"_54":55,"_86":87,"_88":89,"_26":27,"_28":29,"_37":-5,"_90":91,"_92":-5,"_93":94,"_95":96,"_97":98,"_99":-5,"_100":101,"_136":-5,"_137":-5,"_138":139},"defaultLocale","en","enabledLocales",[17,11,20],"de","logoUrl","/igenu-preview/media/f607ce2a51366ba8778f1000.jpg","regionalContacts",[25,39,47],{"_26":27,"_28":29,"_30":31,"_35":36,"_37":38},"email","Germany@igenu.com","phone","0049-935890-024","labels",{"_20":32,"_17":33,"_11":34},"Deutschland","Germany","德国","region","GERMANY","address","",{"_26":40,"_28":41,"_30":42,"_35":46,"_37":38},"cn@igenu.com","400-002-1266",{"_20":43,"_17":44,"_11":45},"Servicezentrum China","China service center","中国服务中心","CHINA",{"_26":48,"_28":38,"_30":49,"_35":53,"_37":38},"info@igenu-germany.com",{"_20":50,"_17":51,"_11":52},"Internationale Anfragen","International enquiries","国际业务咨询","INTERNATIONAL","navigation",[56,63,69,75,81],{"_57":58,"_30":59},"slug","products",{"_20":60,"_17":61,"_11":62},"Instrumente","Instruments","产品中心",{"_57":64,"_30":65},"parameters",{"_20":66,"_17":67,"_11":68},"Messparameter","Parameters","测量参数",{"_57":70,"_30":71},"applications",{"_20":72,"_17":73,"_11":74},"Anwendungen","Applications","应用方案",{"_57":76,"_30":77},"about",{"_20":78,"_17":79,"_11":80},"Über IGENU","About IGENU","关于 IGENU",{"_57":82,"_30":83},"service",{"_20":84,"_17":84,"_11":85},"Support","服务支持","companyName","IGENU SCIENCE","tagline","洞察环境，明晰工业。","footer","从水质分析、工业过程到气体检测，以测量仪器连接每一项工况需求。","copyright","primaryCta","联系专家","primaryCtaUrl","/contact","socialLinks",{},"defaultSeoImageUrl","footerNavigation",[102,118],{"_103":104,"_105":106},"title","产品","links",[107,112,115],{"_108":109,"_110":111},"label","水质分析","href","/zh-CN/products?category=water",{"_108":113,"_110":114},"工业测量","/zh-CN/products?category=industrial",{"_108":116,"_110":117},"气体检测","/zh-CN/products?category=gas",{"_103":119,"_105":120},"了解更多",[121,124,127,130,133],{"_108":122,"_110":123},"关于我们","/zh-CN/about",{"_108":125,"_110":126},"客户案例","/zh-CN/cases",{"_108":128,"_110":129},"新闻中心","/zh-CN/news",{"_108":131,"_110":132},"售后服务","/zh-CN/service",{"_108":134,"_110":135},"下载中心","/zh-CN/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig3000",[],[],"seo",{"_103":146,"_147":148,"_149":150,"_151":152},"IG3000 Display 多通道智能控制器 | IGENU SCIENCE","description","将兼容的数字与模拟传感器接入统一的多通道控制平台，通过显示屏与按键菜单完成操作。可选信号输出、继电器及通讯配置，并提供输出保持功能，便于传感器维护。","imageUrl","/igenu-preview/media/8032374cce79b2ec8e8e37dc.png","index",true,"canonical","https://eicloc.github.io/igenu-preview/zh-CN/products/ig3000","query",{},"selected",[],"detail",{"_161":162,"_57":141,"_163":164,"_165":166,"_167":148,"_168":152,"_169":170,"_174":175,"_209":210,"_211":212,"_147":-5,"_213":214,"_215":216,"_217":218,"_219":220,"_307":308,"_309":310,"_311":312,"_144":145},"id","da285210-11c2-4983-81be-86274bcf1ca2","model","IG3000","name","IG3000 Display 多通道智能控制器","shortDescription","featured","category",{"_57":171,"_172":-5,"_165":109,"_147":-5,"_144":173},"water","brand",{"_103":109,"_147":-5,"_149":-5,"_151":152},"heroImage",{"_161":176,"_140":177,"_178":179,"_180":181,"_182":183,"_184":185,"_186":187,"_188":189,"_190":150,"_191":192,"_193":194},"d84d4b36-8577-47f5-a6b1-91a7ae3a7c9f","IMAGE","originalName","2025040855746689.png","mimeType","image/png","size",749999,"sha256","8032374cce79b2ec8e8e37dca3798c3058050655937edfc7f06654e8d4ff5b9e","width",1280,"height",1706,"url","createdAt","2026-10-20T17:32:39.748Z","variants",[195,200,204,207],{"_186":196,"_188":197,"_180":198,"_190":199},320,427,"image/webp","/igenu-preview/media/c82ee037d25142ee99b2efed.webp",{"_186":201,"_188":202,"_180":198,"_190":203},640,853,"/igenu-preview/media/8aafd5be554a54bb0699b6bf.webp",{"_186":205,"_188":187,"_180":198,"_190":206},960,"/igenu-preview/media/4a8ece2b232c4eb15009de8a.webp",{"_186":187,"_188":189,"_180":198,"_190":208},"/igenu-preview/media/288701302fcf6e887f187cad.webp","detailLayout","STRUCTURED","availableLocales",[11,20,17],"bodyHtml","<p><strong><span>产品特点：</span></strong></p><p>◆兼容性强，可连接伊格努公司的数字化传感器及模拟传感器</p><p>◆90*70大屏幕LED显示屏，操作界面友好</p><p>◆大尺寸防紫外线防腐PS壳体，可适应各种恶劣工况条件。</p><p>◆4-20mA输出带控制功能，可对外部设备进行PID控制</p><p>◆可选配多路继电器,ModbusRTU、DeviceNet、ModbusRS232、CANopen、EthermetIP、ModbusTCP,TCP/IP通讯等，可应对各种现场要求</p><p>◆多通道控制器，可以连接1个或多个传感器</p><p>◆输出保持功能，便于传感器维护</p><p>◆IP66防护等级 ,CE认证。</p><p><strong> </strong></p><p><strong><span>应用领域：</span></strong></p><p>地表水、市政污水、环境监测、工业过程水、污染源、废水、智慧水务</p><p><strong> </strong></p><p><strong><span>技术参数：</span></strong></p><p>显示：高分辨率全彩大屏幕LED显示屏</p><p>操作方式：按键式菜单导航</p><p>操作界面：中文/英文</p><p>通道数：1-8路</p><p>支持参数：PH、ORP、浊度、余氯、电导率、溶解氧、蓝藻、叶绿素、色度、透明度、UVCOD、氨氮、污泥浓度、悬浮物、硝酸盐氮等</p><p>单位：pH、mV、mg/L、us/cm、cm、ppb、ppm、℃、%、NTU等</p><p>支持温度传感器：PT100、PT1000、NTC10/30K</p><p>内部可供电源：5V/12V/24V</p><p>继电器：1-4路220VAC 3A ，可编程</p><p>模拟量输出：可选2-8路4-20mA输出</p><p>数字通讯：ModbusRS485、DeviceNet、ModbusRS232、CANopen、EthermetIP、ModbusTCP,TCP/IP，Profibus</p><p>输出保持功能：有</p><p>尺寸：200mm*200mm*70mm</p><p>安装方式：壁挂式</p><p>外壳材料：Poly+PS</p><p>工作环境：-10~50℃</p><p>防护等级：符合IP66 NEMA 4X</p><p>电气接口:M16*1.5</p><p>电源：100~240VAC,50/60Hz</p><p>认证：EMC: CE 认证，电磁和辐射排放符合EN 50081-2，抗干扰符合EN 61000-6-2</p><br />\n    ","gallery",[],"features",[],"specificationGroups",[221],{"_165":222,"_223":224},"技术参数","specifications",[225,232,236,240,244,247,251,255,259,263,267,271,275,279,283,287,291,295,299,303],{"_226":227,"_108":228,"_229":230,"_231":-5},"key","display","显示","value","高分辨率全彩大屏幕LED显示屏","unit",{"_226":233,"_108":234,"_229":235,"_231":-5},"operation","操作方式","按键式菜单导航",{"_226":237,"_108":238,"_229":239,"_231":-5},"interface-language","操作界面","中文/英文",{"_226":241,"_108":242,"_229":243,"_231":-5},"channels","通道数","1-8路",{"_226":64,"_108":245,"_229":246,"_231":-5},"支持参数","PH、ORP、浊度、余氯、电导率、溶解氧、蓝藻、叶绿素、色度、透明度、UVCOD、氨氮、污泥浓度、悬浮物、硝酸盐氮等",{"_226":248,"_108":249,"_229":250,"_231":-5},"units","单位","pH、mV、mg/L、us/cm、cm、ppb、ppm、℃、%、NTU等",{"_226":252,"_108":253,"_229":254,"_231":-5},"temperature-sensors","支持温度传感器","PT100、PT1000、NTC10/30K",{"_226":256,"_108":257,"_229":258,"_231":-5},"internal-power","内部可供电源","5V/12V/24V",{"_226":260,"_108":261,"_229":262,"_231":-5},"relay","继电器","1-4路220VAC 3A ，可编程",{"_226":264,"_108":265,"_229":266,"_231":-5},"analog-output","模拟量输出","可选2-8路4-20mA输出",{"_226":268,"_108":269,"_229":270,"_231":-5},"digital-communication","数字通讯","ModbusRS485、DeviceNet、ModbusRS232、CANopen、EthermetIP、ModbusTCP,TCP/IP，Profibus",{"_226":272,"_108":273,"_229":274,"_231":-5},"output-hold","输出保持功能","有",{"_226":276,"_108":277,"_229":278,"_231":-5},"dimensions","尺寸","200mm*200mm*70mm",{"_226":280,"_108":281,"_229":282,"_231":-5},"installation","安装方式","壁挂式",{"_226":284,"_108":285,"_229":286,"_231":-5},"material","外壳材料","Poly+PS",{"_226":288,"_108":289,"_229":290,"_231":-5},"operating-temperature","工作环境","-10~50℃",{"_226":292,"_108":293,"_229":294,"_231":-5},"protection","防护等级","符合IP66 NEMA 4X",{"_226":296,"_108":297,"_229":298,"_231":-5},"connection","电气接口","M16*1.5",{"_226":300,"_108":301,"_229":302,"_231":-5},"power-supply","电源","100~240VAC,50/60Hz",{"_226":304,"_108":305,"_229":306,"_231":-5},"certification","认证","EMC: CE 认证，电磁和辐射排放符合EN 50081-2，抗干扰符合EN 61000-6-2","sourceReviews",[],"documents",[],"supportDownloads",[]]
