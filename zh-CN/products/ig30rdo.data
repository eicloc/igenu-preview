[{"_1":2,"_7":8},"root",{"_3":4},"data",{"_5":6},"productView","grid","content",{"_3":9},{"_10":11,"_12":13,"_14":15,"_140":58,"_57":141,"_64":142,"_70":143,"_144":145,"_153":154,"_155":156,"_157":158,"_159":160},"locale","zh-CN","origin","https://eicloc.github.io","settings",{"_16":17,"_18":19,"_21":22,"_23":24,"_54":55,"_86":87,"_88":89,"_26":27,"_28":29,"_37":-5,"_90":91,"_92":-5,"_93":94,"_95":96,"_97":98,"_99":-5,"_100":101,"_136":-5,"_137":-5,"_138":139},"defaultLocale","en","enabledLocales",[17,11,20],"de","logoUrl","/igenu-preview/media/f607ce2a51366ba8778f1000.jpg","regionalContacts",[25,39,47],{"_26":27,"_28":29,"_30":31,"_35":36,"_37":38},"email","Germany@igenu.com","phone","0049-935890-024","labels",{"_20":32,"_17":33,"_11":34},"Deutschland","Germany","德国","region","GERMANY","address","",{"_26":40,"_28":41,"_30":42,"_35":46,"_37":38},"cn@igenu.com","400-002-1266",{"_20":43,"_17":44,"_11":45},"Servicezentrum China","China service center","中国服务中心","CHINA",{"_26":48,"_28":38,"_30":49,"_35":53,"_37":38},"info@igenu-germany.com",{"_20":50,"_17":51,"_11":52},"Internationale Anfragen","International enquiries","国际业务咨询","INTERNATIONAL","navigation",[56,63,69,75,81],{"_57":58,"_30":59},"slug","products",{"_20":60,"_17":61,"_11":62},"Instrumente","Instruments","产品中心",{"_57":64,"_30":65},"parameters",{"_20":66,"_17":67,"_11":68},"Messparameter","Parameters","测量参数",{"_57":70,"_30":71},"applications",{"_20":72,"_17":73,"_11":74},"Anwendungen","Applications","应用方案",{"_57":76,"_30":77},"about",{"_20":78,"_17":79,"_11":80},"Über IGENU","About IGENU","关于 IGENU",{"_57":82,"_30":83},"service",{"_20":84,"_17":84,"_11":85},"Support","服务支持","companyName","IGENU SCIENCE","tagline","洞察环境，明晰工业。","footer","从水质分析、工业过程到气体检测，以测量仪器连接每一项工况需求。","copyright","primaryCta","联系专家","primaryCtaUrl","/contact","socialLinks",{},"defaultSeoImageUrl","footerNavigation",[102,118],{"_103":104,"_105":106},"title","产品","links",[107,112,115],{"_108":109,"_110":111},"label","水质分析","href","/zh-CN/products?category=water",{"_108":113,"_110":114},"工业测量","/zh-CN/products?category=industrial",{"_108":116,"_110":117},"气体检测","/zh-CN/products?category=gas",{"_103":119,"_105":120},"了解更多",[121,124,127,130,133],{"_108":122,"_110":123},"关于我们","/zh-CN/about",{"_108":125,"_110":126},"客户案例","/zh-CN/cases",{"_108":128,"_110":129},"新闻中心","/zh-CN/news",{"_108":131,"_110":132},"售后服务","/zh-CN/service",{"_108":134,"_110":135},"下载中心","/zh-CN/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig30rdo",[],[],"seo",{"_103":146,"_147":148,"_149":150,"_151":152},"IG30RDO 荧光法溶解氧传感器 | IGENU SCIENCE","description","采用荧光法测量溶解氧，无需更换电解液或进行极化。内置温度补偿并支持数字通讯，提供空气及样品校准方式，面向水处理、环境监测与水产养殖等应用。","imageUrl","/igenu-preview/media/1513162129cbcc0b7fb98e96.jpg","index",true,"canonical","https://eicloc.github.io/igenu-preview/zh-CN/products/ig30rdo","query",{},"selected",[],"detail",{"_161":162,"_57":141,"_163":164,"_165":166,"_167":148,"_168":152,"_169":170,"_174":175,"_202":203,"_204":205,"_147":-5,"_206":207,"_208":209,"_210":211,"_212":213,"_301":302,"_303":304,"_305":306,"_144":145},"id","f607cd0f-5835-4426-b788-827be959a3fc","model","IG30RDO","name","IG30RDO 荧光法溶解氧传感器","shortDescription","featured","category",{"_57":171,"_172":-5,"_165":109,"_147":-5,"_144":173},"water","brand",{"_103":109,"_147":-5,"_149":-5,"_151":152},"heroImage",{"_161":176,"_140":177,"_178":179,"_180":181,"_182":183,"_184":185,"_186":187,"_188":189,"_190":150,"_191":192,"_193":194},"0ddcf618-0714-49aa-9919-74ce97332e9e","IMAGE","originalName","2025040860317013.png","mimeType","image/jpeg","size",19493,"sha256","1513162129cbcc0b7fb98e96f5e5a24329832e50befa0944e7b17725123db89a","width",458,"height",293,"url","createdAt","2026-10-20T17:32:39.769Z","variants",[195,200],{"_186":196,"_188":197,"_180":198,"_190":199},320,205,"image/webp","/igenu-preview/media/875a6bfa76d0d60b22d59c3d.webp",{"_186":187,"_188":189,"_180":198,"_190":201},"/igenu-preview/media/676768d13901a89005e95e68.webp","detailLayout","STRUCTURED","availableLocales",[11,20,17],"bodyHtml","<p><strong><span>产品特点：</span></strong></p><p>◆内置温度传感器，自动温度补偿 </p><p>◆荧光法，无需更换膜与电解液，空气校准，简单快速 </p><p>◆数字传感器，RS-485输出，标准ModbusRTU协议，不 受传输距离影响，稳定性更佳 ◆传感器采用钛合金材料，使用寿命更长，降低维护与停机时间</p><p>◆无需极化，响应时间快 </p><p>◆不受pH 值波动、CO2、硫化物、硫化氢、硫酸盐、氯化物、氨氮、重金属的干扰 </p><p>◆不受流速干扰、能承受剧烈冲击</p><p><strong> </strong></p><p><strong><span>应用领域：</span></strong></p><p>市政污水、工业废水、环境监测、饮用及地表水监测 、工业过程 、水产养殖、生物过程</p><p><strong> </strong></p><p><strong><span>技术参数：</span></strong></p><p>量程：0~20mg/L 或0~200%饱和度，0~65℃ </p><p>测量原理：荧光法 </p><p>测量精度：低于 5 mg/L 时为 ±0.1mg/L</p><p>高于 5 mg/L 时为 ±0.2 mg/L</p><p>温度： ±0.1°C</p><p>响应时间：20℃时，37 秒达到 95% </p><p>重复性：±0.1mg/L </p><p>分辨率：0.01mg/L </p><p>最大压力：23bar @50℃</p><p>最大流速：无流速要求</p><p>校准方式：饱和空气校准，1点样品校准，零点校准，1点温度校准 </p><p>电极主体材质：钛合金 </p><p>螺纹接口：标准3/4NPT</p><p>传感器通讯：MODBUS RS-485 </p><p>温度电极：PT1000</p><p>电极形式：数字化电极</p><p>通讯接口：ModbusRS485</p><p>存储温度：-15~60℃ </p><p>工作温度：0~65℃（不结冰） </p><p>防护等级：IP68</p><p>线缆长度：标准10m，可延长</p><p>传感器尺寸：151mm*26mm</p><br />\n    ","gallery",[],"features",[],"specificationGroups",[214],{"_165":215,"_216":217},"技术参数","specifications",[218,225,229,233,237,241,245,249,253,257,261,265,269,273,277,281,285,289,293,297],{"_219":220,"_108":221,"_222":223,"_224":-5},"key","measurement-range","量程","value","0~20mg/L 或0~200%饱和度，0~65℃","unit",{"_219":226,"_108":227,"_222":228,"_224":-5},"measurement-principle","测量原理","荧光法",{"_219":230,"_108":231,"_222":232,"_224":-5},"accuracy","测量精度","低于 5 mg/L 时为 ±0.1mg/L",{"_219":234,"_108":235,"_222":236,"_224":-5},"temperature","温度","±0.1°C",{"_219":238,"_108":239,"_222":240,"_224":-5},"response-time","响应时间","20℃时，37 秒达到 95%",{"_219":242,"_108":243,"_222":244,"_224":-5},"repeatability","重复性","±0.1mg/L",{"_219":246,"_108":247,"_222":248,"_224":-5},"resolution","分辨率","0.01mg/L",{"_219":250,"_108":251,"_222":252,"_224":-5},"maximum-pressure","最大压力","23bar @50℃",{"_219":254,"_108":255,"_222":256,"_224":-5},"maximum-flow","最大流速","无流速要求",{"_219":258,"_108":259,"_222":260,"_224":-5},"calibration","校准方式","饱和空气校准，1点样品校准，零点校准，1点温度校准",{"_219":262,"_108":263,"_222":264,"_224":-5},"electrode-body-material","电极主体材质","钛合金",{"_219":266,"_108":267,"_222":268,"_224":-5},"thread","螺纹接口","标准3/4NPT",{"_219":270,"_108":271,"_222":272,"_224":-5},"digital-communication","传感器通讯","MODBUS RS-485; ModbusRS485",{"_219":274,"_108":275,"_222":276,"_224":-5},"temperature-electrode","温度电极","PT1000",{"_219":278,"_108":279,"_222":280,"_224":-5},"electrode-form","电极形式","数字化电极",{"_219":282,"_108":283,"_222":284,"_224":-5},"storage-temperature","存储温度","-15~60℃",{"_219":286,"_108":287,"_222":288,"_224":-5},"operating-temperature","工作温度","0~65℃（不结冰）",{"_219":290,"_108":291,"_222":292,"_224":-5},"protection","防护等级","IP68",{"_219":294,"_108":295,"_222":296,"_224":-5},"cable","线缆长度","标准10m，可延长",{"_219":298,"_108":299,"_222":300,"_224":-5},"sensor-size","传感器尺寸","151mm*26mm","sourceReviews",[],"documents",[],"supportDownloads",[]]
