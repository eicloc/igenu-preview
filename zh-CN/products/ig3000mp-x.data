ts?category=water",{"_108":113,"_110":114},"工业测量","/zh-CN/products?category=industrial",{"_108":116,"_110":117},"气体检测","/zh-CN/products?category=gas",{"_103":119,"_105":120},"了解更多",[121,124,127,130,133],{"_108":122,"_110":123},"关于我们","/zh-CN/about",{"_108":125,"_110":126},"客户案例","/zh-CN/cases",{"_108":128,"_110":129},"新闻中心","/zh-CN/news",{"_108":131,"_110":132},"售后服务","/zh-CN/service",{"_108":134,"_110":135},"下载中心","/zh-CN/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig3000mp-x",[],[],"seo",{"_103":146,"_147":148,"_149":150,"_151":152},"IG3000MP-X 水质多参数分析仪 | IGENU SCIENCE","description","通过可选数字探头组合监测pH、溶解氧、电导率、浊度等水质参数。探头采用防水连接并保存校准数据，便于现场更换；配备自动清洁装置，减少表面附着物。","imageUrl","/igenu-preview/media/9a9243397faa84f675ead5a8.jpg","index",true,"canonical","https://eicloc.github.io/igenu-preview/zh-CN/products/ig3000mp-x","query",{},"selected",[],"detail",{"_161":162,"_57":141,"_163":164,"_165":166,"_167":148,"_168":169,"_170":171,"_175":176,"_201":202,"_203":204,"_147":-5,"_205":206,"_207":208,"_209":210,"_211":212,"_250":251,"_252":253,"_254":255,"_144":145},"id","27f7a7c7-2e6f-4394-8a3b-e1d66ae51c83","model","IG3000MP-X","name","IG3000MP-X 水质多参数分析仪","shortDescription","featured",false,"category",{"_57":172,"_173":-5,"_165":109,"_147":-5,"_144":174},"water","brand",{"_103":109,"_147":-5,"_149":-5,"_151":152},"heroImage",{"_161":177,"_140":178,"_179":180,"_181":182,"_183":184,"_185":186,"_187":188,"_189":188,"_190":150,"_191":192,"_193":194},"d6d649eb-90c0-469f-9bfb-1c613153f689","IMAGE","originalName","2025040861670749.jpg","mimeType","image/jpeg","size",19258,"sha256","9a9243397faa84f675ead5a8a5216895cf7e15c9b82d390083269947f0d00581","width",540,"height","url","createdAt","2026-10-20T17:32:39.812Z","variants",[195,199],{"_187":196,"_189":196,"_181":197,"_190":198},320,"image/webp","/igenu-preview/media/32f08ba6aa513832d0c6c644.webp",{"_187":188,"_189":188,"_181":197,"_190":200},"/igenu-preview/media/61f38d89920b71a6040fa537.webp","detailLayout","STRUCTURED","availableLocales",[11,20,17],"bodyHtml","<p><strong><span>产品特点：</span></strong></p><p>◆数字传感器，RS485 输出，支持MODBUS </p><p>◆所有校准参数存储在传感器内，每支探头带有防水接头， 可方便插拔替换</p><p>◆配备自动清洁装置，可以有效的清除传感器表面沾污，防止微生物的生长，更准确，更低维护</p><p>◆可选择溶解氧、电导率、浊度、pH、ORP、叶绿素、蓝绿藻、 水中油等传感器，适合长期在线监测</p><p>◆多合一结构设计，可以同时接 7 个探头，测量 8 个参数</p><p><strong> </strong></p><p><strong><span>应用领域：</span></strong></p><p>环境监测 、饮用及地表水监测、工业废水、污水 、生活废水、污水 、地下水、湖泊水</p><p> </p><p><strong><span>技术参数：</span></strong></p><table> <tbody><tr>  <td><p>测量参数</p></td>  <td><p>PH</p></td>  <td><p>ORP</p></td>  <td><p>电导率</p></td>  <td><p>溶解氧</p></td>  <td><p>浊度</p></td>  <td><p>叶绿素</p></td>  <td><p>蓝藻</p></td>  <td><p>温度</p></td> </tr> <tr>  <td><p>量程</p></td>  <td><p>0-14pH</p></td>  <td><p>±1999mV</p></td>  <td><p>0-20us/cm；  0-200us/cm; 0-2000us/cm; 0-10ms/cm</p>  <p> </p></td>  <td><p>0~20mg/L</p></td>  <td><p>0~1000NTU</p></td>  <td><p>0-1000ppb </p>  <p> </p></td>  <td><p>0~200,000 cells/mL </p>  <p> </p></td>  <td><p>-5-105℃</p></td> </tr> <tr>  <td><p>准确度</p></td>  <td><p>± 0.01 pH</p></td>  <td><p>±0. 1 mV</p></td>  <td><p>±1%读数</p></td>  <td><p>低于 5 mg/L 时为 ±0.1  mg/L</p>  <p>高于 5 mg/L 时为 ±0.2 mg/L</p>  <p> </p></td>  <td><p>读数的±1%或±0.1NTU，取大者</p></td>  <td><p>读数的±3%或0.1ppb</p></td>  <td><p>读数的±3%</p></td>  <td><p>±0.1℃</p></td> </tr> <tr>  <td><p>分辨率</p></td>  <td><p>0.01 pH</p></td>  <td><p>0. 1 mV</p></td>  <td><p>±1%读数</p></td>  <td><p>0.01mg/L</p></td>  <td><p>0.001NTU</p></td>  <td><p>0.1ppb</p></td>  <td><p>1 cells/mL</p></td>  <td><p>0.1℃</p></td> </tr> <tr>  <td><p>重复性</p></td>  <td><p>0.01 pH</p></td>  <td><p>0. 1 mV</p></td>  <td><p>±1%读数</p></td>  <td><p>±0.1mg/L</p></td>  <td><p>±1%</p></td>  <td><p>±3%</p></td>  <td><p>±3%</p></td>  <td><p>0.1℃</p></td> </tr> <tr>  <td><p>响应时间</p></td>  <td><p>30S,T95</p></td>  <td><p>30S,T95</p></td>  <td><p>30S,T90</p></td>  <td><p>37S,T95</p></td>  <td><p>5S,T90</p></td>  <td><p>30S,T90</p></td>  <td><p>30S,T90</p></td>  <td><p>15S,T90</p></td> </tr> <tr>  <td><p>防护等级</p></td>  <td><p>IP68</p></td>  <td><p>IP68</p></td>  <td><p>IP68</p></td>  <td><p>IP68</p></td>  <td><p>IP68</p></td>  <td><p>IP68</p></td>  <td><p>IP68</p></td>  <td><p>IP68</p></td> </tr> <tr>  <td><p>主体材质</p></td>  <td><p>PEEK、Ryton</p></td>  <td><p>PEEK、Ryton</p></td>  <td><p>PEEK、Ryton</p></td>  <td><p>钛合金</p></td>  <td><p>316L</p></td>  <td><p>316L</p></td>  <td><p>316L</p></td>  <td><p>PT1000</p></td> </tr></tbody></table><br />\n    ","gallery",[],"features",[],"specificationGroups",[213],{"_165":214,"_215":216},"技术参数","specifications",[217,222,226,230,234,238,242,246],{"_218":64,"_108":68,"_219":220,"_221":-5},"key","value","PH | ORP | 电导率 | 溶解氧 | 浊度 | 叶绿素 | 蓝藻 | 温度","unit",{"_218":223,"_108":224,"_219":225,"_221":-5},"measurement-range","量程","0-14pH | ±1999mV | 0-20us/cm； 0-200us/cm; 0-2000us/cm; 0-10ms/cm | 0~20mg/L | 0~1000NTU | 0-1000ppb | 0~200,000 cells/mL | -5-105℃",{"_218":227,"_108":228,"_219":229,"_221":-5},"accuracy","准确度","± 0.01 pH | ±0. 1 mV | ±1%读数 | 低于 5 mg/L 时为 ±0.1 mg/L\n高于 5 mg/L 时为 ±0.2 mg/L | 读数的±1%或±0.1NTU，取大者 | 读数的±3%或0.1ppb | 读数的±3% | ±0.1℃",{"_218":231,"_108":232,"_219":233,"_221":-5},"resolution","分辨率","0.01 pH | 0. 1 mV | ±1%读数 | 0.01mg/L | 0.001NTU | 0.1ppb | 1 cells/mL | 0.1℃",{"_218":235,"_108":236,"_219":237,"_221":-5},"repeatability","重复性","0.01 pH | 0. 1 mV | ±1%读数 | ±0.1mg/L | ±1% | ±3% | ±3% | 0.1℃",{"_218":239,"_108":240,"_219":241,"_221":-5},"response-time","响应时间","30S,T95 | 30S,T95 | 30S,T90 | 37S,T95 | 5S,T90 | 30S,T90 | 30S,T90 | 15S,T90",{"_218":243,"_108":244,"_219":245,"_221":-5},"protection","防护等级","IP68 | IP68 | IP68 | IP68 | IP68 | IP68 | IP68 | IP68",{"_218":247,"_108":248,"_219":249,"_221":-5},"material","主体材质","PEEK、Ryton | PEEK、Ryton | PEEK、Ryton | 钛合金 | 316L | 316L | 316L | PT1000","sourceReviews",[],"documents",[],"supportDownloads",[]]
