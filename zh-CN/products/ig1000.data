ts?category=water",{"_108":113,"_110":114},"工业测量","/zh-CN/products?category=industrial",{"_108":116,"_110":117},"气体检测","/zh-CN/products?category=gas",{"_103":119,"_105":120},"了解更多",[121,124,127,130,133],{"_108":122,"_110":123},"关于我们","/zh-CN/about",{"_108":125,"_110":126},"客户案例","/zh-CN/cases",{"_108":128,"_110":129},"新闻中心","/zh-CN/news",{"_108":131,"_110":132},"售后服务","/zh-CN/service",{"_108":134,"_110":135},"下载中心","/zh-CN/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig1000",[],[],"seo",{"_103":146,"_147":148,"_149":150,"_151":152},"IG1000 电磁流量计 | IGENU SCIENCE","description","采用电磁感应原理测量导电液体流量，可用于水、污水及泥浆等介质。提供管道安装与信号输出，电极、衬里及连接形式需结合实际介质和工况选配。","imageUrl","/igenu-preview/media/2a75c1e35c4f5d26d0d45a78.jpg","index",true,"canonical","https://eicloc.github.io/igenu-preview/zh-CN/products/ig1000","query",{},"selected",[],"detail",{"_161":162,"_57":141,"_163":164,"_165":166,"_167":148,"_168":169,"_170":171,"_175":176,"_207":208,"_209":210,"_147":-5,"_211":212,"_213":214,"_215":216,"_217":218,"_317":318,"_365":366,"_367":368,"_144":145},"id","718efa0b-619e-43bd-aa4d-e57bc33e3a82","model","IG1000","name","IG1000 电磁流量计","shortDescription","featured",false,"category",{"_57":172,"_173":-5,"_165":113,"_147":-5,"_144":174},"industrial","brand",{"_103":113,"_147":-5,"_149":-5,"_151":152},"heroImage",{"_161":177,"_140":178,"_179":180,"_181":182,"_183":184,"_185":186,"_187":188,"_189":190,"_191":150,"_192":193,"_194":195},"ae088e5b-dee3-4d64-a813-8aea3d5faa40","IMAGE","originalName","2018040280914617.jpg","mimeType","image/jpeg","size",79233,"sha256","2a75c1e35c4f5d26d0d45a78e4afd1e32e7fc5846f14595ed04ad41691e1ba5a","width",775,"height",522,"url","createdAt","2026-10-20T17:32:39.599Z","variants",[196,201,205],{"_187":197,"_189":198,"_181":199,"_191":200},320,216,"image/webp","/igenu-preview/media/b9d84e037e2e93e539dbc230.webp",{"_187":202,"_189":203,"_181":199,"_191":204},640,431,"/igenu-preview/media/34a2de4913f859e3b5fd7093.webp",{"_187":188,"_189":190,"_181":199,"_191":206},"/igenu-preview/media/f7cba31a9a75d0b97c8bfde5.webp","detailLayout","STRUCTURED","availableLocales",[11,20,17],"bodyHtml","<p></p><p><strong><span>技术参数：</span></strong></p><p>结构形式：分体式、一体式</p><p>安装方式：管段法兰式</p><p>介质电导率：电导率大于 5µs/cm （软化水为20 uS/cm）</p><p>准确度等级： 标准±0.5 %，可选±0.2%</p><p>过程连接：法兰（碳钢），法兰（1.4571[316Ti]）</p><p>电极材质：含钼不锈钢、哈氏合金 B、哈氏合金 C、钛、铂 / 铱合金、 钽、碳化钨</p><p>衬里材质：氯丁橡胶、聚四氟乙烯、聚全氟乙丙烯、聚氨酯橡胶</p><p>输出信号：4 ~ 20mA有源隔离</p><p>脉冲输出：无源、有源、频率、脉宽可调</p><p>通讯：RS485，可选 HART 通讯协议、MODBUS 协议、 RS232 协议</p><p>供电电源： 85-253 VAC/16.8-26.4VAC/16.8-31.2 VDC</p><p>防护等级：IP67（特殊订货 IP68）</p><p>环境温度：-20℃ ~+60℃</p><p>介质温度：-25 ~ +180°C</p><p>防爆设计：TÜV 97， ATEX1173X</p><p>压力设备指令97/23/EG：致性评估符合Category III， Fluid Group 1</p><p>介质流速： 0.3-12.0m/s 范围内</p><p>累加器复位：光电耦合器输入</p><p>正/反向测量：光电耦合器输出信号</p><p>空管检测器：从DN10 ：3/8”开始，光电耦合器输出信号</p><p>自监控功能：有</p><p>现场显示/累加功能：有</p><p>外壳：铝制转换器外壳（标准），不锈钢转换器（选配）</p><br /><br />\n    ","gallery",[],"features",[],"specificationGroups",[219],{"_165":220,"_221":222},"技术参数","specifications",[223,230,234,238,242,246,250,254,258,262,266,270,274,278,282,286,290,294,298,302,306,310,313],{"_224":225,"_108":226,"_227":228,"_229":-5},"key","accuracy","准确度等级","value","标准±0.5 %，可选±0.2%","unit",{"_224":231,"_108":232,"_227":233,"_229":-5},"process-connection","过程连接","法兰（碳钢），法兰（1.4571[316Ti]）",{"_224":235,"_108":236,"_227":237,"_229":-5},"lining","衬里材质","氯丁橡胶、聚四氟乙烯、聚全氟乙丙烯、聚氨酯橡胶",{"_224":239,"_108":240,"_227":241,"_229":-5},"conductivity","介质电导率","电导率大于 5µs/cm （软化水为20 uS/cm）",{"_224":243,"_108":244,"_227":245,"_229":-5},"electrode-material","电极材质","含钼不锈钢、哈氏合金 B、哈氏合金 C、钛、铂 / 铱合金、 钽、碳化钨",{"_224":247,"_108":248,"_227":249,"_229":-5},"protection","防护等级","IP67（特殊订货 IP68）",{"_224":251,"_108":252,"_227":253,"_229":-5},"explosion-design","防爆设计","TÜV 97， ATEX1173X",{"_224":255,"_108":256,"_227":257,"_229":-5},"power-supply","供电电源","85-253 VAC/16.8-26.4VAC/16.8-31.2 VDC",{"_224":259,"_108":260,"_227":261,"_229":-5},"pulse-output","脉冲输出","无源、有源、频率、脉宽可调",{"_224":263,"_108":2