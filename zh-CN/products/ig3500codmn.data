[{"_1":2,"_7":8},"root",{"_3":4},"data",{"_5":6},"productView","grid","content",{"_3":9},{"_10":11,"_12":13,"_14":15,"_140":58,"_57":141,"_64":142,"_70":143,"_144":145,"_153":154,"_155":156,"_157":158,"_159":160},"locale","zh-CN","origin","https://eicloc.github.io","settings",{"_16":17,"_18":19,"_21":22,"_23":24,"_54":55,"_86":87,"_88":89,"_26":27,"_28":29,"_37":-5,"_90":91,"_92":-5,"_93":94,"_95":96,"_97":98,"_99":-5,"_100":101,"_136":-5,"_137":-5,"_138":139},"defaultLocale","en","enabledLocales",[17,11,20],"de","logoUrl","/igenu-preview/media/f607ce2a51366ba8778f1000.jpg","regionalContacts",[25,39,47],{"_26":27,"_28":29,"_30":31,"_35":36,"_37":38},"email","Germany@igenu.com","phone","0049-935890-024","labels",{"_20":32,"_17":33,"_11":34},"Deutschland","Germany","德国","region","GERMANY","address","",{"_26":40,"_28":41,"_30":42,"_35":46,"_37":38},"cn@igenu.com","400-002-1266",{"_20":43,"_17":44,"_11":45},"Servicezentrum China","China service center","中国服务中心","CHINA",{"_26":48,"_28":38,"_30":49,"_35":53,"_37":38},"info@igenu-germany.com",{"_20":50,"_17":51,"_11":52},"Internationale Anfragen","International enquiries","国际业务咨询","INTERNATIONAL","navigation",[56,63,69,75,81],{"_57":58,"_30":59},"slug","products",{"_20":60,"_17":61,"_11":62},"Instrumente","Instruments","产品中心",{"_57":64,"_30":65},"parameters",{"_20":66,"_17":67,"_11":68},"Messparameter","Parameters","测量参数",{"_57":70,"_30":71},"applications",{"_20":72,"_17":73,"_11":74},"Anwendungen","Applications","应用方案",{"_57":76,"_30":77},"about",{"_20":78,"_17":79,"_11":80},"Über IGENU","About IGENU","关于 IGENU",{"_57":82,"_30":83},"service",{"_20":84,"_17":84,"_11":85},"Support","服务支持","companyName","IGENU SCIENCE","tagline","洞察环境，明晰工业。","footer","从水质分析、工业过程到气体检测，以测量仪器连接每一项工况需求。","copyright","primaryCta","联系专家","primaryCtaUrl","/contact","socialLinks",{},"defaultSeoImageUrl","footerNavigation",[102,118],{"_103":104,"_105":106},"title","产品","links",[107,112,115],{"_108":109,"_110":111},"label","水质分析","href","/zh-CN/products?category=water",{"_108":113,"_110":114},"工业测量","/zh-CN/products?category=industrial",{"_108":116,"_110":117},"气体检测","/zh-CN/products?category=gas",{"_103":119,"_105":120},"了解更多",[121,124,127,130,133],{"_108":122,"_110":123},"关于我们","/zh-CN/about",{"_108":125,"_110":126},"客户案例","/zh-CN/cases",{"_108":128,"_110":129},"新闻中心","/zh-CN/news",{"_108":131,"_110":132},"售后服务","/zh-CN/service",{"_108":134,"_110":135},"下载中心","/zh-CN/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig3500codmn",[],[],"seo",{"_103":146,"_147":148,"_149":150,"_151":152},"IG3500CODmn 高锰酸盐指数分析仪 | IGENU SCIENCE","description","采用高锰酸钾氧化与滴定法测定水中高锰酸盐指数。提供自动量程切换、质控核查和运行日志，结合报警功能及信号接口，便于接入在线监测系统。","imageUrl","/igenu-preview/media/076a24550dfec7d99b95ba88.png","index",true,"canonical","https://eicloc.github.io/igenu-preview/zh-CN/products/ig3500codmn","query",{},"selected",[],"detail",{"_161":162,"_57":141,"_163":164,"_165":166,"_167":148,"_168":169,"_170":171,"_175":176,"_199":200,"_201":202,"_147":-5,"_203":204,"_205":206,"_207":208,"_209":210,"_284":285,"_286":287,"_288":289,"_144":145},"id","879c4612-34a5-41ef-a5f2-419989ad469e","model","IG3500CODMN","name","IG3500CODmn 高锰酸盐指数分析仪","shortDescription","featured",false,"category",{"_57":172,"_173":-5,"_165":109,"_147":-5,"_144":174},"water","brand",{"_103":109,"_147":-5,"_149":-5,"_151":152},"heroImage",{"_161":177,"_140":178,"_179":180,"_181":182,"_183":184,"_185":186,"_187":188,"_189":190,"_191":150,"_192":193,"_194":195},"bfda7f5e-e504-4c40-85f0-1afea6d4aba3","IMAGE","originalName","2025040938476253.jpg","mimeType","image/png","size",51146,"sha256","076a24550dfec7d99b95ba8827dbead49c4506dc3d55d9d8b47b0c95d2a2c36e","width",267,"height",435,"url","createdAt","2026-10-20T17:32:39.824Z","variants",[196],{"_187":188,"_189":190,"_181":197,"_191":198},"image/webp","/igenu-preview/media/f3d468788765b050ceafe139.webp","detailLayout","STRUCTURED","availableLocales",[20,11,17],"bodyHtml","<p><strong><span>产品特点：</span></strong></p><p>◆高量程测低浓度:采用环取样，减少稀释次数，重复性更好。新验收标准要求仪器量程是排放标准的2~3倍，而实际排放的水样浓度很低，针对这种高量程测低浓度的情况，优势特别明显</p><p>◆创新的计量方法(专利) (1)具有抗浊度干扰自动补偿功能，当采集浑浊水样时不会计量误判(2)具有气泡消除功能，对有气泡产生的废水效果明显，如光伏厂、印染厂等有气泡产生的污水</p><p>◆量程自动切换功能:任意选择一个低量程和一个高量程组合，仪器自动根据实际水样浓度切换至最佳量程</p><p>◆多种质控功能:零点/跨度/标样核查、空白测试、预留平行样和加标回收接口 </p><p>◆多种测量模式，关键参数显示，运行、核查、校准日志，上下限预警</p><p>◆上电自检、自动复位、缺液报警、断电保护、废液分离</p><p>◆支持2路RS232/485、2路4-20mA通信接口，支持打印机实时数据打印</p><p>◆(选配)云监测功能:手机实时监控仪器状态，远程报警、远程障故诊断 </p><p>◆(选配)试剂冷藏:配备试剂冷藏箱，延长试剂质保期</p><p><strong> </strong></p><p><strong><span>应用领域：</span></strong></p><p>地表水 、地下水 、自来水 、饮用水、海水</p><p><strong> </strong></p><p><strong><span>技术参数：</span></strong></p><p>检测量程： (0~20/100 ) mg/L </p><p>测量原理：高锰酸钾氧化—滴定法 </p><p>准确度：±5% </p><p>重复性：≤2% </p><p>零点漂移：±5% </p><p>量程漂移：±5% </p><p>数据存储：≥48000条 </p><p>环境要求：温度+5~28°C :湿度&lt;90%</p><p>测量周期：30~50min </p><p>MTBF:≥720h/次 </p><p>通讯接口：4-20mA、RS232、RS485 </p><p>绝缘阻抗：2MΩ以上 </p><p>电源：AC ( 220+20 ) V ( 50+0.5 ) Hz ，5A </p><p>功耗：150W </p><p>定量下限：0.2mg/L </p><p>最低检出限：0.04mg/L </p><p>尺寸：500mm*445mm*1355mm</p><br />\n    ","gallery",[],"features",[],"specificationGroups",[211],{"_165":212,"_213":214},"技术参数","specifications",[215,222,226,230,234,237,240,244,248,252,256,260,264,268,272,276,280],{"_216":217,"_108":218,"_219":220,"_221":-5},"key","measurement-range","检测量程","value","(0~20/100 ) mg/L","unit",{"_216":223,"_108":224,"_219":225,"_221":-5},"measurement-principle","测量原理","高锰酸钾氧化—滴定法",{"_216":227,"_108":228,"_219":229,"_221":-5},"accuracy","准确度","±5%",{"_216":231,"_108":232,"_219":233,"_221":-5},"repeatability","重复性","≤2%",{"_216":235,"_108":236,"_219":229,"_221":-5},"zero-drift","零点漂移",{"_216":238,"_108":239,"_219":229,"_221":-5},"range-drift","量程漂移",{"_216":241,"_108":242,"_219":243,"_221":-5},"data-storage","数据存储","≥48000条",{"_216":245,"_108":246,"_219":247,"_221":-5},"environment-requirements","环境要求","温度+5~28°C :湿度<90%",{"_216":249,"_108":250,"_219":251,"_221":-5},"measurement-cycle","测量周期","30~50min",{"_216":253,"_108":254,"_219":255,"_221":-5},"mtbf","MTBF","≥720h/次",{"_216":257,"_108":258,"_219":259,"_221":-5},"digital-communication","通讯接口","4-20mA、RS232、RS485",{"_216":261,"_108":262,"_219":263,"_221":-5},"insulation","绝缘阻抗","2MΩ以上",{"_216":265,"_108":266,"_219":267,"_221":-5},"power-supply","电源","AC ( 220+20 ) V ( 50+0.5 ) Hz ，5A",{"_216":269,"_108":270,"_219":271,"_221":-5},"power-consumption","功耗","150W",{"_216":273,"_108":274,"_219":275,"_221":-5},"quantitative-limit","定量下限","0.2mg/L",{"_216":277,"_108":278,"_219":279,"_221":-5},"detection-limit","最低检出限","0.04mg/L",{"_216":281,"_108":282,"_219":283,"_221":-5},"dimensions","尺寸","500mm*445mm*1355mm","sourceReviews",[],"documents",[],"supportDownloads",[]]
