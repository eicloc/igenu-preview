ts?category=water",{"_108":113,"_110":114},"工业测量","/zh-CN/products?category=industrial",{"_108":116,"_110":117},"气体检测","/zh-CN/products?category=gas",{"_103":119,"_105":120},"了解更多",[121,124,127,130,133],{"_108":122,"_110":123},"关于我们","/zh-CN/about",{"_108":125,"_110":126},"客户案例","/zh-CN/cases",{"_108":128,"_110":129},"新闻中心","/zh-CN/news",{"_108":131,"_110":132},"售后服务","/zh-CN/service",{"_108":134,"_110":135},"下载中心","/zh-CN/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig3254cod",[],[],"seo",{"_103":146,"_147":148,"_149":150,"_151":152},"IG3254COD 紫外法COD与TOC传感器 | IGENU SCIENCE","description","采用紫外吸收原理在线监测COD与TOC，无需投加测量试剂。数字探头结合浊度补偿、多种校准方式及可选自动清洁装置，测量结果需按所选校准方法解读。","imageUrl","/igenu-preview/media/e3e2c21db606165f614650cf.jpg","index",true,"canonical","https://eicloc.github.io/igenu-preview/zh-CN/products/ig3254cod","query",{},"selected",[],"detail",{"_161":162,"_57":141,"_163":164,"_165":166,"_167":148,"_168":169,"_170":171,"_175":176,"_201":202,"_203":204,"_147":-5,"_205":206,"_207":208,"_209":210,"_211":212,"_296":297,"_298":299,"_300":301,"_144":145},"id","dfbb0b65-0921-4d76-820c-bc18ebd08c71","model","IG3254COD","name","IG3254COD 紫外法COD与TOC传感器","shortDescription","featured",false,"category",{"_57":172,"_173":-5,"_165":109,"_147":-5,"_144":174},"water","brand",{"_103":109,"_147":-5,"_149":-5,"_151":152},"heroImage",{"_161":177,"_140":178,"_179":180,"_181":182,"_183":184,"_185":186,"_187":188,"_189":188,"_190":150,"_191":192,"_193":194},"79d9f104-d914-4e36-bec2-d6d2b843fefd","IMAGE","originalName","2025041051182309.jpg","mimeType","image/jpeg","size",14215,"sha256","e3e2c21db606165f614650cf931244737a0e84793f3dd9ab8bd834db8aa5b8b3","width",540,"height","url","createdAt","2026-10-20T17:32:39.888Z","variants",[195,199],{"_187":196,"_189":196,"_181":197,"_190":198},320,"image/webp","/igenu-preview/media/087409fcbd7eefe1aec06c53.webp",{"_187":188,"_189":188,"_181":197,"_190":200},"/igenu-preview/media/6d889354b11ab94fb489a773.webp","detailLayout","STRUCTURED","availableLocales",[11,20,17],"bodyHtml","<p><strong><span>产品特点：</span></strong></p><p>◆数字传感器，485输出，支持ModbusRTU </p><p>◆无需试剂，无污染，更经济环保 </p><p>◆可选择自动清洁装置，可以有效的清除传感器表面沾污， 防止微生物的生长，更准确更低维护</p><p>◆可测量SAC、COD、TOC、浊度、温度等参数 </p><p>◆自动对浊度、悬浮物干扰进行补偿，具有极佳的测试性能</p><p><strong> </strong></p><p><strong><span>应用领域：</span></strong></p><p>市政污水 、工业废水、环境监测、饮用及地表水监测 、工业过程 、水产养殖、生物过程</p><p><strong> </strong></p><p><strong><span>技术参数：</span></strong></p><p>量程：COD（使用 KHP 进行标定）：0~500mg/L，0-1500 mg/L COD </p><p>TOC（使用 KHP 进行标定）： 0~180mg/L TOC ，0~600 mg/L TOC</p><p>测量原理：254nm 紫外吸收光谱</p><p>光源：闪烁氙灯 </p><p>光程：2.5mm、6.5mm </p><p>测量精度： 读数的± 5%</p><p>重复性：小于±5% </p><p>检测限：0.1 mg/L</p><p>测量间隔：15s、30s、1min、30min</p><p>校准方式：单点样品校准、多点标液校准、斜率校准 </p><p>传感器材质：机身：SUS316L；视窗：蓝宝石</p><p>自清洗：自动刮刷</p><p>交叉灵敏度补偿：浊度</p><p>传感器通讯：MODBUS RS-485 </p><p>存储温度：-10~50℃ </p><p>工作温度：0~50℃（不结冰） </p><p>防护等级：IP68 </p><p>线缆长度：标准10m，可延长</p><p>传感器尺寸： 179mm*50mm</p><br />\n    ","gallery",[],"features",[],"specificationGroups",[213],{"_165":214,"_215":216},"技术参数","specifications",[217,224,228,232,236,240,244,248,252,256,260,264,268,272,276,280,284,288,292],{"_218":219,"_108":220,"_221":222,"_223":-5},"key","measurement-range","量程","value","COD（使用 KHP 进行标定）：0~500mg/L，0-1500 mg/L COD","unit",{"_218":225,"_108":226,"_221":227,"_223":-5},"toc","TOC（使用 KHP 进行标定）","0~180mg/L TOC ，0~600 mg/L TOC",{"_218":229,"_108":230,"_221":231,"_223":-5},"measurement-principle","测量原理","254nm 紫外吸收光谱",{"_218":233,"_108":234,"_221":235,"_223":-5},"light-source","光源","闪烁氙灯",{"_218":237,"_108":238,"_221":239,"_223":-5},"optical-path","光程","2.5mm、6.5mm",{"_218":241,"_108":242,"_221":243,"_223":-5},"accuracy","测量精度","读数的± 5%",{"_218":245,"_108":246,"_221":247,"_223":-5},"repeatability","重复性","小于±5%",{"_218":249,"_108":250,"_221":251,"_223":-5},"detection-limit","检测限","0.1 mg/L",{"_218":253,"_108":254,"_221":255,"_223":-5},"measurement-interval","测量间隔","15s、30s、1min、30min",{"_218":257,"_108":258,"_221":259,"_223":-5},"calibration","校准方式","单点样品校准、多点标液校准、斜率校准",{"_218":261,"_108":262,"_221":263,"_223":-5},"sensor-material","传感器材质","机身：SUS316L；视窗：蓝宝石",{"_218":265,"_108":266,"_221":267,"_223":-5},"self-cleaning","自清洗","自动刮刷",{"_218":269,"_108":270,"_221":271,"_223":-5},"cross-sensitivity-compensation","交叉灵敏度补偿","浊度",{"_218":273,"_108":274,"_221":275,"_223":-5},"digital-communication","传感器通讯","MODBUS RS-485",{"_218":277,"_108":278,"_221":279,"_223":-5},"storage-temperature","存储温度","-10~50℃",{"_218":281,"_108":282,"_221":283,"_223":-5},"operating-temperature","工作温度","0~50℃（不结冰）",{"_218":285,"_108":286,"_221":287,"_223":-5},"protection","防护等级","IP68",{"_218":289,"_108":290,"_221":291,"_223":-5},"cable","线缆长度","标准10m，可延长",{"_218":293,"_108":294,"_221":295,"_223":-5},"sensor-size","传感器尺寸","179mm*50mm","sourceReviews",[],"documents",[],"supportDownloads",[]]
