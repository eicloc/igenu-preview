ts?category=water",{"_108":113,"_110":114},"工业测量","/zh-CN/products?category=industrial",{"_108":116,"_110":117},"气体检测","/zh-CN/products?category=gas",{"_103":119,"_105":120},"了解更多",[121,124,127,130,133],{"_108":122,"_110":123},"关于我们","/zh-CN/about",{"_108":125,"_110":126},"客户案例","/zh-CN/cases",{"_108":128,"_110":129},"新闻中心","/zh-CN/news",{"_108":131,"_110":132},"售后服务","/zh-CN/service",{"_108":134,"_110":135},"下载中心","/zh-CN/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig3500",[],[],"seo",{"_103":146,"_147":148,"_149":150,"_151":152},"IG3500 余氯分析仪 | IGENU SCIENCE","description","采用DPD比色法监测水中余氯，面向供水及工业过程。结合光学干扰补偿、自动清洗与数据存储，提供继电器控制输出，并可选远传模块接入监测系统。","imageUrl","/igenu-preview/media/8851b0c528aa8f3f11bac4d5.png","index",true,"canonical","https://eicloc.github.io/igenu-preview/zh-CN/products/ig3500","query",{},"selected",[],"detail",{"_161":162,"_57":141,"_163":164,"_165":166,"_167":148,"_168":169,"_170":171,"_175":176,"_203":204,"_205":206,"_147":-5,"_207":208,"_209":210,"_211":212,"_213":214,"_309":310,"_311":312,"_313":314,"_144":145},"id","caa08499-feb7-4ba5-a00f-5383e3318a7b","model","IG3500","name","IG3500 余氯分析仪","shortDescription","featured",false,"category",{"_57":172,"_173":-5,"_165":109,"_147":-5,"_144":174},"water","brand",{"_103":109,"_147":-5,"_149":-5,"_151":152},"heroImage",{"_161":177,"_140":178,"_179":180,"_181":182,"_183":184,"_185":186,"_187":188,"_189":190,"_191":150,"_192":193,"_194":195},"c50c4c9d-55bb-4423-8c3e-781ffff460bb","IMAGE","originalName","2025040937453857.jpg","mimeType","image/png","size",161037,"sha256","8851b0c528aa8f3f11bac4d54c4a5ffd8e6ba0b79e7a6a527d4c31805dbb2c25","width",439,"height",577,"url","createdAt","2026-10-20T17:32:39.818Z","variants",[196,201],{"_187":197,"_189":198,"_181":199,"_191":200},320,421,"image/webp","/igenu-preview/media/a94dedbc4c305ed00e17532e.webp",{"_187":188,"_189":190,"_181":199,"_191":202},"/igenu-preview/media/addc2737c9f6397359f3a546.webp","detailLayout","STRUCTURED","availableLocales",[20,11,17],"bodyHtml","<p><strong><span>产品特点：</span></strong></p><p>◆DPD标准比色法 </p><p>◆长光程光路结构，不易污染，吸光度检测分辨率可大于0.001Abs </p><p>◆双光速技术，自动对浊度、色度、气泡干扰补偿 </p><p>◆独特的流体结构，维护要求低 </p><p>◆继电器输出，可锁定加氯泵，实现自动加氯 </p><p>◆可选配4G远传模块，数据无线上传</p><p>◆自带存储功能，方便查看记录</p><p><strong> </strong></p><p><strong><span>应用领域：</span></strong></p><p>市政自来水 、管网监测 、食品饮料 、饮用及地表水监测、工业过程</p><p><strong> </strong></p><p><strong><span>技术参数：</span></strong></p><p>量程：0~10mg/L </p><p>测量原理：DPD比色法 </p><p>测量精度：测量值的±1%或0.01mg/L，取大值 </p><p>检测下限：0.01mg/L </p><p>测量模式：连续测量，周期测量（测量间隔可调）</p><p>显示： 70mm×48 mm 液晶显示 </p><p>校准：默认校正曲线 </p><p>试剂余量报警：有 </p><p>数据存储：历史记录 </p><p>自动清洗功能：有 </p><p>试剂更换周期：1个月（以5分钟测量计）</p><p>通讯：RS485MODBUS </p><p>输出：4-20mA </p><p>继电器：2路，可设置报警 </p><p>电源：220-230VAC，50/60Hz</p><p>样品流速：250-500mL/min </p><p>样品进口压力：0.1~5bar </p><p>样品温度：5~45℃ </p><p>工作环境：5-95%，不凝结 </p><p>仪器尺寸：350mm*186mm*460mm(长*宽*高）</p><p>重量：9kg </p><p>安装方式：壁挂</p><br />\n    ","gallery",[],"features",[],"specificationGroups",[215],{"_165":216,"_217":218},"技术参数","specifications",[219,226,230,234,238,242,246,250,254,258,261,265,269,273,277,281,285,289,293,297,301,305],{"_220":221,"_108":222,"_223":224,"_225":-5},"key","measurement-range","量程","value","0~10mg/L","unit",{"_220":227,"_108":228,"_223":229,"_225":-5},"measurement-principle","测量原理","DPD比色法",{"_220":231,"_108":232,"_223":233,"_225":-5},"accuracy","测量精度","测量值的±1%或0.01mg/L，取大值",{"_220":235,"_108":236,"_223":237,"_225":-5},"detection-limit","检测下限","0.01mg/L",{"_220":239,"_108":240,"_223":241,"_225":-5},"measurement-mode","测量模式","连续测量，周期测量（测量间隔可调）",{"_220":243,"_108":244,"_223":245,"_225":-5},"display","显示","70mm×48 mm 液晶显示",{"_220":247,"_108":248,"_223":249,"_225":-5},"calibration","校准","默认校正曲线",{"_220":251,"_108":252,"_223":253,"_225":-5},"reagent-alarm","试剂余量报警","有",{"_220":255,"_108":256,"_223":257,"_225":-5},"data-storage","数据存储","历史记录",{"_220":259,"_108":260,"_223":253,"_225":-5},"automatic-cleaning","自动清洗功能",{"_220":262,"_108":263,"_223":264,"_225":-5},"reagent-replacement","试剂更换周期","1个月（以5分钟测量计）",{"_220":266,"_108":267,"_223":268,"_225":-5},"digital-communication","通讯","RS485MODBUS",{"_220":270,"_108":271,"_223":272,"_225":-5},"output","输出","4-20mA",{"_220":274,"_108":275,"_223":276,"_225":-5},"relay","继电器","2路，可设置报警",{"_220":278,"_108":279,"_223":280,"_225":-5},"power-supply","电源","220-230VAC，50/60Hz",{"_220":282,"_108":283,"_223":284,"_225":-5},"sample-flow","样品流速","250-500mL/min",{"_220":286,"_108":287,"_223":288,"_225":-5},"sample-pressure","样品进口压力","0.1~5bar",{"_220":290,"_108":291,"_223":292,"_225":-5},"sample-temperature","样品温度","5~45℃",{"_220":294,"_108":295,"_223":296,"_225":-5},"operating-temperature","工作环境","5-95%，不凝结",{"_220":298,"_108":299,"_223":300,"_225":-5},"instrument-size","仪器尺寸","350mm*186mm*460mm(长*宽*高）",{"_220":302,"_108":303,"_223":304,"_225":-5},"weight","重量","9kg",{"_220":306,"_108":307,"_223":308,"_225":-5},"installation","安装方式","壁挂","sourceReviews",[],"documents",[],"supportDownloads",[]]
