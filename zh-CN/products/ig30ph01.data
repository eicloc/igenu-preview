ts?category=water",{"_108":113,"_110":114},"工业测量","/zh-CN/products?category=industrial",{"_108":116,"_110":117},"气体检测","/zh-CN/products?category=gas",{"_103":119,"_105":120},"了解更多",[121,124,127,130,133],{"_108":122,"_110":123},"关于我们","/zh-CN/about",{"_108":125,"_110":126},"客户案例","/zh-CN/cases",{"_108":128,"_110":129},"新闻中心","/zh-CN/news",{"_108":131,"_110":132},"售后服务","/zh-CN/service",{"_108":134,"_110":135},"下载中心","/zh-CN/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig30ph01",[],[],"seo",{"_103":146,"_147":148,"_149":150,"_151":152},"IG30PH01 模拟pH电极 | IGENU SCIENCE","description","面向水质与过程监测的模拟pH电极，采用凝胶填充及双盐桥结构，并内置温度传感器用于温度补偿。配套安装支架和流通池，便于结合现场测点进行安装。","imageUrl","/igenu-preview/media/7dfe5452c927d26232963ff8.jpg","index",true,"canonical","https://eicloc.github.io/igenu-preview/zh-CN/products/ig30ph01","query",{},"selected",[],"detail",{"_161":162,"_57":141,"_163":164,"_165":166,"_167":148,"_168":169,"_170":171,"_175":176,"_203":204,"_205":206,"_147":-5,"_207":208,"_209":210,"_211":212,"_213":214,"_302":303,"_304":305,"_306":307,"_144":145},"id","ca3ec482-3741-46d1-bf9e-a1da33a8c095","model","IG30PH01","name","IG30PH01 模拟pH电极","shortDescription","featured",false,"category",{"_57":172,"_173":-5,"_165":109,"_147":-5,"_144":174},"water","brand",{"_103":109,"_147":-5,"_149":-5,"_151":152},"heroImage",{"_161":177,"_140":178,"_179":180,"_181":182,"_183":184,"_185":186,"_187":188,"_189":190,"_191":150,"_192":193,"_194":195},"7507b7cd-7dc3-42b2-90a4-f843106d4461","IMAGE","originalName","2025040859520101.png","mimeType","image/jpeg","size",19079,"sha256","7dfe5452c927d26232963ff85f11073f15b9d29010abcb394bea3ce0f2f502d6","width",358,"height",302,"url","createdAt","2026-10-20T17:32:39.754Z","variants",[196,201],{"_187":197,"_189":198,"_181":199,"_191":200},320,270,"image/webp","/igenu-preview/media/93a066c50a54638353b43bbf.webp",{"_187":188,"_189":190,"_181":199,"_191":202},"/igenu-preview/media/b72cc265fa7500183b25c7da.webp","detailLayout","STRUCTURED","availableLocales",[11,20,17],"bodyHtml","<p><strong><span></span></strong></p><p><strong><span>产品特点：</span></strong></p><p>◆配置丰富，满足各种不同工况需求<strong></strong></p><p>◆内置温度传感器，自动温度补偿 </p><p>◆自动识别标液，可选1点、2点标液校准 、一点样品校准 </p><p>◆传感器采用Ryton材料，使用寿命更长，降低维护与停机时间</p><p>◆大容量微孔双盐桥让探头抗毒性更强，使用寿命更长</p><p>◆大厚度高阻抗球泡，结构强度大，颗粒物撞击不易破损</p><p>◆屏蔽壳体封装，不受环境电磁干扰</p><p> </p><p><strong><span>应用领域：</span></strong></p><p>地表水、市政污水、环境监测、工业过程控制、污染源、工业废水、自来水、生物制药、啤酒饮料、石油石化、冶金</p><p> </p><p><strong><span>技术参数：</span></strong></p><p>测量范围：0-14pH；温度：-5-105℃</p><p>分辨率：0.01 pH，0.1℃</p><p>准确度:± 0.01 pH</p><p>重复性：0.01 pH</p><p>工作环境：0-95℃</p><p>响应时间:30秒达95%</p><p>漂移：≤0.02 pH/24h不累加</p><p>最大压力:<span> 8.0bar</span></p><p>最大流速:3米/秒</p><p>校准方式:一点样品、一点标液、两点标液校准</p><p>标液选择：手动、自动</p><p>温度补偿：自动</p><p>温度电极：PT1000</p><p>电极接口：BNC</p><p>参比电极：PTFE多孔盐桥液接</p><p>电极材质：PEEK、Ryton</p><p>螺纹接口：前后标准3/4NPT</p><p>防护等级：IP68</p><p>线缆长度：标准10m，可延长</p><p>电极尺寸：165mm*25mm</p><br /><br />\n    ","gallery",[],"features",[],"specificationGroups",[215],{"_165":216,"_217":218},"技术参数","specifications",[219,226,230,234,238,242,246,250,254,258,262,266,270,274,278,282,286,290,294,298],{"_220":221,"_108":222,"_223":224,"_225":-5},"key","measurement-range","测量范围","value","0-14pH；温度：-5-105℃","unit",{"_220":227,"_108":228,"_223":229,"_225":-5},"resolution","分辨率","0.01 pH，0.1℃",{"_220":231,"_108":232,"_223":233,"_225":-5},"accuracy","准确度","± 0.01 pH",{"_220":235,"_108":236,"_223":237,"_225":-5},"repeatability","重复性","0.01 pH",{"_220":239,"_108":240,"_223":241,"_225":-5},"operating-temperature","工作环境","0-95℃",{"_220":243,"_108":244,"_223":245,"_225":-5},"response-time","响应时间","30秒达95%",{"_220":247,"_108":248,"_223":249,"_225":-5},"drift","漂移","≤0.02 pH/24h不累加",{"_220":251,"_108":252,"_223":253,"_225":-5},"maximum-pressure","最大压力","8.0bar",{"_220":255,"_108":256,"_223":257,"_225":-5},"maximum-flow","最大流速","3米/秒",{"_220":259,"_108":260,"_223":261,"_225":-5},"calibration","校准方式","一点样品、一点标液、两点标液校准",{"_220":263,"_108":264,"_223":265,"_225":-5},"standard-solution","标液选择","手动、自动",{"_220":267,"_108":268,"_223":269,"_225":-5},"temperature-compensation","温度补偿","自动",{"_220":271,"_108":272,"_223":273,"_225":-5},"temperature-electrode","温度电极","PT1000",{"_220":275,"_108":276,"_223":277,"_225":-5},"electrode-interface","电极接口","BNC",{"_220":279,"_108":280,"_223":281,"_225":-5},"reference-electrode","参比电极","PTFE多孔盐桥液接",{"_220":283,"_108":284,"_223":285,"_225":-5},"electrode-material","电极材质","PEEK、Ryton",{"_220":287,"_108":288,"_223":289,"_225":-5},"thread","螺纹接口","前后标准3/4NPT",{"_220":291,"_108":292,"_223":293,"_225":-5},"protection","防护等级","IP68",{"_220":295,"_108":296,"_223":297,"_225":-5},"cable","线缆长度","标准10m，可延长",{"_220":299,"_108":300,"_223":301,"_225":-5},"electrode-size","电极尺寸","165mm*25mm","sourceReviews",[],"documents",[],"supportDownloads",[]]
