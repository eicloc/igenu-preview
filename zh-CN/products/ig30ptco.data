ts?category=water",{"_108":113,"_110":114},"工业测量","/zh-CN/products?category=industrial",{"_108":116,"_110":117},"气体检测","/zh-CN/products?category=gas",{"_103":119,"_105":120},"了解更多",[121,124,127,130,133],{"_108":122,"_110":123},"关于我们","/zh-CN/about",{"_108":125,"_110":126},"客户案例","/zh-CN/cases",{"_108":128,"_110":129},"新闻中心","/zh-CN/news",{"_108":131,"_110":132},"售后服务","/zh-CN/service",{"_108":134,"_110":135},"下载中心","/zh-CN/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig30ptco",[],[],"seo",{"_103":146,"_147":148,"_149":150,"_151":152},"IG30PTCO 水质色度传感器 | IGENU SCIENCE","description","采用光学吸收原理，基于铂钴色度标准监测水体色度。自动浊度补偿与清洁刷减少干扰和附着影响，内置校准参数并支持数字通讯，便于在线水质监测接入。","imageUrl","/igenu-preview/media/3a4bd3a9ba0af3bd90061177.jpg","index",true,"canonical","https://eicloc.github.io/igenu-preview/zh-CN/products/ig30ptco","query",{},"selected",[],"detail",{"_161":162,"_57":141,"_163":164,"_165":166,"_167":148,"_168":169,"_170":171,"_175":176,"_201":202,"_203":204,"_147":-5,"_205":206,"_207":208,"_209":210,"_211":212,"_272":273,"_274":275,"_276":277,"_144":145},"id","f98a1a11-9b74-4b87-a91b-1548d296a61a","model","IG30PTCO","name","IG30PTCO 水质色度传感器","shortDescription","featured",false,"category",{"_57":172,"_173":-5,"_165":109,"_147":-5,"_144":174},"water","brand",{"_103":109,"_147":-5,"_149":-5,"_151":152},"heroImage",{"_161":177,"_140":178,"_179":180,"_181":182,"_183":184,"_185":186,"_187":188,"_189":188,"_190":150,"_191":192,"_193":194},"e9c2938f-6236-4c7f-bf9d-752bcf98b444","IMAGE","originalName","2025040861512869.jpg","mimeType","image/jpeg","size",13520,"sha256","3a4bd3a9ba0af3bd90061177b116d1a851d9d410ca383514dfbd7fdb3aa5270f","width",540,"height","url","createdAt","2026-10-20T17:32:39.805Z","variants",[195,199],{"_187":196,"_189":196,"_181":197,"_190":198},320,"image/webp","/igenu-preview/media/9fb61c06fe27bcc0e9cecfd6.webp",{"_187":188,"_189":188,"_181":197,"_190":200},"/igenu-preview/media/b63396be40013d2d55e983f5.webp","detailLayout","STRUCTURED","availableLocales",[11,20,17],"bodyHtml","<p><strong><span>产品特点：</span></strong></p><p>◆数字传感器，RS-485 输出，MODBUS协议</p><p>◆带自动清洁刷，可防止沾污，消除气泡</p><p>◆自动对浊度干扰进行补偿，具有很好的测试性能</p><p>◆内置校准参数，出厂已精确校准，可直接安装使用</p><p><strong> </strong></p><p><strong><span>应用领域：</span></strong></p><p>饮用水监测、地表水监测、医院、工业企业、环保</p><p><strong> </strong></p><p><strong><span>技术参数：</span></strong></p><p>测量范围：0-50Pt-Co</p><p>测量原理：光学法（铂钴色度标准）</p><p>测量精度：±2% FS</p><p>重复性：小于±2% </p><p>传感器材质：机身：SUS316L；视窗：蓝宝石</p><p>自清洗：自动刮刷</p><p>传感器通讯：MODBUS RS-485 </p><p>存储温度：-10~50℃ </p><p>工作温度：0~50℃（不结冰） </p><p>防护等级：IP68 </p><p>功耗：＜2W</p><p>线缆长度：标准10m，可延长 </p><p>传感器尺寸：212mm*50mm</p><br />\n    ","gallery",[],"features",[],"specificationGroups",[213],{"_165":214,"_215":216},"技术参数","specifications",[217,224,228,232,236,240,244,248,252,256,260,264,268],{"_218":219,"_108":220,"_221":222,"_223":-5},"key","measurement-range","测量范围","value","0-50Pt-Co","unit",{"_218":225,"_108":226,"_221":227,"_223":-5},"measurement-principle","测量原理","光学法（铂钴色度标准）",{"_218":229,"_108":230,"_221":231,"_223":-5},"accuracy","测量精度","±2% FS",{"_218":233,"_108":234,"_221":235,"_223":-5},"repeatability","重复性","小于±2%",{"_218":237,"_108":238,"_221":239,"_223":-5},"sensor-material","传感器材质","机身：SUS316L；视窗：蓝宝石",{"_218":241,"_108":242,"_221":243,"_223":-5},"self-cleaning","自清洗","自动刮刷",{"_218":245,"_108":246,"_221":247,"_223":-5},"digital-communication","传感器通讯","MODBUS RS-485",{"_218":249,"_108":250,"_221":251,"_223":-5},"storage-temperature","存储温度","-10~50℃",{"_218":253,"_108":254,"_221":255,"_223":-5},"operating-temperature","工作温度","0~50℃（不结冰）",{"_218":257,"_108":258,"_221":259,"_223":-5},"protection","防护等级","IP68",{"_218":261,"_108":262,"_221":263,"_223":-5},"power-consumption","功耗","＜2W",{"_218":265,"_108":266,"_221":267,"_223":-5},"cable","线缆长度","标准10m，可延长",{"_218":269,"_108":270,"_221":271,"_223":-5},"sensor-size","传感器尺寸","212mm*50mm","sourceReviews",[],"documents",[],"supportDownloads",[]]
