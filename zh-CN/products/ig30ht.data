[{"_1":2,"_7":8},"root",{"_3":4},"data",{"_5":6},"productView","grid","content",{"_3":9},{"_10":11,"_12":13,"_14":15,"_140":58,"_57":141,"_64":142,"_70":143,"_144":145,"_153":154,"_155":156,"_157":158,"_159":160},"locale","zh-CN","origin","https://eicloc.github.io","settings",{"_16":17,"_18":19,"_21":22,"_23":24,"_54":55,"_86":87,"_88":89,"_26":27,"_28":29,"_37":-5,"_90":91,"_92":-5,"_93":94,"_95":96,"_97":98,"_99":-5,"_100":101,"_136":-5,"_137":-5,"_138":139},"defaultLocale","en","enabledLocales",[17,11,20],"de","logoUrl","/igenu-preview/media/f607ce2a51366ba8778f1000.jpg","regionalContacts",[25,39,47],{"_26":27,"_28":29,"_30":31,"_35":36,"_37":38},"email","Germany@igenu.com","phone","0049-935890-024","labels",{"_20":32,"_17":33,"_11":34},"Deutschland","Germany","德国","region","GERMANY","address","",{"_26":40,"_28":41,"_30":42,"_35":46,"_37":38},"cn@igenu.com","400-002-1266",{"_20":43,"_17":44,"_11":45},"Servicezentrum China","China service center","中国服务中心","CHINA",{"_26":48,"_28":38,"_30":49,"_35":53,"_37":38},"info@igenu-germany.com",{"_20":50,"_17":51,"_11":52},"Internationale Anfragen","International enquiries","国际业务咨询","INTERNATIONAL","navigation",[56,63,69,75,81],{"_57":58,"_30":59},"slug","products",{"_20":60,"_17":61,"_11":62},"Instrumente","Instruments","产品中心",{"_57":64,"_30":65},"parameters",{"_20":66,"_17":67,"_11":68},"Messparameter","Parameters","测量参数",{"_57":70,"_30":71},"applications",{"_20":72,"_17":73,"_11":74},"Anwendungen","Applications","应用方案",{"_57":76,"_30":77},"about",{"_20":78,"_17":79,"_11":80},"Über IGENU","About IGENU","关于 IGENU",{"_57":82,"_30":83},"service",{"_20":84,"_17":84,"_11":85},"Support","服务支持","companyName","IGENU SCIENCE","tagline","洞察环境，明晰工业。","footer","从水质分析、工业过程到气体检测，以测量仪器连接每一项工况需求。","copyright","primaryCta","联系专家","primaryCtaUrl","/contact","socialLinks",{},"defaultSeoImageUrl","footerNavigation",[102,118],{"_103":104,"_105":106},"title","产品","links",[107,112,115],{"_108":109,"_110":111},"label","水质分析","href","/zh-CN/products?category=water",{"_108":113,"_110":114},"工业测量","/zh-CN/products?category=industrial",{"_108":116,"_110":117},"气体检测","/zh-CN/products?category=gas",{"_103":119,"_105":120},"了解更多",[121,124,127,130,133],{"_108":122,"_110":123},"关于我们","/zh-CN/about",{"_108":125,"_110":126},"客户案例","/zh-CN/cases",{"_108":128,"_110":129},"新闻中心","/zh-CN/news",{"_108":131,"_110":132},"售后服务","/zh-CN/service",{"_108":134,"_110":135},"下载中心","/zh-CN/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig30ht",[],[],"seo",{"_103":146,"_147":148,"_149":150,"_151":152},"IG30HT 高量程浊度传感器 | IGENU SCIENCE","description","采用红外散射光原理测量浊度，适用于工业过程水、地表水及水处理监测。数字探头结合光学补偿与蓝宝石视窗，可选自动清洁刷，减少持续运行中的表面附着。","imageUrl","/igenu-preview/media/ecdac2d963d6479b136774a8.png","index",true,"canonical","https://eicloc.github.io/igenu-preview/zh-CN/products/ig30ht","query",{},"selected",[],"detail",{"_161":162,"_57":141,"_163":164,"_165":166,"_167":148,"_168":169,"_170":171,"_175":176,"_199":200,"_201":202,"_147":-5,"_203":204,"_205":206,"_207":208,"_209":210,"_294":295,"_296":297,"_298":299,"_144":145},"id","beabf1d3-ee7e-4d27-92b1-039290c217dc","model","IG30HT","name","IG30HT 高量程浊度传感器","shortDescription","featured",false,"category",{"_57":172,"_173":-5,"_165":109,"_147":-5,"_144":174},"water","brand",{"_103":109,"_147":-5,"_149":-5,"_151":152},"heroImage",{"_161":177,"_140":178,"_179":180,"_181":182,"_183":184,"_185":186,"_187":188,"_189":190,"_191":150,"_192":193,"_194":195},"95eccf83-22e5-4f4d-a03f-5509479d7661","IMAGE","originalName","2025040860985293.jpg","mimeType","image/png","size",11246,"sha256","ecdac2d963d6479b136774a8172895d54061650f1cb8089d1404ff2a26710a79","width",190,"height",78,"url","createdAt","2026-10-20T17:32:39.787Z","variants",[196],{"_187":188,"_189":190,"_181":197,"_191":198},"image/webp","/igenu-preview/media/c0547cb002a63d36b1ac374c.webp","detailLayout","STRUCTURED","availableLocales",[11,20,17],"bodyHtml","<p><strong><span>产品特点：</span></strong></p><p>◆内置温度传感器，自动光源温飘补偿 </p><p>◆采用双光束红外和散射光光度计检测技术 ，具有良好的重复性及稳定性</p><p>◆数字传感器，RS-485输出，标准ModbusRTU协议，不受传输距离影响，稳定性更佳 </p><p>◆传感器采用不锈钢材料，使用寿命更长，降低维护与停机时间 </p><p>◆使用860nm近红外光源，可补偿样品背景光颜色干扰</p><p>◆具备自清洗系统，运行稳定、维护量小 </p><p>◆蓝宝石视窗，经久耐磨，保障长期数据准确性</p><p>◆不受流速干扰、能承受剧烈冲击</p><p>◆数字化传感器，抗干扰能力强，传输距离远</p><p><strong> </strong></p><p><strong><span>应用领域：</span></strong></p><p>工业过程用水监测、饮用水处理、地表水/地下水监测、污水处理、膜过滤监测</p><p><strong> </strong></p><p><strong><span>技术参数：</span></strong></p><p>量程：0~1000NTU，0.2~4000NTU，0.5~10000NTU</p><p>测量原理：860nm 波长，90°和 135°散射光 </p><p>分辨率：0.001 NTU </p><p>测量精度：读数的±1%或±0.1NTU，取大者</p><p>重复性：小于±1% </p><p>气泡补偿：以软件为基础的气泡补偿 </p><p>响应时间：T90＜5S</p><p>最大压力：≤30bar </p><p>校准方式：单点样品、斜率校准 </p><p>传感器材质：机身：SUS316L；视窗：蓝宝石</p><p>自清洗：自动刮刷（可不选） </p><p>光衰补偿：自动</p><p>传感器通讯：MODBUS RS-485 </p><p>存储温度：-10~50℃ </p><p>工作温度：0~45℃（不结冰） </p><p>防护等级：IP68 </p><p>线缆长度：标准10m，可延长</p><p>最大压力：30bar</p><p>最大流速：3米/秒</p><p>传感器尺寸： 176mm*22mm</p><br />\n    ","gallery",[],"features",[],"specificationGroups",[211],{"_165":212,"_213":214},"技术参数","specifications",[215,222,226,230,234,238,242,246,250,254,258,262,266,270,274,278,282,286,290],{"_216":217,"_108":218,"_219":220,"_221":-5},"key","measurement-range","量程","value","0~1000NTU，0.2~4000NTU，0.5~10000NTU","unit",{"_216":223,"_108":224,"_219":225,"_221":-5},"measurement-principle","测量原理","860nm 波长，90°和 135°散射光",{"_216":227,"_108":228,"_219":229,"_221":-5},"resolution","分辨率","0.001 NTU",{"_216":231,"_108":232,"_219":233,"_221":-5},"accuracy","测量精度","读数的±1%或±0.1NTU，取大者",{"_216":235,"_108":236,"_219":237,"_221":-5},"repeatability","重复性","小于±1%",{"_216":239,"_108":240,"_219":241,"_221":-5},"bubble-compensation","气泡补偿","以软件为基础的气泡补偿",{"_216":243,"_108":244,"_219":245,"_221":-5},"response-time","响应时间","T90＜5S",{"_216":247,"_108":248,"_219":249,"_221":-5},"maximum-pressure","最大压力","≤30bar; 30bar",{"_216":251,"_108":252,"_219":253,"_221":-5},"calibration","校准方式","单点样品、斜率校准",{"_216":255,"_108":256,"_219":257,"_221":-5},"sensor-material","传感器材质","机身：SUS316L；视窗：蓝宝石",{"_216":259,"_108":260,"_219":261,"_221":-5},"self-cleaning","自清洗","自动刮刷（可不选）",{"_216":263,"_108":264,"_219":265,"_221":-5},"light-attenuation-compensation","光衰补偿","自动",{"_216":267,"_108":268,"_219":269,"_221":-5},"digital-communication","传感器通讯","MODBUS RS-485",{"_216":271,"_108":272,"_219":273,"_221":-5},"storage-temperature","存储温度","-10~50℃",{"_216":275,"_108":276,"_219":277,"_221":-5},"operating-temperature","工作温度","0~45℃（不结冰）",{"_216":279,"_108":280,"_219":281,"_221":-5},"protection","防护等级","IP68",{"_216":283,"_108":284,"_219":285,"_221":-5},"cable","线缆长度","标准10m，可延长",{"_216":287,"_108":288,"_219":289,"_221":-5},"maximum-flow","最大流速","3米/秒",{"_216":291,"_108":292,"_219":293,"_221":-5},"sensor-size","传感器尺寸","176mm*22mm","sourceReviews",[],"documents",[],"supportDownloads",[]]
