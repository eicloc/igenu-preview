[{"_1":2,"_7":8},"root",{"_3":4},"data",{"_5":6},"productView","grid","content",{"_3":9},{"_10":11,"_12":13,"_14":15,"_140":58,"_57":141,"_64":142,"_70":143,"_144":145,"_153":154,"_155":156,"_157":158,"_159":160},"locale","zh-CN","origin","https://eicloc.github.io","settings",{"_16":17,"_18":19,"_21":22,"_23":24,"_54":55,"_86":87,"_88":89,"_26":27,"_28":29,"_37":-5,"_90":91,"_92":-5,"_93":94,"_95":96,"_97":98,"_99":-5,"_100":101,"_136":-5,"_137":-5,"_138":139},"defaultLocale","en","enabledLocales",[17,11,20],"de","logoUrl","/igenu-preview/media/f607ce2a51366ba8778f1000.jpg","regionalContacts",[25,39,47],{"_26":27,"_28":29,"_30":31,"_35":36,"_37":38},"email","Germany@igenu.com","phone","0049-935890-024","labels",{"_20":32,"_17":33,"_11":34},"Deutschland","Germany","德国","region","GERMANY","address","",{"_26":40,"_28":41,"_30":42,"_35":46,"_37":38},"cn@igenu.com","400-002-1266",{"_20":43,"_17":44,"_11":45},"Servicezentrum China","China service center","中国服务中心","CHINA",{"_26":48,"_28":38,"_30":49,"_35":53,"_37":38},"info@igenu-germany.com",{"_20":50,"_17":51,"_11":52},"Internationale Anfragen","International enquiries","国际业务咨询","INTERNATIONAL","navigation",[56,63,69,75,81],{"_57":58,"_30":59},"slug","products",{"_20":60,"_17":61,"_11":62},"Instrumente","Instruments","产品中心",{"_57":64,"_30":65},"parameters",{"_20":66,"_17":67,"_11":68},"Messparameter","Parameters","测量参数",{"_57":70,"_30":71},"applications",{"_20":72,"_17":73,"_11":74},"Anwendungen","Applications","应用方案",{"_57":76,"_30":77},"about",{"_20":78,"_17":79,"_11":80},"Über IGENU","About IGENU","关于 IGENU",{"_57":82,"_30":83},"service",{"_20":84,"_17":84,"_11":85},"Support","服务支持","companyName","IGENU SCIENCE","tagline","洞察环境，明晰工业。","footer","从水质分析、工业过程到气体检测，以测量仪器连接每一项工况需求。","copyright","primaryCta","联系专家","primaryCtaUrl","/contact","socialLinks",{},"defaultSeoImageUrl","footerNavigation",[102,118],{"_103":104,"_105":106},"title","产品","links",[107,112,115],{"_108":109,"_110":111},"label","水质分析","href","/zh-CN/products?category=water",{"_108":113,"_110":114},"工业测量","/zh-CN/products?category=industrial",{"_108":116,"_110":117},"气体检测","/zh-CN/products?category=gas",{"_103":119,"_105":120},"了解更多",[121,124,127,130,133],{"_108":122,"_110":123},"关于我们","/zh-CN/about",{"_108":125,"_110":126},"客户案例","/zh-CN/cases",{"_108":128,"_110":129},"新闻中心","/zh-CN/news",{"_108":131,"_110":132},"售后服务","/zh-CN/service",{"_108":134,"_110":135},"下载中心","/zh-CN/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig30uvno3",[],[],"seo",{"_103":146,"_147":148,"_149":150,"_151":152},"IG30UVNO3 紫外吸收法硝氮传感器 | IGENU SCIENCE","description","通过紫外吸收原理直接测量水中硝酸盐氮，无需化学试剂和独立采样系统。提供不同光程选择，结合干扰补偿及自动清洁，适用于饮用水、环境与污水处理监测。","imageUrl","/igenu-preview/media/82c04b6460e5738541de5cfe.jpg","index",true,"canonical","https://eicloc.github.io/igenu-preview/zh-CN/products/ig30uvno3","query",{},"selected",[],"detail",{"_161":162,"_57":141,"_163":164,"_165":166,"_167":148,"_168":152,"_169":170,"_174":175,"_198":199,"_200":201,"_147":-5,"_202":203,"_204":205,"_206":207,"_208":209,"_289":290,"_291":292,"_293":294,"_144":145},"id","a5b76360-49f2-40e8-aeb2-c79f30115f7c","model","IG30UVNO3","name","IG30UVNO3 紫外吸收法硝氮传感器","shortDescription","featured","category",{"_57":171,"_172":-5,"_165":109,"_147":-5,"_144":173},"water","brand",{"_103":109,"_147":-5,"_149":-5,"_151":152},"heroImage",{"_161":176,"_140":177,"_178":179,"_180":181,"_182":183,"_184":185,"_186":187,"_188":189,"_190":150,"_191":192,"_193":194},"79581a81-10c6-426b-80fa-28e7baf03c33","IMAGE","originalName","2025040861391349.png","mimeType","image/jpeg","size",16873,"sha256","82c04b6460e5738541de5cfefb589dc0c6890e78350a89fe4e1a3b1a0828a745","width",263,"height",348,"url","createdAt","2026-10-20T17:32:39.799Z","variants",[195],{"_186":187,"_188":189,"_180":196,"_190":197},"image/webp","/igenu-preview/media/5668d414b7362883ab524969.webp","detailLayout","STRUCTURED","availableLocales",[11,20,17],"bodyHtml","<p><strong><span>产品特点：</span></strong></p><p>◆准确的紫外线吸收技术：确保了检测的高精度</p><p>◆灵活的光程选择：提供(1mm,2mm, 5mm)等不同光程选项，适应不同监测需求</p><p>◆探头直接浸入式测量，无需采样和预处理 </p><p>◆无需化学试剂，无二次污染 </p><p>◆响应时间短，可实现连续测量 </p><p>◆无需更换膜头和电解液 </p><p>◆传感器具有自动清洗功能，可减少维护量</p><p><strong> </strong></p><p><strong><span>应用领域：</span></strong></p><p>环境监测 、饮用及地表水监测 、工业废水、污水 、生活废水、污水 、地下水、湖泊水</p><p><strong> </strong></p><p><strong><span>技术参数：</span></strong></p><p>量程：0~40mg/L，0~100mg/L</p><p>测量原理：紫外吸收光谱</p><p>光源：闪烁氙灯 </p><p>光程：1mm、2mm、5mm </p><p>测量精度： ± 0.1 mg/L或读数的± 3%</p><p>重复性：小于±3% </p><p>检测限：0.02 mg/L</p><p>测量间隔：15s、30s、1min、30min</p><p>校准方式：单点样品校准、多点标液校准、斜率校准 </p><p>传感器材质：机身：SUS316L；视窗：蓝宝石</p><p>自清洗：自动刮刷</p><p>交叉灵敏度补偿：浊度、固体颗粒、有机物质</p><p>传感器通讯：MODBUS RS-485 </p><p>存储温度：-10~50℃ </p><p>工作温度：0~45℃（不结冰） </p><p>防护等级：IP68 </p><p>线缆长度：标准10m，可延长</p><p>传感器尺寸： 365mm*70mm</p><br />\n    ","gallery",[],"features",[],"specificationGroups",[210],{"_165":211,"_212":213},"技术参数","specifications",[214,221,225,229,233,237,241,245,249,253,257,261,265,269,273,277,281,285],{"_215":216,"_108":217,"_218":219,"_220":-5},"key","measurement-range","量程","value","0~40mg/L，0~100mg/L","unit",{"_215":222,"_108":223,"_218":224,"_220":-5},"measurement-principle","测量原理","紫外吸收光谱",{"_215":226,"_108":227,"_218":228,"_220":-5},"light-source","光源","闪烁氙灯",{"_215":230,"_108":231,"_218":232,"_220":-5},"optical-path","光程","1mm、2mm、5mm",{"_215":234,"_108":235,"_218":236,"_220":-5},"accuracy","测量精度","± 0.1 mg/L或读数的± 3%",{"_215":238,"_108":239,"_218":240,"_220":-5},"repeatability","重复性","小于±3%",{"_215":242,"_108":243,"_218":244,"_220":-5},"detection-limit","检测限","0.02 mg/L",{"_215":246,"_108":247,"_218":248,"_220":-5},"measurement-interval","测量间隔","15s、30s、1min、30min",{"_215":250,"_108":251,"_218":252,"_220":-5},"calibration","校准方式","单点样品校准、多点标液校准、斜率校准",{"_215":254,"_108":255,"_218":256,"_220":-5},"sensor-material","传感器材质","机身：SUS316L；视窗：蓝宝石",{"_215":258,"_108":259,"_218":260,"_220":-5},"self-cleaning","自清洗","自动刮刷",{"_215":262,"_108":263,"_218":264,"_220":-5},"cross-sensitivity-compensation","交叉灵敏度补偿","浊度、固体颗粒、有机物质",{"_215":266,"_108":267,"_218":268,"_220":-5},"digital-communication","传感器通讯","MODBUS RS-485",{"_215":270,"_108":271,"_218":272,"_220":-5},"storage-temperature","存储温度","-10~50℃",{"_215":274,"_108":275,"_218":276,"_220":-5},"operating-temperature","工作温度","0~45℃（不结冰）",{"_215":278,"_108":279,"_218":280,"_220":-5},"protection","防护等级","IP68",{"_215":282,"_108":283,"_218":284,"_220":-5},"cable","线缆长度","标准10m，可延长",{"_215":286,"_108":287,"_218":288,"_220":-5},"sensor-size","传感器尺寸","365mm*70mm","sourceReviews",[],"documents",[],"supportDownloads",[]]
