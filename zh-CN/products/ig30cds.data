ts?category=water",{"_108":113,"_110":114},"工业测量","/zh-CN/products?category=industrial",{"_108":116,"_110":117},"气体检测","/zh-CN/products?category=gas",{"_103":119,"_105":120},"了解更多",[121,124,127,130,133],{"_108":122,"_110":123},"关于我们","/zh-CN/about",{"_108":125,"_110":126},"客户案例","/zh-CN/cases",{"_108":128,"_110":129},"新闻中心","/zh-CN/news",{"_108":131,"_110":132},"售后服务","/zh-CN/service",{"_108":134,"_110":135},"下载中心","/zh-CN/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig30cds",[],[],"seo",{"_103":146,"_147":148,"_149":150,"_151":152},"IG30CDS 电导率传感器 | IGENU SCIENCE","description","提供不同电极常数选择，面向水处理与工业过程水的电导率监测。支持数字通讯并保存校准及设定信息，配套安装支架和流通池，便于接入现场监测系统。","imageUrl","/igenu-preview/media/08cc865f38c95a6b72364eaf.jpg","index",true,"canonical","https://eicloc.github.io/igenu-preview/zh-CN/products/ig30cds","query",{},"selected",[],"detail",{"_161":162,"_57":141,"_163":164,"_165":166,"_167":148,"_168":169,"_170":171,"_175":176,"_201":202,"_203":204,"_147":-5,"_205":206,"_207":208,"_209":210,"_211":212,"_295":296,"_297":298,"_299":300,"_144":145},"id","f33fa081-7e09-4283-a1f0-899eb8c5a37c","model","IG30CDS","name","IG30CDS 电导率传感器","shortDescription","featured",false,"category",{"_57":172,"_173":-5,"_165":109,"_147":-5,"_144":174},"water","brand",{"_103":109,"_147":-5,"_149":-5,"_151":152},"heroImage",{"_161":177,"_140":178,"_179":180,"_181":182,"_183":184,"_185":186,"_187":188,"_189":188,"_190":150,"_191":192,"_193":194},"97568f30-f32e-4d9a-85ac-2b57a8967181","IMAGE","originalName","2025040860050401.jpg","mimeType","image/jpeg","size",57217,"sha256","08cc865f38c95a6b72364eaf3f6b94912df92297b7cb4dbcdb9d9d327b79dd1c","width",500,"height","url","createdAt","2026-10-20T17:32:39.763Z","variants",[195,199],{"_187":196,"_189":196,"_181":197,"_190":198},320,"image/webp","/igenu-preview/media/6f7c525ac57d10f270f2e15f.webp",{"_187":188,"_189":188,"_181":197,"_190":200},"/igenu-preview/media/d8eaca92b7d0ec37a6ee861d.webp","detailLayout","STRUCTURED","availableLocales",[11,20,17],"bodyHtml","<p></p><p><strong><span>产品特点：</span></strong></p><p>◆响应时间快，15秒达到95% </p><p>◆数字传感器，RS-485输出，标准ModbusRTU协议，不受传输距离影响，稳定性更佳 </p><p>◆传感器采用Ryton材料，使用寿命更长，降低维护与停机时间</p><p>◆反应迅速、测量精准、数据可靠、操作便捷</p><p>◆内部电极可测量极微弱信号，不会出现极化效应影响</p><p>◆内部集成存储器，断电后仍可记忆存储的校准和设定信息</p><p><strong> </strong></p><p><strong><span>应用领域：</span></strong></p><p>地表水、市政污水、环境监测、工业过程控制、污染源、工业废水、自来水、生物制药、啤酒饮料、石油石化、冶金</p><p><strong> </strong></p><p><strong><span>技术参数：</span></strong></p><p>测量范围：K=0.01，0-20us/cm；K=0. 1，0-200us/cm; K=1，0-2000us/cm; K=10，0-20000us/cm</p><p>温度：0-125℃</p><p>分辨率：0.01 us/cm; 0.1us/cm; 1us/cm，0.1℃</p><p>准确度:±1%读数</p><p>重复性：±1%读数</p><p>温度补偿：自动</p><p>工作环境：0-95℃</p><p>最大压力:<span> 6.0bar</span></p><p>最大流速:3米/秒</p><p>校准方式:标液校准</p><p>温度补偿：自动</p><p>温度电极：PT1000</p><p>电极形式：数字化电极</p><p>响应时间: 15秒达95%</p><p>通讯接口：ModbusRS485</p><p>电极材质：PEEK、Ryton</p><p>螺纹接口：前后标准3/4NPT</p><p>防护等级：IP68</p><p>线缆长度：标准10m，可延长</p><p>电极尺寸：165mm*25mm</p><br /><br />\n    ","gallery",[],"features",[],"specificationGroups",[213],{"_165":214,"_215":216},"技术参数","specifications",[217,224,228,232,236,239,243,247,251,255,259,263,267,271,275,279,283,287,291],{"_218":219,"_108":220,"_221":222,"_223":-5},"key","measurement-range","测量范围","value","K=0.01，0-20us/cm；K=0. 1，0-200us/cm; K=1，0-2000us/cm; K=10，0-20000us/cm","unit",{"_218":225,"_108":226,"_221":227,"_223":-5},"temperature","温度","0-125℃",{"_218":229,"_108":230,"_221":231,"_223":-5},"resolution","分辨率","0.01 us/cm; 0.1us/cm; 1us/cm，0.1℃",{"_218":233,"_108":234,"_221":235,"_223":-5},"accuracy","准确度","±1%读数",{"_218":237,"_108":238,"_221":235,"_223":-5},"repeatability","重复性",{"_218":240,"_108":241,"_221":242,"_223":-5},"temperature-compensation","温度补偿","自动",{"_218":244,"_108":245,"_221":246,"_223":-5},"operating-temperature","工作环境","0-95℃",{"_218":248,"_108":249,"_221":250,"_223":-5},"maximum-pressure","最大压力","6.0bar",{"_218":252,"_108":253,"_221":254,"_223":-5},"maximum-flow","最大流速","3米/秒",{"_218":256,"_108":257,"_221":258,"_223":-5},"calibration","校准方式","标液校准",{"_218":260,"_108":261,"_221":262,"_223":-5},"temperature-electrode","温度电极","PT1000",{"_218":264,"_108":265,"_221":266,"_223":-5},"electrode-form","电极形式","数字化电极",{"_218":268,"_108":269,"_221":270,"_223":-5},"response-time","响应时间","15秒达95%",{"_218":272,"_108":273,"_221":274,"_223":-5},"digital-communication","通讯接口","ModbusRS485",{"_218":276,"_108":277,"_221":278,"_223":-5},"electrode-material","电极材质","PEEK、Ryton",{"_218":280,"_108":281,"_221":282,"_223":-5},"thread","螺纹接口","前后标准3/4NPT",{"_218":284,"_108":285,"_221":286,"_223":-5},"protection","防护等级","IP68",{"_218":288,"_108":289,"_221":290,"_223":-5},"cable","线缆长度","标准10m，可延长",{"_218":292,"_108":293,"_221":294,"_223":-5},"electrode-size","电极尺寸","165mm*25mm","sourceReviews",[],"documents",[],"supportDownloads",[]]
