ts?category=water",{"_108":113,"_110":114},"工业测量","/zh-CN/products?category=industrial",{"_108":116,"_110":117},"气体检测","/zh-CN/products?category=gas",{"_103":119,"_105":120},"了解更多",[121,124,127,130,133],{"_108":122,"_110":123},"关于我们","/zh-CN/about",{"_108":125,"_110":126},"客户案例","/zh-CN/cases",{"_108":128,"_110":129},"新闻中心","/zh-CN/news",{"_108":131,"_110":132},"售后服务","/zh-CN/service",{"_108":134,"_110":135},"下载中心","/zh-CN/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig30phs",[],[],"seo",{"_103":146,"_147":148,"_149":150,"_151":152},"IG30PHS 数字pH电极 | IGENU SCIENCE","description","数字pH电极结合凝胶填充、双盐桥参比结构与内置温度传感器，支持Modbus通讯接入兼容控制器。提供标液及样品校准方式，配套支架和流通池，便于现场安装与日常使用。","imageUrl","/igenu-preview/media/7dfe5452c927d26232963ff8.jpg","index",true,"canonical","https://eicloc.github.io/igenu-preview/zh-CN/products/ig30phs","query",{},"selected",[],"detail",{"_161":162,"_57":141,"_163":164,"_165":166,"_167":148,"_168":152,"_169":170,"_174":175,"_202":203,"_204":205,"_147":-5,"_206":207,"_208":209,"_210":211,"_212":213,"_305":306,"_307":308,"_309":310,"_144":145},"id","331a2881-86de-42d4-aad2-8985fb41f4ba","model","IG30PHS","name","IG30PHS 数字pH电极","shortDescription","featured","category",{"_57":171,"_172":-5,"_165":109,"_147":-5,"_144":173},"water","brand",{"_103":109,"_147":-5,"_149":-5,"_151":152},"heroImage",{"_161":176,"_140":177,"_178":179,"_180":181,"_182":183,"_184":185,"_186":187,"_188":189,"_190":150,"_191":192,"_193":194},"7507b7cd-7dc3-42b2-90a4-f843106d4461","IMAGE","originalName","2025040859520101.png","mimeType","image/jpeg","size",19079,"sha256","7dfe5452c927d26232963ff85f11073f15b9d29010abcb394bea3ce0f2f502d6","width",358,"height",302,"url","createdAt","2026-10-20T17:32:39.754Z","variants",[195,200],{"_186":196,"_188":197,"_180":198,"_190":199},320,270,"image/webp","/igenu-preview/media/93a066c50a54638353b43bbf.webp",{"_186":187,"_188":189,"_180":198,"_190":201},"/igenu-preview/media/b72cc265fa7500183b25c7da.webp","detailLayout","STRUCTURED","availableLocales",[11,20,17],"bodyHtml","<p><strong><span>产品特点：</span></strong></p><p>◆配置丰富，满足各种不同工况需求<strong></strong></p><p>◆内置温度传感器，自动温度补偿 </p><p>◆自动识别标液，可选1点、2点标液校准 、一点样品校准</p><p>◆数字传感器，标准ModbusRTU协议，不受传输距离影响，稳定性更佳</p><p>◆传感器采用Ryton材料，使用寿命更长，降低维护与停机时间</p><p>◆大容量微孔双盐桥让探头抗毒性更强，使用寿命更长</p><p>◆大厚度高阻抗球泡，结构强度大，颗粒物撞击不易破损</p><p>◆屏蔽壳体封装，不受环境电磁干扰</p><p> </p><p><strong><span>应用领域：</span></strong></p><p>地表水、市政污水、环境监测、工业过程控制、污染源、工业废水、自来水、生物制药、啤酒饮料、石油石化、冶金</p><p> </p><p><strong><span>技术参数：</span></strong></p><p>测量范围：0-14pH；温度：-5-105℃</p><p>分辨率：0.01 pH，0.1℃</p><p>准确度:± 0.01 pH</p><p>重复性：0.01 pH</p><p>工作环境：0-95℃</p><p>响应时间:30秒达95%</p><p>漂移：≤0.02 pH/24h不累加</p><p>最大压力:<span> 8.0bar</span></p><p>最大流速:3米/秒</p><p>校准方式:一点样品、一点标液、两点标液校准</p><p>标液选择：手动、自动</p><p>温度补偿：自动</p><p>温度电极：PT1000</p><p>电极形式：数字化电极</p><p>参比电极：PTFE多孔盐桥液接</p><p>通讯接口：ModbusRS485</p><p>电极材质：PEEK、Ryton</p><p>螺纹接口：前后标准3/4NPT</p><p>防护等级：IP68</p><p>线缆长度：标准10m，可延长</p><p>电极尺寸：165mm*25mm</p><br />\n    ","gallery",[],"features",[],"specificationGroups",[214],{"_165":215,"_216":217},"技术参数","specifications",[218,225,229,233,237,241,245,249,253,257,261,265,269,273,277,281,285,289,293,297,301],{"_219":220,"_108":221,"_222":223,"_224":-5},"key","measurement-range","测量范围","value","0-14pH；温度：-5-105℃","unit",{"_219":226,"_108":227,"_222":228,"_224":-5},"resolution","分辨率","0.01 pH，0.1℃",{"_219":230,"_108":231,"_222":232,"_224":-5},"accuracy","准确度","± 0.01 pH",{"_219":234,"_108":235,"_222":236,"_224":-5},"repeatability","重复性","0.01 pH",{"_219":238,"_108":239,"_222":240,"_224":-5},"operating-temperature","工作环境","0-95℃",{"_219":242,"_108":243,"_222":244,"_224":-5},"response-time","响应时间","30秒达95%",{"_219":246,"_108":247,"_222":248,"_224":-5},"drift","漂移","≤0.02 pH/24h不累加",{"_219":250,"_108":251,"_222":252,"_224":-5},"maximum-pressure","最大压力","8.0bar",{"_219":254,"_108":255,"_222":256,"_224":-5},"maximum-flow","最大流速","3米/秒",{"_219":258,"_108":259,"_222":260,"_224":-5},"calibration","校准方式","一点样品、一点标液、两点标液校准",{"_219":262,"_108":263,"_222":264,"_224":-5},"standard-solution","标液选择","手动、自动",{"_219":266,"_108":267,"_222":268,"_224":-5},"temperature-compensation","温度补偿","自动",{"_219":270,"_108":271,"_222":272,"_224":-5},"temperature-electrode","温度电极","PT1000",{"_219":274,"_108":275,"_222":276,"_224":-5},"electrode-form","电极形式","数字化电极",{"_219":278,"_108":279,"_222":280,"_224":-5},"reference-electrode","参比电极","PTFE多孔盐桥液接",{"_219":282,"_108":283,"_222":284,"_224":-5},"digital-communication","通讯接口","ModbusRS485",{"_219":286,"_108":287,"_222":288,"_224":-5},"electrode-material","电极材质","PEEK、Ryton",{"_219":290,"_108":291,"_222":292,"_224":-5},"thread","螺纹接口","前后标准3/4NPT",{"_219":294,"_108":295,"_222":296,"_224":-5},"protection","防护等级","IP68",{"_219":298,"_108":299,"_222":300,"_224":-5},"cable","线缆长度","标准10m，可延长",{"_219":302,"_108":303,"_222":304,"_224":-5},"electrode-size","电极尺寸","165mm*25mm","sourceReviews",[],"documents",[],"supportDownloads",[]]
