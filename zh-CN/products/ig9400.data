ts?category=water",{"_108":113,"_110":114},"工业测量","/zh-CN/products?category=industrial",{"_108":116,"_110":117},"气体检测","/zh-CN/products?category=gas",{"_103":119,"_105":120},"了解更多",[121,124,127,130,133],{"_108":122,"_110":123},"关于我们","/zh-CN/about",{"_108":125,"_110":126},"客户案例","/zh-CN/cases",{"_108":128,"_110":129},"新闻中心","/zh-CN/news",{"_108":131,"_110":132},"售后服务","/zh-CN/service",{"_108":134,"_110":135},"下载中心","/zh-CN/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig9400",[],[],"seo",{"_103":146,"_147":148,"_149":150,"_151":152},"IG9400 超声波明渠流量计 | IGENU SCIENCE","description","以非接触超声波测量明渠堰槽水位，并换算对应流量。分体式探头与显示单元提供瞬时及累计流量信息，适用于废水排放口、灌溉和市政水利工程。","imageUrl","/igenu-preview/media/96effce7a54b18259f3ac6a1.png","index",true,"canonical","https://eicloc.github.io/igenu-preview/zh-CN/products/ig9400","query",{},"selected",[],"detail",{"_161":162,"_57":141,"_163":164,"_165":166,"_167":148,"_168":169,"_170":171,"_175":176,"_217":218,"_219":220,"_147":-5,"_221":222,"_223":224,"_225":226,"_227":228,"_284":285,"_305":306,"_307":308,"_144":145},"id","eb107e4e-e537-4104-aea5-d30cd2f70c8a","model","IG9400","name","IG9400 超声波明渠流量计","shortDescription","featured",false,"category",{"_57":172,"_173":-5,"_165":113,"_147":-5,"_144":174},"industrial","brand",{"_103":113,"_147":-5,"_149":-5,"_151":152},"heroImage",{"_161":177,"_140":178,"_179":180,"_181":182,"_183":184,"_185":186,"_187":188,"_189":190,"_191":150,"_192":193,"_194":195},"c09dd052-6bcc-434a-9386-7136b00ba170","IMAGE","originalName","2025040854281913.png","mimeType","image/png","size",544222,"sha256","96effce7a54b18259f3ac6a19a290f71d4f862b45801327c466bd60032c71808","width",1809,"height",1449,"url","createdAt","2026-10-20T17:32:39.727Z","variants",[196,201,205,209,213],{"_187":197,"_189":198,"_181":199,"_191":200},320,256,"image/webp","/igenu-preview/media/f7db19bc9da969b069506228.webp",{"_187":202,"_189":203,"_181":199,"_191":204},640,513,"/igenu-preview/media/9e26d52402655e540b305fd0.webp",{"_187":206,"_189":207,"_181":199,"_191":208},960,769,"/igenu-preview/media/1e64887f2c4083e3b4c84b69.webp",{"_187":210,"_189":211,"_181":199,"_191":212},1280,1025,"/igenu-preview/media/a853495b9ddf518f0be39552.webp",{"_187":214,"_189":215,"_181":199,"_191":216},1600,1282,"/igenu-preview/media/f0f509b5abc23cc9078dfaf4.webp","detailLayout","STRUCTURED","availableLocales",[11,20,17],"bodyHtml","<p></p><p><strong><span>产品特点：</span></strong></p><p>◆分体式，适用于不同现场安装要求 </p><p>◆分根据流速自动调节发射功率，先进的数字模型运算，抗干扰设计 </p><p>◆分使用简洁，结果可靠，界面操作指示可以减少操作失误 </p><p>◆分探头材质有POM、PVDF、PTFE可选，适用于多种工况场合 </p><p>◆分内部集成温度传感器，可实时对声速进行温度补偿</p><p><strong> </strong></p><p><strong><span>应用领域：</span></strong></p><p>废水排放口 、农田灌溉 、市政污水 、水利工程</p><p><strong> </strong></p><p><strong><span>技术参数：</span></strong></p><p>液位高度：≤ 5m</p><p>瞬时流量 ：由配用的量水堰槽的种类、规格确定</p><p>累积流量：0-999999999m³</p><p>分 辨 率 ：0.001m³/h</p><p>精 度 ：2%</p><p>盲 区 ：0.3m</p><p>显示方式： LCD 液晶显示</p><p>发射开角 ：6°~ 10°</p><p>防护等级: 防护等级：变送器：IP65；变送器：IP68</p><p>电源：DC18-36V；AC90-260V</p><p>信 号：4-20mA,RS485（可选）</p><p>报警：多路继电器</p><br /><br />\n    ","gallery",[],"features",[],"specificationGroups",[229],{"_165":230,"_231":232},"技术参数","specifications",[233,240,244,248,252,256,260,264,268,272,276,280],{"_234":235,"_108":236,"_237":238,"_239":-5},"key","liquid-level-height","液位高度","value","≤ 5m","unit",{"_234":241,"_108":242,"_237":243,"_239":-5},"instantaneous-flow","瞬时流量","由配用的量水堰槽的种类、规格确定",{"_234":245,"_108":246,"_237":247,"_239":-5},"accumulated-flow","累积流量","0-999999999m³",{"_234":249,"_108":250,"_237":251,"_239":-5},"resolution","分 辨 率","0.001m³/h",{"_234":253,"_108":254,"_237":255,"_239":-5},"accuracy","精 度","2%",{"_234":257,"_108":258,"_237":259,"_239":-5},"blind-zone","盲 区","0.3m",{"_234":261,"_108":262,"_237":263,"_239":-5},"display","显示方式","LCD 液晶显示",{"_234":265,"_108":266,"_237":267,"_239":-5},"launch-angle","发射开角","6°~ 10°",{"_234":269,"_108":270,"_237":271,"_239":-5},"protection","防护等级","防护等级：变送器：IP65；变送器：IP68",{"_234":273,"_108":274,"_237":275,"_239":-5},"power