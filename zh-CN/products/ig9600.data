ts?category=water",{"_108":113,"_110":114},"工业测量","/zh-CN/products?category=industrial",{"_108":116,"_110":117},"气体检测","/zh-CN/products?category=gas",{"_103":119,"_105":120},"了解更多",[121,124,127,130,133],{"_108":122,"_110":123},"关于我们","/zh-CN/about",{"_108":125,"_110":126},"客户案例","/zh-CN/cases",{"_108":128,"_110":129},"新闻中心","/zh-CN/news",{"_108":131,"_110":132},"售后服务","/zh-CN/service",{"_108":134,"_110":135},"下载中心","/zh-CN/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig9600",[],[],"seo",{"_103":146,"_147":148,"_149":150,"_151":152},"IG9600 超声波污泥界面仪 | IGENU SCIENCE","description","通过超声波回声传播时间识别污泥界面，服务于沉淀池与污泥浓缩池监测。分体式探头结合温度补偿及现场显示，适用于污水处理和水厂沉淀工艺。","imageUrl","/igenu-preview/media/65b4e4d80f69906e1d7bb840.png","index",true,"canonical","https://eicloc.github.io/igenu-preview/zh-CN/products/ig9600","query",{},"selected",[],"detail",{"_161":162,"_57":141,"_163":164,"_165":166,"_167":148,"_168":169,"_170":171,"_175":176,"_217":218,"_219":220,"_147":-5,"_221":222,"_223":224,"_225":226,"_227":228,"_308":309,"_310":311,"_312":313,"_144":145},"id","12c35e01-af3a-4ad0-b514-1b67363212af","model","IG9600","name","IG9600 超声波污泥界面仪","shortDescription","featured",false,"category",{"_57":172,"_173":-5,"_165":113,"_147":-5,"_144":174},"industrial","brand",{"_103":113,"_147":-5,"_149":-5,"_151":152},"heroImage",{"_161":177,"_140":178,"_179":180,"_181":182,"_183":184,"_185":186,"_187":188,"_189":190,"_191":150,"_192":193,"_194":195},"fe68277b-0e41-4c1a-b0a4-8bfebd654caa","IMAGE","originalName","2025040854938433.png","mimeType","image/png","size",549953,"sha256","65b4e4d80f69906e1d7bb840b3735e20c7fa903b831162b2a977ae41ff5f77d9","width",2064,"height",1704,"url","createdAt","2026-10-20T17:32:39.735Z","variants",[196,201,205,209,213],{"_187":197,"_189":198,"_181":199,"_191":200},320,264,"image/webp","/igenu-preview/media/2dc78a489616479a5aadfbac.webp",{"_187":202,"_189":203,"_181":199,"_191":204},640,528,"/igenu-preview/media/aae51fe4186be6ad1749b345.webp",{"_187":206,"_189":207,"_181":199,"_191":208},960,793,"/igenu-preview/media/50b869a018e4f784a789e882.webp",{"_187":210,"_189":211,"_181":199,"_191":212},1280,1057,"/igenu-preview/media/44748a134c7000c8efd4c395.webp",{"_187":214,"_189":215,"_181":199,"_191":216},1600,1321,"/igenu-preview/media/8ef2f704c499019d37e0855c.webp","detailLayout","STRUCTURED","availableLocales",[11,20,17],"bodyHtml","<p><strong><span>产品特点：</span></strong></p><p>◆分体式，适用于不同现场安装要求 </p><p>◆主机中英文操作界面，可实现多点测量、报警等功能 </p><p>◆使用简洁，结果可靠，界面操作指示可以减少操作失误 </p><p>◆探头材质有POM、PVDF、PTFE可选，适用于多种工况场合 </p><p>◆内部集成温度传感器，可实时对声速进行温度补偿</p><p><strong> </strong></p><p><strong><span>应用领域：</span></strong></p><p>固液分界面的场合、污水厂的初沉池、二沉池、污泥浓缩池泥位、自来水厂沉淀池泥位</p><p><strong> </strong></p><p><strong><span>技术参数：</span></strong></p><p>测量范围：0.2～10/15/20m </p><p>分辨率：&lt; 0.04m </p><p>精度：0.1m ± 0.05m </p><p>响应时间：10～900s（可调）</p><p>校准：只须在开机时进行一次</p><p>自动压力范围：≤ 0.3bar </p><p>环境温度：0～50℃ </p><p>温度补偿：自动补偿</p><p>防护等级：IP68 </p><p>流速要求：≤ 3m/s</p><p>尺寸：140mm × 195mm（H× D） </p><p>重量：约 3.5Kg </p><p>维护：常规 &lt; 1 小时 / 月</p><p>电缆线长：10m，至少延长 100m </p><p>输出：2路0/4-20mA、负载750Ω、 </p><p>报警：多路继电器、220VAC/ 2 A 485 </p><p>信 号：Modbus协议（可选） </p><p>过程温度：变送器：-30℃~80℃；传感器：-40℃~80℃ </p><p>防护等级：变送器：IP65；变送器：IP68</p><p>电源：DC18-36V；AC90-260V</p><br /><p></p>\n    ","gallery",[],"features",[],"specificationGroups",[229],{"_165":230,"_231":232},"技术参数","specifications",[233,240,244,248,252,256,260,264,268,272,276,280,284,288,292,296,300,304],{"_234":235,"_108":236,"_237":238,"_239":-5},"key","measurement-range","测量范围","value","0.2～10/15/20m","unit",{"_234":241,"_108":242,"_237":243,"_239":-5},"resolution","分辨率","< 0.04m",{"_234":245,"_108":246,"_237":247,"_239":-5},"accuracy","精度","0.1m ± 0.05m",{"_234":249,"_108":250,"_237":251,"_239":-5},"response-time","响应时间","10～900s（可调）",{"_234":253,"_108":254,"_237":255,"_239":-5},"calibration","校准","只须在开机时进行一次",{"_234":257,"_108":258,"_237":259,"_239":-5},"automatic-pressure-range","自动压力范围","≤ 0.3bar",{"_234":261,"_108":262,"_237":263,"_2