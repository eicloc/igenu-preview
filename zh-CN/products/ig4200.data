ts?category=water",{"_108":113,"_110":114},"工业测量","/zh-CN/products?category=industrial",{"_108":116,"_110":117},"气体检测","/zh-CN/products?category=gas",{"_103":119,"_105":120},"了解更多",[121,124,127,130,133],{"_108":122,"_110":123},"关于我们","/zh-CN/about",{"_108":125,"_110":126},"客户案例","/zh-CN/cases",{"_108":128,"_110":129},"新闻中心","/zh-CN/news",{"_108":131,"_110":132},"售后服务","/zh-CN/service",{"_108":134,"_110":135},"下载中心","/zh-CN/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig4200",[],[],"seo",{"_103":146,"_147":148,"_149":150,"_151":152},"IG4200 在线总固体浓度分析仪 | IGENU SCIENCE","description","采用微波透射原理直接测量水样中的总固体浓度，无需预先分离或沉淀。连续测量与控制系统接入功能，服务于污水处理、化工、制药及食品等过程监测。","imageUrl","/igenu-preview/media/4b53f5aab7936bf5768d9331.jpg","index",true,"canonical","https://eicloc.github.io/igenu-preview/zh-CN/products/ig4200","query",{},"selected",[],"detail",{"_161":162,"_57":141,"_163":164,"_165":166,"_167":148,"_168":169,"_170":171,"_175":176,"_203":204,"_205":206,"_147":-5,"_207":208,"_209":210,"_211":212,"_213":214,"_282":283,"_284":285,"_286":287,"_144":145},"id","8adc50f7-109a-4e34-80e1-4442cb557ef8","model","IG4200","name","IG4200 在线总固体浓度分析仪","shortDescription","featured",false,"category",{"_57":172,"_173":-5,"_165":113,"_147":-5,"_144":174},"industrial","brand",{"_103":113,"_147":-5,"_149":-5,"_151":152},"heroImage",{"_161":177,"_140":178,"_179":180,"_181":182,"_183":184,"_185":186,"_187":188,"_189":190,"_191":150,"_192":193,"_194":195},"a7d0c5a5-4017-44bb-880a-fe921c7cae03","IMAGE","originalName","2025041053569693.png","mimeType","image/jpeg","size",47641,"sha256","4b53f5aab7936bf5768d9331003eaab972aa10e742396f2311725e7a132e48cb","width",490,"height",278,"url","createdAt","2026-10-20T17:32:39.927Z","variants",[196,201],{"_187":197,"_189":198,"_181":199,"_191":200},320,182,"image/webp","/igenu-preview/media/460947b2f394cc6a41c35af0.webp",{"_187":188,"_189":190,"_181":199,"_191":202},"/igenu-preview/media/b3843283fc6cbe984798d870.webp","detailLayout","STRUCTURED","availableLocales",[11,20,17],"bodyHtml","<p><strong><span></span></strong></p><p><strong><span>产品特点：</span></strong></p><p>◆快速准确：使用微波信号进行测量，可以在数秒内获得水样中总固体的浓度值，并且精度高。<br />◆无需样品处理：传统的总固体浓度测试方法需要对样品进行分离、沉淀等处理，而在线微波总固体浓度测量仪直接对水样进行测量，省去了样品处理的步骤。</p><p>◆实时监测：该仪器可以实时监测水样中总固体浓度的变化，方便对生产过程进行控制和调节。<br />◆自动化程度高：可以与生产过程的控制系统相连，实现自动化控制。</p><p>◆目前使用的污泥浓度传感器多为光学传感器，严重玷污测量头，主要是累积的石灰岩会使其偏离测量范围，进而增加维护成本。IG4200 采用特殊材料传感器，能抵御污垢的积聚，因此可提供的长期稳定性。</p><p><strong><span>应用领域：</span></strong></p><p>化工 、制药 、污水处理、食品、 环保</p><p><span><strong>技术参数：</strong></span></p><p>测量范围：35%TS，350,000mg/L</p><p>重复性：0.01%TS</p><p>分辨率：0.001%</p><p>精度（稳定条件下）：± 0.02%TS</p><p>压力：大于1.5bar</p><p>电导率：0-25ms/cm</p><p>信号端口：4-20mA / RS485</p><p>接液材质：316L+陶瓷</p><p>采样时间：1s</p><p>防护等级：传感器IP66,控制器：IP65</p><p>安装方式：插入式、法兰式</p><p>流速：＜5m/s</p><p>工艺温度：0-70℃</p><p>环境温度：0-60℃</p><p>电源：220VAC</p><br /><br />\n    ","gallery",[],"features",[],"specificationGroups",[215],{"_165":216,"_217":218},"技术参数","specifications",[219,226,230,234,238,242,246,250,254,258,262,266,270,274,278],{"_220":221,"_108":222,"_223":224,"_225":-5},"key","measurement-range","测量范围","value","35%TS，350,000mg/L","unit",{"_220":227,"_108":228,"_223":229,"_225":-5},"repeatability","重复性","0.01%TS",{"_220":231,"_108":232,"_223":233,"_225":-5},"resolution","分辨率","0.001%",{"_220":235,"_108":236,"_223":237,"_225":-5},"accuracy","精度（稳定条件下）","± 0.02%TS",{"_220":239,"_108":240,"_223":241,"_225":-5},"pressure","压力","大于1.5bar",{"_220":243,"_108":244,"_223":245,"_225":-5},"conductivity","电导率","0-25ms/cm",{"_220":247,"_108":248,"_223":249,"_225":-5},"signal-port","信号端口","4-20mA / RS485",{"_220":251,"_108":252,"_223":253,"_225":-5},"wetted-material","接液材质","316L+陶瓷",{"_220":255,"_108":256,"_223":257,"_225":-5},"sampling-time","采样时间","1s",{"_220":259,"_108":260,"_223":261,"_225":-5},"protection","防护等级","传感器IP66,控制器：IP65",{"_220":263,"_108":264,"_223":265,"_225":-5},"installation","安装方式","插入式、法兰式",{"_220":267,"_108":268,"_223":269,"_225":-5},"flow-rate","流速","＜5m/s",{"_220":271,"_108":272,"_223":273,"_225":-5},"process-temperature","工艺温度","0-70℃",{"_220":275,"_108":276,"_223":277,"_225":-5},"operating-temperature","环境温度","0-60℃",{"_220":279,"_108":280,"_223":281,"_225":-5},"power-supply","电源","220VAC","sourceReviews",[],"documents",[],"supportDownloads",[]]
