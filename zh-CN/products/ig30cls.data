ts?category=water",{"_108":113,"_110":114},"工业测量","/zh-CN/products?category=industrial",{"_108":116,"_110":117},"气体检测","/zh-CN/products?category=gas",{"_103":119,"_105":120},"了解更多",[121,124,127,130,133],{"_108":122,"_110":123},"关于我们","/zh-CN/about",{"_108":125,"_110":126},"客户案例","/zh-CN/cases",{"_108":128,"_110":129},"新闻中心","/zh-CN/news",{"_108":131,"_110":132},"售后服务","/zh-CN/service",{"_108":134,"_110":135},"下载中心","/zh-CN/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig30cls",[],[],"seo",{"_103":146,"_147":148,"_149":150,"_151":152},"IG30CLS 余氯传感器 | IGENU SCIENCE","description","采用恒电压电化学原理监测水中余氯与二氧化氯，配套流通槽保持样品流量。无需比色试剂，也无需定期更换膜片和电解液，适用于供水与水处理监测。","imageUrl","/igenu-preview/media/128cbf77e27c44f50a679ba8.jpg","index",true,"canonical","https://eicloc.github.io/igenu-preview/zh-CN/products/ig30cls","query",{},"selected",[],"detail",{"_161":162,"_57":141,"_163":164,"_165":166,"_167":148,"_168":169,"_170":171,"_175":176,"_203":204,"_205":206,"_147":-5,"_207":208,"_209":210,"_211":212,"_213":214,"_285":286,"_287":288,"_289":290,"_144":145},"id","979b50bb-1b83-4aa2-b03a-464c97387d69","model","IG30CLS","name","IG30CLS 余氯传感器","shortDescription","featured",false,"category",{"_57":172,"_173":-5,"_165":109,"_147":-5,"_144":174},"water","brand",{"_103":109,"_147":-5,"_149":-5,"_151":152},"heroImage",{"_161":177,"_140":178,"_179":180,"_181":182,"_183":184,"_185":186,"_187":188,"_189":190,"_191":150,"_192":193,"_194":195},"ce0b8383-b6df-4c9a-aabb-3a55435db7a7","IMAGE","originalName","2025040861142109.png","mimeType","image/jpeg","size",22021,"sha256","128cbf77e27c44f50a679ba8b27ec860b8243697fccdc4f64b056e6497df3a79","width",344,"height",423,"url","createdAt","2026-10-20T17:32:39.792Z","variants",[196,201],{"_187":197,"_189":198,"_181":199,"_191":200},320,393,"image/webp","/igenu-preview/media/e07f5ef0e1a47e02ed6259ae.webp",{"_187":188,"_189":190,"_181":199,"_191":202},"/igenu-preview/media/ecb94564bb6e1f06cbfde7cd.webp","detailLayout","STRUCTURED","availableLocales",[11,20,17],"bodyHtml","<p><strong><span>产品特点：</span></strong></p><p>◆采用恒电压原理 </p><p>◆无需更换膜片和电解液 </p><p>◆无需比色试剂 </p><p>◆特制流通槽保持流量稳定 </p><p>◆零点稳定，抗干扰能力强 </p><p>◆操作简单方便，性价比高</p><p><strong> </strong></p><p><strong><span>应用领域：</span></strong></p><p>市政自来水厂、污水处理厂、二次供水 、饮用及地表水监测 、工业过程</p><p><strong> </strong></p><p><strong><span>技术参数：</span></strong></p><p>量程：0~2mg/L 或0~20mg/L </p><p>测量原理：恒电压 </p><p>测量精度：±5% </p><p>重复性：读数的±5% </p><p>分辨率：0.01mg/L </p><p>流速：25~55 L/h </p><p>校准方式：零点校准、斜率校准 </p><p>PH 补偿：手动或自动 </p><p>温度补偿：手动或自动 </p><p>斜率：75%~155% </p><p>传感器材质：316L不锈钢+铂电极</p><p>传感器电压：9~36VDC </p><p>传感器通讯：MODBUS RS-485 </p><p>介质温度：0~50℃（不结冰） </p><p>线缆长度：标准 1.5 米，可延长</p><p>传感器尺寸：201mm*35mm</p><br />\n    ","gallery",[],"features",[],"specificationGroups",[215],{"_165":216,"_217":218},"技术参数","specifications",[219,226,230,234,238,242,246,250,254,257,261,265,269,273,277,281],{"_220":221,"_108":222,"_223":224,"_225":-5},"key","measurement-range","量程","value","0~2mg/L 或0~20mg/L","unit",{"_220":227,"_108":228,"_223":229,"_225":-5},"measurement-principle","测量原理","恒电压",{"_220":231,"_108":232,"_223":233,"_225":-5},"accuracy","测量精度","±5%",{"_220":235,"_108":236,"_223":237,"_225":-5},"repeatability","重复性","读数的±5%",{"_220":239,"_108":240,"_223":241,"_225":-5},"resolution","分辨率","0.01mg/L",{"_220":243,"_108":244,"_223":245,"_225":-5},"flow-rate","流速","25~55 L/h",{"_220":247,"_108":248,"_223":249,"_225":-5},"calibration","校准方式","零点校准、斜率校准",{"_220":251,"_108":252,"_223":253,"_225":-5},"ph-compensation","PH 补偿","手动或自动",{"_220":255,"_108":256,"_223":253,"_225":-5},"temperature-compensation","温度补偿",{"_220":258,"_108":259,"_223":260,"_225":-5},"slope","斜率","75%~155%",{"_220":262,"_108":263,"_223":264,"_225":-5},"sensor-material","传感器材质","316L不锈钢+铂电极",{"_220":266,"_108":267,"_223":268,"_225":-5},"sensor-voltage","传感器电压","9~36VDC",{"_220":270,"_108":271,"_223":272,"_225":-5},"digital-communication","传感器通讯","MODBUS RS-485",{"_220":274,"_108":275,"_223":276,"_225":-5},"medium-temperature"