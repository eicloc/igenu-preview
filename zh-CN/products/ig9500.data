vailableLocales",[11,20,17],"bodyHtml","<p><strong><span>产品特点：</span></strong></p><p>◆投入式测量方式</p><p>◆全不锈钢结构设计，体积小，重量轻</p><p>◆选用稳定可靠的扩散硅压力传感器，具有出色的重复性和稳定性</p><p>◆多种输出模式可选</p><p><strong> </strong></p><p><strong><span>应用领域：</span></strong></p><p>水处理工程、水文监测、农林渔业、工业过程</p><p><strong> </strong></p><p><strong><span>技术参数：</span></strong></p><p>测量范围：0-3/5/10/…100m H20</p><p>电源：24VDC</p><p>输出：0/4-20mA,0-10V,RS485(可选)</p><p>精度：＜0.1%F.S.</p><p>防护等级：IP68</p><p>长期稳定性：±0.2%F.S./年</p><p>介质温度：-20℃ ~70℃</p><p>传感器材质：316L</p><p>温度补偿范围：0-50℃</p><p>满量程温度误差：±0.3%F.S.</p><p>过载压力：满量程压力2.5倍</p><br />\n    ","gallery",[],"features",[],"specificationGroups",[215],{"_165":216,"_217":218},"技术参数","specifications",[219,226,230,234,238,242,246,250,254,258,262],{"_220":221,"_108":222,"_223":224,"_225":-5},"key","measurement-range","测量范围","value","0-3/5/10/…100m H20","unit",{"_220":227,"_108":228,"_223":229,"_225":-5},"power-supply","电源","24VDC",{"_220":231,"_108":232,"_223":233,"_225":-5},"output","输出","0/4-20mA,0-10V,RS485(可选)",{"_220":235,"_108":236,"_223":237,"_225":-5},"accuracy","精度","＜0.1%F.S.",{"_220":239,"_108":240,"_223":241,"_225":-5},"protection","防护等级","IP68",{"_220":243,"_108":244,"_223":245,"_225":-5},"long-term-stability","长期稳定性","±0.2%F.S./年",{"_220":247,"_108":248,"_223":249,"_225":-5},"medium-temperature","介质温度","-20℃ ~70℃",{"_220":251,"_108":252,"_223":253,"_225":-5},"sensor-material","传感器材质","316L",{"_220":255,"_108":256,"_223":257,"_225":-5},"temperature-compensation-range","温度补偿范围","0-50℃",{"_220":259,"_108":260,"_223":261,"_225":-5},"full-range-temperature-error","满量程温度误差","±0.3%F.S.",{"_220":263,"_108":264,"_223":265,"_225":-5},"overload-pressure","过载压力","满量程压力2.5倍","sourceReviews",[],"documents",[],"supportDownloads",[]]
