[{"_1":2,"_7":8},"root",{"_3":4},"data",{"_5":6},"productView","grid","content",{"_3":9},{"_10":11,"_12":13,"_14":15,"_140":58,"_57":141,"_64":142,"_70":143,"_144":145,"_153":154,"_155":156,"_157":158,"_159":160},"locale","zh-CN","origin","https://eicloc.github.io","settings",{"_16":17,"_18":19,"_21":22,"_23":24,"_54":55,"_86":87,"_88":89,"_26":27,"_28":29,"_37":-5,"_90":91,"_92":-5,"_93":94,"_95":96,"_97":98,"_99":-5,"_100":101,"_136":-5,"_137":-5,"_138":139},"defaultLocale","en","enabledLocales",[17,11,20],"de","logoUrl","/igenu-preview/media/f607ce2a51366ba8778f1000.jpg","regionalContacts",[25,39,47],{"_26":27,"_28":29,"_30":31,"_35":36,"_37":38},"email","Germany@igenu.com","phone","0049-935890-024","labels",{"_20":32,"_17":33,"_11":34},"Deutschland","Germany","德国","region","GERMANY","address","",{"_26":40,"_28":41,"_30":42,"_35":46,"_37":38},"cn@igenu.com","400-002-1266",{"_20":43,"_17":44,"_11":45},"Servicezentrum China","China service center","中国服务中心","CHINA",{"_26":48,"_28":38,"_30":49,"_35":53,"_37":38},"info@igenu-germany.com",{"_20":50,"_17":51,"_11":52},"Internationale Anfragen","International enquiries","国际业务咨询","INTERNATIONAL","navigation",[56,63,69,75,81],{"_57":58,"_30":59},"slug","products",{"_20":60,"_17":61,"_11":62},"Instrumente","Instruments","产品中心",{"_57":64,"_30":65},"parameters",{"_20":66,"_17":67,"_11":68},"Messparameter","Parameters","测量参数",{"_57":70,"_30":71},"applications",{"_20":72,"_17":73,"_11":74},"Anwendungen","Applications","应用方案",{"_57":76,"_30":77},"about",{"_20":78,"_17":79,"_11":80},"Über IGENU","About IGENU","关于 IGENU",{"_57":82,"_30":83},"service",{"_20":84,"_17":84,"_11":85},"Support","服务支持","companyName","IGENU SCIENCE","tagline","洞察环境，明晰工业。","footer","从水质分析、工业过程到气体检测，以测量仪器连接每一项工况需求。","copyright","primaryCta","联系专家","primaryCtaUrl","/contact","socialLinks",{},"defaultSeoImageUrl","footerNavigation",[102,118],{"_103":104,"_105":106},"title","产品","links",[107,112,115],{"_108":109,"_110":111},"label","水质分析","href","/zh-CN/products?category=water",{"_108":113,"_110":114},"工业测量","/zh-CN/products?category=industrial",{"_108":116,"_110":117},"气体检测","/zh-CN/products?category=gas",{"_103":119,"_105":120},"了解更多",[121,124,127,130,133],{"_108":122,"_110":123},"关于我们","/zh-CN/about",{"_108":125,"_110":126},"客户案例","/zh-CN/cases",{"_108":128,"_110":129},"新闻中心","/zh-CN/news",{"_108":131,"_110":132},"售后服务","/zh-CN/service",{"_108":134,"_110":135},"下载中心","/zh-CN/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig30ss-sol",[],[],"seo",{"_103":146,"_147":148,"_149":150,"_151":152},"IG30SS/SOL 悬浮物与污泥浓度传感器 | IGENU SCIENCE","description","采用红外散射光原理，在线监测水及污水处理过程中的悬浮物与污泥浓度。数字探头结合光学补偿与蓝宝石视窗，可选清洁刷减少持续运行中的表面附着。","imageUrl","/igenu-preview/media/fbfabb8705ffee2ab2928de1.jpg","index",true,"canonical","https://eicloc.github.io/igenu-preview/zh-CN/products/ig30ss-sol","query",{},"selected",[],"detail",{"_161":162,"_57":141,"_163":164,"_165":166,"_167":148,"_168":152,"_169":170,"_174":175,"_198":199,"_200":201,"_147":-5,"_202":203,"_204":205,"_206":207,"_208":209,"_293":294,"_295":296,"_297":298,"_144":145},"id","9d824bcb-a360-4cc5-9c05-f39f8c5afaa3","model","IG30SS/SOL","name","IG30SS/SOL 悬浮物与污泥浓度传感器","shortDescription","featured","category",{"_57":171,"_172":-5,"_165":109,"_147":-5,"_144":173},"water","brand",{"_103":109,"_147":-5,"_149":-5,"_151":152},"heroImage",{"_161":176,"_140":177,"_178":179,"_180":181,"_182":183,"_184":185,"_186":187,"_188":189,"_190":150,"_191":192,"_193":194},"1439d80a-330c-424f-b53e-2863e4ad2437","IMAGE","originalName","2025040860527217.png","mimeType","image/jpeg","size",17952,"sha256","fbfabb8705ffee2ab2928de1e179bcbdfff9163bf9562b20f0a57da383e92447","width",252,"height",303,"url","createdAt","2026-10-20T17:32:39.774Z","variants",[195],{"_186":187,"_188":189,"_180":196,"_190":197},"image/webp","/igenu-preview/media/75deeb09829c31a530ddf618.webp","detailLayout","STRUCTURED","availableLocales",[11,20,17],"bodyHtml","<p><strong><span>产品特点：</span></strong></p><p>◆内置温度传感器，自动光源温飘补偿 </p><p>◆采用双光束红外和散射光光度计检测技术 ，具有良好的重复性及稳定性</p><p>◆数字传感器，RS-485输出，标准ModbusRTU协议，不受传输距离影响，稳定性更佳 </p><p>◆传感器采用不锈钢材料，使用寿命更长，降低维护与停机时间 </p><p>◆使用860nm近红外光源，可补偿样品背景光颜色干扰</p><p>◆具备自清洗系统，运行稳定、维护量小 </p><p>◆蓝宝石视窗，经久耐磨，保障长期数据准确性</p><p>◆不受流速干扰、能承受剧烈冲击</p><p>◆数字化传感器，抗干扰能力强，传输距离远</p><p><strong> </strong></p><p><strong><span>应用领域：</span></strong></p><p>市政污水、工业废水、环境监测 、饮用及地表水监测、工业过程</p><p><strong> </strong></p><p><strong><span>技术参数：</span></strong></p><p>量程：0~50g/L，0.1~100g/L，0.2~500g/L</p><p>测量原理：860nm 波长，90°和 140°散射光 </p><p>分辨率：0.01mg/L </p><p>测量精度：小于读数的±1%（取决于介质污泥的同质性） </p><p>重复性：小于±1% </p><p>气泡补偿：以软件为基础的气泡补偿 </p><p>响应时间：T90＜5S</p><p>最大压力：≤30bar </p><p>校准方式：单点样品、斜率校准 </p><p>传感器材质：机身：SUS316L；视窗：蓝宝石</p><p>自清洗：自动刮刷（可选） </p><p>光衰补偿：自动</p><p>传感器通讯：MODBUS RS-485 </p><p>存储温度：-30~75℃ </p><p>工作温度：0~70℃（不结冰） </p><p>防护等级：IP68 </p><p>线缆长度：标准10m，可延长 </p><p>最大压力：30bar</p><p>最大流速：3米/秒</p><p>传感器尺寸： 200mm*50mm</p><br />\n    ","gallery",[],"features",[],"specificationGroups",[210],{"_165":211,"_212":213},"技术参数","specifications",[214,221,225,229,233,237,241,245,249,253,257,261,265,269,273,277,281,285,289],{"_215":216,"_108":217,"_218":219,"_220":-5},"key","measurement-range","量程","value","0~50g/L，0.1~100g/L，0.2~500g/L","unit",{"_215":222,"_108":223,"_218":224,"_220":-5},"measurement-principle","测量原理","860nm 波长，90°和 140°散射光",{"_215":226,"_108":227,"_218":228,"_220":-5},"resolution","分辨率","0.01mg/L",{"_215":230,"_108":231,"_218":232,"_220":-5},"accuracy","测量精度","小于读数的±1%（取决于介质污泥的同质性）",{"_215":234,"_108":235,"_218":236,"_220":-5},"repeatability","重复性","小于±1%",{"_215":238,"_108":239,"_218":240,"_220":-5},"bubble-compensation","气泡补偿","以软件为基础的气泡补偿",{"_215":242,"_108":243,"_218":244,"_220":-5},"response-time","响应时间","T90＜5S",{"_215":246,"_108":247,"_218":248,"_220":-5},"maximum-pressure","最大压力","≤30bar; 30bar",{"_215":250,"_108":251,"_218":252,"_220":-5},"calibration","校准方式","单点样品、斜率校准",{"_215":254,"_108":255,"_218":256,"_220":-5},"sensor-material","传感器材质","机身：SUS316L；视窗：蓝宝石",{"_215":258,"_108":259,"_218":260,"_220":-5},"self-cleaning","自清洗","自动刮刷（可选）",{"_215":262,"_108":263,"_218":264,"_220":-5},"light-attenuation-compensation","光衰补偿","自动",{"_215":266,"_108":267,"_218":268,"_220":-5},"digital-communication","传感器通讯","MODBUS RS-485",{"_215":270,"_108":271,"_218":272,"_220":-5},"storage-temperature","存储温度","-30~75℃",{"_215":274,"_108":275,"_218":276,"_220":-5},"operating-temperature","工作温度","0~70℃（不结冰）",{"_215":278,"_108":279,"_218":280,"_220":-5},"protection","防护等级","IP68",{"_215":282,"_108":283,"_218":284,"_220":-5},"cable","线缆长度","标准10m，可延长",{"_215":286,"_108":287,"_218":288,"_220":-5},"maximum-flow","最大流速","3米/秒",{"_215":290,"_108":291,"_218":292,"_220":-5},"sensor-size","传感器尺寸","200mm*50mm","sourceReviews",[],"documents",[],"supportDownloads",[]]
