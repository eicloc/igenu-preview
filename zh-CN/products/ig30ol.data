ts?category=water",{"_108":113,"_110":114},"工业测量","/zh-CN/products?category=industrial",{"_108":116,"_110":117},"气体检测","/zh-CN/products?category=gas",{"_103":119,"_105":120},"了解更多",[121,124,127,130,133],{"_108":122,"_110":123},"关于我们","/zh-CN/about",{"_108":125,"_110":126},"客户案例","/zh-CN/cases",{"_108":128,"_110":129},"新闻中心","/zh-CN/news",{"_108":131,"_110":132},"售后服务","/zh-CN/service",{"_108":134,"_110":135},"下载中心","/zh-CN/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig30ol",[],[],"seo",{"_103":146,"_147":148,"_149":150,"_151":152},"IG30OL 水中油传感器 | IGENU SCIENCE","description","通过紫外荧光原理监测水中油，适用于石化污水、油田回注水及相关水处理环节。采用光学滤光与自清洁设计，减少环境光和表面附着影响，并支持数字通讯接入。","imageUrl","/igenu-preview/media/e3e2c21db606165f614650cf.jpg","index",true,"canonical","https://eicloc.github.io/igenu-preview/zh-CN/products/ig30ol","query",{},"selected",[],"detail",{"_161":162,"_57":141,"_163":164,"_165":166,"_167":148,"_168":169,"_170":171,"_175":176,"_201":202,"_203":204,"_147":-5,"_205":206,"_207":208,"_209":210,"_211":212,"_276":277,"_278":279,"_280":281,"_144":145},"id","32049077-055b-4d74-8a27-aac11e6dcee3","model","IG30OL","name","IG30OL 水中油传感器","shortDescription","featured",false,"category",{"_57":172,"_173":-5,"_165":109,"_147":-5,"_144":174},"water","brand",{"_103":109,"_147":-5,"_149":-5,"_151":152},"heroImage",{"_161":177,"_140":178,"_179":180,"_181":182,"_183":184,"_185":186,"_187":188,"_189":188,"_190":150,"_191":192,"_193":194},"79d9f104-d914-4e36-bec2-d6d2b843fefd","IMAGE","originalName","2025041051182309.jpg","mimeType","image/jpeg","size",14215,"sha256","e3e2c21db606165f614650cf931244737a0e84793f3dd9ab8bd834db8aa5b8b3","width",540,"height","url","createdAt","2026-10-20T17:32:39.888Z","variants",[195,199],{"_187":196,"_189":196,"_181":197,"_190":198},320,"image/webp","/igenu-preview/media/087409fcbd7eefe1aec06c53.webp",{"_187":188,"_189":188,"_181":197,"_190":200},"/igenu-preview/media/6d889354b11ab94fb489a773.webp","detailLayout","STRUCTURED","availableLocales",[11,20,17],"bodyHtml","<p><strong><span>产品特点：</span></strong></p><p>◆紫外荧光法原理测量水中油，精确度高，与红外法具有优良的相关性</p><p>◆采用钛合金耐腐蚀壳体；NPT3/4上螺纹接口，方便安装</p><p>◆具自清洗功能，清除水样中附着物，免维护</p><p>◆采用独特的光学和电子滤光技术，消除环境光对测量的影响</p><p>◆不受水中悬浮物颗粒物的影响</p><p><strong> </strong></p><p><strong><span>应用领域：</span></strong></p><p>石油石化污水达标排放、油田回注水含油量控制、锅炉补充反渗透膜进水保护、污废水</p><p><strong> </strong></p><p><strong><span>技术参数：</span></strong></p><p>测量范围：0-10mg/L, 0-100mg/L, 0-1000mg/L</p><p>测量原理：紫外荧光法</p><p>测量精度： 读数的± 3%</p><p>重复性：小于±3% </p><p>检测限：0.1 mg/L</p><p>响应时间：4s</p><p>校准方式：单点校准</p><p>水样需求：流速：0-3m/s;压力：0-100Psi；0-6bar;温度：0-50℃</p><p>通讯接口：ModbusRS485</p><p>螺纹接口：标准3/4NPT</p><p>防护等级：IP68</p><p>安装方式：投入式、流通式</p><p>线缆长度：标准10m，可延长</p><p>电极尺寸：176mm*22 mm</p><br />\n    ","gallery",[],"features",[],"specificationGroups",[213],{"_165":214,"_215":216},"技术参数","specifications",[217,224,228,232,236,240,244,248,252,256,260,264,268,272],{"_218":219,"_108":220,"_221":222,"_223":-5},"key","measurement-range","测量范围","value","0-10mg/L, 0-100mg/L, 0-1000mg/L","unit",{"_218":225,"_108":226,"_221":227,"_223":-5},"measurement-principle","测量原理","紫外荧光法",{"_218":229,"_108":230,"_221":231,"_223":-5},"accuracy","测量精度","读数的± 3%",{"_218":233,"_108":234,"_221":235,"_223":-5},"repeatability","重复性","小于±3%",{"_218":237,"_108":238,"_221":239,"_223":-5},"detection-limit","检测限","0.1 mg/L",{"_218":241,"_108":242,"_221":243,"_223":-5},"response-time","响应时间","4s",{"_218":245,"_108":246,"_221":247,"_223":-5},"calibration","校准方式","单点校准",{"_218":249,"_108":250,"_221":251,"_223":-5},"water-sample","水样需求","流速：0-3m/s;压力：0-100Psi；0-6bar;温度：0-50℃",{"_218":253,"_108":254,"_221":255,"_223":-5},"digital-communication","通讯接口","ModbusRS485",{"_218":257,"_108":258,"_221":259,"_223":-5},"thread","螺纹接口","标准3/4NPT",{"_218":261,"_108":262,"_221":263,"_223":-5},"protection","防护等级","IP68",{"_218":265,"_108":266,"_221":267,"_223":-5},"installation","安装方式","投入式、流通式",{"_218":269,"_108":270,"_221":271,"_223":-5},"cable","线缆长度","标准10m，可延长",{"_218":273,"_108":274,"_221":275,"_223":-5},"electrode-size","电极尺寸","176mm*22 mm","sourceReviews",[],"documents",[],"supportDownloads",[]]
