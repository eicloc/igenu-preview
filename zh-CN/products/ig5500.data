ts?category=water",{"_108":113,"_110":114},"工业测量","/zh-CN/products?category=industrial",{"_108":116,"_110":117},"气体检测","/zh-CN/products?category=gas",{"_103":119,"_105":120},"了解更多",[121,124,127,130,133],{"_108":122,"_110":123},"关于我们","/zh-CN/about",{"_108":125,"_110":126},"客户案例","/zh-CN/cases",{"_108":128,"_110":129},"新闻中心","/zh-CN/news",{"_108":131,"_110":132},"售后服务","/zh-CN/service",{"_108":134,"_110":135},"下载中心","/zh-CN/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig5500",[],[],"seo",{"_103":146,"_147":148,"_149":150,"_151":152},"IG5500 压力变送器 | IGENU SCIENCE","description","采用扩散硅压力芯体与信号处理电路，测量兼容气体及液体介质的压力。紧凑结构结合可选输出与过程连接，便于水处理、液压设备和工业过程控制中的现场安装。","imageUrl","/igenu-preview/media/c746becf8db6677ba7f20c1b.png","index",true,"canonical","https://eicloc.github.io/igenu-preview/zh-CN/products/ig5500","query",{},"selected",[],"detail",{"_161":162,"_57":141,"_163":164,"_165":166,"_167":148,"_168":169,"_170":171,"_175":176,"_207":208,"_209":210,"_147":-5,"_211":212,"_213":214,"_215":216,"_217":218,"_286":287,"_288":289,"_290":291,"_144":145},"id","d5c3a293-847d-45eb-8e36-aa2ac3fc2463","model","IG5500","name","IG5500 压力变送器","shortDescription","featured",false,"category",{"_57":172,"_173":-5,"_165":113,"_147":-5,"_144":174},"industrial","brand",{"_103":113,"_147":-5,"_149":-5,"_151":152},"heroImage",{"_161":177,"_140":178,"_179":180,"_181":182,"_183":184,"_185":186,"_187":188,"_189":190,"_191":150,"_192":193,"_194":195},"33d41440-c759-49f8-90bd-34b6cd5f235a","IMAGE","originalName","2025040851699125.png","mimeType","image/png","size",328593,"sha256","c746becf8db6677ba7f20c1ba57229696ee47b035e9b8e09a92e661b92d3b81c","width",894,"height",591,"url","createdAt","2026-10-20T17:32:39.705Z","variants",[196,201,205],{"_187":197,"_189":198,"_181":199,"_191":200},320,212,"image/webp","/igenu-preview/media/742e701732a18bc68d06d2a3.webp",{"_187":202,"_189":203,"_181":199,"_191":204},640,423,"/igenu-preview/media/bcb0d54fc977c2edfe25d6f5.webp",{"_187":188,"_189":190,"_181":199,"_191":206},"/igenu-preview/media/6dcb50f0f86d2a52dccece3c.webp","detailLayout","STRUCTURED","availableLocales",[11,20,17],"bodyHtml","<p><strong><span>产品特点：</span></strong></p><p>◆使用介质广泛，可测油、水、糊状物等，具有一定的防腐蚀能力 </p><p>◆线性好，高准确度，高稳定性，寿命长 </p><p>◆体积小，重量轻，方便安装 </p><p>◆范围宽抗腐蚀，适于多种介质</p><p><strong> </strong></p><p><strong><span>应用领域：</span></strong></p><p>水厂、污水处理厂、石油化工、工业过程</p><p><strong> </strong></p><p><strong><span>技术参数：</span></strong></p><p>测量介质：气体、液体、油等</p><p>测量形式及范围：表压（G）---最大(0～60)MPa, 最小(0～0.5)Kpa</p><p>绝压（A）---最大(0～40)MPa, 最小 (0～5)KPa</p><p>负压（B）--- (-0.1～40)MPa,   最小(-0.2～0.2 )KPa</p><p>环境温度：-10~65℃ </p><p>环境湿度：5~100%相对湿度</p><p>精度等级：0.1%</p><p>过载能力：量程的2～5倍</p><p>长期稳定性：小于0.2%FS/60个月</p><p>供电电源：24VDC</p><p>输出信号：(4～20)mA（二/三线制）（选配HART协议输出）、（0～10/20）mA<br />（0～5）V、（1～5）V、（0～10）V、（选配）RS485</p><p>显示方式：数显                                             </p><p>测量速率：0.2S</p><p>工作温度：-40～80℃</p><p>补偿温度：-20～70 ℃</p><p>过程连接：M20×1.5外螺纹（Ф3内孔），或用户指定</p><p>防护等级：IP67</p><p>电磁兼容:射频保护符合 EN61326</p><br /><p></p>\n    ","gallery",[],"features",[],"specificationGroups",[219],{"_165":220,"_221":222},"技术参数","specifications",[223,230,234,238,242,246,250,254,258,262,266,270,274,278,282],{"_224":225,"_108":226,"_227":228,"_229":-5},"key","medium","测量介质","value","气体、液体、油等","unit",{"_224":231,"_108":232,"_227":233,"_229":-5},"measurement-form","测量形式及范围","表压（G）---最大(0～60)MPa, 最小(0～0.5)Kpa",{"_224":235,"_108":236,"_227":237,"_229":-5},"operating-temperature","环境温度","-10~65℃; -40～80℃",{"_224":239,"_108":240,"_227":241,"_229":-5},"operating-humidity","环境湿度","5~100%相对湿度",{"_224":243,"_108":244,"_227":245,"_229":-5},"accuracy","精度等级","0.1%",{"_224":247,"_108":248,"_227":249,"_229":-5},"overload-capacity","过载能力","量程的2～5倍",{"_224":251,"_108":252,"_227":253,"_229":-5},"long-term-stability","长期稳定性","小于0.2%FS/60个月",{"_224":255,"_108":256,"_227":257,"_229":-5},"power-supply","供电电源","24VDC",{"_224":259,"_108":260,"_227":261,"_229":-5},"output","输出信号","(4～20)mA（二/三线制）（选配HART协议输出）、（0～10/20）mA",{"_224":263,"_108":264,"_227":265,"_229":-5},"display","显示方式","数显",{"_224":267,"_108":268,"_227":269,"_229":-5},"measurement-rate","测量速率","0.2S",{"_224":271,"_108":272,"_227":273,"_229":-5},"compensation-temperature","补偿温度","-20～70 ℃",{"_224":275,"_108":276,"_227":277,"_229":-5},"process-connection","过程连接","M20×1.5外螺纹（Ф3内孔），或用户指定",{"_224":279,"_108":280,"_227":281,"_229":-5},"protection","防护等级","IP67",{"_224":283,"_108":284,"_227":285,"_229":-5},"emc","电磁兼容","射频保护符合 EN61326","sourceReviews",[],"documents",[],"supportDownloads",[]]
