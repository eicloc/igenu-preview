ts?category=water",{"_108":113,"_110":114},"工业测量","/zh-CN/products?category=industrial",{"_108":116,"_110":117},"气体检测","/zh-CN/products?category=gas",{"_103":119,"_105":120},"了解更多",[121,124,127,130,133],{"_108":122,"_110":123},"关于我们","/zh-CN/about",{"_108":125,"_110":126},"客户案例","/zh-CN/cases",{"_108":128,"_110":129},"新闻中心","/zh-CN/news",{"_108":131,"_110":132},"售后服务","/zh-CN/service",{"_108":134,"_110":135},"下载中心","/zh-CN/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig30codm",[],[],"seo",{"_103":146,"_147":148,"_149":150,"_151":152},"IG30CODM 有色溶解性有机物传感器 | IGENU SCIENCE","description","通过紫外荧光原理监测水体中的有色溶解性有机物，适用于江河湖泊、地下水及废水监测。紧凑探头结合自动清洁刷与数字通讯，便于长期在线布设。","imageUrl","/igenu-preview/media/3a4bd3a9ba0af3bd90061177.jpg","index",true,"canonical","https://eicloc.github.io/igenu-preview/zh-CN/products/ig30codm","query",{},"selected",[],"detail",{"_161":162,"_57":141,"_163":164,"_165":166,"_167":148,"_168":169,"_170":171,"_175":176,"_201":202,"_203":204,"_147":-5,"_205":206,"_207":208,"_209":210,"_211":212,"_280":281,"_282":283,"_284":285,"_144":145},"id","a4f89e53-652b-45dd-9cfa-d40ea54aa7f6","model","IG30CODM","name","IG30CODM 有色溶解性有机物传感器","shortDescription","featured",false,"category",{"_57":172,"_173":-5,"_165":109,"_147":-5,"_144":174},"water","brand",{"_103":109,"_147":-5,"_149":-5,"_151":152},"heroImage",{"_161":177,"_140":178,"_179":180,"_181":182,"_183":184,"_185":186,"_187":188,"_189":188,"_190":150,"_191":192,"_193":194},"e9c2938f-6236-4c7f-bf9d-752bcf98b444","IMAGE","originalName","2025040861512869.jpg","mimeType","image/jpeg","size",13520,"sha256","3a4bd3a9ba0af3bd90061177b116d1a851d9d410ca383514dfbd7fdb3aa5270f","width",540,"height","url","createdAt","2026-10-20T17:32:39.805Z","variants",[195,199],{"_187":196,"_189":196,"_181":197,"_190":198},320,"image/webp","/igenu-preview/media/9fb61c06fe27bcc0e9cecfd6.webp",{"_187":188,"_189":188,"_181":197,"_190":200},"/igenu-preview/media/b63396be40013d2d55e983f5.webp","detailLayout","STRUCTURED","availableLocales",[11,20,17],"bodyHtml","<p><strong><span>产品特点：</span></strong></p><p>◆传感器，采用紫外荧光分析法原理，专门检测水体的有色可溶解性有机物</p><p>◆适用于江河湖泊的有色可溶解性有机物的测量，具有灵敏度高，体积小、带自动清洁刷等特点，适合长期在线监测</p><p>◆应用于环境监测，地下水监测，海洋研究，废水处理等领域</p><p>◆RS485输出，支持MODBUS，可轻松集成于水质监测系统，满足客户需求</p><p><strong> </strong></p><p><strong><span>应用领域：</span></strong></p><p>环境监测、地下水监测、海洋研究、废水处理</p><p><strong> </strong></p><p><strong><span>技术参数：</span></strong></p><p>测量范围：0-400ppb</p><p>测量原理：紫外荧光法</p><p>测量精度： 读数的± 3%</p><p>重复性：小于±3% </p><p>检测限：0.1 ppb</p><p>响应时间：4s</p><p>线性度：R2＞0.999（标液连续稀释）</p><p>水样需求：流速：0-3m/s;压力：0-100Psi；0-6bar;温度：0-50℃</p><p>通讯接口：ModbusRS485</p><p>螺纹接口：标准3/4NPT</p><p>防护等级：IP68</p><p>安装方式：投入式、流通式</p><p>线缆长度：标准10m，可延长</p><p>传感器材料：316L</p><p>电极尺寸：190mm*46 mm</p><br />\n    ","gallery",[],"features",[],"specificationGroups",[213],{"_165":214,"_215":216},"技术参数","specifications",[217,224,228,232,236,240,244,248,252,256,260,264,268,272,276],{"_218":219,"_108":220,"_221":222,"_223":-5},"key","measurement-range","测量范围","value","0-400ppb","unit",{"_218":225,"_108":226,"_221":227,"_223":-5},"measurement-principle","测量原理","紫外荧光法",{"_218":229,"_108":230,"_221":231,"_223":-5},"accuracy","测量精度","读数的± 3%",{"_218":233,"_108":234,"_221":235,"_223":-5},"repeatability","重复性","小于±3%",{"_218":237,"_108":238,"_221":239,"_223":-5},"detection-limit","检测限","0.1 ppb",{"_218":241,"_108":242,"_221":243,"_223":-5},"response-time","响应时间","4s",{"_218":245,"_108":246,"_221":247,"_223":-5},"linearity","线性度","R2＞0.999（标液连续稀释）",{"_218":249,"_108":250,"_221":251,"_223":-5},"water-sample","水样需求","流速：0-3m/s;压力：0-100Psi；0-6bar;温度：0-50℃",{"_218":253,"_108":254,"_221":255,"_223":-5},"digital-communication","通讯接口","ModbusRS485",{"_218":257,"_108":258,"_221":259,"_223":-5},"thread","螺纹接口","标准3/4NPT",{"_218":261,"_108":262,"_221":263,"_223":-5},"protection","防护等级","IP68",{"_218":265,"_108":266,"_221":267,"_223":-5},"installation","安装方式","投入式、流通式",{"_218":269,"_108":270,"_221":271,"_223":-5},"cable","线缆长度","标准10m，可延长",{"_218":273,"_108":274,"_221":275,"_223":-5},"sensor-material","传感器材料","316L",{"_218":277,"_108":278,"_221":279,"_223":-5},"electrode-size","电极尺寸","190mm*46 mm","sourceReviews",[],"documents",[],"supportDownloads",[]]
