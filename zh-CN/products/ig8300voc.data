[{"_1":2,"_7":8},"root",{"_3":4},"data",{"_5":6},"productView","grid","content",{"_3":9},{"_10":11,"_12":13,"_14":15,"_140":58,"_57":141,"_64":142,"_70":143,"_144":145,"_153":154,"_155":156,"_157":158,"_159":160},"locale","zh-CN","origin","https://eicloc.github.io","settings",{"_16":17,"_18":19,"_21":22,"_23":24,"_54":55,"_86":87,"_88":89,"_26":27,"_28":29,"_37":-5,"_90":91,"_92":-5,"_93":94,"_95":96,"_97":98,"_99":-5,"_100":101,"_136":-5,"_137":-5,"_138":139},"defaultLocale","en","enabledLocales",[17,11,20],"de","logoUrl","/igenu-preview/media/f607ce2a51366ba8778f1000.jpg","regionalContacts",[25,39,47],{"_26":27,"_28":29,"_30":31,"_35":36,"_37":38},"email","Germany@igenu.com","phone","0049-935890-024","labels",{"_20":32,"_17":33,"_11":34},"Deutschland","Germany","德国","region","GERMANY","address","",{"_26":40,"_28":41,"_30":42,"_35":46,"_37":38},"cn@igenu.com","400-002-1266",{"_20":43,"_17":44,"_11":45},"Servicezentrum China","China service center","中国服务中心","CHINA",{"_26":48,"_28":38,"_30":49,"_35":53,"_37":38},"info@igenu-germany.com",{"_20":50,"_17":51,"_11":52},"Internationale Anfragen","International enquiries","国际业务咨询","INTERNATIONAL","navigation",[56,63,69,75,81],{"_57":58,"_30":59},"slug","products",{"_20":60,"_17":61,"_11":62},"Instrumente","Instruments","产品中心",{"_57":64,"_30":65},"parameters",{"_20":66,"_17":67,"_11":68},"Messparameter","Parameters","测量参数",{"_57":70,"_30":71},"applications",{"_20":72,"_17":73,"_11":74},"Anwendungen","Applications","应用方案",{"_57":76,"_30":77},"about",{"_20":78,"_17":79,"_11":80},"Über IGENU","About IGENU","关于 IGENU",{"_57":82,"_30":83},"service",{"_20":84,"_17":84,"_11":85},"Support","服务支持","companyName","IGENU SCIENCE","tagline","洞察环境，明晰工业。","footer","从水质分析、工业过程到气体检测，以测量仪器连接每一项工况需求。","copyright","primaryCta","联系专家","primaryCtaUrl","/contact","socialLinks",{},"defaultSeoImageUrl","footerNavigation",[102,118],{"_103":104,"_105":106},"title","产品","links",[107,112,115],{"_108":109,"_110":111},"label","水质分析","href","/zh-CN/products?category=water",{"_108":113,"_110":114},"工业测量","/zh-CN/products?category=industrial",{"_108":116,"_110":117},"气体检测","/zh-CN/products?category=gas",{"_103":119,"_105":120},"了解更多",[121,124,127,130,133],{"_108":122,"_110":123},"关于我们","/zh-CN/about",{"_108":125,"_110":126},"客户案例","/zh-CN/cases",{"_108":128,"_110":129},"新闻中心","/zh-CN/news",{"_108":131,"_110":132},"售后服务","/zh-CN/service",{"_108":134,"_110":135},"下载中心","/zh-CN/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig8300voc",[],[],"seo",{"_103":146,"_147":148,"_149":150,"_151":152},"IG8300VOC 恶臭与气体在线监测系统 | IGENU SCIENCE","description","通过多传感器配置监测相关恶臭气体，结合样气预处理、温度补偿与自动校准功能。集成显示、数据存储及通讯，面向污水、化工、垃圾处理等场所的环境在线监测。","imageUrl","/igenu-preview/media/97c97b1129c8237eb4b7d324.jpg","index",true,"canonical","https://eicloc.github.io/igenu-preview/zh-CN/products/ig8300voc","query",{},"selected",[],"detail",{"_161":162,"_57":141,"_163":164,"_165":166,"_167":148,"_168":169,"_170":171,"_175":176,"_199":200,"_201":202,"_147":-5,"_203":204,"_205":206,"_207":208,"_209":210,"_289":290,"_291":292,"_293":294,"_144":145},"id","0ebe2f55-73e5-48ce-b7d2-aab462d75429","model","IG8300VOC","name","IG8300VOC 恶臭与气体在线监测系统","shortDescription","featured",false,"category",{"_57":172,"_173":-5,"_165":116,"_147":-5,"_144":174},"gas","brand",{"_103":116,"_147":-5,"_149":-5,"_151":152},"heroImage",{"_161":177,"_140":178,"_179":180,"_181":182,"_183":184,"_185":186,"_187":188,"_189":190,"_191":150,"_192":193,"_194":195},"248b037a-97ca-43b1-abac-a26d2deaf089","IMAGE","originalName","2025040852682581.png","mimeType","image/jpeg","size",22439,"sha256","97c97b1129c8237eb4b7d324799035ec948f856036b41f67613d22e0171553b0","width",194,"height",421,"url","createdAt","2026-10-20T17:32:39.720Z","variants",[196],{"_187":188,"_189":190,"_181":197,"_191":198},"image/webp","/igenu-preview/media/51378fe539ff38c9e791e3c9.webp","detailLayout","STRUCTURED","availableLocales",[11,20,17],"bodyHtml","<p><strong><span>产品特点：</span></strong></p><p>◆采用高精度电化学传感器，性能可靠稳定 </p><p>◆配备独立算法，确保数据精准可靠 </p><p>◆内置除尘、除水散热等多重预处理系统，有效延长使用寿命 </p><p>◆集成温度补偿技术+自动校准技术，智能校准无需人工干预</p><p>◆集成GPRS通信技术，实时监测数据可对接环保局平台</p><p>◆采用7英寸工业触摸显示屏、大屏显示更清晰</p><p>◆内置16G内存卡，数据可存储2-5年 </p><p>◆采用32位高速处理芯片、断电上电监测自动联网功能</p><p>◆传感器具备自动清洗、智能校准功能，365*24小时连续监测毫无压力 </p><p>◆特殊的外观设计，防干扰</p><p><strong> </strong></p><p><strong><span>应用领域：</span></strong></p><p>石油/化工 、工业制造 、污水处理、印刷、 垃圾、养殖</p><p><strong> </strong></p><p><strong><span>技术参数：</span></strong></p><p>检测气体： NH3、C9H9N、H2S、CH4S、C2SH6、C2H6S2、CS 2、C8H8、OU、VOC、T、H、PM2.5、PM10 </p><p>测量范围：恶臭：0-2000 NH3、C9H9N、H2S、CH4S、C2SH6、C2H6S2、CS 2、C8H8：0-100ppm, 挥发性气体（VOC）：0-100ppm PM2.5、PM10：0-1000ppb</p><p>分辨率：1OU;0.01ppm,1ppb </p><p>响应时间：T90≤20s </p><p>测量精度：±3% </p><p>线性误差：≤±1% </p><p>零点漂移：≤±1%（F.S/年）</p><p>恢复时间：≤20秒 </p><p>安装方式：立柱抱箍式、壁挂式 </p><p>重 复 性：≤±1% </p><p>防护等级：IP65 </p><p>温湿度：选配件，温度检测范围：-40 ～ 800℃，湿度检测范围：0-100%RH </p><p>报警设置：报警值可任意设置 </p><p>数据存储：标配10万条以上数据存储,支持大容量SD卡, 数据连续存储一年以上,自由设置数据存储间隔时间</p><p>信号输出：支持RS485，GPRS，433M，NBIOT，LoRa等无线或有线传输方式</p><p>工作环境： 工作温度 -30 ～50℃（更高温湿度环境使 用需定制或选配预处理系统） 工作湿度: ≤95%RH，无冷凝 </p><p>工作压力: 0 ～ 100Kpa </p><p>工作电源: 220VAC</p><br />\n    ","gallery",[],"features",[],"specificationGroups",[211],{"_165":212,"_213":214},"技术参数","specifications",[215,222,226,230,234,238,242,246,250,254,257,261,265,269,273,277,281,285],{"_216":217,"_108":218,"_219":220,"_221":-5},"key","gas-detection","检测气体","value","NH3、C9H9N、H2S、CH4S、C2SH6、C2H6S2、CS 2、C8H8、OU、VOC、T、H、PM2.5、PM10","unit",{"_216":223,"_108":224,"_219":225,"_221":-5},"measurement-range","测量范围","恶臭：0-2000 NH3、C9H9N、H2S、CH4S、C2SH6、C2H6S2、CS 2、C8H8：0-100ppm, 挥发性气体（VOC）：0-100ppm PM2.5、PM10：0-1000ppb",{"_216":227,"_108":228,"_219":229,"_221":-5},"resolution","分辨率","1OU;0.01ppm,1ppb",{"_216":231,"_108":232,"_219":233,"_221":-5},"response-time","响应时间","T90≤20s",{"_216":235,"_108":236,"_219":237,"_221":-5},"accuracy","测量精度","±3%",{"_216":239,"_108":240,"_219":241,"_221":-5},"linearity","线性误差","≤±1%",{"_216":243,"_108":244,"_219":245,"_221":-5},"zero-drift","零点漂移","≤±1%（F.S/年）",{"_216":247,"_108":248,"_219":249,"_221":-5},"recovery-time","恢复时间","≤20秒",{"_216":251,"_108":252,"_219":253,"_221":-5},"installation","安装方式","立柱抱箍式、壁挂式",{"_216":255,"_108":256,"_219":241,"_221":-5},"repeatability","重 复 性",{"_216":258,"_108":259,"_219":260,"_221":-5},"protection","防护等级","IP65",{"_216":262,"_108":263,"_219":264,"_221":-5},"temperature-humidity","温湿度","选配件，温度检测范围：-40 ～ 800℃，湿度检测范围：0-100%RH",{"_216":266,"_108":267,"_219":268,"_221":-5},"alarm-settings","报警设置","报警值可任意设置",{"_216":270,"_108":271,"_219":272,"_221":-5},"data-storage","数据存储","标配10万条以上数据存储,支持大容量SD卡, 数据连续存储一年以上,自由设置数据存储间隔时间",{"_216":274,"_108":275,"_219":276,"_221":-5},"output","信号输出","支持RS485，GPRS，433M，NBIOT，LoRa等无线或有线传输方式",{"_216":278,"_108":279,"_219":280,"_221":-5},"operating-temperature","工作环境","工作温度 -30 ～50℃（更高温湿度环境使 用需定制或选配预处理系统） 工作湿度: ≤95%RH，无冷凝",{"_216":282,"_108":283,"_219":284,"_221":-5},"pressure","工作压力","0 ～ 100Kpa",{"_216":286,"_108":287,"_219":288,"_221":-5},"power-supply","工作电源","220VAC","sourceReviews",[],"documents",[],"supportDownloads",[]]
