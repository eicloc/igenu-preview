ts?category=water",{"_108":113,"_110":114},"工业测量","/zh-CN/products?category=industrial",{"_108":116,"_110":117},"气体检测","/zh-CN/products?category=gas",{"_103":119,"_105":120},"了解更多",[121,124,127,130,133],{"_108":122,"_110":123},"关于我们","/zh-CN/about",{"_108":125,"_110":126},"客户案例","/zh-CN/cases",{"_108":128,"_110":129},"新闻中心","/zh-CN/news",{"_108":131,"_110":132},"售后服务","/zh-CN/service",{"_108":134,"_110":135},"下载中心","/zh-CN/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig8100",[],[],"seo",{"_103":146,"_147":148,"_149":150,"_151":152},"IG8100 固定式气体检测报警仪 | IGENU SCIENCE","description","面向固定检测点的气体浓度监测，按目标气体配置检测元件，并提供现场声光报警。支持模拟与数字信号输出，便于与兼容的控制及监测系统连接。","imageUrl","/igenu-preview/media/839a34011d33d0b03a4d6173.jpg","index",true,"canonical","https://eicloc.github.io/igenu-preview/zh-CN/products/ig8100","query",{},"selected",[],"detail",{"_161":162,"_57":141,"_163":164,"_165":166,"_167":148,"_168":152,"_169":170,"_174":175,"_202":203,"_204":205,"_147":-5,"_206":207,"_208":209,"_225":226,"_227":228,"_312":313,"_314":315,"_316":317,"_144":145},"id","f3e2a88e-adb6-4f1f-8997-8600b01faa5a","model","IG8100","name","IG8100 固定式气体检测报警仪","shortDescription","featured","category",{"_57":171,"_172":-5,"_165":116,"_147":-5,"_144":173},"gas","brand",{"_103":116,"_147":-5,"_149":-5,"_151":152},"heroImage",{"_161":176,"_140":177,"_178":179,"_180":181,"_182":183,"_184":185,"_186":187,"_188":189,"_190":150,"_191":192,"_193":194},"a55ad70e-9d54-462e-a2ea-a827378021aa","IMAGE","originalName","2018040281324785.jpg","mimeType","image/jpeg","size",50456,"sha256","839a34011d33d0b03a4d61735b7686e5645b3091e52bd34545f51bda446373d6","width",339,"height",243,"url","createdAt","2026-10-20T17:32:39.606Z","variants",[195,200],{"_186":196,"_188":197,"_180":198,"_190":199},320,229,"image/webp","/igenu-preview/media/6d839fb13c7f64d9a04f573f.webp",{"_186":187,"_188":189,"_180":198,"_190":201},"/igenu-preview/media/023755c71cd1c8e5ab08db45.webp","detailLayout","STRUCTURED","availableLocales",[11,20,17],"bodyHtml","<p><strong><span>产品特点：</span></strong></p><p>◆三线制4-20mA、RS485(ModbusRTU)双信号输出， 完美兼容各类PLC/DCS控制系统</p><p>◆现场声光报警功能，大屏幕多参数LCD显示</p><p>◆可选配红外遥控，无需开盖即可调试 </p><p>◆科学合理的气室结构设计、采用航空品质的超高强度铝材、 优秀的表面处理技术，使用寿命更长</p><p><strong> </strong></p><p><strong><span>应用领域：</span></strong></p><p>石油/化工 、工业制造 、污水处理、电力电工、 金属冶炼</p><p><strong> </strong></p><p><strong><span>技术参数：</span></strong></p><p><strong>检测气体：</strong></p><p><strong>氧、硫及氧化物 </strong></p><p><a href=\"https://www.szwost.cn/product-17-1-24-1.html\" title=\"氧气 O2\" rel=\"noopener noreferrer\"><span>氧气 O2</span></a>、 <a href=\"https://www.szwost.cn/product-17-1-25-1.html\" title=\"臭氧 O3\" rel=\"noopener noreferrer\"><span>臭氧 O3</span></a>、 <a href=\"https://www.szwost.cn/product-17-1-35-1.html\" title=\"一氧化碳CO\" rel=\"noopener noreferrer\"><span>一氧化碳CO</span></a> 、<a href=\"https://www.szwost.cn/product-17-1-21-1.html\" title=\"二氧化碳CO2\" rel=\"noopener noreferrer\"><span>二氧化碳CO2</span></a> 、<a href=\"https://www.szwost.cn/product-17-1-34-1.html\" title=\"一氧化氮NO\" rel=\"noopener noreferrer\"><span>一氧化氮NO</span></a>、 <a href=\"https://www.szwost.cn/product-17-1-20-1.html\" title=\"二氧化氮NO2\" rel=\"noopener noreferrer\"><span>二氧化氮NO2</span></a>、 <a href=\"https://www.szwost.cn/product-17-1-164-1.html\" title=\"氮氧化物NOx\" rel=\"noopener noreferrer\"><span>氮氧化物NOx</span></a> 、<a href=\"https://www.szwost.cn/product-17-1-176-1.html\" title=\"二氧化硫SO2\" rel=\"noopener noreferrer\"><span>二氧化硫SO2</span></a>、 <a href=\"https://www.szwost.cn/product-17-1-177-1.html\" title=\"二氧化氯CLO2\" rel=\"noopener noreferrer\"><span>二氧化氯CLO2</span></a></p><p><strong>氮、氢及氰化物</strong></p><p><a href=\"https://www.szwost.cn/product-17-2-16-1.html\" title=\"氢气 H2\" rel=\"noopener noreferrer\"><span>氢气 H2</span></a> 、<a href=\"https://www.szwost.cn/product-17-2-17-1.html\" title=\"氨气 NH3\" rel=\"noopener noreferrer\"><span>氨气 NH3</span></a> 、<a href=\"https://www.szwost.cn/product-17-2-18-1.html\" title=\"硫化氢 H2S\" rel=\"noopener noreferrer\"><span>硫化氢 H2S</span></a> 、<a href=\"https://www.szwost.cn/product-17-2-33-1.html\" title=\"氮气N2\" rel=\"noopener noreferrer\"><span>氮气N2</span></a> 、<a href=\"https://www.szwost.cn/product-17-2-19-1.html\" title=\"氯化氢 HCL\" rel=\"noopener noreferrer\"><span>氯化氢 HCL</span></a> 、<a href=\"https://www.szwost.cn/product-17-2-36-1.html\" title=\"磷化氢PH3\" rel=\"noopener noreferrer\"><span>磷化氢PH3</span></a> 、<a href=\"https://www.szwost.cn/product-17-2-22-1.html\" title=\"氰化氢HCN\" rel=\"noopener noreferrer\"><span>氰化氢HCN</span></a>、 <a href=\"https://www.szwost.cn/product-17-2-37-1.html\" title=\"砷化氢AsH3\" rel=\"noopener noreferrer\"><span>砷化氢AsH3</span></a>、 <a href=\"https://www.szwost.cn/product-17-2-23-1.html\" title=\"氟化氢 HF\" rel=\"noopener noreferrer\"><span>氟化氢 HF</span></a></p><p><strong>烷类、可燃气体</strong></p><p><a href=\"https://www.szwost.cn/product-17-3-26-1.html\" title=\"可燃气体EX\" rel=\"noopener noreferrer\"><span>可燃气体EX</span></a>、 <a href=\"https://www.szwost.cn/product-17-3-44-1.html\" title=\"甲烷CH4\" rel=\"noopener noreferrer\"><span>甲烷CH4</span></a>、 <a href=\"https://www.szwost.cn/product-17-3-45-1.html\" title=\"乙烷C2H6\" rel=\"noopener noreferrer\"><span>乙烷C2H6</span></a> 、<a href=\"https://www.szwost.cn/product-17-3-28-1.html\" title=\"丙烷C3H8\" rel=\"noopener noreferrer\"><span>丙烷C3H8</span></a> 、<a href=\"https://www.szwost.cn/product-17-3-185-1.html\" title=\"环氧乙烷C2H4O\" rel=\"noopener noreferrer\"><span>环氧乙烷C2H4O</span></a></p><p><strong>有机挥发性气体</strong></p><p><a href=\"https://www.szwost.cn/product-17-4-27-1.html\" title=\"臭味ODOR\" rel=\"noopener noreferrer\"><span>臭味ODOR</span></a> 、<a href=\"https://www.szwost.cn/product-17-4-29-1.html\" title=\"苯C6H6\" rel=\"noopener noreferrer\"><span>苯C6H6</span></a> 、<a href=\"https://www.szwost.cn/product-17-4-30-1.html\" title=\"甲苯C7H8\" rel=\"noopener noreferrer\"><span>甲苯C7H8</span></a> 、<a href=\"https://www.szwost.cn/product-17-4-183-1.html\" title=\"二甲苯C8H10\" rel=\"noopener noreferrer\"><span>二甲苯C8H10</span></a> 、<a href=\"https://www.szwost.cn/product-17-4-184-1.html\" title=\"VOCs\" rel=\"noopener noreferrer\"><span>VOCs</span></a> 、<a href=\"https://www.szwost.cn/product-17-4-186-1.html\" title=\"甲醛CH2O\" rel=\"noopener noreferrer\"><span>甲醛CH2O</span></a> 、<a href=\"https://www.szwost.cn/product-17-4-187-1.html\" title=\"乙烯C2H4\" rel=\"noopener noreferrer\"><span>乙烯C2H4</span></a>、 <a href=\"https://www.szwost.cn/product-17-4-188-1.html\" title=\"乙醇C2H6O\" rel=\"noopener noreferrer\"><span>乙醇C2H6O</span></a> 、<a href=\"https://www.szwost.cn/product-17-4-189-1.html\" title=\"非甲烷总烃\" rel=\"noopener noreferrer\"><span>非甲烷总烃</span></a></p><p><strong>卤素、卤代烃</strong></p><p><a href=\"https://www.szwost.cn/product-17-5-46-1.html\" title=\"六氟化硫SF6\" rel=\"noopener noreferrer\"><span>六氟化硫SF6</span></a>、 <a href=\"https://www.szwost.cn/product-17-5-47-1.html\" title=\"氯气CL2\" rel=\"noopener noreferrer\"><span>氯气CL2</span></a>、 <a href=\"https://www.szwost.cn/product-17-5-48-1.html\" title=\"氟气F2\" rel=\"noopener noreferrer\"><span>氟气F2</span></a> 、<a href=\"https://www.szwost.cn/product-17-5-49-1.html\" title=\"溴气Br2\" rel=\"noopener noreferrer\"><span>溴气Br2</span></a></p><p> </p><p>检测原理：电化学法/红外法/催化燃烧/PID</p><p>测量范围：0~50/100ppm, 0~50/100%Vol </p><p>分辨率： 0.01ppm，0.01%VOL</p><p>检测下限：0.05ppm，0.05%VOL</p><p>精度：≤±1%F.S </p><p>零点漂移：≤±1%F.S/年 </p><p>响应时间：≤20 秒（T90）</p><p>恢复时间：≤20 秒 </p><p>显示方式：LCD 背光显示 </p><p>检测方式：扩散式测量，连续工作 </p><p>工作温度：-30℃~ ＋60℃ </p><p>工作湿度：5%~95%RH 无冷凝 </p><p>安装方式：壁挂式、管道式 </p><p>外壳材质：全铝外壳，氟碳漆耐腐蚀，坚固耐用 </p><p>防护等级：IP66 </p><p>报警方式：高低报警/区间报警/加权平均值报警</p><p>信号输出：三线制4-20mA、RS485(ModbusRTU)</p><p>数字信号：RS-485输出，ModBusRTU通讯协议（可选配） </p><p>尺寸：180mm*140mm*92mm（高*宽*厚）</p><br /><p></p>\n    ","gallery",[210],{"_161":211,"_140":177,"_178":212,"_180":181,"_182":213,"_184":214,"_186":215,"_188":216,"_190":217,"_191":218,"_193":219},"b85fe479-8089-4ee5-aa2a-db75eb8b0b74","2025040939442237.png",52081,"0c749136b26fb747638a2559e5b6057a6373b64df0d34ac5108e01e84a37