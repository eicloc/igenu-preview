ts?category=water",{"_108":113,"_110":114},"工业测量","/zh-CN/products?category=industrial",{"_108":116,"_110":117},"气体检测","/zh-CN/products?category=gas",{"_103":119,"_105":120},"了解更多",[121,124,127,130,133],{"_108":122,"_110":123},"关于我们","/zh-CN/about",{"_108":125,"_110":126},"客户案例","/zh-CN/cases",{"_108":128,"_110":129},"新闻中心","/zh-CN/news",{"_108":131,"_110":132},"售后服务","/zh-CN/service",{"_108":134,"_110":135},"下载中心","/zh-CN/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig5200",[],[],"seo",{"_103":146,"_147":148,"_149":150,"_151":152},"IG5200 温度变送器 | IGENU SCIENCE","description","将热电阻或热电偶测温元件与信号转换单元集成，提供与温度对应的电流输出及现场显示。便于接入监测设备，并通过就地读数辅助现场巡检与仪表查看。","imageUrl","/igenu-preview/media/0ef55182d75fdce9b0e8cdaf.png","index",true,"canonical","https://eicloc.github.io/igenu-preview/zh-CN/products/ig5200","query",{},"selected",[],"detail",{"_161":162,"_57":141,"_163":164,"_165":166,"_167":148,"_168":169,"_170":171,"_175":176,"_199":200,"_201":202,"_147":-5,"_203":204,"_205":206,"_207":208,"_209":210,"_274":275,"_276":277,"_278":279,"_144":145},"id","6bd17643-47a4-46c6-93c1-0b337edb7ec2","model","IG5200","name","IG5200 温度变送器","shortDescription","featured",false,"category",{"_57":172,"_173":-5,"_165":113,"_147":-5,"_144":174},"industrial","brand",{"_103":113,"_147":-5,"_149":-5,"_151":152},"heroImage",{"_161":177,"_140":178,"_179":180,"_181":182,"_183":184,"_185":186,"_187":188,"_189":190,"_191":150,"_192":193,"_194":195},"48490d76-c117-4813-9e44-d08d44e53200","IMAGE","originalName","2025041052499693.jpg","mimeType","image/png","size",105279,"sha256","0ef55182d75fdce9b0e8cdaf4c03e078ea6eeb5578a6154000d2e3efca25ae71","width",183,"height",677,"url","createdAt","2026-10-20T17:32:39.916Z","variants",[196],{"_187":188,"_189":190,"_181":197,"_191":198},"image/webp","/igenu-preview/media/565e37464151b9fb7246a52e.webp","detailLayout","STRUCTURED","availableLocales",[20,11,17],"bodyHtml","<p><strong><span>产品特点：</span></strong></p><p>◆信号准确、可远传（最大1000米）</p><p>◆精度高、抗干扰、长期稳定性好、免维护</p><p>◆变送器可以现场显示测量</p><p>◆量程：-200℃～1200℃；常规精度：± 0.25%</p><p> </p><p><strong><span>技术参数：</span></strong></p><p>测量范围：-200-1200℃</p><table> <tbody><tr>  <td><p>热电阻测温范围  </p></td>  <td><p>：-200～450℃；        -50～150℃</p></td> </tr> <tr>  <td><p>热电偶测温范围   </p></td>  <td><p> </p>  <p>：  0℃-1200℃；             0℃-800℃；</p>  <p>  0℃-1600℃               <strong>  0℃-1800℃</strong></p></td> </tr> <tr>  <td><p>测量精度：</p></td>  <td><p>&lt;热电阻&gt; ± 0.25%； ± 0.5%；  &lt;热电偶&gt; ± 0.75%</p></td> </tr> <tr>  <td><p>输出信号：</p>  <p>温    漂：</p></td>  <td><p>4-20mA</p>  <p>± 0.025%/℃</p></td> </tr> <tr>  <td><p>时    漂：</p></td>  <td><p>每年小于± 0.5%</p></td> </tr> <tr>  <td><p>环境温度：</p></td>  <td><p>-10～85℃</p></td> </tr> <tr>  <td><p>供电电压：</p></td>  <td><p>24V DC    ± 10%</p></td> </tr> <tr>  <td><p>负载能力：</p></td>  <td><p>0-500 Ω</p></td> </tr> <tr>  <td><p>显示范围：</p></td>  <td><p>-1999～1999</p></td> </tr> <tr>  <td><p>防护等级：</p></td>  <td><p>IP65</p></td> </tr> <tr>  <td><p>隔爆等级：</p></td>  <td><p>dII BT6</p></td> </tr> <tr>  <td><p>保护管材质：</p></td>  <td><p>1Cr18Ni9Ti或陶瓷或钢玉管</p></td> </tr></tbody></table><br />\n    ","gallery",[],"features",[],"specificationGroups",[211],{"_165":212,"_213":214},"技术参数","specifications",[215,222,226,230,234,238,242,246,250,254,258,262,266,270],{"_216":217,"_108":218,"_219":220,"_221":-5},"key","measurement-range","测量范围","value","-200-1200℃","unit",{"_216":223,"_108":224,"_219":225,"_221":-5},"thermistor-range","热电阻测温范围","：-200～450℃；       -50～150℃",{"_216":227,"_108":228,"_219":229,"_221":-5},"thermocouple-range","热电偶测温范围","：  0℃-1200℃；            0℃-800℃；\n0℃-1600℃                0℃-1800℃",{"_216":231,"_108":232,"_219":233,"_221":-5},"accuracy","测量精度","<热电阻> ± 0.25%； ± 0.5%； <热电偶> ± 0.75%",{"_216":235,"_108":236,"_219":237,"_221":-5},"output","输出信号","4-20mA",{"_216":239,"_108":240,"_219":241,"_221":-5},"temperature-drift","温    漂","± 0.025%/℃",{"_216":243,"_108":244,"_219":245,"_221":-5},"time-drift","时    漂","每年小于± 0.5%",{"_216":247,"_108":2