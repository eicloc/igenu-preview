[{"_1":2,"_7":8},"root",{"_3":4},"data",{"_5":6},"productView","grid","content",{"_3":9},{"_10":11,"_12":13,"_14":15,"_140":58,"_57":141,"_64":142,"_70":143,"_144":145,"_153":154,"_155":156,"_157":158,"_159":160},"locale","zh-CN","origin","https://eicloc.github.io","settings",{"_16":17,"_18":19,"_21":22,"_23":24,"_54":55,"_86":87,"_88":89,"_26":27,"_28":29,"_37":-5,"_90":91,"_92":-5,"_93":94,"_95":96,"_97":98,"_99":-5,"_100":101,"_136":-5,"_137":-5,"_138":139},"defaultLocale","en","enabledLocales",[17,11,20],"de","logoUrl","/igenu-preview/media/f607ce2a51366ba8778f1000.jpg","regionalContacts",[25,39,47],{"_26":27,"_28":29,"_30":31,"_35":36,"_37":38},"email","Germany@igenu.com","phone","0049-935890-024","labels",{"_20":32,"_17":33,"_11":34},"Deutschland","Germany","德国","region","GERMANY","address","",{"_26":40,"_28":41,"_30":42,"_35":46,"_37":38},"cn@igenu.com","400-002-1266",{"_20":43,"_17":44,"_11":45},"Servicezentrum China","China service center","中国服务中心","CHINA",{"_26":48,"_28":38,"_30":49,"_35":53,"_37":38},"info@igenu-germany.com",{"_20":50,"_17":51,"_11":52},"Internationale Anfragen","International enquiries","国际业务咨询","INTERNATIONAL","navigation",[56,63,69,75,81],{"_57":58,"_30":59},"slug","products",{"_20":60,"_17":61,"_11":62},"Instrumente","Instruments","产品中心",{"_57":64,"_30":65},"parameters",{"_20":66,"_17":67,"_11":68},"Messparameter","Parameters","测量参数",{"_57":70,"_30":71},"applications",{"_20":72,"_17":73,"_11":74},"Anwendungen","Applications","应用方案",{"_57":76,"_30":77},"about",{"_20":78,"_17":79,"_11":80},"Über IGENU","About IGENU","关于 IGENU",{"_57":82,"_30":83},"service",{"_20":84,"_17":84,"_11":85},"Support","服务支持","companyName","IGENU SCIENCE","tagline","洞察环境，明晰工业。","footer","从水质分析、工业过程到气体检测，以测量仪器连接每一项工况需求。","copyright","primaryCta","联系专家","primaryCtaUrl","/contact","socialLinks",{},"defaultSeoImageUrl","footerNavigation",[102,118],{"_103":104,"_105":106},"title","产品","links",[107,112,115],{"_108":109,"_110":111},"label","水质分析","href","/zh-CN/products?category=water",{"_108":113,"_110":114},"工业测量","/zh-CN/products?category=industrial",{"_108":116,"_110":117},"气体检测","/zh-CN/products?category=gas",{"_103":119,"_105":120},"了解更多",[121,124,127,130,133],{"_108":122,"_110":123},"关于我们","/zh-CN/about",{"_108":125,"_110":126},"客户案例","/zh-CN/cases",{"_108":128,"_110":129},"新闻中心","/zh-CN/news",{"_108":131,"_110":132},"售后服务","/zh-CN/service",{"_108":134,"_110":135},"下载中心","/zh-CN/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig70vm",[],[],"seo",{"_103":146,"_147":148,"_149":150,"_151":152},"IG70VM 热式气体质量流量计 | IGENU SCIENCE","description","通过热传导与温差测量原理获取气体质量流量，传感部分无活动部件。提供信号及通讯接口，便于石油化工、热电和冶炼等场景中的气体流量监测接入。","imageUrl","/igenu-preview/media/7f449f38ed6bf8e134b99b22.png","index",true,"canonical","https://eicloc.github.io/igenu-preview/zh-CN/products/ig70vm","query",{},"selected",[],"detail",{"_161":162,"_57":141,"_163":164,"_165":166,"_167":148,"_168":169,"_170":171,"_175":176,"_199":200,"_201":202,"_147":-5,"_203":204,"_205":206,"_220":221,"_222":223,"_287":288,"_289":290,"_291":292,"_144":145},"id","c21fd893-48c8-47d3-a114-c7748db71a81","model","IG70VM","name","IG70VM 热式气体质量流量计","shortDescription","featured",false,"category",{"_57":172,"_173":-5,"_165":113,"_147":-5,"_144":174},"industrial","brand",{"_103":113,"_147":-5,"_149":-5,"_151":152},"heroImage",{"_161":177,"_140":178,"_179":180,"_181":182,"_183":184,"_185":186,"_187":188,"_189":190,"_191":150,"_192":193,"_194":195},"287d31f2-573d-40b0-8a95-78fa8fb30365","IMAGE","originalName","2025040855196033.jpg","mimeType","image/png","size",118746,"sha256","7f449f38ed6bf8e134b99b22ebc9fa0c38477f3744c6a59cd166d471f92c6feb","width",255,"height",555,"url","createdAt","2026-10-20T17:32:39.741Z","variants",[196],{"_187":188,"_189":190,"_181":197,"_191":198},"image/webp","/igenu-preview/media/e43bee78aa0a1ae068fb4bf4.webp","detailLayout","STRUCTURED","availableLocales",[11,20,17],"bodyHtml","<p></p><p><strong><span>产品特点：</span></strong></p><p>◆真正的质量流量计，对气体流量测量无需温度和压力补偿，测量方便、准确。可得到气体的质量流量或者标准体积流量</p><p>◆宽量程比，可测量流速高至100Nm/s底至0.2Nm/s的气体，可以用于气体检漏 </p><p>◆抗震性能好使用寿命长。传感器无活动部件和压力传感部件，不受震动对测量精度的影响</p><p>◆安装维修简便。在现场条件允许的情况下，可以实现不停产安装和维护 </p><p>◆采用RS-485通讯，或HART通讯，可以实现工厂自动化、集成化</p><p><strong> </strong></p><p><strong><span>应用领域：</span></strong></p><p>石油化工 、环保、水处理 、热电、冶炼 、医疗</p><p><strong> </strong></p><p><strong><span>技术参数：</span></strong></p><p>测量介质：各种气体（乙炔气体除外） </p><p>测量范围：DN10~4000mm  ND25~2000mm </p><p>流速：0.2~100Nm/s </p><p>准确度：±0.5% </p><p>工作温度：传感器：常温型-10～200℃高温型-10～350℃ 转换器：-20～45℃ </p><p>工作压力：介质压力≤2.5Mpa 介质压力≤4Mpa </p><p>供电电源：一体机（DC24V 或者AC220V≤18W）分体式（AC220V≤19W） </p><p>响应速度：1S </p><p>输出：4-20mA(光电隔离，最大负载500Ω)，RS485(光电隔离)，HART协议</p><p>管道材质：碳钢、不锈钢、塑料等 </p><p>显示：四行液晶显示 </p><p>显示内容：质量流量、标况体积流量、累积流量、标准时间、累积运行时间、 介质温度、标准流速等 </p><p>防护等级：一次表IP67 </p><p>传感器材质：不锈钢不锈钢/碳钢</p><br /><br />\n    ","gallery",[207],{"_161":208,"_140":178,"_179":209,"_181":210,"_183":211,"_185":212,"_187":213,"_189":214,"_191":215,"_192":216,"_194":217},"065cc5b0-e98f-4705-b61d-45043501843d","2022042942150065.jpg","image/jpeg",16946,"4992623265b6e7526ebac02e17ae603479bf473915f8bd172a72f5ba5954fc5b",251,399,"/igenu-preview/media/4992623265b6e7526ebac02e.jpg","2026-10-20T17:32:39.680Z",[218],{"_187":213,"_189":214,"_181":197,"_191":219},"/igenu-preview/media/9e57d7becb2756c38d1975b2.webp","features",[],"specificationGroups",[224],{"_165":225,"_226":227},"技术参数","specifications",[228,235,239,243,247,251,255,259,263,267,271,275,279,283],{"_229":230,"_108":231,"_232":233,"_234":-5},"key","medium","测量介质","value","各种气体（乙炔气体除外）","unit",{"_229":236,"_108":237,"_232":238,"_234":-5},"measurement-range","测量范围","DN10~4000mm  ND25~2000mm",{"_229":240,"_108":241,"_232":242,"_234":-5},"flow-rate","流速","0.2~100Nm/s",{"_229":244,"_108":245,"_232":246,"_234":-5},"accuracy","准确度","±0.5%",{"_229":248,"_108":249,"_232":250,"_234":-5},"operating-temperature","工作温度","传感器：常温型-10～200℃高温型-10～350℃ 转换器：-20～45℃",{"_229":252,"_108":253,"_232":254,"_234":-5},"pressure","工作压力","介质压力≤2.5Mpa 介质压力≤4Mpa",{"_229":256,"_108":257,"_232":258,"_234":-5},"power-supply","供电电源","一体机（DC24V 或者AC220V≤18W）分体式（AC220V≤19W）",{"_229":260,"_108":261,"_232":262,"_234":-5},"response-time","响应速度","1S",{"_229":264,"_108":265,"_232":266,"_234":-5},"output","输出","4-20mA(光电隔离，最大负载500Ω)，RS485(光电隔离)，HART协议",{"_229":268,"_108":269,"_232":270,"_234":-5},"pipeline-material","管道材质","碳钢、不锈钢、塑料等",{"_229":272,"_108":273,"_232":274,"_234":-5},"display","显示","四行液晶显示",{"_229":276,"_108":277,"_232":278,"_234":-5},"display-content","显示内容","质量流量、标况体积流量、累积流量、标准时间、累积运行时间、 介质温度、标准流速等",{"_229":280,"_108":281,"_232":282,"_234":-5},"protection","防护等级","一次表IP67",{"_229":284,"_108":285,"_232":286,"_234":-5},"sensor-material","传感器材质","不锈钢不锈钢/碳钢","sourceReviews",[],"documents",[],"supportDownloads",[]]
