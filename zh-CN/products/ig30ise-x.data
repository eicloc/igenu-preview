[{"_1":2,"_7":8},"root",{"_3":4},"data",{"_5":6},"productView","grid","content",{"_3":9},{"_10":11,"_12":13,"_14":15,"_140":58,"_57":141,"_64":142,"_70":143,"_144":145,"_153":154,"_155":156,"_157":158,"_159":160},"locale","zh-CN","origin","https://eicloc.github.io","settings",{"_16":17,"_18":19,"_21":22,"_23":24,"_54":55,"_86":87,"_88":89,"_26":27,"_28":29,"_37":-5,"_90":91,"_92":-5,"_93":94,"_95":96,"_97":98,"_99":-5,"_100":101,"_136":-5,"_137":-5,"_138":139},"defaultLocale","en","enabledLocales",[17,11,20],"de","logoUrl","/igenu-preview/media/f607ce2a51366ba8778f1000.jpg","regionalContacts",[25,39,47],{"_26":27,"_28":29,"_30":31,"_35":36,"_37":38},"email","Germany@igenu.com","phone","0049-935890-024","labels",{"_20":32,"_17":33,"_11":34},"Deutschland","Germany","德国","region","GERMANY","address","",{"_26":40,"_28":41,"_30":42,"_35":46,"_37":38},"cn@igenu.com","400-002-1266",{"_20":43,"_17":44,"_11":45},"Servicezentrum China","China service center","中国服务中心","CHINA",{"_26":48,"_28":38,"_30":49,"_35":53,"_37":38},"info@igenu-germany.com",{"_20":50,"_17":51,"_11":52},"Internationale Anfragen","International enquiries","国际业务咨询","INTERNATIONAL","navigation",[56,63,69,75,81],{"_57":58,"_30":59},"slug","products",{"_20":60,"_17":61,"_11":62},"Instrumente","Instruments","产品中心",{"_57":64,"_30":65},"parameters",{"_20":66,"_17":67,"_11":68},"Messparameter","Parameters","测量参数",{"_57":70,"_30":71},"applications",{"_20":72,"_17":73,"_11":74},"Anwendungen","Applications","应用方案",{"_57":76,"_30":77},"about",{"_20":78,"_17":79,"_11":80},"Über IGENU","About IGENU","关于 IGENU",{"_57":82,"_30":83},"service",{"_20":84,"_17":84,"_11":85},"Support","服务支持","companyName","IGENU SCIENCE","tagline","洞察环境，明晰工业。","footer","从水质分析、工业过程到气体检测，以测量仪器连接每一项工况需求。","copyright","primaryCta","联系专家","primaryCtaUrl","/contact","socialLinks",{},"defaultSeoImageUrl","footerNavigation",[102,118],{"_103":104,"_105":106},"title","产品","links",[107,112,115],{"_108":109,"_110":111},"label","水质分析","href","/zh-CN/products?category=water",{"_108":113,"_110":114},"工业测量","/zh-CN/products?category=industrial",{"_108":116,"_110":117},"气体检测","/zh-CN/products?category=gas",{"_103":119,"_105":120},"了解更多",[121,124,127,130,133],{"_108":122,"_110":123},"关于我们","/zh-CN/about",{"_108":125,"_110":126},"客户案例","/zh-CN/cases",{"_108":128,"_110":129},"新闻中心","/zh-CN/news",{"_108":131,"_110":132},"售后服务","/zh-CN/service",{"_108":134,"_110":135},"下载中心","/zh-CN/downloads","cooperationTitle","cooperationBody","footerQrCodes",[],"kind","ig30ise-x",[],[],"seo",{"_103":146,"_147":148,"_149":150,"_151":152},"IG30ISE-X 离子选择性电极 | IGENU SCIENCE","description","采用离子选择性电极法，按配置监测水中离子参数与pH。探头可直接浸入水中，无需独立采样系统，并提供补偿及校准功能，适用于饮用水、环境与污水监测。","imageUrl","/igenu-preview/media/8936108072d3c61053c40f38.png","index",true,"canonical","https://eicloc.github.io/igenu-preview/zh-CN/products/ig30ise-x","query",{},"selected",[],"detail",{"_161":162,"_57":141,"_163":164,"_165":166,"_167":148,"_168":169,"_170":171,"_175":176,"_199":200,"_201":202,"_147":-5,"_203":204,"_205":206,"_207":208,"_209":210,"_312":313,"_314":315,"_316":317,"_144":145},"id","0edda979-2d5f-4caa-bde7-a1368da21597","model","IG30ISE-X","name","IG30ISE-X 离子选择性电极","shortDescription","featured",false,"category",{"_57":172,"_173":-5,"_165":109,"_147":-5,"_144":174},"water","brand",{"_103":109,"_147":-5,"_149":-5,"_151":152},"heroImage",{"_161":177,"_140":178,"_179":180,"_181":182,"_183":184,"_185":186,"_187":188,"_189":190,"_191":150,"_192":193,"_194":195},"c6e3c765-909d-45fd-bd1c-7dbc51fecd54","IMAGE","originalName","2025041051038309.png","mimeType","image/png","size",13330,"sha256","8936108072d3c61053c40f382494eb98c8734713fb66a99450bf2aedb26fb684","width",320,"height",120,"url","createdAt","2026-10-20T17:32:39.882Z","variants",[196],{"_187":188,"_189":190,"_181":197,"_191":198},"image/webp","/igenu-preview/media/f11ab30d5325a31abe0f2adb.webp","detailLayout","STRUCTURED","availableLocales",[11,20,17],"bodyHtml","<p><strong><span>产品特点：</span></strong></p><p>◆稳定可靠、离子选择性法和多参数补偿技术，测量准确、稳定</p><p>◆安装简单，传感器直接浸没水中，无需采样</p><p>◆维护简单，只需定期校准和清洗</p><p>◆具备温度、pH、钾离子等自动补偿功能</p><p>◆多参数显示和输出功能，一机多用</p><p>◆具备单点及多点校准</p><p><strong> </strong></p><p><strong><span>应用领域：</span></strong></p><p>环境监测 、饮用及地表水监测 、工业废水、污水 、生活废水、污水 、地下水、湖泊水</p><p><strong> </strong></p><p><strong><span>技术参数：</span></strong></p><p>测量原理：离子选择电极法</p><p>详细测量原理：离子载体膜、无孔参比电极</p><p>测量参数：氨氮、硝氮、pH、钾离子、氯离子、氟离子</p><p>测量范围：氨离子：0.1-1000mg/L(最大可达10000mg/L)</p><p>硝氮：0.1-1000mg/L(最大可达10000mg/L)</p><p>氯离子：0.1-1000mg/L(最大可达10000mg/L)</p><p>钾离子：0.1-1000mg/L(最大可达10000mg/L)</p><p>pH：2-12pH</p><p>氟离子：0.1-1000mg/L(最大可达10000mg/L)</p><p>准确度：读数的±3%或±0.1 mg/L，取大者</p><p>分辨率：0.01 mg/L，0.01 pH</p><p>重复性：±1%FS</p><p>响应时间：T90≤30s,氟离子T90≤60s</p><p>钾离子补偿：手动或自动 </p><p>pH补偿：手动或自动</p><p>温度补偿：自动</p><p>校准：单点校准、两点校准</p><p>操作温度：0~45℃ （氟离子可达60℃）</p><p>存储温度：-10~50℃ </p><p>防护等级：IP68</p><p>主体材质：316L、POM</p><p>自动清洗：压缩空气（可选）</p><p>线缆长度：标准10m，可延长 </p><p>功耗：1W max</p><p>传感器尺寸：264mm*55mm</p><br />\n    ","gallery",[],"features",[],"specificationGroups",[211],{"_165":212,"_213":214},"技术参数","specifications",[215,222,226,228,232,236,239,242,246,249,253,257,261,265,269,272,276,280,284,288,292,296,300,304,308],{"_216":217,"_108":218,"_219":220,"_221":-5},"key","measurement-principle","测量原理","value","离子选择电极法","unit",{"_216":223,"_108":224,"_219":225,"_221":-5},"detailed-principle","详细测量原理","离子载体膜、无孔参比电极",{"_216":64,"_108":68,"_219":227,"_221":-5},"氨氮、硝氮、pH、钾离子、氯离子、氟离子",{"_216":229,"_108":230,"_219":231,"_221":-5},"measurement-range","测量范围","氨离子：0.1-1000mg/L(最大可达10000mg/L)",{"_216":233,"_108":234,"_219":235,"_221":-5},"nitrate-range","硝氮","0.1-1000mg/L(最大可达10000mg/L)",{"_216":237,"_108":238,"_219":235,"_221":-5},"chloride-range","氯离子",{"_216":240,"_108":241,"_219":235,"_221":-5},"potassium-range","钾离子",{"_216":243,"_108":244,"_219":245,"_221":-5},"ph-range","pH","2-12pH",{"_216":247,"_108":248,"_219":235,"_221":-5},"fluoride-range","氟离子",{"_216":250,"_108":251,"_219":252,"_221":-5},"accuracy","准确度","读数的±3%或±0.1 mg/L，取大者",{"_216":254,"_108":255,"_219":256,"_221":-5},"resolution","分辨率","0.01 mg/L，0.01 pH",{"_216":258,"_108":259,"_219":260,"_221":-5},"repeatability","重复性","±1%FS",{"_216":262,"_108":263,"_219":264,"_221":-5},"response-time","响应时间","T90≤30s,氟离子T90≤60s",{"_216":266,"_108":267,"_219":268,"_221":-5},"potassium-compensation","钾离子补偿","手动或自动",{"_216":270,"_108":271,"_219":268,"_221":-5},"ph-compensation","pH补偿",{"_216":273,"_108":274,"_219":275,"_221":-5},"temperature-compensation","温度补偿","自动",{"_216":277,"_108":278,"_219":279,"_221":-5},"calibration","校准","单点校准、两点校准",{"_216":281,"_108":282,"_219":283,"_221":-5},"operating-temperature","操作温度","0~45℃ （氟离子可达60℃）",{"_216":285,"_108":286,"_219":287,"_221":-5},"storage-temperature","存储温度","-10~50℃",{"_216":289,"_108":290,"_219":291,"_221":-5},"protection","防护等级","IP68",{"_216":293,"_108":294,"_219":295,"_221":-5},"material","主体材质","316L、POM",{"_216":297,"_108":298,"_219":299,"_221":-5},"automatic-cleaning","自动清洗","压缩空气（可选）",{"_216":301,"_108":302,"_219":303,"_221":-5},"cable","线缆长度","标准10m，可延长",{"_216":305,"_108":306,"_219":307,"_221":-5},"power-consumption","功耗","1W max",{"_216":309,"_108":310,"_219":311,"_221":-5},"sensor-size","传感器尺寸","264mm*55mm","sourceReviews",[],"documents",[],"supportDownloads",[]]
