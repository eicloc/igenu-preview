f06cbfde7cd.webp",{"_160":216,"_57":412,"_234":413,"_236":414,"_238":415,"_240":353,"_163":416,"_244":418},"ig30codm","IG30CODM","IG30CODM 有色溶解性有机物传感器","通过紫外荧光原理监测水体中的有色溶解性有机物，适用于江河湖泊、地下水及废水监测。紧凑探头结合自动清洁刷与数字通讯，便于长期在线布设。",{"_57":164,"_242":-5,"_236":109,"_147":-5,"_144":417},{"_103":109,"_147":-5,"_149":-5,"_150":151},{"_160":419,"_140":172,"_173":420,"_175":176,"_177":421,"_179":422,"_181":361,"_183":361,"_185":423,"_187":424,"_189":425},"e9c2938f-6236-4c7f-bf9d-752bcf98b444","2025040861512869.jpg",13520,"3a4bd3a9ba0af3bd90061177b116d1a851d9d410ca383514dfbd7fdb3aa5270f","/igenu-preview/media/3a4bd3a9ba0af3bd90061177.jpg","2026-10-20T17:32:39.805Z",[426,428],{"_181":192,"_183":192,"_175":194,"_185":427},"/igenu-preview/media/9fb61c06fe27bcc0e9cecfd6.webp",{"_181":361,"_183":361,"_175":194,"_185":429},"/igenu-preview/media/b63396be40013d2d55e983f5.webp",{"_160":217,"_57":431,"_234":432,"_236":433,"_238":434,"_240":353,"_163":435,"_244":437},"ig30ht","IG30HT","IG30HT 高量程浊度传感器","采用红外散射光原理测量浊度，适用于工业过程水、地表水及水处理监测。数字探头结合光学补偿与蓝宝石视窗，可选自动清洁刷，减少持续运行中的表面附着。",{"_57":164,"_242":-5,"_236":109,"_147":-5,"_144":436},{"_103":109,"_147":-5,"_149":-5,"_150":151},{"_160":438,"_140":172,"_173":439,"_175":248,"_177":440,"_179":441,"_181":442,"_183":443,"_185":444,"_187":445,"_189":446},"95eccf83-22e5-4f4d-a03f-5509479d7661","2025040860985293.jpg",11246,"ecdac2d963d6479b136774a8172895d54061650f1cb8089d1404ff2a26710a79",190,78,"/igenu-preview/media/ecdac2d963d6479b136774a8.png","2026-10-20T17:32:39.787Z",[447],{"_181":442,"_183":443,"_175":194,"_185":448},"/igenu-preview/media/c0547cb002a63d36b1ac374c.webp",{"_160":218,"_57":450,"_234":451,"_236":452,"_238":453,"_240":353,"_163":454,"_244":456},"ig30ise-x","IG30ISE-X","IG30ISE-X 离子选择性电极","采用离子选择性电极法，按配置监测水中离子参数与pH。探头可直接浸入水中，无需独立采样系统，并提供补偿及校准功能，适用于饮用水、环境与污水监测。",{"_57":164,"_242":-5,"_236":109,"_147":-5,"_144":455},{"_103":109,"_147":-5,"_149":-5,"_150":151},{"_160":457,"_140":172,"_173":458,"_175":248,"_177":459,"_179":460,"_181":192,"_183":