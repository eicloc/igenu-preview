240":151,"_163":315,"_244":317},"ig30ss-sol","IG30SS/SOL","IG30SS/SOL 悬浮物与污泥浓度传感器","采用红外散射光原理，在线监测水及污水处理过程中的悬浮物与污泥浓度。数字探头结合光学补偿与蓝宝石视窗，可选清洁刷减少持续运行中的表面附着。",{"_57":164,"_242":-5,"_236":109,"_147":-5,"_144":316},{"_103":109,"_147":-5,"_149":-5,"_150":151},{"_160":318,"_140":172,"_173":319,"_175":176,"_177":320,"_179":321,"_181":322,"_183":323,"_185":324,"_187":325,"_189":326},"1439d80a-330c-424f-b53e-2863e4ad2437","2025040860527217.png",17952,"fbfabb8705ffee2ab2928de1e179bcbdfff9163bf9562b20f0a57da383e92447",252,303,"/igenu-preview/media/fbfabb8705ffee2ab2928de1.jpg","2026-10-20T17:32:39.774Z",[327],{"_181":322,"_183":323,"_175":194,"_185":328},"/igenu-preview/media/75deeb09829c31a530ddf618.webp",{"_160":212,"_57":330,"_234":331,"_236":332,"_238":333,"_240":151,"_163":334,"_244":336},"ig30uvno3","IG30UVNO3","IG30UVNO3 紫外吸收法硝氮传感器","通过紫外吸收原理直接测量水中硝酸盐氮，无需化学试剂和独立采样系统。提供不同光程选择，结合干扰补偿及自动清洁，适用于饮用水、环境与污水处理监测。",{"_57":164,"_242":-5,"_236":109,"_147":-5,"_144":335},{"_103":109,"_147":-5,"_149":-5,"_150":151},{"_160":337,"_140":172,"_173":338,"_175":176,"_177":339,"_179":340,"_181":341,"_183":342,"_185":343,"_187":344,"_189":345},"79581a81-10c6-426b-80fa-28e7baf03c33","2025040861391349.png",16873,"82c04b6460e5738541de5cfefb589dc0c6890e78350a89fe4e1a3b1a0828a745",263,348,"/igenu-preview/media/82c04b6460e5738541de5cfe.jpg","2026-10-20T17:32:39.799Z",[346],{"_181":341,"_183":342,"_175":194,"_185":347},"/igenu-preview/media/5668d414b7362883ab524969.webp",{"_160":213,"_57":349,"_234":350,"_236":351,"_238":352,"_240":353,"_163":354,"_244":356},"ig3000mp-x","IG3000MP-X","IG3000MP-X 水质多参数分析仪","通过可选数字探头组合监测pH、溶解氧、电导率、浊度等水质参数。探头采用防水连接并保存校准数据，便于现场更换；配备自动清洁装置，减少表面附着物。",false,{"_57":164,"_242":-5,"_236":109,"_147":-5,"_144":355},{"_103":109,"_147":-5,"_149":-5,"_150":151},{"_160":357,"_140":172,"_173":358,"_175":176,"_177":359,"_179":360,"_181":361,"_183":361,"_185":362,"_187":363,"_189":364},"d6d649eb-90c0-469f-9bfb-1c613153f689","2025040861670749.jpg",19258,"9a9243397faa84f675ead5a8a5216895c