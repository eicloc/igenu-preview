da.webp",{"_160":209,"_57":261,"_234":262,"_236":263,"_238":264,"_240":151,"_163":265,"_244":267},"ig30rdo","IG30RDO","IG30RDO 荧光法溶解氧传感器","采用荧光法测量溶解氧，无需更换电解液或进行极化。内置温度补偿并支持数字通讯，提供空气及样品校准方式，面向水处理、环境监测与水产养殖等应用。",{"_57":164,"_242":-5,"_236":109,"_147":-5,"_144":266},{"_103":109,"_147":-5,"_149":-5,"_150":151},{"_160":268,"_140":172,"_173":269,"_175":176,"_177":270,"_179":271,"_181":272,"_183":273,"_185":274,"_187":275,"_189":276},"0ddcf618-0714-49aa-9919-74ce97332e9e","2025040860317013.png",19493,"1513162129cbcc0b7fb98e96f5e5a24329832e50befa0944e7b17725123db89a",458,293,"/igenu-preview/media/1513162129cbcc0b7fb98e96.jpg","2026-10-20T17:32:39.769Z",[277,280],{"_181":192,"_183":278,"_175":194,"_185":279},205,"/igenu-preview/media/875a6bfa76d0d60b22d59c3d.webp",{"_181":272,"_183":273,"_175":194,"_185":281},"/igenu-preview/media/676768d13901a89005e95e68.webp",{"_160":210,"_57":283,"_234":284,"_236":285,"_238":286,"_240":151,"_163":287,"_244":289},"ig30ss-sol","IG30SS/SOL","IG30SS/SOL 悬浮物与污泥浓度传感器","采用红外散射光原理，在线监测水及污水处理过程中的悬浮物与污泥浓度。数字探头结合光学补偿与蓝宝石视窗，可选清洁刷减少持续运行中的表面附着。",{"_57":164,"_242":-5,"_236":109,"_147":-5,"_144":288},{"_103":109,"_147":-5,"_149":-5,"_150":151},{"_160":290,"_140":172,"_173":291,"_175":176,"_177":292,"_179":293,"_181":294,"_183":295,"_185":296,"_187":297,"_189":298},"1439d80a-330c-424f-b53e-2863e4ad2437","2025040860527217.png",17952,"fbfabb8705ffee2ab2928de1e179bcbdfff9163bf9562b20f0a57da383e92447",252,303,"/igenu-preview/media/fbfabb8705ffee2ab2928de1.jpg","2026-10-20T17:32:39.774Z",[299],{"_181":294,"_183":295,"_175":194,"_185":300},"/igenu-preview/media/75deeb09829c31a530ddf618.webp",{"_160":211,"_57":302,"_234":303,"_236":304,"_238":305,"_240":151,"_163":306,"_244":308},"ig30uvno3","IG30UVNO3","IG30UVNO3 紫外吸收法硝氮传感器","通过紫外吸收原理直接测量水中硝酸盐氮，无需化学试剂和独立采样系统。提供不同光程选择，结合干扰补偿及自动清洁，适用于饮用水、环境与污水处理监测。",{"_57":164,"_242":-5,"_236":109,"_147":-5,"_144":307},{"_103":109,"_147":-5,"_149":-5,"_150":151},{"_160":309,"_140":172,"_173":310,"_175":176,"_177":311,"_179":312,"_181":313,"_183":314,"_185":315,"_187":316,"_189":317},"79581a81-10c6-426b-80fa-28e7baf03c33","2025040861391349.png",16873,"82c04b6460e5738541de5cfefb589dc0c6890e78350a89fe4e1a3b1a0828a745",263,348,"/igenu-preview/media/82c04b6460e5738541de5cfe.jpg","2026-10-20T17:32:39.799Z",[318],{"_181":313,"_183":314,"_175":194,"_185":319},"/igenu-preview/media/5668d414b7362883ab524969.webp",{"_160":212,"_57":321,"_234":322,"_236":323,"_238":324,"_240":325,"_163":326,"_244":328},"ig3000lt","IG3000LT","IG3000LT 低量程浊度分析仪","面向饮用水与处理系统中的低浊度测量，采用光学检测与气泡去除流通池，减少气泡对读数的影响。模块化结构便于校准、清洁和维护，并可同时显示温度。",false,{"_57":164,"_242":-5,"_236":109,"_147":-5,"_144":327},{"_103":109,"_147":-5,"_149":-5,"_150":151},{"_160":329,"_140":172,"_173":330,"_175":331,"_177":332,"_179":333,"_181":334,"_183":335,"_185":336,"_187":337,"_189":338},"257d01fc-7670-46be-af54-0ae68bffbc45","2025040860761681.jpg","image/png",133072,"32687b0fb7e3209190a365f6165fd1befe9616a983cc291c12aca450fcae88b2",327,551,"/igenu-preview/media/32687b0fb7e3209190a365f6.png","2026-10-20T17:32:39.781Z",[339,342],{"_181":192,"_183":340,"_175":194,"_185":341},539,"/igenu-preview/media/f37ebd4fe6509270a9cebcfb.webp",{"_181":334,"_183":335,"_175":194,"_185":343},"/igenu-preview/media/eeb83d74a18b9d4f5cb4ef75.webp",{"_160":213,"_57":345,"_234":346,"_236":347,"_238":348,"_240":325,"_163":349,"_244":351},"ig3000mp-x","IG3000MP-X","IG3000MP-X 水质多参数分析仪","通过可选数字探头组合监测pH、溶解氧、电导率、浊度等水质参数。探头采用防水连接并保存校准数据，便于现场更换；配备自动清洁装置，减少表面附着物。",{"_57":164,"_242":-5,"_236":109,"_147":-5,"_144":350},{"_103":109,"_147":-5,"_149":-5,"_150":151},{"_160":352,"_140":172,"_173":353,"_175":176,"_177":354,"_179":355,"_181":356,"_183":356,"_185":357,"_187":358,"_189":359},"d6d649eb-90c0-469f-9bfb-1c613153f689","2025040861670749.jpg",19258,"9a9243397faa84f675ead5a8a5216895cf7e15c9b82d390083269947f0d00581",540,"/igenu-preview/media/9a9243397faa84f675ead5a8.jpg","2026-10-20T17:32:39.812Z",[360,362],{"_181":192,"_183":192,"_175":194,"_185":361},"/igenu-preview/media/32f08ba6aa513